aa=Column([ab,ac,ad,ae],**sm**)
ab=Text("Ethical questions","h2")
ac=Text("For somatic treatments, ethics focuses mainly on safety, efficacy, informed consent, and fair access.",source:"[6][7]"},ad=Text("For germline editing, the concerns become sharper: future people cannot consent, edits may be inherited, and there are worries about unpredictable harms, enhancement uses, and eugenics.",source:"[8][12]"},ae=Text("Broader concerns also include justice, affordability, regulation, and whether powerful editing tools will widen health inequities.",source:"[1]"]
