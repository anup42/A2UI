<a2ui>
$/={evidence_items:[{item:"order confirmation",item:"invoice/bill",item:"product listing screenshots",item:"payment proof"},{item:"photos or videos",item:"defect",item:"unboxing",item:"packaging, labels, and accessories"},{item:"emails, chat logs, complaint ticket numbers, pickup receipts, and return/refund status updates",item:"all"},{item:"job sheet or written service report",item:"if inspected or repaired"}],escalation_channels:[{channel:"National Consumer Helpline (NCH)",details:"pre-litigation escalation step; 1915 toll-free helpline, online and app-based complaint options"},{channel:"e-Daakhil",details:"file complaint for Consumer Commission; choose commission based on value/jurisdiction; name seller/platform; request refund/replacement/repair, compensation, and costs"}],deadlines_timing:[{period:"Consumer complaint limitation period",details:"generally 2 years from the cause of action under the Consumer Protection Act framework and related guidance"},{period:"Timing of complaint",details:"act as soon as the defect is discovered, as delay can weaken evidence and make platform reversals harder to obtain"},{period:"Card payment/refund",details:"bank chargeback may be tried in parallel, subject to card issuer’s timelines"}]}
root=Column([a,e,k,q,w,ac],gap="md",padding=16)
a=Card([b,c])
b=Text("What to keep as evidence","h2")
c=Table(columns=[{key:"item",label:"Item"},{key:"item",label:"Evidence"}],rows=[{item:"order confirmation",item:"order confirmation"},{item:"invoice/bill",item:"invoice/bill"},{item:"product listing screenshots",item:"product listing screenshots"},{item:"payment proof",item:"payment proof"},{item:"photos or videos",item:"photos or videos"},{item:"defect",item:"defect"},{item:"unboxing",item:"unboxing"},{item:"packaging, labels, and accessories",item:"packaging, labels, and accessories"},{item:"emails, chat logs, complaint ticket numbers, pickup receipts, and return/refund status updates",item:"emails, chat logs, complaint ticket numbers, pickup receipts, and return/refund status updates"},{item:"job sheet or written service report",item:"if inspected or repaired"}],domain="generic",preferredPresentation="cards")
e=Card([f,g])
f=Text("First complaint: seller and platform","h2")
g=Text("Report the defect immediately in writing through the app, email, or seller support, and clearly ask for refund, replacement, or repair. If the marketplace route fails, escalate to the platform’s grievance officer/nodal contact and include the order number, defect details, evidence, and the exact remedy sought. Under current consumer guidance, platform-side redressal should be triggered quickly; some guidance cites a 72-hour response expectation for defective goods, but this should be treated as a platform-facing service timeline rather than a guaranteed statutory remedy window.","caption")
h=Card([i,j])
i=Text("Official grievance channels","h2")
j=Table(columns=[{key:"channel",label:"Channel"},{key:"details",label:"Details"}],rows=[{channel:"National Consumer Helpline (NCH)",details:"pre-litigation escalation step; 1915 toll-free helpline, online and app-based complaint options"},{channel:"e-Daakhil",details:"file complaint for Consumer Commission; choose commission based on value/jurisdiction; name seller/platform; request refund/replacement/repair, compensation, and costs"}],domain="comparison",preferredPresentation="cards")
k=Card([l,m])
l=Text("Escalation if the issue is not resolved","h2")
m=Text("If the seller/platform does not resolve the matter, file a complaint on e-Daakhil for the appropriate Consumer Commission. Choose the commission based on the value and jurisdiction of the claim; current consumer-law guides direct consumers to the District, State, or National Commission through the online filing system. In the complaint, name both the seller and, where relevant, the platform, and request refund/replacement/repair, compensation, and costs.","caption")
q=Card([r,s])
r=Text("Deadlines and timing","h2")
s=Table(columns=[{key:"period",label:"Period"},{key:"details",label:"Details"}],rows=[{period:"Consumer complaint limitation period",details:"generally 2 years from the cause of action under the Consumer Protection Act framework and related guidance"},{period:"Timing of complaint",details:"act as soon as the defect is discovered, as delay can weaken evidence and make platform reversals harder to obtain"},{period:"Card payment/refund",details:"bank chargeback may be tried in parallel, subject to card issuer’s timelines"}],domain="generic",preferredPresentation="cards")
w=Card([x,y])
x=Text("Practical approach","h2")
y=Text("Keep the defective item safe until the dispute is resolved, because the seller or platform may require inspection or return. Use written communication only where possible, since a clear paper trail helps at every escalation stage. If the seller offers only store credit or a voucher for a clearly defective product, you can still press for the statutory remedy you want through the grievance and consumer-forum process.","caption")
z=Button("Continue","primary",オンPress=null)
</a2ui>