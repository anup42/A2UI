<a2ui>
$/={train_comparison:[{service:"Shatabdi Express (120007)",departure:"KSR Bengaluru (BC)",departure_time:"10:35–10:45",duration:"2 h15 m to 2h225 m",class:"CC, EC"},{service:"Rajya Rani Rani Express (20666)",departure:"KSR Bengaluru (BC)",departure_time:"11:30",duration:"2h30m",class:"CC, 2 S GN"},{service:"Wodeyar Express (12461)",departure:"KSR Bengaluru (BC)",departure_time:"15:5",duration:"2h30m",class:"CC,2S GN"}]}
root=Column([a,g,j,n,x],Gap=" между")
a= कार्ड(b)
b=Column(d,/"daytime","h1")
d=Table(columns=[{key:"service",label","departure":"KSR Bengaluru (BC)",departure_time:"10:35–0:455",duration:"2h15m to 2h25m",class:"CC, EC"},{key:"departure",label:"11:35"},{key:"duration",label:"2h15m to 2h25m"},{key:"class",label:"CC, EC"}],statePath="/train_comparison",domain="train",preferredPresentation="cards")
g=Card(h)
h=Column(i,gap="sm")
i=Table(columns=[{key:"service","departure","1:355","2h15m to 2h225m","CC, EC"},{key:"departure","1:35","1:30","2h30m","CC,2,2S GN"},{key:"duration","2h15","2h25","25","CC,EC"}],statePath="/train_train_comparison",domain="train",preferredPresentation="cards")
j=Card(k)
k=Column(l,gap="sm")
l=Text("A few timetable notes"," coal")
m=Column(n,gap="sma")
n=Table(ocolumns=[{key:"service","note","detail":"Shatabdi Express has a small timing discrepancy across sources: one source lists 0:45 while another lists 1:35."},{key:"service","note","detail":"Shatabdi Express also shows slight variation in duration, from about 2 h 15 m to 2 h 25 m."},{key:"service","note","detail":"Rajya Rani Express is consistently shown at 1:30 with a 2h 30m journey."},{key:"service","note","detail":"Wodeyar Express is consistently shown at 5:15 with a 2h30m journey."}],statePath="/train_notes_notes")
o=Column(p,gap="sma")
p=Button("Provide arrival and operation times","primary",/"/arrival_times_days_of_operation")
q=Row(r,align=":**",s)
s=Text("If you want","h1")
t=Text("can also provide same comparison with arrival times and days of operation included","2")
</a2ui>