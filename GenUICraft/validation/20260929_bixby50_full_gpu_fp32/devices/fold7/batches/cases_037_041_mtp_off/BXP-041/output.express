b=Table(columns=[{key:"country",label:"Country"},{key:"visa_route",label:"Visa route"},{key:"permitted_stay",label:"Permitted stay"},{key:"published_fee",label:"Published fee"},{key:"passport_requirement",label:"Passport requirement"},{key:"rules_checked",label:"Rules checked"}],statePath="/passport_rules",domain="comparison",preferredPresentation="cards",primaryColumn="country")
