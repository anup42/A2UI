<a2ui>
$/={passport_rules:[{country:"Thailand",visa_route:"Visa exemption for Indian ordinary passport holders for tourism; Thai embassy note says longer stays can use e-visa if needed [21][22]",permitted_stay:"Up to 30 days from 15 September 2026 under the revised exemption scheme",published_fee:"Visa exemption: no fee published; e-visa fee not confirmed in the official snippets I could verify",passport_requirement:"Thai embassy advisory lists a passport valid on arrival and standard immigration conditions[24]",rules_checked:"Checked against Thai embassy notices dated 26 July 2026 and 15 September 2026 rule notice"},{country:"Vietnam",visa_route:"E-visa is the standard route; India is not on Vietnam’s visa-exemption list [11][17]",permitted_stay:"Up to 90 days for the official e-visa",published_fee:"USD 25 single-entry or USD 50 multiple-entry",passport_requirement:"Passport scan required for the application; source notes at least 6 months validity and 2 blank pages[20]",rules_checked:"Checked against sources published 30 March 2026 and 8 July 2026"},{country:"Sri Lanka",visa_route:"ETA is required for short visits; free ETA scheme applies to selected nationalities, but the checked sources do not show India in that free list [12][32]",permitted_stay:"Standard tourist ETA is 30 days",published_fee:"ETA fee for SAARC countries is listed as USD 20 online or USD 25 on arrival in the old fee schedule, but current India-specific published fee was not clearly verified from official sources",passport_requirement:"Tourist ETA is applied online using passport bio-page details; the application guidance requires the passport details exactly as in the travel document [4]",rules_checked:"Checked against Sri Lankan immigration pages and ETA guidance, including 25 May 2026 free-ETA notice and ETA guidance pages"}]}
