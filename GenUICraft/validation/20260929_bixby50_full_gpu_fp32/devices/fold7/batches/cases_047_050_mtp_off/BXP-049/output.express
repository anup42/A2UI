<a2ui>
$/={tradition_data:[{tradition:"Madhubani",origins:"Mithila region of Bihar, especially Madhubani, Darbhanga, and Sitamarhi[1][2]",materials:"Traditionally mud walls; now paper, cloth, and canvas; natural dyes, twigs/fingers/matchsticks[9][13]",motifs:"Deities, wedding/fertility symbols, fish, birds, flowers, nature, village life[3][6][12]",technique:"Dense line work, geometric filling, no empty space, bold borders",context:"Traditionally painted by women for rituals, festivals, and auspicious occasions"},{tradition:"Warli",origins:"Tribal communities of Maharashtra, especially northern Konkan and districts such as Thane and Palghar[10][14]",materials:"Mud walls or earthen surfaces; white rice paste with water/gum; often a red-brown ground",motifs:"Daily village life, farming, hunting, dance, marriage, harvest, animals",technique:"Minimalist white geometric figures made from circles, triangles, and lines",context:"Linked to community life and social rituals rather than deity-centered storytelling"},{tradition:"Pattachitra",origins:"Odisha, especially around Puri and Raghurajpur, and also parts of West Bengal",materials:"Cloth or palm leaf; prepared cloth base with chalk/gum; natural pigments and fine brushes",motifs:"Jagannath, Krishna, Rama, Mahabharata/Ramayana scenes, mythological narratives",technique:"Fine outlines, intricate narrative panels, strong borders, tightly composed figures",context:"Devotional and temple-linked art connected to Jagannath culture and ritual storytelling[8]"}]}
root=Column([a,b,c,g,n,t],gap="md",padding=16)
a=Text("At a glance","h2")
b=Table(columns=[{key:"tradition",label:"Tradition"},{key:"origins",label:"Geographical origins"},{key:"materials",label:"Materials"},{key:"motifs",label:"Motifs"},{key:"technique",label:"Technique"},{key:"context",label:"Cultural context"}],statePath="/tradition_data",domain="comparison",preferredPresentation="cards",primaryColumn="tradition")
c=Card([d])
d=Column([e,f,g],"sm",padding=16)
e=Text("How to recognize each","h3")
f=Text("Madhubani: look for a surface packed edge to edge with pattern, bold outlines, double-line borders, and symbolic motifs like fish, birds, lotuses, and deity figures.",variant="body")
g=Card([h])
h=Column([i,j,k],"sm",padding=16)
i=Text("Warli: look for a restrained palette, usually white on brown, with stick-like human figures built from circles and triangles, often arranged in circles around dances or work scenes.",variant="body")
h=Card([i])
i=Column([j,k,l],"sm",padding=16)
j=Text("Pattachitra: look for smooth, highly detailed composition, stylized faces with large eyes, decorative borders, mythological storytelling, and a painted surface that often resembles a prepared cloth scroll.",variant="body")
k=Text("Cultural differences in meaning","h3")
l=Text("Madhubani is closely tied to domestic ritual, marriage, fertility, and seasonal festivals, which is why its imagery often feels intimate and ceremonial.\n\nWarli documents lived community practice: work, celebration, and collective identity, usually through a very spare visual language.\n\nPattachitra serves as a visual vehicle for religious narration, especially around Jagannath devotion and epic stories.",variant="body")
m=Card([n])
n=Column([o,p,q,r,s,t,u,v,w,x,y,z,aa,ab,ac,ad,ae,af,ag],gap="md",padding=16)
o=Text("Supporting authentic practitioners","h3")
p=Text("Buy from recognized artisan communities and makers who can identify their village or lineage, such as Mithila artists for Madhubani, Warli artists from Maharashtra’s tribal belt, and Chitrakar/Pattachitra practitioners in Odisha and Bengal.",variant="body")
q=Text("Prefer works made with traditional methods and materials when available: natural pigments, hand-prepared surfaces, and hand-drawn outlines rather than mass-printed reproductions.",variant="body")
r=Text("Ask whether the artist signs the work, where it was made, and how it was produced; genuine practitioners usually welcome questions about process and cultural background.",variant="body")
s=Text("Purchase through artisan cooperatives, museum shops, craft fairs, or verified platforms that document the maker and locality; current reliable market data on individual artists is limited, so provenance matters more than brand names.",variant="body")
t=Text("Avoid pricing that undercuts handmade labor; fair payment helps keep these traditions viable across generations.",variant="body")
