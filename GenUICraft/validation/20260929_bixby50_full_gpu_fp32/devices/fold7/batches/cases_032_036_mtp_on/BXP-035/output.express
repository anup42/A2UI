<a2ui>
$/={plan_data:[{week:"Week 1",walk:"Walk 5 days: 10 minutes at a comfortable brisk pace; use the “can talk, not sing” test to stay moderate.",strength:"Strength 2 days, after a walk or on separate days: chair sit-to-stands, wall push-ups, glute bridges, standing calf raises, and bird-dogs. Do 1 set of 6-8 reps each.",recovery:"2 full rest days, with light stretching or easy strolling only."},{week:"Week 2",walk:"Walk 5 days: 12-15 minutes per session.",strength:"Strength 2 days: the same exercises, 1-2 sets of 8 reps each.",recovery:"keep one day completely off and one day very light if you feel sore."},{week:"Week 3",walk:"Walk 5 days: 18-20 minutes per session, or split into two short walks if needed.",strength:"Strength 2 days: 2 sets of 8-10 reps each, moving slowly and with control.",recovery:"Add 3-5 minutes of balance work after one or two sessions: tandem walking, side steps, or single-leg stands near a wall."},{week:"Week 4",walk:"Walk 5 days: 20-25 minutes per session. If this feels easy, add a few one-minute faster intervals.",strength:"Strength 2-3 days: 2 sets of 10-12 reps, keeping form first and stopping before failure.",recovery:"keep at least 1-2 easier days each week."}],exercises:[{exercise:"Chair sit-to-stand",description:"Chair sit-to-stand."},{exercise:"Wall push-up",description:"Wall push-up."},{exercise:"Glute bridge",description:"Glute bridge."},{exercise:"Standing calf raise",description:"Standing calf raise."},{exercise:"Bird-dog or dead bug",description:"For core control."},{exercise:"Side step, heel-to-toe walk, or single-leg stand",description:"For balance."}],stop_criteria:"Stop exercise right away if you have chest pain or tightness, dizziness, faintness, unusual shortness of breath that stops you talking comfortably, palpitations, nausea, or feel cold and clammy."},{adjustment_criteria:"Too hard: shorten the walk, slow the pace, reduce to 1 set, or use a higher chair or wall support.","Too easy: add 5 minutes to walking, add a set, or use slower lowering on strength moves.","If sore: keep moving lightly, but skip hard sessions until normal soreness settles."}],root=Column([a,b,c,d,e,f,g,h,i,j,k,l,m,n,o,p,q,r,s,t