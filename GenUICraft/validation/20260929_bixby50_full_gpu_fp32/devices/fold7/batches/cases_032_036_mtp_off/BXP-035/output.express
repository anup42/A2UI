$/={plan_data:[{week:"Week 1",walk:"Walk 5 days: 10 minutes at a comfortable brisk pace; use the “can talk, not sing” test to stay moderate.",strength:"2 days, after a walk or on separate days: chair sit-to-stands, wall push-ups, glute bridges, standing calf raises, and bird-dogs. Do 1 set of 6-8 reps each.",recovery:"2 full rest days, with light stretching or easy strolling only."},{week:"Week 2",walk:"Walk 5 days: 12-15 minutes per session.",strength:"2 days: the same exercises, 1-2 sets of 8 reps each.",recovery:"Keep one day completely off and one day very light if you feel sore."},{week:"Week 3",walk:"Walk 5 days: 18-20 minutes per session, or split into two short walks if needed.",strength:"2 days: 2 sets of 8-10 reps each, moving slowly and with control.",recovery:"Add 3-5 minutes of balance work after one or two sessions: tandem walking, side steps, or single-leg stands near a wall."},{week:"Week 4",walk:"Walk 5 days: 20-25 minutes per session. If this feels easy, add a few one-minute faster intervals.",strength:"2-3 days: 2 sets of 10-12 reps, keeping form first and stopping before failure.",recovery:"Keep at least 1-2 easier days each week."}],exercises:[{exercise:"Chair sit-to-stand",focus:"Lower Body"},{exercise:"Wall push-up",focus:"Upper Body"},{exercise:"Glute bridge",focus:"Glutes"},{exercise:"Standing calf raise",focus:"Calves"},{exercise:"Bird-dog or dead bug",focus:"Core"},{exercise:"Side step, heel-to-toe walk, or single-leg stand",focus:"Balance"}]}
