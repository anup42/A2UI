<a2ui>
root=Column([a,b,c,i,p,x,af],gap="md",padding=16)
a=Text("Phishing warning signs","h2")
b=Text("Urgent language, threats, or pressure to act immediately are common phishing cues [1].","caption")
c=Card([d])
d=Column([e,f,g,h],"sm",padding=16)
e=Text("Check the sender address carefully; attackers often imitate trusted domains with small changes [2].","caption")
f=Text("Be wary of generic greetings, poor grammar, odd formatting, unexpected attachments, and links that do not match their visible text[3].","caption")
g=Text("Treat requests for passwords, financial details, or unusual payments as high-risk, especially if they arrive by email or text with a link to a login page[4].","caption")
h=Text("This is a general overview of common phishing tactics.","caption")
i=Card([j])
j=Column([k,l,m],"sm",padding=16)
k=Text("Harmless example email","h3")
l=Text("Subject: Expense policy update for review\n\nHello team,\n\nPlease review the updated expense policy attached to this message. If you have questions, contact the Finance Helpdesk using the phone number listed on the company intranet.\n\nThank you,\nFinance Operations","body")
m=Text("This example is harmless because it avoids pressure, does not ask for credentials, and points employees to a trusted internal contact channel rather than a message link [12].","caption")
n=Text("How to verify","h2")
o=Card([p])
p=Column([q,r,s],"sm",padding=16)
q=Text("Pause before clicking and inspect the sender, reply-to address, and destination URL for mismatches.","caption")
r=Text("If a message claims to be from a real company or internal team, contact that organization or team through a known-good channel, not by replying to the suspicious message.","caption")
s=Text("For payment, account, or password requests, verify using a second channel such as a phone call, secure chat, or direct login through the official website.","caption")
t=Text("If the message is unexpected, treat it as suspicious even if the logo and wording look professional.","caption")
u=Text("After clicking a suspicious link","h2")
v=Card([w])
w=Column([x,y,z,aa,ab],"sm",padding=16)
x=Text("Stop interacting with the page immediately and do not enter any information [13].","caption")
y=Text("Open the service yourself by typing the official address or using a saved bookmark, then change the password if credentials were entered [18].","caption")
z=Text("Enable or confirm multi-factor authentication where available, and review recent account activity for unauthorized access.","caption")
aa=Text("If you downloaded a file, disconnect if needed, run a security scan, and report the incident to your IT or security team right away [10].","caption")
ab=Text("Report suspicious messages promptly; NCSC advises forwarding suspicious email and not clicking links in it, and CISA recommends reporting phishing so defenders can act quickly [8].","caption")
ac=Text("Office habits that help","h2")
ad=Card([ae])
ae=Column([af,ag,ah],"sm",padding=16)
af=Text("Use layered defenses: filtering, multi-factor authentication, and clear reporting channels reduce damage when a phish gets through [16].","caption")
ag=Text("Train staff to report mistakes without fear; organizations are more resilient when employees can flag suspicious mail early.","caption")
ah=Text("For finance, HR, and IT teams, require a second-person verification step for sensitive requests, since these roles are often targeted.","caption")
ai=Text("End of document.","h3")
</a2ui>