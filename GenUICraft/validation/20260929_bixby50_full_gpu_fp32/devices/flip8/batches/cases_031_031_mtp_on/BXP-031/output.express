<a2ui>
$/={documents:[{doc:"RERA registration certificate",details:"Confirms the project is registered under Karnataka RERA, which is required for qualifying apartment projects; verify it on the Karnataka RERA portal using the project name or registration number.",verification:"[1][3][4][9]"},{doc:"Sanctioned building plan",details:"Confirms the building layout, floors, and units were approved by the competent authority; verify it with the BBMP, BDA, or other local planning authority and cross-check the same plan details against RERA records.",verification:"[13]"},{doc:"Title documents / title chain",details:"Establishes who owns the land and whether the seller has a valid right to transfer it; verify the mother deed, prior sale deeds, partition deeds, and related title records at the Sub-Registrar’s office or through Karnataka’s registration record system, and have an independent lawyer review the chain.",verification:"[2][5][10][14][15]"},{doc:"Occupancy Certificate (OC)",details:"Confirms the building has been certified fit for occupation and generally matches approved norms; verify it with the BBMP or the issuing municipal/planning authority before taking possession.",verification:"[7]"},{doc:"Encumbrance Certificate (EC)",details:"Shows registered transactions and helps identify mortgages, charges, attachments, or other encumbrances on the property; verify it at the Sub-Registrar’s office or through Karnataka’s online registration services, and ensure the period covered is sufficiently long.",verification:"[13]"}],verification_points:[{verification:"RERA registration should match the developer name, project name, location, phase, and registration number shown in the brochure and agreement; if the project is not listed on the Karnataka RERA portal, that is a major warning sign.",verification_point:"RERA registration"},{verification:"Sanctioned plan should match the actual apartment layout, number of floors, and unit configuration being sold; deviations between the approved plan and marketing material should be treated as a red flag.",verification_point:"Sanctioned plan"},{verification:"Title chain should be continuous and unbroken, showing clear ownership from the root document to the present seller; missing links, unregistered transfers, or mismatched names require legal clarification.",verification_point:"Title chain"},{verification:"OC should exist for ready-to-move flats; possession without it can indicate the building has not been fully regularised for occupation.",verification_point:"OC"},{verification:"EC should be checked for undisclosed loans, attachments, or other registered claims; any active charge should be resolved before purchase.",verification_point:"EC"}]}
*Note: The verification points are derived from the detailed explanations provided in the original text.*
root=Column([a,b,c,g,l,r],gap="md",padding=16)
a=Text("Pre-purchase document checklist for an apartment in Karnataka","h2")
b=Table(columns=[{key:"doc",label:"Document"},{key:"details",label:"Details"},{key:"verification",label:"Verification/Source"}],statePath="/documents",domain="generic",preferredPresentation="cards",primaryColumn="doc")
c=Column([d,e,f,i,j],"sm")
d=Text("What each document should tell you","h2")
e=Text("RERA registration should match the developer name, project name, location, phase, and registration number shown in the brochure and agreement; if the project is not listed on the Karnataka RERA portal, that is a major warning sign.",verification_points=[{verification:"RERA registration"},{verification:"Sanctioned plan"},{verification:"Title chain"},{verification:"OC"},{verification:"EC"}]}
f=Column([g,h,i,j],"sm")
g=Text("Where to verify each item","h2")
h=Text("Karnataka RERA portal: RERA registration details, promoter/project status, and related project disclosures.",verification_points=[{verification:"Karnataka RERA portal"},{verification:"BBMP / BDA / local planning authority"},{verification:"Sub-Registrar’s office / Karnataka registration records"},{verification:"Independent property lawyer"}]}
i=Text("Minimal buy-only-if checklist","h2")
j=Column([k,l,m,n,o],"sm")
k=Text("RERA registration is valid and matches the project.",verification_points=[{verification:"RERA registration"},{verification:"Sanctioned plan"},{verification:"Title chain"},{verification:"OC"},{verification:"EC"}]}
l=Text("Sanctioned plan matches what is being sold.",verification_points=[{verification:"RERA registration"},{verification:"Sanctioned plan"},{verification:"Title chain"},{verification:"OC"},{verification:"EC"}]}
m=Text("Title chain is clear and complete.",verification_points=[{verification:"RERA registration"},{verification:"Sanctioned plan"},{verification:"Title chain"},{verification:"OC"},{verification:"EC"}]}
n=Text("OC is available for a ready apartment.",verification_points=[{verification:"RERA registration"},{verification:"Sanctioned plan"},{verification:"Title chain"},{verification:"OC"},{verification:"EC"}]}
o=Text("EC shows no unresolved encumbrance.",verification_points=[{verification:"RERA registration"},{verification:"Sanctioned plan"},{verification:"Title chain"},{verification:"OC"},{verification:"EC"}]}
p=Text("Current official portal data can change, so verify the latest records directly before paying any booking amount.",variant="body")
</a2ui>