<a2ui>
$/={comparison_data:[{feature:"Eligibility",epf:"Salaried employees in EPF-covered establishments; mandatory for many formal-sector workers.",ppf:"Any resident individual can open an account.",nps:"Indian citizens aged 18–70; both salaried and self-employed can join."},{feature:"Contribution rules",epf:"Employee contributes 12% of basic pay + dearness allowance; employer also contributes.",ppf:"₹500 minimum per year; ₹1.5 lakh maximum per financial year.",nps:"₹1,000 minimum per year for Tier I; no upper limit on contribution."},{feature:"Lock-in / tenure",epf:"Linked to employment; full withdrawal is generally at retirement or after qualifying exit.",ppf:"15 years initial lock-in; extendable in 5-year blocks.",nps:"Locked until age 60 for normal exit."},{feature:"Withdrawals",epf:"Partial withdrawals allowed for specified needs; full withdrawal is tax-favoured after 5 years of continuous service.",ppf:"Partial withdrawal allowed from the 7th year; premature closure only after 5 completed years and for specified reasons.",nps:"Partial withdrawal allowed after 3 years, generally up to 25% of own contributions for specified purposes."},{feature:"Tax treatment",epf:"Contributions may qualify for deduction under Section 80C; interest and eligible withdrawals are generally tax-free, but interest on employee contribution above ₹2.5 lakh/year can be taxable.",ppf:"Contributions qualify under Section 80C; interest and maturity are generally fully tax-free.",nps:"Employee contribution can get Section 80C benefit, plus an extra ₹50,000 under Section 80CCD(1B); at exit, a lump sum portion is tax-free, while annuity income is taxable."}]}
root=Column([a,d,g,m,s],gap="md",padding=16)
a=Column([b,c],"sm")
b=Text("EPF vs PPF vs NPS","h2")
c=Table(columns=[{key:"feature",label:"Feature"},{key:"epf",label:"EPF"},{key:"ppf",label:"PPF"},{key:"nps",label:"NPS"}],statePath="/comparison_data",domain="comparison",preferredPresentation="table")
d=Card([e])
e=Text("EPF is the most employment-linked and usually the least flexible, but it offers strong tax efficiency for salaried workers. PPF is the simplest low-risk option for residents seeking guaranteed, tax-free long-term savings, but it has a fixed annual cap and a long lock-in. NPS is the most flexible for retirement accumulation because of its higher contribution ceiling and market-linked growth, but its exit is partly taxable because annuity income is taxed as regular income.",variant="body")
g=Card([h])
h=Text("Three illustrative saver situations","h2")
i=Column([j,k,l],"sm")
j=Text("A salaried employee with stable income and long service horizon: EPF is usually the core choice because contributions are automatic, employer money is added, and withdrawals after 5 years of service are generally tax-free.",variant="body")
k=Text("A resident freelancer or homemaker wanting safe, disciplined saving: PPF fits well because it is open to resident individuals, allows small yearly contributions, and offers fully tax-free maturity under the current rules.",variant="body")
l=Text("A higher-income saver aiming to build a larger retirement corpus: NPS is often the better fit because there is no practical upper contribution limit, it allows extra deduction over Section 80C, and it supports long-term market-linked growth with partial liquidity after 3 years.",variant="body")
m=Column([n,o],"sm")
n=Text("Current rules cited here reflect the latest available sources; if your exact EPF tax treatment depends on contribution thresholds or employer structure, that should be checked against the latest income-tax and EPFO guidance before investing.",variant="body")
o=Text("[7][8][10]","caption")
p=Text("Disclaimer: The comparison data is based on general knowledge and current publicly available information. Consult with a financial advisor for personalized advice.",variant="body")
</a2ui>