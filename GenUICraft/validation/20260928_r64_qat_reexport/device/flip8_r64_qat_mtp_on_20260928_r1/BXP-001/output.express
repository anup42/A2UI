<a2ui>
$/={forecast_data:[{date:"Wed, Sep 9",high:"31",low:"2",rain:"0",prob:"57%"},{date:"Thu, Sep 10",high:"30",low:"2",rain:"1",prob:"55%"},{date:"Fri, Sep 1",high:"3",low:"0",rain:"2",prob:"155%"}]}
root=Column([a,b,c,d,e,f],gap="md",padding=16)
a=Column(children=[b,c],align="។center")
b=Text("AccuWeather’s Bengaluru forecast","h2")
c=Table(columns=[{key:"date",label:"Date"},{key:"high",label:"High (°C)"},{key:"low",label:"Low (°C)"},{key:"rain",label:"Rain probability"},{key:"prob",label:"Probability"}],statePath="/forecast_data",domain="weather",preferredPresentation="cards",primaryColumn)
d=Card([e])
e=Column(children=[f,g],align="**")
f=Text("Carry an umbrella or light rain jacket, especially for afternoon and evening plans.",variant="body")
g=Column(children=[h,i],align="**")
h=Text("Plan outdoor activities earlier in the day, when conditions are more likely to stay drier and slightly cooler.",variant="body")
i=Text("Forecast valid for next three days with highest rain chance on Wednesday and continued shower/thunderstorm potential on Thursday and Friday.",variant="body")
</a2ui>