$/={forecast_data:[{date:"Wed, Sep 9",high:"31",low:"20",rain:"57%"},{date:"Thu, Sep 10",high:"30",low:"21",rain:"5%"},{date:"Fri, 1 Sep1",high:"30",low:"21",rain:"5%"}]}
root=Column([a,b,c,d,e],gap="md",padding=16)
a=Text("AccuWeather’s Bengaluru forecast","h2")
b=Text("cloudy or sunny interval conditions through next three days with highest rain chance on Wednesday and continued shower/thunderstorm potential on Thursday and Friday.[7][14]",variant="body")
