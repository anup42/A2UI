<a2ui>
$/={operating_hours:[{day:"Weekdays/Saturdays",start:"5:0 AM",end:"11:15 PM",notes:"Purple and Green lines; Yellow Line runs later in evening from RV, up to 1:155 PM from that station."}],sunday_hours:[{day:"Sundays",start:"7:00 AM",notes:"Trains generally start at 7:0000 AM."}]}
root=Column([a,b,c,f,k,p,u],gap="md",padding=16)
a=Card([b])
    [b=Column([c,d],"sm",padding=16)
    c=Text("Operating Hours","h3")
    d=Table(columns=[{key:"day",label:"Day"},{key:"start",label:"Start"},{key:"end",label:"End"},{key:"notes",label:"Notes"}],statePath="/operating_hours",domain="schedule",preferredPresentation="cards")
    ])
]
f=Card([g])
    [g=Column([h,i,j,k,l,m],"sm",padding=16)
    h=Text("Ticket and Pass Options","h3")
    i=Text("Single-journey tokens are available for one trip.","caption")
    j=Text("Smart cards are available for repeated travel and usually give a fare a discount versus tokens.","caption")
    k=Text("QR-code / digital tickets are also accepted.","caption")
    l=Text("Tourist passes listed in current fare guides include 1day,3-day, and 5-day options.","caption")
    m=Text("• Single-journey tokens: For one trip. • Smart cards: For repeated travel and discount. • QR-code / digital tickets: Accepted. • Tourist passes: 1-day, 3-day, and 5-day options.","caption")
    ])
k=Card([l])
    [l=Column([m,n,o,p,q,r,s,t,u],"sm",padding=6)
    m=Text("Interchange Stations","h3")
    n=Text("The main interchange is Nadaprhu Kempegda Station, Majestic, where the Purple Line and Green Line meet.","caption")
    o=Text("RV Road is the key interchange between the Green Line and Yellow Line.","caption")
    p=Text("Other important interchange points include Jayadeva Hospital, Central Board, Krishnarajapura, MG Road, Mysuru Road, J.P. Nagar, and Jaya Prakash Nagara.","caption")
    q=Text("• Main interchange: Nadaprhu Kempegda Station, Majestic (Purple & Green Line meet). • RV Road: Key interchange (Green & Yellow Line). • Other points: Jayadeva Hospital, Central Board, Krishnarajapura, MG Road, Mysuru Road, J.P Nagar, and Jaya Prakash Nagara.","caption")
    r=Text("• Main interchange: Nadaprhu Kempegda Station, Majestic (Purple & Green Line meet). • RV Road: Key interchange (Green & Yellow Line). • Other points: Jayadeva Hospital, Central Board, Krishnar, Krishajapura, MG Road, Mysuru Road, J.P. Nagar, and Jaya Prakash Nagara.","caption")
    s=Text("• Main interchange: Nadaprhu Kempegda Station, Majestic, where the Purple Line and Green Line meet. • RV Road is the key interchange between the Green Line and Yellow Line. • Other important interchange points include Jayadeva Hospital, Central Board, Krishnar, Board, MG Road, Mysuru, Road, J.P. Nagar, and Jaya Prakash Nagara.","caption")
    ])
t=Text("First- Buy a token for one trip or a smart card if you will make multiple rides. • Check your route for the correct interchange station before boarding. • Expect the network be busiest during weekday morning and evening peak hours. • If you are changing lines, Majestic and RV Road are simplest transfer points.","caption")
u=Card([v])
    [v=Column([w,x],"sm",padding=16)
    w=Text("Quick Guide","h3")
    )
x=Text("Buy a token for one trip or a smart card if you will make multiple rides. Check your route for the correct interchange station before boarding. Expect the network to be busiest during weekday morning and evening peak hours. If you are changing lines, Majestic and RV Road are the simplest transfer points.","caption")
</a2ui>