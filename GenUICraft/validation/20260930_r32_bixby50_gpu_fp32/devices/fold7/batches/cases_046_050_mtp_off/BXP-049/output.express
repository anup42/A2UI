$/={checklist_data:[{tradition:"Madhubani",origins:"Mithila region of Bihar, especially Madhubani, Darbhanga, and Sitamarhi[10][14]",materials:"Traditionally mud walls; now paper, cloth, and canvas; natural dyes, twigs/fingers/matchsticks[9][13]",motifs:"Deities, wedding/fertility symbols, fish, birds, flowers, nature, village life[3][6][12]",technique:"Dense line work, geometric filling, no empty space, bold borders",context:"Traditionally painted by women for rituals, festivals, and auspicious occasions"},{tradition:"Warli",origins:"Tribal communities of Maharashtra, especially northern Konkan and districts such as Thane and Palghar[10][14]",materials:"Mud walls or earthen surfaces; white rice paste with water/gum; often a red-brown ground",motifs:"Daily village life, farming, hunting, dance, marriage, harvest, animals",technique:"Minimalist white geometric figures made from circles, triangles, and lines",context:"Linked to community life and social rituals rather than deity-centered storytelling"},{tradition:"Pattachitra",origins:"Odisha, especially around Puri and Raghurajpur, and also parts of West Bengal",materials:"Cloth or palm leaf; prepared cloth base with chalk/gum; natural pigments and fine brushes",motifs:"Jagannath, Krishna, Rama, Mahabharata/Ramayana scenes, mythological narratives",technique:"Fine outlines, intricate narrative panels, strong borders, tightly composed figures",context:"Devotional and temple-linked art connected to Jagannath culture and ritual storytelling[8]"}]}
