<a2ui>
root=Column([a,b,c,f,l,t],gap="md",padding=16)
a=Text("Operating hours","h2")
b=Text("Weekdays/Saturdays: Most sources show service starting around 5:00 AM and ending around 11:05 PM on the Purple and Green lines; the Yellow Line runs later in the evening from RV Road, up to 11:55 PM from that station.","caption")
c=Card([d])
d=Column([e,f],"sm")
e=Text("Sundays: Trains generally start at 7:00 AM.","caption")
f=Card([g])
g=Column([h,i,j,k,l],gap="md")
h=Text("Ticket and pass options","h2")
i=Text("Single-journey tokens are available for one trip.","caption")
j=Text("Smart cards are available for repeated travel and usually give a fare discount versus tokens.","caption")
k=Text("QR-code / digital tickets are also accepted.","caption")
l=Text("Tourist passes listed in current fare guides include 1-day, 3-day, and 5-day options.","caption")
m=Text("Interchange stations","h2")
n=Text("The main interchange is Nadaprabhu Kempegowda Station, Majestic, where the Purple Line and Green Line meet.","caption")
o=Text("RV Road is the key interchange between the Green Line and Yellow Line.","caption")
p=Text("Other important interchange points include Jayadeva Hospital, Central Silk Board, Krishnarajapura, MG Road, Mysuru Road, J.P. Nagar, and Jaya Prakash Nagara.","caption")
q=Text("First-time rider quick guide","h2")
r=Card([s])
s=Column([t,u,v,w],"sm")
t=Text("Buy a token for one trip or a smart card if you will make multiple rides.","caption")
u=Text("Check your route for the correct interchange station before boarding.","caption")
v=Text("Expect the network to be busiest during weekday morning and evening peak hours.","caption")
w=Text("If you are changing lines, Majestic and RV Road are the simplest transfer points to remember.","caption")
</a2ui>