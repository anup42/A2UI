<a2ui>
root=Column([a,b,c,f,o],gap="md",padding=16)
a=Text("Veterinary checkups","h2")
b=Card([c])
c=Column([d,e],"sm",padding=16)
d=Text("Schedule a wellness exam at least once a year; the vet should review weight, body condition, skin/coat, heart/lungs, teeth, and any behavior or litter-box changes. Indoor cats still need routine preventive care because problems can be missed early.","caption")
e=Icon("[CALENDAR_ICON]")
f=Column([g,h,i,j],gap="md")
g=Text("Vaccinations","h2")
h=Card([i])
i=Column([j,k],"sm",padding=16)
j=Text("Discuss whether your cat’s FVRCP and rabies vaccines are current; these are core protections for cats in India.","caption")
k=Text("For adult low-risk cats, FVRCP boosters are often given every 1–3 years depending on the vaccine and vet advice, while rabies timing should follow local rules and the product label.","caption")
l=Text("Ask your vet about FeLV only if your cat has exposure risk, such as outdoor access or contact with other cats of unknown status.","caption")
m=Icon("[VACCINE_ICON]")
n=Column([o,p,q],gap="md")
o=Text("Parasite prevention","h2")
p=Card([q])
q=Column([r,s],"sm",padding=16)
r=Text("Use a vet-directed deworming and flea-prevention plan; indoor cats can still pick up parasites through shoes, litter, shared spaces, or prey exposure.","caption")
s=Text("Many adult cats are dewormed about four times per year; your veterinarian may adjust this based on lifestyle and local risk.","caption")
t=Icon("[PARASITE_ICON]")
u=Column([v,w,x],gap="md")
v=Text("Nutrition and dental care","h2")
w=Card([x])
x=Column([y,z],"sm",padding=16)
y=Text("Feed a complete, balanced cat food with fresh water; milk is not a routine substitute for water.","caption")
z=Text("Support dental health with regular tooth brushing and annual mouth checks during wellness visits; your vet may recommend professional cleaning if plaque or tartar builds up.","caption")
aa=Text("End of checklist.","h3")
</a2ui>