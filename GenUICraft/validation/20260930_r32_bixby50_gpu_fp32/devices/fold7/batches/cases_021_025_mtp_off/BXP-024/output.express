<a2ui>
$/={collection_options:[{option:"Drop-off at a certified recycler or collection centre",details:"Bengaluru options listed in the search results include RecycleKaro’s Bengaluru facility, Saahas, Croma stores, and other listed recyclers/collection points that accept batteries.[9]"},{option:"Scheduled home pickup",details:"RecycleKaro and EcoFlyp both describe pickup services, and Zolopik also offers pickup for battery/e-waste collection in Bengaluru.[7][10]"},{option:"Manufacturer or brand take-back",details:"Some brands and authorised partners offer battery/e-waste return programs, including brand-linked collection or pickup arrangements.[5]"}]}
root=Column([a,b,c,f,k,r,y,ab],gap="md",padding=16)
a=Text("A Bengaluru resident should dispose of a used laptop battery through a certified e-waste recycler, authorised collection centre, or verified manufacturer take-back/pickup service that explicitly accepts batteries.[1][2][14] RecycleKaro lists Bengaluru drop-off and pickup options, EcoFlyp lists multiple Bengaluru organisations and drop-off points that accept batteries, and RecycleKaro’s guidance specifically says to use CPCB or KSPCB-authorized recyclers.",variant="body")
b=Text("Approved collection options","h2")
c=Card([d])
d=Table(columns=[{key:"option",label:"Option"},{key:"details",label:"Details"}],statePath="/collection_options",domain="generic",preferredPresentation="cards")
f=Text("Storage precautions before handing it over","h2")
g=Card([h])
h=Column([i,j,k,l,m],"sm")
i=Text("Keep the battery separate from regular waste and do not put it in household garbage.",variant="body")
j=Text("Store it in a cool, dry place away from heat, sunlight, and moisture; keep it out of reach of children and pets.",variant="body")
k=Text("Do not puncture, crush, bend, or open it; if it is swollen or damaged, handle it especially carefully and do not force it.",variant="body")
l=Text("Tape the terminals if it is loose and place it in a non-conductive container or bag to reduce the risk of short-circuiting.",variant="body")
m=Text("Do not keep it near metal objects such as coins, keys, or tools that could bridge the terminals.",variant="body")
n=Text("What to verify before handing it over","h2")
o=Card([p])
p=Column([q,r,s,t,u,v],"sm")
q=Text("Authorization: Confirm that the recycler or pickup service is CPCB/KSPCB-authorized or otherwise clearly certified.",variant="body")
r=Text("Battery acceptance: Verify that the centre accepts laptop batteries specifically, since some points accept only certain categories of e-waste.[4]",variant="body")
s=Text("Pickup/drop-off terms: Check whether it is a free drop-off, scheduled pickup, or paid service, and whether any minimum quantity applies.",variant="body")
t=Text("Receipt or confirmation: Ask for written or digital proof that the battery was received for lawful recycling or disposal.",variant="body")
u=Text("Data-related items: If you are also handing over the laptop, back up data, sign out of accounts, and factory reset the device first; this is less relevant for the battery alone but important if the laptop is included.[3]",variant="body")
v=Text("Condition reporting: Tell the handler whether the battery is swollen, leaking, or physically damaged so they can apply the right handling process.",variant="body")
w=Text("If you want, I can also help you find the nearest Bengaluru drop-off option from the listed centres and pick the most convenient one.",variant="body")
</a2ui>