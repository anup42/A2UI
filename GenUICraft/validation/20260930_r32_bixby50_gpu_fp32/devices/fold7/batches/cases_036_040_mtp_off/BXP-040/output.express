<a2ui>
root=Column([a,b,c,f,k,r,w,ab,ae],gap="md",padding=16)
a=Text("What to keep as evidence","h2")
b=Text("Save the order confirmation, invoice/bill, product listing screenshots, and payment proof.",variant="body")
c=Card([d])
d=Column([e,f,g,h],"sm")
e=Text("Take photos or videos of the defect, ideally during unboxing, and keep the packaging, labels, and accessories.",variant="body")
f=Column([g,h,i,j],"sm")
g=Text("Preserve all emails, chat logs, complaint ticket numbers, pickup receipts, and return/refund status updates.",variant="body")
h=Text("If the product was inspected or repaired, keep any job sheet or written service report.",variant="body")
i=Text("First complaint: seller and platform","h2")
j=Text("Report the defect immediately in writing through the app, email, or seller support, and clearly ask for refund, replacement, or repair.",variant="body")
k=Card([l])
l=Column([m,n,o],"sm")
m=Text("If the marketplace route fails, escalate to the platform’s grievance officer/nodal contact and include the order number, defect details, evidence, and the exact remedy sought.",variant="body")
n=Text("Under current consumer guidance, platform-side redressal should be triggered quickly; some guidance cites a 72-hour response expectation for defective goods, but this should be treated as a platform-facing service timeline rather than a guaranteed statutory remedy window.",variant="body")
o=Text("Official grievance channels","h2")
p=Text("Use the National Consumer Helpline (NCH) as the pre-litigation escalation step; official consumer guidance lists 1915 as the toll-free helpline, with online and app-based complaint options.",variant="body")
q=Text("File the grievance with enough detail so the complaint can be forwarded and tracked: seller name, platform name, order ID, issue summary, evidence list, and the remedy requested.",variant="body")
r=Card([s])
s=Column([t,u,v],"sm")
t=Text("Escalation if the issue is not resolved","h2")
u=Text("If the seller/platform does not resolve the matter, file a complaint on e-Daakhil for the appropriate Consumer Commission.",variant="body")
v=Text("Choose the commission based on the value and jurisdiction of the claim; current consumer-law guides direct consumers to the District, State, or National Commission through the online filing system.",variant="body")
w=Card([x])
x=Column([y,z,aa],"sm")
y=Text("Deadlines and timing","h2")
z=Text("The consumer complaint limitation period is generally 2 years from the cause of action under the Consumer Protection Act framework and related guidance.",variant="body")
aa=Text("Act as soon as the defect is discovered, because delay can weaken evidence and make platform reversals harder to obtain.",variant="body")
ab=Card([ac])
ac=Column([ad,ae,af],"sm")
ad=Text("Practical approach","h2")
ae=Text("Keep the defective item safe until the dispute is resolved, because the seller or platform may require inspection or return.",variant="body")
af=Text("Use written communication only where possible, since a clear paper trail helps at every escalation stage.",variant="body")
ag=Text("If the seller offers only store credit or a voucher for a clearly defective product, you can still press for the statutory remedy you want through the grievance and consumer-forum process.",variant="body")
ah=Button("Continue","borderless",onPress=openUrl("https://www.consumerprotection.gov.au"))
</a2ui>