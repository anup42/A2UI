<a2ui>
$/={comparison_data:[{factor:"Curriculum",cbse:"Built around NCERT and a structured, concept-based syllabus; it is widely aligned with Indian competitive exams such as JEE, NEET, and CUET.[1][3]",cise:"A broader, more content-rich syllabus with strong language depth and separate treatment of subjects such as History/Civics and Geography from middle school onward.",ib:"Inquiry-based, concept-led, and interdisciplinary, with programmes such as MYP and DP designed around global-minded learning.[4]",transferability:"Transfers most cleanly between CBSE schools within India; CBSE also has the broadest domestic footprint.[8][11]"},{factor:"Assessment",cbse:"More exam-led, with longer papers and many question types covering recall, understanding, application, and evaluation.",cise:"Exam-heavy but typically more descriptive and detailed, with required external assessment and internal components.[5]",ib:"Uses a mix of internal and external assessment; MYP external assessment is optional, and DP adds essays, projects, and other coursework-heavy elements.[7]",transferability:"Transfers best within CISCE schools, but the smaller school network can make moves less convenient than CBSE."},{factor:"Subject flexibility",cbse:"Generally more structured with fewer combinations than international curricula.[13]",cise:"Moderate flexibility, but still more fixed than IB.",ib:"Greater flexibility, especially in subject choice and in how learners connect disciplines.",transferability:"Transfers most cleanly between CBSE schools within India; CBSE also has the broadest domestic footprint.[8][11]"}]}
root=Column([a,b,c,g,k,o,u],gap="md",padding=16)
a=Text("Quick comparison","h2")
b=Table(columns=[{key:"factor",label:"Factor"},{key:"cbse",label:"CBSE"},{key:"cise",label:"CISCE"},{key:"ib",label:"IB"}],statePath="/comparison_data",domain="comparison",preferredPresentation="table")
c=Card([d])
d=Column([e,f,g],"sm",padding=16)
e=Text("What each board suits best","h2")
f=Text("CBSE works well for families prioritizing a clear syllabus, frequent school availability, and a strong fit with Indian entrance-exam preparation.",variant="body")
g=Text("CISCE suits students who want more depth, stronger English exposure, and a broader academic experience across sciences, humanities, and languages.",variant="body")
h=Text("IB suits students who thrive on discussion, projects, research, and a less exam-dominant approach, especially if the family values global mobility.",variant="body")
i=Text("Questions to ask prospective schools","h2")
j=Column([k,l,m,n,o,p,q,r],"sm")
k=Text("Which programme do you actually offer at secondary level: CBSE, ICSE/ISC, or IB MYP/DP?",variant="body")
l=Text("How many subject combinations are available in Classes 9–10 and 11–12, and can students change them later?",variant="body")
m=Text("What proportion of marks comes from board exams, internal assessment, projects, practicals, and coursework?",variant="body")
n=Text("How do you support students who may transfer to another school or board in the future?",variant="body")
o=Text("For IB schools, which subjects are offered in the school, and how do they align with university goals?",variant="body")
p=Text("For CBSE or CISCE schools, how do you balance board preparation with deeper learning and stress management?",variant="body")
q=Text("What are the class sizes, teacher qualifications, lab resources, and language support for the secondary years?",variant="body")
r=Text("Current fee, seat-availability, and school-specific transfer data were not consistently available across the sources, so families should verify these directly with each school.",variant="body")
s=Button("Continue","borderless",オンPress=openUrl("[ACTION_URL_1]"))
</a2ui>