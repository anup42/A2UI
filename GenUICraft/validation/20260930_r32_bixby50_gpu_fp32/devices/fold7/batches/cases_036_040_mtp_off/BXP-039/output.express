<a2ui>
$/={documents_required:[{item:"Photo ID proof of the owner, such as Aadhaar, PAN, Passport, or Voter ID.",detail:"Proof of identity"},{item:"Address proof of the applicant, such as an electricity bill, rent agreement, or other official address document.",detail:"Proof of location"},{item:"Passport-size photograph of the applicant.",detail:"Photo"},{item:"Proof of business premises, such as utility bills, property documents, or a NOC from the landlord if the kitchen is rented.",detail:"Premises Proof"},{item:"Business details and product list, especially for bakery items and other foods made at home.",detail:"Business Details"}]}
root=Column([a,d,i,r,x],gap="md",padding=16)
a=Column([b,c],"sm")
b=Text("Eligibility for a small home bakery","h2")
c=Text("A home bakery in Karnataka generally falls under FSSAI Basic Registration if its annual turnover is up to ₹12 lakh; FSSAI states that registration is meant for petty food businesses and small or cottage-scale industry with turnover up to this limit.[12][14] For turnover above ₹12 lakh, a State License is required instead of registration.[1]",variant="body")
d=Card([e])
e=Column([f,g,h],gap="md",padding=16)
f=Text("Documents usually required","h2")
g=Text("For a small home bakery applying for Basic Registration, the commonly required documents are:",variant="body")
h=Table(columns=[{key:"item",label:"Document Required"},{key:"detail",label:"Purpose"}],statePath="/documents_required",domain="generic",preferredPresentation="cards")
i=Card([j])
j=Column([k,l,m],"sm",padding=16)
k=Text("Official application steps","h2")
l=Text("The official application is made on the FoSCoS portal, which is FSSAI’s licensing and registration system.[9] The standard process is:",variant="body")
m=Column([n,o,p,q,r,s],"sm")
n=Text("Create an account on the FoSCoS portal and log in.",variant="body")
o=Text("Select Apply for License/Registration and choose Registration (Form A) for a petty food business.",variant="body")
p=Text("Enter business details, premises address, and food activity information.",variant="body")
q=Text("Upload the required documents in the prescribed format.",variant="body")
r=Text("Pay the fee online and submit the application.",variant="body")
s=Text("Track the application using the reference or UARN number, and download the certificate once approved.",variant="body")
t=Card([u])
u=Column([v,w,x],"sm",padding=16)
v=Text("Published fees","h2")
w=Text("FSSAI regulations require registration with a fee under the prescribed schedule, and the FoSCoS guidance reflects the standard registration fee structure for petty food businesses.[13] The commonly published fee is ₹100 per year, with multiple-year options also used on the portal.[4] For a home bakery applying as a small business, this is the usual Basic Registration fee referenced by registration guides and the official fee schedule framework.",variant="body")
x=Card([y])
y=Column([z,aa],"sm",padding=16)
z=Text("Common mistakes that cause delay or rejection","h2")
aa=Column([ab,ac,ad,ae,af],"sm")
ab=Text("Choosing the wrong category, such as applying for registration when turnover is above ₹12 lakh and a State License is needed.",variant="body")
ac=Text("Missing or unclear documents, especially address proof or landlord NOC for a rented home kitchen.",variant="body")
ad=Text("Incorrect form selection, since petty businesses must file Form A, not the licensing form used for larger units.",variant="body")
ae=Text("Mismatch in business details, such as inconsistent name, address, or activity description across documents and the portal form.",variant="body")
af=Text("Not preparing product and premises details properly, which can slow scrutiny or lead to queries.",variant="body")
ag=Text("If you want, I can also turn this into a Karnataka home-bakery checklist you can use before applying.",variant="body")
</a2ui>