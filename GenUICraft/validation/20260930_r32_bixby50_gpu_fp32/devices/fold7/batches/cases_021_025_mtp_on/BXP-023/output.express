<a2ui>
root=Column([a,b,c,f,o],gap="md",padding=16)
a=Text("Veterinary checkups","h2")
b=Card([c])
c=Column([d,e],"sm",padding=16)
d=Text("Schedule a wellness exam at least once a year; the vet should review weight, body condition, skin/coat, heart/lungs, teeth, and any behavior or litter-box changes. Indoor cats still need routine preventive care because problems can be missed early.",variant="body")
e=Text("[10]","caption")
f=Column([g,h,i,j],gap="md")
g=Text("Vaccinations","h2")
h=Card([i])
i=Column([j,k],"sm",padding=16)
j=Text("Discuss whether your cat’s FVRCP and rabies vaccines are current; these are core protections for cats in India.",variant="body")
k=Text("[1]","caption")
l=Card([m])
m=Column([n,o],"sm",padding=16)
n=Text("For adult low-risk cats, FVRCP boosters are often given every 1–3 years depending on the vaccine and vet advice, while rabies timing should follow local rules and the product label.",variant="body")
o=Text("[12]","caption")
p=Card([q])
q=Column([r,s],"sm",padding=16)
r=Text("Ask your vet about FeLV only if your cat has exposure risk, such as outdoor access or contact with other cats of unknown status.",variant="body")
s=Text("[14]","caption")
t=Column([u,v,w,x],gap="md")
u=Text("Parasite prevention","h2")
v=Card([w])
w=Column([x,y],"sm",padding=16)
x=Text("Use a vet-directed deworming and flea-prevention plan; indoor cats can still pick up parasites through shoes, litter, shared spaces, or prey exposure.",variant="body")
y=Text("[13][15]","caption")
z=Card([aa])
aa=Column([ab,ac],"sm",padding=16)
ab=Text("Many adult cats are dewormed about four times per year; your veterinarian may adjust this based on lifestyle and local risk.",variant="body")
ac=Text("[13][15]","caption")
ad=Column([ae,af,ag],gap="md")
ae=Text("Nutrition and dental care","h2")
af=Card([ag])
ag=Column([ah,ai],"sm",padding=16)
ah=Text("Feed a complete, balanced cat food with fresh water; milk is not a routine substitute for water.",variant="body")
ai=Text("[13]","caption")
aj=Card([ak])
ak=Column([al,am],"sm",padding=16)
al=Text("Support dental health with regular tooth brushing and annual mouth checks during wellness visits; your vet may recommend professional cleaning if plaque or tartar builds up.",variant="body")
am=Text("[13]","caption")
</a2ui>