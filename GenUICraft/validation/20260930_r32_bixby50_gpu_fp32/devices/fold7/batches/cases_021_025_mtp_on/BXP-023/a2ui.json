[{"version":"v0.9","createSurface":{"surfaceId":"default_surface","catalogId":"https://genui.samsung.com/a2ui/catalogs/genuicraft-mobile/v1","sendDataModel":false}},{"version":"v0.9","updateComponents":{"surfaceId":"default_surface","components":[{"id":"root","component":"Stack","direction":"vertical","gap":"md","padding":16,"children":["a","b","f","l","m","p","t","z","ad","aj"]},{"id":"a","component":"Text","text":"Veterinary checkups","variant":"h2"},{"id":"b","component":"Card","children":["c"]},{"id":"c","component":"Stack","direction":"vertical","gap":"sm","padding":16,"children":["d","e"]},{"id":"d","component":"Text","text":"Schedule a wellness exam at least once a year; the vet should review weight, body condition, skin/coat, heart/lungs, teeth, and any behavior or litter-box changes. Indoor cats still need routine preventive care because problems can be missed early.","variant":"body"},{"id":"e","component":"Text","text":"[10]","variant":"caption"},{"id":"f","component":"Stack","direction":"vertical","gap":"md","children":["g","h","i","j"]},{"id":"g","component":"Text","text":"Vaccinations","variant":"h2"},{"id":"h","component":"Card","children":["i"]},{"id":"i","component":"Stack","direction":"vertical","gap":"sm","padding":16,"children":["j","k"]},{"id":"j","component":"Text","text":"Discuss whether your cat’s FVRCP and rabies vaccines are current; these are core protections for cats in India.","variant":"body"},{"id":"k","component":"Text","text":"[1]","variant":"caption"},{"id":"l","component":"Text","text":"[12]","variant":"caption"},{"id":"m","component":"Card","children":["n"]},{"id":"n","component":"Stack","direction":"vertical","gap":"sm","padding":16,"children":["o"]},{"id":"o","component":"Text","text":"For adult low-risk cats, FVRCP boosters are often given every 1–3 years depending on the vaccine and vet advice, while rabies timing should follow local rules and the product label.","variant":"body"},{"id":"p","component":"Card","children":["q"]},{"id":"q","component":"Stack","direction":"vertical","gap":"sm","padding":16,"children":["r","s"]},{"id":"r","component":"Text","text":"Ask your vet about FeLV only if your cat has exposure risk, such as outdoor access or contact with other cats of unknown status.","variant":"body"},{"id":"s","component":"Text","text":"[14]","variant":"caption"},{"id":"t","component":"Stack","direction":"vertical","gap":"md","children":["u","v","w","x"]},{"id":"u","component":"Text","text":"Parasite prevention","variant":"h2"},{"id":"v","component":"Card","children":["w"]},{"id":"w","component":"Stack","direction":"vertical","gap":"sm","padding":16,"children":["x","y"]},{"id":"x","component":"Text","text":"Use a vet-directed deworming and flea-prevention plan; indoor cats can still pick up parasites through shoes, litter, shared spaces, or prey exposure.","variant":"body"},{"id":"y","component":"Text","text":"[13][15]","variant":"caption"},{"id":"z","component":"Card","children":["aa"]},{"id":"aa","component":"Stack","direction":"vertical","gap":"sm","padding":16,"children":["ab","ac"]},{"id":"ab","component":"Text","text":"Many adult cats are dewormed about four times per year; your veterinarian may adjust this based on lifestyle and local risk.","variant":"body"},{"id":"ac","component":"Text","text":"[13][15]","variant":"caption"},{"id":"ad","component":"Stack","direction":"vertical","gap":"md","children":["ae","af","ag"]},{"id":"ae","component":"Text","text":"Nutrition and dental care","variant":"h2"},{"id":"af","component":"Card","children":["ag"]},{"id":"ag","component":"Stack","direction":"vertical","gap":"sm","padding":16,"children":["ah","ai"]},{"id":"ah","component":"Text","text":"Feed a complete, balanced cat food with fresh water; milk is not a routine substitute for water.","variant":"body"},{"id":"ai","component":"Text","text":"[13]","variant":"caption"},{"id":"aj","component":"Card","children":["ak"]},{"id":"ak","component":"Stack","direction":"vertical","gap":"sm","padding":16,"children":["al","am"]},{"id":"al","component":"Text","text":"Support dental health with regular tooth brushing and annual mouth checks during wellness visits; your vet may recommend professional cleaning if plaque or tartar builds up.","variant":"body"},{"id":"am","component":"Text","text":"[13]","variant":"caption"}]}}]