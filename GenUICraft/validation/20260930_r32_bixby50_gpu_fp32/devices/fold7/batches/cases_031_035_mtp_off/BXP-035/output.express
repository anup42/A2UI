<a2ui>
$/={plan_data:[{week:"Week 1",walk:"Walk 5 days: 10 minutes at a comfortable brisk pace; use the “can talk, not sing” test to stay moderate.",strength:"Strength 2 days, after a walk or on separate days: chair sit-to-stands, wall push-ups, glute bridges, standing calf raises, and bird-dogs. Do 1 set of 6-8 reps each.",recovery:"Recovery: 2 full rest days, with light stretching or easy strolling only."},{week:"Week 2",walk:"Walk 5 days: 12-15 minutes per session.",strength:"Strength 2 days: the same exercises, 1-2 sets of 8 reps each.",recovery:"Recovery: keep one day completely off and one day very light if you feel sore."},{week:"Week 3",walk:"Walk 5 days: 18-20 minutes per session, or split into two short walks if needed.",strength:"Strength 2 days: 2 sets of 8-10 reps each, moving slowly and with control.",recovery:"Add 3-5 minutes of balance work after one or two sessions: tandem walking, side steps, or single-leg stands near a wall."},{week:"Week 4",walk:"Walk 5 days: 20-25 minutes per session. If this feels easy, add a few one-minute faster intervals.",strength:"Strength 2-3 days: 2 sets of 10-12 reps, keeping form first and stopping before failure.",recovery:"Recovery: keep at least 1-2 easier days each week."}],exercises_list:[{exercise:"Chair sit-to-stand",detail:"Chair sit-to-stand."},{exercise:"Wall push-up",detail:"Wall push-up."},{exercise:"Glute bridge",detail:"Glute bridge."},{exercise:"Standing calf raise",detail:"Standing calf raise."},{exercise:"Bird-dog or dead bug",detail:"Bird-dog or dead bug for core control."},{exercise:"Side step, heel-to-toe walk, or single-leg stand",detail:"Side step, heel-to-toe walk, or single-leg stand for balance."}]}
root=Column([a,d,g,k,o,u,z],gap="md",padding=16)
a=Column([b,c],"sm")
b=Text("Four-Week Plan","h2")
c=Text("This plan is designed for a healthy sedentary adult and follows public guidance to build toward about 150 minutes of moderate walking per week plus strength work at least 2 days weekly.",variant="body")
d=Card([e])
e=Column([f,g],"sm")
f=Text("Week 1","h3")
g=Table(columns=[{key:"week",label:"Week"},{key:"walk",label:"Walk"},{key:"strength",label:"Strength"},{key:"recovery",label:"Recovery"}],statePath="/plan_data",domain="schedule",preferredPresentation="cards",primaryColumn="week")
h=Card([i])
i=Column([j,k],"sm")
j=Text("Week 2","h3")
k=Table(columns=[{key:"week",label:"Week"},{key:"walk",label:"Walk"},{key:"strength",label:"Strength"},{key:"recovery",label:"Recovery"}],statePath="/plan_data",domain="schedule",preferredPresentation="cards",primaryColumn="week")
l=Card([m])
m=Column([n,o],"sm")
n=Text("Week 3","h3")
o=Table(columns=[{key:"week",label:"Week"},{key:"walk",label:"Walk"},{key:"strength",label:"Strength"},{key:"recovery",label:"Recovery"}],statePath="/plan_data",domain="schedule",preferredPresentation="cards",primaryColumn="week")
p=Card([q])
q=Column([r,s],"sm")
r=Text("Week 4","h3")
s=Table(columns=[{key:"week",label:"Week"},{key:"walk",label:"Walk"},{key:"strength",label:"Strength"},{key:"recovery",label:"Recovery"}],statePath="/plan_data",domain="schedule",preferredPresentation="cards",primaryColumn="week")
t=Card([u])
u=Column([v,w],"sm")
v=Text("Simple Exercises","h3")
w=Table(columns=[{key:"exercise",label:"Exercise"},{key:"detail",label:"Detail"}],statePath="/exercises_list",domain="generic",preferredPresentation="table")
x=Card([y])
y=Column([z,aa],"sm")
z=Text("When To Stop","h3")
aa=Text("Stop exercise right away if you have chest pain or tightness, dizziness, faintness, unusual shortness of breath that stops you talking comfortably, palpitations, nausea, or feel cold and clammy.",variant="body")
ab=Card([ac])
ac=Column([ad,ae],"sm")
ad=Text("How To Adjust","h3")
ae=Text("Too hard: shorten the walk, slow the pace, reduce to 1 set, or use a higher chair or wall support.\nToo easy: add 5 minutes to walking, add a set, or use slower lowering on strength moves.\nIf sore: keep moving lightly, but skip hard sessions until normal soreness settles.",variant="body")
