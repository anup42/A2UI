<a2ui>
$/={documents:[{doc:"RERA registration certificate",details:"Confirms the project is registered under Karnataka RERA, which is required for qualifying apartment projects; verify it on the Karnataka RERA portal using the project name or registration number.",source:"[1][3][4][9]"},{doc:"Sanctioned building plan",details:"Confirms the building layout, floors, and units were approved by the competent authority; verify it with the BBMP, BDA, or other local planning authority and cross-check the same plan details against RERA records.",source:"[13]"},{doc:"Title documents / title chain",details:"Establishes who owns the land and whether the seller has a valid right to transfer it; verify the mother deed, prior sale deeds, partition deeds, and related title records at the Sub-Registrar’s office or through Karnataka’s registration record system, and have an independent lawyer review the chain.",source:"[2][5][10][14][15]"},{doc:"Occupancy Certificate (OC)",details:"Confirms the building has been certified fit for occupation and generally matches approved norms; verify it with the BBMP or the issuing municipal/planning authority before taking possession.",source:"[7]"},{doc:"Encumbrance Certificate (EC)",details:"Shows registered transactions and helps identify mortgages, charges, attachments, or other encumbrances on the property; verify it at the Sub-Registrar’s office or through Karnataka’s online registration services, and ensure the period covered is sufficiently long.",source:"[2][5][10][14]"}],verification_points:[{point:"RERA registration",check:"Should match the developer name, project name, location, phase, and registration number shown in the brochure and agreement; if the project is not listed on the Karnataka RERA portal, that is a major warning sign."},{point:"Sanctioned plan",check:"Should match the actual apartment layout, number of floors, and unit configuration being sold; deviations between the approved plan and marketing material should be treated as a red flag."},{point:"Title chain",check:"Should be continuous and unbroken, showing clear ownership from the root document to the present seller; missing links, unregistered transfers, or mismatched names require legal clarification."},{point:"OC",check:"Should exist for ready-to-move flats; possession without it can indicate the building has not been fully regularised for occupation."},{point:"EC",check:"Should be checked for undisclosed loans, attachments, or other registered claims; any active charge should be resolved before purchase."}],verification_locations:[{location:"Karnataka RERA portal",check:"RERA registration details, promoter/project status, and related project disclosures."},{location:"BBMP / BDA / local planning authority",check:"Sanctioned building plan and, where applicable, Occupancy Certificate and other municipal approvals."},{location:"Sub-Registrar’s office / Karnataka registration records",check:"Title deeds, sale deed chain, and Encumbrance Certificate."},{location:"Independent property lawyer",check:"Final legal review of title chain, approvals, and any inconsistencies before payment."}],checklist_items:[{item:"RERA registration",status:"Valid and matches the project."},{item:"Sanctioned plan",status:"Matches what is being sold."},{item:"Title chain",status:"Is clear and complete."},{item:"OC",status:"Is available for a ready apartment."},{item:"EC",status:"Shows no unresolved encumbrance."}]}
root=Column([a,b,c,f,i,o,s,x],gap="md",padding=16)
a=Text("Pre-purchase document checklist for an apartment in Karnataka","h2")
b=Table(columns=[{key:"doc",label:"Document"},{key:"details",label:"Details"},{key:"source",label:"Source"}],statePath="/documents",domain="generic",preferredPresentation="cards",primaryColumn="doc")
c=Column([d,e],"sm")
d=Text("What each document should tell you","h2")
e=Table(columns=[{key:"point",label:"Document"},{key:"check",label:"What it tells you"}],statePath="/verification_points",domain="status",preferredPresentation="cards",primaryColumn="point")
f=Column([g,h],"sm")
g=Text("Where to verify each item","h2")
h=Table(columns=[{key:"location",label:"Verification Location"},{key:"check",label:"What to Verify"}],statePath="/verification_locations",domain="generic",preferredPresentation="cards",primaryColumn="location")
i=Column([j,k],"sm")
j=Text("Minimal buy-only-if checklist","h2")
k=Table(columns=[{key:"item",label:"Checklist Item"},{key:"status",label:"Status"}],statePath="/checklist_items",domain="status",preferredPresentation="cards",primaryColumn="item")
l=Text("Current official portal data can change, so verify the latest records directly before paying any booking amount.","caption")
m=Button("Continue","primary",/"/verification_locations)
