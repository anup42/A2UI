<a2ui>
$/={document_checklist:[{item:"RERA registration certificate",details:"Confirms the project is registered under Karnataka RERA, which is required for qualifying apartment projects; verify it on the Karnataka RERA portal using the project name or registration number.",source:"[1][3][4][9]"},{item:"Sanctioned building plan",details:"Confirms the building layout, floors, and units were approved by the competent authority; verify it with the BBMP, BDA, or other local planning authority and cross-check the same plan details against RERA records.",source:"[13]"},{item:"Title documents / title chain",details:"Establishes who owns the land and whether the seller has a valid right to transfer it; verify the mother deed, prior sale deeds, partition deeds, and related title records at the Sub-Registrar’s office or through Karnataka’s registration record system, and have an independent lawyer review the chain.",source:"[2][5][10][14][15]"},{item:"Occupancy Certificate (OC)",details:"Confirms the building has been certified fit for occupation and generally matches approved norms; verify it with the BBMP or the issuing municipal/planning authority before taking possession.",source:"[7]"},{item:"Encumbrance Certificate (EC)",details:"Shows registered transactions and helps identify mortgages, charges, attachments, or other encumbrances on the property; verify it at the Sub-Registrar’s office or through Karnataka’s online registration services, and ensure the period covered is sufficiently long.",source:"[12]"}],verification_points:[{verification:"Karnataka RERA portal",details:"RERA registration details, promoter/project status, and related project disclosures.",source:"[12]"},{verification:"BBMP / BDA / local planning authority",details:"Sanctioned building plan and, where applicable, Occupancy Certificate and other municipal approvals.",source:"[12]"},{verification:"Sub-Registrar’s office / Karnataka registration records",details:"Title deeds, sale deed chain, and Encumbrance Certificate.",source:"[12]"},{verification:"Independent property lawyer",details:"Final legal review of title chain, approvals, and any inconsistencies before payment.",source:"[12]"}],buy_only_checklist:[{item:"RERA registration",details:"is valid and matches the project",source:"Checklist"},{item:"Sanctioned plan",details:"matches what is being sold",source:"Checklist"},{item:"Title chain",details:"is clear and complete",source:"Checklist"},{item:"OC",details:"is available for a ready apartment",source:"Checklist"},{item:"EC",details:"shows no unresolved encumbrance",source:"Checklist"}]}
root=Column([a,b,c,g,l,p,v],gap="md",padding=16)
a=Text("Pre-purchase document checklist for an apartment in Karnataka","h2")
b=Table(columns=[{key:"item",label:"Document"},{key:"details",label:"What it tells you"},{key:"source",label:"Verification Source"}],statePath="/document_checklist",domain="generic",preferredPresentation="cards",primaryColumn="item")
c=Column([d,e],"sm")
d=Text("What each document should tell you","h2")
e=Table(columns=[{key:"item",label:"Document"},{key:"details",label:"Key takeaway"}],statePath="/verification_points",domain="generic",preferredPresentation="cards",primaryColumn="item")
f=Column([g,h],"sm")
g=Text("Where to verify each item","h2")
h=Table(columns=[{key:"verification",label:"Verification Body"},{key:"details",label:"What to check"}],statePath="/verification_points",domain="generic",preferredPresentation="cards",primaryColumn="verification")
i=Column([j,k],"sm")
j=Text("Minimal buy-only-if checklist","h2")
k=Table(columns=[{key:"item",label:"Checklist Item"},{key:"details",label:"Requirement"}],statePath="/buy_only_checklist",domain="status",preferredPresentation="cards",primaryColumn="item")
l=Text("Current official portal data can change, so verify the latest records directly before paying any booking amount.","caption")
m=openUrl("[ACTION_URL_1]")
</a2ui>