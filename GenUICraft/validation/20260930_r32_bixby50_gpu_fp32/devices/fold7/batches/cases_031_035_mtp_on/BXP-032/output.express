<a2ui>
$/={key_terms:[{term:"Deductible",meaning:"A fixed amount you must pay before the insurer pays any admissible claim. In indemnity plans, it is a rupee threshold. [3]",effect:"The insurer starts paying only after the deductible is crossed."},{term:"Co-payment",meaning:"A percentage of the admissible claim that you must bear. It does not reduce the sum insured, but it reduces what the insurer pays for that claim.",effect:"You share the bill in a fixed ratio, such as 10% or 20%."},{term:"Waiting period",meaning:"A period after policy start during which certain claims are not payable. Standard policies generally have a 30-day initial waiting period, and pre-existing-disease waiting periods are commonly capped at 36 months in newer IRDAI-regulated products. [5][7]",effect:"Claims during the waiting period may be fully rejected."},{term:"Room-rent limit",meaning:"A cap on the hospital room charge covered by the policy, often linked to a percentage of the sum insured. [12]",effect:"If you choose a costlier room, some policies reduce payment for other hospital charges in the same proportion."},{term:"Exclusions",meaning:"Treatments or situations the policy does not cover at all, such as pre-existing disease during the waiting period, many non-medical items, cosmetic care, and other listed exclusions. [13][20]",effect:"The insurer pays nothing for excluded items or events."}]}
root=Column([a,b,c,d,e,f,g,h,i,j,k,l,m,n,o,p,q,r,s,t