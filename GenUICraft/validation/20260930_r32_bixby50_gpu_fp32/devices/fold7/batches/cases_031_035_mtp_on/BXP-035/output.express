<a2ui>
$/={weekly_plan:[{week:"Week 1",walk:"Walk 5 days: 10 minutes at a comfortable brisk pace; use the “can talk, not sing” test to stay moderate.",strength:"Strength 2 days, after a walk or on separate days: chair sit-to-stands, wall push-ups, glute bridges, standing calf raises, and bird-dogs. Do 1 set of 6-8 reps each.",recovery:"2 full rest days, with light stretching or easy strolling only."},{week:"Week 2",walk:"Walk 5 days: 12-15 minutes per session.",strength:"Strength 2 days: the same exercises, 1-2 sets of 8 reps each.",recovery:"keep one day completely off and one day very light if you feel sore."},{week:"Week 3",walk:"Walk 5 days: 18-20 minutes per session, or split into two short walks if needed.",strength:"Strength 2 days: 2 sets of 8-10 reps each, moving slowly and with control.",recovery:"Add 3-5 minutes of balance work after one or two sessions: tandem walking, side steps, or single-leg stands near a wall."},{week:"Week 4",walk:"Walk 5 days: 20-25 minutes per session. If this feels easy, add a few one-minute faster intervals.",strength:"Strength 2-3 days: 2 sets of 10-12 reps, keeping form first and stopping before failure.",recovery:"keep at least 1-2 easier days each week."}],exercises:[{exercise:"Chair sit-to-stand"},{exercise:"Wall push-up"},{exercise:"Glute bridge"},{exercise:"Standing calf raise"},{exercise:"Bird-dog or dead bug for core control"},{exercise:"Side step, heel-to-toe walk, or single-leg stand for balance"}]}
root=Column([a,b,c,f,i,l,p,v],gap="md",padding=16)
a=Text("Four-Week Plan","h2")
b=Text("This plan is designed for a healthy sedentary adult and follows public guidance to build toward about 150 minutes of moderate walking per week plus strength work at least 2 days weekly.",variant="body")
c=Card([d,e])
d=Text("Week 1","h3")
e=Table(columns=[{key:"week",label:"Week"},{key:"walk",label:"Walk"},{key:"strength",label:"Strength"},{key:"recovery",label:"Recovery"}],statePath="/weekly_plan",domain="schedule",preferredPresentation="cards",primaryColumn="week")
f=Card([g,h])
g=Text("Week 2","h3")
h=Table(columns=[{key:"week",label:"Week"},{key:"walk",label:"Walk"},{key:"strength",label:"Strength"},{key:"recovery",label:"Recovery"}],statePath="/weekly_plan",domain="schedule",preferredPresentation="cards",primaryColumn="week")
i=Card([j,k])
j=Text("Week 3","h3")
k=Table(columns=[{key:"week",label:"Week"},{key:"walk",label:"Walk"},{key:"strength",label:"Strength"},{key:"recovery",label:"Recovery"}],statePath="/weekly_plan",domain="schedule",preferredPresentation="cards",primaryColumn="week")
l=Card([m,n])
m=Text("Week 4","h3")
n=Table(columns=[{key:"week",label:"Week"},{key:"walk",label:"Walk"},{key:"strength",label:"Strength"},{key:"recovery",label:"Recovery"}],statePath="/weekly_plan",domain="schedule",preferredPresentation="cards",primaryColumn="week")
o=Column([p,q],"sm")
p=Text("Simple Exercises","h2")
q=Table(columns=[{key:"exercise",label:"Exercise"}],statePath="/exercises",domain="generic",preferredPresentation="table")
r=Card([s,t])
s=Text("When To Stop","h2")
t=Text("Stop exercise right away if you have chest pain or tightness, dizziness, faintness, unusual shortness of breath that stops you talking comfortably, palpitations, nausea, or feel cold and clammy.",variant="body")
u=Card([v,w])
v=Text("How To Adjust","h2")
w=Column([x,y,z],"sm")
x=Text("Too hard: shorten the walk, slow the pace, reduce to 1 set, or use a higher chair or wall support.",variant="body")
y=Text("Too easy: add 5 minutes to walking, add a set, or use slower lowering on strength moves.",variant="body")
z=Text("If sore: keep moving lightly, but skip hard sessions until normal soreness settles.",variant="body")
</a2ui>