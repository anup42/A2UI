<a2ui>
root=Column([a,g,n,u],gap="md",padding=16)
a=Card([b])
b=Column([c,d],"sm",padding=16)
c=Text("Operating hours","h2")
d=Column([e,f],"sm")
e=Text("Weekdays/Saturdays: Most sources show service starting around 5:00 AM and ending around 11:05 PM on the Purple and Green lines; the Yellow Line runs later in the evening from RV Road, up to 11:55 PM from that station.","caption")
f=Text("Sundays: Trains generally start at 7:00 AM.","caption")
g=Card([h])
h=Column([i,j],"sm",padding=16)
i=Text("Ticket and pass options","h2")
j=Column([k,l,m,n],"sm")
k=Text("Single-journey tokens are available for one trip.","caption")
l=Text("Smart cards are available for repeated travel and usually give a fare discount versus tokens.","caption")
m=Text("QR-code / digital tickets are also accepted.","caption")
n=Text("Tourist passes listed in current fare guides include 1-day, 3-day, and 5-day options.","caption")
o=Card([p])
p=Column([q,r],"sm",padding=16)
q=Text("Interchange stations","h2")
r=Column([s,t,u],"sm")
s=Text("The main interchange is Nadaprabhu Kempegowda Station, Majestic, where the Purple Line and Green Line meet.","caption")
t=Text("RV Road is the key interchange between the Green Line and Yellow Line.","caption")
u=Text("Other important interchange points include Jayadeva Hospital, Central Silk Board, Krishnarajapura, MG Road, Mysuru Road, J.P. Nagar, and Jaya Prakash Nagara.","caption")
v=Card([w])
w=Column([x,y],"sm",padding=16)
x=Text("First-time rider quick guide","h2")
y=Column([z,aa,ab,ac],"sm")
z=Text("Buy a token for one trip or a smart card if you will make multiple rides.","caption")
aa=Text("Check your route for the correct interchange station before boarding.","caption")
ab=Text("Expect the network to be busiest during weekday morning and evening peak hours.","caption")
ac=Text("If you are changing lines, Majestic and RV Road are the simplest transfer points to remember.","caption")
</a2ui>