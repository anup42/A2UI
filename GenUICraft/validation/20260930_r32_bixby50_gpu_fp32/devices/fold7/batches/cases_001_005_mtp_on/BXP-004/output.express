<a2ui>
root=Column([a,b,f,l,t],gap="md",padding=16)
a=Text("Cabin baggage","h2")
b=Card([c])
c=Column([d,e],"sm",padding=16)
d=Text("Economy standard: one cabin bag up to 7 kg with maximum size 55 × 35 × 25 cm (total 115 cm including handles and wheels).",variant="body")
e=Text("One additional personal item up to 3 kg is allowed, such as a handbag or laptop bag, if it fits under the seat.",variant="body")
f=Column([g,h],"sm")
g=Text("Checked baggage","h2")
h=Card([i])
i=Column([j,k,l],"sm",padding=16)
j=Text("Standard domestic economy: 15 kg checked baggage per passenger.",variant="body")
k=Text("Maximum size for one checked piece is 158 cm total linear dimensions (L+W+H).",variant="body")
l=Card([m])
m=Column([n,o],"sm",padding=16)
n=Text("A single checked bag must not exceed 32 kg for safety handling.",variant="body")
o=Text("Note: These details are based on IndiGo guidelines.",variant="body")
p=Column([q,r],"sm")
q=Text("Excess baggage charges","h2")
r=Card([s])
s=Column([t,u],"sm",padding=16)
t=Text("IndiGo states excess checked baggage is charged per kilogram over the allowance at check-in.",variant="body")
u=Text("Published domestic airport excess rates are commonly around ₹600 per kg or ₹1,000 for an additional piece depending on purchase method and route; pre-booked excess is cheaper than airport purchase.",variant="body")
v=Column([w,x],"sm")
w=Text("Important fare exceptions","h2")
x=Card([y])
y=Column([z,aa,ab],"sm",padding=16)
z=Text("Lite fares may have no free checked baggage; checked weight must be bought separately.",variant="body")
aa=Text("Higher domestic bundles such as UpFront can include more checked allowance, and premium products may allow a higher cabin weight limit.",variant="body")
ab=Text("Exact excess pricing can vary by route and booking channel, so the fare rules on the ticket or booking page should be checked before travel.",variant="body")
