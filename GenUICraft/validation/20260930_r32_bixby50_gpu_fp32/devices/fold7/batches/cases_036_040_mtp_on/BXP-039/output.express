<a2ui>
$/={documents_required:[{item:"Photo ID proof",details:"such as Aadhaar, PAN, Passport, or Voter ID."},{item:"Address proof",details:"such as an electricity bill, rent agreement, or other official address document."},{item:"Passport-size photograph",details:"of the applicant."},{item:"Proof of business premises",details:"such as utility bills, property documents, or a NOC from the landlord if the kitchen is rented."},{item:"Business details and product list",details:"especially for bakery items and other foods made at home."}],application_steps:[{step:"1",action:"Create an account on the FoSCoS portal and log in."},{step:"2",action:"Select Apply for License/Registration and choose Registration (Form A) for a petty food business."},{step:"3",action:"Enter business details, premises address, and food activity information."},{step:"4",action:"Upload the required documents in the prescribed format."},{step:"5",action:"Pay the fee online and submit the application."},{step:"6",action:"Track the application using the reference or UARN number, and download the certificate once approved."}],mistakes_summary:[{mistake:"Choosing the wrong category",reason:"Applying for registration when turnover is above ₹12 lakh and a State License is needed."},{mistake:"Missing or unclear documents",reason:"Especially address proof or landlord NOC for a rented home kitchen."},{mistake:"Incorrect form selection",reason:"Petty businesses must file Form A, not the licensing form used for larger units."},{mistake:"Mismatch in business details",reason:"Inconsistent name, address, or activity description across documents and the portal form."},{mistake:"Not preparing product and premises details properly",reason:"Can slow scrutiny or lead to queries."}]}
root=Column([a,d,i,o,u,z],gap="md",padding=16)
a=Column([b,c],"sm")
b=Text("Eligibility for a small home bakery","h2")
c=Text("A home bakery in Karnataka generally falls under FSSAI Basic Registration if its annual turnover is up to ₹12 lakh; FSSAI states that registration is meant for petty food businesses and small or cottage-scale industry with turnover up to this limit. For turnover above ₹12 lakh, a State License is required instead of registration.","caption")
d=Card([e])
e=Column([f,g,h],"sm")
f=Text("Documents usually required","h3")
g=Text("For a small home bakery applying for Basic Registration, the commonly required documents are:",variant="body")
h=Table(columns=[{key:"item",label:"Document"},{key:"details",label:"Details"}],statePath="/documents_required",domain="generic",preferredPresentation="table")
i=Card([j])
j=Column([k,l,m],"sm")
k=Text("Official application steps","h3")
l=Text("The official application is made on the FoSCoS portal, which is FSSAI’s licensing and registration system. The standard process is:",variant="body")
m=Table(columns=[{key:"step",label:"Step"},{key:"action",label:"Action"}],statePath="/application_steps",domain="status",preferredPresentation="cards",primaryColumn="step")
n=Card([o])
o=Column([p,q],"sm")
p=Text("Published fees","h3")
q=Text("The commonly published fee is ₹100 per year, with multiple-year options also used on the portal. This is the usual Basic Registration fee referenced by registration guides and the official fee schedule framework.","caption")
r=Card([s])
s=Column([t,u],"sm")
t=Text("Common mistakes that cause delay or rejection","h3")
u=Table(columns=[{key:"mistake",label:"Mistake"},{key:"reason",label:"Reason"}],statePath="/mistakes_summary",domain="generic",preferredPresentation="cards",primaryColumn="mistake")
v=Text("If you want, I can also turn this into a Karnataka home-bakery checklist you can use before applying.","label")
