$/={comparison_data:[{factor:"Curriculum",cbse:"Built around NCERT and a structured, concept-based syllabus; it is widely aligned with Indian competitive exams such as JEE, NEET, and CUET.[1][3]",cise:"A broader, more content-rich syllabus with strong language depth and separate treatment of subjects such as History/Civics and Geography from middle school onward.",ib:"Inquiry-based, concept-led, and interdisciplinary, with programmes such as MYP and DP designed around global-minded learning.[4]",transferability:"Transfers most cleanly between CBSE schools within India; CBSE also has the broadest domestic footprint.[8][11]"},{factor:"Assessment",cbse:"More exam-led, with longer papers and many question types covering recall, understanding, application, and evaluation.",cise:"Exam-heavy but typically more descriptive and detailed, with required external assessment and internal components.[5]",ib:"Uses a mix of internal and external assessment; MYP external assessment is optional, and DP adds essays, projects, and other coursework-heavy elements.[7]",transferability:"Transfers best within CISCE schools, but the smaller school network can make moves less convenient than CBSE."},{factor:"Subject flexibility",cbse:"Generally more structured with fewer combinations than international curricula.[13]",cise:"Moderate flexibility, but still more fixed than IB.",ib:"Greater flexibility, especially in subject choice and in how learners connect disciplines."},{factor:"Transferability",cbse:"Transfers most cleanly between CBSE schools within India; CBSE also has the broadest domestic footprint.[8][11]",cise:"Transfers best within CISCE schools, but the smaller school network can make moves less convenient than CBSE.",ib:"Best when moving between international schools; recognition is global, but local transfer can depend on school level and subject mapping."}],suitability_data:[{board:"CBSE",suitability:"works well for families prioritizing a clear syllabus, frequent school availability, and a strong fit with Indian entrance-exam preparation."},{board:"CISCE",suitability:"suits students who want more depth, stronger English exposure, and a broader academic experience across sciences, humanities, and languages."},{board:"IB",suitability:"suits students who thrive on discussion, projects, research, and a less exam-dominant approach, especially if the family values global mobility."}]}
