<a2ui>
root=Column([a,b,c,f,k,r,y,af],gap="md",padding=16)
a=Text("Phishing Warning Signs","h2")
b=Card([c])
c=Column([d,e],"sm",padding=16)
d=Text("Urgent language, threats, or pressure to act immediately are common phishing cues [1].",variant="body")
e=Text("Check the sender address carefully; attackers often imitate trusted domains with small changes [2].",variant="body")
f=Card([g])
g=Column([h,i],"sm",padding=16)
h=Text("Be wary of generic greetings, poor grammar, odd formatting, unexpected attachments, and links that do not match their visible text [3].",variant="body")
i=Text("Treat requests for passwords, financial details, or unusual payments as high-risk, especially if they arrive by email or text with a link to a login page [4].",variant="body")
j=Text("Harmless Example Email","h2")
k=Card([l])
l=Column([m,n,o],"sm",padding=16)
m=Text("Subject: Expense policy update for review","h3")
n=Text("Hello team,\n\nPlease review the updated expense policy attached to this message. If you have questions, contact the Finance Helpdesk using the phone number listed on the company intranet.\n\nThank you,\nFinance Operations","body")
o=Text("This example is harmless because it avoids pressure, does not ask for credentials, and points employees to a trusted internal contact channel rather than a message link [12].","caption")
p=Text("How to Verify","h2")
q=Card([r])
r=Column([s,t,u,v],"sm",padding=16)
s=Text("Pause before clicking and inspect the sender, reply-to address, and destination URL for mismatches.",variant="body")
t=Text("If a message claims to be from a real company or internal team, contact that organization or team through a known-good channel, not by replying to the suspicious message.",variant="body")
u=Text("For payment, account, or password requests, verify using a second channel such as a phone call, secure chat, or direct login through the official website.",variant="body")
v=Text("If the message is unexpected, treat it as suspicious even if the logo and wording look professional.",variant="body")
w=Text("After Clicking a Suspicious Link","h2")
x=Card([y])
y=Column([z,aa,ab,ac,ad],"sm",padding=16)
z=Text("Stop interacting with the page immediately and do not enter any information [13].",variant="body")
aa=Text("Open the service yourself by typing the official address or using a saved bookmark, then change the password if credentials were entered [18].",variant="body")
ab=Text("Enable or confirm multi-factor authentication where available, and review recent account activity for unauthorized access.",variant="body")
ac=Text("If you downloaded a file, disconnect if needed, run a security scan, and report the incident to your IT or security team right away [10].",variant="body")
ad=Text("Report suspicious messages promptly; NCSC advises forwarding suspicious email and not clicking links in it, and CISA recommends reporting phishing so defenders can act quickly [8].","caption")
ae=Text("Office Habits That Help","h2")
af=Card([ag])
ag=Column([ah,ai,aj],"sm",padding=16)
ah=Text("Use layered defenses: filtering, multi-factor authentication, and clear reporting channels reduce damage when a phish gets through [16].",variant="body")
ai=Text("Train staff to report mistakes without fear; organizations are more resilient when employees can flag suspicious mail early.",variant="body")
aj=Text("For finance, HR, and IT teams, require a second-person verification step for sensitive requests, since these roles are often targeted.",variant="body")
</a2ui>