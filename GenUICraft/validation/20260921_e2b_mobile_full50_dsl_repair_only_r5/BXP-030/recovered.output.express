<a2ui>
root=Column([a,b],"md")
a=Table(columns=["Feature","EPF","PPF","NPS","N"],rows=[["Eligibility","Salaried employees in EP-covered establishments; mandatory for many-sector workers.","Any resident individual can open an account.","Indian citizens aged 18-70; both salaried and self-employed can join.",""],["Contribution rules","Employee contributes 2% of basic pay + dearness allowance; employer also contributes.","₹50 minimum per year; ₹1.5 lakh maximum per financial year.","₹1,0000 minimum per year for Tier I; no upper limit on contribution.",""],["Lock-in / tenure","Linked to employment; full withdrawal is generally at retirement or after qualifying exit.","15 years initial lock-in; extendable in 5-year blocks.","Locked until age 6 for normal exit.",""],["Withdrawals","Partial withdrawals allowed for specified needs; full withdrawal tax-favoured after 5 years of continuous.","Partial withdrawal from the 7th year; premature closure after 5 completed years and for specified reasons.","","Partial withdrawal after 3 years, generally up to 25% of own contributions for specified purposes."],["Tax treatment","Contributions may qualify for deduction under Section 8C; interest and eligible withdrawals are generally tax-free, but interest on employee contribution above ₹2.5 lakh/year can be taxable.","Contributions qualify under 80C; interest and maturity are generally fully tax-free.","","Employee contribution can get 80C benefit plus an extra ₹50000 under 80CCD(B); at exit, a lump sum portion is tax-free, while annuity income is taxable."]],title="Comparison table",domain="generic",preferredPresentation="cards")
b=Table(columns=["Scenario","Recommendation"],rows=[["A salaried employee with stable income and long service horizon","EPF is the core choice because contributions are automatic, employer money is added, and withdrawals after 5 years are generally tax-free."],["resident freelancer or homemaker wanting safe, disciplined saving","PPF fits well because it is open to resident individuals, allows small yearly contributions and offers fully-tax-free maturity under current rules."],["higher-income saver aiming to build a larger retirement corpus","N is the better fit because no practical upper limit, it allows extra deduction over 8C, and supports long-term-linked-growth with partial liquidity after 3 years."],["Current rules cited here reflect the latest sources; your exact EPF tax treatment depends thresholds or employer structure, that be checked against latest income-tax and EPFO guidance before investing.","Check the latest income-tax and EPFO guidance before investing."]],title="Situations",domain="generic",preferredPresentation="cards")
</a2ui>