root=Column([a,b,c],"md")
a=Table(columns=["topic","detail"],rows=[["FCP & Rabies Vaccines","Discuss whether your cats FCP and Rabies vaccines are current; these are core protections for cats in India."],["Adult-Risk Cats","FVRCP boosters are often given every 1–3 years depending on the vaccine and vet advice while rabies timing should follow local rules and the product label."],["Exposure Risk","Ask your vet about LV only if your cat has exposure, such as outdoor access or contact with other cats of unknown status."]],title="Vaccinations",domain="generic",preferredPresentation="cards")
b=Table(columns=["topic","detail"],rows=[["Parasite Prevention","Use a vet-directed deworming and flea prevention plan; indoor cats can still pick up parasites through shoes, litter, shared spaces or prey exposure."],["Adult Deworming","Many adult cats are dewormed about four times per year; your veterinarian may adjust this based on lifestyle and local risk."]],title="Parasite prevention",domain="generic",preferredPresentation="cards")
c=Table(columns=["topic","detail"],rows=[["Nutrition & Dental Care","Feed a complete, balanced cat food with fresh water; milk is not a routine substitute for water. Support dental health with regular tooth brushing and annual mouth checks during wellness; your vet may recommend professional cleaning if plaque or tartar builds."]],title="Nutrition dental care",domain="generic",preferredPresentation="cards")
