<a2ui>
root=Column([a],"md")
a=Table(columns=["title","description","verification_sources"],rows=[["ERA registration","Confirms project is registered under Karnataka RERA, required for qualifying apartment projects; verify on Karnataka RERA portal using project name or registration number.","Karnataka RERA portal"],["Sanctioned building plan","Confirms building layout, floors, and units were approved by competent authority; verify with MP, BDA or other local planning authority and cross-check plan details against ERA records.","MP,BDA, or other local planning authority"],["Title / title chain","Establishes who owns the land and whether the seller has a valid right to transfer it; verify with mother deed, prior sale deeds, partition, and related title records at Sub-Registrar’s office or through Karnataka’s registration system, and have an independent lawyer review chain.","Sub-Registrar’s office, Karnataka’s registration system, independent lawyer"],["Occupancy Certificate (OC)","Confirms building has been certified fit for occupation and generally matches approved norms; verify with the BB or the issuing municipal/planning authority before taking possession.","BB, municipal/planning authority"],["Encumbrance Certificate (EC)","Shows transactions and helps identify mortgages, charges, attachments, or other encumbrances on property; verify at the Sub-Registrar’s office or through Karnataka's online registration services and ensure the period covered is sufficiently long.","Sub-Registrar’s office, Karnataka’s online registration services"]],title="Document checklists",domain="generic",preferredPresentation="cards")
</a2ui>