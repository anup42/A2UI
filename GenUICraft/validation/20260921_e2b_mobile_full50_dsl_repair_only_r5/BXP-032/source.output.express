$/={terms:[{term:"Deductible",meaning:"A fixed amount you must pay before the insurer pays any admissible claim. In indemnity plans, it is a threshold.",effect:"The insurer starts paying only after deductible is crossed."},{term:"Co-payment",meaning:"A percentage of the admissible claim that you must bear. It does not reduce the sum insured, but reduces what insurer pays for that claim.",effect:"You share the bill in a fixed ratio, such as 0% or 20%."},{term:"Waiting period",meaning:"A period after policy start during which certain claims are not payable. Standard policies generally have a 30-day initial waiting period and pre-existing-disease waiting periods are commonly capped at 36 months in newer IRDA-regulated.","effect:"Claims during the waiting period may be fully rejected."},{term:"Room-rent limit",meaning:"A cap on hospital room charge covered by the policy, often linked to a percentage of the sum insured.",effect:"If you choose alier room, some policies reduce payment for other hospital charges in the same proportion."},{term:"Exclusions",meaning:"Treatments or situations the policy does not cover at all, such as pre-existing disease during the waiting period, many non-medical items, cosmetic, and other exclusions.",effect:"The insurer pays nothing for excluded items or events."}],comparison_summary_rules:[{rule:"Deductible and co-payment",summary:"both shift part of cost to policyholder, but work differently: deductible is paid first and co-payment is a share of the claim."},{rule:"Room-rent plus exclusion",summary:"room-rent limits are important because some policies apply proportionate reduction to other hospital expenses if room chosen is above the eligible limit; waiting periods and exclusions are filters so if a claim falls inside them, claim may be denied even if hospital bill is genuine."}]}
