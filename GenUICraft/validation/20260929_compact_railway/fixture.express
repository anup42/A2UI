$/={__genuicraft_sources:[{id:"1",url:"https://enquiry.indianrail.gov.in/",title:"Indian Railways enquiry",description:"Synthetic QA source 1: public railway enquiry site."},{id:"11",url:"https://enquiry.indianrail.gov.in/ntes/",title:"National Train Enquiry System",description:"Synthetic QA source 11: public train enquiry site."}],trains:[{service:"Shatabdi Express",number:"12007",departure:"10:35 [1]",journey:"about 2 h 20 m"},{service:"Rajya Rani Express",number:"20660",departure:"11:30",journey:"about 2 h 30 m"},{service:"Wodeyar Express",number:"12614",departure:"15:15",journey:"about 2 h 30 m"}]}
