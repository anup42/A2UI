                  <node index="4" text="The Mysuru–Hunsur route is the default choice for most travelers because the expressway portion is fast and the route is easy to follow." resource-id="" class="android.widget.TextView" package="com.samsung.genuicraft" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" visible-to-user="true" bounds="[58,778][1022,947]" drawing-order="0" hint="" display-id="0" />
                  <node index="5" text="The Hassan route is usually chosen as an alternative when travelers want a different highway alignment and sometimes less congestion, though the available sources still describe the Mysuru-side route more often in detail." resource-id="" class="android.widget.TextView" package="com.samsung.genuicraft" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" visible-to-user="true" bounds="[58,978][1022,1269]" drawing-order="0" hint="" display-id="0" />
                  <node index="6" text="On both routes, the last approach into Madikeri is hillier, and road speed usually drops in the ghat section near town." resource-id="" class="android.widget.TextView" package="com.samsung.genuicraft" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" visible-to-user="true" bounds="[58,1300][1022,1469]" drawing-order="0" hint="" display-id="0" />
                  <node index="7" text="Best single stop on each route" resource-id="" class="android.widget.TextView" package="com.samsung.genuicraft" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" visible-to-user="true" bounds="[58,1527][832,1595]" drawing-order="0" hint="" display-id="0" />
                  <node index="8" text="Mysuru–Hunsur route: Namdroling Monastery, Bylakuppe is the most useful and popular stop because it sits directly along the Coorg approach and breaks up the drive well." resource-id="" class="android.widget.TextView" package="com.samsung.genuicraft" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" visible-to-user="true" bounds="[58,1632][1022,1862]" drawing-order="0" hint="" display-id="0" />
                  <node index="9" text="Hassan route: Hassan is the practical stop for food, fuel, and a short rest before continuing toward Kushalnagar and Madikeri." resource-id="" class="android.widget.TextView" package="com.samsung.genuicraft" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" visible-to-user="true" bounds="[58,1893][1022,2062]" drawing-order="0" hint="" display-id="0" />
                  <node index="10" text="If you want, I can also give you the best route for early morning departure, toll estimate, or a family-friendly stop plan for the drive." resource-id="" class="android.widget.TextView" package="com.samsung.genuicraft" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" visible-to-user="true" bounds="[58,2114][1022,2302]" drawing-order="0" hint="" display-id="0" />
                </node>
              </node>
