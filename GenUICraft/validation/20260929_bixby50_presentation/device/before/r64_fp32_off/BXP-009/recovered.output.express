<a2ui>
root=Column([a,b,c,h],"md",padding=16)
a=Text("Civil Lines","h2")
b=Text("Access to sights: Good for reaching central Jaipur and many major sights by taxi or auto, with a practical location near the city center. [3]","caption")
c=Card([d])
d=Column([e,f,g,h],"sm",padding=16)
e=Text("Transport: Strong road access and usually easier ride-hailing connectivity than outer areas.","caption")
f=Text("Atmosphere: Quieter, more residential, and typically less hectic than the old-city core.","caption")
g=Text("Main drawback: Not the most walkable or characterful area if you want bazaars and heritage streets right outside the hotel.","caption")
h=Card([i])
i=Column([j,k,l,m],"sm",padding=16)
j=Text("C-Scheme / central Jaipur","h2")
k=Text("Access to sights: One of the best all-around bases for a first visit because it sits close to core attractions and city amenities. [6]","caption")
l=Text("Transport: Easy to move around by cab, auto, and local roads, making day planning straightforward.","caption")
m=Text("Atmosphere: Busy, urban, and convenient, with a more modern city feel.","caption")
n=Text("Main drawback: Less historic atmosphere than staying nearer the old city, so it can feel more generic.","caption")
o=Card([p])
p=Column([q,r,s,t],"sm",padding=16)
q=Text("Vaishali Nagar","h2")
r=Text("Access to sights: Useful for outer-west Jaipur and still workable for major attractions by car, but farther from the heritage core. [4]","caption")
s=Text("Transport: Well connected by road, though trips to older sights usually take longer.","caption")
t=Text("Atmosphere: Residential, popular, and generally comfortable for mid-range hotels.","caption")
u=Text("Main drawback: Distance from Amber, the old city, and central monuments makes sightseeing less efficient.","caption")
</a2ui>