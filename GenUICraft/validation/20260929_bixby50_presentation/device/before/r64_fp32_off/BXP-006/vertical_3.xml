              <node index="0" text="" resource-id="" class="android.view.View" package="com.samsung.genuicraft" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" visible-to-user="true" bounds="[16,0][1064,2394]" drawing-order="0" hint="" display-id="0">
                <node index="0" text="" resource-id="" class="android.view.View" package="com.samsung.genuicraft" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" visible-to-user="true" bounds="[16,0][1064,2394]" drawing-order="0" hint="" display-id="0">
                  <node index="5" text="The Hassan route is usually chosen as an alternative when travelers want a different highway alignment and sometimes less congestion, though the available sources still describe the Mysuru-side route more often in detail." resource-id="" class="android.widget.TextView" package="com.samsung.genuicraft" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" visible-to-user="true" bounds="[58,0][1022,313]" drawing-order="0" hint="" display-id="0" />
                  <node index="6" text="On both routes, the last approach into Madikeri is hillier, and road speed usually drops in the ghat section near town." resource-id="" class="android.widget.TextView" package="com.samsung.genuicraft" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" visible-to-user="true" bounds="[58,368][1022,556]" drawing-order="0" hint="" display-id="0" />
                  <node index="7" text="Best single stop on each route" resource-id="" class="android.widget.TextView" package="com.samsung.genuicraft" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" visible-to-user="true" bounds="[58,617][832,685]" drawing-order="0" hint="" display-id="0" />
                  <node index="8" text="Mysuru–Hunsur route: Namdroling Monastery, Bylakuppe is the most useful and popular stop because it sits directly along the Coorg approach and breaks up the drive well." resource-id="" class="android.widget.TextView" package="com.samsung.genuicraft" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" visible-to-user="true" bounds="[58,743][1022,997]" drawing-order="0" hint="" display-id="0" />
                  <node index="9" text="Hassan route: Hassan is the practical stop for food, fuel, and a short rest before continuing toward Kushalnagar and Madikeri." resource-id="" class="android.widget.TextView" package="com.samsung.genuicraft" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" visible-to-user="true" bounds="[58,1052][1022,1240]" drawing-order="0" hint="" display-id="0" />
                  <node index="10" text="If you want, I can also give you the best route for early morning departure, toll estimate, or a family-friendly stop plan for the drive." resource-id="" class="android.widget.TextView" package="com.samsung.genuicraft" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" visible-to-user="true" bounds="[58,1295][1022,1483]" drawing-order="0" hint="" display-id="0" />
