                  <node index="17" text="If you want, I can also turn this into a stricter like-for-like comparison using only the banks’ own official pages and exact effective-date wording." resource-id="" class="android.widget.TextView" package="com.samsung.genuicraft" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" visible-to-user="true" bounds="[58,2178][1022,2347]" drawing-order="0" hint="" display-id="0" />
