                <node index="0" text="" resource-id="" class="android.view.View" package="com.samsung.genuicraft" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" visible-to-user="true" bounds="[16,0][1064,2394]" drawing-order="0" hint="" display-id="0">
                  <node index="9" text="SBI: The bank page shown is the retail domestic term-deposit page with the current revised grid; the page content indicates the current retail slab structure and the source snapshot used here reflects the live rate table." resource-id="" class="android.widget.TextView" package="com.samsung.genuicraft" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" visible-to-user="true" bounds="[58,3][1022,294]" drawing-order="0" hint="" display-id="0" />
                  <node index="10" text="HDFC Bank: The rate table is explicitly marked applicable from 19 August 2026 for domestic/NRO/NRE fixed deposits below ₹3 crore." resource-id="" class="android.widget.TextView" package="com.samsung.genuicraft" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" visible-to-user="true" bounds="[58,325][1022,494]" drawing-order="0" hint="" display-id="0" />
                  <node index="11" text="ICICI Bank: The source snapshot used here reflects the current retail FD grid, and the cited third-party rate page states the one-year retail rate at 6.25% for deposits below ₹3 crore." resource-id="" class="android.widget.TextView" package="com.samsung.genuicraft" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" visible-to-user="true" bounds="[58,525][1022,755]" drawing-order="0" hint="" display-id="0" />
                  <node index="12" text="Premature-withdrawal caveats" resource-id="" class="android.widget.TextView" package="com.samsung.genuicraft" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" visible-to-user="true" bounds="[58,807][701,863]" drawing-order="0" hint="" display-id="0" />
                  <node index="13" text="SBI: The cited SBI retail page provides the rate grid but does not spell out a premature-withdrawal penalty in the extracted text shown here, so the exact penalty should be checked in SBI’s current deposit terms before booking." resource-id="" class="android.widget.TextView" package="com.samsung.genuicraft" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" visible-to-user="true" bounds="[58,897][1022,1188]" drawing-order="0" hint="" display-id="0" />
                  <node index="14" text="HDFC Bank: For deposits booked on or after 22 July 2023, premature withdrawal, including sweep-in/partial withdrawal, is charged at 1% below the rate on the date of deposit booking for the actual period the deposit remained with the bank, rather than the contracted rate; certain government-related entities may be exempt on eligible branches and documents." resource-id="" class="android.widget.TextView" package="com.samsung.genuicraft" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" visible-to-user="true" bounds="[58,1219][1022,1632]" drawing-order="0" hint="" display-id="0" />
                  <node index="15" text="ICICI Bank: The cited current FD rate snapshot shows the one-year retail rate, but the displayed source excerpt here does not include the bank’s premature-withdrawal penalty text, so that condition should be verified in ICICI Bank’s deposit terms before booking." resource-id="" class="android.widget.TextView" package="com.samsung.genuicraft" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" visible-to-user="true" bounds="[58,1663][1022,2015]" drawing-order="0" hint="" display-id="0" />
