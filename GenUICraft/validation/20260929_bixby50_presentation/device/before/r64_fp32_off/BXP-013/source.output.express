<a2ui>
$/={quick_view_data:[{bank:"SBI",rate:"6.25%",size:"Below ₹3 crore",date:"Current retail grid shown on SBI’s retail domestic term-deposit page"},{bank:"HDFC Bank",rate:"6.25%",size:"Below ₹3 crore",date:"19 August 2026"},{bank:"ICICI Bank",rate:"6.25%",size:"Below ₹3 crore",date:"Current retail grid shown in the cited rate snapshot"}]}
root=Column([a,b,c,h,o,x,y],gap="md",padding=16)
a=Text("One-year FD rates","h2")
b=Text("For regular adult retail customers, SBI, HDFC Bank, and ICICI Bank are all showing a one-year rate of 6.25% for the relevant retail deposit bucket [1][6][9].",variant="body")
c=Card([d])
d=Column([e,f,g,h],"sm",padding=16)
e=Text("Assumed deposit sizes","h3")
f=Text("SBI: Retail domestic term deposits below ₹3 crore; the one-year slab is 1 year to less than 2 years and the rate is 6.25% for general customers.",variant="body")
g=Text("HDFC Bank: Domestic/NRO/NRE fixed deposits below ₹3 crore; the one-year slab is 1 year to less than 15 months and the rate is 6.25% for regular customers.",variant="body")
h=Card([i])
i=Column([j,k,l],"sm",padding=16)
j=Text("ICICI Bank: Retail deposits below ₹3 crore; the one-year slab is 1 year to less than 18 months and the rate is 6.25% for general customers [17].",variant="body")
o=Card([p])
p=Column([q,r,s,t],"sm",padding=16)
q=Text("Rate dates","h3")
r=Text("SBI: The bank page shown is the retail domestic term-deposit page with the current revised grid; the page content indicates the current retail slab structure and the source snapshot used here reflects the live rate table.",variant="body")
s=Text("HDFC Bank: The rate table is explicitly marked applicable from 19 August 2026 for domestic/NRO/NRE fixed deposits below ₹3 crore.",variant="body")
t=Text("ICICI Bank: The source snapshot used here reflects the current retail FD grid, and the cited third-party rate page states the one-year retail rate at 6.25% for deposits below ₹3 crore.",variant="body")
u=Card([v])
v=Column([w,x,y,z],"sm",padding=16)
w=Text("Premature-withdrawal caveats","h3")
x=Text("SBI: The cited SBI retail page provides the rate grid but does not spell out a premature-withdrawal penalty in the extracted text shown here, so the exact penalty should be checked in SBI’s current deposit terms before booking.",variant="body")
y=Text("HDFC Bank: For deposits booked on or after 22 July 2023, premature withdrawal, including sweep-in/partial withdrawal, is charged at 1% below the rate on the date of deposit booking for the actual period the deposit remained with the bank, rather than the contracted rate; certain government-related entities may be exempt on eligible branches and documents.",variant="body")
z=Text("ICICI Bank: The cited current FD rate snapshot shows the one-year retail rate, but the displayed source excerpt here does not include the bank’s premature-withdrawal penalty text, so that condition should be verified in ICICI Bank’s deposit terms before booking.",variant="body")
aa=Column([ab,ac],gap="md")
ab=Text("Quick view","h2")
ac=Table(columns=[{key:"bank",label:"Bank"},{key:"rate",label:"One-year retail FD rate"},{key:"size",label:"Assumed deposit size"},{key:"date",label:"Rate date / effective date"}],statePath="/quick_view_data",domain="comparison",preferredPresentation="cards",primaryColumn="bank",numericColumns=["rate"])
ad=Text("If you want, I can also turn this into a stricter like-for-like comparison using only the banks’ own official pages and exact effective-date wording.",variant="body")
