                      <node index="0" text="" resource-id="" class="android.view.View" package="com.samsung.genuicraft" content-desc="For residential rooftop systems under PM Surya Ghar the central subsidy is up to ₹78000 for a3 kW or larger system, with3000000 for first kW,60000 for 2 kW and the maximum cap at 3 kW. Current guidance says the system must be residential, grid-connected, and installed by anMNRE-registered/approved vendor; off-grid systems do not qualify for this central subsidy.: " checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" visible-to-user="true" bounds="[90,621][990,1647]" drawing-order="0" hint="" display-id="0" />
