<a2ui>
root=Column([a,b,c,h],gap="md",padding=16)
a=Text("Civil Lines","h2")
b=Text("Access to sights: Good for reaching central Jaipur and many major sights by taxi or auto, with a practical location near the city center.","caption")
c=Card([d])
d=Column([e,f,g,h],"sm",padding=16)
e=Text("Transport: Strong road access and usually easier ride-hailing connectivity than outer areas.","caption")
f=Text("Atmosphere: Quieter, more residential, and typically less hectic than the old-city core.","caption")
g=Text("Main drawback: Not the most walkable or characterful area if you want bazaars and heritage streets right outside the hotel.","caption")
h=Column([i,j,k,l],"sm")
i=Text("C-Scheme / central Jaipur","h2")
j=Text("Access to sights: One of the best all-around bases for a first visit because it sits close to core attractions and city amenities.","caption")
k=Text("Transport: Easy to move around by cab, auto, and local roads, making day planning straightforward.","caption")
l=Text("Atmosphere: Busy, urban, and convenient, with a more modern city feel.","caption")
m=Card([n])
n=Column([o,p,q,r],"sm",padding=16)
o=Text("Vaishali Nagar","h2")
p=Text("Access to sights: Useful for outer-west Jaipur and still workable for major attractions by car, but farther from the heritage core.","caption")
q=Text("Transport: Well connected by road, though trips to older sights usually take longer.","caption")
r=Text("Atmosphere: Residential, popular, and generally comfortable for mid-range hotels.","caption")
s=Card([t])
t=Column([u,v,w,x],"sm",padding=16)
u=Text("Main drawback: Distance from Amber, the old city, and central monuments makes sightseeing less efficient.","caption")
</a2ui>