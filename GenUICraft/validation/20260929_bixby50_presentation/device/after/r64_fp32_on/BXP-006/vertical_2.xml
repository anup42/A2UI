                  <node index="3" text="Which route feels different in practice" resource-id="" class="android.widget.TextView" package="com.samsung.genuicraft" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" visible-to-user="true" bounds="[58,716][1022,784]" drawing-order="0" hint="" display-id="0" />
                  <node index="4" text="The Mysuru–Hunsur route is the default choice for most travelers because the expressway portion is fast and the route is easy to follow." resource-id="" class="android.widget.TextView" package="com.samsung.genuicraft" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" visible-to-user="true" bounds="[58,821][1022,990]" drawing-order="0" hint="" display-id="0" />
                  <node index="5" text="The Hassan route is usually chosen as an alternative when travelers want a different highway alignment and sometimes less congestion, though the available sources still describe the Mysuru-side route more often in detail." resource-id="" class="android.widget.TextView" package="com.samsung.genuicraft" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" visible-to-user="true" bounds="[58,1021][1022,1312]" drawing-order="0" hint="" display-id="0" />
                  <node index="6" text="On both routes, the last approach into Madikeri is hillier, and road speed usually drops in the ghat section near town." resource-id="" class="android.widget.TextView" package="com.samsung.genuicraft" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" visible-to-user="true" bounds="[58,1343][1022,1512]" drawing-order="0" hint="" display-id="0" />
