                  <node index="1" text="Access to sights: Good for reaching central Jaipur and many major sights by taxi or auto, with a practical location near the city center. [3]" resource-id="" class="android.widget.TextView" package="com.samsung.genuicraft" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" visible-to-user="true" bounds="[58,347][1022,516]" drawing-order="0" hint="" display-id="0" />
