                  <node index="2" text="" resource-id="" class="android.view.View" package="com.samsung.genuicraft" content-desc="Table with 2 rows and 5 columns" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" visible-to-user="true" bounds="[58,0][1022,132]" drawing-order="0" hint="" display-id="0">
