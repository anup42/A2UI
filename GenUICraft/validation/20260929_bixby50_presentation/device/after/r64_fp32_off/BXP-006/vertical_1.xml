                      <node index="0" text="" resource-id="" class="android.view.View" package="com.samsung.genuicraft" content-desc="Row 2. Route: Bengaluru → Hassan → Kushalnagar → Madikeri. Approx. distance: About 265 km. Usual travel time: About 5.5–6 hours. Road conditions: Generally described as smoother and less traffic-heavy than the Mysuru-side route, with a more straightforward long-drive feel[13]. Useful stop: Hassan for a meal break or coffee stop" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" visible-to-user="true" bounds="[58,0][1022,132]" drawing-order="0" hint="" display-id="0" />
                    </node>
                  </node>
                  <node index="3" text="Which route feels different in practice" resource-id="" class="android.widget.TextView" package="com.samsung.genuicraft" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" visible-to-user="true" bounds="[58,185][1022,253]" drawing-order="0" hint="" display-id="0" />
                  <node index="4" text="The Mysuru–Hunsur route is the default choice for most travelers because the expressway portion is fast and the route is easy to follow." resource-id="" class="android.widget.TextView" package="com.samsung.genuicraft" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" visible-to-user="true" bounds="[58,290][1022,459]" drawing-order="0" hint="" display-id="0" />
                  <node index="5" text="The Hassan route is usually chosen as an alternative when travelers want a different highway alignment and sometimes less congestion, though the available sources still describe the Mysuru-side route more often in detail." resource-id="" class="android.widget.TextView" package="com.samsung.genuicraft" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" visible-to-user="true" bounds="[58,490][1022,781]" drawing-order="0" hint="" display-id="0" />
                  <node index="6" text="On both routes, the last approach into Madikeri is hillier, and road speed usually drops in the ghat section near town." resource-id="" class="android.widget.TextView" package="com.samsung.genuicraft" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" visible-to-user="true" bounds="[58,812][1022,981]" drawing-order="0" hint="" display-id="0" />
                  <node index="7" text="Best single stop on each route" resource-id="" class="android.widget.TextView" package="com.samsung.genuicraft" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" visible-to-user="true" bounds="[58,1039][832,1107]" drawing-order="0" hint="" display-id="0" />
                  <node index="8" text="Mysuru–Hunsur route: Namdroling Monastery, Bylakuppe is the most useful and popular stop because it sits directly along the Coorg approach and breaks up the drive well." resource-id="" class="android.widget.TextView" package="com.samsung.genuicraft" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" visible-to-user="true" bounds="[58,1144][1022,1374]" drawing-order="0" hint="" display-id="0" />
                  <node index="9" text="Hassan route: Hassan is the practical stop for food, fuel, and a short rest before continuing toward Kushalnagar and Madikeri." resource-id="" class="android.widget.TextView" package="com.samsung.genuicraft" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" visible-to-user="true" bounds="[58,1405][1022,1574]" drawing-order="0" hint="" display-id="0" />
                  <node index="10" text="If you want, I can also give you the best route for early morning departure, toll estimate, or a family-friendly stop plan for the drive." resource-id="" class="android.widget.TextView" package="com.samsung.genuicraft" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" visible-to-user="true" bounds="[58,1605][1022,1774]" drawing-order="0" hint="" display-id="0" />
                  <node index="11" text="Thank you for using A2UI Express!" resource-id="" class="android.widget.TextView" package="com.samsung.genuicraft" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" visible-to-user="true" bounds="[58,1805][651,1852]" drawing-order="0" hint="" display-id="0" />
