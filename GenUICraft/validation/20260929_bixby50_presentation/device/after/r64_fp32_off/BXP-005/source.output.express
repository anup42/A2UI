<a2ui>
root=Column([a,b,c,i,p],gap="md",padding=16)
a=Text("Travel Information","h2")
b=Card([c])
c=Column([d,e,f],"sm")
d=Text("Operating hours","h3")
e=Text("Weekdays/Saturdays: Most sources show service starting around 5:00 AM and ending around 11:05 PM on the Purple and Green lines; the Yellow Line runs later in the evening from RV Road, up to 11:55 PM from that station.","caption")
f=Text("Sundays: Trains generally start at 7:00 AM.","caption")
g=Card([h])
h=Column([i,j,k,l,m],"sm")
i=Text("Ticket and pass options","h3")
j=Text("Single-journey tokens are available for one trip.","caption")
k=Text("Smart cards are available for repeated travel and usually give a fare discount versus tokens.","caption")
l=Text("QR-code / digital tickets are also accepted.","caption")
m=Text("Tourist passes listed in current fare guides include 1-day, 3-day, and 5-day options.","caption")
n=Card([o])
o=Column([p,q,r,s],"sm")
p=Text("Interchange stations","h3")
q=Text("The main interchange is Nadaprabhu Kempegowda Station, Majestic, where the Purple Line and Green Line meet.","caption")
r=Text("RV Road is the key interchange between the Green Line and Yellow Line.","caption")
s=Text("Other important interchange points include Jayadeva Hospital, Central Silk Board, Krishnarajapura, MG Road, Mysuru Road, J.P. Nagar, and Jaya Prakash Nagara.","caption")
t=Card([u])
u=Column([v,w,x,y,z],"sm")
v=Text("First-time rider quick guide","h3")
w=Text("Buy a token for one trip or a smart card if you will make multiple rides.","caption")
x=Text("Check your route for the correct interchange station before boarding.","caption")
y=Text("Expect the network to be busiest during weekday morning and evening peak hours.","caption")
z=Text("If you are changing lines, Majestic and RV Road are the simplest transfer points to remember.","caption")
aa=Button("Continue","primary",onPress=openUrl("[ACTION_URL_1]"))
</a2ui>