$/={verification_tips:[{tip:"Pause before clicking and inspect the sender reply-to address, and destination for mismatches",tip:"If a message claims to be from a real company or internal team, contact that organization or team through a known good channel not by replying to the suspicious message",tip:"For payment, account, or password requests, verify using a second channel such as a phone call, chat, or direct login through the official website",tip:"If the message is unexpected, treat it as suspicious even if logo and wording look professional."}],security_after_clicking_tip:[{tip:"Stop interacting with the page immediately and do not enter any information",tip:"Open the service yourself by typing the official address or using a saved bookmark then change the password if credentials were entered",tip:"Enable or confirm multi-factor authentication where available and review recent account activity for unauthorized",tip:"If you downloaded a file, disconnect if needed, run a security scan, and report the incident to your IT or security team right away",tip:"Report suspicious messages promptly; NCSC advises forwarding suspicious email and not clicking links in it, and CISA recommends reporting phishing so defenders can act quickly"}]}
