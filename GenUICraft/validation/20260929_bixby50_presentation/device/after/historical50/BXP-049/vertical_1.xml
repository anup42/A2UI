                  <node index="1" text="Pattachitra" resource-id="" class="android.widget.TextView" package="com.samsung.genuicraft" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" visible-to-user="true" bounds="[58,856][248,903]" drawing-order="0" hint="" display-id="0" />
                  <node index="2" text="Supporting authentic practitioners" resource-id="" class="android.widget.TextView" package="com.samsung.genuicraft" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" visible-to-user="true" bounds="[58,934][649,981]" drawing-order="0" hint="" display-id="0" />
                  <node index="3" text="Buy from recognized artisan communities and makers who can identify their village or lineage, such as Mithila artists for Madhubani Warli Warli artists from Maharashtra’s tribal belt, and Chitrakarrakararattachitra practitioners in Odisha and Bengal." resource-id="" class="android.widget.TextView" package="com.samsung.genuicraft" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" visible-to-user="true" bounds="[58,1012][1022,1303]" drawing-order="0" hint="" display-id="0" />
                  <node index="4" text="Prefer works made with traditional methods and materials when available: natural pigments, hand-prepared surfaces and hand-drawn outlines rather than mass-printed reproductions." resource-id="" class="android.widget.TextView" package="com.samsung.genuicraft" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" visible-to-user="true" bounds="[58,1334][1022,1564]" drawing-order="0" hint="" display-id="0" />
                  <node index="5" text="Ask whether artist signs the work, where it was made, and how it it was produced; genuine practitioners usually welcome questions about process and cultural background." resource-id="" class="android.widget.TextView" package="com.samsung.genuicraft" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" visible-to-user="true" bounds="[58,1595][1022,1825]" drawing-order="0" hint="" display-id="0" />
                  <node index="6" text="Purchase through artisan cooperatives museum shops craft fairs fairs, verified platforms that document the maker and locality; current reliable data on individual artists is limited, so provenance matters more than brand names." resource-id="" class="android.widget.TextView" package="com.samsung.genuicraft" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" visible-to-user="true" bounds="[58,1856][1022,2147]" drawing-order="0" hint="" display-id="0" />
                  <node index="7" text="Avoid pricing that undercuts handmade labor; fair payment helps keep these traditions across generations." resource-id="" class="android.widget.TextView" package="com.samsung.genuicraft" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" visible-to-user="true" bounds="[58,2178][1022,2347]" drawing-order="0" hint="" display-id="0" />
