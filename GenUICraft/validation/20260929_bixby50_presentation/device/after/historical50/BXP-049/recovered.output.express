<a2ui>
root=Column([a,c,d,e,f,g,h,i],"md")
a=Column([b],"md")
b=Table(columns=["tradition","geography","materials","motifs","technique","context"],rows=[["Madhubani","Mithila region of Bihar especially Madhubani, Darbhanga, and Sitamarhi","mud walls; paper, cloth, canvas; natural dyes, twigs/fingers/matchsticks","Deities, wedding/fertility symbols, fish, birds, flowers, nature, village life","Dense line work geometric filling, no empty space, bold borders","Traditionally painted by women for rituals, festivals and auspicious occasions"],["Warli","Tribal communities of Maharashtra, especially northern Konkan and districts such as Thane and Palghar","Mud walls or earthen surfaces; white rice paste with water/gum; often red-brown ground","Daily village life, farming, hunting, dance, marriage, harvest, animals","Minimalist white geometric figures made from circles, triangles, lines","Linked to community life and social rituals rather than deity-centered storytelling"],["Pattachitra","Odisha, especially around Puri and Raghurajpur and also parts of West Bengal","Cloth or palm leaf; prepared cloth base with chalk/gum; natural pigments and fine brushes","Jagannath, Krishna, Rama, Mahabharata/Ramayana scenes mythological narratives","Fine outlines, narrative panels, strong borders, tightly composed figures","Devotional temple and temple-linked art connected to Jagannath culture and ritual storytelling"]],title="Comparison data",domain="comparison",preferredPresentation="cards")
c=Text("Pattachitra","Pitra:look for smooth, highly detailed composition, stylized faces with large eyes,decorative borders, mythological storytelling, and a painted surface often resembles a prepared a cloth scroll.")
d=Text("Supporting authentic practitioners","aq")
e=Text("Buy from recognized artisan communities and makers who can identify their village or lineage, such as Mithila artists for Madhubani Warli Warli artists from Maharashtra’s tribal belt, and Chitrakarrakararattachitra practitioners in Odisha and Bengal.","h1")
f=Text("Prefer works made with traditional methods and materials when available: natural pigments, hand-prepared surfaces and hand-drawn outlines rather than mass-printed reproductions.","h1")
g=Text("Ask whether artist signs the work, where it was made, and how it it was produced; genuine practitioners usually welcome questions about process and cultural background.","h1")
h=Text("Purchase through artisan cooperatives museum shops craft fairs fairs, verified platforms that document the maker and locality; current reliable data on individual artists is limited, so provenance matters more than brand names.","h1")
i=Text("Avoid pricing that undercuts handmade labor; fair payment helps keep these traditions across generations.","h1")
</a2ui>