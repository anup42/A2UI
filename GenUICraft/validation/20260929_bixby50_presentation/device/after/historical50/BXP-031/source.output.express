<a2ui>
$/={document_checklists:[{title:"ERA registration",description:"Confirms project is registered under Karnataka RERA, required for qualifying apartment projects; verify on Karnataka RERA portal using project name or registration number.",verification_sources:"Karnataka RERA portal"},{title:"Sanctioned building plan",description:"Confirms building layout, floors, and units were approved by competent authority; verify with MP, BDA or other local planning authority and cross-check plan details against ERA records.",verification_sources:"MP,BDA, or other local planning authority"},{title:"Title / title chain",description:"Establishes who owns the land and whether the seller has a valid right to transfer it; verify with mother deed, prior sale deeds, partition, and related title records at Sub-Registrar’s office or through Karnataka’s registration system, and have an independent lawyer review chain.",verification_sources:"Sub-Registrar’s office, Karnataka’s registration system, independent lawyer"},{title:"Occupancy Certificate (OC)",description:"Confirms building has been certified fit for occupation and generally matches approved norms; verify with the BB or the issuing municipal/planning authority before taking possession.",verification_sources:"BB, municipal/planning authority"},{title:"Encumbrance Certificate (EC)",description:"Shows transactions and helps identify mortgages, charges, attachments, or other encumbrances on property; verify at the Sub-Registrar’s office or through Karnataka's online registration services and ensure the period covered is sufficiently long.",verification_sources:"Sub-Registrar’s office, Karnataka’s online registration services"}]}
