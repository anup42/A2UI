                  <node index="7" text="Drainage failure is a central factor. The CAG report found large-scale encroachment of lakes and drains, poor maintenance missing drain drain inventories and sewage mixing with stormwater; it also said many drains lacked boundary markings, enabled encroachment and blockage . Research on Bengaluru similarly states that natural channels have been narrowed or blocked and artificial drains are often blocked [188][]." resource-id="" class="android.widget.TextView" package="com.samsung.genuicraft" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" visible-to-user="true" bounds="[58,334][1022,869]" drawing-order="0" hint="" display-id="0" />
                  <node index="8" text="Lakes" resource-id="" class="android.widget.TextView" package="com.samsung.genuicraft" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" visible-to-user="true" bounds="[58,900][161,947]" drawing-order="0" hint="" display-id="0" />
                  <node index="9" text="Construction" resource-id="" class="android.widget.TextView" package="com.samsung.genuicraft" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" visible-to-user="true" bounds="[58,978][281,1025]" drawing-order="0" hint="" display-id="0" />
                  <node index="10" text="Construction contributes in two ways: it increases impervious surfaces, and it physically obstructs natural drainsplains. ATREE reports a rise in impervious and loss of blue-green cover, while IIS-linked studies-valley high-alteration of topography reduce infiltration and runoff [1212]" resource-id="" class="android.widget.TextView" package="com.samsung.genuicraft" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" visible-to-user="true" bounds="[58,1056][1022,1408]" drawing-order="0" hint="" display-id="0" />
                  <node index="11" text="Solid waste is a direct operational because litter, debris, and garbage choke drains. IISc and ATREE sources explicitly identify litter, building debris and municipal waste major causes of blockage, and the CAG report notes that sewage and waste in drains worsen flooding and water pollution [3]" resource-id="" class="android.widget.TextView" package="com.samsung.genuicraft" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" visible-to-user="true" bounds="[58,1439][1022,1791]" drawing-order="0" hint="" display-id="0" />
                  <node index="12" text="Household Precautions" resource-id="" class="android.widget.TextView" package="com.samsung.genuicraft" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" visible-to-user="true" bounds="[58,1822][463,1869]" drawing-order="0" hint="" display-id="0" />
                  <node index="13" text="Keep drains courtyard drains roadside inlets clear; Avoid dumping waste into streets; Elevate critical appliances and documents above flood levels; Use rainwater harvesting feasible." resource-id="" class="android.widget.TextView" package="com.samsung.genuicraft" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" visible-to-user="true" bounds="[58,1900][1022,2130]" drawing-order="0" hint="" display-id="0" />
                  <node index="14" text="These actions reduce local damage but cannot fix upstream drainage failures or lake encroachment." resource-id="" class="android.widget.TextView" package="com.samsung.genuicraft" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" visible-to-user="true" bounds="[58,2161][1022,2269]" drawing-order="0" hint="" display-id="0" />
