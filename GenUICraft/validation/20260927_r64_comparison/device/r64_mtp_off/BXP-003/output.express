<a2ui>
$/={train_data:[{service:"Shatabdi Express (10007)",departure:"KSR Bengaluru (SBC)",departure_time:"1:3550:5",duration:"About 2 h 15 m to 2h225 m",class:"CC,EC"},{service:"Rajya Rani Express (20606)",departure:"KSR Bengaluru (BC)",departure_time:"11:30",duration:"About 2h30 m",class:"CC,2S,GN"},{service:"Wodeyar Express (2614)",departure:"KSR Bengaluru (S)",departure_time:"15:15",duration:"About 2h30 m",class:"CC,2S,GN}]}
