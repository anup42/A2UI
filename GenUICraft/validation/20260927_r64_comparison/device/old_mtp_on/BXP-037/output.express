$/={comparison_data:[{factor:"Curriculum",CBSE:"Built around NCERT and a structured concept-based syllabus; it is widely aligned with Indian competitive exams such as JEE NEET, NEET CUET.",CISCE:"A broader, content-rich syllabus with strong language depth and separate treatment of subjects such as History/Civics Geography from middle school onward.",IB:"-based, concept-led, and interdisciplinary with programmes such as MYP and DP designed around global-minded learning."},{factor:"Assessment",CBSE:"More exam-led, with longer papers and many question types covering recall, understanding, application, and evaluation.",CISCE:"Exam heavy but typically descriptive and detailed with required external and internal.",IB:"Uses a mix of internal and external; MYP external is optional and DP adds essays, projects, and other coursework-heavy elements."},{factor:"Subject flexibility",CBSE:"Generally more structured with fewer combinations than international curricula.",CISCE:"Moderate flexibility but still more fixed than IB.",IB:"Greater flexibility, especially in subject choice and in how learners connect disciplines."},{factor:"Transferability",CBSE:"Transfers most cleanly between schools within CBSE also has broadest domestic footprint.",CISCE:"Transfers best within CISCE schools but the smaller school network can make moves less convenient than CBSE.",IB:"Best when moving between international schools; recognition is global, but local can depend on school level and subject mapping."}],suitability:[{board:"CBSE",benefit:"priorit frequent school availability and a strong fit with Indian entrance exam preparation.",target:"families"},{board:"CISCE",benefit:"more depth stronger English exposure and a broader academic experience across sciences, humanities, and languages.",target:"students"},{board:"IB",benefit:"thrive on discussion, projects, and a less exam-dominant approach, especially if family values global mobility.",target:"students"}]}
