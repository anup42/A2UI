b=Column([c,d,e],"sm",padding=16)
c=Text("Operating hours","h2")
d=Text("Weekdays/Saturdays: Most sources show service starting around 5:00 AM and ending around 11:05 PM on the Purple and Green lines; the Yellow Line runs later in the evening from RV Road, up to 11:55 PM from that station.","caption")
e=Text("Sundays: Trains generally start at 7:00 AM.","caption")
f=Column([g,h,i,j,k],"sm")
g=Text("Ticket and pass options","h2")
h=Text("Single-journey tokens are available for one trip.","caption")
i=Text("Smart cards are available for repeated travel and usually give a fare discount versus tokens.","caption")
j=Text("QR-code / digital tickets are also accepted.","caption")
k=Text("Tourist passes listed in current fare guides include 1-day, 3-day, and 5-day options.","caption")
l=Column([m,n,o,p],"sm")
m=Text("Interchange stations","h2")
n=Text("The main interchange is Nadaprabhu Kempegowda Station, Majestic, where the Purple Line and Green Line meet.","caption")
o=Text("RV Road is the key interchange between the Green Line and Yellow Line.","caption")
p=Text("Other important interchange points include Jayadeva Hospital, Central Silk Board, Krishnarajapura, MG Road, Mysuru Road, J.P. Nagar, and Jaya Prakash Nagara.","caption")
q=Card([r])
