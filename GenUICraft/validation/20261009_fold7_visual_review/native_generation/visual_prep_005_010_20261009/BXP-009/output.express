<a2ui>
root=Column([a,b,c,d,e,f,g,h,i,j,k,l,m,n],gap="md",padding=16)
a=Text("Civil Lines","h2")
b=Text("Access to sights: Good for reaching central Jaipur and many major sights by taxi or auto, with a practical location near the city center.","caption")
c=Text("Transport: Strong road access and usually easier ride-hailing connectivity than outer areas.","caption")
d=Text("Atmosphere: Quieter, more residential, and typically less hectic than the old-city core.","caption")
e=Text("Main drawback: Not the most walkable or characterful area if you want bazaars and heritage streets right outside the hotel.","caption")
f=Divider()
g=Text("C-Scheme / central Jaipur","h2")
h=Text("Access to sights: One of the best all-around bases for a first visit because it sits close to core attractions and city amenities.","caption")
i=Text("Transport: Easy to move around by cab, auto, and local roads, making day planning straightforward.","caption")
j=Text("Atmosphere: Busy, urban, and convenient, with a more modern city feel.","caption")
k=Text("Main drawback: Less historic atmosphere than staying nearer the old city, so it can feel more generic.","caption")
l=Divider()
m=Text("Vaishali Nagar","h2")
n=Text("Access to sights: Useful for outer-west Jaipur and still workable for major attractions by car, but farther from the heritage core.","caption")
o=Text("Transport: Well connected by road, though trips to older sights usually take longer.","caption")
p=Text("Atmosphere: Residential, popular, and generally comfortable for mid-range hotels.","caption")
q=Text("Main drawback: Distance from Amber, the old city, and central monuments makes sightseeing less efficient.","caption")
</a2ui>