b=Table(columns=[{key:"app",label:"App"},{key:"offline",label:"Offline use"},{key:"sync",label:"Synchronization"},{key:"export",label:"Export options"},{key:"restriction",label:"Biggest free-plan restriction"}],statePath="/comparison_data",domain="comparison",preferredPresentation="cards",primaryColumn="app")
c=Card([d])
d=Column([e,f,g],"sm",padding=16)
e=Text("Best fit","h3")
f=Text("OneNote: best if you want the most polished free Android + web sync experience, but its free storage cap is the main constraint.",variant="body")
g=Text("Simplenote: best for plain text notes and lightweight syncing across Android and web.",variant="body")
h=Text("Joplin: best for offline use and exportable, user-owned notes, with sync flexibility rather than a large free cloud quota.",variant="body")
i=Text("Current source coverage is enough to compare core limits, but detailed free-tier export rules are not fully specified for every app.","caption")
