<a2ui>
$/={comparison_data:[{app:"Microsoft OneNote",offline:"Works offline on Android and web-backed notebooks sync when you reconnect[2][12]",sync:"Free cross-device sync through OneDrive",export:"Export support is available, but the free plan is mainly limited by storage rather than format[1]",restriction:"About 5 GB of notes on the free plan"},{app:"Simplenote",offline:"Supports offline editing, with changes syncing later across devices[7]",sync:"Syncs across Android and browser-based access",export:"Exports are supported through account data export tools, though not highlighted as a major free-tier feature in the sources",restriction:"No major paid wall is emphasized in the source; the practical limitation is its very minimal feature set"},{app:"Joplin",offline:"Designed for offline-first use with local note storage[4][5]",sync:"Sync is available, but setup depends on the sync method you choose",export:"Strong portability: notes are stored locally and can be exported as files you control",restriction:"The main free-plan limitation is that advanced sync convenience is not bundled as a paid-less, turnkey service"}]}
root=Column([a,b,c,g,h],gap="md",padding=16)
