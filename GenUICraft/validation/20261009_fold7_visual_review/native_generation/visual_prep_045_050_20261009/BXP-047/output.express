<a2ui>
$/={battery_comparison:[{chemistry:"LFP",energy_density:"Lower than NMC; IEA says LFP packs are about one-fifth lower by mass and one-third lower by volume than NMC packs [22]",cycle_life:"Typically long; sources cite roughly 2,000–6,000+ cycles, with some BESS-grade cells higher [3][18]",safety:"Strong; better thermal stability and lower thermal-runaway risk than NMC",cost:"Lower; IEA says LFP packs were almost 30% cheaper per kWh than NMC in 2025, and more than 40% cheaper on average in 2025 data[21]",maturity:"Mature, widely deployed in EVs and especially stationary storage",best_fit:"For EVs, NMC is best for maximum range, lower pack weight, and compact packaging. LFP is better for cost-sensitive EVs, fleet vehicles, and urban cars where safety, durability, and lower lifetime cost matter more than peak energy density. Sodium-ion is a good fit for short-range EVs, cold-climate use cases, and low-cost mobility, but its lower energy density still limits it in long-range vehicles. For stationary storage, LFP is usually the default choice because its long cycle life, strong safety profile, and lower cost align well with daily cycling and large-scale systems. Sodium-ion is also promising for grid storage and backup power, especially where raw energy density matters less than safety, supply-chain resilience, and cost potential. NMC is generally less attractive for stationary storage unless a project specifically needs higher energy density in a constrained footprint.",best_fit_summary:"If you need the safest and most economical mainstream option, choose LFP. If you need the highest range in the smallest battery, choose NMC. If you want an emerging lower-risk chemistry for storage or lower-cost EVs, sodium-ion is promising but still less mature."}],practical_takeaway:[{recommendation:"LFP",reasoning:"Safest and most economical mainstream option."},{recommendation:"NMC",reasoning:"Highest range in the smallest battery."},{recommendation:"Sodium-ion",reasoning:"Emerging lower-risk chemistry for storage or lower-cost EVs."}]}
root=Column([a,b,c,d,e,f,g,h,i,j,k,l,m],gap="md",padding=16)
a=Text("Battery comparison","h2")
b=Table(columns=[{key:"chemistry",label:"Chemistry"},{key:"energy_density",label:"Energy density"},{key:"cycle_life",label:"Cycle life"},{key:"safety",label:"Safety"},{key:"cost",label:"Cost"},{key:"maturity",label:"Maturity"},{key:"best_fit",label:"Best-fit uses"}],statePath="/battery_comparison",domain="comparison",preferredPresentation="cards",primaryColumn="chemistry",highlightColumns=["best_fit"])
c=Text("Best-fit uses","h2")
d=Text("For EVs, NMC is best when maximum range, lower pack weight, and compact packaging are priorities, such as premium cars and long-range models. LFP is better for cost-sensitive EVs, fleet vehicles, and urban cars where safety, durability, and lower lifetime cost matter more than peak energy density. Sodium-ion is a good fit for short-range EVs, cold-climate use cases, and low-cost mobility, but its lower energy density still limits it in long-range vehicles.\n\nFor stationary storage, LFP is usually the default choice because its long cycle life, strong safety profile, and lower cost align well with daily cycling and large-scale systems. Sodium-ion is also promising for grid storage and backup power, especially where raw energy density matters less than safety, supply-chain resilience, and cost potential. NMC is generally less attractive for stationary storage unless a project specifically needs higher energy density in a constrained footprint.",variant="body")
e=Text("Practical takeaway","h2")
f=Table(columns=[{key:"recommendation",label:"Recommendation"},{key:"reasoning",label:"Reasoning"}],statePath="/practical_takeaway",domain="generic",preferredPresentation="table")
g=Text("LFP: Safest and most economical mainstream option.","h3")
h=Text("NMC: Highest range in the smallest battery.","h3")
i=Text("Sodium-ion: Emerging lower-risk chemistry for storage or lower-cost EVs.","h3")
j=Text("End of comparison.","h3")
