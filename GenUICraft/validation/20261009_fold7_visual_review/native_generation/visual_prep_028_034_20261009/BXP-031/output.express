<a2ui>
$/={checklist_items:[{item:"RERA registration certificate",details:"Confirms the project is registered under Karnataka RERA, which is required for qualifying apartment projects; verify it on the Karnataka RERA portal using the project name or registration number.",source:"[1][3][4][9]"},{item:"Sanctioned building plan",details:"Confirms the building layout, floors, and units were approved by the competent authority; verify it with the BBMP, BDA, or other local planning authority and cross-check the same plan details against RERA records.",source:"[13]"},{item:"Title documents / title chain",details:"Establishes who owns the land and whether the seller has a valid right to transfer it; verify the mother deed, prior sale deeds, partition deeds, and related title records at the Sub-Registrar’s office or through Karnataka’s registration record system, and have an independent lawyer review the chain.",source:"[2][5][10][14][15]"},{item:"Occupancy Certificate (OC)",details:"Confirms the building has been certified fit for occupation and generally matches approved norms; verify it with the BBMP or the issuing municipal/planning authority before taking possession.",source:"[7]"},{item:"Encumbrance Certificate (EC)",details:"Shows registered transactions and helps identify mortgages, charges, attachments, or other encumbrances on the property; verify it at the Sub-Registrar’s office or through Karnataka’s online registration services, and ensure the period covered is sufficiently long.",source:""}]}
root=Column([a,b,c,g,m,s,y,ae],gap="md",padding=16)
a=Text("Pre-purchase document checklist for an apartment in Karnataka","h2")
b=Table(columns=[{key:"item",label:"Document"},{key:"details",label:"Verification Details"},{key:"source",label:"Source"}],statePath="/checklist_items",domain="generic",preferredPresentation="cards")
c=Column([d,e,f,i,l,o],gap="md")
d=Text("What each document should tell you","h2")
e=Text("RERA registration should match the developer name, project name, location, phase, and registration number shown in the brochure and agreement; if the project is not listed on the Karnataka RERA portal, that is a major warning sign.",variant="body")
f=Text("Sanctioned plan should match the actual apartment layout, number of floors, and unit configuration being sold; deviations between the approved plan and marketing material should be treated as a red flag.",variant="body")
g=Column([h,i,j,k,l],gap="md")
h=Text("Title chain should be continuous and unbroken, showing clear ownership from the root document to the present seller; missing links, unregistered transfers, or mismatched names require legal clarification.",variant="body")
i=Text("OC should exist for ready-to-move flats; possession without it can indicate the building has not been fully regularised for occupation.",variant="body")
j=Text("EC should be checked for undisclosed loans, attachments, or other registered claims; any active charge should be resolved before purchase.",variant="body")
k=Text("Minimal buy-only-if checklist","h2")
l=Text("RERA registration is valid and matches the project.",variant="body")
m=Text("Sanctioned plan matches what is being sold.",variant="body")
n=Text("Title chain is clear and complete.",variant="body")
o=Text("OC is available for a ready apartment.",variant="body")
p=Text("EC shows no unresolved encumbrance.",variant="body")
q=Column([r,s,t,u,v],gap="md")
r=Text("Where to verify each item","h2")
s=Text("Karnataka RERA portal: RERA registration details, promoter/project status, and related project disclosures.",variant="body")
t=Text("BBMP / BDA / local planning authority: Sanctioned building plan and, where applicable, Occupancy Certificate and other municipal approvals.",variant="body")
u=Text("Sub-Registrar’s office / Karnataka registration records: Title deeds, sale deed chain, and Encumbrance Certificate.",variant="body")
v=Text("Independent property lawyer: Final legal review of title chain, approvals, and any inconsistencies before payment.",variant="body")
w=Card([x])
x=Column([y,z],"sm",padding=16)
y=Text("Current official portal data can change, so verify the latest records directly before paying any booking amount.",variant="body")
z=Text("Thank you for your interest in this property.","h3")
</a2ui>