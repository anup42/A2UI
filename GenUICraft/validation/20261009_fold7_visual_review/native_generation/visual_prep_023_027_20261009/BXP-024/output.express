<a2ui>
$/={collection_options:[{option:"Drop-off at a certified recycler or collection centre",details:"Bengaluru options listed in the search results include RecycleKaro’s Bengaluru facility, Saahas, Croma stores, and other listed recyclers/collection points that accept batteries."},{option:"Scheduled home pickup",details:"RecycleKaro and EcoFlyp both describe pickup services, and Zolopik also offers pickup for battery/e-waste collection in Bengaluru."},{option:"Manufacturer or brand take-back",details:"Some brands and authorised partners offer battery/e-waste return programs, including brand-linked collection or pickup arrangements."}],storage_precautions:[{point:"Keep the battery separate from regular waste",detail:"Do not put it in household garbage."},{point:"Store it in a cool, dry place",detail:"Away from heat, sunlight, and moisture; keep it out of reach of children and pets."},{point:"Do not puncture, crush, bend, or open it",detail:"If it is swollen or damaged, handle it especially carefully and do not force it."},{point:"Tape the terminals if it is loose",detail:"Place it in a non-conductive container or bag to reduce the risk of short-circuiting."},{point:"Do not keep it near metal objects",detail:"Such as coins, keys, or tools that could bridge the terminals."}],verification_points:[{point:"Authorization",detail:"Confirm that the recycler or pickup service is CPCB/KSPCB-authorized or otherwise clearly certified."},{point:"Battery acceptance",detail:"Verify that the centre accepts laptop batteries specifically, since some points accept only certain categories of e-waste."},{point:"Pickup/drop-off terms",detail:"Check whether it is a free drop-off, scheduled pickup, or paid service, and whether any minimum quantity applies."},{point:"Receipt or confirmation",detail:"Ask for written or digital proof that the battery was received for lawful recycling or disposal."},{point:"Data-related items",detail:"If you are also handing over the laptop, back up data, sign out of accounts, and factory reset the device first; this is less relevant for the battery alone but important if the laptop is included."},{point:"Condition reporting",detail:"Tell the handler whether the battery is swollen, leaking, or physically damaged so they can apply the right handling process."}]}
root=Column([a,b,c,g,k,l],gap="md",padding=16)
a=Text("A Bengaluru resident should dispose of a used laptop battery through a certified e-waste recycler, authorised collection centre, or verified manufacturer take-back/pickup service that explicitly accepts batteries. RecycleKaro lists Bengaluru drop-off and pickup options, EcoFlyp lists multiple Bengaluru organisations and drop-off points that accept batteries, and RecycleKaro’s guidance specifically says to use CPCB or KSPCB-authorized recyclers.",variant="body")
b=Text("Approved collection options","h2")
c=Table(columns=[{key:"option",label:"Option"},{key:"details",label:"Details"}],statePath="/collection_options",domain="generic",preferredPresentation="cards")
d=Text("Storage precautions before handing it over","h2")
e=Table(columns=[{key:"point",label:"Precaution"},{key:"detail",label:"Detail"}],statePath="/storage_precautions",domain="generic",preferredPresentation="cards")
f=Text("What to verify before handing it over","h2")
g=Table(columns=[{key:"point",label:"Verification Point"},{key:"detail",label:"Detail"}],statePath="/verification_points",domain="generic",preferredPresentation="cards")
h=Text("If you want, I can also help you find the nearest Bengaluru drop-off option from the listed centres and pick the most convenient one.",variant="body")
</a2ui>