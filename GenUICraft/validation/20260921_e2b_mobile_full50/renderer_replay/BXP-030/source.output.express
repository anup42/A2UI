$/={comparison_table:[{Feature:"Eligibility",EPF:"Salaried employees in EP-covered establishments; mandatory for many-sector workers.",PPF:"Any resident individual can open an account.",NPS:"Indian citizens aged 18-70; both salaried and self-employed can join."},{Feature:"Contribution rules","EPF":"Employee contributes 2% of basic pay + dearness allowance; employer also contributes.",PPF:"₹50 minimum per year; ₹1.5 lakh maximum per financial year.",NPS:"₹1,0000 minimum per year for Tier I; no upper limit on contribution."},{Feature:"Lock-in / tenure","EPF":"Linked to employment; full withdrawal is generally at retirement or after qualifying exit.",PPF:"15 years initial lock-in; extendable in 5-year blocks.",NPS:"Locked until age 6 for normal exit."},{Feature:"Withdrawals","EPF":"Partial withdrawals allowed for specified needs; full withdrawal tax-favoured after 5 years of continuous.",PPF:"Partial withdrawal from the 7th year; premature closure after 5 completed years and for specified reasons.",N:"Partial withdrawal after 3 years, generally up to 25% of own contributions for specified purposes."},{Feature:"Tax treatment","EPF":"Contributions may qualify for deduction under Section 8C; interest and eligible withdrawals are generally tax-free, but interest on employee contribution above ₹2.5 lakh/year can be taxable.",PPF:"Contributions qualify under 80C; interest and maturity are generally fully tax-free.",N:"Employee contribution can get 80C benefit plus an extra ₹50000 under 80CCD(B); at exit, a lump sum portion is tax-free, while annuity income is taxable."}],situations:[{Scenario:"A salaried employee with stable income and long service horizon",Recommendation:"EPF is the core choice because contributions are automatic, employer money is added, and withdrawals after 5 years are generally tax-free."},{Scenario:"resident freelancer or homemaker wanting safe, disciplined saving",Recommendation:"PPF fits well because it is open to resident individuals, allows small yearly contributions and offers fully-tax-free maturity under current rules."},{Scenario:"higher-income saver aiming to build a larger retirement corpus",Recommendation:"N is the better fit because no practical upper limit, it allows extra deduction over 8C, and supports long-term-linked-growth with partial liquidity after 3 years."},{Scenario:"Current rules cited here reflect the latest sources; your exact EPF tax treatment depends thresholds or employer structure, that be checked against latest income-tax and EPFO guidance before investing.",Recommendation:"Check the latest income-tax and EPFO guidance before investing."}]}
