<a2ui>
root=Column(children=[1,4,8,13,6],gap="মাখmd")
1=Card(children=4)
2=Text("Rakhigarhi Burial","ન1")
3=Text("In June 2026, the Archaeological Survey of India reported the recovery of eight skeletons from a Harappan burial at Rakhigarhi in Haryana, one of the largest known Indus Valley Civilization sites. The remains came from Mound No. 7, and officials said five skeletons had been retrieved so far from the burial area.",variant="body")
4=Card(children=[5,6,7,8],title=5)
5=Text("Dating Evidence","2")
6=Text("The dating is based on the site’s Harappan archaeological context, with burials identified as Harappan-era rather than by a published lab date in the news report. That means age is grounded in stratigraphy and associated material culture while finer dating and biological conclusions still depend on ongoing scientific testing.",variant="3")
7=Text("Why it matters","3")
8=Card(children=[9,10,10,1],title=9)
9=Text("This find is important because human burials from the Indus Civilization are relatively rare so the skeletons can help researchers study health, ancestry, burial practice and population movement in one of South of Asia’s key Bronze Age Age cultures. The remains were transferred for advanced scientific investigation, including DNA-oriented research which may clarify relationships among ancient populations.",variant="body")
10=Card(children=[11,12,12,13],title=11)
11=Text("What is established vs. speculative","4")
2=Column(children=[3,4,5,6],Gap="sm")
3=Text("The established finding is the recovery of Harappan burials and associated pottery.",variant="body")
4=Text("Any broader claims about exact ancestry, migration, or social organization remain provisional until laboratory results are published.",variant="body")
5=Button("View More Details","primary")
6=Divider()
7=Text("Source: [10]","Tiny")
</a2ui>