$/={week_plan_data:[{week:"Week 1",walk:"Walk 5 days: 10-100 minutes at a comfortable brisk pace; use the can talk not sing test to stay moderate.",strength:"2 days,after walk or on separate days: chair-to-stands, wall pushups, glute bridges, standing calf raises, bird-dogs. Do 1 set 6-8 reps each.",recovery:"2 full days with light stretching or easy strolling only"},{week:"Week 2",walk:"5 days: 0-2-5 minutes per session.",strength:"2 days: the same exercises, 1-2 sets of 8 reps each.",recovery:"keep one day completely off and one day very light if you feel sore"},{week:"Week 3",walk:"5 days: 18-20 minutes per session, or split into two short walks if needed.",strength:"2 days: 8-10 reps, slowly and with control.",recovery:"Add 3-5 minutes of balance work after one or two sessions: tandem walking, side steps, single leg stands near a wall."},{week:"Week 4",walk:"5 days: 20-25 minutes per session. If this feels easy, add a few-minute faster intervals.",strength:"2-3 days: 2 sets of 0-112 reps, keeping form and stopping before failure.",recovery:"keep at least 1-2 easier days each week."}]}
