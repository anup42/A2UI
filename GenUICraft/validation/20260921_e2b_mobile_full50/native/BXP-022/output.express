$/={_sunlight:[{requirement:"at least 6 hours direct sun daily",best_location:"south or west-facing balcony",caution:"avoid letting taller plants shade tomato"}],_watering:[{method:"regularly and evenly",goal:"soil stays moist not soggy",note:"container tomatoes dry out faster than ground plants"},{method:"check daily",condition:"in hot weather",action:"make pot has good drainage"}],_problems:[{type:"Blossom drop or poor fruit set",cause:"undersized pots, heat, or inconsistent watering"},{type:"Blossom-rot",cause:"irregular moisture and calcium uptake problems, especially in small containers"}]}
