.gitattributes text eol=lf
*.sh text eol=lf
*.bash text eol=lf
*.sbatch text eol=lf

# Kotlin sources feed the GenUI metric renderer manifest hash. Pin LF so the
# hash is identical regardless of a contributor's core.autocrlf setting.
*.kt text eol=lf

# These Golden-32 sidecars are bound by byte-for-byte SHA-256 in the training
# dataset config. Preserve their supplied CRLF bytes on every checkout so the
# same immutable digest is valid on Windows and Linux training hosts.
dataset/data/runs/genui_demo_golden40_gemini38_20260903/genui.jsonl -text whitespace=cr-at-eol
dataset/data/runs/genui_demo_golden40_gemini38_20260903/responses.jsonl -text whitespace=cr-at-eol
training/configs/datasets/golden32_20260903_eval.yaml text eol=lf
# Explicit repeat revision is hash-bound and portable across GPU hosts.
training/data/eval/golden32_archive_repeat_v1/*.jsonl text eol=lf
training/data/eval/golden32_archive_repeat_v1/*.json text eol=lf
# Golden35 is a frozen strict subset with independently pinned file bytes.
training/data/eval/golden35_v1/*.jsonl text eol=lf
training/data/eval/golden35_v1/*.json text eol=lf
# Reproduction pins the historical source's supplied CRLF working-tree bytes.
dataset/data/runs/golden50_g25pro_20260309_204033_stitch_compare_20260429_hybrid_r4/genui.jsonl text eol=crlf
dataset/data/runs/golden50_g25pro_20260309_204033_stitch_compare_20260429_hybrid_r4/responses.jsonl text eol=crlf
training/data/eval/bixby50_v1/*.json text eol=lf
training/data/eval/bixby50_v1/*.jsonl text eol=lf
# Training split bundles must preserve compressed bytes on every platform.
training/data/train/v10/*.gz -text -diff
training/data/train/v10/*.json text eol=lf
training/data/train/v10/*.py text eol=lf
training/data/train/v10/*.md text eol=lf
# New audit catalogs and artifact manifests are SHA-256 bound.
training/data/quality/*.json text eol=lf
training/reports/v10_manual100_20260916/* -text whitespace=cr-at-eol
training/reports/offline_recovery_20260916_v10/*.json text eol=lf
# Keep the Android benchmark corpus byte-identical to its validated snapshot.
android/app/src/main/assets/genuicraft_bixby50.jsonl -text whitespace=cr-at-eol

# v11/v11s preserve the supplied release bytes and original split hashes.
training/data/train/v11/*.gz -text -diff
training/data/train/v11s/*.gz -text -diff
training/data/train/v11/manifest.json -text whitespace=cr-at-eol
training/data/train/v11s/manifest.json -text whitespace=cr-at-eol
training/data/train/v11/prompt_scaffold.json -text whitespace=cr-at-eol
training/data/train/v11s/prompt_scaffold.json -text whitespace=cr-at-eol
training/data/train/v11/bundle.json text eol=lf
training/data/train/v11s/bundle.json text eol=lf
training/data/train/v11/*.py text eol=lf
training/data/train/v11s/*.py text eol=lf
training/data/train/v11/*.md text eol=lf
training/data/train/v11s/*.md text eol=lf
# Historical package audit files and policy snapshots are hash-bound evidence.
training/reports/dataset_v11_20260930/** -text whitespace=cr-at-eol,-blank-at-eof
training/reports/dataset_v11_20260930/**/*.gz -text -diff
# Imported audit implementations retain the SHA-bound supplier bytes.
training/scripts/*space_v11*.py -text whitespace=cr-at-eol
training/scripts/repair_v11_base.py -text whitespace=cr-at-eol
training/scripts/project_space_archive.py -text whitespace=cr-at-eol
training/tests/test_space_v11*.py -text whitespace=cr-at-eol

# Preserve the byte-bound inputs and output evidence in historical dataset audits.
training/reports/20260927_official_e2b_export_audit/** -text whitespace=cr-at-eol
training/reports/20260927_r64_metadata_audit/** -text whitespace=cr-at-eol
training/reports/v10_full_audit_20260926/** -text whitespace=cr-at-eol

# The reviewed training-source archive exceeds GitHub's regular Git file limit.
review_exports/official_e2b_lora_qat_training_bundle_ed0c433d.zip filter=lfs diff=lfs merge=lfs -text

# Preserve intentional whitespace in imported diagnostics and historical scoring evidence.
training/reports/v10_full_audit_20260926/duplicate_source_examples.csv whitespace=cr-at-eol,-blank-at-eol
