{
  "ui_id": "sample_001",
  "genui_json": [
    {
      "version": "v0.9",
      "createSurface": {
        "surfaceId": "sample_surface",
        "catalogId": "https://genui.local/specification/v0_9/standard_catalog.json",
        "theme": {
          "primaryColor": "#1F6FEB"
        }
      }
    },
    {
      "version": "v0.9",
      "updateComponents": {
        "surfaceId": "sample_surface",
        "components": [
          {
            "id": "root",
            "component": "Column",
            "children": [
              "header_row",
              "intro",
              "divider_1",
              "table",
              "action_row"
            ]
          },
          {
            "id": "header_row",
            "component": "Row",
            "align": "center",
            "children": [
              "icon",
              "title"
            ]
          },
          {
            "id": "icon",
            "component": "Image",
            "url": "https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/phone.svg",
            "variant": "icon",
            "fit": "contain"
          },
          {
            "id": "title",
            "component": "Text",
            "text": "Android GenUI Renderer",
            "variant": "h2"
          },
          {
            "id": "intro",
            "component": "Text",
            "text": "This app loads GenUI JSON, converts components to HTML, and renders the result in a WebView.",
            "variant": "body"
          },
          {
            "id": "divider_1",
            "component": "Divider"
          },
          {
            "id": "table",
            "component": "Column",
            "children": [
              "row_h",
              "row_1",
              "row_2"
            ]
          },
          {
            "id": "row_h",
            "component": "Row",
            "children": [
              "h1",
              "h2",
              "h3"
            ]
          },
          {
            "id": "h1",
            "component": "Text",
            "text": "Item",
            "variant": "h4",
            "weight": 1
          },
          {
            "id": "h2",
            "component": "Text",
            "text": "Value",
            "variant": "h4",
            "weight": 1
          },
          {
            "id": "h3",
            "component": "Text",
            "text": "Notes",
            "variant": "h4",
            "weight": 2
          },
          {
            "id": "row_1",
            "component": "Row",
            "children": [
              "r1c1",
              "r1c2",
              "r1c3"
            ]
          },
          {
            "id": "r1c1",
            "component": "Text",
            "text": "Parser",
            "weight": 1
          },
          {
            "id": "r1c2",
            "component": "Text",
            "text": "Supports JSON + JSONL",
            "weight": 1
          },
          {
            "id": "r1c3",
            "component": "Text",
            "text": "Reads first line for JSONL files",
            "weight": 2
          },
          {
            "id": "row_2",
            "component": "Row",
            "children": [
              "r2c1",
              "r2c2",
              "r2c3"
            ]
          },
          {
            "id": "r2c1",
            "component": "Text",
            "text": "Renderer",
            "weight": 1
          },
          {
            "id": "r2c2",
            "component": "Text",
            "text": "HTML + CSS output",
            "weight": 1
          },
          {
            "id": "r2c3",
            "component": "Text",
            "text": "Works offline for non-remote assets",
            "weight": 2
          },
          {
            "id": "action_row",
            "component": "Row",
            "children": [
              "button_docs"
            ]
          },
          {
            "id": "button_docs",
            "component": "Button",
            "variant": "primary",
            "child": "button_docs_text",
            "action": {
              "functionCall": {
                "call": "openUrl",
                "args": {
                  "url": "https://www.android.com"
                }
              }
            }
          },
          {
            "id": "button_docs_text",
            "component": "Text",
            "text": "Open Android Site"
          }
        ]
      }
    }
  ]
}
