ent-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[69,714][1011,1298]" drawing-order="0" hint=""><node index="0" text="5. The Risotto Method" resource-id="" class="android.widget.TextView" package="com.samsung.genuicraft" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[101,740][451,782]" drawing-order="0" hint="" /><node index="1" text="Begin adding the warm broth, one ladle (about 0.5 cup) at a time. Stir frequently. Wait until the liquid is almost completely absorbed before adding the next ladle. The friction from stirring rubs the grains together, releasing the starch that creates the creamy sauce. Repeat this process for about 20-25 minutes. The rice is done when it is tender but still has a slight bite (al dente)." resource-id="" class="android.widget.TextView" package="com.samsung.genuicraft" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[101,798][979,1272]" drawing-order="0" hint="" /></node><node index="3" text="" resource-id="" class="android.view.View" package="com.samsung.genuicraft" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[69,1319][1011,1903]" drawing-order="0" hint=""><node index="0" text="6. The Finish (Mantecatura)" resource-id="" class="android.widget.TextView" package="com.samsung.genuicraft" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="fa