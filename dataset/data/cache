2\",\n          \"component\": \"Text\",\n          \"text\": \"Check router for overheating and ensure proper ventilation\",\n          \"weight\": 1\n        },\n        {\n          \"id\": \"summary_r5c3\",\n          \"component\": \"Text\",\n          \"text\": \"Eliminate hardware failure due to excessive heat.\",\n          \"weight\": 1\n        },\n        {\n          \"id\": \"summary_row6\",\n          \"component\": \"Row\",\n          \"children\": [\n            \"summary_r6c1\",\n            \"summary_r6c2\",\n            \"summary_r6c3\"\n          ]\n        },\n        {\n          \"id\": \"summary_r6c1\",\n          \"component\": \"Text\",\n          \"text\": \"Final Resort\",\n          \"weight\": 1\n        },\n        {\n          \"id\": \"summary_r6c2\",\n          \"component\": \"Text\",\n          \"text\": \"Perform a factory reset on the router\",\n          \"weight\": 1\n        },\n        {\n          \"id\": \"summary_r6c3\",\n          \"component\": \"Text\",\n          \"text\": \"Clear any corrupted configurations and return to a known-good state.\",\n          \"weight\": 1\n        },\n        {\n          \"id\": \"images_section\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"images_heading\",\n            \"images_row\"\n          ]\n        },\n        {\n          \"id\": \"images_heading\",\n          \"component\": \"Text\",\n          \"variant\": \"h2\",\n          \"text\": \"Images\"\n        },\n        {\n          \"id\": \"images_row\",\n          \"component\": \"Row\",\n          \"justify\": \"spaceAround\",\n          \"children\": [\n            \"image1_col\",\n            \"image2_col\",\n            \"image3_col\"\n          ]\n        },\n        {\n          \"id\": \"image1_col\",\n          \"component\": \"Column\",\n          \"align\": \"center\",\n          \"children\": [\n            \"image1\",\n            \"image1_caption\"\n          ]\n        },\n        {\n          \"id\": \"image1\",\n          \"component\": \"Image\",\n          \"url\": \"../assets/r_000021_01_1_router.jpg\",\n          \"variant\": \"mediumFeature\"\n        },\n        {\n          \"id\": \"image1_caption\",\n          \"component\": \"Text\",\n          \"variant\": \"caption\",\n          \"text\": \"Netgear Nighthawk R7000\"\n        },\n        {\n          \"id\": \"image2_col\",\n          \"component\": \"Column\",\n          \"align\": \"center\",\n          \"children\": [\n            \"image2\",\n            \"image2_caption\"\n          ]\n        },\n        {\n          \"id\": \"image2\",\n          \"component\": \"Image\",\n          \"url\": \"../assets/r_000021_01_2_ethernet_cable.jpg\",\n          \"variant\": \"mediumFeature\"\n        },\n        {\n          \"id\": \"image2_caption\",\n          \"component\": \"Text\",\n          \"variant\": \"caption\",\n          \"text\": \"Ethernet Cable Connection\"\n        },\n        {\n          \"id\": \"image3_col\",\n          \"component\": \"Column\",\n          \"align\": \"center\",\n          \"children\": [\n            \"image3\",\n            \"image3_caption\"\n          ]\n        },\n        {\n          \"id\": \"image3\",\n          \"component\": \"Image\",\n          \"url\": \"../assets/r_000021_01_3_modem_router.jpg\",\n          \"variant\": \"mediumFeature\"\n        },\n        {\n          \"id\": \"image3_caption\",\n          \"component\": \"Text\",\n          \"variant\": \"caption\",\n          \"text\": \"Modem and Router Setup\"\n        },\n        {\n          \"id\": \"sources_section\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"sources_heading\",\n            \"sources_list\"\n          ]\n        },\n        {\n          \"id\": \"sources_heading\",\n          \"component\": \"Text\",\n          \"variant\": \"h2\",\n          \"text\": \"Sources\"\n        },\n        {\n          \"id\": \"sources_list\",\n", "raw": {"candidates": [{"content": {"parts": [{"text": "[\n  {\n    \"version\": \"v0.9\",\n    \"createSurface\": {\n      \"surfaceId\": \"netgear-troubleshooting-surface\",\n      \"catalogId\": \"https://genui.local/specification/v0_9/standard_catalog.json\"\n    }\n  },\n  {\n    \"version\": \"v0.9\",\n    \"updateComponents\": {\n      \"surfaceId\": \"netgear-troubleshooting-surface\",\n      \"components\": [\n        {\n          \"id\": \"root\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"header_title\",\n            \"intro_text\",\n            \"context_section\",\n            \"steps_section\",\n            \"summary_section\",\n            \"images_section\",\n            \"sources_section\"\n          ]\n        },\n        {\n          \"id\": \"header_title\",\n          \"component\": \"Text\",\n          \"variant\": \"h1\",\n          \"text\": \"Systematic Troubleshooting for Your Nighthawk R7000\"\n        },\n        {\n          \"id\": \"intro_text\",\n          \"component\": \"Text\",\n          \"variant\": \"body\",\n          \"text\": \"This guide provides a step-by-step process to diagnose the intermittent internet disconnects with your Netgear Nighthawk R7000 router. The goal is to isolate the cause of the issue, which is indicated by the amber internet light, before contacting Comcast support.\"\n        },\n        {\n          \"id\": \"context_section\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"context_heading\",\n            \"context_text\"\n          ]\n        },\n        {\n          \"id\": \"context_heading\",\n          \"component\": \"Text\",\n          \"variant\": \"h2\",\n          \"text\": \"Troubleshooting Context\"\n        },\n        {\n          \"id\": \"context_text\",\n          \"component\": \"Text\",\n          \"variant\": \"body\",\n          \"text\": \"This guide assumes you have a separate modem provided by Comcast and your Netgear R7000 router. The steps are ordered from least to most disruptive. You will need the login credentials for your router's admin panel; if you haven't changed them, the default is often username 'admin' and password 'password'.\"\n        },\n        {\n          \"id\": \"steps_section\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"steps_heading\",\n            \"steps_intro\",\n            \"steps_list\"\n          ]\n        },\n        {\n          \"id\": \"steps_heading\",\n          \"component\": \"Text\",\n          \"variant\": \"h2\",\n          \"text\": \"Step-by-Step Diagnostic Guide\"\n        },\n        {\n          \"id\": \"steps_intro\",\n          \"component\": \"Text\",\n          \"variant\": \"body\",\n          \"text\": \"Follow these steps in order to systematically identify the point of failure.\"\n        },\n        {\n          \"id\": \"steps_list\",\n          \"component\": \"List\",\n          \"direction\": \"vertical\",\n          \"children\": [\n            \"step1_card\",\n            \"step2_card\",\n            \"step3_card\",\n            \"step4_card\",\n            \"step5_card\",\n            \"step6_card\"\n          ]\n        },\n        {\n          \"id\": \"step1_card\",\n          \"component\": \"Card\",\n          \"child\": \"step1_content\"\n        },\n        {\n          \"id\": \"step1_content\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"step1_heading\",\n            \"step1_desc\",\n            \"step1_list\"\n          ]\n        },\n        {\n          \"id\": \"step1_heading\",\n          \"component\": \"Text\",\n          \"variant\": \"h3\",\n          \"text\": \"Step 1: Isolate the Router from the Network\"\n        },\n        {\n          \"id\": \"step1_desc\",\n          \"component\": \"Text\",\n          \"text\": \"This is the most critical step to determine if the router is the source of the problem.\"\n        },\n        {\n          \"id\": \"step1_list\",\n          \"component\": \"List\",\n          \"direction\": \"vertical\",\n          \"children\": [\n            \"step1_item1\",\n            \"step1_item2\"\n          ]\n        },\n        {\n          \"id\": \"step1_item1\",\n          \"component\": \"Text\",\n          \"text\": \"• When the next disconnect occurs, or if you prefer not to wait, unplug the Ethernet cable from your router's WAN (internet) port and plug it directly into your MacBook Pro's Ethernet port (using an adapter if necessary).\"\n        },\n        {\n          \"id\": \"step1_item2\",\n          \"component\": \"Text\",\n          \"text\": \"• Observe the connection for a couple of hours. If the disconnects stop, the problem is likely with the router. If the disconnects continue, the problem is more likely with your modem or the Comcast service itself.\"\n        },\n        {\n          \"id\": \"step2_card\",\n          \"component\": \"Card\",\n          \"child\": \"step2_content\"\n        },\n        {\n          \"id\": \"step2_content\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"step2_heading\",\n            \"step2_desc\",\n            \"step2_list\"\n          ]\n        },\n        {\n          \"id\": \"step2_heading\",\n          \"component\": \"Text\",\n          \"variant\": \"h3\",\n          \"text\": \"Step 2: Check Router Logs for Clues\"\n        },\n        {\n          \"id\": \"step2_desc\",\n          \"component\": \"Text\",\n          \"text\": \"Your router keeps a log of events, which can contain error messages that coincide with the disconnects.\"\n        },\n        {\n          \"id\": \"step2_list\",\n          \"component\": \"List\",\n          \"direction\": \"vertical\",\n          \"children\": [\n            \"step2_item1\",\n            \"step2_item2\",\n            \"step2_item3\",\n            \"step2_item4\"\n          ]\n        },\n        {\n          \"id\": \"step2_item1\",\n          \"component\": \"Row\",\n          \"align\": \"center\",\n          \"children\": [\n            \"step2_item1_text\",\n            \"step2_item1_button1\",\n            \"step2_item1_text2\",\n            \"step2_item1_button2\"\n          ]\n        },\n        {\n          \"id\": \"step2_item1_text\",\n          \"component\": \"Text\",\n          \"text\": \"• Access your router's admin panel by navigating to\"\n        },\n        {\n          \"id\": \"step2_item1_button1\",\n          \"component\": \"Button\",\n          \"variant\": \"borderless\",\n          \"child\": \"step2_item1_button1_text\",\n          \"action\": {\n            \"functionCall\": {\n              \"call\": \"openUrl\",\n              \"args\": {\n                \"url\": \"http://www.routerlogin.net\"\n              }\n            }\n          }\n        },\n        {\n          \"id\": \"step2_item1_button1_text\",\n          \"component\": \"Text\",\n          \"text\": \"http://www.routerlogin.net\"\n        },\n        {\n          \"id\": \"step2_item1_text2\",\n          \"component\": \"Text\",\n          \"text\": \"or\"\n        },\n        {\n          \"id\": \"step2_item1_button2\",\n          \"component\": \"Button\",\n          \"variant\": \"borderless\",\n          \"child\": \"step2_item1_button2_text\",\n          \"action\": {\n            \"functionCall\": {\n              \"call\": \"openUrl\",\n              \"args\": {\n                \"url\": \"http://192.168.1.1\"\n              }\n            }\n          }\n        },\n        {\n          \"id\": \"step2_item1_button2_text\",\n          \"component\": \"Text\",\n          \"text\": \"192.168.1.1\"\n        },\n        {\n          \"id\": \"step2_item2\",\n          \"component\": \"Text\",\n          \"text\": \"• Log in with your credentials.\"\n        },\n        {\n          \"id\": \"step2_item3\",\n          \"component\": \"Text\",\n          \"text\": \"• Navigate to the 'Advanced' tab, then find 'Administration' and 'Logs'.\"\n        },\n        {\n          \"id\": \"step2_item4\",\n          \"component\": \"Text\",\n          \"text\": \"• Look for critical errors, [DoS attack] alerts, or messages related to 'WAN port', 'DHCP', or 'Internet connection' that appear around the time of the disconnects. These can provide specific clues.\"\n        },\n        {\n          \"id\": \"step3_card\",\n          \"component\": \"Card\",\n          \"child\": \"step3_content\"\n        },\n        {\n          \"id\": \"step3_content\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"step3_heading\",\n            \"step3_desc\",\n            \"step3_list\"\n          ]\n        },\n        {\n          \"id\": \"step3_heading\",\n          \"component\": \"Text\",\n          \"variant\": \"h3\",\n          \"text\": \"Step 3: Update Router Firmware\"\n        },\n        {\n          \"id\": \"step3_desc\",\n          \"component\": \"Text\",\n          \"text\": \"Outdated firmware can cause performance and stability issues.\"\n        },\n        {\n          \"id\": \"step3_list\",\n          \"component\": \"List\",\n          \"direction\": \"vertical\",\n          \"children\": [\n            \"step3_item1\",\n            \"step3_item2\"\n          ]\n        },\n        {\n          \"id\": \"step3_item1\",\n          \"component\": \"Text\",\n          \"text\": \"• In the router admin panel, go to 'Advanced', then 'Administration' and 'Firmware Update' or 'Router Update'.\"\n        },\n        {\n          \"id\": \"step3_item2\",\n          \"component\": \"Text\",\n          \"text\": \"• The router can check for new firmware automatically. If a new version is available, follow the on-screen instructions to install it.\"\n        },\n        {\n          \"id\": \"step4_card\",\n          \"component\": \"Card\",\n          \"child\": \"step4_content\"\n        },\n        {\n          \"id\": \"step4_content\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"step4_heading\",\n            \"step4_desc\",\n            \"step4_list\"\n          ]\n        },\n        {\n          \"id\": \"step4_heading\",\n          \"component\": \"Text\",\n          \"variant\": \"h3\",\n          \"text\": \"Step 4: Change DNS Server Settings\"\n        },\n        {\n          \"id\": \"step4_desc\",\n          \"component\": \"Text\",\n          \"text\": \"Sometimes, an ISP's DNS servers can be unreliable. Switching to a public DNS provider is a good troubleshooting step.\"\n        },\n        {\n          \"id\": \"step4_list\",\n          \"component\": \"List\",\n          \"direction\": \"vertical\",\n          \"children\": [\n            \"step4_item1\",\n            \"step4_item2\",\n            \"step4_item3\",\n            \"step4_item4\"\n          ]\n        },\n        {\n          \"id\": \"step4_item1\",\n          \"component\": \"Text\",\n          \"text\": \"• In the router admin panel, go to the 'Basic' tab and select 'Internet'.\"\n        },\n        {\n          \"id\": \"step4_item2\",\n          \"component\": \"Text\",\n          \"text\": \"• Under 'Domain Name Server (DNS) Address', select 'Use These DNS Servers'.\"\n        },\n        {\n          \"id\": \"step4_item3\",\n          \"component\": \"Text\",\n          \"text\": \"• Enter public DNS servers. For example, Google DNS (Primary: 8.8.8.8, Secondary: 8.8.4.4) or Cloudflare DNS (Primary: 1.1.1.1, Secondary: 1.0.0.1).\"\n        },\n        {\n          \"id\": \"step4_item4\",\n          \"component\": \"Text\",\n          \"text\": \"• Apply the changes and monitor the connection.\"\n        },\n        {\n          \"id\": \"step5_card\",\n          \"component\": \"Card\",\n          \"child\": \"step5_content\"\n        },\n        {\n          \"id\": \"step5_content\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"step5_heading\",\n            \"step5_desc\",\n            \"step5_list\"\n          ]\n        },\n        {\n          \"id\": \"step5_heading\",\n          \"component\": \"Text\",\n          \"variant\": \"h3\",\n          \"text\": \"Step 5: Check for Overheating\"\n        },\n        {\n          \"id\": \"step5_desc\",\n          \"component\": \"Text\",\n          \"text\": \"Ensure the router has adequate ventilation. If it's hot to the touch, it may be overheating, causing intermittent failures.\"\n        },\n        {\n          \"id\": \"step5_list\",\n          \"component\": \"List\",\n          \"direction\": \"vertical\",\n          \"children\": [\n            \"step5_item1\",\n            \"step5_item2\"\n          ]\n        },\n        {\n          \"id\": \"step5_item1\",\n          \"component\": \"Text\",\n          \"text\": \"• Make sure the router is in an open area, not in a cabinet or stacked with other electronics.\"\n        },\n        {\n          \"id\": \"step5_item2\",\n          \"component\": \"Text\",\n          \"text\": \"• Ensure the ventilation holes are not blocked by dust or debris.\"\n        },\n        {\n          \"id\": \"step6_card\",\n          \"component\": \"Card\",\n          \"child\": \"step6_content\"\n        },\n        {\n          \"id\": \"step6_content\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"step6_heading\",\n            \"step6_desc\",\n            \"step6_list\"\n          ]\n        },\n        {\n          \"id\": \"step6_heading\",\n          \"component\": \"Text\",\n          \"variant\": \"h3\",\n          \"text\": \"Step 6: Perform a Factory Reset\"\n        },\n        {\n          \"id\": \"step6_desc\",\n          \"component\": \"Text\",\n          \"text\": \"This is a final step if all else fails. A factory reset will erase all your custom settings, including your Wi-Fi name, password, and any port forwarding rules.\"\n        },\n        {\n          \"id\": \"step6_list\",\n          \"component\": \"List\",\n          \"direction\": \"vertical\",\n          \"children\": [\n            \"step6_item1\",\n            \"step6_item2\"\n          ]\n        },\n        {\n          \"id\": \"step6_item1\",\n          \"component\": \"Text\",\n          \"text\": \"• With the router powered on, use a paperclip or similar object to press and hold the 'Reset' button on the back of the router for about 10 seconds.\"\n        },\n        {\n          \"id\": \"step6_item2\",\n          \"component\": \"Text\",\n          \"text\": \"• The router will reboot with factory default settings. You will need to reconfigure it from scratch. Monitor to see if the issue is resolved.\"\n        },\n        {\n          \"id\": \"summary_section\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"summary_heading\",\n            \"summary_table\"\n          ]\n        },\n        {\n          \"id\": \"summary_heading\",\n          \"component\": \"Text\",\n          \"variant\": \"h2\",\n          \"text\": \"Diagnostic Action Summary\"\n        },\n        {\n          \"id\": \"summary_table\",\n          \"component\": \"List\",\n          \"direction\": \"vertical\",\n          \"children\": [\n            \"summary_header_row\",\n            \"summary_divider\",\n            \"summary_row1\",\n            \"summary_row2\",\n            \"summary_row3\",\n            \"summary_row4\",\n            \"summary_row5\",\n            \"summary_row6\"\n          ]\n        },\n        {\n          \"id\": \"summary_header_row\",\n          \"component\": \"Row\",\n          \"children\": [\n            \"summary_header1\",\n            \"summary_header2\",\n            \"summary_header3\"\n          ]\n        },\n        {\n          \"id\": \"summary_header1\",\n          \"component\": \"Text\",\n          \"text\": \"Stage\",\n          \"weight\": 1\n        },\n        {\n          \"id\": \"summary_header2\",\n          \"component\": \"Text\",\n          \"text\": \"Action\",\n          \"weight\": 1\n        },\n        {\n          \"id\": \"summary_header3\",\n          \"component\": \"Text\",\n          \"text\": \"Goal\",\n          \"weight\": 1\n        },\n        {\n          \"id\": \"summary_divider\",\n          \"component\": \"Divider\"\n        },\n        {\n          \"id\": \"summary_row1\",\n          \"component\": \"Row\",\n          \"children\": [\n            \"summary_r1c1\",\n            \"summary_r1c2\",\n            \"summary_r1c3\"\n          ]\n        },\n        {\n          \"id\": \"summary_r1c1\",\n          \"component\": \"Text\",\n          \"text\": \"Isolation\",\n          \"weight\": 1\n        },\n        {\n          \"id\": \"summary_r1c2\",\n          \"component\": \"Text\",\n          \"text\": \"Connect a computer directly to the modem\",\n          \"weight\": 1\n        },\n        {\n          \"id\": \"summary_r1c3\",\n          \"component\": \"Text\",\n          \"text\": \"Confirm if the router is the source of the problem.\",\n          \"weight\": 1\n        },\n        {\n          \"id\": \"summary_row2\",\n          \"component\": \"Row\",\n          \"children\": [\n            \"summary_r2c1\",\n            \"summary_r2c2\",\n            \"summary_r2c3\"\n          ]\n        },\n        {\n          \"id\": \"summary_r2c1\",\n          \"component\": \"Text\",\n          \"text\": \"Investigation\",\n          \"weight\": 1\n        },\n        {\n          \"id\": \"summary_r2c2\",\n          \"component\": \"Text\",\n          \"text\": \"Review the router's system logs\",\n          \"weight\": 1\n        },\n        {\n          \"id\": \"summary_r2c3\",\n          \"component\": \"Text\",\n          \"text\": \"Find specific error messages that correlate with the disconnects.\",\n          \"weight\": 1\n        },\n        {\n          \"id\": \"summary_row3\",\n          \"component\": \"Row\",\n          \"children\": [\n            \"summary_r3c1\",\n            \"summary_r3c2\",\n            \"summary_r3c3\"\n          ]\n        },\n        {\n          \"id\": \"summary_r3c1\",\n          \"component\": \"Text\",\n          \"text\": \"Maintenance\",\n          \"weight\": 1\n        },\n        {\n          \"id\": \"summary_r3c2\",\n          \"component\": \"Text\",\n          \"text\": \"Update the router to the latest firmware\",\n          \"weight\": 1\n        },\n        {\n          \"id\": \"summary_r3c3\",\n          \"component\": \"Text\",\n          \"text\": \"Apply bug fixes and stability improvements from the manufacturer.\",\n          \"weight\": 1\n        },\n        {\n          \"id\": \"summary_row4\",\n          \"component\": \"Row\",\n          \"children\": [\n            \"summary_r4c1\",\n            \"summary_r4c2\",\n            \"summary_r4c3\"\n          ]\n        },\n        {\n          \"id\": \"summary_r4c1\",\n          \"component\": \"Text\",\n          \"text\": \"Configuration\",\n          \"weight\": 1\n        },\n        {\n          \"id\": \"summary_r4c2\",\n          \"component\": \"Text\",\n          \"text\": \"Change router's DNS servers to a public provider\",\n          \"weight\": 1\n        },\n        {\n          \"id\": \"summary_r4c3\",\n          \"component\": \"Text\",\n          \"text\": \"Rule out issues with the ISP's default DNS service.\",\n          \"weight\": 1\n        },\n        {\n          \"id\": \"summary_row5\",\n          \"component\": \"Row\",\n          \"children\": [\n            \"summary_r5c1\",\n            \"summary_r5c2\",\n            \"summary_r5c3\"\n          ]\n        },\n        {\n          \"id\": \"summary_r5c1\",\n          \"component\": \"Text\",\n          \"text\": \"Environment\",\n          \"weight\": 1\n        },\n        {\n          \"id\": \"summary_r5c2\",\n          \"component\": \"Text\",\n          \"text\": \"Check router for overheating and ensure proper ventilation\",\n          \"weight\": 1\n        },\n        {\n          \"id\": \"summary_r5c3\",\n          \"component\": \"Text\",\n          \"text\": \"Eliminate hardware failure due to excessive heat.\",\n          \"weight\": 1\n        },\n        {\n          \"id\": \"summary_row6\",\n          \"component\": \"Row\",\n          \"children\": [\n            \"summary_r6c1\",\n            \"summary_r6c2\",\n            \"summary_r6c3\"\n          ]\n        },\n        {\n          \"id\": \"summary_r6c1\",\n          \"component\": \"Text\",\n          \"text\": \"Final Resort\",\n          \"weight\": 1\n        },\n        {\n          \"id\": \"summary_r6c2\",\n          \"component\": \"Text\",\n          \"text\": \"Perform a factory reset on the router\",\n          \"weight\": 1\n        },\n        {\n          \"id\": \"summary_r6c3\",\n          \"component\": \"Text\",\n          \"text\": \"Clear any corrupted configurations and return to a known-good state.\",\n          \"weight\": 1\n        },\n        {\n          \"id\": \"images_section\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"images_heading\",\n            \"images_row\"\n          ]\n        },\n        {\n          \"id\": \"images_heading\",\n          \"component\": \"Text\",\n          \"variant\": \"h2\",\n          \"text\": \"Images\"\n        },\n        {\n          \"id\": \"images_row\",\n          \"component\": \"Row\",\n          \"justify\": \"spaceAround\",\n          \"children\": [\n            \"image1_col\",\n            \"image2_col\",\n            \"image3_col\"\n          ]\n        },\n        {\n          \"id\": \"image1_col\",\n          \"component\": \"Column\",\n          \"align\": \"center\",\n          \"children\": [\n            \"image1\",\n            \"image1_caption\"\n          ]\n        },\n        {\n        