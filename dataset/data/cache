t\": \"h2\"\n        },\n        {\n          \"id\": \"context_text\",\n          \"component\": \"Text\",\n          \"text\": \"Budget breakdown assumes: Suica card (2,000 JPY initial), train passes (1,500 JPY/day average), temple/shrine entries (free-1,000 JPY each), high-end ramen (1,500-2,000 JPY per meal), anime shops/arcades (2,000-3,000 JPY discretionary), remaining budget for casual meals and minor attractions. May weather in Tokyo averages 18-25°C with occasional rain; comfortable walking clothes recommended. Ramen restaurants listed are popular but require advance research for current hours and reservation policies.\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"itinerary_section_title\",\n          \"component\": \"Text\",\n          \"text\": \"Day-by-Day Itinerary\",\n          \"variant\": \"h2\"\n        },\n        {\n          \"id\": \"day1_card\",\n          \"component\": \"Card\",\n          \"child\": \"day1_content\"\n        },\n        {\n          \"id\": \"day1_content\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"day1_title\",\n            \"day1_morning_header\",\n            \"day1_morning_text\",\n            \"day1_lunch_header\",\n            \"day1_lunch_text\",\n            \"day1_afternoon_header\",\n            \"day1_afternoon_text\",\n            \"day1_dinner_header\",\n            \"day1_dinner_text\",\n            \"day1_evening_header\",\n            \"day1_evening_text\"\n          ]\n        },\n        {\n          \"id\": \"day1_title\",\n          \"component\": \"Text\",\n          \"text\": \"DAY 1: AKIHABARA & SHIBUYA (May 10)\",\n          \"variant\": \"h3\"\n        },\n        {\n          \"id\": \"day1_morning_header\",\n          \"component\": \"Text\",\n          \"text\": \"Morning (8:00 AM - 12:00 PM)\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"day1_morning_text\",\n          \"component\": \"Text\",\n          \"text\": \"Start at Akihabara Station. Explore anime/manga shops on Electric Town Street and Chuo-dori. Visit multi-story arcades (Sega, Round1) for rhythm games and claw machines. Browse vintage anime goods at smaller shops. Cost: 2,000-3,000 JPY for arcade games and light shopping.\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"day1_lunch_header\",\n          \"component\": \"Text\",\n          \"text\": \"Lunch (12:30 PM)\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"day1_lunch_text\",\n          \"component\": \"Text\",\n          \"text\": \"Ichiran Ramen (Akihabara branch) - high-quality tonkotsu ramen, individual booths, approximately 1,000-1,200 JPY. Known for consistency and rich broth.\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"day1_afternoon_header\",\n          \"component\": \"Text\",\n          \"text\": \"Afternoon (2:00 PM - 5:00 PM)\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"day1_afternoon_text\",\n          \"component\": \"Text\",\n          \"text\": \"Take Ginza Line from Akihabara to Shibuya (15 minutes, 200 JPY). Cross Shibuya Scramble, explore Center Gai shopping street. Visit Shibuya Sky observation deck or Magnet by Shibuya 109 for shopping. Cost: 2,000-3,000 JPY (optional paid attractions).\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"day1_dinner_header\",\n          \"component\": \"Text\",\n          \"text\": \"Dinner (6:00 PM)\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"day1_dinner_text\",\n          \"component\": \"Text\",\n          \"text\": \"Ippudo Ramen (Shibuya) - tonkotsu or miso options, approximately 950-1,200 JPY. High-volume chain with reliable quality.\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"day1_evening_header\",\n          \"component\": \"Text\",\n          \"text\": \"Evening\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"day1_evening_text\",\n          \"component\": \"Text\",\n          \"text\": \"Return to accommodation. Daily total: approximately 7,000-10,000 JPY.\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"day2_card\",\n          \"component\": \"Card\",\n          \"child\": \"day2_content\"\n        },\n        {\n          \"id\": \"day2_content\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"day2_title\",\n            \"day2_morning_header\",\n            \"day2_morning_text\",\n            \"day2_lunch_header\",\n            \"day2_lunch_text\",\n            \"day2_afternoon_header\",\n            \"day2_afternoon_text\",\n            \"day2_dinner_header\",\n            \"day2_dinner_text\",\n            \"day2_evening_header\",\n            \"day2_evening_text\"\n          ]\n        },\n        {\n          \"id\": \"day2_title\",\n          \"component\": \"Text\",\n          \"text\": \"DAY 2: ASAKUSA & TRADITIONAL TEMPLES (May 11)\",\n          \"variant\": \"h3\"\n        },\n        {\n          \"id\": \"day2_morning_header\",\n          \"component\": \"Text\",\n          \"text\": \"Morning (8:00 AM - 12:00 PM)\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"day2_morning_text\",\n          \"component\": \"Text\",\n          \"text\": \"Take train to Asakusa Station. Visit Senso-ji Temple (free entry) and walk through Nakamise shopping street for souvenirs. Explore nearby Asakusa-jinja Shrine (free). Wander traditional backstreets. Cost: minimal (free attractions, optional small purchases).\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"day2_lunch_header\",\n          \"component\": \"Text\",\n          \"text\": \"Lunch (12:30 PM)\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"day2_lunch_text\",\n          \"co