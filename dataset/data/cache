\"\n        },\n        {\n          \"id\": \"notes_header\",\n          \"component\": \"Text\",\n          \"variant\": \"h2\",\n          \"text\": \"Recipe Notes for Perfect Texture\"\n        },\n        {\n          \"id\": \"notes_text\",\n          \"component\": \"Text\",\n          \"variant\": \"body\",\n          \"text\": \"For the best results, ensure your butter is softened to room temperature, not melted. Melted butter will cause the cookies to spread too much. Similarly, a room temperature egg incorporates more easily into the batter, creating a more uniform texture. This recipe makes approximately 2 dozen cookies.\"\n        },\n        {\n          \"id\": \"divider_2\",\n          \"component\": \"Divider\"\n        },\n        {\n          \"id\": \"recipe_header\",\n          \"component\": \"Text\",\n          \"variant\": \"h2\",\n          \"text\": \"The Ultimate Soft & Chewy Recipe\"\n        },\n        {\n          \"id\": \"recipe_layout\",\n          \"component\": \"Row\",\n          \"align\": \"start\",\n          \"children\": [\n            \"ingredients_card\",\n            \"instructions_card\"\n          ]\n        },\n        {\n          \"id\": \"ingredients_card\",\n          \"component\": \"Card\",\n          \"weight\": 1,\n          \"child\": \"ingredients_column\"\n        },\n        {\n          \"id\": \"ingredients_column\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"ingredients_header\",\n            \"ingredients_list\"\n          ]\n        },\n        {\n          \"id\": \"ingredients_header\",\n          \"component\": \"Text\",\n          \"variant\": \"h3\",\n          \"text\": \"Ingredients\"\n        },\n        {\n          \"id\": \"ingredients_list\",\n          \"component\": \"List\",\n          \"direction\": \"vertical\",\n          \"children\": [\n            \"ingredient_1\",\n            \"ingredient_2\",\n            \"ingredient_3\",\n            \"ingredient_4\",\n            \"ingredient_5\",\n            \"ingredient_6\",\n            \"ingredient_7\",\n            \"ingredient_8\",\n            \"ingredient_9\"\n          ]\n        },\n        {\n          \"id\": \"ingredient_1\",\n          \"component\": \"Text\",\n          \"text\": \"2 1/4 cups all-purpose flour\"\n        },\n        {\n          \"id\": \"ingredient_2\",\n          \"component\": \"Text\",\n          \"text\": \"1 teaspoon baking soda\"\n        },\n        {\n          \"id\": \"ingredient_3\",\n          \"component\": \"Text\",\n          \"text\": \"1/2 teaspoon salt\"\n        },\n        {\n          \"id\": \"ingredient_4\",\n          \"component\": \"Text\",\n          \"text\": \"1 cup (2 sticks) unsalted butter, softened\"\n        },\n        {\n          \"id\": \"ingredient_5\",\n          \"component\": \"Text\",\n          \"text\": \"3/4 cup packed light brown sugar\"\n        },\n        {\n          \"id\": \"ingredient_6\",\n          \"component\": \"Text\",\n          \"text\": \"1/2 cup granulated white sugar\"\n        },\n        {\n          \"id\": \"ingredient_7\",\n          \"component\": \"Text\",\n          \"text\": \"1 large egg, room temperature\"\n        },\n        {\n          \"id\": \"ingredient_8\",\n          \"component\": \"Text\",\n          \"text\": \"2 teaspoons vanilla extract\"\n        },\n        {\n          \"id\": \"ingredient_9\",\n          \"component\": \"Text\",\n          \"text\": \"2 cups semi-sweet chocolate chips\"\n        },\n        {\n          \"id\": \"instructions_card\",\n          \"component\": \"Card\",\n          \"weight\": 2,\n          \"child\": \"instructions_column\"\n        },\n        {\n          \"id\": \"instructions_column\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"instructions_header\",\n            \"instructions_list\"\n          ]\n        },\n        {\n          \"id\": \"instructions_header\",\n          \"component\": \"Text\",\n          \"variant\": \"h3\",\n          \"text\": \"Step-by-Step Instructions\"\n        },\n        {\n          \"id\": \"instructions_list\",\n          \"component\": \"List\",\n          \"direction\": \"vertical\",\n          \"children\": [\n            \"step_1_row\",\n            \"step_2_row\",\n            \"step_3_row\",\n            \"step_4_row\",\n            \"step_5_row\",\n            \"step_6_row\",\n            \"step_7_row\",\n            \"step_8_row\",\n            \"step_9_row\"\n          ]\n        },\n        {\n          \"id\": \"step_1_row\",\n          \"component\": \"Row\",\n          \"align\": \"start\",\n          \"children\": [\n            \"step_1_num\",\n            \"step_1_text\"\n          ]\n        },\n        {\n          \"id\": \"step_1_num\",\n          \"component\": \"Text\",\n          \"text\": \"1.\"\n        },\n        {\n          \"id\": \"step_1_text\",\n          \"component\": \"Text\",\n          \"weight\": 1,\n          \"text\": \"Prepare Oven and Pans: Preheat your oven to 375°F (190°C). Line two large baking sheets with parchment paper.\"\n        },\n        {\n          \"id\": \"step_2_row\",\n          \"component\": \"Row\",\n          \"align\": \"start\",\n          \"children\": [\n            \"step_2_num\",\n            \"step_2_text\"\n          ]\n        },\n        {\n          \"id\": \"step_2_num\",\n          \"component\": \"Text\",\n          \"text\": \"2.\"\n        },\n        {\n          \"id\": \"step_2_text\",\n          \"component\": \"Text\",\n          \"weight\": 1,\n          \"text\": \"Combine Dry Ingredients: In a medium bowl, whisk together the all-purpose flour, baking soda, and salt. Set this mixture aside.\"\n        },\n        {\n          \"id\": \"step_3_row\",\n          \"component\": \"Row\",\n          \"align\": \"start\",\n          \"children\": [\n            \"step_3_num\",\n            \"step_3_text\"\n          ]