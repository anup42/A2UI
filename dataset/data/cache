{"prompt_hash": "4c3aa676de0521d532b140305c3d480afe7234e2dfd36b8ee847068f3a80b887", "text": "[\n  {\n    \"version\": \"v0.9\",\n    \"createSurface\": {\n      \"surfaceId\": \"risotto_recipe_surface\",\n      \"catalogId\": \"https://genui.local/specification/v0_9/standard_catalog.json\"\n    }\n  },\n  {\n    \"version\": \"v0.9\",\n    \"updateComponents\": {\n      \"surfaceId\": \"risotto_recipe_surface\",\n      \"components\": [\n        {\n          \"id\": \"root\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"title\",\n            \"main_image\",\n            \"overview_card\",\n            \"context_card\",\n            \"instructions_title\",\n            \"ingredients_card\",\n            \"steps_title\",\n            \"steps_col\",\n            \"phases_title\",\n            \"phases_table\",\n            \"gallery_row\",\n            \"sources_title\",\n            \"sources_col\"\n          ]\n        },\n        {\n          \"id\": \"title\",\n          \"component\": \"Text\",\n          \"variant\": \"h2\",\n          \"text\": \"Creamy Vegan Mushroom Risotto Overview\"\n        },\n        {\n          \"id\": \"main_image\",\n          \"component\": \"Image\",\n          \"url\": \"../assets/r_000701_01_1_mushroom-risotto.jpg\",\n          \"variant\": \"largeFeature\"\n        },\n        {\n          \"id\": \"overview_card\",\n          \"component\": \"Card\",\n          \"child\": \"overview_col\"\n        },\n        {\n          \"id\": \"overview_col\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"overview_text_1\",\n            \"overview_text_2\"\n          ]\n        },\n        {\n          \"id\": \"overview_text_1\",\n          \"component\": \"Text\",\n          \"text\": \"This recipe creates a rich, velvety risotto for 4 people without using dairy. The key to the creamy texture lies in the high starch content of Arborio rice and the agitation process (stirring), which releases that starch into the broth.\"\n        },\n        {\n          \"id\": \"overview_text_2\",\n          \"component\": \"Text\",\n          \"text\": \"We will use a mix of mushrooms for depth of flavor and finish with a \\\"mantecatura\\\" technique using vegan fat to emulsify the sauce.\"\n        },\n        {\n          \"id\": \"context_card\",\n          \"component\": \"Card\",\n          \"child\": \"context_col\"\n        },\n        {\n          \"id\": \"context_col\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"context_title\",\n            \"context_text\"\n          ]\n        },\n        {\n          \"id\": \"context_title\",\n          \"component\": \"Text\",\n          \"variant\": \"h3\",\n          \"text\": \"Kitchen & Ingredient Context\"\n        },\n        {\n          \"id\": \"context_text\",\n          \"component\": \"Text\",\n          \"text\": \"This recipe assumes you have a heavy-bottomed pot or Dutch oven to distribute heat evenly. We assume the use of dry white wine (like Pinot Grigio or Sauvignon Blanc) to deglaze the pan, but you can substitute extra vegetable broth mixed with a teaspoon of lemon juice or white wine vinegar if you prefer an alcohol-free version. We also assume the use of store-bought low-sodium vegetable broth, but homemade stock works excellently.\"\n        },\n        {\n          \"id\": \"instructions_title\",\n          \"component\": \"Text\",\n          \"variant\": \"h3\",\n          \"text\": \"Step-by-Step Cooking Instructions\"\n        },\n        {\n          \"id\": \"ingredients_card\",\n          \"component\": \"Card\",\n          \"child\": \"ingredients_col\"\n        },\n        {\n          \"id\": \"ingredients_col\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"ingredients_title\",\n            \"ingredients_list\"\n          ]\n        },\n        {\n          \"id\": \"ingredients_title\",\n          \"component\": \"Text\",\n          \"variant\": \"h4\",\n          \"text\": \"Ingredients:\"\n        },\n        {\n          \"id\": \"ingredients_list\",\n          \"component\": \"List\",\n          \"direction\": \"vertical\",\n          \"children\": [\n            \"ing_1\",\n            \"ing_2\",\n            \"ing_3\",\n            \"ing_4\",\n            \"ing_5\",\n            \"ing_6\",\n            \"ing_7\",\n            \"ing_8\",\n            \"ing_9\",\n            \"ing_10\",\n            \"ing_11\",\n            \"ing_12\"\n          ]\n        },\n        {\n          \"id\": \"ing_1\",\n          \"component\": \"Text\",\n          \"text\": \"1.5 cups Arborio rice (do not rinse, as starch is needed)\"\n        },\n        {\n          \"id\": \"ing_2\",\n          \"component\": \"Text\",\n          \"text\": \"5 to 6 cups vegetable broth (kept warm in a separate pot)\"\n        },\n        {\n          \"id\": \"ing_3\",\n          \"component\": \"Text\",\n          \"text\": \"1 lb mixed mushrooms (cremini, shiitake, oyster), sliced\"\n        },\n        {\n          \"id\": \"ing_4\",\n          \"component\": \"Text\",\n          \"text\": \"2 shallots, finely minced\"\n        },\n        {\n          \"id\": \"ing_5\",\n          \"component\": \"Text\",\n          \"text\": \"3 cloves garlic, minced\"\n        },\n        {\n          \"id\": \"ing_6\",\n          \"component\": \"Text\",\n          \"text\": \"0.5 cup dry white wine\"\n        },\n        {\n          \"id\": \"ing_7\",\n          \"component\": \"Text\",\n          \"text\": \"3 tbsp olive oil (divided)\"\n        },\n        {\n          \"id\": \"ing_8\",\n          \"component\": \"Text\",\n          \"text\": \"2 tbsp vegan butter (or extra olive oil)\"\n        },\n        {\n          \"id\": \"ing_9\",\n          \"component\": \"Text\",\n          \"text\": \"0.25 cup nutritional yeast (optional, for cheesy flavor)\"\n        },\n        {\n          \"id\": \"ing_10\",\n          \"component\": \"Text\",\n          \"text\": \"1 tbsp fresh thyme leaves\"\n        },\n        {\n          \"id\": \"ing_11\",\n          \"component\": \"Text\",\n          \"text\": \"Salt and black pepper to taste\"\n        },\n        {\n          \"id\": \"ing_12\",\n          \"component\": \"Text\",\n          \"text\": \"Fresh parsley for garnish\"\n        },\n        {\n          \"id\": \"steps_title\",\n          \"component\": \"Text\",\n          \"variant\": \"h4\",\n          \"text\": \"Instructions:\"\n        },\n        {\n          \"id\": \"steps_col\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"step_1_card\",\n            \"step_2_card\",\n            \"step_3_card\",\n            \"step_4_card\",\n            \"step_5_card\",\n            \"step_6_card\"\n          ]\n        },\n        {\n          \"id\": \"step_1_card\",\n          \"component\": \"Card\",\n          \"child\": \"step_1_col\"\n        },\n        {\n          \"id\": \"step_1_col\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"step_1_title\",\n            \"step_1_text\"\n          ]\n        },\n        {\n          \"id\": \"step_1_title\",\n          \"component\": \"Text\",\n          \"text\": \"1. Warm the Broth:\"\n        },\n        {\n          \"id\": \"step_1_text\",\n          \"component\": \"Text\",\n          \"text\": \"Pour the vegetable broth into a saucepan and keep it on a low simmer next to your main cooking pot. Cold broth shocks the rice and stops the cooking process, preventing the creamy texture from developing.\"\n        },\n        {\n          \"id\": \"step_2_card\",\n          \"component\": \"Card\",\n          \"child\": \"step_2_col\"\n        },\n        {\n          \"id\": \"step_2_col\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"step_2_title\",\n            \"step_2_text\"\n          ]\n        },\n        {\n          \"id\": \"step_2_title\",\n          \"component\": \"Text\",\n          \"text\": \"2. Sauté the Mushrooms:\"\n        },\n        {\n          \"id\": \"step_2_text\",\n          \"component\": \"Text\",\n          \"text\": \"In your heavy-bottomed pot, heat 1 tablespoon of olive oil over medium-high heat. Add the sliced mushrooms and cook until browned and their liquid has evaporated (about 5-8 minutes). Season with a pinch of salt. Remove mushrooms from the pot and set aside. This prevents them from getting rubbery during the rice cooking.\"\n        },\n        {\n          \"id\": \"step_3_card\",\n          \"component\": \"Card\",\n          \"child\": \"step_3_col\"\n        },\n        {\n          \"id\": \"step_3_col\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"step_3_title\",\n            \"step_3_text\"\n          ]\n        },\n        {\n          \"id\": \"step_3_title\",\n          \"component\": \"Text\",\n          \"text\": \"3. Aromatics and Toasting:\"\n        },\n        {\n          \"id\": \"step_3_text\",\n          \"component\": \"Text\",\n          \"text\": \"Reduce heat to medium. Add the remaining 2 tablespoons of olive oil to the pot. Add shallots and cook until softened (2-3 minutes). Add garlic and thyme, cooking for another minute until fragrant. Add the Arborio rice. Toast the rice, stirring constantly, for 1-2 minutes until the edges are translucent and the center remains opaque. This toasting step creates a shell around the grain so it doesn't turn to mush while slowly releasing starch.\"\n        },\n        {\n          \"id\": \"step_4_card\",\n          \"component\": \"Card\",\n          \"child\": \"step_4_col\"\n        },\n        {\n          \"id\": \"step_4_col\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"step_4_title\",\n            \"step_4_text\"\n          ]\n        },\n        {\n          \"id\": \"step_4_title\",\n          \"component\": \"Text\",\n          \"text\": \"4. Deglaze:\"\n        },\n        {\n          \"id\": \"step_4_text\",\n          \"component\": \"Text\",\n          \"text\": \"Pour in the white wine. Stir constantly until the wine is fully absorbed by the rice.\"\n        },\n        {\n          \"id\": \"step_5_card\",\n          \"component\": \"Card\",\n          \"child\": \"step_5_col\"\n        },\n        {\n          \"id\": \"step_5_col\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"step_5_title\",\n            \"step_5_text\"\n          ]\n        },\n        {\n          \"id\": \"step_5_title\",\n          \"component\": \"Text\",\n          \"text\": \"5. The Risotto Method:\"\n        },\n        {\n          \"id\": \"step_5_text\",\n          \"component\": \"Text\",\n          \"text\": \"Begin adding the warm broth, one ladle (about 0.5 cup) at a time. Stir frequently. Wait until the liquid is almost completely absorbed before adding the next ladle. The friction from stirring rubs the grains together, releasing the starch that creates the creamy sauce. Repeat this process for about 20-25 minutes. The rice is done when it is tender but still has a slight bite (al dente).\"\n        },\n        {\n          \"id\": \"step_6_card\",\n          \"component\": \"Card\",\n          \"child\": \"step_6_col\"\n        },\n        {\n          \"id\": \"step_6_col\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"step_6_title\",\n            \"step_6_text\"\n          ]\n        },\n        {\n          \"id\": \"step_6_title\",\n          \"component\": \"Text\",\n          \"text\": \"6. The Finish (Mantecatura):\"\n        },\n        {\n          \"id\": \"step_6_text\",\n          \"component\": \"Text\",\n          \"text\": \"Remove the pot from the heat. This is crucial. Stir in the cooked mushrooms, vegan butter, and nutritional yeast. Vigorously stir the mixture for 30 seconds to emulsify the fats with the starch. This step guarantees the creamy mouthfeel without dairy. Season with salt and pepper to taste. Garnish with fresh parsley and serve immediately.\"\n        },\n        {\n          \"id\": \"phases_title\",\n          \"component\": \"Text\",\n          \"variant\": \"h3\",\n          \"text\": \"Risotto Cooking Phases\"\n        },\n        {\n          \"id\": \"phases_table\",\n          \"component\": \"List\",\n          \"direction\": \"vertical\",\n          \"children\": [\n            \"phases_header_row\",\n            \"phases_row_1\",\n            \"phases_row_2\",\n            \"phases_row_3\",\n            \"phases_row_4\"\n          ]\n        },\n        {\n          \"id\": \"phases_header_row\",\n          \"component\": \"Row\",\n          \"children\": [\n            \"phase_h\",\n            \"duration_h\",\n            \"action_h\"\n          ]\n        },\n        {\n          \"id\": \"phase_h\",\n          \"component\": \"Text\",\n          \"text\": \"Phase\",\n          \"weight\": 1\n        },\n        {\n          \"id\": \"duration_h\",\n          \"component\": \"Text\",\n          \"text\": \"Duration\",\n          \"weight\": 1\n        },\n        {\n          \"id\": \"action_h\",\n          \"component\": \"Text\",\n          \"text\": \"Key Action\",\n          \"weight\": 2\n        },\n        {\n          \"id\": \"phases_row_1\",\n          \"component\": \"Row\",\n          \"children\": [\n            \"phase_1\",\n            \"duration_1\",\n            \"action_1\"\n          ]\n        },\n        {\n          \"id\": \"phase_1\",\n          \"component\": \"Text\",\n          \"text\": \"Prep\",\n          \"weight\": 1\n        },\n        {\n          \"id\": \"duration_1\",\n          \"component\": \"Text\",\n          \"text\": \"10-15 mins\",\n          \"weight\": 1\n        },\n        {\n          \"id\": \"action_1\",\n          \"component\": \"Text\",\n          \"text\": \"Chop vegetables, slice mushrooms, warm broth\",\n          \"weight\": 2\n        },\n        {\n          \"id\": \"phases_row_2\",\n          \"component\": \"Row\",\n          \"children\": [\n            \"phase_2\",\n            \"duration_2\",\n            \"action_2\"\n          ]\n        },\n        {\n          \"id\": \"phase_2\",\n          \"component\": \"Text\",\n          \"text\": \"Sauté\",\n          \"weight\": 1\n        },\n        {\n          \"id\": \"duration_2\",\n          \"component\": \"Text\",\n          \"text\": \"8-10 mins\",\n          \"weight\": 1\n        },\n        {\n          \"id\": \"action_2\",\n          \"component\": \"Text\",\n          \"text\": \"Brown mushrooms, sweat shallots, toast rice\",\n          \"weight\": 2\n        },\n        {\n          \"id\": \"phases_row_3\",\n          \"component\": \"Row\",\n          \"children\": [\n            \"phase_3\",\n            \"duration_3\",\n            \"action_3\"\n          ]\n        },\n        {\n          \"id\": \"phase_3\",\n          \"component\": \"Text\",\n          \"text\": \"Simmer\",\n          \"weight\": 1\n        },\n        {\n          \"id\": \"duration_3\",\n          \"component\": \"Text\",\n          \"text\": \"20-25 mins\",\n          \"weight\": 1\n        },\n        {\n          \"id\": \"action_3\",\n          \"component\": \"Text\",\n          \"text\": \"Add broth gradually, stir frequently to release starch\",\n          \"weight\": 2\n        },\n        {\n          \"id\": \"phases_row_4\",\n          \"component\": \"Row\",\n          \"children\": [\n            \"phase_4\",\n            \"duration_4\",\n            \"action_4\"\n          ]\n        },\n        {\n          \"id\": \"phase_4\",\n          \"component\": \"Text\",\n          \"text\": \"Rest\",\n          \"weight\": 1\n        },\n        {\n          \"id\": \"duration_4\",\n          \"component\": \"Text\",\n          \"text\": \"2-3 mins\",\n          \"weight\": 1\n        },\n        {\n          \"id\": \"action_4\",\n          \"component\": \"Text\",\n          \"text\": \"Remove from heat, beat in fat (mantecatura) for creaminess\",\n          \"weight\": 2\n        },\n        {\n          \"id\": \"gallery_row\",\n          \"component\": \"Row\",\n          \"justify\": \"spaceAround\",\n          \"children\": [\n            \"gallery_card_1\",\n            \"gallery_card_2\",\n            \"gallery_card_3\"\n          ]\n        },\n        {\n          \"id\": \"gallery_card_1\",\n          \"component\": \"Card\",\n          \"child\": \"gallery_col_1\"\n        },\n        {\n          \"id\": \"gallery_col_1\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"gallery_img_1\",\n            \"gallery_caption_1\"\n          ]\n        },\n        {\n          \"id\": \"gallery_img_1\",\n          \"component\": \"Image\",\n          \"url\": \"../assets/r_000701_01_1_mushroom-risotto.jpg\",\n          \"variant\": \"smallFeature\"\n        },\n        {\n          \"id\": \"gallery_caption_1\",\n          \"component\": \"Text\",\n          \"text\": \"Vegan Mushroom Risotto Plating\"\n        },\n        {\n          \"id\": \"gallery_card_2\",\n          \"component\": \"Card\",\n          \"child\": \"gallery_col_2\"\n        },\n        {\n          \"id\": \"gallery_col_2\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"gallery_img_2\",\n            \"gallery_caption_2\"\n          ]\n        },\n        {\n          \"id\": \"gallery_img_2\",\n          \"component\": \"Image\",\n          \"url\": \"../assets/r_000701_01_2_arborio-rice.jpg\",\n          \"variant\": \"smallFeature\"\n        },\n        {\n          \"id\": \"gallery_caption_2\",\n          \"component\": \"Text\",\n          \"text\": \"Arborio Rice Texture\"\n        },\n        {\n          \"id\": \"gallery_card_3\",\n       