{"prompt_hash": "bd056e25c3594306f8de75231de10e34e159d4305c0b81f00628ab366626750c", "text": "[\n  {\n    \"createSurface\": {\n      \"surfaceId\": \"bolognese-recipe\",\n      \"catalogId\": \"https://genui.local/specification/v0_9/standard_catalog.json\",\n      \"theme\": {\n        \"primaryColor\": \"#C41E3A\"\n      }\n    },\n    \"version\": \"v0.9\"\n  },\n  {\n    \"updateComponents\": {\n      \"surfaceId\": \"bolognese-recipe\",\n      \"components\": [\n        {\n          \"id\": \"root\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"img-header\",\n            \"content-container\"\n          ]\n        },\n        {\n          \"id\": \"img-header\",\n          \"component\": \"Image\",\n          \"url\": \"/assets/r_000321_01_1_bolognese-sauce.jpg\",\n          \"fit\": \"cover\",\n          \"variant\": \"header\"\n        },\n        {\n          \"id\": \"content-container\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"header-section\",\n            \"divider-1\",\n            \"ingredients-section\",\n            \"divider-2\",\n            \"steps-section\",\n            \"tips-card\",\n            \"actions-row\",\n            \"sources-section\"\n          ]\n        },\n        {\n          \"id\": \"header-section\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"title\",\n            \"meta-row\",\n            \"description\"\n          ]\n        },\n        {\n          \"id\": \"title\",\n          \"component\": \"Text\",\n          \"text\": \"Traditional Ragù alla Bolognese for 4\",\n          \"variant\": \"h1\"\n        },\n        {\n          \"id\": \"meta-row\",\n          \"component\": \"Row\",\n          \"align\": \"center\",\n          \"children\": [\n            \"icon-clock\",\n            \"text-time\",\n            \"icon-fire\",\n            \"text-method\"\n          ]\n        },\n        {\n          \"id\": \"icon-clock\",\n          \"component\": \"Icon\",\n          \"name\": {\n            \"path\": \"/assets/r_000242_01_6_clock.svg\"\n          }\n        },\n        {\n          \"id\": \"text-time\",\n          \"component\": \"Text\",\n          \"text\": \" 3.5 hours  \",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"icon-fire\",\n          \"component\": \"Icon\",\n          \"name\": {\n            \"path\": \"/assets/r_000321_01_5_fire.svg\"\n          }\n        },\n        {\n          \"id\": \"text-method\",\n          \"component\": \"Text\",\n          \"text\": \" Slow Simmer\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"description\",\n          \"component\": \"Text\",\n          \"text\": \"This recipe draws from authentic sources like the Accademia Italiana della Cucina and Italian home cooks, scaled to serve 4 with a classic soffritto base, dual meats, milk for tenderness, and a 3-hour slow simmer for deep flavor. It yields about 1.2 kg sauce, enough for 400g dried tagliatelle.\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"divider-1\",\n          \"component\": \"Divider\"\n        },\n        {\n          \"id\": \"ingredients-section\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"h-ingredients\",\n            \"list-ingredients\"\n          ]\n        },\n        {\n          \"id\": \"h-ingredients\",\n          \"component\": \"Text\",\n          \"text\": \"Ingredients\",\n          \"variant\": \"h2\"\n        },\n        {\n          \"id\": \"list-ingredients\",\n          \"component\": \"List\",\n          \"direction\": \"vertical\",\n          \"children\": [\n            \"ing-1\",\n            \"ing-2\",\n            \"ing-3\",\n            \"ing-4\",\n            \"ing-5\",\n            \"ing-6\",\n            \"ing-7\",\n            \"ing-8\",\n            \"ing-9\",\n            \"ing-10\",\n            \"ing-11\",\n            \"ing-12\",\n            \"ing-13\",\n            \"ing-14\"\n          ]\n        },\n        {\n          \"id\": \"ing-1\",\n          \"component\": \"Text\",\n          \"text\": \"• 300g coarsely ground beef (70-80% lean)\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"ing-2\",\n          \"component\": \"Text\",\n          \"text\": \"• 300g ground pork\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"ing-3\",\n          \"component\": \"Text\",\n          \"text\": \"• 50g pancetta, finely diced\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"ing-4\",\n          \"component\": \"Text\",\n          \"text\": \"• 1 medium onion (150g), finely diced\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"ing-5\",\n          \"component\": \"Text\",\n          \"text\": \"• 1 medium carrot (100g), finely diced\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"ing-6\",\n          \"component\": \"Text\",\n          \"text\": \"• 1 celery stalk (80g), finely diced\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"ing-7\",\n          \"component\": \"Text\",\n          \"text\": \"• 2 tbsp (30ml) olive oil\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"ing-8\",\n          \"component\": \"Text\",\n          \"text\": \"• 50ml dry white wine (or red)\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"ing-9\",\n          \"component\": \"Text\",\n          \"text\": \"• 2 tbsp (50g) tomato paste\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"ing-10\",\n          \"component\": \"Text\",\n          \"text\": \"• 400ml tomato passata (or puree)\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"ing-11\",\n          \"component\": \"Text\",\n          \"text\": \"• 100ml whole milk\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"ing-12\",\n          \"component\": \"Text\",\n          \"text\": \"• 1 bay leaf\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"ing-13\",\n          \"component\": \"Text\",\n          \"text\": \"• Salt and black pepper to taste\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"ing-14\",\n          \"component\": \"Text\",\n          \"text\": \"• Pinch of nutmeg (optional)\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"divider-2\",\n          \"component\": \"Divider\"\n        },\n        {\n          \"id\": \"steps-section\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"h-steps\",\n            \"step-1\",\n            \"step-2\",\n            \"img-soffritto\",\n            \"step-3\",\n            \"step-4\",\n            \"step-5\",\n            \"step-6\",\n            \"img-simmer\",\n            \"step-7\",\n            \"step-8\"\n          ]\n        },\n        {\n          \"id\": \"h-steps\",\n          \"component\": \"Text\",\n          \"text\": \"3-Hour Slow Simmer Steps\",\n          \"variant\": \"h2\"\n        },\n        {\n          \"id\": \"step-1\",\n          \"component\": \"Text\",\n          \"text\": \"1. In a large heavy pot over low heat, add olive oil and pancetta. Render fat for 5 minutes until crisp, no browning.\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"step-2\",\n          \"component\": \"Text\",\n          \"text\": \"2. Add diced onion, carrot, and celery (soffritto). Cook covered on low for 10-15 minutes until soft and translucent, stirring occasionally.\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"img-soffritto\",\n          \"component\": \"Image\",\n          \"url\": \"/assets/r_000321_01_2_italian-s