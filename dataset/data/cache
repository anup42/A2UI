{"prompt_hash": "44c1643297c875206955811e42215997683c204782d62bc048fb5a444f837b82", "text": "[\n  {\n    \"version\": \"v0.9\",\n    \"createSurface\": {\n      \"surfaceId\": \"recipe_risotto\",\n      \"catalogId\": \"https://genui.local/specification/v0_9/standard_catalog.json\"\n    }\n  },\n  {\n    \"version\": \"v0.9\",\n    \"updateComponents\": {\n      \"surfaceId\": \"recipe_risotto\",\n      \"components\": [\n        {\n          \"id\": \"root\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"text_title\",\n            \"text_overview_body_1\",\n            \"text_overview_body_2\",\n            \"divider_1\",\n            \"text_context_heading\",\n            \"text_context_body_1\",\n            \"text_context_body_2\",\n            \"divider_2\",\n            \"text_instructions_heading\",\n            \"text_ingredients_heading\",\n            \"list_ingredients\",\n            \"text_cooking_steps_heading\",\n            \"column_step_1\",\n            \"column_step_2\",\n            \"column_step_3\",\n            \"column_step_4\",\n            \"column_step_5\",\n            \"column_step_6\",\n            \"divider_3\",\n            \"text_phases_heading\",\n            \"list_phases_table\",\n            \"divider_4\",\n            \"text_images_heading\",\n            \"list_images\",\n            \"divider_5\",\n            \"text_icons_section_heading\",\n            \"list_icons\",\n            \"divider_6\",\n            \"text_sources_heading\",\n            \"list_sources\"\n          ]\n        },\n        {\n          \"id\": \"text_title\",\n          \"component\": \"Text\",\n          \"text\": \"Creamy Vegan Mushroom Risotto Overview\",\n          \"variant\": \"h2\"\n        },\n        {\n          \"id\": \"text_overview_body_1\",\n          \"component\": \"Text\",\n          \"text\": \"This recipe creates a rich, velvety risotto for 4 people without using dairy. The key to the creamy texture lies in the high starch content of Arborio rice and the agitation process (stirring), which releases that starch into the broth.\"\n        },\n        {\n          \"id\": \"text_overview_body_2\",\n          \"component\": \"Text\",\n          \"text\": \"We will use a mix of mushrooms for depth of flavor and finish with a \\\"mantecatura\\\" technique using vegan fat to emulsify the sauce.\"\n        },\n        {\n          \"id\": \"divider_1\",\n          \"component\": \"Divider\"\n        },\n        {\n          \"id\": \"text_context_heading\",\n          \"component\": \"Text\",\n          \"text\": \"Kitchen & Ingredient Context\",\n          \"variant\": \"h3\"\n        },\n        {\n          \"id\": \"text_context_body_1\",\n          \"component\": \"Text\",\n          \"text\": \"This recipe assumes you have a heavy-bottomed pot or Dutch oven to distribute heat evenly. We assume the use of dry white wine (like Pinot Grigio or Sauvignon Blanc) to deglaze the pan, but you can substitute extra vegetable broth mixed with a teaspoon of lemon juice or white wine vinegar if you prefer an alcohol-free version.\"\n        },\n        {\n          \"id\": \"text_context_body_2\",\n          \"component\": \"Text\",\n          \"text\": \"We also assume the use of store-bought low-sodium vegetable broth, but homemade stock works excellently.\"\n        },\n        {\n          \"id\": \"divider_2\",\n          \"component\": \"Divider\"\n        },\n        {\n          \"id\": \"text_instructions_heading\",\n          \"component\": \"Text\",\n          \"text\": \"Step-by-Step Cooking Instructions\",\n          \"variant\": \"h2\"\n        },\n        {\n          \"id\": \"text_ingredients_heading\",\n          \"component\": \"Text\",\n          \"text\": \"Ingredients:\",\n          \"variant\": \"h3\"\n        },\n        {\n          \"id\": \"list_ingredients\",\n          \"component\": \"List\",\n          \"direction\": \"vertical\",\n          \"children\": [\n            \"row_ingredient_1\",\n            \"row_ingredient_2\",\n            \"row_ingredient_3\",\n            \"row_ingredient_4\",\n            \"row_ingredient_5\",\n            \"row_ingredient_6\",\n            \"row_ingredient_7\",\n            \"row_ingredient_8\",\n            \"row_ingredient_9\",\n            \"row_ingredient_10\",\n            \"row_ingredient_11\"\n          ]\n        },\n        {\n          \"id\": \"row_ingredient_1\",\n          \"component\": \"Row\",\n          \"children\": [\n            \"text_ingredient_1_quantity\",\n            \"text_ingredient_1_item\"\n          ]\n        },\n        {\n          \"id\": \"text_ingredient_1_quantity\",\n          \"component\": \"Text\",\n          \"text\": \"1.5 cups\",\n          \"weight\": 0.3\n        },\n        {\n          \"id\": \"text_ingredient_1_item\",\n          \"component\": \"Text\",\n          \"text\": \"Arborio rice (do not rinse, as starch is needed)\",\n          \"weight\": 0.7\n        },\n        {\n          \"id\": \"row_ingredient_2\",\n          \"component\": \"Row\",\n          \"children\": [\n            \"text_ingredient_2_quantity\",\n            \"text_ingredient_2_item\"\n          ]\n        },\n        {\n          \"id\": \"text_ingredient_2_quantity\",\n          \"component\": \"Text\",\n          \"text\": \"5 to 6 cups\",\n          \"weight\": 0.3\n        },\n        {\n          \"id\": \"text_ingredient_2_item\",\n          \"component\": \"Text\",\n          \"text\": \"vegetable broth (kept warm in a separate pot)\",\n          \"weight\": 0.7\n        },\n        {\n          \"id\": \"row_ingredient_3\",\n          \"component\": \"Row\",\n          \"children\": [\n            \"text_ingredient_3_quantity\",\n            \"text_ingredient_3_item\"\n          ]\n        },\n        {\n          \"id\": \"text_ingredient_3_quantity\",\n          \"component\": \"Text\",\n          \"text\": \"1 lb\",\n          \"weight\": 0.3\n        },\n        {\n          \"id\": \"text_ingredient_3_item\",\n          \"component\": \"Text\",\n          \"text\": \"mixed mushrooms (cremini, shiitake, oyster), sliced\",\n          \"weight\": 0.7\n        },\n        {\n          \"id\": \"row_ingredient_4\",\n          \"component\": \"Row\",\n          \"children\": [\n            \"text_ingredient_4_quantity\",\n            \"text_ingredient_4_item\"\n          ]\n        },\n        {\n          \"id\": \"text_ingredient_4_quantity\",\n          \"component\": \"Text\",\n          \"text\": \"2\",\n          \"weight\": 0.3\n        },\n        {\n          \"id\": \"text_ingredient_4_item\",\n          \"component\": \"Text\",\n          \"text\": \"shallots, finely minced\",\n          \"weight\": 0.7\n        },\n        {\n          \"id\": \"row_ingredient_5\",\n          \"component\": \"Row\",\n          \"children\": [\n            \"text_ingredient_5_quantity\",\n            \"text_ingredient_5_item\"\n          ]\n        },\n        {\n          \"id\": \"text_ingredient_5_quantity\",\n          \"component\": \"Text\",\n          \"text\": \"3 cloves\",\n          \"weight\": 0.3\n        },\n        {\n          \"id\": \"text_ingredient_5_item\",\n          \"component\": \"Text\",\n          \"text\": \"garlic, minced\",\n          \"weight\": 0.7\n        },\n        {\n          \"id\": \"row_ingredient_6\",\n          \"component\": \"Row\",\n          \"children\": [\n            \"text_ingredient_6_quantity\",\n            \"text_ingredient_6_item\"\n          ]\n        },\n        {\n          \"id\": \"text_ingredient_6_quantity\",\n          \"component\": \"Text\",\n          \"text\": \"0.5 cup\",\n          \"weight\": 0.3\n        },\n        {\n          \"id\": \"text_ingredient_6_item\",\n          \"component\": \"Text\",\n          \"text\": \"dry white wine\",\n          \"weight\": 0.7\n        },\n        {\n          \"id\": \"row_ingredient_7\",\n          \"component\": \"Row\",\n          \"children\": [\n            \"text_ingredient_7_quantity\",\n            \"text_ingredient_7_item\"\n          ]\n        },\n        {\n          \"id\": \"text_ingredient_7_quantity\",\n          \"component\": \"Text\",\n          \"text\": \"3 tbsp\",\n          \"weight\": 0.3\n        },\n        {\n          \"id\": \"text_ingredient_7_item\",\n          \"component\": \"Text\",\n          \"text\": \"olive oil (divided)\",\n          \"weight\": 0.7\n        },\n        {\n          \"id\": \"row_ingredient_8\",\n          \"component\": \"Row\",\n          \"children\": [\n            \"text_ingredient_8_quantity\",\n            \"text_ingredient_8_item\"\n          ]\n        },\n        {\n          \"id\": \"text_ingredient_8_quantity\",\n          \"component\": \"Text\",\n          \"text\": \"2 tbsp\",\n          \"weight\": 0.3\n        },\n        {\n          \"id\": \"text_ingredient_8_item\",\n          \"component\": \"Text\",\n          \"text\": \"vegan butter (or extra olive oil)\",\n          \"weight\": 0.7\n        },\n        {\n          \"id\": \"row_ingredient_9\",\n          \"component\": \"Row\",\n          \"children\": [\n            \"text_ingredient_9_quantity\",\n            \"text_ingredient_9_item\"\n          ]\n        },\n        {\n          \"id\": \"text_ingredient_9_quantity\",\n          \"component\": \"Text\",\n          \"text\": \"0.25 cup\",\n          \"weight\": 0.3\n        },\n        {\n          \"id\": \"text_ingredient_9_item\",\n          \"component\": \"Text\",\n          \"text\": \"nutritional yeast (optional, for cheesy flavor)\",\n          \"weight\": 0.7\n        },\n        {\n          \"id\": \"row_ingredient_10\",\n          \"component\": \"Row\",\n          \"children\": [\n            \"text_ingredient_10_quantity\",\n            \"text_ingredient_10_item\"\n          ]\n        },\n        {\n          \"id\": \"text_ingredient_10_quantity\",\n          \"component\": \"Text\",\n          \"text\": \"1 tbsp\",\n          \"weight\": 0.3\n        },\n        {\n          \"id\": \"text_ingredient_10_item\",\n          \"component\": \"Text\",\n          \"text\": \"fresh thyme leaves\",\n          \"weight\": 0.7\n        },\n        {\n          \"id\": \"row_ingredient_11\",\n          \"component\": \"Row\",\n          \"children\": [\n            \"text_ingredient_11_quantity\",\n            \"text_ingredient_11_item\"\n          ]\n        },\n        {\n          \"id\": \"text_ingredient_11_quantity\",\n          \"component\": \"Text\",\n          \"text\": \"\",\n          \"weight\": 0.3\n        },\n        {\n          \"id\": \"text_ingredient_11_item\",\n          \"component\": \"Text\",\n          \"text\": \"Salt and black pepper to taste\",\n          \"weight\": 0.7\n        },\n        {\n          \"id\": \"text_cooking_steps_heading\",\n          \"component\": \"Text\",\n          \"text\": \"Instructions:\",\n          \"variant\": \"h3\"\n        },\n        {\n          \"id\": \"column_step_1\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"text_step_1_title\",\n            \"text_step_1_body\"\n          ]\n        },\n        {\n          \"id\": \"text_step_1_title\",\n          \"component\": \"Text\",\n          \"text\": \"1. Warm the Broth:\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"text_step_1_body\",\n          \"component\": \"Text\",\n          \"text\": \"Pour the vegetable broth into a saucepan and keep it on a low simmer next to your main cooking pot. Cold broth shocks the rice and stops the cooking process, preventing the creamy texture from developing.\"\n        },\n        {\n          \"id\": \"column_step_2\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"text_step_2_title\",\n            \"text_step_2_body_1\",\n            \"text_step_2_body_2\"\n          ]\n        },\n        {\n          \"id\": \"text_step_2_title\",\n          \"component\": \"Text\",\n          \"text\": \"2. Sauté the Mushrooms:\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"text_step_2_body_1\",\n          \"component\": \"Text\",\n          \"text\": \"In your heavy-bottomed pot, heat 1 tablespoon of olive oil over medium-high heat. Add the sliced mushrooms and cook until browned and their liquid has evaporated (about 5-8 minutes). Season with a pinch of salt.\"\n        },\n        {\n          \"id\": \"text_step_2_body_2\",\n          \"component\": \"Text\",\n          \"text\": \"Remove mushrooms from the pot and set aside. This prevents them from getting rubbery during the rice cooking.\"\n        },\n        {\n          \"id\": \"column_step_3\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"text_step_3_title\",\n            \"text_step_3_body_1\",\n            \"text_step_3_body_2\"\n          ]\n        },\n        {\n          \"id\": \"text_step_3_title\",\n          \"component\": \"Text\",\n          \"text\": \"3. Aromatics and Toasting:\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"text_step_3_body_1\",\n          \"component\": \"Text\",\n          \"text\": \"Reduce heat to medium. Add the remaining 2 tablespoons of olive oil to the pot. Add shallots and cook until softened (2-3 minutes). Add garlic and thyme, cooking for another minute until fragrant. Add the Arborio rice.\"\n        },\n        {\n          \"id\": \"text_step_3_body_2\",\n          \"component\": \"Text\",\n          \"text\": \"Toast the rice, stirring constantly, for 1-2 minutes until the edges are translucent and the center remains opaque. This toasting step creates a shell around the grain so it doesn't turn to mush while slowly releasing starch.\"\n        },\n        {\n          \"id\": \"column_step_4\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"text_step_4_title\",\n            \"text_step_4_body\"\n          ]\n        },\n        {\n          \"id\": \"text_step_4_title\",\n          \"component\": \"Text\",\n          \"text\": \"4. Deglaze:\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"text_step_4_body\",\n          \"component\": \"Text\",\n          \"text\": \"Pour in the white wine. Stir constantly until the wine is fully absorbed by the rice.\"\n        },\n        {\n          \"id\": \"column_step_5\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"text_step_5_title\",\n            \"text_step_5_body_1\",\n            \"text_step_5_body_2\"\n          ]\n        },\n        {\n          \"id\": \"text_step_5_title\",\n          \"component\": \"Text\",\n          \"text\": \"5. The Risotto Method:\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"text_step_5_body_1\",\n          \"component\": \"Text\",\n          \"text\": \"Begin adding the warm broth, one ladle (about 0.5 cup) at a time. Stir frequently. Wait until the liquid is almost completely absorbed before adding the next ladle.\"\n        },\n        {\n          \"id\": \"text_step_5_body_2\",\n          \"component\": \"Text\",\n          \"text\": \"The friction from stirring rubs the grains together, releasing the starch that creates the creamy sauce. Repeat this process for about 20-25 minutes. The rice is done when it is tender but still has a slight bite (al dente).\"\n        },\n        {\n          \"id\": \"column_step_6\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"text_step_6_title\",\n            \"text_step_6_body_1\",\n            \"text_step_6_body_2\"\n          ]\n        },\n        {\n          \"id\": \"text_step_6_title\",\n          \"component\": \"Text\",\n          \"text\": \"6. The Finish (Mantecatura):\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"text_step_6_body_1\",\n          \"component\": \"Text\",\n          \"text\": \"Remove the pot from the heat. This is crucial. Stir in the cooked mushrooms, vegan butter, and nutritional yeast. Vigorously stir the mixture for 30 seconds to emulsify the fats with the starch.\"\n        },\n        {\n          \"id\": \"text_step_6_body_2\",\n          \"component\": \"Text\",\n          \"text\": \"This step guarantees the creamy mouthfeel without dairy. Season with salt and pepper to taste. Garnish with fresh parsley and serve immediately.\"\n        },\n        {\n          \"id\": \"divider_3\",\n          \"component\": \"Divider\"\n        },\n        {\n          \"id\": \"text_phases_heading\",\n          \"component\": \"Text\",\n          \"text\": \"Risotto Cooking Phases\",\n          \"variant\": \"h3\"\n        },\n        {\n          \"id\": \"list_phases_table\",\n          \"component\": \"List\",\n          \"direction\": \"vertical\",\n          \"children\": [\n            \"row_phases_header\",\n            \"row_phase_1\",\n            \"row_phase_2\",\n            \"row_phase_3\",\n            \"row_phase_4\"\n          ]\n        },\n        {\n          \"id\": \"row_phases_header\",\n          \"component\": \"Row\",\n          \"children\": [\n            \"text_phase_header\",\n            \"text_duration_header\",\n            \"text_action_header\"\n          ]\n        },\n        {\n          \"id\": \"text_phase_header\",\n          \"component\": \"Text\",\n          \"text\": \"Phase\",\n          \"variant\": \"body\",\n          \"weight\": 0.25\n        },\n        {\n          \"id\": \"text_duration_header\",\n          \"component\": \"Text\",\n          \"text\": \"Duration\",\n          \"variant\": \"body\",\n          \"weight\": 0.25\n        },\n        {\n          \"id\": \"text_action_header\",\n          \"component\": \"Text\",\n          \"text\": \"Key Action\",\n          \"variant\": \"body\",\n          \"weight\": 0.5\n        },\n        {\n          \"id\": \"row_phase_1\",\n          \"component\": \"Row\",\n          \"children\": [\n            \"text_phase_1_name\",\n            \"text_phase_1_duration\",\n            \"text_phase_1_action\"\n          ]\n        },\n        {\n          \"id\": \"text_phase_1_name\",\n          \"component\": \"Text\",\n          \"text\": \"Prep\",\n          \"variant\": \"body\",\n          \"weight\": 0.25\n        },\n        {\n          \"id\": \"text_phase_1_duration\",\n          \"component\": \"Text\",\n          \"text\": \"10-15 mins\",\n          \"variant\": \"body\",\n          \"weight\": 0.25\n        },\n        {\n          \"id\": \"text_phase_1_action\",\n          \"component\": \"Text\",\n          \"text\": \"Chop vegetables, slice mushrooms, warm broth\",\n          \"variant\": \"body\",\n          \"weight\": 0.5\n        },\n        {\n          \"id\": \"row_phase_2\",\n          \"component\": \"Row\",\n          \"children\": [\n            \"text_phase_2_name\",\n            \"text_phase_2_duration\",\n            \"text_phase_2_action\"\n          ]\n        },\n        {\n          \"id\": \"text_phase_2_name\",\n          \"component\": \"Text\",\n          \"text\": \"Sauté\",\n          \"variant\": \"body\",\n          \"weight\": 0.25\n        },\n        {\n          \"id\": \"text_phase_2_duration\",\n          \"component\": \"Text\",\n          \"text\": \"8-10 mins\",\n          \"variant\": \"body\",\n          \"weight\": 0.25\n        },\n        {\n          \"id\": \"text_phase_2_action\",\n          \"component\": \"Text\",\n          \"text\": \"Brown mushrooms, sweat shallots, toast rice\",\n          \"variant\": \"body\",\n          \"weight\": 0.5\n        },\n        {\n          \"id\": \"row_phase_3\",\n          \"component\": \"Row\",\n          \"children\": [\n            \"text_phase_3_name\",\n            \"text_phase_3_duration\",\n            \"text_phase_3_action\"\n          ]\n        },\n        {\n          \"id\": \"text_phase_3_name\",\n          \"component\": \"Text\",\n          \"text\": \"Simmer\",\n          \"variant\": \"body\",\n          \"weight\": 0.25\n        },\n        {\n          \"id\": \"text_phase_3_duration\",\n          \"component\": \"Text\",\n          \"text\": \"20-25 mins\",\n          \"variant\": \"body\",\n          \"weight\": 0.25\n        },\n        {\n          \"id\": \"text_phase_3_action\",\n          \"component\": \"Text\",\n          \"text\": \"Add broth gradually, stir frequently to release starch\",\n          \"variant\": \"body\",\n          \"weight\": 0.5\n        },\n        {\n          \"id\": \"row_phase_4\",\n          \"component\": \"Row\",\n          \"children\": [\n            \"text_phase_4_name\",\n            \"text_phase_4_duration\",\n            \"text_phase_4_action\"\n          ]\n        },\n        {\n          \"id\": \"text_phase_4_name\",\n          \"component\": \"Text\",\n          \"text\": \"Rest\",\n          \"variant\": \"body\",\n          \"weight\": 0.25\n        },\n        {\n          \"id\": \"text_phase_4_duration\",\n          \"component\": \"Text\",\n          \"text\": \"2-3 mins\",\n          \"variant\": \"body\",\n          \"weight\": 0.25\n        },\n        {\n          \"id\": \"text_phase_4_action\",\n          \"component\": \"Text\",\n          \"text\": \"Remove from heat, beat in fat (mantecatura) for creaminess\",\n          \"variant\": \"body\",\n          \"weight\": 0.5\n        },\n        {\n          \"id\": \"divider_4\",\n          \"component\": \"Divider\"\n        },\n        {\n          \"id\": \"text_images_heading\",\n          \"component\": \"Text\",\n          \"text\": \"Images\",\n          \"variant\": \"h3\"\n        },\n        {\n          \"id\": \"list_images\",\n          \"component\": \"List\",\n          \"direction\": \"vertical\",\n          \"children\": [\n            \"card_image_1\",\n            \"card_image_2\",\n            \"card_image_3\"\n          ]\n        },\n        {\n          \"id\": \"card_image_1\",\n          \"component\": \"Card\",\n          \"child\": \"column_image_1\"\n        },\n        {\n          \"id\": \"column_image_1\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"image_1\",\n            \"text_image_1_caption\"\n          ]\n        },\n        {\n          \"id\": \"image_1\",\n          \"component\": \"Image\",\n          \"url\": \"../assets/r_000701_01_1_mushroom-risotto.jpg\",\n          \"fit\": \"contain\"\n        },\n        {\n          \"id\": \"text_image_1_caption\",\n          \"component\": \"Text\",\n          \"text\": \"Vegan Mushroom Risotto Plating\",\n          \"variant\": \"caption\"\n        },\n        {\n          \"id\": \"card_image_2\",\n          \"component\": \"Card\",\n          \"child\": \"column_image_2\"\n        },\n        {\n          \"id\": \"column_image_2\",\n          \"component\": \"Column\",\n          \"children\":", "raw": {"candidates": [{"content": {"role": "model", "parts": [{"text": "[\n  {\n    \"version\": \"v0.9\",\n    \"createSurface\": {\n      \"surfaceId\": \"recipe_risotto\",\n      \"catalogId\": \"https://genui.local/specification/v0_9/standard_catalog.json\"\n    }\n  },\n  {\n    \"version\": \"v0.9\",\n    \"updateComponents\": {\n      \"surfaceId\": \"recipe_risotto\",\n      \"components\": [\n        {\n          \"id\": \"root\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"text_title\",\n            \"text_overview_body_1\",\n            \"text_overview_body_2\",\n            \"divider_1\",\n            \"text_context_heading\",\n            \"text_context_body_1\",\n            \"text_context_body_2\",\n            \"divider_2\",\n            \"text_instructions_heading\",\n            \"text_ingredients_heading\",\n            \"list_ingredients\",\n            \"text_cooking_steps_heading\",\n            \"column_step_1\",\n            \"column_step_2\",\n            \"column_step_3\",\n            \"column_step_4\",\n            \"column_step_5\",\n            \"column_step_6\",\n            \"divider_3\",\n            \"text_phases_heading\",\n            \"list_phases_table\",\n            \"divider_4\",\n            \"text_images_heading\",\n            \"list_images\",\n            \"divider_5\",\n            \"text_icons_section_heading\",\n            \"list_icons\",\n            \"divider_6\",\n            \"text_sources_heading\",\n            \"list_sources\"\n          ]\n        },\n        {\n          \"id\": \"text_title\",\n          \"component\": \"Text\",\n          \"text\": \"Creamy Vegan Mushroom Risotto Overview\",\n          \"variant\": \"h2\"\n        },\n        {\n          \"id\": \"text_overview_body_1\",\n          \"component\": \"Text\",\n          \"text\": \"This recipe creates a rich, velvety risotto for 4 people without using dairy. The key to the creamy texture lies in the high starch content of Arborio rice and the agitation process (stirring), which releases that starch into the broth.\"\n        },\n        {\n          \"id\": \"text_overview_body_2\",\n          \"component\": \"Text\",\n          \"text\": \"We will use a mix of mushrooms for depth of flavor and finish with a \\\"mantecatura\\\" technique using vegan fat to emulsify the sauce.\"\n        },\n        {\n          \"id\": \"divider_1\",\n          \"component\": \"Divider\"\n        },\n        {\n          \"id\": \"text_context_heading\",\n          \"component\": \"Text\",\n          \"text\": \"Kitchen & Ingredient Context\",\n          \"variant\": \"h3\"\n        },\n        {\n          \"id\": \"text_context_body_1\",\n          \"component\": \"Text\",\n          \"text\": \"This recipe assumes you have a heavy-bottomed pot or Dutch oven to distribute heat evenly. We assume the use of dry white wine (like Pinot Grigio or Sauvignon Blanc) to deglaze the pan, but you can substitute extra vegetable broth mixed with a teaspoon of lemon juice or white wine vinegar if you prefer an alcohol-free version.\"\n        },\n        {\n          \"id\": \"text_context_body_2\",\n          \"component\": \"Text\",\n          \"text\": \"We also assume the use of store-bought low-sodium vegetable broth, but homemade stock works excellently.\"\n        },\n        {\n          \"id\": \"divider_2\",\n          \"component\": \"Divider\"\n        },\n        {\n          \"id\": \"text_instructions_heading\",\n          \"component\": \"Text\",\n          \"text\": \"Step-by-Step Cooking Instructions\",\n          \"variant\": \"h2\"\n        },\n        {\n          \"id\": \"text_ingredients_heading\",\n          \"component\": \"Text\",\n          \"text\": \"Ingredients:\",\n          \"variant\": \"h3\"\n        },\n        {\n          \"id\": \"list_ingredients\",\n          \"component\": \"List\",\n          \"direction\": \"vertical\",\n          \"children\": [\n            \"row_ingredient_1\",\n            \"row_ingredient_2\",\n            \"row_ingredient_3\",\n            \"row_ingredient_4\",\n            \"row_ingredient_5\",\n            \"row_ingredient_6\",\n            \"row_ingredient_7\",\n            \"row_ingredient_8\",\n            \"row_ingredient_9\",\n            \"row_ingredient_10\",\n            \"row_ingredient_11\"\n          ]\n        },\n        {\n          \"id\": \"row_ingredient_1\",\n          \"component\": \"Row\",\n          \"children\": [\n            \"text_ingredient_1_quantity\",\n            \"text_ingredient_1_item\"\n          ]\n        },\n        {\n          \"id\": \"text_ingredient_1_quantity\",\n          \"component\": \"Text\",\n          \"text\": \"1.5 cups\",\n          \"weight\": 0.3\n        },\n        {\n          \"id\": \"text_ingredient_1_item\",\n          \"component\": \"Text\",\n          \"text\": \"Arborio rice (do not rinse, as starch is needed)\",\n          \"weight\": 0.7\n        },\n        {\n          \"id\": \"row_ingredient_2\",\n          \"component\": \"Row\",\n          \"children\": [\n            \"text_ingredient_2_quantity\",\n            \"text_ingredient_2_item\"\n          ]\n        },\n        {\n          \"id\": \"text_ingredient_2_quantity\",\n          \"component\": \"Text\",\n          \"text\": \"5 to 6 cups\",\n          \"weight\": 0.3\n        },\n        {\n          \"id\": \"text_ingredient_2_item\",\n          \"component\": \"Text\",\n          \"text\": \"vegetable broth (kept warm in a separate pot)\",\n          \"weight\": 0.7\n        },\n        {\n          \"id\": \"row_ingredient_3\",\n          \"component\": \"Row\",\n          \"children\": [\n            \"text_ingredient_3_quantity\",\n            \"text_ingredient_3_item\"\n          ]\n        },\n        {\n          \"id\": \"text_ingredient_3_quantity\",\n          \"component\": \"Text\",\n          \"text\": \"1 lb\",\n          \"weight\": 0.3\n        },\n        {\n          \"id\": \"text_ingredient_3_item\",\n          \"component\": \"Text\",\n          \"text\": \"mixed mushrooms (cremini, shiitake, oyster), sliced\",\n          \"weight\": 0.7\n        },\n        {\n          \"id\": \"row_ingredient_4\",\n          \"component\": \"Row\",\n          \"children\": [\n            \"text_ingredient_4_quantity\",\n            \"text_ingredient_4_item\"\n          ]\n        },\n        {\n          \"id\": \"text_ingredient_4_quantity\",\n          \"component\": \"Text\",\n          \"text\": \"2\",\n          \"weight\": 0.3\n        },\n        {\n          \"id\": \"text_ingredient_4_item\",\n          \"component\": \"Text\",\n          \"text\": \"shallots, finely minced\",\n          \"weight\": 0.7\n        },\n        {\n          \"id\": \"row_ingredient_5\",\n          \"component\": \"Row\",\n          \"children\": [\n            \"text_ingredient_5_quantity\",\n            \"text_ingredient_5_item\"\n          ]\n        },\n        {\n          \"id\": \"text_ingredient_5_quantity\",\n          \"component\": \"Text\",\n          \"text\": \"3 cloves\",\n          \"weight\": 0.3\n        },\n        {\n          \"id\": \"text_ingredient_5_item\",\n          \"component\": \"Text\",\n          \"text\": \"garlic, minced\",\n          \"weight\": 0.7\n        },\n        {\n          \"id\": \"row_ingredient_6\",\n          \"component\": \"Row\",\n          \"children\": [\n            \"text_ingredient_6_quantity\",\n            \"text_ingredient_6_item\"\n          ]\n        },\n        {\n          \"id\": \"text_ingredient_6_quantity\",\n          \"component\": \"Text\",\n          \"text\": \"0.5 cup\",\n          \"weight\": 0.3\n        },\n        {\n          \"id\": \"text_ingredient_6_item\",\n          \"component\": \"Text\",\n          \"text\": \"dry white wine\",\n          \"weight\": 0.7\n        },\n        {\n          \"id\": \"row_ingredient_7\",\n          \"component\": \"Row\",\n          \"children\": [\n            \"text_ingredient_7_quantity\",\n            \"text_ingredient_7_item\"\n          ]\n        },\n        {\n          \"id\": \"text_ingredient_7_quantity\",\n          \"component\": \"Text\",\n          \"text\": \"3 tbsp\",\n          \"weight\": 0.3\n        },\n        {\n          \"id\": \"text_ingredient_7_item\",\n          \"component\": \"Text\",\n          \"text\": \"olive oil (divided)\",\n          \"weight\": 0.7\n        },\n        {\n          \"id\": \"row_ingredient_8\",\n          \"component\": \"Row\",\n          \"children\": [\n            \"text_ingredient_8_quantity\",\n            \"text_ingredient_8_item\"\n          ]\n        },\n        {\n          \"id\": \"text_ingredient_8_quantity\",\n          \"component\": \"Text\",\n          \"text\": \"2 tbsp\",\n          \"weight\": 0.3\n        },\n        {\n          \"id\": \"text_ingredient_8_item\",\n          \"component\": \"Text\",\n          \"text\": \"vegan butter (or extra olive oil)\",\n          \"weight\": 0.7\n        },\n        {\n          \"id\": \"row_ingredient_9\",\n          \"component\": \"Row\",\n          \"children\": [\n            \"text_ingredient_9_quantity\",\n            \"text_ingredient_9_item\"\n          ]\n        },\n        {\n          \"id\": \"text_ingredient_9_quantity\",\n          \"component\": \"Text\",\n          \"text\": \"0.25 cup\",\n          \"weight\": 0.3\n        },\n        {\n          \"id\": \"text_ingredient_9_item\",\n          \"component\": \"Text\",\n          \"text\": \"nutritional yeast (optional, for cheesy flavor)\",\n          \"weight\": 0.7\n        },\n        {\n          \"id\": \"row_ingredient_10\",\n          \"component\": \"Row\",\n          \"children\": [\n            \"text_ingredient_10_quantity\",\n            \"text_ingredient_10_item\"\n          ]\n        },\n        {\n          \"id\": \"text_ingredient_10_quantity\",\n          \"component\": \"Text\",\n          \"text\": \"1 tbsp\",\n          \"weight\": 0.3\n        },\n        {\n          \"id\": \"text_ingredient_10_item\",\n          \"component\": \"Text\",\n          \"text\": \"fresh thyme leaves\",\n          \"weight\": 0.7\n        },\n        {\n          \"id\": \"row_ingredient_11\",\n          \"component\": \"Row\",\n          \"children\": [\n            \"text_ingredient_11_quantity\",\n            \"text_ingredient_11_item\"\n          ]\n        },\n        {\n          \"id\": \"text_ingredient_11_quantity\",\n          \"component\": \"Text\",\n          \"text\": \"\",\n          \"weight\": 0.3\n        },\n        {\n          \"id\": \"text_ingredient_11_item\",\n          \"component\": \"Text\",\n          \"text\": \"Salt and black pepper to taste\",\n          \"weight\": 0.7\n        },\n        {\n          \"id\": \"text_cooking_steps_heading\",\n          \"component\": \"Text\",\n          \"text\": \"Instructions:\",\n          \"variant\": \"h3\"\n        },\n        {\n          \"id\": \"column_step_1\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"text_step_1_title\",\n            \"text_step_1_body\"\n          ]\n        },\n        {\n          \"id\": \"text_step_1_title\",\n          \"component\": \"Text\",\n          \"text\": \"1. Warm the Broth:\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"text_step_1_body\",\n          \"component\": \"Text\",\n          \"text\": \"Pour the vegetable broth into a saucepan and keep it on a low simmer next to your main cooking pot. Cold broth shocks the rice and stops the cooking process, preventing the creamy texture from developing.\"\n        },\n        {\n          \"id\": \"column_step_2\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"text_step_2_title\",\n            \"text_step_2_body_1\",\n            \"text_step_2_body_2\"\n          ]\n        },\n        {\n          \"id\": \"text_step_2_title\",\n          \"component\": \"Text\",\n          \"text\": \"2. Sauté the Mushrooms:\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"text_step_2_body_1\",\n          \"component\": \"Text\",\n          \"text\": \"In your heavy-bottomed pot, heat 1 tablespoon of olive oil over medium-high heat. Add the sliced mushrooms and cook until browned and their liquid has evaporated (about 5-8 minutes). Season with a pinch of salt.\"\n        },\n        {\n          \"id\": \"text_step_2_body_2\",\n          \"component\": \"Text\",\n          \"text\": \"Remove mushrooms from the pot and set aside. This prevents them from getting rubbery during the rice cooking.\"\n        },\n        {\n          \"id\": \"column_step_3\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"text_step_3_title\",\n            \"text_step_3_body_1\",\n            \"text_step_3_body_2\"\n          ]\n        },\n        {\n          \"id\": \"text_step_3_title\",\n          \"component\": \"Text\",\n          \"text\": \"3. Aromatics and Toasting:\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"text_step_3_body_1\",\n          \"component\": \"Text\",\n          \"text\": \"Reduce heat to medium. Add the remaining 2 tablespoons of olive oil to the pot. Add shallots and cook until softened (2-3 minutes). Add garlic and thyme, cooking for another minute until fragrant. Add the Arborio rice.\"\n        },\n        {\n          \"id\": \"text_step_3_body_2\",\n          \"component\": \"Text\",\n          \"text\": \"Toast the rice, stirring constantly, for 1-2 minutes until the edges are translucent and the center remains opaque. This toasting step creates a shell around the grain so it doesn't turn to mush while slowly releasing starch.\"\n        },\n        {\n          \"id\": \"column_step_4\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"text_step_4_title\",\n            \"text_step_4_body\"\n          ]\n        },\n        {\n          \"id\": \"text_step_4_title\",\n          \"component\": \"Text\",\n          \"text\": \"4. Deglaze:\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"text_step_4_body\",\n          \"component\": \"Text\",\n          \"text\": \"Pour in the white wine. Stir constantly until the wine is fully absorbed by the rice.\"\n        },\n        {\n          \"id\": \"column_step_5\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"text_step_5_title\",\n            \"text_step_5_body_1\",\n            \"text_step_5_body_2\"\n          ]\n        },\n        {\n          \"id\": \"text_step_5_title\",\n          \"component\": \"Text\",\n          \"text\": \"5. The Risotto Method:\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"text_step_5_body_1\",\n          \"component\": \"Text\",\n          \"text\": \"Begin adding the warm broth, one ladle (about 0.5 cup) at a time. Stir frequently. Wait until the liquid is almost completely absorbed before adding the next ladle.\"\n        },\n        {\n          \"id\": \"text_step_5_body_2\",\n          \"component\": \"Text\",\n          \"text\": \"The friction from stirring rubs the grains together, releasing the starch that creates the creamy sauce. Repeat this process for about 20-25 minutes. The rice is done when it is tender but still has a slight bite (al dente).\"\n        },\n        {\n          \"id\": \"column_step_6\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"text_step_6_title\",\n            \"text_step_6_body_1\",\n            \"text_step_6_body_2\"\n          ]\n        },\n        {\n          \"id\": \"text_step_6_title\",\n          \"component\": \"Text\",\n          \"text\": \"6. The Finish (Mantecatura):\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"text_step_6_body_1\",\n          \"component\": \"Text\",\n          \"text\": \"Remove the pot from the heat. This is crucial. Stir in the cooked mushrooms, vegan butter, and nutritional yeast. Vigorously stir the mixture for 30 seconds to emulsify the fats with the starch.\"\n        },\n        {\n          \"id\": \"text_step_6_body_2\",\n          \"component\": \"Text\",\n          \"text\": \"This step guarantees the creamy mouthfeel without dairy. Season with salt and pepper to taste. Garnish with fresh parsley and serve immediately.\"\n        },\n        {\n          \"id\": \"divider_3\",\n          \"component\": \"Divider\"\n        },\n        {\n          \"id\": \"text_phases_heading\",\n          \"component\": \"Text\",\n          \"text\": \"Risotto Cooking Phases\",\n          \"variant\": \"h3\"\n        },\n        {\n          \"id\":