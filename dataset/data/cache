{"prompt_hash": "c59278bd85f058635a6317bd5f9da6fc177542d8ed828edac7fcc3ae6baa12a6", "text": "[\n  {\n    \"version\": \"v0.9\",\n    \"createSurface\": {\n      \"surfaceId\": \"bolognese-recipe-surface\",\n      \"catalogId\": \"https://genui.local/specification/v0_9/standard_catalog.json\",\n      \"theme\": {\n        \"primaryColor\": \"#C41E3A\",\n        \"agentDisplayName\": \"Chef GenUI\"\n      }\n    }\n  },\n  {\n    \"version\": \"v0.9\",\n    \"updateComponents\": {\n      \"surfaceId\": \"bolognese-recipe-surface\",\n      \"components\": [\n        {\n          \"id\": \"root\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"header-title\",\n            \"summary-text\",\n            \"image-main\",\n            \"header-ingredients\",\n            \"list-ingredients\",\n            \"image-soffritto\",\n            \"header-instructions\",\n            \"list-instructions\",\n            \"divider-actions\",\n            \"header-actions\",\n            \"row-actions\"\n          ]\n        },\n        {\n          \"id\": \"header-title\",\n          \"component\": \"Text\",\n          \"variant\": \"h2\",\n          \"text\": \"Traditional Italian Bolognese Sauce (Serves 4)\"\n        },\n        {\n          \"id\": \"summary-text\",\n          \"component\": \"Text\",\n          \"variant\": \"body\",\n          \"text\": \"This recipe provides a traditional, rich, and deeply flavorful Bolognese sauce, perfect for serving with fresh pasta. The key to its authentic taste is a slow, patient simmer over three hours, allowing the flavors to meld beautifully. This process creates a thick, luxurious sauce that is a staple of Italian cuisine.\"\n        },\n        {\n          \"id\": \"image-main\",\n          \"component\": \"Image\",\n          \"url\": \"/assets/bolognese_simmering.jpg\",\n          \"variant\": \"largeFeature\",\n          \"fit\": \"cover\"\n        },\n        {\n          \"id\": \"header-ingredients\",\n          \"component\": \"Text\",\n          \"variant\": \"h3\",\n          \"text\": \"Ingredients\"\n        },\n        {\n          \"id\": \"list-ingredients\",\n          \"component\": \"List\",\n          \"direction\": \"vertical\",\n          \"children\": [\n            \"ing-1\",\n            \"ing-2\",\n            \"ing-3\",\n            \"ing-4\",\n            \"ing-5\",\n            \"ing-6\",\n            \"ing-7\",\n            \"ing-8\",\n            \"ing-9\",\n            \"ing-10\",\n            \"ing-11\",\n            \"ing-12\",\n            \"ing-13\",\n            \"ing-14\",\n            \"ing-15\"\n          ]\n        },\n        {\n          \"id\": \"ing-1\",\n          \"component\": \"Text\",\n          \"text\": \"• Olive Oil: 30 ml (2 tablespoons)\"\n        },\n        {\n          \"id\": \"ing-2\",\n          \"component\": \"Text\",\n          \"text\": \"• Pancetta, diced: 100 grams\"\n        },\n        {\n          \"id\": \"ing-3\",\n          \"component\": \"Text\",\n          \"text\": \"• Yellow Onion, finely chopped: 150 grams (about 1 medium)\"\n        },\n        {\n          \"id\": \"ing-4\",\n          \"component\": \"Text\",\n          \"text\": \"• Carrot, finely chopped: 100 grams (about 1 medium)\"\n        },\n        {\n          \"id\": \"ing-5\",\n          \"component\": \"Text\",\n          \"text\": \"• Celery Stalk, finely chopped: 100 grams (about 1-2 stalks)\"\n        },\n        {\n          \"id\": \"ing-6\",\n          \"component\": \"Text\",\n          \"text\": \"• Ground Beef (80/20 blend recommended): 300 grams\"\n        },\n        {\n          \"id\": \"ing-7\",\n          \"component\": \"Text\",\n          \"text\": \"• Ground Pork: 200 grams\"\n        },\n        {\n          \"id\": \"ing-8\",\n          \"component\": \"Text\",\n          \"text\": \"• Whole Milk: 200 ml\"\n        },\n        {\n          \"id\": \"ing-9\",\n          \"component\": \"Text\",\n     