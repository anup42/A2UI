card\",\n          \"component\": \"Card\",\n          \"child\": \"day4_col\"\n        },\n        {\n          \"id\": \"day4_col\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"day4_title\",\n            \"day4_driving_time\",\n            \"day4_stop_row\",\n            \"day4_hike_row\",\n            \"day4_stay_row\"\n          ]\n        },\n        {\n          \"id\": \"day4_title\",\n          \"component\": \"Text\",\n          \"variant\": \"h4\",\n          \"text\": \"Day 4: The Southern Approach | Santa Barbara to Los Angeles\"\n        },\n        {\n          \"id\": \"day4_driving_time\",\n          \"component\": \"Text\",\n          \"variant\": \"caption\",\n          \"text\": \"Driving Time: ~2 hours (100 miles)\"\n        },\n        {\n          \"id\": \"day4_stop_row\",\n          \"component\": \"Row\",\n          \"align\": \"center\",\n          \"children\": [\n            \"camera_icon_4\",\n            \"day4_stop_text\"\n          ]\n        },\n        {\n          \"id\": \"camera_icon_4\",\n          \"component\": \"Image\",\n          \"variant\": \"icon\",\n          \"url\": \"../assets/r_000002_01_1_camera.svg\"\n        },\n        {\n          \"id\": \"day4_stop_text\",\n          \"component\": \"Text\",\n          \"weight\": 1,\n          \"text\": \"Major Scenic Stop: Point Dume State Beach & Preserve. Located in Malibu, this promontory offers panoramic views of the coast, Zuma Beach, and Paradise Cove. It's a prime spot for sunset photography.\"\n        },\n        {\n          \"id\": \"day4_hike_row\",\n          \"component\": \"Row\",\n          \"align\": \"center\",\n          \"children\": [\n            \"hike_icon_4\",\n            \"day4_hike_text\"\n          ]\n        },\n        {\n          \"id\": \"hike_icon_4\",\n          \"component\": \"Image\",\n          \"variant\": \"icon\",\n          \"url\": \"../assets/r_000036_01_2_house.svg\"\n        },\n        {\n 