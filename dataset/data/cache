   {\n          \"id\": \"context-section\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"context-header\",\n            \"context-body\"\n          ]\n        },\n        {\n          \"id\": \"context-header\",\n          \"component\": \"Text\",\n          \"text\": \"Kitchen & Ingredient Context\",\n          \"variant\": \"h3\"\n        },\n        {\n          \"id\": \"context-body\",\n          \"component\": \"Text\",\n          \"text\": \"This recipe assumes you have a heavy-bottomed pot or Dutch oven to distribute heat evenly. We assume the use of dry white wine (like Pinot Grigio or Sauvignon Blanc) to deglaze the pan, but you can substitute extra vegetable broth mixed with a teaspoon of lemon juice or white wine vinegar if you prefer an alcohol-free version. We also assume the use of store-bought low-sodium vegetable broth, but homemade stock works excellently.\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"ingredients-section\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"ingredients-header\",\n            \"ingredients-list\"\n          ]\n        },\n        {\n          \"id\": \"ingredients-header\",\n          \"component\": \"Text\",\n          \"text\": \"Ingredients\",\n          \"variant\": \"h3\"\n        },\n        {\n          \"id\": \"ingredients-list\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"ing-1\",\n            \"ing-2\",\n            \"ing-3\",\n            \"ing-4\",\n            \"ing-5\",\n            \"ing-6\",\n            \"ing-7\",\n            \"ing-8\",\n            \"ing-9\",\n            \"ing-10\",\n            \"ing-11\",\n            \"ing-12\"\n          ]\n        },\n        {\n          \"id\": \"ing-1\",\n          \"component\": \"Row\",\n          \"children\": [\n            \"icon-basket-1\",\n            \"text-ing-1\"\n          ],\n          \"align\": \"center\"\n        },\n        {\n          \"id\": \"icon-basket-1\",\n          \"component\": \"Image\",\n          \"url\": \"/assets/r_000701_01_6_basket.svg\",\n          \"variant\": \"icon\",\n          \"fit\": \"contain\"\n        },\n        {\n          \"id\": \"text-ing-1\",\n          \"component\": \"Text\",\n          \"text\": \"1.5 cups Arborio rice (do not rinse)\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"ing-2\",\n          \"component\": \"Row\",\n          \"children\": [\n            \"icon-basket-2\",\n            \"text-ing-2\"\n          ],\n          \"align\": \"center\"\n        },\n        {\n          \"id\": \"icon-basket-2\",\n          \"component\": \"Image\",\n          \"url\": \"/assets/r_000701_01_6_basket.svg\",\n          \"variant\": \"icon\",\n          \"fit\": \"contain\"\n        },\n        {\n          \"id\": \"text-ing-2\",\n          \"component\": \"Text\",\n          \"text\": \"5 to 6 cups vegetable broth (warm)\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"ing-3\",\n          \"component\": \"Row\",\n          \"children\": [\n            \"icon-basket-3\",\n            \"text-ing-3\"\n          ],\n          \"align\": \"center\"\n        },\n        {\n          \"id\": \"icon-basket-3\",\n          \"component\": \"Image\",\n          \"url\": \"/assets/r_000701_01_6_basket.svg\",\n          \"variant\": \"icon\",\n          \"fit\": \"contain\"\n        },\n        {\n          \"id\": \"text-ing-3\",\n          \"component\": \"Text\",\n          \"text\": \"1 lb mixed mushrooms (cremini, shiitake, oyster), sliced\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"ing-4\",\n          \"component\": \"Row\",\n          \"children\": [\n            \"icon-basket-4\",\n            \"text-ing-4\"\n          ],\n          \"align\": \"center\"\n        },\n        {\n          \"id\": \"icon-basket-4\",\n          \"component\": \"Image\",\n          \"url\": \"/assets/r_000701_01_6_basket.svg\",\n          \"variant\": \"icon\",\n          \"fit\": \"contain\"\n        },\n        {\n          \"id\": \"text-ing-4\",\n          \"component\": \"Text\",\n          \"text\": \"2 shallots, finely minced\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"ing-5\",\n          \"component\": \"Row\",\n          \"children\": [\n            \"icon-basket-5\",\n            \"text-ing-5\"\n          ],\n          \"align\": \"center\"\n        },\n        {\n          \"id\": \"icon-basket-5\",\n          \"component\": \"Image\",\n          \"url\": \"/assets/r_000701_01_6_basket.svg\",\n          \"variant\": \"icon\",\n          \"fit\": \"contain\"\n        },\n        {\n          \"id\": \"text-ing-5\",\n          \"component\": \"Text\",\n          \"text\": \"3 cloves garlic, minced\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"ing-6\",\n          \"component\": \"Row\",\n          \"children\": [\n            \"icon-basket-6\",\n            \"text-ing-6\"\n          ],\n          \"align\": \"center\"\n        },\n        {\n          \"id\": \"icon-basket-6\",\n          \"component\": \"Image\",\n          \"url\": \"/assets/r_000701_01_6_basket.svg\",\n          \"variant\": \"icon\",\n          \"fit\": \"contain\"\n        },\n        {\n          \"id\": \"text-ing-6\",\n          \"component\": \"Text\",\n          \"text\": \"0.5 cup dry white wine\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"ing-7\",\n          \"component\": \"Row\",\n          \"children\": [\n            \"icon-basket-7\",\n            \"text-ing-7\"\n          ],\n          \"align\": \"center\"\n        },\n        {\n          \"id\": \"icon-basket-7\",\n          \"component\": \"Image\",\n          \"url\": \"/assets/r_000701_01_6_basket.svg\",\n          \"variant\": \"icon\",\n          \"fit\": \"contain\"\n        },\n        {\n          \"id\": \"text-ing-7\",\n          \"component\": \"Text\",\n          \"text\": \"3 tbsp olive oil (divided)\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"ing-8\",\n          \"component\": \"Row\",\n          \"children\": [\n            \"icon-basket-8\",\n            \"text-ing-8\"\n          ],\n          \"align\": \"center\"\n        },\n        {\n          \"id\": \"icon-basket-8\",\n          \"component\": \"Image\",\n          \"url\": \"/assets/r_000701_01_6_basket.svg\",\n          \"variant\": \"icon\",\n          \"fit\": \"contain\"\n        },\n        {\n          \"id\": \"text-ing-8\",\n          \"component\": \"Text\",\n          \"text\": \"2 tbsp vegan butter (or extra olive oil)\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"ing-9\",\n          \"component\": \"Row\",\n          \"children\": [\n            \"icon-basket-9\",\n            \"text-ing-9\"\n          ],\n          \"align\": \"center\"\n        },\n        {\n          \"id\": \"icon-basket-9\",\n          \"component\": \"Image\",\n          \"url\": \"/assets/r_000701_01_6_basket.svg\",\n          \"variant\": \"icon\",\n          \"fit\": \"contain\"\n        },\n        {\n          \"id\": \"text-ing-9\",\n          \"component\": \"Text\",\n          \"text\": \"0.25 cup nutritional yeast (optional)\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"ing-10\",\n          \"component\": \"Row\",\n          \"children\": [\n            \"icon-basket-10\",\n            \"text-ing-10\"\n          ],\n          \"align\": \"center\"\n        },\n        {\n          \"id\": \"icon-basket-10\",\n          \"component\": \"Image\",\n          \"url\": \"/assets/r_000701_01_6_basket.svg\",\n          \"variant\": \"icon\",\n          \"fit\": \"contain\"\n        },\n        {\n          \"id\": \"text-ing-10\",\n          \"component\": \"Text\",\n          \"text\": \"1 tbsp fresh thyme leaves\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"ing-11\",\n          \"component\": \"Row\",\n          \"children\": [\n            \"icon-basket-11\",\n            \"text-ing-11\"\n          ],\n          \"align\": \"center\"\n        },\n        {\n          \"id\": \"icon-basket-11\",\n          \"component\": \"Image\",\n          \"url\": \"/assets/r_000701_01_6_basket.svg\",\n          \"variant\": \"icon\",\n          \"fit\": \"contain\"\n        },\n        {\n          \"id\": \"text-ing-11\",\n          \"component\": \"Text\",\n          \"text\": \"Salt and black pepper to taste\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"ing-12\",\n          \"component\": \"Row\",\n          \"children\": [\n            \"icon-basket-12\",\n            \"text-ing-12\"\n          ],\n          \"align\": \"center\"\n        },\n        {\n          \"id\": \"icon-basket-12\",\n          \"component\": \"Image\",\n          \"url\": \"/assets/r_000701_01_6_basket.svg\",\n          \"variant\": \"icon\",\n          \"fit\": \"contain\"\n        },\n        {\n          \"id\": \"text-ing-12\",\n          \"component\": \"Text\",\n          \"text\": \"Fresh parsley for garnish\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"instructions-section\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"instructions-header\",\n            \"step-1\",\n            \"step-2\",\n            \"step-3\",\n            \"image-rice\",\n            \"step-4\",\n            \"step-5\",\n            \"image-cooking\",\n            \"step-6\"\n          ]\n        },\n        {\n          \"id\": \"instructions-header\",\n          \"component\": \"Text\",\n          \"text\": \"Instructions\",\n          \"variant\": \"h3\"\n        },\n        {\n          \"id\": \"step-1\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"step-1-title\",\n            \"step-1-body\"\n          ]\n        },\n        {\n          \"id\": \"step-1-title\",\n          \"component\": \"Text\",\n          \"text\": \"1. Warm the Broth\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"step-1-body\",\n          \"component\": \"Text\",\n          \"text\": \"Pour the vegetable broth into a saucepan and keep it on a low simmer next to your main cooking pot. Cold broth shocks the rice and stops the cooking process, preventing the creamy texture from developing.\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"step-2\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"step-2-title\",\n            \"step-2-body\"\n          ]\n        },\n        {\n          \"id\": \"step-2-title\",\n          \"component\": \"Text\",\n          \"text\": \"2. Sauté the Mushrooms\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"step-2-body\",\n          \"component\": \"Text\",\n          \"text\": \"In your heavy-bottomed pot, heat 1 tablespoon of olive oil over medium-high heat. Add the sliced mushrooms and cook until browned and their liquid has evaporated (about 5-8 minutes). Season with a pinch of salt. Remove mushrooms from the pot and set aside. This prevents them from getting rubbery during the rice cooking.\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"step-3\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"step-3-title\",\n            \"step-3-body\"\n          ]\n        },\n        {\n          \"id\": \"step-3-title\",\n          \"component\": \"Text\",\n          \"text\": \"3. Aromatics and Toasting\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"step-3-body\",\n          \"component\": \"Text\",\n          \"text\": \"Reduce heat to medium. Add the remaining 2 tablespoons of olive oil to the pot. Add shallots and cook until softened (2-3 minutes). Add garlic and thyme, cooking for another minute until fragrant. Add the Arborio rice. Toast the rice, stirring constantly, for 1-2 minutes until the edges are translucent and the center remains opaque. This toasting step creates a shell around the grain so it doesn't turn to mush while slowly releasing starch.\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"image-rice\",\n          \"component\": \"Image\",\n          \"url\": \"/assets/r_000701_01_2_arborio-rice.jpg\",\n          \"variant\": \"mediumFeature\",\n          \"fit\": \"cover\"\n        },\n        {\n          \"id\": \"step-4\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"step-4-title\",\n            \"step-4-body\"\n          ]\n        },\n        {\n          \"id\": \"step-4-title\",\n          \"component\": \"Text\",\n          \"text\": \"4. Deglaze\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"step-4-body\",\n          \"component\": \"Text\",\n          \"text\": \"Pour in the white wine. Stir constantly until the wine is fully absorbed by the rice.\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"step-5\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"step-5-title\",\n            \"step-5-body\"\n          ]\n        },\n        {\n          \"id\": \"step-5-title\",\n          \"component\": \"Text\",\n          \"text\": \"5. The Risotto Method\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"step-5-body\",\n          \"component\": \"Text\",\n          \"text\": \"Begin adding the warm broth, one ladle (about 0.5 cup) at a time. Stir frequently. Wait until the liquid is almost completely absorbed before adding the next ladle. The friction from stirring rubs the grains together, releasing the starch that creates the creamy sauce. Repeat this process for about 20-25 minutes. The rice is done when it is tender but still has a slight bite (al dente).\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"image-cooking\",\n          \"component\": \"Image\",\n          \"url\": \"/assets/r_000701_01_3_cooking-rice.jpg\",\n          \"variant\": \"mediumFeature\",\n          \"fit\": \"cover\"\n        },\n        {\n          \"id\": \"step-6\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"step-6-title\",\n            \"step-6-body\"\n          ]\n        },\n        {\n          \"id\": \"step-6-title\",\n          \"component\": \"Text\",\n          \"text\": \"6. The Finish (Mantecatura)\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"step-6-body\",\n          \"component\": \"Text\",\n          \"text\": \"Remove the pot from the heat. This is crucial. Stir in the cooked mushrooms, vegan butter, and nutritional yeast. Vigorously stir the mixture for 30 seconds to emulsify the fats with the starch. This step guarantees the creamy mouthfeel without dairy. Season with salt and pepper to taste. Garnish with fresh parsley and serve immediately.\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"phases-section\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"phases-header\",\n            \"phases-table\"\n          ]\n        },\n        {\n          \"id\": \"phases-header\",\n          \"component\": \"Text\",\n          \"text\": \"Risotto Cooking Phases\",\n          \"variant\": \"h3\"\n        },\n        {\n          \"id\": \"phases-table\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"table-header-row\",\n            \"table-row-1\",\n            \"table-row-2\",\n            \"table-row-3\",\n            \"table-row-4\"\n          ]\n        },\n        {\n          \"i