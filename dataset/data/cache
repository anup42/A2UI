{"prompt_hash": "86b6cb9cde6a081204d395aa38ca0dc086944cbe5a5c1b169c1d6380e3eac342", "text": "[\n  {\n    \"version\": \"v0.9\",\n    \"createSurface\": {\n      \"surfaceId\": \"catan_guide_surface\",\n      \"catalogId\": \"https://genui.local/specification/v0_9/standard_catalog.json\"\n    }\n  },\n  {\n    \"version\": \"v0.9\",\n    \"updateComponents\": {\n      \"surfaceId\": \"catan_guide_surface\",\n      \"components\": [\n        {\n          \"id\": \"root\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"header_row\",\n            \"summary_card\",\n            \"main_tabs\",\n            \"footer_text\"\n          ],\n          \"align\": \"stretch\"\n        },\n        {\n          \"id\": \"header_row\",\n          \"component\": \"Row\",\n          \"children\": [\n            \"title_text\",\n            \"header_icon\"\n          ],\n          \"justify\": \"spaceBetween\",\n          \"align\": \"center\"\n        },\n        {\n          \"id\": \"title_text\",\n          \"component\": \"Text\",\n          \"text\": \"Catan: Beginner's Guide\",\n          \"variant\": \"h2\"\n        },\n        {\n          \"id\": \"header_icon\",\n          \"component\": \"Image\",\n          \"url\": \"/assets/r_000086_01_1_hexagon.png\",\n          \"variant\": \"icon\"\n        },\n        {\n          \"id\": \"summary_card\",\n          \"component\": \"Card\",\n          \"child\": \"summary_text\"\n        },\n        {\n          \"id\": \"summary_text\",\n          \"component\": \"Text\",\n          \"text\": \"Players compete to be the dominant force on the island of Catan by building settlements, cities, and roads.\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"main_tabs\",\n          \"component\": \"Tabs\",\n          \"tabs\": [\n            {\n              \"title\": \"Setup\",\n              \"child\": \"setup_col\"\n            },\n            {\n              \"title\": \"