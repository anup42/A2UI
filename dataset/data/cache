1_4_clock.svg\",\n          \"variant\": \"icon\",\n          \"fit\": \"contain\"\n        },\n        {\n          \"id\": \"meta_prep\",\n          \"component\": \"Text\",\n          \"text\": \" Prep Time \",\n          \"variant\": \"caption\"\n        },\n        {\n          \"id\": \"icon_people\",\n          \"component\": \"Image\",\n          \"url\": \"../assets/r_000701_01_5_people.svg\",\n          \"variant\": \"icon\",\n          \"fit\": \"contain\"\n        },\n        {\n          \"id\": \"meta_servings\",\n          \"component\": \"Text\",\n          \"text\": \" Servings \",\n          \"variant\": \"caption\"\n        },\n        {\n          \"id\": \"summary_text\",\n          \"component\": \"Text\",\n          \"text\": \"This vegan mushroom risotto achieves a rich, creamy texture without dairy by leveraging the natural starches of Arborio rice and a technique called 'mantecatura' using vegan fats. By slowly adding warm vegetable broth and stirring frequently, the rice releases amylopectin, creating a velvety sauce. Umami boosters like soy sauce or miso paste replace the depth usually provided by parmesan cheese.\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"assumptions_text\",\n          \"component\": \"Text\",\n          \"text\": \"Assumptions: I assume you have access to a heavy-bottomed pot or Dutch oven for even heat distribution and standard measuring tools.\",\n          \"variant\": \"caption\"\n        },\n        {\n          \"id\": \"divider_1\",\n          \"component\": \"Divider\"\n        },\n        {\n          \"id\": \"ingredients_section\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"ingredients_header_row\",\n            \"ingredients_list\",\n            \"rice_image\"\n          ]\n        },\n        {\n          \"id\": \"ingredients_header_row\",\n          \"component\": \"Row\",\n          \"children\": [\n            \"icon_basket\",\n            \"ingredients_title\"\n          ],\n          \"align\": \"center\"\n        },\n        {\n          \"id\": \"icon_basket\",\n          \"component\": \"Image\",\n          \"url\": \"../assets/r_000701_01_6_basket.svg\",\n          \"variant\": \"icon\",\n          \"fit\": \"contain\"\n        },\n        {\n          \"id\": \"ingredients_title\",\n          \"component\": \"Text\",\n          \"text\": \" Ingredients Checklist\",\n          \"variant\": \"h3\"\n        },\n        {\n          \"id\": \"ingredients_list\",\n          \"component\": \"List\",\n          \"direction\": \"vertical\",\n          \"children\": [\n            \"ing_1\",\n            \"ing_2\",\n            \"ing_3\",\n            \"ing_4\",\n            \"ing_5\",\n            \"ing_6\",\n            \"ing_7\",\n            \"ing_8\",\n            \"ing_9\",\n            \"ing_10\",\n            \"ing_11\",\n            \"ing_12\",\n            \"ing_13\"\n          ]\n        },\n        {\n          \"id\": \"ing_1\",\n          \"component\": \"Text\",\n          \"text\": \"• 1.5 cups Arborio rice\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"ing_2\",\n          \"component\": \"Text\",\n          \"text\": \"• 5-6 cups Vegetable broth (low sodium, kept simmering)\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"ing_3\",\n          \"component\": \"Text\",\n          \"text\": \"• 1 lb Mixed mushrooms (cremini, shiitake, oyster), sliced\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"ing_4\",\n          \"component\": \"Text\",\n          \"text\": \"• 1 Medium yellow onion, finely diced\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"ing_5\",\n          \"component\": \"Text\",\n          \"text\": \"• 2 Cloves garlic, minced\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"ing_6\",\n          \"component\": \"Text\",\n          \"text\": \"• 1/2 cup Dry white wine (Sauvignon Blanc or Pinot Grigio)\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"ing_7\",\n          \"component\": \"Text\",\n          \"text\": \"• 3 tbsp Olive oil (divided)\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"ing_8\",\n          \"component\": \"Text\",\n          \"text\": \"• 2 tbsp Vegan butter (cold)\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"ing_9\",\n          \"component\": \"Text\",\n          \"text\": \"• 3 tbsp Nutritional yeast (essential for cheesy flavor)\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"ing_10\",\n          \"component\": \"Text\",\n          \"text\": \"• 1 tbsp Soy sauce or white miso paste (for savory depth)\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"ing_11\",\n          \"component\": \"Text\",\n          \"text\": \"• 1 tbsp Fresh thyme leaves\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"ing_12\",\n          \"component\": \"Text\",\n          \"text\": \"• Salt and black pepper to taste\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"ing_13\",\n          \"component\": \"Text\",\n          \"text\": \"• Fresh parsley for garnish\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"rice_image\",\n          \"component\": \"Image\",\n          \"url\": \"../assets/r_000701_01_2_arborio-rice.jpg\",\n          \"variant\": \"mediumFeature\",\n          \"fit\": \"cover\"\n        },\n        {\n          \"id\": \"divider_2\",\n          \"component\": \"Divider\"\n        },\n        {\n          \"id\": \"phases_section\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"phases_title\",\n            \"phase_1_card\",\n            \"phase_2_card\",\n            \"phase_3_card\",\n            \"phase_4_card\",\n            \"herbs_image\"\n          ]\n        },\n        {\n          \"id\": \"phases_title\",\n          \"component\": \"Text\",\n          \"text\": \"Cooking Phases\",\n          \"variant\": \"h3\"\n        },\n        {\n          \"id\": \"phase_1_card\",\n          \"component\": \"Card\",\n          \"child\": \"phase_1_content\"\n        },\n        {\n          \"id\": \"phase_1_content\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"p1_title\",\n            \"p1_meta\",\n            \"p1_body\",\n            \"p1_btn\"\n          ]\n        },\n        {\n          \"id\": \"p1_title\",\n          \"component\": \"Text\",\n          \"text\": \"Option 1: The Sauté & Toast\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"p1_meta\",\n          \"component\": \"Text\",\n          \"text\": \"Flavor Foundation | High Heat\",\n          \"variant\": \"caption\"\n        },\n        {\n          \"id\": \"p1_body\",\n          \"component\": \"Text\",\n          \"text\": \"Start by sautéing the mushrooms in 1 tbsp olive oil until browned and all liquid has evaporated; set them aside. In the same pot, add remaining oil and onions, cooking until translucent. Add the Arborio rice and toast for 2 minutes until edges are translucent. This toasting step ensures the grains hold their shape.\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"p1_btn\",\n          \"component\": \"Button\",\n          \"child\": \"p1_btn_text\",\n          \"action\": {\n            \"functionCall\": {\n              \"call\": \"openUrl\",\n              \"args\": {\n                \"url\": \"https://www.youtube.com/results?search_query=how+to+toast+risotto+rice\"\n              }\n            }\n          }\n        },\n        {\n          \"id\": \"p1_btn_text\",\n          \"component\": \"Text\",\n          \"text\": \"Watch Toasting Technique\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"phase_2_card\",\n          \"component\": \"Card\",\n          \"child\": \"phase_2_content\"\n        },\n        {\n          \"id\": \"phase_2_content\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"p2_title\",\n            \"p2_meta\",\n            \"p2_body\",\n            \"p2_btn\"\n          ]\n        },\n        {\n          \"id\": \"p2_title\",\n          \"component\": \"Text\",\n          \"text\": \"Option 2: The Slow Simmer\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"p2_meta\",\n          \"component\": \"Text\",\n          \"text\": \"Texture Development | Medium Heat\",\n          \"variant\": \"caption\"\n        },\n        {\n          \"id\": \"p2_body\",\n          \"component\": \"Text\",\n          \"text\": \"Deglaze the pot with white wine and stir until fully absorbed. Begin adding the hot vegetable broth one ladle at a time. Stir almost constantly. Wait until the liquid is nearly absorbed before adding the next ladle. This friction releases the starch required for creaminess. Repeat this process for about 18-20 minutes until rice is al dente.\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"p2_btn\",\n          \"component\": \"Button\",\n          \"child\": \"p2_btn_text\",\n          \"action\": {\n            \"functionCall\": {\n              \"call\": \"openUrl\",\n              \"args\": {\n                \"url\": \"https://www.youtube.com/results?search_query=risotto+stirring+technique\"\n              }\n            }\n          }\n        },\n        {\n          \"id\": \"p2_btn_text\",\n          \"component\": \"Text\",\n          \"text\": \"Risotto Stirring Tips\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"phase_3_card\",\n          \"component\": \"Card\",\n          \"child\": \"phase_3_content\"\n        },\n        {\n          \"id\": \"phase_3_content\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"p3_title\",\n            \"p3_meta\",\n            \"p3_body\",\n            \"p3_btn\"\n          ]\n        },\n        {\n          \"id\": \"p3_title\",\n          \"component\": \"Text\",\n          \"text\": \"Option 3: The Mantecatura\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"p3_meta\",\n          \"component\": \"Text\",\n          \"text\": \"Creamy Finish | Heat Off\",\n          \"variant\": \"caption\"\n        },\n        {\n          \"id\": \"p3_body\",\n          \"component\": \"Text\",\n          \"text\": \"Remove the pot from the heat immediately. This is crucial. Fold the cooked mushrooms back in. Add the cold vegan butter, nutritional yeast, and soy sauce/miso. Stir vigorously (whip it) for 1 minute to emulsify the fats with the starch. This creates the signature creamy wave. Season with salt, pepper, and fresh thyme.\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"p3_btn\",\n          \"component\": \"Button\",\n          \"child\": \"p3_btn_text\",\n          \"action\": {\n            \"functionCall\": {\n              \"call\": \"openUrl\",\n              \"args\": {\n                \"url\": \"https://www.google.com/search?q=best+vegan+butter+for+cooking\"\n              }\n            }\n          }\n        },\n        {\n          \"id\": \"p3_btn_text\",\n          \"component\": \"Text\",\n          \"text\": \"Vegan Butter Options\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"phase_4_card\",\n          \"component\": \"Card\",\n          \"child\": \"phase_4_content\"\n        },\n        {\n          \"id\": \"phase_4_content\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"p4_title\",\n            \"p4_meta\",\n            \"p4_body\",\n            \"p4_btn\"\n       