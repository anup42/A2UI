{"prompt_hash": "45e2ac52a41f2c93126c990ea48c9f0b62385d1d880fa97b5920aef36b3c7f76", "text": "[\n  {\n    \"version\": \"v0.9\",\n    \"createSurface\": {\n      \"surfaceId\": \"main_surface\",\n      \"catalogId\": \"https://genui.local/specification/v0_9/standard_catalog.json\"\n    }\n  },\n  {\n    \"version\": \"v0.9\",\n    \"updateComponents\": {\n      \"surfaceId\": \"main_surface\",\n      \"components\": [\n        {\n          \"id\": \"root\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"text_title\",\n            \"card_group_dynamics\",\n            \"text_top_picks_h3\",\n            \"list_game_options\",\n            \"text_icons_h3\",\n            \"list_icons_table\",\n            \"text_quick_actions_h3\",\n            \"list_quick_actions\",\n            \"text_sources_h3\",\n            \"list_sources\"\n          ]\n        },\n        {\n          \"id\": \"text_title\",\n          \"component\": \"Text\",\n          \"text\": \"Beginner-Friendly 6-Player Game Recommendations\",\n          \"variant\": \"h2\"\n        },\n        {\n          \"id\": \"card_group_dynamics\",\n          \"component\": \"Card\",\n          \"child\": \"col_group_dynamics\"\n        },\n        {\n          \"id\": \"col_group_dynamics\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"text_group_dynamics_h3\",\n            \"text_group_dynamics_p1\"\n          ]\n        },\n        {\n          \"id\": \"text_group_dynamics_h3\",\n          \"component\": \"Text\",\n          \"text\": \"Group Dynamics and Selection Criteria\",\n          \"variant\": \"h3\"\n        },\n        {\n          \"id\": \"text_group_dynamics_p1\",\n          \"component\": \"Text\",\n          \"text\": \"These recommendations assume the group has little to no prior experience with modern hobby board games. The selections focus on high interaction, minimal downtime between turns, and rules that can be taught in under 5 minutes. The games selected bridge the gap between casual conversation and structured play, ensuring the 60-minute time limit is respected even with teaching time included.\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"text_top_picks_h3\",\n          \"component\": \"Text\",\n          \"text\": \"Top Party and Deduction Picks\",\n          \"variant\": \"h3\"\n        },\n        {\n          \"id\": \"list_game_options\",\n          \"component\": \"List\",\n          \"direction\": \"vertical\",\n          \"children\": [\n            \"card_option1\",\n            \"card_option2\",\n            \"card_option3\",\n            \"card_option4\"\n          ]\n        },\n        {\n          \"id\": \"card_option1\",\n          \"component\": \"Card\",\n          \"child\": \"col_option1\"\n        },\n        {\n          \"id\": \"col_option1\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"text_option1_h4\",\n            \"row_option1_details\",\n            \"text_option1_desc\",\n            \"button_option1_bgg\"\n          ]\n        },\n        {\n          \"id\": \"text_option1_h4\",\n          \"component\": \"Text\",\n          \"text\": \"Codenames\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"row_option1_details\",\n          \"component\": \"Row\",\n          \"children\": [\n            \"text_option1_genre\",\n            \"text_option1_category\",\n            \"text_option1_time\"\n          ],\n          \"justify\": \"spaceBetween\"\n        },\n        {\n          \"id\": \"text_option1_genre\",\n          \"component\": \"Text\",\n          \"text\": \"Team-based word association game\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"text_option1_category\",\n          \"component\": \"Text\",\n          \"text\": \"Party\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"text_option1_time\",\n          \"component\": \"Text\",\n          \"text\": \"15 Minutes\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"text_option1_desc\",\n          \"component\": \"Text\",\n          \"text\": \"The group splits into two teams, Red and Blue. Each team has a Spymaster who provides one-word clues linked to multiple cards on the table. The goal is for teammates to guess the correct words based on the clue without picking the opposing team's words or the instant-loss Assassin card. It encourages clever thinking and group discussion.\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"button_option1_bgg\",\n          \"component\": \"Button\",\n          \"child\": \"text_button_option1_bgg\",\n          \"action\": {\n            \"functionCall\": {\n              \"call\": \"openUrl\",\n              \"args\": {\n                \"url\": \"https://boardgamegeek.com/boardgame/178900/codenames\"\n              }\n            }\n          }\n        },\n        {\n          \"id\": \"text_button_option1_bgg\",\n          \"component\": \"Text\",\n          \"text\": \"View on BoardGameGeek\"\n        },\n        {\n          \"id\": \"card_option2\",\n          \"component\": \"Card\",\n          \"child\": \"col_option2\"\n        },\n        {\n          \"id\": \"col_option2\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"text_option2_h4\",\n            \"row_option2_details\",\n            \"text_option2_desc\",\n            \"button_option2_bgg\"\n          ]\n        },\n        {\n          \"id\": \"text_option2_h4\",\n          \"component\": \"Text\",\n          \"text\": \"Just One\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"row_option2_details\",\n          \"component\": \"Row\",\n          \"children\": [\n            \"text_option2_genre\",\n            \"text_option2_category\",\n            \"text_option2_time\"\n          ],\n          \"justify\": \"spaceBetween\"\n        },\n        {\n          \"id\": \"text_option2_genre\",\n          \"component\": \"Text\",\n          \"text\": \"Cooperative guessing game\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"text_option2_category\",\n          \"component\": \"Text\",\n          \"text\": \"Party\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"text_option2_time\",\n          \"component\": \"Text\",\n          \"text\": \"20 Minutes\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"text_option2_desc\",\n          \"component\": \"Text\",\n          \"text\": \"This is a fully cooperative game where everyone wins or loses together. One player is the guesser, and the other five write one-word clues to help them guess a specific word. The catch is that if any two players write the exact same clue, those clues are erased and the guesser never sees them. It forces players to be creative rather than obvious.\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"button_option2_bgg\",\n          \"component\": \"Button\",\n          \"child\": \"text_button_option2_bgg\",\n          \"action\": {\n            \"functionCall\": {\n              \"call\": \"openUrl\",\n              \"args\": {\n                \"url\": \"https://boardgamegeek.com/boardgame/254640/just-one\"\n              }\n            }\n          }\n        },\n        {\n          \"id\": \"text_button_option2_bgg\",\n          \"component\": \"Text\",\n          \"text\": \"View on BoardGameGeek\"\n        },\n        {\n          \"id\": \"card_option3\",\n          \"component\": \"Card\",\n          \"child\": \"col_option3\"\n        },\n        {\n          \"id\": \"col_option3\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"text_option3_h4\",\n            \"row_option3_details\",\n            \"text