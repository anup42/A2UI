nt\": \"Text\",\n          \"text\": \"Arashiyama Area Guide\"\n        },\n        {\n          \"id\": \"day2Card\",\n          \"component\": \"Card\",\n          \"child\": \"day2Column\"\n        },\n        {\n          \"id\": \"day2Column\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"day2Title\",\n            \"day2Image\",\n            \"day2Description\",\n            \"day2Button\"\n          ]\n        },\n        {\n          \"id\": \"day2Title\",\n          \"component\": \"Text\",\n          \"text\": \"Day 2: Iconic Gates & Views | Fushimi Inari Shrine and Kiyomizu-dera | Southern & Eastern Kyoto\",\n          \"variant\": \"h3\"\n        },\n        {\n          \"id\": \"day2Image\",\n          \"component\": \"Image\",\n          \"url\": \"../assets/r_000784_01_4_fushimi_inari_torii.jpg\",\n          \"variant\": \"mediumFeature\"\n        },\n        {\n          \"id\": \"day2Description\",\n          \"component\": \"Text\",\n          \"text\": \"Morning at Fushimi Inari (JR Inari Station is immediately adjacent). The lower loop hike is gentle and features thousands of gates. Afternoon: Take a taxi to Kiyomizu-dera to avoid the steep approach walk.\"\n        },\n        {\n          \"id\": \"day2Button\",\n          \"component\": \"Button\",\n          \"child\": \"day2ButtonText\",\n          \"action\": {\n            \"functionCall\": {\n              \"call\": \"openUrl\",\n              \"args\": {\n                \"url\": \"https://inari.jp/en/map/\"\n              },\n              \"returnType\": \"void\"\n            }\n          }\n        },\n        {\n          \"id\": \"day2ButtonText\",\n          \"component\": \"Text\",\n          \"text\": \"Fushimi Inari Maps\"\n        },\n        {\n          \"id\": \"day3Card\",\n          \"component\": \"Card\",\n          \"child\": \"day3Column\"\n        },\n        {\n          \"id\": \"day3Column\",\n          \"component\": \"Column\",\