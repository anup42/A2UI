n          \"id\": \"day1_stop_text\",\n          \"component\": \"Text\",\n          \"weight\": 1,\n          \"text\": \"Major Scenic Stop: Pigeon Point Lighthouse. This historic 115-foot lighthouse offers a classic coastal California photo opportunity against the cliffs and ocean.\"\n        },\n        {\n          \"id\": \"day1_hike_row\",\n          \"component\": \"Row\",\n          \"align\": \"center\",\n          \"children\": [\n            \"hike_icon_1\",\n            \"day1_hike_text\"\n          ]\n        },\n        {\n          \"id\": \"hike_icon_1\",\n          \"component\": \"Image\",\n          \"variant\": \"icon\",\n          \"url\": \"../assets/r_000036_01_2_house.svg\"\n        },\n        {\n          \"id\": \"day1_hike_text\",\n          \"component\": \"Text\",\n          \"weight\": 1,\n          \"text\": \"Optional Short Hike: Point Lobos State Natural Reserve. The Sea Lion Point Trail (0.6-mile loop) provides dramatic ocean views, access to tide pools, and abundant wildlife photography chances.\"\n        },\n        {\n          \"id\": \"day1_stay_row\",\n          \"component\": \"Row\",\n          \"align\": \"center\",\n          \"children\": [\n            \"stay_icon_1\",\n            \"day1_stay_text\"\n          ]\n        },\n        {\n          \"id\": \"stay_icon_1\",\n          \"component\": \"Image\",\n          \"variant\": \"icon\",\n          \"url\": \"../assets/r_000006_01_5_calendar-event.svg\"\n        },\n        {\n          \"id\": \"day1_stay_text\",\n          \"component\": \"Text\",\n          \"weight\": 1,\n          \"text\": \"Overnight Stay: Carmel-by-the-Sea. A charming town known for its European-style village, art galleries, and beautiful beach.\"\n        },\n        {\n          \"id\": \"day2_card\",\n          \"component\": \"Card\",\n          \"child\": \"day2_col\"\n        },\n        {\n          \"id\": \"day2_col\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"day2_title\",\n            \"day2_driving_time\",\n            \"day2_stop_row\",\n            \"day2_hike_row\",\n            \"day2_stay_row\"\n          ]\n        },\n        {\n          \"id\": \"day2_title\",\n          \"component\": \"Text\",\n          \"variant\": \"h4\",\n          \"text\": \"Day 2: The Heart of Big Sur | Carmel-by-the-Sea to Cambria\"\n        },\n        {\n          \"id\": \"day2_driving_time\",\n          \"component\": \"Text\",\n          \"variant\": \"caption\",\n          \"text\": \"Driving Time: ~2 hours 30 minutes (90 miles)\"\n        },\n        {\n          \"id\": \"day2_stop_row\",\n          \"component\": \"Row\",\n          \"align\": \"center\",\n          \"children\": [\n            \"camera_icon_2\",\n            \"day2_stop_text\"\n          ]\n        },\n        {\n          \"id\": \"camera_icon_2\",\n          \"component\": \"Image\",\n          \"variant\": \"icon\",\n          \"url\": \"../assets/r_000002_01_1_camera.svg\"\n        },\n        {\n          \"id\": \"day2_stop_text\",\n          \"component\": \"Text\",\n          \"weight\": 1,\n          \"text\": \"Major Scenic Stop: Bixby Creek Bridge. The most iconic landmark on Highway 1. Park in the designated pullouts on the north side of the bridge for the best and safest photographic angles.\"\n        },\n        {\n          \"id\": \"day2_hike_row\",\n          \"component\": \"Row\",\n          \"align\": \"center\",\n          \"children\": [\n            \"hike_icon_2\",\n            \"day2_hike_text\"\n          ]\n        },\n        {\n          \"id\": \"hike_icon_2\",\n          \"component\": \"Image\",\n          \"variant\": \"icon\",\n          \"url\": \"../assets/r_000036_01_2_house.svg\"\n        },\n        {\n          \"id\": \"day2_hike_text\",\n          \"component\": \"Text\",\n          \"weight\": 1,\n          \"text\": \"Optional Short Hike: Partington Cove Trail. This 1-mile round-trip hike descends through a 60-foot tunnel to a secluded, rocky cove, offering a unique perspective of the Big Sur coast.\"\n        },\n        {\n          \"id\": \"day2_stay_row\",\n          \"component\": \"Row\",\n          \"align\": \"center\",\n          \"children\": [\n            \"stay_icon_2\",\n            \"day2_stay_text\"\n          ]\n        },\n        {\n          \"id\": \"stay_icon_2\",\n          \"component\": \"Image\",\n          \"variant\": \"icon\",\n          \"url\": \"../assets/r_000006_01_5_calendar-event.svg\"\n        },\n        {\n          \"id\": \"day2_stay_text\",\n          \"component\": \"Text\",\n          \"weight\": 1,\n          \"text\": \"Overnight Stay: Cambria. A quaint coastal village with a relaxed atmosphere, perfect for resting after a day of breathtaking views.\"\n        },\n        {\n          \"id\": \"day3_card\",\n          \"component\": \"Card\",\n          \"child\": \"day3_col\"\n        },\n        {\n          \"id\": \"day3_col\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"day3_title\",\n            \"day3_driving_time\",\n            \"day3_stop_row\",\n            \"day3_hike_row\",\n            \"day3_stay_row\"\n          ]\n        },\n        {\n          \"id\": \"day3_title\",\n          \"component\": \"Text\",\n          \"variant\": \"h4\",\n          \"text\": \"Day 3: The Central Coast Transition | Cambria to Santa Barbara\"\n        },\n        {\n          \"id\": \"day3_driving_time\",\n          \"component\": \"Text\",\n          \"variant\": \"caption\",\n          \"text\": \"Driving Time: ~3 hours (130 miles)\"\n        },\n        {\n          \"id\": \"day3_stop_row\",\n          \"component\": \"Row\",\n          \"align\": \"center\",\n          \"children\": [\n            \"camera_icon_3\",\n            \"day3_stop_text\"\n          ]\n        },\n        {\n          \"id\": \"camera_icon_3\",\n          \"component\": \"Image\",\n          \"var