{"prompt_hash": "2b292b2d3d6a23b7beaad1c3bdabd1b48c8eefa4c8f17ce6e40a9aab2f2e76b9", "text": "[\n  {\n    \"version\": \"v0.9\",\n    \"createSurface\": {\n      \"surfaceId\": \"recipe-surface-1\",\n      \"catalogId\": \"https://genui.local/specification/v0_9/standard_catalog.json\"\n    }\n  },\n  {\n    \"version\": \"v0.9\",\n    \"updateComponents\": {\n      \"surfaceId\": \"recipe-surface-1\",\n      \"components\": [\n        {\n          \"id\": \"root\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"title_text\",\n            \"intro_text\",\n            \"stats_row\",\n            \"main_image_row\",\n            \"divider_1\",\n            \"prep_title\",\n            \"prep_text\",\n            \"divider_2\",\n            \"guide_title\",\n            \"recipe_tabs\",\n            \"divider_3\",\n            \"gallery_title\",\n            \"gallery_row\"\n          ]\n        },\n        {\n          \"id\": \"title_text\",\n          \"component\": \"Text\",\n          \"variant\": \"h1\",\n          \"text\": \"Hearty Lentil Shepherd's Pie with Cauliflower Mash\"\n        },\n        {\n          \"id\": \"intro_text\",\n          \"component\": \"Text\",\n          \"variant\": \"body\",\n          \"text\": \"This recipe provides a complete guide for a comforting, allergy-friendly shepherd's pie. The savory lentil and mushroom filling is topped with a creamy, dairy-free cauliflower mash, creating a dish that is both vegan and gluten-free. It is designed to be prepared and baked in under 90 minutes.\"\n        },\n        {\n          \"id\": \"stats_row\",\n          \"component\": \"Row\",\n          \"justify\": \"spaceAround\",\n          \"children\": [\n            \"time_col\",\n            \"servings_col\",\n            \"diet_col\"\n          ]\n        },\n        {\n          \"id\": \"time_col\",\n          \"component\": \"Column\",\n          \"align\": \"center\",\n          \"children\": [\n            \"time_icon\",\n            \"time_text\"\n          ]\n        },\n        {\n          \"id\": \"time_icon\",\n          \"component\": \"Image\",\n          \"variant\": \"icon\",\n          \"url\": \"../assets/r_000018_01_4_clock.svg\"\n        },\n        {\n          \"id\": \"time_text\",\n          \"component\": \"Text\",\n          \"text\": \"Total Time: 80 min\"\n        },\n        {\n          \"id\": \"servings_col\",\n          \"component\": \"Column\",\n          \"align\": \"center\",\n          \"children\": [\n            \"servings_icon\",\n            \"servings_text\"\n          ]\n        },\n        {\n          \"id\": \"servings_icon\",\n          \"component\": \"Image\",\n          \"variant\": \"icon\",\n          \"url\": \"../assets/r_000018_01_5_people.svg\"\n        },\n        {\n          \"id\": \"servings_text\",\n          \"component\": \"Text\",\n          \"text\": \"Servings: 6\"\n        },\n        {\n          \"id\": \"diet_col\",\n          \"component\": \"Column\",\n          \"align\": \"center\",\n          \"children\": [\n            \"diet_icon\",\n            \"diet_text\"\n          ]\n        },\n        {\n          \"id\": \"diet_icon\",\n          \"component\": \"Image\",\n          \"variant\": \"icon\",\n          \"url\": \"../assets/r_000018_01_6_tree.svg\"\n        },\n        {\n          \"id\": \"diet_text\",\n          \"component\": \"Text\",\n          \"text\": \"Vegan & Gluten-Free\"\n        },\n        {\n          \"id\": \"main_image_row\",\n          \"component\": \"Row\",\n          \"justify\": \"spaceEvenly\",\n          \"children\": [\n            \"main_image_1\",\n            \"main_image_2\"\n          ]\n        },\n        {\n          \"id\": \"main_image_1\",\n          \"component\": \"Image\",\n          \"url\": \"../assets/r_000018_01_1_shepherds-pie_vegan.jpg\",\n          \"variant\": \"mediumFeature\",\n          \"fit\": \"cover\",\n          \"weight\": 1\n        },\n        {\n          \"id\": \"main_image_2\",\n          \"component\": \"Image\",\n          \"url\": \"../assets/r_000018_01_2_vegan-casserole.jpg\",\n          \"variant\": \"mediumFeature\",\n          \"fit\": \"cover\",\n          \"weight\": 1\n        },\n        {\n          \"id\": \"divider_1\",\n          \"component\": \"Divider\"\n        },\n        {\n          \"id\": \"prep_title\",\n          \"component\": \"Text\",\n          \"variant\": \"h2\",\n          \"text\": \"Recipe Notes and Kitchen Prep\"\n        },\n        {\n          \"id\": \"prep_text\",\n          \"component\": \"Text\",\n          \"text\": \"This recipe assumes you have common pantry staples such as salt, black pepper, and cooking oil. For the best texture, use brown or green lentils, as red lentils can become too mushy. Ensure your vegetable broth and coconut aminos are certified gluten-free to meet the dietary requirements. A 9x13 inch (23x33 cm) baking dish or a similar 3-quart casserole dish is ideal for this recipe.\"\n        },\n        {\n          \"id\": \"divider_2\",\n          \"component\": \"Divider\"\n        },\n        {\n          \"id\": \"guide_title\",\n          \"component\": \"Text\",\n          \"variant\": \"h2\",\n          \"text\": \"Step-by-Step Cooking Guide\"\n        },\n        {\n          \"id\": \"recipe_tabs\",\n          \"component\": \"Tabs\",\n          \"tabs\": [\n            {\n              \"title\": \"Ingredients\",\n              \"child\": \"ingredients_col\"\n            },\n            {\n              \"title\": \"Instructions\",\n              \"child\": \"instructions_list\"\n            }\n          ]\n        },\n        {\n          \"id\": \"ingredients_col\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"cauli_title\",\n            \"cauli_list\",\n            \"lentil_title\",\n            \"lentil_list\"\n          ]\n        },\n        {\n          \"id\": \"cauli_title\",\n          \"component\": \"Text\",\n          \"variant\": \"h3\",\n          \"text\": \"INGREDIENTS FOR CAULIFLOWER TOPPING\"\n        },\n        {\n          \"id\": \"cauli_list\",\n          \"component\": \"List\",\n          \"direction\": \"vertical\",\n          \"children\": [\n            \"cauli_item_1\",\n            \"cauli_item_2\",\n            \"cauli_item_3\",\n            \"cauli_item_4\",\n            \"cauli_item_5\",\n            \"cauli_item_6\",\n            \"cauli_item_7\"\n          ]\n        },\n        {\n          \"id\": \"cauli_item_1\",\n          \"component\": \"Text\",\n          \"text\": \"- Cauliflower: 1 large head (approx. 1000g / 2.2 lbs), cut into florets\"\n        },\n        {\n          \"id\": \"cauli_item_2\",\n          \"component\": \"Text\",\n          \"text\": \"- Full-Fat Canned Coconut Milk: 120 ml / 1/2 cup\"\n        },\n        {\n          \"id\": \"cauli_item_3\",\n          \"component\": \"Text\",\n          \"text\": \"- Nutritional Yeast: 25g / 1/4 cup\"\n        },\n        {\n          \"id\": \"cauli_item_4\",\n          \"component\": \"Text\",\n          \"text\": \"- Minced Garlic: 2 cloves\"\n        },\n        {\n          \"id\": \"cauli_item_5\",\n          \"component\": \"Text\",\n          \"text\": \"- Olive Oil: 30 ml / 2 tbsp\"\n        },\n        {\n          \"id\": \"cauli_item_6\",\n          \"component\": \"Text\",\n          \"text\": \"- Salt: 1 tsp, or to taste\"\n        },\n        {\n          \"id\": \"cauli_item_7\",\n          \"component\": \"Text\",\n          \"text\": \"- Black Pepper: 1/2 tsp, or to taste\"\n        },\n        {\n          \"id\": \"lentil_title\",\n          \"component\": \"Text\",\n          \"variant\": \"h3\",\n          \"text\": \"INGREDIENTS FOR LENTIL FILLING\"\n        },\n        {\n          \"id\": \"lentil_list\",\n          \"component\": \"List\",\n          \"direction\": \"vertical\",\n          \"children\": [\n            \"lentil_item_1\",\n            \"lentil_item_2\",\n            \"lentil_item_3\",\n            \"lentil_item_4\",\n            \"lentil_item_5\",\n            \"lentil_item_6\",\n            \"lentil_item_7\",\n            \"lentil_item_8\",\n            \"lentil_item_9\",\n            \"lentil_item_10\",\n            \"lentil_item_11\",\n            \"lentil_item_12\",\n            \"lentil_item_13\",\n            \"lentil_item_14\"\n          ]\n        },\n        {\n          \"id\": \"lentil_item_1\",\n          \"component\": \"Text\",\n          \"text\": \"- Olive Oil: 30 ml / 2 tbsp\"\n        },\n        {\n          \"id\": \"lentil_item_2\",\n          \"component\": \"Text\",\n          \"text\": \"- Yellow Onion: 1 large (approx. 220g), finely chopped\"\n        },\n        {\n          \"id\": \"lentil_item_3\",\n          \"component\": \"Text\",\n          \"text\": \"- Carrots: 2 medium (approx. 200g), diced\"\n        },\n        {\n          \"id\": \"lentil_item_4\",\n          \"component\": \"Text\",\n          \"text\": \"- Cremini Mushrooms: 225g / 8 oz, chopped\"\n        },\n        {\n          \"id\": \"lentil_item_5\",\n          \"component\": \"Text\",\n          \"text\": \"- Minced Garlic: 3 cloves\"\n        },\n        {\n          \"id\": \"lentil_item_6\",\n          \"component\": \"Text\",\n          \"text\": \"- Dry Brown or Green Lentils: 200g / 1 cup, rinsed\"\n        },\n        {\n          \"id\": \"lentil_item_7\",\n          \"component\": \"Text\",\n          \"text\": \"- Gluten-Free Vegetable Broth: 720 ml / 3 cups\"\n        },\n        {\n          \"id\": \"lentil_item_8\",\n          \"component\": \"Text\",\n          \"text\": \"- Tomato Paste: 30g / 2 tbsp\"\n        },\n        {\n          \"id\": \"lentil_item_9\",\n          \"component\": \"Text\",\n          \"text\": \"- Dried Thyme: 1 tsp\"\n        },\n        {\n          \"id\": \"lentil_item_10\",\n          \"component\": \"Text\",\n          \"text\": \"- Dried Rosemary: 1 tsp, crushed\"\n        },\n        {\n          \"id\": \"lentil_item_11\",\n          \"component\": \"Text\",\n          \"text\": \"- Smoked Paprika: 1/2 tsp\"\n        },\n        {\n          \"id\": \"lentil_item_12\",\n          \"component\": \"Text\",\n          \"text\": \"- Coconut Aminos: 30 ml / 2 tbsp (ensure soy-free)\"\n        },\n        {\n          \"id\": \"lentil_item_13\",\n          \"component\": \"Text\",\n          \"text\": \"- Frozen Peas: 150g / 1 cup\"\n        },\n        {\n          \"id\": \"lentil_item_14\",\n          \"component\": \"Text\",\n          \"text\": \"- Cornstarch (or Arrowroot Powder): 2 tbsp, mixed with 4 tbsp cold water to make a slurry\"\n        },\n        {\n          \"id\": \"instructions_list\",\n          \"component\": \"List\",\n          \"direction\": \"vertical\",\n          \"children\": [\n            \"step_1_card\",\n            \"step_2_card\",\n            \"step_3_card\",\n            \"step_4_card\",\n            \"step_5_card\",\n            \"step_6_card\",\n            \"step_7_card\"\n          ]\n        },\n        {\n          \"id\": \"step_1_card\",\n          \"component\": \"Card\",\n          \"child\": \"step_1_col\"\n        },\n        {\n          \"id\": \"step_1_col\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"step_1_title\",\n            \"step_1_text\"\n          ]\n        },\n        {\n          \"id\": \"step_1_title\",\n          \"component\": \"Text\",\n          \"variant\": \"h4\",\n          \"text\": \"1. Prepare the Cauliflower Topping\"\n        },\n        {\n          \"id\": \"step_1_text\",\n          \"component\": \"Text\",\n          \"text\": \"Place the cauliflower florets in a large pot and cover with water. Bring to a boil and cook for 10-15 minutes, or until fork-tender. Drain very well. Transfer the drained cauliflower to a food processor or use an immersion blender. Add the coconut milk, nutritional yeast, minced garlic, olive oil, salt, and pepper. Blend until completely smooth and creamy. Set aside.\"\n        },\n        {\n          \"id\": \"step_2_card\",\n          \"component\": \"Card\",\n          \"child\": \"step_2_col\"\n        },\n        {\n          \"id\": \"step_2_col\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"step_2_title\",\n            \"step_2_text\"\n          ]\n        },\n        {\n          \"id\": \"step_2_title\",\n          \"component\": \"Text\",\n          \"variant\": \"h4\",\n          \"text\": \"2. Preheat Oven and Sauté Vegetables\"\n        },\n        {\n          \"id\": \"step_2_text\",\n          \"component\": \"Text\",\n          \"text\": \"Preheat your oven to 400°F (200°C). In a large pot or Dutch oven, heat 2 tbsp of olive oil over medium-high heat. Add the chopped onion and carrots, cooking for 5-7 minutes until softened. Add the chopped mushrooms and cook for another 5-7 minutes, until they have released their liquid and started to brown. Stir in the 3 cloves of minced garlic and cook for one minute more until fragrant.\"\n        },\n        {\n          \"id\": \"step_3_card\",\n          \"component\": \"Card\",\n          \"child\": \"step_3_col\"\n        },\n        {\n          \"id\": \"step_3_col\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"step_3_title\",\n            \"step_3_text\"\n          ]\n        },\n        {\n          \"id\": \"step_3_title\",\n          \"component\": \"Text\",\n          \"variant\": \"h4\",\n          \"text\": \"3. Cook the Lentil Filling\"\n        },\n        {\n          \"id\": \"step_3_text\",\n          \"component\": \"Text\",\n          \"text\": \"Stir the tomato paste, dried thyme, rosemary, and smoked paprika into the vegetable mixture. Cook for 1 minute. Add the rinsed lentils and the vegetable broth. Bring to a boil, then reduce the heat to a simmer. Cover and cook for 20-25 minutes, or until the lentils are tender but not mushy.\"\n        },\n        {\n          \"id\": \"step_4_card\",\n          \"component\": \"Card\",\n          \"child\": \"step_4_col\"\n        },\n        {\n          \"id\": \"step_4_col\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"step_4_title\",\n            \"step_4_text\"\n          ]\n        },\n        {\n          \"id\": \"step_4_title\",\n          \"component\": \"Text\",\n          \"variant\": \"h4\",\n          \"text\": \"4. Thicken and Finish the Filling\"\n        },\n        {\n          \"id\": \"step_4_text\",\n          \"component\": \"Text\",\n          \"text\": \"Stir in the coconut aminos. Slowly pour in the cornstarch slurry while stirring constantly. Continue to simmer for 1-2 minutes until the gravy has thickened. Remove from heat and stir in the frozen peas. Season with additional salt and pepper to taste.\"\n        },\n        {\n          \"id\": \"step_5_card\",\n          \"component\": \"Card\",\n          \"child\": \"step_5_col\"\n        },\n        {\n          \"id\": \"step_5_col\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"step_5_title\",\n            \"step_5_text\"\n          ]\n        },\n        {\n          \"id\": \"step_5_title\",\n          \"component\": \"Text\",\n          \"variant\": \"h4\",\n          \"text\": \"5. Assemble and Bake the Pie\"\n        },\n        {\n          \"id\": \"step_5_text\",\n          \"component\": \"Text\",\n          \"text\": \"Pour the lentil filling into your baking dish and spread it into an even layer. Spoon the mashed cauliflower topping over the filling, using a spatula to spread it evenly to the edges. You can use a fork to create a textured pattern on top.\"\n        },\n        {\n          \"id\": \"step_6_card\",\n          \"component\": \"Card\",\n          \"child\": \"step_6_col\"\n        },\n        {\n          \"id\": \"step_6_col\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"step_6_title\",\n            \"step_6_text\"\n          ]\n        },\n        {\n          \"id\": \"step_6_title\",\n          \"component\": \"Text\",\n          \"variant\": \"h4\",\n          \"text\": \"6. Bake\"\n        },\n        {\n          \"id\": \"step_6_text\",\n          \"component\": \"Text\",\n          \"text\": \"Place the dish on a baking sheet to catch any potential drips. Bake for 20-25 minutes, until the filling is bubbly and the cauliflower topping is lightly golden on top. For extra browning, you can place it under the broiler for 1-2 minutes at the end, watching carefully to prevent burning.\"\n        },\n        {\n          \"id\": \"step_7_card\",\n          \"component\": \"Card\",\n          \"child\": \"step_7_col\"\n        },\n        {\n          \"id\": \"step_7_col\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"step_7_title\",\n            \"step_7_text\"\n          ]\n        },\n        {\n          \"id\": \"step_7_title\",\n          \"component\": \"Text\",\n          \"variant\": \"h4\",\n          \"text\": \"7. Rest and Serve\"\n        },\n        {\n          \"id\": \"step_7_text\",\n          \"component\": \"Text\",\n          \"text\": \"Remove the shepherd's pie from the oven and let it rest for at least 10 minutes before serving. This allows the filling to set.\"\n        },\n        {\n          \"id\": \"divider_3\",\n          \"component\": \"Divider\"\n        },\n        {\n          \"id\": \"gallery_title\",\n          \"component\": \"Text\",\n          \"variant\": \"h2\",\n          \"text\": \"Images\"\n        },\n        {\n          \"id\": \"gallery_row\",\n          \"component\": \"Row\",\n          \"justify\": \"spaceEvenly\",\n          \"children\": [\n            \"gallery_image_1\",\n            \"gallery_image_2\",\n            \"gallery