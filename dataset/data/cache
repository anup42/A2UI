{"prompt_hash": "ef8261e94dbbd41deee0ece60b0a11481dffdcd44cdab402ac32a6857f204ec5", "text": "[\n  {\n    \"version\": \"v0.9\",\n    \"createSurface\": {\n      \"surfaceId\": \"sat-math-plan-surface\",\n      \"catalogId\": \"https://genui.local/specification/v0_9/standard_catalog.json\"\n    }\n  },\n  {\n    \"version\": \"v0.9\",\n    \"updateComponents\": {\n      \"surfaceId\": \"sat-math-plan-surface\",\n      \"components\": [\n        {\n          \"id\": \"root\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"header-title\",\n            \"intro-text\",\n            \"divider-1\",\n            \"domains-title\",\n            \"domains-list\",\n            \"divider-2\",\n            \"schedule-title\",\n            \"schedule-table\",\n            \"divider-3\",\n            \"tips-title\",\n            \"tips-text\",\n            \"divider-4\",\n            \"resources-title\",\n            \"resources-row\",\n            \"divider-5\",\n            \"actions-title\",\n            \"actions-list\"\n          ]\n        },\n        {\n          \"id\": \"header-title\",\n          \"component\": \"Text\",\n          \"text\": \"SAT Math 4-Week Study Plan Overview\",\n          \"variant\": \"h2\"\n        },\n        {\n          \"id\": \"intro-text\",\n          \"component\": \"Text\",\n          \"text\": \"This plan covers the four SAT Math domains—Algebra (linear equations, systems, inequalities), Problem Solving and Data Analysis (ratios, percentages, statistics, probability), and Passport to Advanced Math (quadratics, polynomials, exponents)—with 1 hour weekdays (5 days/week) for targeted lessons and practice, plus 3 hours Saturdays for deeper review and full sections. Total: 23 hours/week, building from foundations to advanced mastery using official topics.\"\n        },\n        {\n          \"id\": \"divider-1\",\n          \"component\": \"Divider\"\n        },\n        {\n          \"id\": \"domains-title\",\n