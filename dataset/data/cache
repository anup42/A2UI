{"prompt_hash": "dfe41ab3cef0397b6116bb6b03b23e15691d7ed90ce04406bab432980ad9c078", "text": "[\n  {\n    \"version\": \"v0.9\",\n    \"createSurface\": {\n      \"surfaceId\": \"bankruptcy_comparison_surface\",\n      \"catalogId\": \"https://genui.local/specification/v0_9/standard_catalog.json\"\n    }\n  },\n  {\n    \"version\": \"v0.9\",\n    \"updateComponents\": {\n      \"surfaceId\": \"bankruptcy_comparison_surface\",\n      \"components\": [\n        {\n          \"id\": \"root\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"txt_summary_title\",\n            \"txt_summary_body\",\n            \"txt_assumptions\",\n            \"div_1\",\n            \"txt_table_title\",\n            \"col_table\",\n            \"div_2\",\n            \"txt_details_title\",\n            \"col_details\",\n            \"div_3\",\n            \"row_actions\",\n            \"txt_sources\"\n          ]\n        },\n        {\n          \"id\": \"txt_summary_title\",\n          \"component\": \"Text\",\n          \"text\": \"Summary\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"txt_summary_body\",\n          \"component\": \"Text\",\n          \"text\": \"Chapter 7 and Chapter 13 are the most common forms of personal bankruptcy in the U.S. Chapter 7 is a liquidation process designed to wipe out unsecured debts quickly, while Chapter 13 is a reorganization plan for individuals with regular income to pay back all or part of their debts over time.\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"txt_assumptions\",\n          \"component\": \"Text\",\n          \"text\": \"Assumptions: This overview assumes federal bankruptcy laws apply; state-specific exemptions for property may vary.\",\n          \"variant\": \"caption\"\n        },\n        {\n          \"id\": \"div_1\",\n          \"component\": \"Divider\"\n        },\n        {\n          \"id\": \"txt_table_title\",\n          \"