,\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"context_section\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"context_title\",\n            \"context_list\"\n          ]\n        },\n        {\n          \"id\": \"context_title\",\n          \"component\": \"Text\",\n          \"text\": \"Context and Assumptions\",\n          \"variant\": \"h2\"\n        },\n        {\n          \"id\": \"context_list\",\n          \"component\": \"List\",\n          \"direction\": \"vertical\",\n          \"children\": [\n            \"ctx_1\",\n            \"ctx_2\",\n            \"ctx_3\",\n            \"ctx_4\",\n            \"ctx_5\",\n            \"ctx_6\"\n          ]\n        },\n        {\n          \"id\": \"ctx_1\",\n          \"component\": \"Text\",\n          \"text\": \"• Family staying in a central location (Shinjuku, Shibuya, or Ueno recommended).\"\n        },\n        {\n          \"id\": \"ctx_2\",\n          \"component\": \"Text\",\n          \"text\": \"• Children comfortable with 2-3 hours of walking daily with rest breaks.\"\n        },\n        {\n          \"id\": \"ctx_3\",\n          \"component\": \"Text\",\n          \"text\": \"• Willingness to book popular attractions 1-2 weeks in advance.\"\n        },\n        {\n          \"id\": \"ctx_4\",\n          \"component\": \"Text\",\n          \"text\": \"• Use of Suica/Pasmo cards for transit efficiency.\"\n        },\n        {\n          \"id\": \"ctx_5\",\n          \"component\": \"Text\",\n          \"text\": \"• Early June weather: warm (75-80°F), possible rain; plan indoor activities accordingly.\"\n        },\n        {\n          \"id\": \"ctx_6\",\n          \"component\": \"Text\",\n          \"text\": \"• Budget includes meals at casual/mid-range restaurants, not fine dining.\"\n        },\n        {\n          \"id\": \"itinerary_section\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"itinerary_title\",\n            \"days_tabs\"\n          ]\n        },\n        {\n          \"id\": \"itinerary_title\",\n          \"component\": \"Text\",\n          \"text\": \"Day-by-Day Itinerary\",\n          \"variant\": \"h2\"\n        },\n        {\n          \"id\": \"days_tabs\",\n          \"component\": \"Tabs\",\n          \"tabs\": [\n            {\n              \"title\": \"Day 1\",\n              \"child\": \"day1_content\"\n            },\n            {\n              \"title\": \"Day 2\",\n              \"child\": \"day2_content\"\n            },\n            {\n              \"title\": \"Day 3\",\n              \"child\": \"day3_content\"\n            },\n            {\n              \"title\": \"Day 4\",\n              \"child\": \"day4_content\"\n            },\n            {\n              \"title\": \"Day 5\",\n              \"child\": \"day5_content\"\n            }\n          ]\n        },\n        {\n          \"id\": \"day1_content\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"d1_header\",\n            \"d1_morning_title\",\n            \"d1_morning_text\",\n            \"d1_afternoon_title\",\n            \"d1_afternoon_text\",\n            \"d1_evening_title\",\n            \"d1_evening_text\",\n            \"d1_divider\",\n            \"d1_stats\"\n          ]\n        },\n        {\n          \"id\": \"d1_header\",\n          \"component\": \"Text\",\n          \"text\": \"Modern Tokyo & Anime Culture (Harajuku, Shibuya, Omotesando)\",\n          \"variant\": \"h3\"\n        },\n        {\n          \"id\": \"d1_morning_title\",\n          \"component\": \"Text\",\n          \"text\": \"Morning (8:00 AM - 12:00 PM)\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"d1_morning_text\",\n          \"component\": \"Text\",\n          \"text\": \"Start at Yoyogi Park near Harajuku station. Walk through the park to reach Meiji Jingu Shrine, where children can participate in the water purification ritual. The shrine grounds are peaceful and suitable for families. Grab coffee at a nearby cafe.\"\n        },\n        {\n          \"id\": \"d1_afternoon_title\",\n          \"component\": \"Text\",\n          \"text\": \"Afternoon (1:00 PM - 5:00 PM)\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"d1_afternoon_text\",\n          \"component\": \"Text\",\n          \"text\": \"Head to Takeshita Street in Harajuku, famous for youth culture and anime-related shops. Children aged 8-10 typically enjoy browsing anime merchandise, character goods, and quirky fashion stores. For lunch, cook okonomiyaki (Japanese savory pancakes) together at Sakura-tei, which offers an interactive dining experience. Reserve ahead.\"\n        },\n        {\n          \"id\": \"d1_evening_title\",\n          \"component\": \"Text\",\n          \"text\": \"Late Afternoon/Evening (5:00 PM - 8:30 PM)\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"d1_evening_text\",\n          \"component\": \"Text\",\n          \"text\": \"Explore Omotesando's upscale shopping district and visit Tokyu Plaza to see the famous mirrored escalator. End the day at Nezu Museum in Aoyama, open until 5 PM. For dinner, book tonkatsu at Butagumi or choose casual ramen nearby.\"\n        },\n        {\n          \"id\": \"d1_divider\",\n          \"component\": \"Divider\"\n        },\n        {\n          \"id\": \"d1_stats\",\n          \"component\": \"Text\",\n          \"text\": \"Estimated Cost: USD 280-350 | Neighborhood: Harajuku, Shibuya, Aoyama\",\n          \"variant\": \"caption\"\n        },\n        {\n          \"id\": \"day2_content\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"d2_header\",\n            \"d2_morning_title\",\n            \"d2_morning_text\",\n            \"d2_lunch_title\",\n            \"d2_lunch_text\",\n            \"d2_afternoon_title\",\n            \"d2_afternoon_text\",\n            \"d2_evening_title\",\n            \"d2_evening_text\",\n            \"d2_divider\",\n            \"d2_stats\"\n          ]\n        },\n        {\n          \"id\": \"d2_header\",\n          \"component\": \"Text\",\n          \"text\": \"Technology & Interactive Art (Odaiba, Ginza)\",\n          \"variant\": \"h3\"\n        },\n        {\n          \"id\": \"d2_morning_title\",\n          \"component\": \"Text\",\n          \"text\": \"Morning (8:00 AM - 12:00 PM)\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"d2_morning_text\",\n          \"component\": \"Text\",\n          \"text\": \"Take the train to Odaiba. Visit teamLab Planets, an immersive digital art installation specifically designed for interactive engagement. Children can walk through light-based exhibits, digital gardens, and interactive installations. Book tickets in advance online.\"\n        },\n        {\n          \"id\": \"d2_lunch_title\",\n          \"component\": \"Text\",\n          \"text\": \"Lunch (12:30 PM - 1:30 PM)\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"d2_lunch_text\",\n          \"component\": \"Text\",\n          \"text\": \"Eat at Odaiba's waterfront dining area or nearby malls.\"\n        },\n        {\n          \"id\": \"d2_afternoon_title\",\n          \"component\": \"Text\",\n          \"text\": \"Afternoon (2:00 PM - 5:00 PM)\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"d2_afternoon_text\",\n          \"component\": \"Text\",\n          \"text\": \"Visit Miraikan (National Museum of Science and Innovation), featuring hands-on exhibits, robotics demonstrations, and interactive technology displays. Children can explore space exhibits, digital technology zones, and engineering concepts.\"\n        },\n        {\n          \"id\": \"d2_evening_title\",\n          \"component\": \"Text\",\n          \"text\": \"Evening (5:30 PM - 8:30 PM)\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"d2_evening_text\",\n          \"component\": \"Text\",\n          \"text\": \"Return to Ginza for dinner. Browse Ginza's shopping streets or visit the Ginza district's casual dining options. If energy permits, explore anime/manga shops in nearby Akihabara.\"\n        },\n        {\n          \"id\": \"d2_divider\",\n          \"component\": \"Divider\"\n        },\n        {\n          \"id\": \"d2_stats\",\n          \"component\": \"Text\",\n          \"text\": \"Estimated Cost: USD 300-400 | Neighborhood: Odaiba, Ginza, Akihabara\",\n          \"variant\": \"caption\"\n        },\n        {\n          \"id\": \"day3_content\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"d3_header\",\n            \"d3_morning_title\",\n            \"d3_morning_text\",\n            \"d3_lunch_title\",\n            \"d3_lunch_text\",\n            \"d3_afternoon_title\",\n            \"d3_afternoon_text\",\n            \"d3_evening_title\",\n            \"d3_evening_text\",\n            \"d3_divider\",\n            \"d3_stats\"\n          ]\n        },\n        {\n          \"id\": \"d3_header\",\n          \"component\": \"Text\",\n          \"text\": \"Aquariums & Cultural Museums (Asakusa, Ueno)\",\n          \"variant\": \"h3\"\n        },\n        {\n          \"id\": \"d3_morning_title\",\n          \"component\": \"Text\",\n          \"text\": \"Morning (8:00 AM - 12:00 PM)\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"d3_morning_text\",\n          \"component\": \"Text\",\n          \"text\": \"Visit Sumida Aquarium at Tokyo Skytree. This aquarium is highly recommended for families with children; it features beautiful displays, intimate exhibits, and a stunning goldfish collection.\"\n        },\n        {\n          \"id\": \"d3_lunch_title\",\n          \"component\": \"Text\",\n          \"text\": \"Lunch (12:30 PM - 1:30 PM)\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"d3_lunch_text\",\n          \"component\": \"Text\",\n          \"text\": \"Explore Asakusa neighborhood near Sumida Aquarium. Visit the famous Senso-ji Temple. Try local eats including sweet potato desserts at Imo Pippi or ramen shops in the area.\"\n        },\n        {\n          \"id\": \"d3_afternoon_title\",\n          \"component\": \"Text\",\n          \"text\": \"Afternoon (2:00 PM - 5:00 PM)\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"d3_afternoon_text\",\n          \"component\": \"Text\",\n          \"text\": \"Head to Ueno Park and visit either the Tokyo National Museum or the National Museum of Nature & Science. Both feature exhibits engaging for school-age children. Ueno Zoo is also nearby.\"\n        },\n        {\n          \"id\": \"d3_evening_title\",\n          \"component\": \"Text\",\n          \"text\": \"Evening (5:30 PM - 8:30 PM)\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"d3_evening_text\",\n          \"component\": \"Text\",\n          \"text\": \"Rest at hotel or explore Ueno's casual dining. Consider a light dinner near the park.\"\n        },\n        {\n          \"id\": \"d3_divider\",\n          \"component\": \"Divider\"\n        },\n        {\n          \"id\": \"d3_stats\",\n          \"component\": \"Text\",\n          \"text\": \"Estimated Cost: USD 250-320 | Neighborhood: Asakusa, Ueno\",\n          \"variant\": \"caption\"\n        },\n        {\n          \"id\": \"day4_content\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"d4_header\",\n            \"d4_morning_title\",\n            \"d4_morning_text\",\n            \"d4_lunch_title\",\n            \"d4_lunch_text\",\n            \"d4_afternoon_title\",\n            \"d4_afternoon_text\",\n            \"d4_evening_title\",\n            \"d4_evening_text\",\n            \"d4_divider\",\n            \"d4_stats\"\n          ]\n        },\n        {\n          \"id\": \"d4_header\",\n          \"component\": \"Text\",\n          \"text\": \"Anime & Gaming District (Akihabara, Shinjuku)\",\n          \"variant\": \"h3\"\n        },\n        {\n          \"id\": \"d4_morning_title\",\n          \"component\": \"Text\",\n          \"text\": \"Morning (8:00 AM - 12:00 PM)\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"d4_morning_text\",\n          \"component\": \"Text\",\n          \"text\": \"Spend the morning in Akihabara, Tokyo's anime, manga, and gaming hub. Visit multi-story anime shops (Animate, Mandarake), gaming arcades, and character goods stores. Budget time for arcade games.\"\n        },\n        {\n          \"id\": \"d4_lunch_title\",\n          \"component\": \"Text\",\n          \"text\": \"Lunch (12:30 PM - 1:30 PM)\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"d4_lunch_text\",\n          \"component\": \"Text\",\n          \"text\": \"Eat at casual ramen shops, conveyor-belt sushi, or themed cafes in Akihabara.\"\n        },\n        {\n          \"id\": \"d4_afternoon_title\",\n          \"component\": \"Text\",\n          \"text\": \"Afternoon (2:00 PM - 5:00 PM)\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"d4_afternoon_text\",\n          \"component\": \"Text\",\n          \"text\": \"Travel to Shinjuku. Visit the Imperial Palace East Garden or take a leisurely walk through Shinjuku's parks. Alternatively, explore Shinjuku's shopping districts.\"\n        },\n        {\n          \"id\": \"d4_evening_title\",\n          \"component\": \"Text\",\n          \"text\": \"Evening (5:30 PM - 8:30 PM)\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"d4_evening_text\",\n          \"component\": \"Text\",\n          \"text\": \"Enjoy dinner in Shinjuku. The district has numerous family-friendly restaurants ranging from casual to mid-range.\"\n        },\n        {\n          \"id\": \"d4_divider\",\n          \"component\": \"Divider\"\n        },\n        {\n          \"id\": \"d4_stats\",\n          \"component\": \"Text\",\n          \"text\": \"Estimated Cost: USD 280-350 | Neighborhood: Akihabara, Shinjuku\",\n          \"variant\": \"caption\"\n        },\n        {\n          \"id\": \"day5_content\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"d5_header\",\n            \"d5_morning_title\",\n            \"d5_morning_text\",\n            \"d5_afternoon_title\",\n            \"d5_afternoon_text\",\n            \"d5_evening_title\",\n            \"d5_evening_text\",\n            \"d5_divider\",\n            \"d5_stats\"\n          ]\n        },\n        {\n          \"id\": \"d5_header\",\n          \"component\": \"Text\",\n          \"text\": \"Fish Market & Cultural Sites (Tsukiji, Imperial Palace)\",\n          \"variant\": \"h3\"\n        },\n        {\n          \"id\": \"d5_morning_title\",\n          \"component\": \"Text\",\n          \"text\": \"Morning (7:00 AM - 11:00 AM)\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"d5_morning_text\",\n          \"component\": \"Text\",\n          \"text\": \"Rise early to visit Tsukiji Outer Market. Experience the bustling fish market, sample fresh sushi breakfast at Sushizanmai or market stalls, and browse food and cookware shops.\"\n        },\n        {\n          \"id\": \"d5_afternoon_title\",\n          \"component\": \"Text\",\n          \"text\": \"Late Morning/Afternoon (11:30 AM - 4:00 PM)\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"d5_afternoon_text\",\n          \"component\": \"Text\",\n          \"text\": \"Visit the Imperial Palace East Garden, which offers peaceful walks and traditional architecture. Alternatively, visit the Edo-Tokyo Museum for interactive history exhibits.\"\n        },\n        {\n          \"id\": \"d5_evening_title\",\n          \"component\": \"Text\",\n          \"text\": \"Evening (6:30 PM onwards)\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"d5_evening_text\",\n          \"component\": \"Text\",\n          \"text\": \"Dinner near your hotel or at a favorite restaurant from earlier in the trip. Prepare for departure.\"\n        },\n        {\n          \"id\": \"d5_divider\",\n          \"component\": \"Divider\"\n        },\n        {\n          \"id\": \"d5_stats\",\n          \"component\": \"Text\",\n          \"text\": \"Estimated Cost: USD 220-300 | Neighborhood: Tsukiji, Imperial Palace, Ginza\",\n          \"variant\": \"caption\"\n        },\n        {\n          \"id\": \"cost_section\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"cost_title\",\n            \"cost_table\"\n          ]\n        },\n        {\n          \"id\": \"cost_title\",\n          \"component\": \"Text\",\n          \"text\": \"Cost Summary (Family of 4)\",\n          \"variant\": \"h2\"\n        },\n        {\n          \"id\": \"cost_table\",\n          \"component\": \"List\",\n          \"direction\": \"vertical\",\n          \"children\": [\n            \"cost_row_1\",\n            \"cost_row_2\",\n            \"cost_row_3\",\n            \"cost_row_4\",\n            \"cost_row_5\",\n            \"cost_row_total\"\n          ]\n        },\n        {\n          \"id\": \"cost_row_1\",\n          \"component\": \"Row\",\n          \"justify\": \"spaceBetween\",\n          \"children\": [\n            \"cr1_day\",\n            \"cr1_cost\"\n          ]\n        },\n        {\n          \"id\": \"cr1_day\",\n          \"component\": \"Text\",\n          \"text\": \"Day 1 (Modern Tokyo)\"\n        },\n        {\n          \"id\": \"cr1_cost\",\n          \"component\": \"Text\",\n          \"text\": \"USD 280-350\"\n        },\n        {\n          \"id\": \"cost_row_2\",\n          \"component\": \"Row\",\n          \"justify\": \"sp