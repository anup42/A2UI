\n            \"default_pass\"\n          ]\n        },\n        {\n          \"id\": \"defaults_title\",\n          \"component\": \"Text\",\n          \"text\": \"Default Router Access Information\",\n          \"variant\": \"h3\"\n        },\n        {\n          \"id\": \"default_ip\",\n          \"component\": \"Text\",\n          \"text\": \"• Local IP Address: 192.168.1.1\"\n        },\n        {\n          \"id\": \"default_user\",\n          \"component\": \"Text\",\n          \"text\": \"• Standard Administrative Username: admin\"\n        },\n        {\n          \"id\": \"default_pass\",\n          \"component\": \"Text\",\n          \"text\": \"• Standard Administrative Password: admin or password (check device label).\"\n        },\n        {\n          \"id\": \"steps_section\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"steps_title\",\n            \"step1_col\",\n            \"step2_col\",\n            \"step3_col\",\n            \"step4_col\",\n            \"step5_col\",\n            \"step6_col\",\n            \"step7_col\"\n          ]\n        },\n        {\n          \"id\": \"steps_title\",\n          \"component\": \"Text\",\n          \"text\": \"Step-by-Step Guide\",\n          \"variant\": \"h3\"\n        },\n        {\n          \"id\": \"step1_col\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"step1_title\",\n            \"step1_list\"\n          ]\n        },\n        {\n          \"id\": \"step1_title\",\n          \"component\": \"Text\",\n          \"text\": \"1. Access Your Router's Web Interface\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"step1_list\",\n          \"component\": \"List\",\n          \"direction\": \"vertical\",\n          \"children\": [\n            \"step1_item1\",\n            \"step1_item2\"\n          ]\n        },\n        {\n          \"id\": \"step1_item1\",\n          \"component\": \"Text\",\n          \"text\": \"Open a web browser on a connected device.\"\n        },\n        {\n          \"id\": \"step1_item2\",\n          \"component\": \"Text\",\n          \"text\": \"Type 192.168.1.1 in the address bar and press Enter.\"\n        },\n        {\n          \"id\": \"step2_col\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"step2_title\",\n            \"step2_list\"\n          ]\n        },\n        {\n          \"id\": \"step2_title\",\n          \"component\": \"Text\",\n          \"text\": \"2. Log In to Your Router\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"step2_list\",\n          \"component\": \"List\",\n          \"direction\": \"vertical\",\n          \"children\": [\n            \"step2_item1\",\n            \"step2_item2\",\n            \"step2_item3\"\n          ]\n        },\n        {\n          \"id\": \"step2_item1\",\n          \"component\": \"Text\",\n          \"text\": \"Enter Username (default: admin).\"\n        },\n        {\n          \"id\": \"step2_item2\",\n          \"component\": \"Text\",\n          \"text\": \"Enter Password (your current admin password).\"\n        },\n        {\n          \"id\": \"step2_item3\",\n          \"component\": \"Text\",\n          \"text\": \"Click 'Log In' or 'Sign In'.\"\n        },\n        {\n          \"id\": \"step3_col\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"step3_title\",\n            \"step3_list\"\n          ]\n        },\n        {\n          \"id\": \"step3_title\",\n          \"component\": \"Text\",\n          \"text\": \"3. Navigate to Wireless Settings\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"step3_list\",\n          \"component\": \"List\",\n          \"direction\": \"vertical\",\n          \"children\": [\n            \"step3_item1\",\n            \"step3_item2\"\n          ]\n        },\n        {\n          \"id\": \"step3_item1\",\n          \"component\": \"Text\",\n          \"text\": \"Locate the dashboard or main menu.\"\n        },\n        {\n          \"id\": \"step3_item2\",\n          \"component\": \"Text\",\n          \"text\": \"Select 'Wi-Fi Settings', 'Wireless', or 'Connectivity'.\"\n        },\n        {\n          \"id\": \"step4_col\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"step4_title\",\n            \"step4_list\"\n          ]\n        },\n        {\n          \"id\": \"step4_title\",\n          \"component\": \"Text\",\n          \"text\": \"4. Change the Wi-Fi Network Name (SSID)\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"step4_list\",\n          \"component\": \"List\",\n          \"direction\": \"vertical\",\n          \"children\": [\n            \"step4_item1\",\n            \"step4_item2\",\n            \"step4_item3\"\n          ]\n        },\n        {\n          \"id\": \"step4_item1\",\n          \"component\": \"Text\",\n          \"text\": \"Find the 'Network Name (SSID)' field for 2.4 GHz and 5 GHz bands.\"\n        },\n        {\n          \"id\": \"step4_item2\",\n          \"component\": \"Text\",\n          \"text\": \"Delete the existing name.\"\n        },\n        {\n          \"id\": \"step4_item3\",\n          \"component\": \"Text\",\n          \"text\": \"Type in your new desired Wi-Fi network name.\"\n        },\n        {\n          \"id\": \"step5_col\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"step5_title\",\n            \"step5_list\"\n          ]\n        },\n        {\n          \"id\": \"step5_title\",\n          \"component\": \"Text\",\n          \"text\": \"5. Change the Wi-Fi Password\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"step5_list\",\n          \"component\": \"List\",\n          \"direction\": \"vertical\",\n          \"children\": [\n            \"step5_item1\",\n            \"step5_item2\",\n            \"step5_item3\",\n            \"step5_item4\"\n          ]\n        },\n        {\n          \"id\": \"step5_item1\",\n          \"component\": \"Text\",\n          \"text\": \"Ensure 'Security Mode' is set to 'WPA2 Personal' or 'WPA2/WPA3 Personal'.\"\n        },\n        {\n          \"id\": \"step5_item2\",\n          \"component\": \"Text\",\n          \"text\": \"Locate the 'Password' or 'Network Key' field.\"\n        },\n        {\n          \"id\": \"step5_item3\",\n          \"component\": \"Text\",\n          \"text\": \"Enter your new strong password (at least 8 chars, mixed case, numbers, symbols).\"\n        },\n        {\n          \"id\": \"step5_item4\",\n          \"component\": \"Text\",\n          \"text\": \"Delete the old password first if necessary.\"\n        },\n        {\n          \"id\": \"step6_col\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"step6_title\",\n            \"step6_list\"\n          ]\n        },\n        {\n          \"id\": \"step6_title\",\n          \"component\": \"Text\",\n          \"text\": \"6. Save Your Changes\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"step6_list\",\n          \"component\": \"List\",\n          \"direction\": \"vertical\",\n          \"children\": [\n            \"step6_item1\"\n          ]\n        },\n        {\n          \"id\": \"step6_item1\",\n          \"component\": \"Text\",\n          \"text\": \"Click 'Apply', 'Save', or 'OK' at the bottom of the page.\"\n        },\n        {\n          \"id\": \"step7_col\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"step7_title\",\n            \"step7_list\"\n          ]\n        },\n        {\n          \"id\": \"step7_title\",\n          \"component\": \"Text\",\n          \"text\": \"7. Reconnect Your Devices\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"step7_list\",\n          \"c