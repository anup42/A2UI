nt\": \"Image\",\n          \"url\": \"../assets/r_000701_01_1_mushroom-risotto.jpg\",\n          \"fit\": \"cover\",\n          \"accessibility\": {\n            \"label\": \"Vegan Mushroom Risotto Plating\"\n          }\n        },\n        {\n          \"id\": \"heading_context\",\n          \"component\": \"Text\",\n          \"text\": \"Kitchen & Ingredient Context\",\n          \"variant\": \"h3\"\n        },\n        {\n          \"id\": \"text_context_1\",\n          \"component\": \"Text\",\n          \"text\": \"This recipe assumes you have a heavy-bottomed pot or Dutch oven to distribute heat evenly.\"\n        },\n        {\n          \"id\": \"text_context_2\",\n          \"component\": \"Text\",\n          \"text\": \"We assume the use of dry white wine (like Pinot Grigio or Sauvignon Blanc) to deglaze the pan, but you can substitute extra vegetable broth mixed with a teaspoon of lemon juice or white wine vinegar if you prefer an alcohol-free version. We also assume the use of store-bought low-sodium vegetable broth, but homemade stock works excellently.\"\n        },\n        {\n          \"id\": \"heading_instructions\",\n          \"component\": \"Text\",\n          \"text\": \"Step-by-Step Cooking Instructions\",\n          \"variant\": \"h3\"\n        },\n        {\n          \"id\": \"heading_ingredients\",\n          \"component\": \"Text\",\n          \"text\": \"Ingredients:\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"list_ingredients\",\n          \"component\": \"List\",\n          \"direction\": \"vertical\",\n          \"children\": [\n            \"ingredient_item_1\",\n            \"ingredient_item_2\",\n            \"ingredient_item_3\",\n            \"ingredient_item_4\",\n            \"ingredient_item_5\",\n            \"ingredient_item_6\",\n            \"ingredient_item_7\",\n            \"ingredient_item_8\",\n            \"ingredient_item_9\",\n            \"ingredient_item_10\",\n            \"ingredient_item_11\"\n          ]\n        },\n        {\n          \"id\": \"ingredient_item_1\",\n          \"component\": \"Text\",\n          \"text\": \"- 1.5 cups Arborio rice (do not rinse, as starch is needed)\"\n        },\n        {\n          \"id\": \"ingredient_item_2\",\n          \"component\": \"Text\",\n          \"text\": \"- 5 to 6 cups vegetable broth (kept warm in a separate pot)\"\n        },\n        {\n          \"id\": \"ingredient_item_3\",\n          \"component\": \"Text\",\n          \"text\": \"- 1 lb mixed mushrooms (cremini, shiitake, oyster), sliced\"\n        },\n        {\n          \"id\": \"ingredient_item_4\",\n          \"component\": \"Text\",\n          \"text\": \"- 2 shallots, finely minced\"\n        },\n        {\n          \"id\": \"ingredient_item_5\",\n          \"component\": \"Text\",\n          \"text\": \"- 3 cloves garlic, minced\"\n        },\n        {\n          \"id\": \"ingredient_item_6\",\n          \"component\": \"Text\",\n          \"text\": \"- 0.5 cup dry white wine\"\n        },\n        {\n          \"id\": \"ingredient_item_7\",\n          \"component\": \"Text\",\n          \"text\": \"- 3 tbsp olive oil (divided)\"\n        },\n        {\n          \"id\": \"ingredient_item_8\",\n          \"component\": \"Text\",\n          \"text\": \"- 2 tbsp vegan butter (or extra olive oil)\"\n        },\n        {\n          \"id\": \"ingredient_item_9\",\n          \"component\": \"Text\",\n          \"text\": \"- 0.25 cup nutritional yeast (optional, for cheesy flavor)\"\n        },\n        {\n          \"id\": \"ingredient_item_10\",\n          \"component\": \"Text\",\n          \"text\": \"- 1 tbsp fresh thyme leaves\"\n        },\n        {\n          \"id\": \"ingredient_item_11\",\n          \"component\": \"Text\",\n          \"text\": \"- Salt and black pepper to taste\\n- Fresh parsley for garnish\"\n        },\n        {\n          \"id\": \"heading_steps\",\n          \"component\": \"Text\",\n          \"text\": \"Instructions:\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"list_steps\",\n          \"component\": \"List\",\n          \"direction\": \"vertical\",\n          \"children\": [\n            \"step_item_1\",\n            \"step_item_2\",\n            \"step_item_3\",\n            \"step_item_4\",\n            \"step_item_5\",\n            \"step_item_6\"\n          ]\n        },\n        {\n          \"id\": \"step_item_1\",\n          \"component\": \"Text\",\n          \"text\": \"1. Warm the Broth:\\nPour the vegetable broth into a saucepan and keep it on a low simmer next to your main cooking pot. Cold broth shocks the rice and stops the cooking process, preventing the creamy texture from developing.\"\n        },\n        {\n          \"id\": \"step_item_2\",\n          \"component\": \"Text\",\n          \"text\": \"2. Sauté the Mushrooms:\\nIn your heavy-bottomed pot, heat 1 tablespoon of olive oil over medium-high heat. Add the sliced mushrooms and cook until browned and their liquid has evaporated (about 5-8 minutes). Season with a pinch of salt. Remove mushrooms from the pot and set aside. This prevents them from getting rubbery during the rice cooking.\"\n        },\n        {\n          \"id\": \"step_item_3\",\n          \"component\": \"Text\",\n          \"text\": \"3. Aromatics and Toasting:\\nReduce heat to medium. Add the remaining 2 tablespoons of olive oil to the pot. Add shallots and cook until softened (2-3 minutes). Add garlic and thyme, cooking for another minute until fragrant. Add the Arborio rice. Toast the rice, stirring constantly, for 1-2 minutes until the edges are translucent and the center remains opaque. This toasting step creates a shell around the grain so it doesn't turn to mush while slowly releasing starch.\"\n        },\n        {\n          \"id\": \"step_item_4\",\n          \"component\": \"Text\",\n          \"text\": \"4. Deglaze:\\nPour in the white wine. Stir constantly until the wine is fully absorbed by the rice.\"\n        },\n        {\n          \"id\": \"step_item_5\",\n          \"component\": \"Text\",\n          \"text\": \"5. The Risotto Method:\\nBegin adding the warm broth, one ladle (about 0.5 cup) at a time. Stir frequently. Wait until the liquid is almost completely absorbed before adding the next ladle. The friction from stirring rubs the grains together, releasing the starch that creates the creamy sauce. Repeat this process for about 20-25 minutes. The rice is done when it is tender but still has a slight bite (al dente).\"\n        },\n        {\n          \"id\": \"step_item_6\",\n          \"component\": \"Text\",\n          \"text\": \"6. The Finish (Mantecatura):\\nRemove the pot from the heat. This is crucial. Stir in the cooked mushrooms, vegan butter, and nutritional yeast. Vigorously stir the mixture for 30 seconds to emulsify the fats with the starch. This step guarantees the creamy mouthfeel without dairy. Season with salt and pepper to taste. Garnish with fresh parsley and serve immediately.\"\n        },\n        {\n          \"id\": \"heading_cooking_phases\",\n          \"component\": \"Text\",\n          \"text\": \"Risotto Cooking Phases\",\n          \"variant\": \"h3\"\n        },\n        {\n          \"id\": \"table_phases\",\n          \"component\": \"List\",\n          \"direction\": \"vertical\",\n          \"children\": [\n            \"table_header_row\",\n            \"phase_row_1\",\n            \"phase_row_2\",\n            \"phase_row_3\",\n            \"phase_row_4\"\n          ]\n        },\n        {\n          \"id\": \"table_header_row\",\n          \"component\": \"Row\",\n          \"children\": [\n            \"header_phase\",\n            \"header_duration\",\n            \"header_action\"\n          ]\n        },\n        {\n          \"id\": \"header_phase\",\n          \"component\": \"Text\",\n          \"text\": \"Phase\",\n          \"variant\": \"h4\",\n          \"weight\": 1\n        },\n        {\n          \"id\": \"header_duration\",\n          \"component\": \"Text\",\n          \"text\": \"Duration\",\n          \"variant\": \"h4\",\n          \"weight\": 1\n        },\n        {\n          \"id\": \"header_action\",\n          \"component\": \"Text\",\n          \"text\": \"Key Action\",\n          \"variant\": \"h4\",\n          \"weight\": 2\n        },\n        {\n          \"id\": \"phase_row_1\",\n          \"component\": \"Row\",\n          \"children\": [\n            \"phase_1_text_1\",\n            \"phase_1_text_2\",\n            \"phase_1_text_3\"\n          ]\n        },\n        {\n          \"id\": \"phase_1_text_1\",\n          \"component\": \"Text\",\n          \"text\": \"Prep\",\n          \"weight\": 1\n        },\n        {\n          \"id\": \"phase_1_text_2\",\n          \"component\": \"Text\",\n          \"text\": \"10-15 mins\",\n          \"weight\": 1\n        },\n        {\n          \"id\": \"phase_1_text_3\",\n          \"component\": \"Text\",\n          \"text\": \"Chop vegetables, slice mushrooms, warm broth\",\n          \"weight\": 2\n        },\n        {\n          \"id\": \"phase_row_2\",\n          \"component\": \"Row\",\n          \"children\": [\n            \"phase_2_text_1\",\n            \"phase_2_text_2\",\n            \"phase_2_text_3\"\n          ]\n        },\n        {\n          \"id\": \"phase_2_text_1\",\n          \"component\": \"Text\",\n          \"text\": \"Sauté\",\n          \"weight\": 1\n        },\n        {\n          \"id\": \"phase_2_text_2\",\n          \"component\": \"Text\",\n          \"text\": \"8-10 mins\",\n          \"weight\": 1\n        },\n        {\n          \"id\": \"phase_2_text_3\",\n          \"component\": \"Text\",\n          \"text\": \"Brown mushrooms, sweat shallots, toast rice\",\n          \"weight\": 2\n        },\n        {\n          \"id\": \"phase_row_3\",\n          \"component\": \"Row\",\n          \"children\": [\n            \"phase_3_text_1\",\n            \"phase_3_text_2\",\n            \"phase_3_text_3\"\n          ]\n        },\n        {\n          \"id\": \"phase_3_text_1\",\n          \"component\": \"Text\",\n          \"text\": \"Simmer\",\n          \"weight\": 1\n        },\n        {\n          \"id\": \"phase_3_text_2\",\n          \"component\": \"Text\",\n          \"text\": \"20-25 mins\",\n          \"weight\": 1\n        },\n        {\n          \"id\": \"phase_3_text_3\",\n          \"component\": \"Text\",\n          \"text\": \"Add broth gradually, stir frequently to release starch\",\n          \"weight\": 2\n        },\n        {\n          \"id\": \"phase_row_4\",\n          \"component\": \"Row\",\n          \"children\": [\n            \"phase_4_text_1\",\n            \"phase_4_text_2\",\n            \"phase_4_text_3\"\n          ]\n        },\n        {\n          \"id\": \"phase_4_text_1\",\n          \"component\": \"Text\",\n          \"text\": \"Rest\",\n          \"weight\": 1\n        },\n        {\n          \"id\": \"phase_4_text_2\",\n          \"component\": \"Text\",\n          \"text\": \"2-3 mins\",\n          \"weight\": 1\n        },\n        {\n          \"id\": \"phase_4_text_3\",\n          \"component\": \"Text\",\n          \"text\": \"Remove from heat, beat in fat (mantecatura) for creaminess\",\n          \"weight\": 2\n        },\n        {\n          \"id\": \"image_arborio_rice\",\n          \"component\": \"Image\",\n          \"url\": \"../assets/r_000701_01_2_arborio-rice.jpg\",\n          \"fit\": \"cover\",\n          \"accessibility\": {\n            \"label\": \"Arborio Rice Texture\"\n          }\n        },\n        {\n          \"id\": \"image_cooking_process\",\n          \"component\": \"Image\",\n          \"url\": \"../assets/r_000701_01_3_cooking-rice.jpg\",\n          \"fit\": \"cover\",\n          \"accessibility\": {\n            \"label\": \"Cooking Process\"\n          }\n        },\n        {\n          \"id