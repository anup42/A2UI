{"prompt_hash": "937d22a008b3d483b13f697a7bfe6ecd17b9013a30c133b268182ea91aeeb6da", "text": "[\n  {\n    \"version\": \"v0.9\",\n    \"createSurface\": {\n      \"surfaceId\": \"game_recommendations_surface\",\n      \"catalogId\": \"https://genui.local/specification/v0_9/standard_catalog.json\"\n    }\n  },\n  {\n    \"version\": \"v0.9\",\n    \"updateComponents\": {\n      \"surfaceId\": \"game_recommendations_surface\",\n      \"components\": [\n        {\n          \"id\": \"root\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"title_h2\",\n            \"group_dynamics_h3\",\n            \"group_dynamics_body\",\n            \"top_picks_h3\",\n            \"codenames_card\",\n            \"justone_card\",\n            \"deception_card\",\n            \"resistance_card\",\n            \"quick_actions_h3\",\n            \"quick_actions_list\",\n            \"sources_h3\",\n            \"sources_list\"\n          ]\n        },\n        {\n          \"id\": \"title_h2\",\n          \"component\": \"Text\",\n          \"text\": \"Beginner-Friendly 6-Player Game Recommendations\",\n          \"variant\": \"h2\"\n        },\n        {\n          \"id\": \"group_dynamics_h3\",\n          \"component\": \"Text\",\n          \"text\": \"Group Dynamics and Selection Criteria\",\n          \"variant\": \"h3\"\n        },\n        {\n          \"id\": \"group_dynamics_body\",\n          \"component\": \"Text\",\n          \"text\": \"These recommendations assume the group has little to no prior experience with modern hobby board games. The selections focus on high interaction, minimal downtime between turns, and rules that can be taught in under 5 minutes. The games selected bridge the gap between casual conversation and structured play, ensuring the 60-minute time limit is respected even with teaching time included.\"\n        },\n        {\n          \"id\": \"top_picks_h3\",\n          \"component\": \"Text\",\n          \"text\": \"Top Party and Deduction Picks\",\n          \"variant\": \"h3\"\n        },\n        {\n          \"id\": \"codenames_card\",\n          \"component\": \"Card\",\n          \"child\": \"codenames_column\"\n        },\n        {\n          \"id\": \"codenames_column\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"codenames_title_h4\",\n            \"codenames_subtitle_body\",\n            \"codenames_desc_body\",\n            \"codenames_bgg_button\"\n          ]\n        },\n        {\n          \"id\": \"codenames_title_h4\",\n          \"component\": \"Text\",\n          \"text\": \"Option 1: Codenames\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"codenames_subtitle_body\",\n          \"component\": \"Text\",\n          \"text\": \"Team-based word association game | Party / 15 Minutes\"\n        },\n        {\n          \"id\": \"codenames_desc_body\",\n          \"component\": \"Text\",\n          \"text\": \"The group splits into two teams, Red and Blue. Each team has a Spymaster who provides one-word clues linked to multiple cards on the table. The goal is for teammates to guess the correct words based on the clue without picking the opposing team's words or the instant-loss Assassin card. It encourages clever thinking and group discussion.\"\n        },\n        {\n          \"id\": \"codenames_bgg_button\",\n          \"component\": \"Button\",\n          \"child\": \"codenames_bgg_button_text\",\n          \"action\": {\n            \"functionCall\": {\n              \"call\": \"openUrl\",\n              \"args\": {\n                \"url\": \"https://boardgamegeek.com/boardgame/178900/codenames\"\n              }\n            }\n          }\n        },\n        {\n          \"id\": \"codenames_bgg_button_text\",\n          \"component\": \"Text\",\n          \"text\": \"View on BoardGameGeek\"\n        },\n        {\n          \"id\": \"justone_card\",\n          \"component\": \"Card\",\n      