{"prompt_hash": "4b7f94762ab170f56a747684575c16c484df242dd260bc704191348732fe127c", "text": "[\n  {\n    \"version\": \"v0.9\",\n    \"createSurface\": {\n      \"surfaceId\": \"surface-risotto-recipe\",\n      \"catalogId\": \"https://genui.local/specification/v0_9/standard_catalog.json\",\n      \"theme\": {\n        \"primaryColor\": \"#4CAF50\"\n      }\n    }\n  },\n  {\n    \"version\": \"v0.9\",\n    \"updateComponents\": {\n      \"surfaceId\": \"surface-risotto-recipe\",\n      \"components\": [\n        {\n          \"id\": \"root\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"header_title\",\n            \"summary_section_title\",\n            \"summary_text\",\n            \"assumptions_section_title\",\n            \"assumptions_text\",\n            \"meta_icons_row\",\n            \"ingredients_title\",\n            \"ingredients_list\",\n            \"phases_title\",\n            \"phase_1_card\",\n            \"phase_2_card\",\n            \"phase_3_card\",\n            \"phase_4_card\",\n            \"actions_title\",\n            \"actions_row\",\n            \"sources_title\",\n            \"sources_list\"\n          ]\n        },\n        {\n          \"id\": \"header_title\",\n          \"component\": \"Text\",\n          \"text\": \"Vegan Mushroom Risotto\",\n          \"variant\": \"h1\"\n        },\n        {\n          \"id\": \"summary_section_title\",\n          \"component\": \"Text\",\n          \"text\": \"Summary\",\n          \"variant\": \"h3\"\n        },\n        {\n          \"id\": \"summary_text\",\n          \"component\": \"Text\",\n          \"text\": \"This vegan mushroom risotto achieves a rich, creamy texture without dairy by leveraging the natural starches of Arborio rice and a technique called \\\"mantecatura\\\" using vegan fats. By slowly adding warm vegetable broth and stirring frequently, the rice releases amylopectin, creating a velvety sauce. Umami boosters like soy sauce or miso paste replace the depth usually provided by parmesan cheese.\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"assumptions_section_title\",\n          \"component\": \"Text\",\n          \"text\": \"Assumptions\",\n          \"variant\": \"h3\"\n        },\n        {\n          \"id\": \"assumptions_text\",\n          \"component\": \"Text\",\n          \"text\": \"I assume you have access to a heavy-bottomed pot or Dutch oven for even heat distribution and standard measuring tools.\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"meta_icons_row\",\n          \"component\": \"Row\",\n          \"children\": [\n            \"icon_prep_col\",\n            \"icon_servings_col\",\n            \"icon_ingredients_col\"\n          ],\n          \"justify\": \"spaceAround\"\n        },\n        {\n          \"id\": \"icon_prep_col\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"icon_prep_img\",\n            \"icon_prep_label\"\n          ],\n          \"align\": \"center\"\n        },\n        {\n          \"id\": \"icon_prep_img\",\n          \"component\": \"Image\",\n          \"url\": \"/assets/r_000701_01_1_stopwatch.svg\",\n          \"variant\": \"icon\"\n        },\n        {\n          \"id\": \"icon_prep_label\",\n          \"component\": \"Text\",\n          \"text\": \"Prep Time\",\n          \"variant\": \"caption\"\n        },\n        {\n          \"id\": \"icon_servings_col\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"icon_servings_img\",\n            \"icon_servings_label\"\n          ],\n          \"align\": \"center\"\n        },\n        {\n          \"id\": \"icon_servings_img\",\n          \"component\": \"Image\",\n          \"url\": \"/assets/r_000264_01_3_airplane.svg\",\n          \"variant\": \"icon\"\n        },\n        {\n          \"id\": \"icon_servings_label\",\n          \"component\": \"Text\",\n          \"text\": \"Servings\",\n          \"variant\": \"caption\"\n        },\n        {\n          \"id\": \"icon_ingredients_col\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"icon_ingredients_img\",\n            \"icon_ingredients_label\"\n          ],\n          \"align\": \"center\"\n        },\n        {\n          \"id\": \"icon_ingredients_img\",\n          \"component\": \"Image\",\n          \"url\": \"/assets/r_000701_01_3_book.svg\",\n          \"variant\": \"icon\"\n        },\n        {\n          \"id\": \"icon_ingredients_label\",\n          \"component\": \"Text\",\n          \"text\": \"Ingredients\",\n          \"variant\": \"caption\"\n        },\n        {\n          \"id\": \"ingredients_title\",\n          \"component\": \"Text\",\n          \"text\": \"Ingredients Checklist\",\n          \"variant\": \"h3\"\n        },\n        {\n          \"id\": \"ingredients_list\",\n          \"component\": \"List\",\n          \"direction\": \"vertical\",\n          \"children\": [\n            \"ing_1\",\n            \"ing_2\",\n            \"ing_3\",\n            \"ing_4\",\n            \"ing_5\",\n            \"ing_6\",\n            \"ing_7\",\n            \"ing_8\",\n            \"ing_9\",\n            \"ing_10\",\n            \"ing_11\",\n            \"ing_12\",\n            \"ing_13\"\n          ]\n        },\n        {\n          \"id\": \"ing_1\",\n          \"component\": \"Text\",\n          \"text\": \"• 1.5 cups Arborio rice\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"ing_2\",\n          \"component\": \"Text\",\n          \"text\": \"• 5-6 cups Vegetable broth (low sodium, kept simmering)\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"ing_3\",\n          \"component\": \"Text\",\n          \"text\": \"• 1 lb Mixed mushrooms (cremini, shiitake, oyster), sliced\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"ing_4\",\n          \"component\": \"Text\",\n          \"text\": \"• 1 Medium yellow onion, finely diced\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"ing_5\",\n          \"component\": \"Text\",\n          \"text\": \"• 2 Cloves garlic, minced\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"ing_6\",\n          \"component\": \"Text\",\n          \"text\": \"• 1/2 cup Dry white wine (Sauvignon Blanc or Pinot Grigio)\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"ing_7\",\n          \"component\": \"Text\",\n          \"text\": \"• 3 tbsp Olive oil (divided)\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"ing_8\",\n          \"component\": \"Text\",\n          \"text\": \"• 2 tbsp Vegan butter (cold)\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"ing_9\",\n          \"component\": \"Text\",\n          \"text\": \"• 3 tbsp Nutritional yeast (essential for cheesy flavor)\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"ing_10\",\n          \"component\": \"Text\",\n          \"text\": \"• 1 tbsp Soy sauce or white miso paste (for savory depth)\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"ing_11\",\n          \"component\": \"Text\",\n          \"text\": \"• 1 tbsp Fresh thyme leaves\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"ing_12\",\n          \"component\": \"Text\",\n          \"text\": \"• Salt and black pepper to taste\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"ing_13\",\n          \"component\": \"Text\",\n          \"text\": \"• Fresh parsley for garnish\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"phases_title\",\n          \"component\": \"Text\",\n          \"text\": \"Cooking Phases\",\n          \"variant\": \"h3\"\n        },\n        {\n          \"id\": \"phase_1_card\",\n          \"component\": \"Card\",\n          \"child\": \"phase_1_col\"\n        },\n        {\n          \"id\": \"phase_1_col\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"phase_1_title\",\n            \"phase_1_meta\",\n            \"phase_1_body\",\n            \"phase_1_btn\"\n          ]\n        },\n        {\n          \"id\": \"phase_1_title\",\n          \"component\": \"Text\",\n          \"text\": \"Option 1: The Sauté & Toast\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"phase_1_meta\",\n          \"component\": \"Text\",\n          \"text\": \"Flavor Foundation | High Heat\",\n          \"variant\": \"caption\"\n        },\n        {\n          \"id\": \"phase_1_body\",\n          \"component\": \"Text\",\n          \"text\": \"Start by sautéing the mushrooms in 1 tbsp olive oil until browned and all liquid has evaporated; set them aside. In the same pot, add remaining oil and onions, cooking until translucent. Add the Arborio rice and toast for 2 minutes until edges are translucent. This toasting step ensures the grains hold their shape.\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"phase_1_btn\",\n          \"component\": \"Button\",\n          \"child\": \"phase_1_btn_text\",\n          \"action\": {\n            \"functionCall\": {\n              \"call\": \"openUrl\",\n              \"args\": {\n                \"url\": \"https://www.youtube.com/results?search_query=how+to+toast+risotto+rice\"\n              }\n            }\n          }\n        },\n        {\n          \"id\": \"phase_1_btn_text\",\n          \"component\": \"Text\",\n          \"text\": \"Watch Toasting Technique\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"phase_2_card\",\n          \"component\": \"Card\",\n          \"child\": \"phase_2_col\"\n        },\n        {\n          \"id\": \"phase_2_col\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"phase_2_title\",\n            \"phase_2_meta\",\n            \"phase_2_body\",\n            \"phase_2_btn\"\n          ]\n        },\n        {\n          \"id\": \"phase_2_title\",\n          \"component\": \"Text\",\n          \"text\": \"Option 2: The Slow Simmer\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"phase_2_meta\",\n          \"component\": \"Text\",\n          \"text\": \"Texture Development | Medium Heat\",\n          \"variant\": \"caption\"\n        },\n        {\n          \"id\": \"phase_2_body\",\n          \"component\": \"Text\",\n          \"text\": \"Deglaze the pot with white wine and stir until fully absorbed. Begin adding the hot vegetable broth one ladle at a time. Stir almost constantly. Wait until the liquid is nearly absorbed before adding the next ladle. This friction releases the starch required for creaminess. Repeat this process for about 18-20 minutes until rice is al dente.\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"phase_2_btn\",\n          \"component\": \"Button\",\n          \"child\": \"phase_2_btn_text\",\n          \"action\": {\n            \"functionCall\": {\n              \"call\": \"openUrl\",\n              \"args\": {\n                \"url\": \"https://www.youtube.com/results?search_query=risotto+stirring+technique\"\n              }\n            }\n          }\n        },\n        {\n          \"id\": \"phase_2_btn_text\",\n          \"component\": \"Text\",\n          \"text\": \"Risotto Stirring Tips\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"phase_3_card\",\n          \"component\": \"Card\",\n          \"child\": \"phase_3_col\"\n        },\n        {\n          \"id\": \"phase_3_col\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"phase_3_title\",\n            \"phase_3_meta\",\n            \"phase_3_body\",\n            \"phase_3_btn\"\n          ]\n        },\n        {\n          \"id\": \"phase_3_title\",\n          \"component\": \"Text\",\n          \"text\": \"Option 3: The Mantecatura\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"phase_3_meta\",\n          \"component\": \"Text\",\n          \"text\": \"Creamy Finish | Heat Off\",\n          \"variant\": \"caption\"\n        },\n        {\n          \"id\": \"phase_3_body\",\n          \"component\": \"Text\",\n          \"text\": \"Remove the pot from the heat immediately. This is crucial. Fold the cooked mushrooms back in. Add the cold vegan butter, nutritional yeast, and soy sauce/miso. Stir vigorously (whip it) for 1 minute to emulsify the fats with the starch. This creates the signature creamy wave. Season with salt, pepper, and fresh thyme.\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"phase_3_btn\",\n          \"component\": \"Button\",\n          \"child\": \"phase_3_btn_text\",\n          \"action\": {\n            \"functionCall\": {\n              \"call\": \"openUrl\",\n              \"args\": {\n                \"url\": \"https://www.google.com/search?q=best+vegan+butter+for+cooking\"\n              }\n            }\n          }\n        },\n        {\n          \"id\": \"phase_3_btn_text\",\n          \"component\": \"Text\",\n          \"text\": \"Vegan Butter Options\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"phase_4_card\",\n          \"component\": \"Card\",\n          \"child\": \"phase_4_col\"\n        },\n        {\n          \"id\": \"phase_4_col\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"phase_4_title\",\n            \"phase_4_meta\",\n            \"phase_4_body\",\n            \"phase_4_btn\"\n          ]\n        },\n        {\n          \"id\": \"phase_4_title\",\n          \"component\": \"Text\",\n          \"text\": \"Option 4: Plating & Serving\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"phase_4_meta\",\n          \"component\": \"Text\",\n          \"text\": \"Presentation | Immediate\",\n          \"variant\": \"caption\"\n        },\n        {\n          \"id\": \"phase_4_body\",\n          \"component\": \"Text\",\n          \"text\": \"Serve immediately while the texture is loose and flowing (all'onda). Garnish with fresh parsley and a drizzle of high-quality olive oil. Risotto stiffens as it cools, so immediate service ensures the best texture.\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"phase_4_btn\",\n          \"component\": \"Button\",\n          \"child\": \"phase_4_btn_text\",\n          \"action\": {\n            \"functionCall\": {\n              \"call\": \"openUrl\",\n              \"args\": {\n                \"url\": \"https://www.google.com/search?q=vegan+wine+pairing+mushroom+risotto\"\n              }\n            }\n          }\n        },\n        {\n          \"id\": \"phase_4_btn_text\",\n          \"component\": \"Text\",\n          \"text\": \"Wine Pairing Guide\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"actions_title\",\n          \"component\": \"Text\",\n          \"text\": \"Quick Actions\",\n          \"variant\": \"h3\"\n        },\n        {\n          \"id\": \"actions_row\",\n          \"component\": \"Row\",\n          \"children\": [\n            \"action_btn_1\",\n            \"action_btn_2\"\n          ],\n          \"justify\": \"start\"\n        },\n        {\n          \"id\": \"action_btn_1\",\n          \"component\": \"Button\",\n          \"child\": \"action_btn_1_text\",\n          \"variant\": \"primary\",\n          \"action\": {\n            \"functionCall\": {\n              \"call\": \"openUrl\",\n              \"args\": {\n                \"url\": \"https://www.google.com/search?q=save+recipe+app\"\n              }\n    