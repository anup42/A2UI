\n          \"text\": \"2 shallots, finely minced\"\n        },\n        {\n          \"id\": \"ingredient_5\",\n          \"component\": \"Text\",\n          \"text\": \"3 cloves garlic, minced\"\n        },\n        {\n          \"id\": \"ingredient_6\",\n          \"component\": \"Text\",\n          \"text\": \"0.5 cup dry white wine\"\n        },\n        {\n          \"id\": \"ingredient_7\",\n          \"component\": \"Text\",\n          \"text\": \"3 tbsp olive oil (divided)\"\n        },\n        {\n          \"id\": \"ingredient_8\",\n          \"component\": \"Text\",\n          \"text\": \"2 tbsp vegan butter (or extra olive oil)\"\n        },\n        {\n          \"id\": \"ingredient_9\",\n          \"component\": \"Text\",\n          \"text\": \"0.25 cup nutritional yeast (optional, for cheesy flavor)\"\n        },\n        {\n          \"id\": \"ingredient_10\",\n          \"component\": \"Text\",\n          \"text\": \"1 tbsp fresh thyme leaves\"\n        },\n        {\n          \"id\": \"ingredient_11\",\n          \"component\": \"Text\",\n          \"text\": \"Salt and black pepper to taste\"\n        },\n        {\n          \"id\": \"ingredient_12\",\n          \"component\": \"Text\",\n          \"text\": \"Fresh parsley for garnish\"\n        },\n        {\n          \"id\": \"instructions_list_title\",\n          \"component\": \"Text\",\n          \"variant\": \"h3\",\n          \"text\": \"Instructions:\"\n        },\n        {\n          \"id\": \"instructions_list\",\n          \"component\": \"List\",\n          \"direction\": \"vertical\",\n          \"children\": [\n            \"step_1_col\",\n            \"step_2_col\",\n            \"step_3_col\",\n            \"step_4_col\",\n            \"step_5_col\",\n            \"step_6_col\"\n          ]\n        },\n        {\n          \"id\": \"step_1_col\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"step_1_title\",\n            \"step_1_desc\"\n      