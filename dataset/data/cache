\n        },\n        {\n          \"id\": \"day1_card\",\n          \"component\": \"Card\",\n          \"child\": \"day1_column\"\n        },\n        {\n          \"id\": \"day1_column\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"day1_title\",\n            \"day1_image\",\n            \"day1_desc\",\n            \"day1_button\"\n          ]\n        },\n        {\n          \"id\": \"day1_title\",\n          \"component\": \"Text\",\n          \"text\": \"Day 1: Arashiyama Nature & Wildlife | Iwatayama Monkey Park (easy hike) and Bamboo Grove | West Kyoto\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"day1_image\",\n          \"component\": \"Image\",\n          \"url\": \"/assets/r_000784_01_3_kyoto_bamboo.jpg\",\n          \"accessibility\": {\n            \"label\": \"Arashiyama Bamboo Path\"\n          }\n        },\n        {\n          \"id\": \"day1_desc\",\n          \"component\": \"Text\",\n          \"text\": \"Start at JR Saga-Arashiyama Station. Walk 15 minutes to the Monkey Park entrance; the climb is an easy 20-minute trail with monkeys at the summit. Afterward, cross the Togetsukyo Bridge to the Bamboo Grove.\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"day1_button\",\n          \"component\": \"Button\",\n          \"child\": \"day1_button_text\",\n          \"action\": {\n            \"functionCall\": {\n              \"call\": \"openUrl\",\n              \"args\": {\n                \"url\": \"https://kyoto.travel/en/areas/arashiyama.html\"\n              }\n            }\n          }\n        },\n        {\n          \"id\": \"day1_button_text\",\n          \"component\": \"Text\",\n          \"text\": \"Arashiyama Area Guide\"\n        },\n        {\n          \"id\": \"day2_card\",\n          \"component\": \"Card\",\n          \"child\": \"day2_column\"\n        },\n        {\n          \"id\": \"day2_column\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"day2_title\",\n            \"day2_image\",\n            \"day2_desc\",\n            \"day2_button\"\n          ]\n        },\n        {\n          \"id\": \"day2_title\",\n          \"component\": \"Text\",\n          \"text\": \"Day 2: Iconic Gates & Views | Fushimi Inari Shrine and Kiyomizu-dera | Southern & Eastern Kyoto\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"day2_image\",\n          \"component\": \"Image\",\n          \"url\": \"/assets/r_000784_01_4_fushimi_inari_torii.jpg\",\n          \"accessibility\": {\n            \"label\": \"Fushimi Inari Torii Gates\"\n          }\n        },\n        {\n          \"id\": \"day2_desc\",\n          \"component\": \"Text\",\n          \"text\": \"Morning at Fushimi Inari (JR Inari Station is immediately adjacent). The lower loop hike is gentle and features thousands of gates. Afternoon: Take a taxi to Kiyomizu-dera to avoid the steep approach walk.\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"day2_button\",\n          \"component\": \"Button\",\n          \"child\": \"day2_button_text\",\n          \"action\": {\n            \"functionCall\": {\n              \"call\": \"openUrl\",\n              \"args\": {\n                \"url\": \"https://inari.jp/en/map/\"\n              }\n            }\n          }\n        },\n        {\n          \"id\": \"day2_button_text\",\n          \"component\": \"Text\",\n          \"text\": \"Fushimi Inari Maps\"\n        },\n        {\n          \"id\": \"day3_card\",\n          \"component\": \"Card\",\n          \"child\": \"day3_column\"\n        },\n        {\n          \"id\": \"day3_column\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"day3_title\",\n            \"day3_image\",\n            \"day3_desc\",\n            \"day3_button\"\n          ]\n        },\n        {\n          \"id\": \"day3_title\",\n          \"co