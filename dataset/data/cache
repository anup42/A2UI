{"prompt_hash": "9737c8c5ebfd03ffe6ce1cfca203dba92bcfb5813b20f9706c82a1d81236e2ee", "text": "[\n  {\n    \"version\": \"v0.9\",\n    \"createSurface\": {\n      \"surfaceId\": \"chair-comparison-surface\",\n      \"catalogId\": \"https://genui.local/specification/v0_9/standard_catalog.json\"\n    }\n  },\n  {\n    \"version\": \"v0.9\",\n    \"updateComponents\": {\n      \"surfaceId\": \"chair-comparison-surface\",\n      \"components\": [\n        {\n          \"id\": \"root\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"summary_h\",\n            \"summary_b\",\n            \"comp_h\",\n            \"lumbar_card\",\n            \"armrest_card\",\n            \"tilt_card\",\n            \"actions_row\",\n            \"sources_h\",\n            \"source_1\",\n            \"source_2\"\n          ],\n          \"justify\": \"start\",\n          \"align\": \"stretch\"\n        },\n        {\n          \"id\": \"summary_h\",\n          \"component\": \"Text\",\n          \"text\": \"Summary\",\n          \"variant\": \"h2\"\n        },\n        {\n          \"id\": \"summary_b\",\n          \"component\": \"Text\",\n          \"text\": \"The Herman Miller Aeron is a classic mesh task chair focused on suspended support, while the Steelcase Gesture is designed for modern tech users, supporting a wide range of postures and device-usage styles.\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"comp_h\",\n          \"component\": \"Text\",\n          \"text\": \"Ergonomic Feature Comparison\",\n          \"variant\": \"h3\"\n        },\n        {\n          \"id\": \"lumbar_card\",\n          \"component\": \"Card\",\n          \"child\": \"lumbar_col\"\n        },\n        {\n          \"id\": \"lumbar_col\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"lumbar_t\",\n            \"lumbar_a\",\n            \"lumbar_g\"\n          ]\n        },\n        {\n          \"id\": \"l