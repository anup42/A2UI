         \"component\": \"Text\",\n          \"text\": \"Detailed Differences\",\n          \"variant\": \"h5\"\n        },\n        {\n          \"id\": \"col_details\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"card_elig\",\n            \"card_assets\",\n            \"card_time\"\n          ]\n        },\n        {\n          \"id\": \"card_elig\",\n          \"component\": \"Card\",\n          \"child\": \"col_elig_content\"\n        },\n        {\n          \"id\": \"col_elig_content\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"row_elig_header\",\n            \"txt_elig_ch7\",\n            \"txt_elig_ch13\"\n          ]\n        },\n        {\n          \"id\": \"row_elig_header\",\n          \"component\": \"Row\",\n          \"align\": \"center\",\n          \"children\": [\n            \"img_law\",\n            \"txt_elig_title\"\n          ]\n        },\n        {\n          \"id\": \"img_law\",\n          \"component\": \"Image\",\n          \"url\": \"/assets/r_000069_01_1_law.png\",\n          \"variant\": \"icon\"\n        },\n        {\n          \"id\": \"txt_elig_title\",\n          \"component\": \"Text\",\n          \"text\": \"1. Eligibility Requirements\",\n          \"variant\": \"h5\"\n        },\n        {\n          \"id\": \"txt_elig_ch7\",\n          \"component\": \"Text\",\n          \"text\": \"**Chapter 7:** Requires a Means Test to ensure your income is below the state median or that you lack the disposable income to pay creditors.\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"txt_elig_ch13\",\n          \"component\": \"Text\",\n          \"text\": \"**Chapter 13:** Open to individuals with a stable income. There are specific debt ceilings (e.g., less than $2.75 million in total debt) that change periodically.\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"card_assets\",\n          \"component\": \"Card\",\n          \"child\": \"col_assets_content\"\n        },\n        {\n          \"id\": \"col_assets_content\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"row_assets_header\",\n            \"txt_assets_ch7\",\n            \"txt_assets_ch13\"\n          ]\n        },\n        {\n          \"id\": \"row_assets_header\",\n          \"component\": \"Row\",\n          \"align\": \"center\",\n          \"children\": [\n            \"img_fin\",\n            \"txt_assets_title\"\n          ]\n        },\n        {\n          \"id\": \"img_fin\",\n          \"component\": \"Image\",\n          \"url\": \"/assets/r_000069_01_2_money-box.png\",\n          \"variant\": \"icon\"\n        },\n        {\n          \"id\": \"txt_assets_title\",\n          \"component\": \"Text\",\n          \"text\": \"2. Treatment of Secured Assets\",\n          \"variant\": \"h5\"\n        },\n        {\n          \"id\": \"txt_assets_ch7\",\n          \"component\": \"Text\",\n          \"text\": \"**Chapter 7:** If you are behind on your mortgage, Chapter 7 does not provide a way to catch up. If you have significant equity above the legal exemption, the trustee may sell the home to pay creditors.\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"txt_assets_ch13\",\n          \"component\": \"Text\",\n          \"text\": \"**Chapter 13:** This is often used to save homes from foreclosure. It allows you to stop foreclosure and pay back the missed mortgage payments (arrears) over the life of the 3 to 5-year plan.\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"card_time\",\n          \"component\": \"Card\",\n          \"child\": \"col_time_content\"\n        },\n        {\n          \"id\": \"col_time_content\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"row_time_header\",\n            \"txt_time_ch7\",\n            \"txt_time_ch13\"\n          ]\n    