ame nights.\"\n        },\n        {\n          \"id\": \"recommendations_header\",\n          \"component\": \"Text\",\n          \"variant\": \"h3\",\n          \"text\": \"Three Recommendations for a Two-Hour Game Night\"\n        },\n        {\n          \"id\": \"recommendations_list\",\n          \"component\": \"List\",\n          \"direction\": \"vertical\",\n          \"children\": [\n            \"horrified_card\",\n            \"spirit_island_card\",\n            \"the_crew_card\"\n          ]\n        },\n        {\n          \"id\": \"horrified_card\",\n          \"component\": \"Card\",\n          \"child\": \"horrified_content\"\n        },\n        {\n          \"id\": \"horrified_content\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"horrified_image\",\n            \"horrified_title\",\n            \"horrified_subtitle\",\n            \"horrified_playtime\",\n            \"horrified_description\",\n            \"horrified_button\"\n          ]\n        },\n        {\n          \"id\": \"horrified_image\",\n          \"component\": \"Image\",\n          \"url\": \"../assets/r_000003_01_1_horrified-board-game.jpg\",\n          \"fit\": \"cover\"\n        },\n        {\n          \"id\": \"horrified_title\",\n          \"component\": \"Text\",\n          \"variant\": \"h4\",\n          \"text\": \"Option 1: Horrified\"\n        },\n        {\n          \"id\": \"horrified_subtitle\",\n          \"component\": \"Text\",\n          \"variant\": \"caption\",\n          \"text\": \"Defend a village from classic movie monsters in this thematic co-op.\"\n        },\n        {\n          \"id\": \"horrified_playtime\",\n          \"component\": \"Text\",\n          \"variant\": \"caption\",\n          \"text\": \"Playtime: 60-75 minutes\"\n        },\n        {\n          \"id\": \"horrified_description\",\n          \"component\": \"Text\",\n          \"text\": \"In Horrified, you and your fellow players become heroes tryi