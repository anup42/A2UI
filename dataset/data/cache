\"center\",\n          \"children\": [\n            \"timeline_row_1_cell_1\",\n            \"timeline_row_1_cell_2\",\n            \"timeline_row_1_cell_3\"\n          ]\n        },\n        {\n          \"id\": \"timeline_row_1_cell_1\",\n          \"component\": \"Text\",\n          \"text\": \"September\",\n          \"weight\": 1\n        },\n        {\n          \"id\": \"timeline_row_1_cell_2\",\n          \"component\": \"Text\",\n          \"text\": \"Foundation & Legal\",\n          \"weight\": 1\n        },\n        {\n          \"id\": \"timeline_row_1_cell_3\",\n          \"component\": \"Text\",\n          \"text\": \"Business Registered & Packaging Finalized\",\n          \"weight\": 1\n        },\n        {\n          \"id\": \"timeline_row_2\",\n          \"component\": \"Row\",\n          \"align\": \"center\",\n          \"children\": [\n            \"timeline_row_2_cell_1\",\n            \"timeline_row_2_cell_2\",\n            \"timeline_row_2_cell_3\"\n          ]\n        },\n        {\n          \"id\": \"timeline_row_2_cell_1\",\n          \"component\": \"Text\",\n          \"text\": \"October\",\n          \"weight\": 1\n        },\n        {\n          \"id\": \"timeline_row_2_cell_2\",\n          \"component\": \"Text\",\n          \"text\": \"E-commerce Build & Content\",\n          \"weight\": 1\n        },\n        {\n          \"id\": \"timeline_row_2_cell_3\",\n          \"component\": \"Text\",\n          \"text\": \"Functional Online Store (Private) & Product Photos\",\n          \"weight\": 1\n        },\n        {\n          \"id\": \"timeline_row_3\",\n          \"component\": \"Row\",\n          \"align\": \"center\",\n          \"children\": [\n            \"timeline_row_3_cell_1\",\n            \"timeline_row_3_cell_2\",\n            \"timeline_row_3_cell_3\"\n          ]\n        },\n        {\n          \"id\": \"timeline_row_3_cell_1\",\n          \"component\": \"Text\",\n          \"text\": \"November\",\n          \"weight\": 1\n        },\n        {\n          \"id\": \"timeline_row_3_cell_2\",\n          \"component\": \"Text\",\n          \"text\": \"Marketing & Launch\",\n          \"weight\": 1\n        },\n        {\n          \"id\": \"timeline_row_3_cell_3\",\n          \"component\": \"Text\",\n          \"text\": \"Public Store Launch & First Sale Processed\",\n          \"weight\": 1\n        },\n        {\n          \"id\": \"roadmap_col\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"roadmap_title\",\n            \"month_1_card\",\n            \"month_2_card\",\n            \"month_3_card\"\n          ]\n        },\n        {\n          \"id\": \"roadmap_title\",\n          \"component\": \"Text\",\n          \"variant\": \"h3\",\n          \"text\": \"Month-by-Month Launch Roadmap\"\n        },\n        {\n          \"id\": \"month_1_card\",\n          \"component\": \"Card\",\n          \"child\": \"month_1_col\"\n        },\n        {\n          \"id\": \"month_1_col\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"month_1_title_row\",\n            \"month_1_desc\",\n            \"month_1_tasks_title\",\n            \"month_1_tasks_list\"\n          ]\n        },\n        {\n          \"id\": \"month_1_title_row\",\n          \"component\": \"Row\",\n          \"align\": \"center\",\n          \"children\": [\n            \"month_1_icon\",\n            \"month_1_title\"\n          ]\n        },\n        {\n          \"id\": \"month_1_icon\",\n          \"component\": \"Image\",\n          \"variant\": \"icon\",\n          \"url\": \"../assets/r_000014_01_7_calendar-week.svg\"\n        },\n        {\n          \"id\": \"month_1_title\",\n          \"component\": \"Text\",\n          \"variant\": \"h4\",\n          \"text\": \"Month 1: September 2024 - Foundation & Legal\"\n        },\n        {\n          \"id\": \"month_1_desc\",\n          \"component\": \"Text\",\n          \"text\": \"The goal for this month is to establish the legal and operational groundwork for your business. This ensures you are compliant and have a solid brand foundation before building your online presence.\"\n        },\n        {\n          \"id\": \"month_1_tasks_title\",\n          \"component\": \"Text\",\n          \"variant\": \"h5\",\n          \"text\": \"Key Tasks:\"\n        },\n        {\n          \"id\": \"month_1_tasks_list\",\n          \"component\": \"List\",\n          \"direction\": \"vertical\",\n          \"children\": [\n            \"month_1_task_1\",\n            \"month_1_task_2\",\n            \"month_1_task_3\",\n            \"month_1_task_4\"\n          ]\n        },\n        {\n          \"id\": \"month_1_task_1\",\n          \"component\": \"Text\",\n          \"text\": \"Legal & Finance: Register your business name (a \\\"Doing Business As\\\" or DBA is a common starting point). Research any local permits required for home-based businesses. Open a dedicated business bank account to keep finances separate.\"\n        },\n        {\n          \"id\": \"month_1_task_2\",\n          \"component\": \"Text\",\n          \"text\": \"Product Finalization: Conduct comprehensive burn tests for all 10 candle designs to ensure safety, scent throw, and consistent quality. Finalize your packaging design, including warning labels, branding, and shipping protection. Place orders for all packaging materials.\"\n        },\n        {\n          \"id\": \"month_1_task_3\",\n          \"component\": \"Text\",\n          \"text\": \"Brand Identity: Finalize your logo, brand colors, and fonts.\"\n        },\n        {\n          \"id\": \"month_1_task_4\",\n          \"component\": \"Text\",\n          \"text\": \"Digital Presence: Secure social media handles (e.g., Instagram, TikTok, Pinterest) that match your business name.\"\n        },\n        {\n          \"id\": \"month_2_card\",\n          \"component\": \"Card\",\n          \"child\": \"month_2_col\"\n        },\n        {\n          \"id\": \"month_2_col\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"month_2_title_row\",\n            \"month_2_desc\",\n            \"month_2_tasks_title\",\n            \"month_2_tasks_list\"\n          ]\n        },\n        {\n          \"id\": \"month_2_title_row\",\n          \"component\": \"Row\",\n          \"align\": \"center\",\n          \"children\": [\n            \"month_2_icon\",\n            \"month_2_title\"\n          ]\n        },\n        {\n          \"id\": \"month_2_icon\",\n          \"component\": \"Image\",\n          \"variant\": \"icon\",\n          \"url\": \"../assets/r_000014_01_8_shop.svg\"\n        },\n        {\n          \"id\": \"month_2_title\",\n          \"component\": \"Text\",\n          \"variant\": \"h4\",\n          \"text\": \"Month 2: October 2024 - E-commerce Build & Content Creation\"\n        },\n        {\n          \"id\": \"month_2_desc\",\n          \"component\": \"Text\",\n          \"text\": \"The focus shifts to building your digital storefront and creating the visual assets needed to market your products effectively.\"\n        },\n        {\n          \"id\": \"month_2_tasks_title\",\n          \"component\": \"Text\",\n          \"variant\": \"h5\",\n          \"text\": \"Key Tasks:\"\n        },\n        {\n          \"id\": \"month_2_tasks_list\",\n          \"component\": \"List\",\n          \"direction\": \"vertical\",\n          \"children\": [\n            \"month_2_task_1\",\n            \"month_2_task_2\",\n            \"month_2_task_3\",\n            \"month_2_task_4\"\n          ]\n        },\n        {\n          \"id\": \"month_2_task_1\",\n          \"component\": \"Text\",\n          \"text\": \"E-commerce Platform: Choose your platform (e.g., Shopify for brand control or Etsy for its existing marketplace). Set up your account, configure payment gateways, and establish shipping rates and zones.\"\n        },\n        {\n          \"id\": \"month_2_task_2\",\n          \"component\": \"Text\",\n          \"text\": \"Product Listings: Take high-quality, well-lit photographs and short videos of your candles. Write compelling, descriptive, and keyword-rich product titles and descriptions.\"\n        },\n        {\n          \"id\": \"month_2_task_3\",\n          \"component\": \"Text\",\n          \"text\": \"Inventory Production: Begin producing your initial stock for launch. Focus on creating a small but sufficient quantity of each of the 10 designs.\"\n        },\n        {\n          \"id\": \"month_2_task_4\",\n          \"component\": \"Text\",\n          \"text\": \"Content Planning: Develop a social media content calendar for November. Start creating \\\"coming soon\\\" and behind-the-scenes content to build anticipation.\"\n        },\n        {\n          \"id\": \"month_3_card\",\n          \"component\": \"Card\",\n          \"child\": \"month_3_col\"\n        },\n        {\n          \"id\": \"month_3_col\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"month_3_title_row\",\n            \"month_3_desc\",\n            \"month_3_tasks_title\",\n            \"month_3_tasks_list\"\n          ]\n        },\n        {\n          \"id\": \"month_3_title_row\",\n          \"component\": \"Row\",\n          \"align\": \"center\",\n          \"children\": [\n            \"month_3_icon\",\n            \"month_3_title\"\n          ]\n        },\n        {\n          \"id\": \"month_3_icon\",\n          \"component\": \"Image\",\n          \"variant\": \"icon\",\n          \"url\": \"../assets/r_000014_01_9_rocket-takeoff.svg\"\n        },\n        {\n          \"id\": \"month_3_title\",\n          \"component\": \"Text\",\n          \"variant\": \"h4\",\n          \"text\": \"Month 3: November 2024 - Marketing, Launch & First Sale\"\n        },\n        {\n          \"id\": \"month_3_desc\",\n          \"component\": \"Text\",\n          \"text\": \"This is the final push to launch. The focus is on marketing, final operational checks, and opening your store to the public.\"\n        },\n        {\n          \"id\": \"month_3_tasks_title\",\n          \"component\": \"Text\",\n          \"variant\": \"h5\",\n          \"text\": \"Key Tasks:\"\n        },\n        {\n          \"id\": \"month_3_tasks_list\",\n          \"component\": \"List\",\n          \"direction\": \"vertical\",\n          \"children\": [\n            \"month_3_task_1\",\n            \"month_3_task_2\",\n            \"month_3_task_3\",\n            \"month_3_task_4\"\n          ]\n        },\n        {\n          \"id\": \"month_3_task_1\",\n          \"component\": \"Text\",\n          \"text\": \"Marketing Execution: Begin actively posting on your social media channels according to your content calendar. Engage with potential customers and accounts in your niche.\"\n        },\n        {\n          \"id\": \"month_3_task_2\",\n          \"component\": \"Text\",\n          \"text\": \"Final Checks: Perform a full test of your website's checkout process with a friend or family member to ensure it is seamless. Organize your shipping station with all necessary materials (boxes, tape, labels).\"\n        },\n        {\n          \"id\": \"month_3_task_3\",\n          \"component\": \"Text\",\n          \"text\": \"Store Launch (Target: Mid-November): Set your online store live and announce the grand opening across all your channels. Consider a simple launch day promotion, like free shipping on orders over a certain amount.\"\n        },\n        {\n          \"id\": \"month_3_task_4\",\n          \"component\": \"Text\",\n          \"text\": \"Post-Launch Operations: Monitor sales and website analytics. Fulfill your first orders promptly and professionally. Follow up with customers to encourage reviews and feedback.\"\n        },\n        {\n          \"id\": \"images_row\",\n          \"component\": \"Row\",\n          \"justify\": \"spaceAround\",\n          \"children\": [\n            \"image_1\",\n            \"image_2\",\n            \"image_3\"\n          ]\n        },\n        {\n          \"id\": \"image_1\",\n          \"component\": \"Image\",\n          \"url\": \"../assets/r_000014_01_3_handmade_candle_lifestyle.jpg\",\n          \"fit\": \"cover\",\n          \"variant\": \"mediumFeature\",\n          \"weight\": 1\n        },\n        {\n          \"id\": \"image_2\",\n          \"component\": \"Image\",\n          \"url\": \"../assets/r_000014_01_4_ecommerce_website_laptop.jpg\",\n          \"fit\": \"cover\",\n          \"variant\": \"mediumFeature\",\n          \"weight\": 1\n        },\n        {\n          \"id\": \"image_3\",\n          \"component\": \"Image\",\n          \"url\": \"../assets/r_000014_01_5_socialmedia_flatlay_product.jpg\",\n          \"fit\": \"cover\",\n          \"variant\": \"mediumFeature\",\n          \"weight\": 1\n        },\n        {\n          \"id\": \"actions_col\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"actions_title\",\n            \"action_1_card\",\n            \"action_2_card\"\n          ]\n        },\n        {\n          \"id\": \"actions_title\",\n          \"component\": \"Text\",\n          \"variant\": \"h3\",\n          \"text\": \"Quick Actions\"\n        },\n        {\n          \"id\": \"action_1_card\",\n          \"component\": \"Card\",\n          \"child\": \"action_1_col\"\n        },\n        {\n          \"id\": \"action_1_col\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"action_1_title\",\n            \"action_1_desc\",\n            \"action_1_attr\",\n            \"action_1_button\"\n          ]\n        },\n        {\n          \"id\": \"action_1_title\",\n          \"component\": \"Text\",\n          \"variant\": \"h4\",\n          \"text\": \"Option 1: Compare E-commerce Platforms\"\n        },\n        {\n          \"id\": \"action_1_desc\",\n          \"component\