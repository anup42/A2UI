{"prompt_hash": "12ef1005ee2143300e116f9a7fe691bac248866dbc786de52b55848703918a00", "text": "[\n  {\n    \"version\": \"v0.9\",\n    \"createSurface\": {\n      \"surfaceId\": \"6-player-game-recommendations\",\n      \"catalogId\": \"https://genui.local/specification/v0_9/standard_catalog.json\"\n    }\n  },\n  {\n    \"version\": \"v0.9\",\n    \"updateComponents\": {\n      \"surfaceId\": \"6-player-game-recommendations\",\n      \"components\": [\n        {\n          \"id\": \"root\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"title_main\",\n            \"section_group_dynamics\",\n            \"section_top_picks\",\n            \"section_icons\",\n            \"section_quick_actions\",\n            \"section_sources\"\n          ]\n        },\n        {\n          \"id\": \"title_main\",\n          \"component\": \"Text\",\n          \"text\": \"Beginner-Friendly 6-Player Game Recommendations\",\n          \"variant\": \"h2\"\n        },\n        {\n          \"id\": \"section_group_dynamics\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"heading_group_dynamics\",\n            \"text_group_dynamics\"\n          ]\n        },\n        {\n          \"id\": \"heading_group_dynamics\",\n          \"component\": \"Text\",\n          \"text\": \"Group Dynamics and Selection Criteria\",\n          \"variant\": \"h3\"\n        },\n        {\n          \"id\": \"text_group_dynamics\",\n          \"component\": \"Text\",\n          \"text\": \"These recommendations assume the group has little to no prior experience with modern hobby board games. The selections focus on high interaction, minimal downtime between turns, and rules that can be taught in under 5 minutes. The games selected bridge the gap between casual conversation and structured play, ensuring the 60-minute time limit is respected even with teaching time included.\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"section_top_picks\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"heading_top_picks\",\n            \"list_game_options\"\n          ]\n        },\n        {\n          \"id\": \"heading_top_picks\",\n          \"component\": \"Text\",\n          \"text\": \"Top Party and Deduction Picks\",\n          \"variant\": \"h3\"\n        },\n        {\n          \"id\": \"list_game_options\",\n          \"component\": \"List\",\n          \"direction\": \"vertical\",\n          \"children\": [\n            \"card_codenames\",\n            \"card_just_one\",\n            \"card_deception\",\n            \"card_resistance\"\n          ]\n        },\n        {\n          \"id\": \"card_codenames\",\n          \"component\": \"Card\",\n          \"child\": \"col_codenames\"\n        },\n        {\n          \"id\": \"col_codenames\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"title_codenames\",\n            \"details_codenames\",\n            \"desc_codenames\",\n            \"btn_codenames_bgg\"\n          ]\n        },\n        {\n          \"id\": \"title_codenames\",\n          \"component\": \"Text\",\n          \"text\": \"Codenames\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"details_codenames\",\n          \"component\": \"Text\",\n          \"text\": \"Team-based word association game | Party / 15 Minutes\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"desc_codenames\",\n          \"component\": \"Text\",\n          \"text\": \"The group splits into two teams, Red and Blue. Each team has a Spymaster who provides one-word clues linked to multiple cards on the table. The goal is for teammates to guess the correct words based on the clue without picking the opposing team's words or the instant-loss Assassin card. It encourages clever thinking and group discussion.\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"btn_codenames_bgg\",\n          \"component\": \"Button\",\n          \"child\": \"btn_codenames_bgg_text\",\n          \"action\": {\n            \"functionCall\": {\n              \"call\": \"openUrl\",\n              \"args\": {\n                \"url\": \"https://boardgamegeek.com/boardgame/178900/codenames\"\n              }\n            }\n          }\n        },\n        {\n          \"id\": \"btn_codenames_bgg_text\",\n          \"component\": \"Text\",\n          \"text\": \"View on BoardGameGeek\"\n        },\n        {\n          \"id\": \"card_just_one\",\n          \"component\": \"Card\",\n          \"child\": \"col_just_one\"\n        },\n        {\n          \"id\": \"col_just_one\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"title_just_one\",\n            \"details_just_one\",\n            \"desc_just_one\",\n            \"btn_just_one_bgg\"\n          ]\n        },\n        {\n          \"id\": \"title_just_one\",\n          \"component\": \"Text\",\n          \"text\": \"Just One\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"details_just_one\",\n          \"component\": \"Text\",\n          \"text\": \"Cooperative guessing game | Party / 20 Minutes\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"desc_just_one\",\n          \"component\": \"Text\",\n          \"text\": \"This is a fully cooperative game where everyone wins or loses together. One player is the guesser, and the other five write one-word clues to help them guess a specific word. The catch is that if any two players write the exact same clue, those clues are erased and the guesser never sees them. It forces players to be creative rather than obvious.\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"btn_just_one_bgg\",\n          \"component\": \"Button\",\n          \"child\": \"btn_just_one_bgg_text\",\n          \"action\": {\n            \"functionCall\": {\n              \"call\": \"openUrl\",\n              \"args\": {\n                \"url\": \"https://boardgamegeek.com/boardgame/254640/just-one\"\n              }\n            }\n          }\n        },\n        {\n          \"id\": \"btn_just_one_bgg_text\",\n          \"component\": \"Text\",\n          \"text\": \"View on BoardGameGeek\"\n        },\n        {\n          \"id\": \"card_deception\",\n          \"component\": \"Card\",\n          \"child\": \"col_deception\"\n        },\n        {\n          \"id\": \"col_deception\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"title_deception\",\n            \"details_deception\",\n            \"desc_deception\",\n            \"btn_deception_bgg\"\n          ]\n        },\n        {\n          \"id\": \"title_deception\",\n          \"component\": \"Text\",\n          \"text\": \"Deception: Murder in Hong Kong\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"id\": \"details_deception\",\n          \"component\": \"Text\",\n          \"text\": \"Crime-solving deduction game | Social Deduction / 20 Minutes\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"desc_deception\",\n          \"component\": \"Text\",\n          \"text\": \"One player is secretly the Murderer, and another is the Forensic Scientist who knows the solution but can only communicate by placing markers on scene tiles (like Cause of Death: Suffocation). The remaining players are investigators trying to interpret these vague clues to identify the murderer and the weapon used. It is less aggressive than other lying games because the focus is on the evidence.\",\n          \"variant\": \"body\"\n        },\n        {\n          \"id\": \"btn_deception_bgg\",\n          \"component\": \"Button\",\n          \"child\": \"btn_deception_bgg_text\",\n          \"action\": {\n            \"functionCall\": {\n              \"call\": \"openUrl\",\n        