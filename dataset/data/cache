      \"id\": \"row5_col1\",\n          \"component\": \"Text\",\n          \"text\": \"5\",\n          \"weight\": 0.5\n        },\n        {\n          \"id\": \"row5_col2\",\n          \"component\": \"Text\",\n          \"text\": \"Nov 9\",\n          \"weight\": 1\n        },\n        {\n          \"id\": \"row5_col3\",\n          \"component\": \"Text\",\n          \"text\": \"Central Kyoto\",\n          \"weight\": 1.5\n        },\n        {\n          \"id\": \"row5_col4\",\n          \"component\": \"Text\",\n          \"text\": \"Kyoto Railway Museum, Last-Minute Souvenir Shopping\",\n          \"weight\": 3\n        },\n        {\n          \"id\": \"details_header\",\n          \"component\": \"Text\",\n          \"variant\": \"h2\",\n          \"text\": \"Detailed Daily Guide\"\n        },\n        {\n          \"id\": \"day1_card\",\n          \"component\": \"Card\",\n          \"child\": \"day1_content\"\n        },\n        {\n          \"id\": \"day1_content\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"day1_title\",\n            \"day1_morning_title\",\n            \"day1_morning_desc\",\n            \"day1_morning_fee\",\n            \"day1_morning_loc\",\n            \"day1_divider1\",\n            \"day1_afternoon_title\",\n            \"day1_afternoon_desc\",\n            \"day1_afternoon_fee\",\n            \"day1_afternoon_loc\",\n            \"day1_divider2\",\n            \"day1_dinner_title\",\n            \"day1_dinner_desc\"\n          ]\n        },\n        {\n          \"id\": \"day1_title\",\n          \"component\": \"Text\",\n          \"variant\": \"h3\",\n          \"text\": \"Day 1: Torii Gates and Autumn Views (Tuesday, Nov 5)\"\n        },\n        {\n          \"id\": \"day1_morning_title\",\n          \"component\": \"Text\",\n          \"variant\": \"h4\",\n          \"text\": \"Morning Activity: Fushimi Inari Shrine\"\n        },\n        {\n          \"id\": \"day1_morning_desc\",\n          \"component\": \"Text\",\n          \"text\": \"Begin your trip with an iconic Kyoto landmark. The thousands of vibrant red torii gates create a magical tunnel that kids will love exploring. You don't need to hike the entire mountain; the first 30-45 minutes of the path are the most impressive and fun for families.\"\n        },\n        {\n          \"id\": \"day1_morning_fee\",\n          \"component\": \"Text\",\n          \"variant\": \"caption\",\n          \"text\": \"Entry Fee: Free.\"\n        },\n        {\n          \"id\": \"day1_morning_loc\",\n          \"component\": \"Text\",\n          \"variant\": \"caption\",\n          \"text\": \"Location: Fushimi Ward. Accessible via JR Inari Station.\"\n        },\n        {\n          \"id\": \"day1_divider1\",\n          \"component\": \"Divider\"\n        },\n        {\n          \"id\": \"day1_afternoon_title\",\n          \"component\": \"Text\",\n          \"variant\": \"h4\",\n          \"text\": \"Afternoon Activity: Tofuku-ji Temple\"\n        },\n        {\n          \"id\": \"day1_afternoon_desc\",\n          \"component\": \"Text\",\n          \"text\": \"A short train ride from Fushimi Inari, this Zen temple is famous for its autumn foliage. The view from the Tsutenkyo Bridge is breathtaking in early November. The large temple grounds provide ample space for kids to walk around.\"\n        },\n        {\n          \"id\": \"day1_afternoon_fee\",\n          \"component\": \"Text\",\n          \"variant\": \"caption\",\n          \"text\": \"Entry Fee: Approx. ¥1000 for access to Tsutenkyo Bridge & Kaisando Hall.\"\n        },\n        {\n          \"id\": \"day1_afternoon_loc\",\n          \"component\": \"Text\",\n          \"variant\": \"caption\",\n          \"text\": \"Location: Higashiyama Ward. Accessible via JR Tofukuji Station.\"\n        },\n        {\n          \"id\": \"day1_divider2\",\n          \"component\": \"Divider\"\n        },\n        {\n          \"id\": \"day1_dinner_title\",\n          \"component\": \"Text\",\n          \"variant\": \"h4\",\n          \"text\": \"Dinner Suggestion: Kyoto Ramen Koji (Ramen Street)\"\n        },\n        {\n          \"id\": \"day1_dinner_desc\",\n          \"component\": \"Text\",\n          \"text\": \"Located on the 10th floor of the Kyoto Station building, this food court features ramen shops from all over Japan. It's a fun, casual, and delicious way to please everyone in the family.\"\n        },\n        {\n          \"id\": \"day2_card\",\n          \"component\": \"Card\",\n          \"child\": \"day2_content\"\n        },\n        {\n          \"id\": \"day2_content\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"day2_title\",\n            \"day2_morning_title\",\n            \"day2_morning_desc\",\n            \"day2_morning_fee\",\n            \"day2_morning_loc\",\n            \"day2_divider1\",\n            \"day2_afternoon_title\",\n            \"day2_afternoon_desc\",\n            \"day2_afternoon_fee\",\n            \"day2_afternoon_loc\",\n            \"day2_divider2\",\n            \"day2_dinner_title\",\n            \"day2_dinner_desc\"\n          ]\n        },\n        {\n          \"id\": \"day2_title\",\n          \"component\": \"Text\",\n          \"variant\": \"h3\",\n          \"text\": \"Day 2: Monkeys and Bamboo Groves (Wednesday, Nov 6)\"\n        },\n        {\n          \"id\": \"day2_morning_title\",\n          \"component\": \"Text\",\n          \"variant\": \"h4\",\n          \"text\": \"Morning Activity: Arashiyama Bamboo Grove & Tenryu-ji Temple\"\n        },\n        {\n          \"id\": \"day2_morning_desc\",\n          \"component\": \"Text\",\n          \"text\": \"Arrive early to experience the ethereal beauty of the bamboo grove with fewer crowds. Afterward, visit the adjacent Tenryu-ji Temple, a UNESCO World Heritage site with a stunning landscape garden that looks beautiful against the backdrop of the Arashiyama mountains.\"\n        },\n        {\n          \"id\": \"day2_morning_fee\",\n          \"component\": \"Text\",\n          \"variant\": \"caption\",\n          \"text\": \"Entry Fee: Bamboo Grove is free. Tenryu-ji Temple is approx. ¥500 (garden only).\"\n        },\n        {\n          \"id\": \"day2_morning_loc\",\n          \"component\": \"Text\",\n          \"variant\": \"caption\",\n          \"text\": \"Location: Arashiyama (Western Kyoto). Accessible via JR Saga-Arashiyama Station.\"\n        },\n        {\n          \"id\": \"day2_divider1\",\n          \"component\": \"Divider\"\n        },\n        {\n          \"id\": \"day2_afternoon_title\",\n          \"component\": \"Text\",\n          \"variant\": \"h4\",\n          \"text\": \"Afternoon Activity: Iwatayama Monkey Park\"\n        },\n        {\n          \"id\": \"day2_afternoon_desc\",\n          \"component\": \"Text\",\n          \"text\": \"After crossing the scenic Togetsukyo Bridge, embark on a 20-minute uphill hike to this park where Japanese macaques roam freely. The kids will love watching the monkeys, and the panoramic view of Kyoto from the top is a fantastic reward.\"\n        },\n        {\n          \"id\": \"day2_afternoon_fee\",\n          \"component\": \"Text\",\n          \"variant\": \"caption\",\n          \"text\": \"Entry Fee: Approx. ¥600 Adult / ¥300 Child.\"\n        },\n        {\n          \"id\": \"day2_afternoon_loc\",\n          \"component\": \"Text\",\n          \"variant\": \"caption\",\n          \"text\": \"Location: Arashiyama.\"\n        },\n        {\n          \"id\": \"day2_divider2\",\n          \"component\": \"Divider\"\n        },\n        {\n          \"id\": \"day2_dinner_title\",\n          \"component\": \"Text\",\n          \"variant\": \"h4\",\n          \"text\": \"Dinner Suggestion: Arashiyama Casual Dining\"\n        },\n        {\n          \"id\": \"day2_dinner_desc\",\n          \"component\": \"Text\",\n          \"text\": \"While Arashiyama is known for traditional Yudofu (simmered tofu), you can find many family-friendly restaurants near the Togetsukyo Bridge serving tempura, soba noodles, and other popular dishes.\"\n        },\n        {\n          \"id\": \"day3_card\",\n          \"component\": \"Card\",\n          \"child\": \"day3_content\"\n        },\n        {\n          \"id\": \"day3_content\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"day3_title\",\n            \"day3_morning_title\",\n            \"day3_morning_desc\",\n            \"day3_morning_fee\",\n            \"day3_morning_loc\",\n            \"day3_divider1\",\n            \"day3_afternoon_title\",\n            \"day3_afternoon_desc\",\n            \"day3_afternoon_fee\",\n            \"day3_afternoon_loc\",\n            \"day3_divider2\",\n            \"day3_dinner_title\",\n            \"day3_dinner_desc\"\n          ]\n        },\n        {\n          \"id\": \"day3_title\",\n          \"component\": \"Text\",\n          \"variant\": \"h3\",\n          \"text\": \"Day 3: Golden Pavilions and Samurai Action (Thursday, Nov 7)\"\n        },\n        {\n          \"id\": \"day3_morning_title\",\n          \"component\": \"Text\",\n          \"variant\": \"h4\",\n          \"text\": \"Morning Activity: Kinkaku-ji (The Golden Pavilion)\"\n        },\n        {\n          \"id\": \"day3_morning_desc\",\n          \"component\": \"Text\",\n          \"text\": \"One of Kyoto's most famous sights, this Zen temple is covered in gold leaf. The reflection in the surrounding pond is picture-perfect. The route through the grounds is straightforward and doesn't take too long, holding children's attention well.\"\n        },\n        {\n          \"id\": \"day3_morning_fee\",\n          \"component\": \"Text\",\n          \"variant\": \"caption\",\n          \"text\": \"Entry Fee: Approx. ¥500.\"\n        },\n        {\n          \"id\": \"day3_morning_loc\",\n          \"component\": \"Text\",\n          \"variant\": \"caption\",\n          \"text\": \"Location: Northern Kyoto.\"\n        },\n        {\n          \"id\": \"day3_divider1\",\n          \"component\": \"Divider\"\n        },\n        {\n          \"id\": \"day3_afternoon_title\",\n          \"component\": \"Text\",\n          \"variant\": \"h4\",\n          \"text\": \"Afternoon Activity: Toei Kyoto Studio Park (Eigamura)\"\n        },\n        {\n          \"id\": \"day3_afternoon_desc\",\n          \"component\": \"Text\",\n          \"text\": \"A working film set and theme park rolled into one. Explore a replica Edo-period town, watch a live ninja show, try a haunted house, and see samurai movie magic. It's highly interactive and a great contrast to the morning's temple visit.\"\n        },\n        {\n          \"id\": \"day3_afternoon_fee\",\n          \"component\": \"Text\",\n          \"variant\": \"caption\",\n          \"text\": \"Entry Fee: Approx. ¥2400 Adult / ¥1200 Child.\"\n        },\n        {\n          \"id\": \"day3_afternoon_loc\",\n          \"component\": \"Text\",\n          \"variant\": \"caption\",\n          \"text\": \"Location: Ukyo Ward.\"\n        },\n        {\n          \"id\": \"day3_divider2\",\n          \"component\": \"Divider\"\n        },\n        {\n          \"id\": \"day3_dinner_title\",\n          \"component\": \"Text\",\n          \"variant\": \"h4\",\n          \"text\": \"Dinner Suggestion: Okonomiyaki & Yakisoba\"\n        },\n        {\n          \"id\": \"day3_dinner_desc\",\n          \"component\": \"Text\",\n          \"text\": \"Find a local restaurant specializing in okonomiyaki (savory pancake) and yakisoba (fried noodles). Kids often enjoy these dishes, especially if you can sit at a counter where the chef cooks on a large griddle in front of you.\"\n        },\n        {\n          \"id\": \"day4_card\",\n          \"component\": \"Card\",\n          \"child\": \"day4_content\"\n        },\n        {\n          \"id\": \"day4_content\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"day4_title\",\n            \"day4_morning_title\",\n            \"day4_morning_desc\",\n            \"day4_morning_fee\",\n            \"day4_morning_loc\",\n            \"day4_divider1\",\n            \"day4_afternoon_title\",\n            \"day4_afternoon_desc\",\n            \"day4_afternoon_fee\",\n            \"day4_afternoon_loc\",\n            \"day4_divider2\",\n            \"day4_dinner_title\",\n            \"day4_dinner_desc\"\n          ]\n        },\n        {\n          \"id\": \"day4_title\",\n          \"component\": \"Text\",\n          \"variant\": \"h3\",\n          \"text\": \"Day 4: Historic Streets and Market Flavors (Friday, Nov 8)\"\n        },\n        {\n          \"id\": \"day4_morning_title\",\n          \"component\": \"Text\",\n          \"variant\": \"h4\",\n          \"text\": \"Morning Activity: Kiyomizu-dera Temple & Higashiyama Streets\"\n        },\n        {\n          \"id\": \"day4_morning_desc\",\n          \"component\": \"Text\",\n          \"text\": \"Visit this magnificent wooden temple perched on a hillside with sweeping views of the city. The walk up to the temple through the historic, preserved streets of Sannenzaka and Ninenzaka is part of the experience, with many small shops and snack stalls.\"\n        },\n        {\n          \"id\": \"day4_morning_fee\",\n          \"component\": \"Text\",\n          \"variant\": \"caption\",\n          \"text\": \"Entry Fee: Approx. ¥400.\"\n        },\n        {\n          \"id\": \"day4_morning_loc\",\n          \"component\": \"Text\",\n          \"variant\": \"caption\",\n          \"text\": \"Location: Eastern Kyoto.\"\n        },\n        {\n          \"id\": \"day4_divider1\",\n          \"component\": \"Divider\"\n        },\n        {\n          \"id\": \"day4_afternoon_title\",\n          \"component\": \"Text\",\n          \"variant\": \"h4\",\n          \"text\": \"Afternoon Activity: Nishiki Market\"