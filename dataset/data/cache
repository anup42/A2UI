{"prompt_hash": "ee5b8ac899238f978eb3f453e0f9ad5c1761f62c8f8f08fda571ca61ad25dc32", "text": "[\n  {\n    \"version\": \"v0.9\",\n    \"createSurface\": {\n      \"surfaceId\": \"recipe_risotto\",\n      \"catalogId\": \"https://genui.local/specification/v0_9/standard_catalog.json\"\n    }\n  },\n  {\n    \"version\": \"v0.9\",\n    \"updateComponents\": {\n      \"surfaceId\": \"recipe_risotto\",\n      \"components\": [\n        {\n          \"component\": \"Column\",\n          \"id\": \"root\",\n          \"children\": [\n            \"title_overview\",\n            \"text_overview\",\n            \"image_risotto_plating\",\n            \"title_context\",\n            \"text_context\",\n            \"title_instructions\",\n            \"section_ingredients\",\n            \"section_steps\",\n            \"title_phases\",\n            \"table_phases\",\n            \"title_media\",\n            \"image_arborio_texture\",\n            \"image_cooking_process\",\n            \"title_sources\",\n            \"list_sources\"\n          ]\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"title_overview\",\n          \"text\": \"Creamy Vegan Mushroom Risotto Overview\",\n          \"variant\": \"h2\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"text_overview\",\n          \"text\": \"This recipe creates a rich, velvety risotto for 4 people without using dairy. The key to the creamy texture lies in the high starch content of Arborio rice and the agitation process (stirring), which releases that starch into the broth. We will use a mix of mushrooms for depth of flavor and finish with a \\\"mantecatura\\\" technique using vegan fat to emulsify the sauce.\"\n        },\n        {\n          \"component\": \"Image\",\n          \"id\": \"image_risotto_plating\",\n          \"url\": \"../assets/r_000701_01_1_mushroom-risotto.jpg\",\n          \"variant\": \"largeFeature\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"title_context\",\n          \"text\": \"Kitchen & Ingredient Context\",\n          \"variant\": \"h3\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"text_context\",\n          \"text\": \"This recipe assumes you have a heavy-bottomed pot or Dutch oven to distribute heat evenly. We assume the use of dry white wine (like Pinot Grigio or Sauvignon Blanc) to deglaze the pan, but you can substitute extra vegetable broth mixed with a teaspoon of lemon juice or white wine vinegar if you prefer an alcohol-free version. We also assume the use of store-bought low-sodium vegetable broth, but homemade stock works excellently.\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"title_instructions\",\n          \"text\": \"Step-by-Step Cooking Instructions\",\n          \"variant\": \"h3\"\n        },\n        {\n          \"component\": \"Column\",\n          \"id\": \"section_ingredients\",\n          \"children\": [\n            \"heading_ingredients\",\n            \"list_ingredients\"\n          ]\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"heading_ingredients\",\n          \"text\": \"Ingredients:\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"component\": \"List\",\n          \"id\": \"list_ingredients\",\n          \"direction\": \"vertical\",\n          \"children\": [\n            \"ingredient_item_1\",\n            \"ingredient_item_2\",\n            \"ingredient_item_3\",\n            \"ingredient_item_4\",\n            \"ingredient_item_5\",\n            \"ingredient_item_6\",\n            \"ingredient_item_7\",\n            \"ingredient_item_8\",\n            \"ingredient_item_9\",\n            \"ingredient_item_10\",\n            \"ingredient_item_11\"\n          ]\n        },\n        {\n          \"component\": \"Row\",\n          \"id\": \"ingredient_item_1\",\n          \"children\": [\"icon_basket_1\", \"text_ingredient_1\"],\n          \"align\": \"center\"\n        },\n        {\n          \"component\": \"Icon\",\n          \"id\": \"icon_basket_1\",\n          \"name\": \"../assets/r_000701_01_6_basket.svg\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"text_ingredient_1\",\n          \"text\": \"1.5 cups Arborio rice (do not rinse, as starch is needed)\"\n        },\n        {\n          \"component\": \"Row\",\n          \"id\": \"ingredient_item_2\",\n          \"children\": [\"icon_basket_2\", \"text_ingredient_2\"],\n          \"align\": \"center\"\n        },\n        {\n          \"component\": \"Icon\",\n          \"id\": \"icon_basket_2\",\n          \"name\": \"../assets/r_000701_01_6_basket.svg\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"text_ingredient_2\",\n          \"text\": \"5 to 6 cups vegetable broth (kept warm in a separate pot)\"\n        },\n        {\n          \"component\": \"Row\",\n          \"id\": \"ingredient_item_3\",\n          \"children\": [\"icon_basket_3\", \"text_ingredient_3\"],\n          \"align\": \"center\"\n        },\n        {\n          \"component\": \"Icon\",\n          \"id\": \"icon_basket_3\",\n          \"name\": \"../assets/r_000701_01_6_basket.svg\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"text_ingredient_3\",\n          \"text\": \"1 lb mixed mushrooms (cremini, shiitake, oyster), sliced\"\n        },\n        {\n          \"component\": \"Row\",\n          \"id\": \"ingredient_item_4\",\n          \"children\": [\"icon_basket_4\", \"text_ingredient_4\"],\n          \"align\": \"center\"\n        },\n        {\n          \"component\": \"Icon\",\n          \"id\": \"icon_basket_4\",\n          \"name\": \"../assets/r_000701_01_6_basket.svg\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"text_ingredient_4\",\n          \"text\": \"2 shallots, finely minced\"\n        },\n        {\n          \"component\": \"Row\",\n          \"id\": \"ingredient_item_5\",\n          \"children\": [\"icon_basket_5\", \"text_ingredient_5\"],\n          \"align\": \"center\"\n        },\n        {\n          \"component\": \"Icon\",\n          \"id\": \"icon_basket_5\",\n          \"name\": \"../assets/r_000701_01_6_basket.svg\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"text_ingredient_5\",\n          \"text\": \"3 cloves garlic, minced\"\n        },\n        {\n          \"component\": \"Row\",\n          \"id\": \"ingredient_item_6\",\n          \"children\": [\"icon_basket_6\", \"text_ingredient_6\"],\n          \"align\": \"center\"\n        },\n        {\n          \"component\": \"Icon\",\n          \"id\": \"icon_basket_6\",\n          \"name\": \"../assets/r_000701_01_6_basket.svg\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"text_ingredient_6\",\n          \"text\": \"0.5 cup dry white wine\"\n        },\n        {\n          \"component\": \"Row\",\n          \"id\": \"ingredient_item_7\",\n          \"children\": [\"icon_basket_7\", \"text_ingredient_7\"],\n          \"align\": \"center\"\n        },\n        {\n          \"component\": \"Icon\",\n          \"id\": \"icon_basket_7\",\n          \"name\": \"../assets/r_000701_01_6_basket.svg\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"text_ingredient_7\",\n          \"text\": \"3 tbsp olive oil (divided)\"\n        },\n        {\n          \"component\": \"Row\",\n          \"id\": \"ingredient_item_8\",\n          \"children\": [\"icon_basket_8\", \"text_ingredient_8\"],\n          \"align\": \"center\"\n        },\n        {\n          \"component\": \"Icon\",\n          \"id\": \"icon_basket_8\",\n          \"name\": \"../assets/r_000701_01_6_basket.svg\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"text_ingredient_8\",\n          \"text\": \"2 tbsp vegan butter (or extra olive oil)\"\n        },\n        {\n          \"component\": \"Row\",\n          \"id\": \"ingredient_item_9\",\n          \"children\": [\"icon_basket_9\", \"text_ingredient_9\"],\n          \"align\": \"center\"\n        },\n        {\n          \"component\": \"Icon\",\n          \"id\": \"icon_basket_9\",\n          \"name\": \"../assets/r_000701_01_6_basket.svg\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"text_ingredient_9\",\n          \"text\": \"0.25 cup nutritional yeast (optional, for cheesy flavor)\"\n        },\n        {\n          \"component\": \"Row\",\n          \"id\": \"ingredient_item_10\",\n          \"children\": [\"icon_basket_10\", \"text_ingredient_10\"],\n          \"align\": \"center\"\n        },\n        {\n          \"component\": \"Icon\",\n          \"id\": \"icon_basket_10\",\n          \"name\": \"../assets/r_000701_01_6_basket.svg\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"text_ingredient_10\",\n          \"text\": \"1 tbsp fresh thyme leaves\"\n        },\n        {\n          \"component\": \"Row\",\n          \"id\": \"ingredient_item_11\",\n          \"children\": [\"icon_basket_11\", \"text_ingredient_11\"],\n          \"align\": \"center\"\n        },\n        {\n          \"component\": \"Icon\",\n          \"id\": \"icon_basket_11\",\n          \"name\": \"../assets/r_000701_01_6_basket.svg\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"text_ingredient_11\",\n          \"text\": \"Salt and black pepper to taste; Fresh parsley for garnish\"\n        },\n        {\n          \"component\": \"Column\",\n          \"id\": \"section_steps\",\n          \"children\": [\n            \"heading_steps\",\n            \"list_steps\"\n          ]\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"heading_steps\",\n          \"text\": \"Instructions:\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"component\": \"List\",\n          \"id\": \"list_steps\",\n          \"direction\": \"vertical\",\n          \"children\": [\n            \"step_1_card\",\n            \"step_2_card\",\n            \"step_3_card\",\n            \"step_4_card\",\n            \"step_5_card\",\n            \"step_6_card\"\n          ]\n        },\n        {\n          \"component\": \"Card\",\n          \"id\": \"step_1_card\",\n          \"child\": \"step_1_content\"\n        },\n        {\n          \"component\": \"Column\",\n          \"id\": \"step_1_content\",\n          \"children\": [\n            \"step_1_title\",\n            \"text_step_1_body\"\n          ]\n        },\n        {\n          \"component\": \"Row\",\n          \"id\": \"step_1_title\",\n          \"children\": [\"icon_fire_1\", \"text_step_1_title\"],\n          \"align\": \"center\"\n        },\n        {\n          \"component\": \"Icon\",\n          \"id\": \"icon_fire_1\",\n          \"name\": \"../assets/r_000701_01_4_fire.svg\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"text_step_1_title\",\n          \"text\": \"1. Warm the Broth:\",\n          \"variant\": \"h5\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"text_step_1_body\",\n          \"text\": \"Pour the vegetable broth into a saucepan and keep it on a low simmer next to your main cooking pot. Cold broth shocks the rice and stops the cooking process, preventing the creamy texture from developing.\"\n        },\n        {\n          \"component\": \"Card\",\n          \"id\": \"step_2_card\",\n          \"child\": \"step_2_content\"\n        },\n        {\n          \"component\": \"Column\",\n          \"id\": \"step_2_content\",\n          \"children\": [\n            \"step_2_title\",\n            \"text_step_2_body\"\n          ]\n        },\n        {\n          \"component\": \"Row\",\n          \"id\": \"step_2_title\",\n          \"children\": [\"icon_fire_2\", \"text_step_2_title\"],\n          \"align\": \"center\"\n        },\n        {\n          \"component\": \"Icon\",\n          \"id\": \"icon_fire_2\",\n          \"name\": \"../assets/r_000701_01_4_fire.svg\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"text_step_2_title\",\n          \"text\": \"2. Sauté the Mushrooms:\",\n          \"variant\": \"h5\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"text_step_2_body\",\n          \"text\": \"In your heavy-bottomed pot, heat 1 tablespoon of olive oil over medium-high heat. Add the sliced mushrooms and cook until browned and their liquid has evaporated (about 5-8 minutes). Season with a pinch of salt. Remove mushrooms from the pot and set aside. This prevents them from getting rubbery during the rice cooking.\"\n        },\n        {\n          \"component\": \"Card\",\n          \"id\": \"step_3_card\",\n          \"child\": \"step_3_content\"\n        },\n        {\n          \"component\": \"Column\",\n          \"id\": \"step_3_content\",\n          \"children\": [\n            \"step_3_title\",\n            \"text_step_3_body\"\n          ]\n        },\n        {\n          \"component\": \"Row\",\n          \"id\": \"step_3_title\",\n          \"children\": [\"icon_fire_3\", \"text_step_3_title\"],\n          \"align\": \"center\"\n        },\n        {\n          \"component\": \"Icon\",\n          \"id\": \"icon_fire_3\",\n          \"name\": \"../assets/r_000701_01_4_fire.svg\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"text_step_3_title\",\n          \"text\": \"3. Aromatics and Toasting:\",\n          \"variant\": \"h5\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"text_step_3_body\",\n          \"text\": \"Reduce heat to medium. Add the remaining 2 tablespoons of olive oil to the pot. Add shallots and cook until softened (2-3 minutes). Add garlic and thyme, cooking for another minute until fragrant. Add the Arborio rice. Toast the rice, stirring constantly, for 1-2 minutes until the edges are translucent and the center remains opaque. This toasting step creates a shell around the grain so it doesn't turn to mush while slowly releasing starch.\"\n        },\n        {\n          \"component\": \"Card\",\n          \"id\": \"step_4_card\",\n          \"child\": \"step_4_content\"\n        },\n        {\n          \"component\": \"Column\",\n          \"id\": \"step_4_content\",\n          \"children\": [\n            \"step_4_title\",\n            \"text_step_4_body\"\n          ]\n        },\n        {\n          \"component\": \"Row\",\n          \"id\": \"step_4_title\",\n          \"children\": [\"icon_fire_4\", \"text_step_4_title\"],\n          \"align\": \"center\"\n        },\n        {\n          \"component\": \"Icon\",\n          \"id\": \"icon_fire_4\",\n          \"name\": \"../assets/r_000701_01_4_fire.svg\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"text_step_4_title\",\n          \"text\": \"4. Deglaze:\",\n          \"variant\": \"h5\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"text_step_4_body\",\n          \"text\": \"Pour in the white wine. Stir constantly until the wine is fully absorbed by the rice.\"\n        },\n        {\n          \"component\": \"Card\",\n          \"id\": \"step_5_card\",\n          \"child\": \"step_5_content\"\n        },\n        {\n          \"component\": \"Column\",\n          \"id\": \"step_5_content\",\n          \"children\": [\n            \"step_5_title\",\n            \"text_step_5_body\"\n          ]\n        },\n        {\n          \"component\": \"Row\",\n          \"id\": \"step_5_title\",\n          \"children\": [\"icon_clock_1\", \"text_step_5_title\"],\n          \"align\": \"center\"\n        },\n        {\n          \"component\": \"Icon\",\n          \"id\": \"icon_clock_1\",\n          \"name\": \"../assets/r_000701_01_5_clock.svg\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"text_step_5_title\",\n          \"text\": \"5. The Risotto Method:\",\n          \"variant\": \"h5\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"text_step_5_body\",\n          \"text\": \"Begin adding the warm broth, one ladle (about 0.5 cup) at a time. Stir frequently. Wait until the liquid is almost completely absorbed before adding the next ladle. The friction from stirring rubs the grains together, releasing the starch that creates the creamy sauce. Repeat this process for about 20-25 minutes. The rice is done when it is tender but still has a slight bite (al dente).\"\n        },\n        {\n          \"component\": \"Card\",\n          \"id\": \"step_6_card\",\n          \"child\": \"step_6_content\"\n        },\n        {\n          \"component\": \"Column\",\n          \"id\": \"step_6_content\",\n          \"children\": [\n            \"step_6_title\",\n            \"text_step_6_body\"\n          ]\n        },\n        {\n          \"component\": \"Row\",\n          \"id\": \"step_6_title\",\n          \"children\": [\"icon_fire_5\", \"text_step_6_title\"],\n          \"align\": \"center\"\n        },\n        {\n          \"component\": \"Icon\",\n          \"id\": \"icon_fire_5\",\n          \"name\": \"../assets/r_000701_01_4_fire.svg\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"text_step_6_title\",\n          \"text\": \"6. The Finish (Mantecatura):\",\n          \"variant\": \"h5\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"text_step_6_body\",\n          \"text\": \"Remove the pot from the heat. This is crucial. Stir in the cooked mushrooms, vegan butter, and nutritional yeast. Vigorously stir the mixture for 30 seconds to emulsify the fats with the starch. This step guarantees the creamy mouthfeel without dairy. Season with salt and pepper to taste. Garnish with fresh parsley and serve immediately.\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"title_phases\",\n          \"text\": \"Risotto Cooking Phases\",\n          \"variant\": \"h3\"\n        },\n        {\n          \"component\": \"List\",\n          \"id\": \"table_phases\",\n          \"direction\": \"vertical\",\n          \"children\": [\n            \"table_header_row\",\n            \"phase_row_1\",\n            \"phase_row_2\",\n            \"phase_row_3\",\n            \"phase_row_4\"\n          ]\n        },\n        {\n          \"component\": \"Row\",\n          \"id\": \"table_header_row\",\n          \"children\": [\n            \"text_phase_header\",\n            \"text_duration_header\",\n            \"text_key_action_header\"\n          ],\n          \"justify\": \"spaceBetween\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"text_phase_header\",\n          \"text\": \"Phase\",\n          \"variant\": \"h5\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"text_duration_header\",\n          \"text\": \"Duration\",\n          \"variant\": \"h5\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"text_key_action_header\",\n          \"text\": \"Key Action\",\n          \"variant\": \"h5\"\n        },\n        {\n          \"component\": \"Row\",\n          \"id\": \"phase_row_1\",\n          \"children\": [\n            \"text_phase_1\",\n            \"text_duration_1\",\n            \"text_key_action_1\"\n          ],\n          \"justify\": \"spaceBetween\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"text_phase_1\",\n          \"text\": \"Prep\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"text_duration_1\",\n          \"text\": \"10-15 mins\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"text_key_action_1\",\n          \"text\": \"Chop vegetables, slice mushrooms, warm broth\"\n        },\n        {\n          \"component\": \"Row\",\n          \"id\": \"phase_row_2\",\n          \"children\": [\n            \"text_phase_2\",\n            \"text_duration_2\",\n            \"text_key_action_2\"\n          ],\n          \"justify\": \"spaceBetween\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"text_phase_2\",\n          \"text\": \"Sauté\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"text_duration_2\",\n          \"text\": \"8-10 mins\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"text_key_action_2\",\n          \"text\": \"Brown mushrooms, sweat shallots, toast rice\"\n        },\n        {\n          \"component\": \"Row\",\n          \"id\": \"phase_row_3\",\n          \"children\": [\n            \"text_phase_3\",\n            \"text_duration_3\",\n            \"text_key_action_3\"\n          ],\n          \"justify\": \"spaceBetween\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"text_phase_3\",\n          \"text\": \"Simmer\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"text_duration_3\",\n          \"text\": \"20-25 mins\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"text_key_action_3\",\n          \"text\": \"Add broth gradually, stir frequently to release starch\"\n        },\n        {\n          \"component\": \"Row\",\n          \"id\": \"phase_row_4\",\n          \"children\": [\n            \"text_phase_4\",\n            \"text_duration_4\",\n            \"text_key_action_4\"\n          ],\n          \"justify\": \"spaceBetween\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"text_phase_4\",\n          \"text\": \"Rest\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"text_duration_4\",\n          \"text\": \"2-3 mins\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"text_key_action_4\",\n          \"text\": \"Remove from heat, beat in fat (mantecatura) for creaminess\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"title_media\",\n          \"text\": \"Visual Guides\",\n          \"variant\": \"h3\"\n        },\n        {\n          \"component\": \"Image\",\n          \"id\": \"image_arborio_texture\",\n          \"url\": \"../assets/r_000701_01_2_arborio-rice.jpg\",\n          \"variant\": \"mediumFeature\",\n          \"accessibility\": {\n            \"label\": \"Arborio Rice Texture\"\n          }\n        },\n        {\n          \"component\": \"Image\",\n          \"id\": \"image_cooking_process\",\n          \"url\": \"../assets/r_000701_01_3_cooking-rice.jpg\",\n          \"variant\": \"mediumFeature\",\n          \"accessibility\": {\n            \"label\": \"Risotto Cooking Process\"\n          }\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"title_sources\",\n          \"text\": \"Sources\",\n          \"variant\": \"h3\"\n        },\n        {\n          \"component\": \"List\",\n          \"id\": \"list_sources", "raw": {"candidates": [{"content": {"role": "model", "parts": [{"text": "[\n  {\n    \"version\": \"v0.9\",\n    \"createSurface\": {\n      \"surfaceId\": \"recipe_risotto\",\n      \"catalogId\": \"https://genui.local/specification/v0_9/standard_catalog.json\"\n    }\n  },\n  {\n    \"version\": \"v0.9\",\n    \"updateComponents\": {\n      \"surfaceId\": \"recipe_risotto\",\n      \"components\": [\n        {\n          \"component\": \"Column\",\n          \"id\": \"root\",\n          \"children\": [\n            \"title_overview\",\n            \"text_overview\",\n            \"image_risotto_plating\",\n            \"title_context\",\n            \"text_context\",\n            \"title_instructions\",\n            \"section_ingredients\",\n            \"section_steps\",\n            \"title_phases\",\n            \"table_phases\",\n            \"title_media\",\n            \"image_arborio_texture\",\n            \"image_cooking_process\",\n            \"title_sources\",\n            \"list_sources\"\n          ]\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"title_overview\",\n          \"text\": \"Creamy Vegan Mushroom Risotto Overview\",\n          \"variant\": \"h2\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"text_overview\",\n          \"text\": \"This recipe creates a rich, velvety risotto for 4 people without using dairy. The key to the creamy texture lies in the high starch content of Arborio rice and the agitation process (stirring), which releases that starch into the broth. We will use a mix of mushrooms for depth of flavor and finish with a \\\"mantecatura\\\" technique using vegan fat to emulsify the sauce.\"\n        },\n        {\n          \"component\": \"Image\",\n          \"id\": \"image_risotto_plating\",\n          \"url\": \"../assets/r_000701_01_1_mushroom-risotto.jpg\",\n          \"variant\": \"largeFeature\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"title_context\",\n          \"text\": \"Kitchen & Ingredient Context\",\n          \"variant\": \"h3\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"text_context\",\n          \"text\": \"This recipe assumes you have a heavy-bottomed pot or Dutch oven to distribute heat evenly. We assume the use of dry white wine (like Pinot Grigio or Sauvignon Blanc) to deglaze the pan, but you can substitute extra vegetable broth mixed with a teaspoon of lemon juice or white wine vinegar if you prefer an alcohol-free version. We also assume the use of store-bought low-sodium vegetable broth, but homemade stock works excellently.\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"title_instructions\",\n          \"text\": \"Step-by-Step Cooking Instructions\",\n          \"variant\": \"h3\"\n        },\n        {\n          \"component\": \"Column\",\n          \"id\": \"section_ingredients\",\n          \"children\": [\n            \"heading_ingredients\",\n            \"list_ingredients\"\n          ]\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"heading_ingredients\",\n          \"text\": \"Ingredients:\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"component\": \"List\",\n          \"id\": \"list_ingredients\",\n          \"direction\": \"vertical\",\n          \"children\": [\n            \"ingredient_item_1\",\n            \"ingredient_item_2\",\n            \"ingredient_item_3\",\n            \"ingredient_item_4\",\n            \"ingredient_item_5\",\n            \"ingredient_item_6\",\n            \"ingredient_item_7\",\n            \"ingredient_item_8\",\n            \"ingredient_item_9\",\n            \"ingredient_item_10\",\n            \"ingredient_item_11\"\n          ]\n        },\n        {\n          \"component\": \"Row\",\n          \"id\": \"ingredient_item_1\",\n          \"children\": [\"icon_basket_1\", \"text_ingredient_1\"],\n          \"align\": \"center\"\n        },\n        {\n          \"component\": \"Icon\",\n          \"id\": \"icon_basket_1\",\n          \"name\": \"../assets/r_000701_01_6_basket.svg\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"text_ingredient_1\",\n          \"text\": \"1.5 cups Arborio rice (do not rinse, as starch is needed)\"\n        },\n        {\n          \"component\": \"Row\",\n          \"id\": \"ingredient_item_2\",\n          \"children\": [\"icon_basket_2\", \"text_ingredient_2\"],\n          \"align\": \"center\"\n        },\n        {\n          \"component\": \"Icon\",\n          \"id\": \"icon_basket_2\",\n          \"name\": \"../assets/r_000701_01_6_basket.svg\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"text_ingredient_2\",\n          \"text\": \"5 to 6 cups vegetable broth (kept warm in a separate pot)\"\n        },\n        {\n          \"component\": \"Row\",\n          \"id\": \"ingredient_item_3\",\n          \"children\": [\"icon_basket_3\", \"text_ingredient_3\"],\n          \"align\": \"center\"\n        },\n        {\n          \"component\": \"Icon\",\n          \"id\": \"icon_basket_3\",\n          \"name\": \"../assets/r_000701_01_6_basket.svg\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"text_ingredient_3\",\n          \"text\": \"1 lb mixed mushrooms (cremini, shiitake, oyster), sliced\"\n        },\n        {\n          \"component\": \"Row\",\n          \"id\": \"ingredient_item_4\",\n          \"children\": [\"icon_basket_4\", \"text_ingredient_4\"],\n          \"align\": \"center\"\n        },\n        {\n          \"component\": \"Icon\",\n          \"id\": \"icon_basket_4\",\n          \"name\": \"../assets/r_000701_01_6_basket.svg\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"text_ingredient_4\",\n          \"text\": \"2 shallots, finely minced\"\n        },\n        {\n          \"component\": \"Row\",\n          \"id\": \"ingredient_item_5\",\n          \"children\": [\"icon_basket_5\", \"text_ingredient_5\"],\n          \"align\": \"center\"\n        },\n        {\n          \"component\": \"Icon\",\n          \"id\": \"icon_basket_5\",\n          \"name\": \"../assets/r_000701_01_6_basket.svg\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"text_ingredient_5\",\n          \"text\": \"3 cloves garlic, minced\"\n        },\n        {\n          \"component\": \"Row\",\n          \"id\": \"ingredient_item_6\",\n          \"children\": [\"icon_basket_6\", \"text_ingredient_6\"],\n          \"align\": \"center\"\n        },\n        {\n          \"component\": \"Icon\",\n          \"id\": \"icon_basket_6\",\n          \"name\": \"../assets/r_000701_01_6_basket.svg\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"text_ingredient_6\",\n          \"text\": \"0.5 cup dry white wine\"\n        },\n        {\n          \"component\": \"Row\",\n          \"id\": \"ingredient_item_7\",\n          \"children\": [\"icon_basket_7\", \"text_ingredient_7\"],\n          \"align\": \"center\"\n        },\n        {\n          \"component\": \"Icon\",\n          \"id\": \"icon_basket_7\",\n          \"name\": \"../assets/r_000701_01_6_basket.svg\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"text_ingredient_7\",\n          \"text\": \"3 tbsp olive oil (divided)\"\n        },\n        {\n          \"component\": \"Row\",\n          \"id\": \"ingredient_item_8\",\n          \"children\": [\"icon_basket_8\", \"text_ingredient_8\"],\n          \"align\": \"center\"\n        },\n        {\n          \"component\": \"Icon\",\n          \"id\": \"icon_basket_8\",\n          \"name\": \"../assets/r_000701_01_6_basket.svg\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"text_ingredient_8\",\n          \"text\": \"2 tbsp vegan butter (or extra olive oil)\"\n        },\n        {\n          \"component\": \"Row\",\n          \"id\": \"ingredient_item_9\",\n          \"children\": [\"icon_basket_9\", \"text_ingredient_9\"],\n          \"align\": \"center\"\n        },\n        {\n          \"component\": \"Icon\",\n          \"id\": \"icon_basket_9\",\n          \"name\": \"../assets/r_000701_01_6_basket.svg\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"text_ingredient_9\",\n          \"text\": \"0.25 cup nutritional yeast (optional, for cheesy flavor)\"\n        },\n        {\n          \"component\": \"Row\",\n          \"id\": \"ingredient_item_10\",\n          \"children\": [\"icon_basket_10\", \"text_ingredient_10\"],\n          \"align\": \"center\"\n        },\n        {\n          \"component\": \"Icon\",\n          \"id\": \"icon_basket_10\",\n          \"name\": \"../assets/r_000701_01_6_basket.svg\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"text_ingredient_10\",\n          \"text\": \"1 tbsp fresh thyme leaves\"\n        },\n        {\n          \"component\": \"Row\",\n          \"id\": \"ingredient_item_11\",\n          \"children\": [\"icon_basket_11\", \"text_ingredient_11\"],\n          \"align\": \"center\"\n        },\n        {\n          \"component\": \"Icon\",\n          \"id\": \"icon_basket_11\",\n          \"name\": \"../assets/r_000701_01_6_basket.svg\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"text_ingredient_11\",\n          \"text\": \"Salt and black pepper to taste; Fresh parsley for garnish\"\n        },\n        {\n          \"component\": \"Column\",\n          \"id\": \"section_steps\",\n          \"children\": [\n            \"heading_steps\",\n            \"list_steps\"\n          ]\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"heading_steps\",\n          \"text\": \"Instructions:\",\n          \"variant\": \"h4\"\n        },\n        {\n          \"component\": \"List\",\n          \"id\": \"list_steps\",\n          \"direction\": \"vertical\",\n          \"children\": [\n            \"step_1_card\",\n            \"step_2_card\",\n            \"step_3_card\",\n            \"step_4_card\",\n            \"step_5_card\",\n            \"step_6_card\"\n          ]\n        },\n        {\n          \"component\": \"Card\",\n          \"id\": \"step_1_card\",\n          \"child\": \"step_1_content\"\n        },\n        {\n          \"component\": \"Column\",\n          \"id\": \"step_1_content\",\n          \"children\": [\n            \"step_1_title\",\n            \"text_step_1_body\"\n          ]\n        },\n        {\n          \"component\": \"Row\",\n          \"id\": \"step_1_title\",\n          \"children\": [\"icon_fire_1\", \"text_step_1_title\"],\n          \"align\": \"center\"\n        },\n        {\n          \"component\": \"Icon\",\n          \"id\": \"icon_fire_1\",\n          \"name\": \"../assets/r_000701_01_4_fire.svg\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"text_step_1_title\",\n          \"text\": \"1. Warm the Broth:\",\n          \"variant\": \"h5\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"text_step_1_body\",\n          \"text\": \"Pour the vegetable broth into a saucepan and keep it on a low simmer next to your main cooking pot. Cold broth shocks the rice and stops the cooking process, preventing the creamy texture from developing.\"\n        },\n        {\n          \"component\": \"Card\",\n          \"id\": \"step_2_card\",\n          \"child\": \"step_2_content\"\n        },\n        {\n          \"component\": \"Column\",\n          \"id\": \"step_2_content\",\n          \"children\": [\n            \"step_2_title\",\n            \"text_step_2_body\"\n          ]\n        },\n        {\n          \"component\": \"Row\",\n          \"id\": \"step_2_title\",\n          \"children\": [\"icon_fire_2\", \"text_step_2_title\"],\n          \"align\": \"center\"\n        },\n        {\n          \"component\": \"Icon\",\n          \"id\": \"icon_fire_2\",\n          \"name\": \"../assets/r_000701_01_4_fire.svg\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"text_step_2_title\",\n          \"text\": \"2. Sauté the Mushrooms:\",\n          \"variant\": \"h5\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"text_step_2_body\",\n          \"text\": \"In your heavy-bottomed pot, heat 1 tablespoon of olive oil over medium-high heat. Add the sliced mushrooms and cook until browned and their liquid has evaporated (about 5-8 minutes). Season with a pinch of salt. Remove mushrooms from the pot and set aside. This prevents them from getting rubbery during the rice cooking.\"\n        },\n        {\n          \"component\": \"Card\",\n          \"id\": \"step_3_card\",\n          \"child\": \"step_3_content\"\n        },\n        {\n          \"component\": \"Column\",\n          \"id\": \"step_3_content\",\n          \"children\": [\n            \"step_3_title\",\n            \"text_step_3_body\"\n          ]\n        },\n        {\n          \"component\": \"Row\",\n          \"id\": \"step_3_title\",\n          \"children\": [\"icon_fire_3\", \"text_step_3_title\"],\n          \"align\": \"center\"\n        },\n        {\n          \"component\": \"Icon\",\n          \"id\": \"icon_fire_3\",\n          \"name\": \"../assets/r_000701_01_4_fire.svg\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"text_step_3_title\",\n          \"text\": \"3. Aromatics and Toasting:\",\n          \"variant\": \"h5\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"text_step_3_body\",\n          \"text\": \"Reduce heat to medium. Add the remaining 2 tablespoons of olive oil to the pot. Add shallots and cook until softened (2-3 minutes). Add garlic and thyme, cooking for another minute until fragrant. Add the Arborio rice. Toast the rice, stirring constantly, for 1-2 minutes until the edges are translucent and the center remains opaque. This toasting step creates a shell around the grain so it doesn't turn to mush while slowly releasing starch.\"\n        },\n        {\n          \"component\": \"Card\",\n          \"id\": \"step_4_card\",\n          \"child\": \"step_4_content\"\n        },\n        {\n          \"component\": \"Column\",\n          \"id\": \"step_4_content\",\n          \"children\": [\n            \"step_4_title\",\n            \"text_step_4_body\"\n          ]\n        },\n        {\n          \"component\": \"Row\",\n          \"id\": \"step_4_title\",\n          \"children\": [\"icon_fire_4\", \"text_step_4_title\"],\n          \"align\": \"center\"\n        },\n        {\n          \"component\": \"Icon\",\n          \"id\": \"icon_fire_4\",\n          \"name\": \"../assets/r_000701_01_4_fire.svg\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"text_step_4_title\",\n          \"text\": \"4. Deglaze:\",\n          \"variant\": \"h5\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"text_step_4_body\",\n          \"text\": \"Pour in the white wine. Stir constantly until the wine is fully absorbed by the rice.\"\n        },\n        {\n          \"component\": \"Card\",\n          \"id\": \"step_5_card\",\n          \"child\": \"step_5_content\"\n        },\n        {\n          \"component\": \"Column\",\n          \"id\": \"step_5_content\",\n          \"children\": [\n            \"step_5_title\",\n            \"text_step_5_body\"\n          ]\n        },\n        {\n          \"component\": \"Row\",\n          \"id\": \"step_5_title\",\n          \"children\": [\"icon_clock_1\", \"text_step_5_title\"],\n          \"align\": \"center\"\n        },\n        {\n          \"component\": \"Icon\",\n          \"id\": \"icon_clock_1\",\n          \"name\": \"../assets/r_000701_01_5_clock.svg\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"text_step_5_title\",\n          \"text\": \"5. The Risotto Method:\",\n          \"variant\": \"h5\"\n        },\n        {\n          \"component\": \"Text\",\n          \"id\": \"text_step_5_body\",\n          \"text\": \"Begin adding the warm broth, one ladle (about 0.5 cup) at a time. Stir frequently. Wait until the liquid is almost completely absorbed before adding the next ladle. The friction from stirring rubs the grains together, releasing the starch that creates the creamy sauce. Repe