         \"id\": \"phases_row_4\",\n          \"component\": \"Row\",\n          \"justify\": \"spaceBetween\",\n          \"children\": [\n            \"phases_row_4_cell_1\",\n            \"phases_row_4_cell_2\",\n            \"phases_row_4_cell_3\"\n          ]\n        },\n        {\n          \"id\": \"phases_row_4_cell_1\",\n          \"component\": \"Text\",\n          \"text\": \"Rest\",\n          \"weight\": 1\n        },\n        {\n          \"id\": \"phases_row_4_cell_2\",\n          \"component\": \"Text\",\n          \"text\": \"2-3 mins\",\n          \"weight\": 1\n        },\n        {\n          \"id\": \"phases_row_4_cell_3\",\n          \"component\": \"Text\",\n          \"text\": \"Remove from heat, beat in fat (mantecatura) for creaminess\",\n          \"weight\": 2\n        },\n        {\n          \"id\": \"sources_card\",\n          \"component\": \"Card\",\n          \"child\": \"sources_col\"\n        },\n        {\n          \"id\": \"sources_col\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"sources_title\",\n            \"source_1_button\",\n            \"source_2_button\",\n            \"source_3_button\"\n          ]\n        },\n        {\n          \"id\": \"sources_title\",\n          \"component\": \"Text\",\n          \"variant\": \"h2\",\n          \"text\": \"Sources\"\n        },\n        {\n          \"id\": \"source_1_button\",\n          \"component\": \"Button\",\n          \"variant\": \"borderless\",\n          \"child\": \"source_1_text\",\n          \"action\": {\n            \"functionCall\": {\n              \"call\": \"openUrl\",\n              \"args\": {\n                \"url\": \"https://www.seriouseats.com/how-to-make-perfect-risotto-recipe\"\n              }\n            }\n          }\n        },\n        {\n          \"id\": \"source_1_text\",\n          \"component\": \"Text\",\n          \"text\": \"Serious Eats (The Science of Risotto)\"\n        },\n        {\n          \"id\": \"source_2_button\",\n          \"component\": \"Button\",\n          \"variant\": \"borderless\",\n          \"child\": \"source_2_text\",\n          \"action\": {\n            \"functionCall\": {\n              \"call\": \"openUrl\",\n              \"args\": {\n                \"url\": \"https://minimalistbaker.com/creamy-vegetable-risotto-30-minutes/\"\n              }\n            }\n          }\n        },\n        {\n          \"id\": \"source_2_text\",\n          \"component\": \"Text\",\n          \"text\": \"Minimalist Baker (Vegan Risotto Tips)\"\n        },\n        {\n          \"id\": \"source_3_button\",\n          \"component\": \"Button\",\n          \"variant\": \"borderless\",\n          \"child\": \"source_3_text\",\n          \"action\": {\n            \"functionCall\": {\n              \"call\": \"openUrl\",\n              \"args\": {\n                \"url\": \"https://www.loveandlemons.com/mushroom-risotto/\"\n              }\n            }\n          }\n        },\n        {\n          \"id\": \"source_3_text\",\n          \"component\": \"Text\",\n          \"text\": \"Love & Lemons (Mushroom Risotto Guide)\"\n        }\n      ]\n    }\n  }\n]", "raw": {"candidates": [{"content": {"role": "model", "parts": [{"text": "[\n  {\n    \"version\": \"v0.9\",\n    \"createSurface\": {\n      \"surfaceId\": \"recipe-surface-1\",\n      \"catalogId\": \"https://genui.local/specification/v0_9/standard_catalog.json\"\n    }\n  },\n  {\n    \"version\": \"v0.9\",\n    \"updateComponents\": {\n      \"surfaceId\": \"recipe-surface-1\",\n      \"components\": [\n        {\n          \"id\": \"root\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"header_title\",\n            \"header_image\",\n            \"header_desc\",\n            \"context_card\",\n            \"instructions_card\",\n            \"phases_card\",\n            \"sources_card\"\n          ]\n        },\n        {\n          \"id\": \"header_title\",\n          \"component\": \"Text\",\n          \"variant\": \"h1\",\n          \"text\": \"Creamy Vegan Mushroom Risotto Overview\"\n        },\n        {\n          \"id\": \"header_image\",\n          \"component\": \"Image\",\n          \"url\": \"../assets/r_000701_01_1_mushroom-risotto.jpg\",\n          \"variant\": \"largeFeature\"\n        },\n        {\n          \"id\": \"header_desc\",\n          \"component\": \"Text\",\n          \"variant\": \"body\",\n          \"text\": \"This recipe creates a rich, velvety risotto for 4 people without using dairy. The key to the creamy texture lies in the high starch content of Arborio rice and the agitation process (stirring), which releases that starch into the broth. We will use a mix of mushrooms for depth of flavor and finish with a \\\"mantecatura\\\" technique using vegan fat to emulsify the sauce.\"\n        },\n        {\n          \"id\": \"context_card\",\n          \"component\": \"Card\",\n          \"child\": \"context_col\"\n        },\n        {\n          \"id\": \"context_col\",\n          \"component\": \"Column\",\n          \"children\": [\n            \"context_title\",\n            \"context_desc\"\n          ]\n        },\n        {\n          \"id\": \"context_title\",\n          \"component\": \"Text\",\n          \"variant\": \"h2\",\n          \"text\": \"Kitchen & Ingredient Context\"\n        },\n        {\n          \"id\": \"context_desc\",\n          \"component\": \"Text\",\n          \"variant\": \"body\",\n          \"text\": \"This recipe assumes you have a heavy-bottomed pot or Dutch oven to distribute heat evenly. We assume the use of dry white wine (like Pinot Grigio or Sauvignon Blanc) to deglaze the pan, but you can substitute extra vegetable broth mixed with a teaspoon of lemon juice or white wine vinegar if you prefer an alcohol-free version. We also assume the use of store-bought low-sodium vegetable broth, but homemade stock works excellently.\"\n        },\n       