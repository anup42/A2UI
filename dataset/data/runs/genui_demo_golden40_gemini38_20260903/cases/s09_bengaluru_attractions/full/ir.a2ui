<a2ui>
root=Column([a,b,c,d,e,f,o,x,ag,ap,ay,az,bc,bd,bg],"lg")
a=Text("Top Tourist Attractions in Bengaluru","h1")
b=Text("Bengaluru blends historic royal heritage, lush botanical gardens, and modern cultural monuments across its urban landscape. The following five landmarks are among the city's most visited and highly rated destinations.","body")
c=Text("Landmark Comparison Table","h2")
d=Table(columns=["Attraction","Category","Rating","Key Highlights"],rows=[["Bangalore Palace","Heritage & Architecture","4.2 / 5.0","Tudor Revival architecture, royal artifacts, manicured grounds"],["Lalbagh Botanical Garden","Nature & Horticulture","4.4 / 5.0","Historic 1890 Glass House, century-old trees, serene lake"],["Cubbon Park","Nature & Recreation","4.6 / 5.0","300 acres of shaded green walking paths, colonial statues, library"],["ISKCON Temple Bangalore","Culture & Spirituality","4.7 / 5.0","Grand hilltop shrine, ornate gopurams, tranquil prayer halls"],["Bannerghatta Biological Park","Wildlife & Conservation","4.3 / 5.0","Wildlife safari, butterfly sanctuary, zoological rescue center"]],title="Landmark Comparison Table")
e=Text("Top 5 Landmarks to Visit","h2")
f=Card([g,h,k,l,m,n],"Bangalore Palace")
g=Image("https://commons.wikimedia.org/wiki/Special:FilePath/Bangalore%20Palace%20-%20Jayamahal.jpg","Bangalore Palace")
h=Row([i,j],"sm","center")
i=Icon("https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/building.svg")
j=Text("Bangalore Palace Overview","caption")
k=Text("• Built in 1878 by the Mysore royal family, this palace is renowned for its Tudor Revival architecture, fortified towers, and wood carvings.","body")
l=Text("• Visitors can explore 35 ornate rooms showcasing vintage photos, hunting trophies, and Victorian-era furnishings.","body")
m=Text("Rating: 4.2 / 5.0","body")
n=Button("Open in Maps",onPress=openUrl("https://www.google.com/maps/search/?api=1&query=Bangalore+Palace"))
o=Card([p,q,t,u,v,w],"Lalbagh Botanical Garden")
p=Image("https://commons.wikimedia.org/wiki/Special:FilePath/Lalbagh%20botanical%20garden%20,bangalore,India.jpg","Lalbagh Botanical Garden")
q=Row([r,s],"sm","center")
r=Icon("https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/tree.svg")
s=Text("Lalbagh Botanical Garden Overview","caption")
t=Text("• Commissioned in 1760 by Hyder Ali and developed by Tipu Sultan, this 240-acre garden houses over 1,000 rare plant species.","body")
u=Text("• Its centerpiece is the Victorian Glass House modeled after London's Crystal Palace, which hosts famous bi-annual flower shows.","body")
v=Text("Rating: 4.4 / 5.0","body")
w=Button("Open in Maps",onPress=openUrl("https://www.google.com/maps/search/?api=1&query=Lalbagh+Botanical+Garden"))
x=Card([y,z,ac,ad,ae,af],"Cubbon Park")
y=Image("https://commons.wikimedia.org/wiki/Special:FilePath/Cubbon%20Park%20W.jpg","Cubbon Park")
z=Row([aa,ab],"sm","center")
aa=Icon("https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/geo-alt.svg")
ab=Text("Cubbon Park Overview","caption")
ac=Text("• Spanning 300 acres in the heart of Bengaluru's central business district, Cubbon Park serves as the city's green lung.","body")
ad=Text("• Ideal for morning walks and peaceful outings, it houses the State Central Library, bandstands, and statues surrounded by dense greenery.","body")
ae=Text("Rating: 4.6 / 5.0","body")
af=Button("Open in Maps",onPress=openUrl("https://www.google.com/maps/search/?api=1&query=Cubbon+Park+Bengaluru"))
ag=Card([ah,ai,al,am,an,ao],"ISKCON Temple Bangalore")
ah=Image("https://commons.wikimedia.org/wiki/Special:FilePath/ISKCON%20Temple%20-%20Bangalore%20-%20Karnataka%20-%20DSCN0101.jpg","ISKCON Temple Bangalore")
ai=Row([aj,ak],"sm","center")
aj=Icon("https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/star.svg")
ak=Text("ISKCON Temple Overview","caption")
al=Text("• Situated atop Hare Krishna Hill in Rajajinagar, this complex is one of the largest ISKCON centers in the world.","body")
am=Text("• The temple blends modern glass-and-stone architectural styles with traditional Dravidian stone craftsmanship, drawing thousands of devotees and tourists daily.","body")
an=Text("Rating: 4.7 / 5.0","body")
ao=Button("Open in Maps",onPress=openUrl("https://www.google.com/maps/search/?api=1&query=ISKCON+Temple+Bangalore"))
ap=Card([aq,ar,au,av,aw,ax],"Bannerghatta Biological Park")
aq=Image("https://commons.wikimedia.org/wiki/Special:FilePath/Bannerghatta%20National%20Park%20(Bannerghatta%20Biological%20Park).jpg","Bannerghatta Biological Park")
ar=Row([as,at],"sm","center")
as=Icon("https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/compass.svg")
at=Text("Bannerghatta Biological Park Overview","caption")
au=Text("• Situated 22 km south of the city center, this ecological park offers close encounters with tigers, lions, and Asian elephants via guided bus safaris.","body")
av=Text("• The facility includes a dedicated butterfly park conservatory, a zoo, and a wildlife rescue center.","body")
aw=Text("Rating: 4.3 / 5.0","body")
ax=Button("Open in Maps",onPress=openUrl("https://www.google.com/maps/search/?api=1&query=Bannerghatta+Biological+Park"))
ay=Text("Quick Actions","h2")
az=Row([ba,bb],"md")
ba=Button("View Bengaluru Map",onPress=openUrl("https://www.google.com/maps/search/?api=1&query=Bengaluru+Attractions"))
bb=Button("Karnataka Tourism",onPress=openUrl("https://www.karnatakatourism.org"))
bc=Text("Sources","h2")
bd=Row([be,bf],"sm","center")
be=Text("Karnataka Tourism Official Portal: https://www.karnatakatourism.org","body")
bf=Button("Visit Portal","secondary",onPress=openUrl("https://www.karnatakatourism.org"))
bg=Row([bh,bi],"sm","center")
bh=Text("Incredible India Destination Guide: https://www.incredibleindia.gov.in","body")
bi=Button("View Guide","secondary",onPress=openUrl("https://www.incredibleindia.gov.in"))
</a2ui>
