<a2ui>
root=Column([a,d,k,l,s,t],"md")
a=Row([b,c],"sm","center")
b=Icon("https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/star.svg")
c=Text("Here is the breakdown for splitting the bill:","h3")
d=Column([e,f,g,h,i,j],"sm")
e=Text("Formulas","h3")
f=Icon("https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/star.svg")
g=Formula("\\text{Tip Amount} = \\text{Bill Amount} \\times \\left(\\frac{\\text{Tip Percentage}}{100}\\right)","1. Tip Amount")
h=Formula("\\text{Total Bill} = \\text{Bill Amount} + \\text{Tip Amount}","2. Total Bill")
i=Icon("https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/star.svg")
j=Formula("\\text{Amount per Person} = \\frac{\\text{Total Bill}}{\\text{Number of People}}","3. Amount per Person")
k=Divider()
l=Column([m,n],"sm")
m=Text("Calculations","h3")
n=List([o,p,q,r])
o=Text("Base Bill: ₹2,400")
p=Text("Tip (10%): ₹2,400 × 0.10 = ₹240")
q=Text("Total Amount: ₹2,400 + ₹240 = ₹2,640")
r=Text("Amount per Person: ₹2,640 ÷ 4 = ₹660")
s=Divider()
t=Card([u],"Summary")
u=List([v,w,x])
v=Text("Tip: ₹240")
w=Text("Total Bill: ₹2,640")
x=Text("Amount per person: ₹660")
</a2ui>
