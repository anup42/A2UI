<a2ui>
root=Column([a,d,p],"md")
a=Row([b,c],"sm","center")
b=Icon("https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/star.svg")
c=Text("Mushroom Risotto","h2")
d=Card([e],"Ingredients (for 2)")
e=List([f,g,h,i,j,k,l,m,n,o])
f=Text("150g (3/4 cup) Arborio rice")
g=Text("200g mushrooms, sliced")
h=Text("1 small shallot or onion, finely chopped")
i=Text("1 clove garlic, minced")
j=Text("60ml (1/4 cup) dry white wine")
k=Text("500–600ml warm vegetable or chicken broth")
l=Text("30g butter (divided)")
m=Text("1 tbsp olive oil")
n=Text("30g grated Parmesan cheese")
o=Text("Salt and black pepper, to taste")
p=Card([q],"Steps")
q=List([r,s,t,u])
r=Text("1. Sauté mushrooms in 1 tablespoon of butter over medium-high heat until browned; season with salt and pepper, then set aside.")
s=Text("2. Heat olive oil in the same pan, cook the shallots and garlic until translucent, add rice, and toast for 1–2 minutes until edges turn translucent.")
t=Text("3. Pour in the white wine, simmering until absorbed, then add warm broth one ladle at a time, stirring frequently until liquid is absorbed before adding more (about 18–20 minutes).")
u=Text("4. Remove from heat, fold in the cooked mushrooms, remaining butter, and Parmesan cheese, then cover for 2 minutes before serving.")
</a2ui>
