<a2ui>
root=Column([a,b,c,d,h,l,p,q,t,u,v],"md")
a=Text("Mysuru Heritage & Sightseeing Highlights","h1")
b=Text("Mysuru offers a blend of historic royal architecture, sacred hillside shrines, and landscaped terrace gardens.")
c=Text("Top 3 Attractions in Mysuru","h2")
d=Card([e,f,g],"1. Mysore Palace (Amba Vilas Palace)")
e=Image("https://commons.wikimedia.org/wiki/Special:FilePath/Mysore_Palace_Morning.jpg","Mysore Palace (Amba Vilas Palace)")
f=Icon("https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/building.svg")
g=Text("A magnificent Indo-Saracenic royal residence renowned for its ornate durbar halls and thousands of lights that illuminate the facade on weekends and festive occasions.")
h=Card([i,j,k],"2. Sri Chamundeshwari Temple")
i=Image("https://commons.wikimedia.org/wiki/Special:FilePath/Chamundeshwari_Temple.jpg","Sri Chamundeshwari Temple")
j=Icon("https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/geo-alt.svg")
k=Text("A revered hilltop temple perched atop Chamundi Hills, known for its towering seven-tiered Dravidian gopuram and panoramic views over the city.")
l=Card([m,n,o],"3. Brindavan Gardens")
m=Image("https://commons.wikimedia.org/wiki/Special:FilePath/Brindavan_Gardens,_Mysore.jpg","Brindavan Gardens")
n=Icon("https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/tree.svg")
o=Text("A sprawling terraced botanical garden situated below the Krishna Raja Sagara Dam, celebrated for its ornamental lawns and synchronized musical fountain shows.")
p=Text("Quick Actions","h2")
q=Row([r,s],"sm")
r=Button("Mysuru Tourism Guide","primary",onPress=openUrl("https://www.karnatakatourism.org"))
s=Button("Mysore Palace Portal","secondary",onPress=openUrl("https://mysorepalace.karnataka.gov.in"))
t=Text("Sources","h2")
u=Text("Mysuru District Portal: https://mysore.nic.in")
v=Text("Karnataka Tourism Official Site: https://www.karnatakatourism.org")
</a2ui>
