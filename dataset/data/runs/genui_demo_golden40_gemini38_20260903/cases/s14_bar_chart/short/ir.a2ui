<a2ui>
root=Column([a,b],"md")
a=Chart(chartType="bar",columns=["Day","Value"],rows=[["Mon",4000],["Tue",6500],["Wed",5000],["Thu",8000],["Fri",7500]])
b=Column([c,g,k,o,r],"sm")
c=Row([d,e,f],"sm","center")
d=Text("Mon")
e=Text("4,000")
f=Icon("https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/star.svg")
g=Row([h,i,j],"sm","center")
h=Text("Tue")
i=Text("6,500")
j=Icon("https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/star.svg")
k=Row([l,m,n],"sm","center")
l=Text("Wed")
m=Text("5,000")
n=Icon("https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/star.svg")
o=Row([p,q],"sm","center")
p=Text("Thu")
q=Text("8,000")
r=Row([s,t],"sm","center")
s=Text("Fri")
t=Text("7,500")
</a2ui>
