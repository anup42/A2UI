<a2ui>
root=Column([a,b,e,f,g,j,k,l,m],"md")
a=Text("Here is a breakdown of your walking activity for the week:")
b=Row([c,d],"sm","center")
c=Icon("https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/star.svg")
d=Text("Walking Activity Table","h3")
e=Table(columns=["Day","Steps"],rows=[["Monday","4,000"],["Tuesday","6,500"],["Wednesday","5,000"],["Thursday","8,000"],["Friday","7,500"],["Total","31,000"],["Average","6,200"]])
f=Divider()
g=Row([h,i],"sm","center")
h=Icon("https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/star.svg")
i=Text("Walking Activity Bar Chart","h3")
j=Text("*(Each █ represents roughly 500 steps)*")
k=CodeBlock("Monday    [4,000] : ████████\nMedia: Icon=https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/star.svg\nTuesday   [6,500] : █████████████\nWednesday [5,000] : ██████████\nThursday  [8,000] : ████████████████\nFriday    [7,500] : ███████████████","text")
l=Text("Summary Stats","h3")
m=List([n,o,p,q])
n=Text("**Total Steps:** 31,000 steps")
o=Text("**Daily Average:** 6,200 steps/day")
p=Text("**Highest Day:** Thursday (8,000 steps)")
q=Text("**Lowest Day:** Monday (4,000 steps)")
</a2ui>
