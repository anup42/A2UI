\n      text: \"Provided a consistent, high-volume sales base throughout the week, showing steady but modest growth. Masala Chai is the top-selling item overall.\"\n      variant: body\n  trend_hot_stack:\n    type: Stack\n    children[2]: trend_hot_title,trend_hot_desc\n    props:\n      direction: vertical\n      gap: sm\n  trend_hot_title:\n    type: Text\n    children[0]:\n    props:\n      text: Hot Drinks\n      variant: h3\n  trends_card:\n    type: Card\n    children[1]: trends_stack\n    props:\n  trends_section:\n    type: Stack\n    children[2]: trends_title,trends_card\n    props:\n      direction: vertical\n      gap: md\n  trends_stack:\n    type: Stack\n    children[3]: trend_cold_stack,trend_hot_stack,trend_food_stack\n    props:\n      direction: vertical\n      gap: md\n      padding: md\n  trends_title:\n    type: Text\n    children[0]:\n    props:\n      text: Category Performance Trends\n      variant: h2\nstate:\n  salesData[5]{category,growth,id,item,sales}:\n    Hot,+18.2%,\"1\",Masala Chai,\"300\"\n    Cold,+84.2%,\"2\",Iced Latte,\"255\"\n    Hot,+21.4%,\"3\",Espresso,\"221\"\n    Food,+46.7%,\"4\",Sandwich,\"171\"\n    Cold,+118.2%,\"5\",Cold Brew,\"160\"","validation":{"json_parse_ok":true,"schema_valid_strict":true,"schema_valid_lenient":true,"toon_roundtrip_ok":true,"converted_from_legacy":false,"errors":[],"repair_attempts":0,"repair_needed":false},"metrics":{"content_coverage":0.844559585492228,"dup_rate":0.36363636363636365,"lint_score":1.0,"output_tokens_toon":5384,"output_tokens_json":6946,"output_chars_toon":5384,"output_chars_json":6946,"component_count":48.0,"component_count_norm":0.8,"component_count_capped":48.0,"unique_component_types":6.0,"max_tree_depth":6.0,"avg_tree_depth":1.9166666666666667,"container_to_text_ratio":1.0,"information_chunking_score":0.8624919302775984,"ui_modularity_score":0.10416666666666667,"ui_decomposition_score":0.5818733860555196,"actionable_elements":0.0,"action_coverage":1.0,"url_as_text_rate":0.0