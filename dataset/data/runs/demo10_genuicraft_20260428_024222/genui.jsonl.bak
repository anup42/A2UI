text1":{"type":"Text","props":{"text":"Remove the pan from the heat. This is important to prevent the yogurt from curdling. Stir in 1/2 cup of Greek yogurt and the juice of half a lemon until well combined and the sauce is creamy.","variant":"body"},"children":[]},"step4_text2":{"type":"Text","props":{"text":"Divide the fluffy basmati rice between two bowls and top with the paneer and chickpea curry.","variant":"body"},"children":[]},"actions_card":{"type":"Card","props":{},"children":["actions_stack"]},"actions_stack":{"type":"Stack","props":{"direction":"vertical","gap":"md"},"children":["actions_title","actions_button_stack"]},"actions_title":{"type":"Text","props":{"text":"Quick Actions","variant":"h2"},"children":[]},"actions_button_stack":{"type":"Stack","props":{"direction":"horizontal","gap":"md","wrap":"wrap"},"children":["action_button_1","action_button_2"]},"action_button_1":{"type":"Button","props":{"label":"Create Grocery List","variant":"primary"},"children":[],"on":{"press":{"action":"openUrl","params":{"url":"https://anylist.com/"}}}},"action_button_2":{"type":"Button","props":{"label":"Start 35-Min Timer","variant":"primary"},"children":[],"on":{"press":{"action":"openUrl","params":{"url":"https://www.google.com/search?q=set+a+timer+for+35+minutes"}}}}}},"assets":[{"url":"https://loremflickr.com/1200/800/paneer,curry","path":"assets\\r_000004_01_1_paneer_curry.jpg","sha256":"430e3fb602e1d2754847832fb388dc713edd933cfa24cd233b56897d63c1a357","bytes":151624},{"url":"https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/cup-hot.svg","path":"assets\\r_000004_01_2_cup-hot.svg"},{"url":"https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/stopwatch.svg","path":"assets\\r_000004_01_3_stopwatch.svg"},{"url":"https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/alarm.svg","path":"assets\\r_000002_01_5_alarm.svg"},{"url":"https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/book.svg","path":"assets\\r_000004_01_5_book.svg"}],"toon":"root: main\nelements:\n  action_button_1:\n    type: Button\n    children[0]:\n    on:\n      press:\n        action: openUrl\n        params:\n          url: \"https://anylist.com/\"\n    props:\n      label: Create Grocery List\n      variant: primary\n  action_button_2:\n    type: Button\n    children[0]:\n    on:\n      press:\n        action: openUrl\n        params:\n          url: \"https://www.google.com/search?q=set+a+timer+for+35+minutes\"\n    props:\n      label: Start 35-Min Timer\n      variant: primary\n  actions_button_stack:\n    type: Stack\n    children[2]: action_button_1,action_button_2\n    props:\n      direction: horizontal\n      gap: md\n      wrap: wrap\n  actions_card:\n    type: Card\n    children[1]: actions_stack\n    props:\n  actions_stack:\n    type: Stack\n    children[2]: actions_title,actions_button_stack\n    props:\n      direction: vertical\n      gap: md\n  actions_title:\n    type: Text\n    children[0]:\n    props:\n      text: Quick Actions\n      variant: h2\n  curry_ingredients_table:\n    type: Table\n    children[0]:\n    props:\n      domain: generic\n      preferredPresentation: table\n      statePath: /curry_ingredients\n      columns[2]{key,label}:\n        item,Item\n        quantity,Quantity\n  curry_ingredients_title:\n    type: Text\n    children[0]:\n    props:\n      text: \"For the Curry:\"\n      variant: h3\n  hero_image:\n    type: Image\n    children[0]:\n    props:\n      fit: cover\n      url: ../assets/r_000004_01_1_paneer_curry.jpg\n  ingredients_card:\n    type: Card\n    children[1]: ingredients_stack\n    props:\n  ingredients_stack:\n    type: Stack\n    children[8]: ingredients_title,servings_text,curry_ingredients_title,curry_ingredients_table,serving_ingredients_title,serving_ingredients_table,nutrition_title,nutrition_table\n    props:\n      direction: vertical\n      gap: md\n  ingredients_title:\n    type: Text\n    children[0]:\n    props:\n      text: Ingredients & Nutrition Breakdown\n      variant: h2\n  intro_text:\n    type: Text\n    children[0]:\n    props:\n      text: \"A high-protein, satisfying vegetarian meal ready in under 40 minutes. This recipe combines creamy paneer, hearty chickpeas, and fresh spinach in a flavorful tomato-yogurt sauce, served over fluffy basmati rice.\"\n      variant: body\n  main:\n    type: Stack\n    children[10]: title_stack,hero_image,intro_text,ingredients_card,steps_title_stack,step1_card,step2_card,step3_card,step4_card,actions_card\n    props:\n      direction: vertical\n      gap: lg\n  nutrition_table:\n    type: Table\n    children[0]:\n    props:\n      domain: generic\n      preferredPresentation: table\n      statePath: /nutrition\n      columns[2]{key,label}:\n        metric,Metric\n        value,Value\n  nutrition_title:\n    type: Text\n    children[0]:\n    props:\n      text: \"Nutrition Estimate (per serving):\"\n      variant: h3\n  serving_ingredients_table:\n    type: Table\n    children[0]:\n    props:\n      domain: generic\n      preferredPresentation: table\n      statePath: /serving_ingredients\n      columns[2]{key,label}:\n        item,Item\n        quantity,Quantity\n  serving_ingredients_title:\n    type: Text\n    children[0]:\n    props:\n      text: \"For Serving:\"\n      variant: h3\n  servings_text:\n    type: Text\n    children[0]:\n    props:\n      text: This recipe serves 2 people.\n      variant: caption\n  step1_card:\n    type: Card\n    children[1]: step1_stack\n    props:\n  step1_stack:\n    type: Stack\n    children[3]: step1_title,step1_text1,step1_text2\n    props:\n      direction: vertical\n      gap: sm\n  step1_text1:\n    type: Text\n    children[0]:\n    props:\n      text: \"Rinse 1 cup of basmati rice under cold water. In a medium pot, combine the rinsed rice with 2 cups of water and a pinch of salt.\"\n      variant: body\n  step1_text2:\n    type: Text\n    children[0]:\n    props:\n      text: \"Bring to a boil, then reduce heat to the lowest setting, cover, and simmer for 15 minutes or until all water is absorbed. Remove from heat and let it rest, covered, for 5 minutes. Fluff with a fork before serving.\"\n      variant: body\n  step1_title:\n    type: Text\n    children[0]:\n    props:\n      text: \"Step 1: Cook the Rice (Time: 0-20 mins)\"\n      variant: h3\n  step2_card:\n    type: Card\n    children[1]: step2_stack\n    props:\n  step2_stack:\n    type: Stack\n    children[3]: step2_title,step2_text1,step2_text2\n    props:\n      direction: vertical\n      gap: sm\n  step2_text1:\n    type: Text\n    children[0]:\n    props:\n      text: \"While the rice cooks, heat 1 tbsp of oil or ghee in a large pan or skillet over medium heat. Add 1 tsp of cumin seeds and let them sizzle for 30 seconds until fragrant.\"\n      variant: body\n  step2_text2:\n    type: Text\n    children[0]:\n    props:\n      text: \"Stir in 1 tbsp of ginger-garlic paste and cook for another minute. Pour in 1 cup of tomato puree, 1.5 tsp garam masala, 1/2 tsp turmeric, and salt to taste. Cook for 3-4 minutes, stirring occasionally.\"\n      variant: body\n  step2_title:\n    type: Text\n    children[0]:\n    props:\n      text: \"Step 2: Sauté Aromatics & Spices (Time: 20-25 mins)\"\n      variant: h3\n  step3_card:\n    type: Card\n    children[1]: step3_stack\n    props:\n  step3_stack:\n    type: Stack\n    children[3]: step3_title,step3_text1,step3_text2\n    props:\n      direction: vertical\n      gap: sm\n  step3_text1:\n    type: Text\n    children[0]:\n    props:\n      text: \"Add the 1 cup of cooked chickpeas and 3 cups of spinach to the pan. Stir until the spinach has wilted completely, which should take about 2-3 minutes.\"\n      variant: body\n  step3_text2:\n    type: Text\n    children[0]:\n    props:\n      text: Gently fold in the 250g of paneer cubes. Allow it to simmer for 2 more minutes to heat the paneer through and absorb the flavors of the sauce.\n      variant: body\n  step3_title:\n    type: Text\n    children[0]:\n    props:\n      text: \"Step 3: Combine & Simmer (Time: 25-32 mins)\"\n      variant: h3\n  step4_card:\n    type: Card\n    children[1]: step4_stack\n    props:\n  step4_stack:\n    type: Stack\n    children[3]: step4_title,step4_text1,step4_text2\n    props:\n      direction: vertical\n      gap: sm\n  step4_text1:\n    type: Text\n    children[0]:\n    props:\n      text: Remove the pan from the heat. This is important to prevent the yogurt from curdling. Stir in 1/2 cup of Greek yogurt and the juice of half a lemon until well combined and the sauce is creamy.\n      variant: body\n  step4_text2:\n    type: Text\n    children[0]:\n    props:\n      text: Divide the fluffy basmati rice between two bowls and top with the paneer and chickpea curry.\n      variant: body\n  step4_title:\n    type: Text\n    children[0]:\n    props:\n      text: \"Step 4: Finish & Serve (Time: 32-35 mins)\"\n      variant: h3\n  steps_title_icon:\n    type: Icon\n    children[0]:\n    props:\n      name: ../assets/r_000004_01_3_stopwatch.svg\n  steps_title_stack:\n    type: Stack\n    children[2]: steps_title_text,steps_title_icon\n    props:\n      align: center\n      direction: horizontal\n      gap: md\n  steps_title_text:\n    type: Text\n    children[0]:\n    props:\n      text: Step-by-Step Cooking Guide (35 Mins)\n      variant: h2\n  title_icon:\n    type: Icon\n    children[0]:\n    props:\n      name: ../assets/r_000004_01_2_cup-hot.svg\n  title_stack:\n    type: Stack\n    children[2]: title_icon,title_text\n    props:\n      align: center\n      direction: horizontal\n      gap: md\n  title_text:\n    type: Text\n    children[0]:\n    props:\n      text: Speedy Paneer & Chickpea Curry Bowl\n      variant: h2\nstate:\n  curry_ingredients[12]{item,quantity}:\n    Paneer,\"250g, cut into 1-inch cubes\"\n    Cooked Chickpeas,1 cup\n    Fresh Spinach,\"3 cups, roughly chopped\"\n    Tomato Puree,1 cup\n    Greek Yogurt,1/2 cup\n    Ginger-Garlic Paste,1 tbsp\n    Garam Masala,1.5 tsp\n    Turmeric Powder,1/2 tsp\n    Cumin Seeds,1 tsp\n    Lemon,\"1/2, juiced\"\n    Oil or Ghee,1 tbsp\n    Salt,to taste\n  nutrition[4]{metric,value}:\n    Calories,~650 kcal\n    Protein,~38 g\n    Carbohydrates,~75 g\n    Fat,~22 g\n  serving_ingredients[2]{item,quantity}:\n    Basmati Rice,1 cup (uncooked)\n    Water,2 cups (for rice)","validation":{"json_parse_ok":true,"schema_valid_strict":true,"schema_valid_lenient":true,"toon_roundtrip_ok":true,"converted_from_legacy":false,"errors":[],"repair_attempts":0,"repair_needed":false},"metrics":{"content_coverage":0.9150943396226415,"dup_rate":0.3057553956834532,"lint_score":1.0,"output_tokens_toon":5867,"output_tokens_json":7567,"output_chars_toon":5867,"output_chars_json":7567,"component_count":45.0,"component_count_norm":0.75,"component_count_capped":45.0,"unique_component_types":7.0,"max_tree_depth":5.0,"avg_tree_depth":1.6,"container_to_text_ratio":0.7619047619047619,"information_chunking_score":0.8862786972770955,"ui_modularity_score":0.13333333333333333,"ui_decomposition_score":0.5633668505665302,"actionable_elements":2.0,"action_coverage":1.0,"url_as_text_rate":0.0,"table_pattern_detected":1.0,"table_cell_coverage":0.5,"section_heading_coverage":0.5263157894736842,"markdown_leakage_rate":0.0,"image_presence":1.0,"icon_presence":1.0,"missing_ids":0.0,"missing_ids_rate":0.0,"dangling_components":0.0,"dangling_components_rate":0.0,"intent_require_table":1.0,"intent_require_actions":1.0,"intent_require_sections":1.0,"intent_table_ok":1.0,"intent_actions_ok":1.0,"intent_sections_ok":0.0,"intent_expectation_pass":0.0,"intent_score":0.6666666666666666},"gen":{"provider":"gemini","model":"gemini-2.5-pro","prompt_version":"genui_gen_v11_flatspec_hardcut","latency_ms":74730.19218444824,"input_tokens":5067,"output_tokens":3983,"cost_usd":null,"error":null},"created_at":"2026-04-27T21:49:14.479228Z"}
{"ui_id":"u_000005_01","response_id":"r_000005_01","query_id":"q_000005","intent":"Event Schedule","tags":["event","schedule","developer","actions"],"intent_bucket":"event_schedule","response_text":"# GenAI Developer Summit: Bengaluru Agenda\nMedia: Image=https://images.pexels.com/photos/230544/pexels-photo-230544.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=1 Icon=https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/calendar-event.svg\nYour personalized agenda for the GenAI Developer Summit is ready for your mobile device.\n\n- **Date**: Thursday, July 9, 2026\n- **Venue**: Bengaluru Convention Centre\n\n# Summit Schedule: July 9, 2026\n\n**09:00 - 10:00 AM**\nMedia: Image=https://images.pexels.com/photos/3184296/pexels-photo-3184296.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=1 Icon=https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/cup-hot.svg\n- **Registration & Breakfast**\n- Location: Hall Lobby\n- Host: Ops Team\n\n**10:00 - 11:15 AM**\nMedia: Image=https://images.pexels.com/photos/1181387/pexels-photo-1181387.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=1 Icon=https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/mic.svg\n- **Keynote: Building On-Device Agents**\n- Location: Hall A\n- Speaker: Maya Rao\n\n**11:15 AM - 01:00 PM**\nMedia: Image=https://images.pexels.com/photos/3184418/pexels-photo-3184418.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=1 Icon=https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/tools.svg\n- **Workshop: Compact UI IR for Mobile**\n- Location: Room 204\n- Speaker: Anup K\n\n**01:00 - 02:15 PM**\nMedia: Image=https://images.pexels.com/photos/1445696/pexels-photo-1445696.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=1 Icon=https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/display.svg\n- **Lunch & Demos**\n- Location: Expo Zone\n- Host: Partners\n\n**02:15 - 03:45 PM**\nMedia: Image=https://images.pexels.com/photos/3184433/pexels-photo-3184433.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=1 Icon=https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/people.svg\n- **Panel: Safe Declarative UI**\n- Location: Hall B\n- Speakers: Chen Li & Sara Kim\n\n**03:45 - 05:00 PM**\nMedia: Image=https://images.pexels.com/photos/5439427/pexels-photo-5439427.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=1 Icon=https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/laptop.svg\n- **Lab: Android OneUI Rendering**\n- Location: Room 204\n- Speaker: DevRel Team\n\n**05:00 PM onwards**\nMedia: Image=https://images.pexels.com/photos/2833037/pexels-photo-2833037.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=1 Icon=https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/flag.svg\n- **Closing Roadmap**\n- Location: Hall A\n- Speaker: Maya Rao\n\n# Quick Actions\nAction: [Button: Save to Calendar] https://www.google.com/calendar/render?action=TEMPLATE&text=GenAI+Developer+Summit&dates=20260709T090000/20260709T173000&details=Full-day+GenAI+Developer+Summit+in+Bengaluru.&location=Bengaluru+Convention+Centre\nAction: [Button: View Venue Map] https://www.google.com/maps/search/?api=1&query=Bengaluru+Convention+Centre\n\nIcons:\n- Alarm: https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/alarm.svg\n- Book: https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/book.svg","genui_json":{"root":"root","state":{"scheduleItems":[{"id":"1","time":"09:00 - 10:00 AM","imageUrl":"../assets/r_000005_01_3_pexels-photo-3184296.jpeg","iconUrl":"../assets/r_000004_01_2_cup-hot.svg","title":"Registration & Breakfast","location":"Location: Hall Lobby","speaker":"Host: Ops Team"},{"id":"2","time":"10:00 - 11:15 AM","imageUrl":"../assets/r_000005_01_5_pexels-photo-1181387.jpeg","iconUrl":"../assets/r_000005_01_4_mic.svg","title":"Keynote: Building On-Device Agents","location":"Location: Hall A","speaker":"Speaker: Maya Rao"},{"id":"3","time":"11:15 AM - 01:00 PM","imageUrl":"../assets/r_000005_01_7_pexels-photo-3184418.jpeg","iconUrl":"../assets/r_000005_01_5_tools.svg","title":"Workshop: Compact UI IR for Mobile","location":"Location: Room 204","speaker":"Speaker: Anup K"},{"id":"4","time":"01:00 - 02:15 PM","imageUrl":"../assets/r_000005_01_9_pexels-photo-1445696.jpeg","iconUrl":"../assets/r_000005_01_6_display.svg","title":"Lunch & Demos","location":"Location: Expo Zone","speaker":"Host: Partners"},{"id":"5","time":"02:15 - 03:45 PM","imageUrl":"../assets/r_000005_01_11_pexels-photo-3184433.jpeg","iconUrl":"../assets/r_000005_01_7_people.svg","title":"Panel: Safe Declarative UI","location":"Location: Hall B","speaker":"Speakers: Chen Li & Sara Kim"},{"id":"6","time":"03:45 - 05:00 PM","imageUrl":"../assets/r_000005_01_13_pexels-photo-5439427.jpeg","iconUrl":"../assets/r_000005_01_8_laptop.svg","title":"Lab: Android OneUI Rendering","location":"Location: Room 204","speaker":"Speaker: DevRel Team"},{"id":"7","time":"05:00 PM onwards","imageUrl":"../assets/r_000005_01_15_pexels-photo-2833037.jpeg","iconUrl":"../assets/r_000005_01_9_flag.svg","title":"Closing Roadmap","location":"Location: Hall A","speaker":"Speaker: Maya Rao"}],"agendaRows":[{"time":"09:00 - 10:00 AM","session":"Registration & Breakfast","room":"Hall Lobby","lead":"Ops Team"},{"time":"10:00 - 11:15 AM","session":"Keynote: Building On-Device Agents","room":"Hall A","lead":"Maya Rao"},{"time":"11:15 AM - 01:00 PM","session":"Workshop: Compact UI IR for Mobile","room":"Room 204","lead":"Anup K"},{"time":"01:00 - 02:15 PM","session":"Lunch & Demos","room":"Expo Zone","lead":"Partners"},{"time":"02:15 - 03:45 PM","session":"Panel: Safe Declarative UI","room":"Hall B","lead":"Chen Li & Sara Kim"},{"time":"03:45 - 05:00 PM","session":"Lab: Android OneUI Rendering","room":"Room 204","lead":"DevRel Team"},{"time":"05:00 PM onwards","session":"Closing Roadmap","room":"Hall A","lead":"Maya Rao"}]},"elements":{"root":{"type":"Stack","props":{"direction":"vertical","gap":"lg"},"children":["title","heroImage","introCard","scheduleTitle","agendaAtGlanceTitle","agendaAtGlanceTable","schedu