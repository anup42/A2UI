	font-size: 12px;
	font-weight: 400;
	line-height: 1.6;
	color: #454545;
}

.page-id-6204 .section.section--narrow {
	padding: 0;
}
.sc-card-list ul li {
	position: relative;
	list-style: none;
	margin: 10px 0;
}
.sc-card-list ul li:before {
	  content: '\e5ca';
    font-family: "Material Icons";
    font-weight: 700;
    display: -webkit-flex;
    display: -ms-flexbox;
    display: flex;
    position: absolute;
    left: -25px;
    color: #583f9a;
    font-size: 17px;
