	<script type="rocketlazyloadscript">
		window.amplitude.init('ad683eb13531bfb457de6bb7929dcebb', {
			fetchRemoteConfig: true,
			autocapture: {
				enabled: true,
				elementProperties: element => {
					let current = element
					const tracks = []

					while (current) {
						const value = current.getAttribute("data-track")
						if (value) {
							tracks.push(value)
						}
						current = current.parentElement
					}

					return {
						data_track_all: tracks.reverse().join(" > ")  // root first, clicked last
					}
				}
			}
		});
	</script>

