{"ui_id":"u_000512_01","response_id":"r_000512_01","query_id":"q_000512","intent":"Event Schedule","tags":["home-improvement","project-management","schedule"],"intent_bucket":"event_schedule","genui_json":[{"version":"v0.9","createSurface":{"surfaceId":"kitchen_renovation_schedule_1","catalogId":"https://genui.local/specification/v0_9/standard_catalog.json"}},{"version":"v0.9","updateComponents":{"surfaceId":"kitchen_renovation_schedule_1","components":[{"id":"root","component":"Column","children":["card_container"]},{"id":"card_container","component":"Card","child":"main_content_column"},{"id":"main_content_column","component":"Column","children":["assumptions_text","title_text","description_text","table_container","actions_title","actions_container"]},{"id":"assumptions_text","component":"Text","text":"Assumptions:\n- The renovation schedule starts precisely on 2024-05-01 and ends on 2024-05-15.\n- Each phase starts immediately after the previous one, with no buffer days."},{"id":"title_text","component":"Text","variant":"h2","text":"Kitchen Renovation Schedule"},{"id":"description_text","component":"Text","text":"Here is a detailed schedule for your kitchen remodel from May 1, 2024, to May 15, 2024:"},{"id":"table_container","component":"Column","children":["table_header_row","table_divider","table_row_1","table_row_2","table_row_3","table_row_4","table_row_5","table_row_6"]},{"id":"table_header_row","component":"Row","children":["header_phase","header_start_date","header_end_date","header_duration"]},{"id":"header_phase","component":"Text","text":"Phase","weight":3},{"id":"header_start_date","component":"Text","text":"Start Date","weight":2},{"id":"header_end_date","component":"Text","text":"End Date","weight":2},{"id":"header_duration","component":"Text","text":"Duration (Days)","weight":2},{"id":"table_divider","component":"Divider"},{"id":"table_row_1","component":"Row","children":["row_1_phase","row_1_start_date","row_1_end_date","row_1_duration"]},{"id":"ro