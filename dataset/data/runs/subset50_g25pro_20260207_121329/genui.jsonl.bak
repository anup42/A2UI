0.5355503368502016,"actionable_elements":3.0,"action_coverage":1.0,"url_as_text_rate":0.0,"table_pattern_detected":0.0,"table_cell_coverage":0.0,"section_heading_coverage":0.5,"markdown_leakage_rate":0.0,"missing_ids":0.0,"missing_ids_rate":0.0,"dangling_components":0.0,"dangling_components_rate":0.0,"intent_require_table":1.0,"intent_require_actions":1.0,"intent_require_sections":1.0,"intent_table_ok":0.0,"intent_actions_ok":1.0,"intent_sections_ok":0.0,"intent_expectation_pass":0.0,"intent_score":0.3333333333333333},"gen":{"provider":"gemini","model":"gemini-2.5-pro","prompt_version":"genui_gen_v1","latency_ms":236476.1447906494,"input_tokens":14699,"output_tokens":4294,"cost_usd":null,"error":null},"created_at":"2026-02-07T11:10:20.097525Z"}
{"ui_id":"u_000042_01","response_id":"r_000042_01","query_id":"q_000042","intent":"Booking","tags":["restaurant","dining","business"],"intent_bucket":"booking","genui_json":[{"version":"v0.9","createSurface":{"surfaceId":"surface_q_000042","catalogId":"https://genui.local/specification/v0_9/standard_catalog.json"}},{"version":"v0.9","updateComponents":{"surfaceId":"surface_q_000042","components":[{"id":"root","component":"Column","children":["text_1"]},{"id":"text_1","component":"Text","text":"Assumptions: This confirmation is a template to guide your booking. A placeholder name (\"Ms. Jane Doe\") is used for the reservation. You must contact the restaurant directly to confirm availability and secure the booking, as a reservation for this date and time is extremely competitive and not guaranteed.\n\nDinner Reservation Plan: L'Ambroisie\n\nBooking Confirmation Summary\n\nRestaurant: L'Ambroisie (*** Michelin)\nStatus: PENDING - ACTION REQUIRED\nDate: Tuesday, 24 December 2024\nTime: 20:00 (8:00 PM)\nParty Size: 8 guests\nBooked Under: Ms. Jane Doe (Corporate Group)\nReference ID: L'AMB-CORP-2412 (Provide when calling)\n\nReservation Details\n\nAddress:\n9 Place des Vosges, 75004 Paris, France\n\nSpecial Request:\nA quiet table suitable for business discussion has been requested for your group. Please reiterate this when confirming with the restaurant.\n\nBudget Note:\nThe specified budget is €400 per person. L'Ambroisie's tasting menu and wine pairings may exceed this. It is highly recommended to discuss set menu options or pre-select wines with the sommelier in advance to align with your budget.\n\nCancellation Policy\n\nA minimum of 48 hours' notice is required for cancellation or any changes to your reservation. Given this is a holiday booking for a large group, a deposit and a stricter cancellation policy may apply. Please verify the exact terms directly with the restaurant.\n\nNext Steps to Secure Your Booking\n\n1. Contact Restaurant Immediately: Call L'Ambroisie at your earliest convenience to check for real-time availability. Reservations for Christmas Eve are in exceptionally high demand and are often booked months in advance.\n\n2. Provide Booking Details: If a table is available, provide the details above (date, time, party size) and use the reference ID. You will likely need to provide a primary contact name, phone number, email, and a credit card to secure the booking.\n\n3. Confirm Your Requests: Reiterate your preference for a quiet table and inquire about menu options for the evening.\n\n4. Finalize Menu & Budget: Discuss the menu for Christmas Eve and confirm pricing to ensure it aligns with your group's budget of €400 per person.\n\nImages:\n- L'Ambroisie, Place des Vosges: https://api.service.tourism-system.com/images/153/000/101/711/original/ambroisie-bernard-pacaud-restaurant-paris-4.jpg\n\nQuick Actions:\n[Button: Call L'Ambroisie to Confirm] tel:+33142785145\n[Button: View on Map] https://www.google.com/maps/search/?api=1&query=L'Ambroisie+9+Place+des+Vosges+Paris\n\nSources:\n- Michelin Guide - L'Ambroisie: https://guide.michelin.com/en/ile-de-france/paris/restaurant/l-ambroisie","variant":"body"}]}}],"assets":[],"toon":"[2]:\n  - version: v0.9\n    createSurface:\n      catalogId: \"https://genui.local/specification/v0_9/standard_catalog.json\"\n      surfaceId: surface_q_000042\n  - version: v0.9\n    updateComponents:\n      surfaceId: surface_q_000042\n      components[2]:\n        - component: Column\n          id: root\n          children[1]: text_1\n        - component: Text\n          id: text_1\n          text: \"Assumptions: This confirmation is a template to guide your booking. A placeholder name (\\\"Ms. Jane Doe\\\") is used for the reservation. You must contact the restaurant directly to confirm availability and secure the booking, as a reservation for this date and time is extremely competitive and not guaranteed.\\n\\nDinner Reservation Plan: L'Ambroisie\\n\\nBooking Confirmation Summary\\n\\nRestaurant: L'Ambroisie (*** Michelin)\\nStatus: PENDING - ACTION REQUIRED\\nDate: Tuesday, 24 December 2024\\nTime: 20:00 (8:00 PM)\\nParty Size: 8 guests\\nBooked Under: Ms. Jane Doe (Corporate Group)\\nReference ID: L'AMB-CORP-2412 (Provide when calling)\\n\\nReservation Details\\n\\nAddress:\\n9 Place des Vosges, 75004 Paris, France\\n\\nSpecial Request:\\nA quiet table suitable for business discussion has been requested for your group. Please reiterate this when confirming with the restaurant.\\n\\nBudget Note:\\nThe specified budget is €400 per person. L'Ambroisie's tasting menu and wine pairings may exceed this. It is highly recommended to discuss set menu options or pre-select wines with the sommelier in advance to align with your budget.\\n\\nCancellation Policy\\n\\nA minimum of 48 hours' notice is required for cancellation or any changes to your reservation. Given this is a holiday booking for a large group, a deposit and a stricter cancellation policy may apply. Please verify the exact terms directly with the restaurant.\\n\\nNext Steps to Secure Your Booking\\n\\n1. Contact Restaurant Immediately: Call L'Ambroisie at your earliest convenience to check for real-time availability. Reservations for Christmas Eve are in exceptionally high demand and are often booked months in advance.\\n\\n2. Provide Booking Details: If a table is available, provide the details above (date, time, party size) and use the reference ID. You will likely need to provide a primary contact name, phone number, email, and a credit card to secure the booking.\\n\\n3. Confirm Your Requests: Reiterate your preference for a quiet table and inquire about menu options for the evening.\\n\\n4. Finalize Menu & Budget: Discuss the menu for Christmas Eve and confirm pricing to ensure it aligns with your group's budget of €400 per person.\\n\\nImages:\\n- L'Ambroisie, Place des Vosges: https://api.service.tourism-system.com/images/153/000/101/711/original/ambroisie-bernard-pacaud-restaurant-paris-4.jpg\\n\\nQuick Actions:\\n[Button: Call L'Ambroisie to Confirm] tel:+33142785145\\n[Button: View on Map] https://www.google.com/maps/search/?api=1&query=L'Ambroisie+9+Place+des+Vosges+Paris\\n\\nSources:\\n- Michelin Guide - L'Ambroisie: https://guide.michelin.com/en/ile-de-france/paris/restaurant/l-ambroisie\"\n          variant: body","validation":{"json_parse_ok":true,"schema_valid_strict":true,"schema_valid_lenient":true,"toon_roundtrip_ok":true,"errors":["fallback_generated"],"repair_attempts":1,"repair_needed":true},"metrics":{"content_coverage":1.0,"dup_rate":0.041666666666666664,"lint_score":1.0,"output_tokens_toon":362,"output_tokens_json":357,"component_count":2.0,"unique_component_types":2.0,"max_tree_depth":2.0,"avg_tree_depth":1.5,"container_to_text_ratio":1.0,"information_chunking_score":0.0,"ui_modularity_score":0.0,"ui_decomposition_score":0.2833333333333333,"actionable_elements":0.0,"action_coverage":0.0,"url_as_text_rate":1.0,"table_pattern_detected":0.0,"table_cell_coverage":0.0,"section_heading_coverage":0.0,"markdown_leakage_rate":0.041666666666666664,"missing_ids":0.0,"missing_ids_rate":0.0,"dangling_components":0.0,"dangling_components_rate":0.0,"intent_require_table":0.0,"intent_require_actions":1.0,"intent_require_sections":1.0,"intent_table_ok":0.0,"intent_actions_ok":0.0,"intent_sections_ok":0.0,"intent_expectation_pass":0.0,"intent_score":0.0},"gen":{"provider":"gemini","model":"gemini-2.5-pro","prompt_version":"genui_gen_v1","latency_ms":59914.724588394165,"input_tokens":14664,"output_tokens":3932,"cost_usd":null,"error":null},"created_at":"2026-02-07T11:12:21.287132Z"}
{"ui_id":"u_000051_01","response_id":"r_000051_01","query_id":"q_000051","intent":"weather","tags":["packing-list","forecast-analysis","london"],"intent_bucket":"weather","genui_json":[{"version":"v0.9","createSurface":{"surfaceId":"london-packing-list-01","catalogId":"https://genui.local/specification/v0_9/standard_catalog.json"}},{"version":"v0.9","updateDataModel":{"surfaceId":"london-packing-list-01","path":"/","value":{"tripInfo":{"destination":"London, UK","dates":"2024-10-15 to 2024-10-17","forecast":"Cool, wet, and windy. Temperatures range from 10°C to 14°C with heavy rain and strong winds on the first two days."},"packingSections":[{"id":"outerwear","title":"Outerwear","iconUrl":"/trench-coat","description":"A versatile, weather-resistant outer layer is critical for this trip.","items":[{"id":"item1","label":"Waterproof Trench Coat or Smart Rain Jacket","quantity":"x1","checked":false},{"id":"item2","label":"Compact Travel Umbrella","quantity":"x1","checked":false},{"id":"item3","label":"Wool Scarf","quantity":"x1","checked":false}]},{"id":"footwear","title":"Footwear","iconUrl":"/boots","description":"Comfort and water resistance are key. You will likely be walking between transport and meetings.","items":[{"id":"item4","label":"Waterproof Leather Shoes or Boots","quantity":"x1 pair","checked":false},{"id":"item5","label":"Smart Dress Shoes","quantity":"x1 pair","checked":false}]},{"id":"business_attire","title":"Business Attire","iconUrl":"/briefcase","description":"Focus on layering and fabrics like merino wool, cashmere, and cotton blends that provide warmth without bulk.","items":[{"id":"item6","label":"Suit or Blazer/Trousers/Skirt Combo","quantity":"x2","checked":false},{"id":"item7","label":"Dress Shirts or Blouses","quantity":"x3","checked":false},{"id":"item8","label":"Fine-Knit Sweater or Cardigan","quantity":"x2","checked":false},{"id":"item9","label":"Business-appropriate Trousers or Skirt","quantity":"x1, extra","checked":false},{"id":"item10