{"ui_id":"u_000031_01","response_id":"r_000031_01","query_id":"q_000031","intent":"product_lookup","tags":["electronics","comparison","laptops"],"intent_bucket":"product_lookup","genui_json":[{"version":"v0.9","createSurface":{"surfaceId":"macbook-comparison-surface","catalogId":"https://genui.local/specification/v0_9/standard_catalog.json"}},{"version":"v0.9","updateComponents":{"surfaceId":"macbook-comparison-surface","components":[{"id":"root","component":"Column","children":["summary_card","comparison_card","differences_card","images_card","actions_card","sources_card"]},{"id":"summary_card","component":"Card","child":"summary_column"},{"id":"summary_column","component":"Column","children":["assumptions_text","summary_title","summary_text"]},{"id":"assumptions_text","component":"Text","variant":"caption","text":"Assumptions: This comparison is based on the official technical specifications released by Apple for the standard configurations of both models. \"Base\" refers to the entry-level configuration, and \"Maximum\" refers to the highest build-to-order option available."},{"id":"summary_title","component":"Text","variant":"h2","text":"Summary"},{"id":"summary_text","component":"Text","text":"The 2022 MacBook Air (M2) offers a significant upgrade over the 2020 M1 model, featuring a more powerful and efficient chip, a modern flat-edge design, a larger and brighter display, and expanded memory support. While the M1 model remains a powerful machine for everyday tasks, the M2 model provides notable performance gains, particularly in graphics-intensive applications, and introduces key quality-of-life improvements like MagSafe charging and a better webcam."},{"id":"comparison_card","component":"Card","child":"comparison_column"},{"id":"comparison_column","component":"Column","children":["comparison_title","table_header_row","divider_1","cpu_row","divider_2","gpu_row","divider_3","memory_row","divider_4","weight_row"]},{"id":"comparison_title","component":"Text","variant":"h3","text":"Comparison Table"},{"id":"table_header_row","component":"Row","children":["spec_header","m1_header","m2_header"]},{"id":"spec_header","component":"Text","text":"Specification","weight":2},{"id":"m1_header","component":"Text","text":"2020 MacBook Air (M1)","weight":1},{"id":"m2_header","component":"Text","text":"2022 MacBook Air (M2)","weight":1},{"id":"divider_1","component":"Divider"},{"id":"cpu_row","component":"Row","children":["cpu_spec","cpu_m1","cpu_m2"]},{"id":"cpu_spec","component":"Text","text":"CPU Cores (Base)","weight":2},{"id":"cpu_m1","component":"Text","text":"8-core (4 performance, 4 efficiency)","weight":1},{"id":"cpu_m2","component":"Text","text":"8-core (4 performance, 4 efficiency)","weight":1},{"id":"divider_2","component":"Divider"},{"id":"gpu_row","component":"Row","children":["gpu_spec","gpu_m1","gpu_m2"]},{"id":"gpu_spec","component":"Text","text":"GPU Cores (Base)","weight":2},{"id":"gpu_m1","component":"Text","text":"7-core","weight":1},{"id":"gpu_m2","component":"Text","text":"8-core","weight":1},{"id":"divider_3","component":"Divider"},{"id":"memory_row","component":"Row","children":["memory_spec","memory_m1","memory_m2"]},{"id":"memory_spec","component":"Text","text":"Maximum Unified Memory","weight":2},{"id":"memory_m1","component":"Text","text":"16GB","weight":1},{"id":"memory_m2","component":"Text","text":"24GB","weight":1},{"id":"divider_4","component":"Divider"},{"id":"weight_row","component":"Row","children":["weight_spec","weight_m1","weight_m2"]},{"id":"weight_spec","component":"Text","text":"Weight","weight":2},{"id":"weight_m1","component":"Text","text":"2.8 pounds (1.29 kg)","weight":1},{"id":"weight_m2","component":"Text","text":"2.7 pounds (1.24 kg)","weight":1},{"id":"differences_card","component":"Card","child":"differences_column"},{"id":"differences_column","component":"Column","children":["differences_title","processor_title","processor_text","design_title","design_text","charging_title","charging_text","camera_title","camera_text"]},{"id":"differences_title","component":"Text","variant":"h3","text":"Key Differences Explained"},{"id":"processor_title","component":"Text","variant":"h4","text":"Processor Performance"},{"id":"processor_text","component":"Text","text":"The M2 chip delivers an 18% faster CPU, a 35% more powerful GPU, and a 40% faster Neural Engine compared to the M1. It also features increased memory bandwidth, which improves multitasking performance."},{"id":"design_title","component":"Text","variant":"h4","text":"Design and Display"},{"id":"design_text","component":"Text","text":"The M2 Air has a completely new, uniform-thickness design and is slightly lighter. It boasts a larger 13.6-inch Liquid Retina display that is brighter (500 nits vs. 400 nits) and supports 1 billion colors. This display includes a notch for the camera. The M1 Air retains the classic tapered wedge design with a 13.3-inch Retina display."},{"id":"charging_title","component":"Text","variant":"h4","text":"Charging and Ports"},{"id":"charging_text","component":"Text","text":"The M2 Air brings back the dedicated MagSafe 3 charging port, which frees up its two Thunderbolt / USB 4 ports for accessories even while charging. The M1 Air charges via one of its two Thunderbolt / USB 4 ports."},{"id":"camera_title","component":"Text","variant":"h4","text":"Camera and Audio"},{"id":"camera_text","component":"Text","text":"The M2 model features an upgraded 1080p FaceTime HD camera, providing a much clearer image than the 720p camera on the M1 model. It also has an improved four-speaker sound system."},{"id":"images_card","component":"Card","child":"images_column"},{"id":"images_column","component":"Column","children":["images_title","images_row"]},{"id":"images_title","component":"Text","variant":"h3","text":"Images"},{"id":"images_row","component":"Row","children":["m1_image_col","m2_image_col"]},{"id":"m1_image_col","component":"Column","align":"center","children":["m1_image","m1_caption"]},{"id":"m1_image","component":"Image","url":"/macbook-air-m1.jpeg","accessibility":{"label":"2020 MacBook Air M1 in gold color"}},{"id":"m1_caption","component":"Text","text":"2020 MacBook Air (M1) Design"},{"id":"m2_image_col","component":"Column","align":"center","children":["m2_image","m2_caption"]},{"id":"m2_image","component":"Image","url":"/macbook-air-m2.jpeg","accessibility":{"label":"2022 MacBook Air M2 in midnight color"}},{"id":"m2_caption","component":"Text","text":"2022 MacBook Air (M2) Design"},{"id":"actions_card","component":"Card","child":"actions_column"},{"id":"actions_column","component":"Column","children":["actions_title","compare_button","m2_specs_button","m1_specs_button"]},{"id":"actions_title","component":"Text","variant":"h3","text":"Quick Actions"},{"id":"compare_button","component":"Button","child":"compare_button_text","action":{"functionCall":{"call":"openUrl","args":{"url":"https://www.apple.com/mac/compare/"}}}},{"id":"compare_button_text","component":"Text","text":"Compare Mac Models on Apple.com"},{"id":"m2_specs_button","component":"Button","child":"m2_specs_button_text","action":{"functionCall":{"call":"openUrl","args":{"url":"https://www.apple.com/macbook-air-13-and-15-m2/specs/"}}}},{"id":"m2_specs_button_text","component":"Text","text":"View M2 MacBook Air Tech Specs"},{"id":"m1_specs_button","component":"Button","child":"m1_specs_button_text","action":{"functionCall":{"call":"openUrl","args":{"url":"https://support.apple.com/kb/SP825"}}}},{"id":"m1_specs_button_text","component":"Text","text":"View M1 MacBook Air Tech Specs"},{"id":"sources_card","component":"Card","child":"sources_column"},{"id":"sources_column","component":"Column","children":["sources_title","source_1_button","source_2_button"]},{"id":"sources_title","component":"Text","variant":"h3","text":"Sources"},{"id":"source_1_button","component":"Button","variant":"borderless","child":"source_1_text","action":{"functionCall":{"call":"openUrl","args":{"url":"https://www.apple.com/newsroom/2022/06/apple-unveils-all-new-macbook-air-supercharged-by-the-new-m2-chip/"}}}},{"id":"source_1_text","component":"Text","text":"Apple Newsroom: M2 MacBook Air Unveiling"},{"id":"source_2_button","component":"Button","variant":"borderless","child":"source_2_text","action":{"functionCall":{"call":"openUrl","args":{"url":"https://support.apple.com/kb/SP869"}}}},{"id":"source_2_text","component":"Text","text":"Apple Support: M2 MacBook Air Tech Specs"}]}}],"assets":[],"toon":"[2]:\n  - version: v0.9\n    createSurface:\n      catalogId: \"https://genui.local/specification/v0_9/standard_catalog.json\"\n      surfaceId: macbook-comparison-surface\n  - version: v0.9\n    updateComponents:\n      surfaceId: macbook-comparison-surface\n      components[70]:\n        - component: Column\n          id: root\n          children[6]: summary_card,comparison_card,differences_card,images_card,actions_card,sources_card\n        - child: summary_column\n          component: Card\n          id: summary_card\n        - component: Column\n          id: summary_column\n          children[3]: assumptions_text,summary_title,summary_text\n        - component: Text\n          id: assumptions_text\n          text: \"Assumptions: This comparison is based on the official technical specifications released by Apple for the standard configurations of both models. \\\"Base\\\" refers to the entry-level configuration, and \\\"Maximum\\\" refers to the highest build-to-order option available.\"\n          variant: caption\n        - component: Text\n          id: summary_title\n          text: Summary\n          variant: h2\n        - component: Text\n          id: summary_text\n          text: \"The 2022 MacBook Air (M2) offers a significant upgrade over the 2020 M1 model, featuring a more powerful and efficient chip, a modern flat-edge design, a larger and brighter display, and expanded memory support. While the M1 model remains a powerful machine for everyday tasks, the M2 model provides notable performance gains, particularly in graphics-intensive applications, and introduces key quality-of-life improvements like MagSafe charging and a better webcam.\"\n        - child: comparison_column\n          component: Card\n          id: comparison_card\n        - component: Column\n          id: comparison_column\n          children[10]: comparison_title,table_header_row,divider_1,cpu_row,divider_2,gpu_row,divider_3,memory_row,divider_4,weight_row\n        - component: Text\n          id: comparison_title\n          text: Comparison Table\n          variant: h3\n        - component: Row\n          id: table_header_row\n          children[3]: spec_header,m1_header,m2_header\n        - component: Text\n          id: spec_header\n          text: Specification\n          weight: 2\n        - component: Text\n          id: m1_header\n          text: 2020 MacBook Air (M1)\n          weight: 1\n        - component: Text\n          id: m2_header\n          text: 2022 MacBook Air (M2)\n          weight: 1\n        - component: Divider\n          id: divider_1\n        - component: Row\n          id: cpu_row\n          children[3]: cpu_spec,cpu_m1,cpu_m2\n        - component: Text\n          id: cpu_spec\n          text: CPU Cores (Base)\n          weight: 2\n        - component: Text\n          id: cpu_m1\n          text: \"8-core (4 performance, 4 efficiency)\"\n          weight: 1\n        - component: Text\n          id: cpu_m2\n          text: \"8-core (4 performance, 4 efficiency)\"\n          weight: 1\n        - component: Divider\n          id: divider_2\n        - component: Row\n          id: gpu_row\n          children[3]: gpu_spec,gpu_m1,gpu_m2\n        - component: Text\n          id: gpu_spec\n          text: GPU Cores (Base)\n          weight: 2\n        - component: Text\n          id: gpu_m1\n          text: 7-core\n          weight: 1\n        - component: Text\n          id: gpu_m2\n          text: 8-core\n          weight: 1\n        - component: Divider\n          id: divider_3\n        - component: Row\n          id: memory_row\n          children[3]: memory_spec,memory_m1,memory_m2\n        - component: Text\n          id: memory_spec\n          text: Maximum Unified Memory\n          weight: 2\n        - component: Text\n          id: memory_m1\n          text: 16GB\n          weight: 1\n        - component: Text\n          id: memory_m2\n          text: 24GB\n          weight: 1\n        - component: Divider\n          id: divider_4\n        - component: Row\n          id: weight_row\n          children[3]: weight_spec,weight_m1,weight_m2\n        - component: Text\n          id: weight_spec\n          text: Weight\n          weight: 2\n        - component: Text\n          id: weight_m1\n          text: 2.8 pounds (1.29 kg)\n          weight: 1\n        - component: Text\n          id: weight_m2\n          text: 2.7 pounds (1.24 kg)\n          weight: 1\n        - child: differences_column\n          component: Card\n          id: differences_card\n        - component: Column\n          id: differences_column\n          children[9]: differences_title,processor_title,processor_text,design_title,design_text,charging_title,charging_text,camera_title,camera_text\n        - component: Text\n          id: differences_title\n          text: Key Differences Explained\n          variant: h3\n        - component: Text\n          id: processor_title\n          text: Processor Performance\n          variant: h4\n        - component: Text\n          id: processor_text\n          text: \"The M2 chip delivers an 18% faster CPU, a 35% more powerful GPU, and a 40% faster Neural Engine compared to the M1. It also features increased memory bandwidth, which improves multitasking performance.\"\n        - component: Text\n          id: design_title\n          text: Design and Display\n          variant: h4\n        - component: Text\n          id: design_text\n          text: \"The M2 Air has a completely new, uniform-thickness design and is slightly lighter. It boasts a larger 13.6-inch Liquid Retina display that is brighter (500 nits vs. 400 nits) and supports 1 billion colors. This display includes a notch for the camera. The M1 Air retains the classic tapered wedge design with a 13.3-inch Retina display.\"\n        - component: Text\n          id: charging_title\n          text: Charging and Ports\n          variant: h4\n        - component: Text\n          id: charging_text\n          text: \"The M2 Air brings back the dedicated MagSafe 3 charging port, which frees up its two Thunderbolt / USB 4 ports for accessories even while charging. The M1 Air charges via one of its two Thunderbolt / USB 4 ports.\"\n        - component: Text\n          id: camera_title\n          text: Camera and Audio\n          variant: h4\n        - component: Text\n          id: camera_text\n          text: \"The M2 model features an upgraded 1080p FaceTime HD camera, providing a much clearer image than the 720p camera on the M1 model. It also has an improved four-speaker sound system.\"\n        - child: images_column\n          component: Card\n          id: images_card\n        - component: Column\n          id: images_column\n          children[2]: images_title,images_row\n        - component: Text\n          id: images_title\n          text: Images\n          variant: h3\n        - component: Row\n          id: images_row\n          children[2]: m1_image_col,m2_image_col\n        - align: center\n          component: Column\n          id: m1_image_col\n          children[2]: m1_image,m1_caption\n        - component: Image\n          id: m1_image\n          url: /macbook-air-m1.jpeg\n          accessibility:\n            label: 2020 MacBook Air M1 in gold color\n        - component: Text\n          id: m1_caption\n          text: 2020 MacBook Air (M1) Design\n        - align: center\n          component: Column\n          id: m2_image_col\n          children[2]: m2_image,m2_caption\n        - component: Image\n          id: m2_image\n          url: /macbook-air-m2.jpeg\n          accessibility:\n            label: 2022 MacBook Air M2 in midnight color\n        - component: Text\n          id: m2_caption\n          text: 2022 MacBook Air (M2) Design\n        - child: actions_column\n          component: Card\n          id: actions_card\n        - component: Column\n          id: actions_column\n          children[4]: actions_title,compare_button,m2_specs_button,m1_specs_button\n        - component: Text\n          id: actions_title\n          text: Quick Actions\n          variant: h3\n        - child: compare_button_text\n          component: Button\n          id: compare_button\n          action:\n            functionCall:\n              call: openUrl\n              args:\n                url: \"https://www.apple.com/mac/compare/\"\n        - component: Text\n          id: compare_button_text\n          text: Compare Mac Models on Apple.com\n        - child: m2_specs_button_text\n          component: Button\n          id: m2_specs_button\n          action:\n            functionCall:\n              call: openUrl\n              args:\n                url: \"https://www.apple.com/macbook-air-13-and-15-m2/specs/\"\n        - component: Text\n          id: m2_specs_button_text\n          text: View M2 MacBook Air Tech Specs\n        - child: m1_specs_button_text\n          component: Button\n          id: m1_specs_button\n          action:\n            functionCall:\n              call: openUrl\n              args:\n                url: \"https://support.apple.com/kb/SP825\"\n        - component: Text\n          id: m1_specs_button_text\n          text: View M1 MacBook Air Tech Specs\n        - child: sources_column\n          component: Card\n          id: sources_card\n        - component: Column\n          id: sources_column\n          children[3]: sources_title,source_1_button,source_2_button\n        - component: Text\n          id: sources_title\n          text: Sources\n          variant: h3\n        - child: source_1_text\n          component: Button\n          id: source_1_button\n          variant: borderless\n          action:\n            functionCall:\n              call: openUrl\n              args:\n                url: \"https://www.apple.com/newsroom/2022/06/apple-unveils-all-new-macbook-air-supercharged-by-the-new-m2-chip/\"\n        - component: Text\n          id: source_1_text\n          text: \"Apple Newsroom: M2 MacBook Air Unveiling\"\n        - child: source_2_text\n          component: Button\n          id: source_2_button\n          variant: borderless\n          action:\n            functionCall:\n              call: openUrl\n              args:\n                url: \"https://support.apple.com/kb/SP869\"\n        - component: Text\n          id: source_2_text\n          text: \"Apple Support: M2 MacBook Air Tech Specs\"","validation":{"json_parse_ok":true,"schema_valid_strict":true,"schema_valid_lenient":true,"toon_roundtrip_ok":true,"errors":[],"repair_attempts":0,"repair_needed":false},"metrics":{"content_coverage":0.9295774647887324,"dup_rate":0.2948717948717949,"lint_score":1.0,"output_tokens_toon":938,"output_tokens_json":908,"component_count":70.0,"unique_component_types":7.0,"max_tree_depth":6.0,"avg_tree_depth":1.6714285714285715,"container_to_text_ratio":0.5526315789473685,"information_chunking_score":0.7952548330404218,"ui_modularity_score":0.17142857142857143,"ui_decomposition_score":0.5058554778862799,"actionable_elements":5.0,"action_coverage":1.0,"url_as_text_rate":0.0,"table_pattern_detected":0.0,"table_cell_coverage":0.0,"section_heading_coverage":0.8571428571428571,"markdown_leakage_rate":0.0,"missing_ids":0.0,"missing_ids_rate":0.0,"dangling_components":0.0,"dangling_components_rate":0.0,"intent_require_table":1.0,"intent_require_actions":1.0,"intent_require_sections":1.0,"intent_table_ok":0.0,"intent_actions_ok":1.0,"intent_sections_ok":1.0,"intent_expectat