          text: Total Monthly Expenses\n          variant: h4\n        - component: Text\n          id: summaryAmount\n          variant: h3\n          text:\n            call: formatCurrency\n            returnType: string\n            args:\n              currency:\n                path: /currency\n              value:\n                path: /totalAmount\n        - component: Text\n          id: summaryDescription\n          text: This is the sum of all expense categories for January 2024.\n          variant: body\n        - component: Text\n          id: breakdownTitle\n          text: Detailed Breakdown\n          variant: h3\n        - component: Row\n          id: tableHeaderRow\n          justify: spaceBetween\n          children[3]: categoryHeader,amountHeader,percentageHeader\n        - component: Text\n          id: categoryHeader\n          text: Category\n          weight: 2\n        - component: Text\n          id: amountHeader\n          text: Amount\n          weight: 1\n        - component: Text\n          id: percentageHeader\n          text: Percentage of Total\n          weight: 1\n        - component: Divider\n          id: headerDivider\n        - component: List\n          direction: vertical\n          id: expenseList\n          children:\n            componentId: expenseRowTemplate\n            path: /expenses\n        - component: Row\n          id: expenseRowTemplate\n          justify: spaceBetween\n          children[3]: categoryCell,amountCell,percentageCell\n        - component: Text\n          id: categoryCell\n          weight: 2\n          text:\n            path: category\n        - component: Text\n          id: amountCell\n          weight: 1\n          text:\n            call: formatCurrency\n            returnType: string\n            args:\n              currency:\n                path: /currency\n              value:\n                path: amount\n        - component: Text\n          id: percentageCell\n          weight: 1\n          text:\n            call: formatString\n            returnType: string\n            args:\n              value: \"${percentage}%\"\n        - component: Divider\n          id: totalDivider\n        - component: Row\n          id: totalRow\n          justify: spaceBetween\n          children[3]: totalLabel,totalAmount,totalPercentage\n        - component: Text\n          id: totalLabel\n          text: **Total**\n          weight: 2\n        - component: Text\n          id: totalAmount\n          weight: 1\n          text:\n            call: formatCurrency\n            returnType: string\n            args:\n              currency:\n                path: /currency\n              value:\n                path: /totalAmount\n        - component: Text\n          id: totalPercentage\n          text: **100.0%**\n          weight: 1\n        - component: Text\n          id: actionsTitle\n          text: Quick Actions\n          variant: h4\n        - component: Row\n          id: actionsRow\n          justify: start\n          children[3]: budgetButton,tipsButton,exportButton\n        - child: budgetText\n          component: Button\n          id: budgetButton\n          action:\n            event:\n              name: createBudget\n        - component: Text\n          id: budgetText\n          text: Create a Budget for February\n        - child: tipsText\n          component: Button\n          id: tipsButton\n          action:\n            event:\n              name: findSavingTips\n        - component: Text\n          id: tipsText\n          text: Find Tips for Saving Money\n        - child: exportText\n          component: Button\n          id: exportButton\n          action:\n            event:\n              name: exportReport\n              context:\n                format: csv\n        - component: Text\n          id: exportText\n          text: Export Report as CSV","validation":{"json_parse_ok":true,"schema_valid_strict":true,"schema_valid_lenient":true,"toon