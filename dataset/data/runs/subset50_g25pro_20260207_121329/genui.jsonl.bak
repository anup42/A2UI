\n          url: /assets/r_000562_01_1_account_balance_wallet_gm_grey_24dp.png\n          variant: icon\n        - component: Text\n          id: header_title\n          text: Credit Card Comparison\n          variant: h2\n        - component: Text\n          id: summary_text\n          text: \"Based on your provided monthly spending, Card A offers a higher net annual value compared to Card B.\"\n          variant: body\n        - child: assumptions_column\n          component: Card\n          id: assumptions_card\n        - component: Column\n          id: assumptions_column\n          children[2]: assumptions_title,assumptions_text\n        - component: Text\n          id: assumptions_title\n          text: Assumptions\n          variant: h4\n        - component: Text\n          id: assumptions_text\n          text: \"- Calculations are based on the exact monthly spending figures provided for a full year (12 months).\\n- Cashback is calculated directly on the specified spend categories and rates.\\n- No other fees or introductory offers are considered.\"\n        - component: Text\n          id: details_title\n          text: Detailed Calculation\n          variant: h3\n        - child: card_a_column\n          component: Card\n          id: card_a_card\n        - component: Column\n          id: card_a_column\n          children[2]: card_a_title,card_a_details\n        - component: Text\n          id: card_a_title\n          text: Card A Analysis\n          variant: h4\n        - component: Text\n          id: card_a_details\n          text: \"**Cashback Rate:** 2% on all purchases\\n**Annual Fee:** $0\\n\\n**Monthly Spending:**\\n- Dining: $500\\n- Travel: $200\\n- Other: $1,300\\n- Total Monthly Spending: $2,000\\n\\n**Annual Calculations:**\\n- Total Annual Spending: $24,000\\n- Annual Cashback Earned: $480\\n- **Net Annual Value (Card A): $480**\"\n        - child: card_b_column\n          component: Card\n          id: card_b_card\n        - component: Colum