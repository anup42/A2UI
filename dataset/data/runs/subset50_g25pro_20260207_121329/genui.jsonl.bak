ormatString","returnType":"string","args":{"value":"Location: ${location}"}}},{"id":"arrival_title","component":"Text","variant":"h3","text":"Estimated Arrival Order:"},{"id":"arrival_list","component":"Column","children":["arrival_item_1","arrival_item_2","arrival_item_3"]},{"id":"arrival_item_1","component":"Column","children":["arrival_item_1_title","arrival_item_1_desc"]},{"id":"arrival_item_1_title","component":"Text","text":"1. Package ID: 94001 (Out for Delivery)"},{"id":"arrival_item_1_desc","component":"Text","text":"This package is the closest to delivery and is likely to arrive today (May 20th) or the next business day."},{"id":"arrival_item_2","component":"Column","children":["arrival_item_2_title","arrival_item_2_desc"]},{"id":"arrival_item_2_title","component":"Text","text":"2. Package ID: 94002 (In Transit)"},{"id":"arrival_item_2_desc","component":"Text","text":"This package has arrived at a sorting facility and is actively moving. It will likely arrive after package 94001, typically within a few business days depending on its final destination."},{"id":"arrival_item_3","component":"Column","children":["arrival_item_3_title","arrival_item_3_desc"]},{"id":"arrival_item_3_title","component":"Text","text":"3. Package ID: 94003 (Label Created, pending pickup)"},{"id":"arrival_item_3_desc","component":"Text","text":"This package has only had its label created and has not yet been picked up by the carrier. It will be the last to arrive, as its journey has not yet begun."},{"id":"assumptions_text","component":"Text","variant":"caption","text":"Assumptions: These estimates are based on typical shipping timelines for each status. Actual delivery times may vary due to carrier operations, unforeseen delays, or specific service levels."},{"id":"actions_row","component":"Row","justify":"spaceAround","children":{"componentId":"track_button_template","path":"/packages"}},{"id":"track_button_template","component":"Button","child":"track_button_text_template","action