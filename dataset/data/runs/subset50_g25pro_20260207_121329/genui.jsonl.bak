{"ui_id":"u_000001_01","response_id":"r_000001_01","query_id":"q_000001","intent":"Information Retrieval","tags":["finance","mortgage-comparison","calculators"],"intent_bucket":"information_retrieval","genui_json":[{"version":"v0.9","createSurface":{"surfaceId":"mortgage-comparison-surface","catalogId":"https://genui.local/specification/v0_9/standard_catalog.json"}},{"version":"v0.9","updateComponents":{"surfaceId":"mortgage-comparison-surface","components":[{"id":"root","component":"Column","children":["main_title","assumptions_card","summary_card","comparison_title","option_a_card","option_b_card","option_c_card"]},{"id":"main_title","component":"Text","variant":"h1","text":"Mortgage Options Comparison: Austin, TX"},{"id":"assumptions_card","component":"Card","child":"assumptions_column"},{"id":"assumptions_column","component":"Column","children":["assumptions_title","assumptions_text"]},{"id":"assumptions_title","component":"Text","variant":"h3","text":"Assumptions"},{"id":"assumptions_text","component":"Text","text":"- The calculations below are for principal and interest (P&I) only and do not include property taxes, homeowners insurance, or other escrow payments. Your total monthly housing payment will be higher.\n- The 5/1 ARM rate is assumed to adjust once after the initial 5-year period to 7.5% (a 2% increase) and remain at that rate for the remaining 25 years of the loan. Real-world ARMs may adjust annually and have different caps.\n- No additional principal payments are made during the life of the loan.\n- Closing costs are not factored into this analysis."},{"id":"summary_card","component":"Card","child":"summary_column"},{"id":"summary_column","component":"Column","children":["summary_title","home_price_row","down_payment_row","loan_amount_row"]},{"id":"summary_title","component":"Text","variant":"h3","text":"Loan Summary"},{"id":"home_price_row","component":"Row","justify":"spaceBetween","children":["home_price_label","home_price_value"]},{"id":"home_price_label","component":"Text","text":"Home Price:"},{"id":"home_price_value","component":"Text","text":"$500,000"},{"id":"down_payment_row","component":"Row","justify":"spaceBetween","children":["down_payment_label","down_payment_value"]},{"id":"down_payment_label","component":"Text","text":"Down Payment (20%):"},{"id":"down_payment_value","component":"Text","text":"$100,000"},{"id":"loan_amount_row","component":"Row","justify":"spaceBetween","children":["loan_amount_label","loan_amount_value"]},{"id":"loan_amount_label","component":"Text","text":"Loan Amount:"},{"id":"loan_amount_value","component":"Text","text":"$400,000"},{"id":"comparison_title","component":"Text","variant":"h2","text":"MORTGAGE OPTION COMPARISON"},{"id":"option_a_card","component":"Card","child":"option_a_column"},{"id":"option_a_column","component":"Column","children":["option_a_header","option_a_rate_row","option_a_payment_row","option_a_interest_row"]},{"id":"option_a_header","component":"Row","align":"center","children":["option_a_icon","option_a_title"]},{"id":"option_a_icon","component":"Image","variant":"icon","url":"/loan_option"},{"id":"option_a_title","component":"Text","variant":"h4","text":"Option A: 30-Year Fixed"},{"id":"option_a_rate_row","component":"Row","justify":"spaceBetween","children":["option_a_rate_label","option_a_rate_value"]},{"id":"option_a_rate_label","component":"Text","text":"Interest Rate:"},{"id":"option_a_rate_value","component":"Text","text":"6.50%"},{"id":"option_a_payment_row","component":"Row","justify":"spaceBetween","children":["option_a_payment_label","option_a_payment_value"]},{"id":"option_a_payment_label","component":"Text","text":"Monthly P&I Payment:"},{"id":"option_a_payment_value","component":"Text","text":"$2,528"},{"id":"option_a_interest_row","component":"Row","justify":"spaceBetween","children":["option_a_interest_label","option_a_interest_value"]},{"id":"option_a_interest_label","component":"Text","text":"Total Interest Paid:"},{"id":"option_a_interest_value","component":"Text","text":"$509,900"},{"id":"option_b_card","component":"Card","child":"option_b_column"},{"id":"option_b_column","component":"Column","children":["option_b_header","option_b_rate_row","option_b_payment_row","option_b_interest_row"]},{"id":"option_b_header","component":"Row","align":"center","children":["option_b_icon","option_b_title"]},{"id":"option_b_icon","component":"Image","variant":"icon","url":"/loan_option"},{"id":"option_b_title","component":"Text","variant":"h4","text":"Option B: 15-Year Fixed"},{"id":"option_b_rate_row","component":"Row","justify":"spaceBetween","children":["option_b_rate_label","option_b_rate_value"]},{"id":"option_b_rate_label","component":"Text","text":"Interest Rate:"},{"id":"option_b_rate_value","component":"Text","text":"5.75%"},{"id":"option_b_payment_row","component":"Row","justify":"spaceBetween","children":["option_b_payment_label","option_b_payment_value"]},{"id":"option_b_payment_label","component":"Text","text":"Monthly P&I Payment:"},{"id":"option_b_payment_value","component":"Text","text":"$3,323"},{"id":"option_b_interest_row","component":"Row","justify":"spaceBetween","children":["option_b_interest_label","option_b_interest_value"]},{"id":"option_b_interest_label","component":"Text","text":"Total Interest Paid:"},{"id":"option_b_interest_value","component":"Text","text":"$198,138"},{"id":"option_c_card","component":"Card","child":"option_c_column"},{"id":"option_c_column","component":"Column","children":["option_c_header","option_c_rate_row"]},{"id":"option_c_header","component":"Row","align":"center","children":["option_c_icon","option_c_title"]},{"id":"option_c_icon","component":"Image","variant":"icon","url":"/loan_option"},{"id":"option_c_title","component":"Text","variant":"h4","text":"Option C: 5/1 Adjustable-Rate Mortgage (ARM)"},{"id":"option_c_rate_row","component":"Row","children":["option_c_rate_label"]},{"id":"option_c_rate_label","component":"Text","text":"Interest Rate (Years"}]}}],"assets":[],"toon":"[2]:\n  - version: v0.9\n    createSurface:\n      catalogId: \"https://genui.local/specification/v0_9/standard_catalog.json\"\n      surfaceId: mortgage-comparison-surface\n  - version: v0.9\n    updateComponents:\n      surfaceId: mortgage-comparison-surface\n      components[54]:\n        - component: Column\n          id: root\n          children[7]: main_title,assumptions_card,summary_card,comparison_title,option_a_card,option_b_card,option_c_card\n        - component: Text\n          id: main_title\n          text: \"Mortgage Options Comparison: Austin, TX\"\n          variant: h1\n        - child: assumptions_column\n          component: Card\n          id: assumptions_card\n        - component: Column\n          id: assumptions_column\n          children[2]: assumptions_title,assumptions_text\n        - component: Text\n          id: assumptions_title\n          text: Assumptions\n          variant: h3\n        - component: Text\n          id: assumptions_text\n          text: \"- The calculations below are for principal and interest (P&I) only and do not include property taxes, homeowners insurance, or other escrow payments. Your total monthly housing payment will be higher.\\n- The 5/1 ARM rate is assumed to adjust once after the initial 5-year period to 7.5% (a 2% increase) and remain at that rate for the remaining 25 years of the loan. Real-world ARMs may adjust annually and have different caps.\\n- No additional principal payments are made during the life of the loan.\\n- Closing costs are not factored into this analysis.\"\n        - child: summary_column\n          component: Card\n          id: summary_card\n        - component: Column\n          id: summary_column\n          children[4]: summary_title,home_price_row,down_payment_row,loan_amount_row\n        - component: Text\n          id: summary_title\n          text: Loan Summary\n          variant: h3\n        - component: Row\n          id: home_price_row\n         