id":"ba_button","component":"Button","child":"ba_button_text","action":{"functionCall":{"call":"openUrl","args":{"url":"https://www.britishairways.com"}}}},{"id":"ba_button_text","component":"Text","text":"Check Availability on British Airways"},{"id":"emirates_button","component":"Button","child":"emirates_button_text","action":{"functionCall":{"call":"openUrl","args":{"url":"https://www.emirates.com/uk/english/"}}}},{"id":"emirates_button_text","component":"Text","text":"Check Availability on Emirates"}]}}],"assets":[{"url":"https://images.unsplash.com/photo-1542051841857-5f90071e7989","path":"assets\\r_000041_01_1_photo-1542051841857-5f90071e7989.jpg","sha256":"379f55fec52e83b08a762c903e730e517dfc4499d7ce68af69a940d4c56f90a3","bytes":7391048}],"toon":"[2]:\n  - version: v0.9\n    createSurface:\n      catalogId: \"https://genui.local/specification/v0_9/standard_catalog.json\"\n      surfaceId: flight-recommendation-surface\n  - version: v0.9\n    updateComponents:\n      surfaceId: flight-recommendation-surface\n      components[83]:\n        - component: Column\n          id: root\n          children[18]: title,main_image,summary_header,summary_text,divider_1,comparison_header,ana_card,ba_card,emirates_card,divider_2,trip_details_header,trip_details_column,divider_3,cost_breakdown_header,cost_breakdown_column,divider_4,actions_header,actions_row\n        - component: Text\n          id: title\n          text: \"Flight Recommendation: London to Tokyo\"\n          variant: h1\n        - component: Image\n          id: main_image\n          url: /assets/r_000041_01_1_photo-1542051841857-5f90071e7989.jpg\n          accessibility:\n            label: Tokyo Destination\n        - component: Text\n          id: summary_header\n          text: Summary\n          variant: h3\n        - component: Text\n          id: summary_text\n          text: \"Based on your priority of the shortest travel time, the best option is the All Nippon Airways (ANA) direct flight. At 13 hours and 50 minutes, it is the fastest of the three choices and is within your specified budget of £3,500. While the Emirates flight is the most affordable, its significantly longer travel time and layover make it less ideal for your request.\"\n          variant: body\n        - component: Divider\n          id: divider_1\n        - component: Text\n          id: comparison_header\n          text: Flight Comparison\n          variant: h3\n        - child: ana_card_content\n          component: Card\n          id: ana_card\n        - component: Column\n          id: ana_card_content\n          children[5]: ana_title,ana_summary,ana_price_row,ana_time_row,ana_stops_row\n        - component: Text\n          id: ana_title\n          text: \"Option 1: All Nippon Airways (ANA) - Recommended\"\n          variant: h4\n        - component: Text\n          id: ana_summary\n          text: \"The fastest flight, direct to Tokyo (HND).\"\n        - align: center\n          component: Row\n          id: ana_price_row\n          children[1]: ana_price_text\n        - component: Text\n          id: ana_price_text\n          text: \"Total Price: £3,450\"\n        - align: center\n          component: Row\n          id: ana_time_row\n          children[1]: ana_time_text\n        - component: Text\n          id: ana_time_text\n          text: \"Travel Time: 13h 50m\"\n        - align: center\n          component: Row\n          id: ana_stops_row\n          children[1]: ana_stops_text\n        - component: Text\n          id: ana_stops_text\n          text: \"Stops: Direct\"\n        - child: ba_card_content\n          component: Card\n          id: ba_card\n        - component: Column\n          id: ba_card_content\n          children[5]: ba_title,ba_summary,ba_price_row,ba_time_row,ba_stops_row\n        - component: Text\n          id: ba_title\n          text: \"Option 2: British Airways\"\n          variant: h4\n        - component: Text\n          id: ba_summary\n          text: A s