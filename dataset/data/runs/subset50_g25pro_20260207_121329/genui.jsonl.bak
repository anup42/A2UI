aderRow,overviewTitle,budgetTable,savingsHeaderRow,savingsGoalText,areasToSaveTitle,savingsOptionsColumn,totalSavingsText,actionsTitle,actionsRow\n        - align: center\n          component: Row\n          id: headerRow\n          children[2]: financeIcon,mainTitle\n        - component: Image\n          id: financeIcon\n          url: /finance-icon.png\n          variant: icon\n        - component: Text\n          id: mainTitle\n          text: Your Monthly Budget Analysis\n          variant: h1\n        - component: Text\n          id: overviewTitle\n          text: \"Your Monthly Budget Overview:\"\n          variant: h2\n        - component: Column\n          id: budgetTable\n          children[11]: rentRow,groceriesRow,diningOutRow,utilitiesRow,internetRow,streamingServicesRow,gymRow,transportationRow,miscRow,totalDivider,totalRow\n        - component: Row\n          id: rentRow\n          justify: spaceBetween\n          children[2]: rentLabel,rentAmount\n        - component: Text\n          id: rentLabel\n          text: Rent\n        - component: Text\n          id: rentAmount\n          text: \"$2,100\"\n        - component: Row\n          id: groceriesRow\n          justify: spaceBetween\n          children[2]: groceriesLabel,groceriesAmount\n        - component: Text\n          id: groceriesLabel\n          text: Groceries\n        - component: Text\n          id: groceriesAmount\n          text: $650\n        - component: Row\n          id: diningOutRow\n          justify: spaceBetween\n          children[2]: diningOutLabel,diningOutAmount\n        - component: Text\n          id: diningOutLabel\n          text: Dining Out\n        - component: Text\n          id: diningOutAmount\n          text: $400\n        - component: Row\n          id: utilitiesRow\n          justify: spaceBetween\n          children[2]: utilitiesLabel,utilitiesAmount\n        - component: Text\n          id: utilitiesLabel\n          text: Utilities\n        - component: Text\n          id: utilitiesAmount\n          text: $280\n        - component: Row\n          id: internetRow\n          justify: spaceBetween\n          children[2]: internetLabel,internetAmount\n        - component: Text\n          id: internetLabel\n          text: Internet\n        - component: Text\n          id: internetAmount\n          text: $80\n        - component: Row\n          id: streamingServicesRow\n          justify: spaceBetween\n          children[2]: streamingServicesLabel,streamingServicesAmount\n        - component: Text\n          id: streamingServicesLabel\n          text: Streaming Services\n        - component: Text\n          id: streamingServicesAmount\n          text: $120\n        - component: Row\n          id: gymRow\n          justify: spaceBetween\n          children[2]: gymLabel,gymAmount\n        - component: Text\n          id: gymLabel\n          text: Gym\n        - component: Text\n          id: gymAmount\n          text: $100\n        - component: Row\n          id: transportationRow\n          justify: spaceBetween\n          children[2]: transportationLabel,transportationAmount\n        - component: Text\n          id: transportationLabel\n          text: Transportation\n        - component: Text\n          id: transportationAmount\n          text: $350\n        - component: Row\n          id: miscRow\n          justify: spaceBetween\n          children[2]: miscLabel,miscAmount\n        - component: Text\n          id: miscLabel\n          text: Miscellaneous\n        - component: Text\n          id: miscAmount\n          text: $200\n        - component: Divider\n          id: totalDivider\n        - component: Row\n          id: totalRow\n          justify: spaceBetween\n          children[2]: totalLabel,totalAmount\n        - component: Text\n          id: totalLabel\n          text: Total Monthly Expenses\n        - component: Text\n          id: totalAmount\n          text: \"$4,280\"\n        - align: center\n          component: Row\n          id: savingsHeaderRow\n          children[2]: savingsIcon,savingsGoalTitle\n        - component: Image\n          id: savingsIcon\n          url: /piggy-bank-icon.png\n          variant: icon\n        - component: Text\n          id: savingsGoalTitle\n          text: \"Savings Goal:\"\n          variant: h2\n        - component: Text\n          id: savingsGoalText\n          text: \"Based on your budget, we've identified three areas where you can save at least $200 per month without significantly impacting essential needs.\"\n        - component: Text\n          id: areasToSaveTitle\n          text: \"Three Areas to Save:\"\n          variant: h2\n        - component: Column\n          id: savingsOptionsColumn\n          children[3]: diningOutCard,streamingCard,groceriesSaveCard\n        - child: diningOutContent\n          component: Card\n          id: diningOutCard\n        - component: Column\n          id: diningOutContent\n          children[4]: diningOutTitle,diningOutSummary,diningOutSavings,diningOutTip\n        - component: Text\n          id: diningOutTitle\n          text: \"Option 1: Dining Out\"\n          variant: h3\n        - component: Text\n          id: diningOutSummary\n          text: \"Summary: Reduce dining out expenses by focusing on home-cooked meals and packed lunches.\"\n        - component: Text\n          id: diningOutSavings\n          text: \"Potential Savings: $100 (reducing from $400 to $300)\"\n        - component: Text\n          id: diningOutTip\n          text: \"Actionable Tip: Plan to cook at home more often. Consider packing your lunch for work/school at least 2-3 times a week instead of buying it.\"\n        - child: streamingContent\n          component: Card\n          id: streamingCard\n        - component: Column\n          id: streamingContent\n          children[4]: streamingTitle,streamingSummary,streamingSavings,streamingTip\n        - component: Text\n          id: streamingTitle\n          text: \"Option 2: Streaming Services\"\n          variant: h3\n        - component: Text\n          id: streamingSummary\n          text: \"Summary: Evaluate and optimize your streaming subscriptions to cut unnecessary costs.\"\n        - component: Text\n          id: streamingSavings\n          text: \"Potential Savings: $50 (reducing from $120 to $70)\"\n        - component: Text\n          id: streamingTip\n          text: \"Actionable Tip: Review all active subscriptions. Cancel any services you rarely use, or consider rotating services month-to-month. Look into ad-supported tiers if available and suitable.\"\n        - child: groceriesSaveContent\n          component: Card\n          id: groceriesSaveCard\n        - component: Column\n          id: groceriesSaveContent\n          children[4]: groceriesSaveTitle,groceriesSaveSummary,groceriesSaveSavings,groceriesSaveTip\n        - component: Text\n          id: groceriesSaveTitle\n          text: \"Option 3: Groceries\"\n          variant: h3\n        - component: Text\n          id: groceriesSaveSummary\n          text: \"Summary: Implement smarter grocery shopping habits to reduce your weekly spend.\"\n        - component: Text\n          id: groceriesSaveSavings\n          text: \"Potential Savings: $50 (reducing from $650 to $600)\"\n        - component: Text\n          id: groceriesSaveTip\n          text: \"Actionable Tip: Create a weekly meal plan before you shop, make a detailed grocery list, and stick to it to avoid impulse purchases. Compare prices and buy generic brands for staples.\"\n        - component: Text\n          id: totalSavingsText\n          text: \"Total Potential Savings: $100 + $50 + $50 = $200\"\n        - component: Text\n          id: actionsTitle\n          text: \"Quick Actions:\"\n          variant: h2\n        - component: Row\n          id: actionsRow\n          justify: spaceAround\n          children[3]: planButton,mealButton,streamingButton\n        - child: planButtonText\n          component: Button\n          id: planButton\n          action:\n            functionCall:\n              call: openUrl\n              args:\n                url: \"https://www.example.com/budget-template\"\n        - component: Text\n          id: planButtonText\n          text: Create a Detailed Budget Plan\n        - child: mealButtonText\n          component: Button\n          id: mealButton\n          action:\n            functionCall:\n              call: openUrl\n              args:\n                url: \"https://www.example.com/meal-planning-tips\"\n        - component: Text\n          id: mealButtonText\n          text: Find Meal Planning Resources\n        - child: streamingButtonText\n          component: Button\n          id: streamingButton\n          action:\n            functionCall:\n              call: openUrl\n              args:\n                url: \"https://www.example.com/streaming-comparison\"\n        - component: Text\n          id: streamingButtonText\n          text: Compare Streaming Services","validation":{"json_parse_ok":true,"schema_valid_strict":true,"schema_valid_lenient":true,"toon_roundtrip_ok":true,"errors":[],"repair_attempts":0,"repair_needed":false},"metrics":{"content_coverage":0.9367088607594937,"dup_rate":0.27986348122866894,"lint_score":1.0,"output_tokens_toon":764,"output_tokens_json":735,"component_count":70.0,"unique_component_types":7.0,"max_tree_depth":5.0,"avg_tree_depth":1.5,"container_to_text_ratio":0.5238095238095238,"information_chunking_score":0.8769027134348114,"ui_modularity_score":0.22857142857142856,"ui_decomposition_score":0.5297456220520417,"actionable_elements":3.0,"action_coverage":1.0,"url_as_text_rate":0.0,"table_pattern_detected":0.0,"table_cell_coverage":0.0,"section_heading_coverage":0.8,"markdown_leakage_rate":0.0,"missing_ids":0.0,"missing_ids_rate":0.0,"dangling_components":0.0,"dangling_components_rate":0.0,"intent_require_table":1.0,"intent_require_actions":1.0,"intent_require_sections":1.0