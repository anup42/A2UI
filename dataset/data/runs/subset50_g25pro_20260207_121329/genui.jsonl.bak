{"ui_id":"u_000361_01","response_id":"r_000361_01","query_id":"q_000361","intent":"Localization","tags":["weather","comparison","travel"],"intent_bucket":"localization","genui_json":[{"version":"v0.9","createSurface":{"surfaceId":"weather-comparison-surface","catalogId":"https://genui.local/specification/v0_9/standard_catalog.json"}},{"version":"v0.9","updateDataModel":{"surfaceId":"weather-comparison-surface","path":"/","value":{"cities":[{"name":"London, UK","high":23,"low":14},{"name":"Madrid, Spain","high":33,"low":20}]}}},{"version":"v0.9","updateComponents":{"surfaceId":"weather-comparison-surface","components":[{"id":"root","component":"Column","children":["summary-row","summary-text","table-card","image-row","info-tabs","actions-row"]},{"id":"summary-row","component":"Row","align":"center","children":["weather-icon","summary-title"]},{"id":"weather-icon","component":"Image","variant":"icon","url":"/weather_icon.png"},{"id":"summary-title","component":"Text","variant":"h2","text":"July Temperature Comparison"},{"id":"summary-text","component":"Text","text":"Here's a comparison of the average high and low temperatures for London, UK and Madrid, Spain during the month of July, based on historical climate data. Madrid generally experiences significantly warmer temperatures than London in July."},{"id":"table-card","component":"Card","child":"table-column"},{"id":"table-column","component":"Column","children":["table-header-row","table-divider","cities-list"]},{"id":"table-header-row","component":"Row","children":["header-city","header-high","header-low"]},{"id":"header-city","component":"Text","text":"City","weight":2},{"id":"header-high","component":"Text","text":"Average High (C)","weight":1},{"id":"header-low","component":"Text","text":"Average Low (C)","weight":1},{"id":"table-divider","component":"Divider"},{"id":"cities-list","component":"Column","children":{"componentId":"city-row-template","path":"/cities"}},{"id":"city-row-template","component":"Row","c