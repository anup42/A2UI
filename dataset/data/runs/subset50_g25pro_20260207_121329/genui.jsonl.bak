ks_title,tasks_list,divider_2,health_title,health_card,divider_3,bottleneck_title,bottleneck_card,divider_4,actions_title,actions_row\n        - component: Text\n          id: main_title\n          text: \"Project Status Report: Website Redesign\"\n          variant: h1\n        - component: Text\n          id: report_date\n          text: \"Date: 2024-03-01\"\n          variant: caption\n        - component: Text\n          id: summary_text\n          text: \"The 'Website Redesign' project is currently facing significant challenges. While UI Mockups are complete, the critical Backend API development is only 60% complete, directly blocking QA Testing. Content Migration has not yet started.\"\n        - component: Divider\n          id: divider_1\n        - component: Text\n          id: tasks_title\n          text: Task Status Overview\n          variant: h2\n        - component: List\n          direction: vertical\n          id: tasks_list\n          children:\n            componentId: task_item_template\n            path: /tasks\n        - align: center\n          component: Row\n          id: task_item_template\n          children[4]: task_icon_template,task_name_template,task_status_template,task_progress_template\n        - component: Image\n          id: task_icon_template\n          variant: icon\n          url:\n            path: iconUrl\n        - component: Text\n          id: task_name_template\n          weight: 1\n          text:\n            path: name\n        - component: Text\n          id: task_status_template\n          weight: 1\n          text:\n            path: status\n        - component: Text\n          id: task_progress_template\n          weight: 1\n          text:\n            call: formatString\n            returnType: string\n            args:\n              value: \"Progress: ${progress}%\"\n        - component: Divider\n          id: divider_2\n        - component: Text\n          id: health_title\n          text: Project Health Status\n          variant: h2\n        - child: health_card_content\n          component: Card\n          id: health_card\n        - component: Column\n          id: health_card_content\n          children[2]: health_status_text,health_details_text\n        - component: Text\n          id: health_status_text\n          text: At Risk\n          variant: h3\n        - component: Text\n          id: health_details_text\n          text: The project is at risk due to key dependencies not being met and a major component still in progress. The inability to start QA Testing and Content Migration significantly impacts the project timeline.\n        - component: Divider\n          id: divider_3\n        - component: Text\n          id: bottleneck_title\n          text: Primary Bottleneck\n          variant: h2\n        - child: bottleneck_card_content\n          component: Card\n          id: bottleneck_card\n        - component: Column\n          id: bottleneck_card_content\n          children[2]: bottleneck_name_text,bottleneck_details_text\n        - component: Text\n          id: bottleneck_name_text\n          text: Backend API Development\n          variant: h3\n        - component: Text\n          id: bottleneck_details_text\n          text: \"The Backend API development is the primary bottleneck. Its incomplete status (60%) is directly blocking the QA Testing phase. Until the Backend API is finalized, further progress on testing and potentially other dependent tasks like Content Migration cannot proceed efficiently.\"\n        - component: Divider\n          id: divider_4\n        - component: Text\n          id: actions_title\n          text: Quick Actions\n          variant: h2\n        - component: Row\n          id: actions_row\n          justify: spaceAround\n          children[3]: action_btn_1,action_btn_2,action_btn_3\n        - child: action_btn_1_text\n          component: Button\n          id: action_btn_1\n          action:\n            functionCall:\n              call: openUrl\n              returnType: void\n              args:\n                url: \"https://example.com/project/websiteredesign/backend_status_update\"\n        - component: Text\n          id: action_btn_1_text\n          text: Update Backend API Status\n        - child: action_btn_2_text\n          component: Button\n          id: action_btn_2\n          action:\n            functionCall:\n              call: openUrl\n              returnType: void\n              args:\n                url: \"https://example.com/project/websiteredesign/backend_plan\"\n        - component: Text\n          id: action_btn_2_text\n          text: Review Backend API Development Plan\n        - child: action_btn_3_text\n          component: Button\n          id: action_btn_3\n          action:\n            functionCall:\n              call: openUrl\n              returnType: void\n              args:\n                url: \"https://example.com/project/websiteredesign/content_migration_planning\"\n        - component: Text\n          id: action_btn_3_text\n          text: Discuss Content Migration Readiness","validation":{"json_parse_ok":true,"schema_valid_strict":true,"schema_valid_lenient":true,"toon_roundtrip_ok":true,"errors":[],"repair_attempts":0,"repair_needed":false},"metrics":{"content_coverage":0.9693877551020408,"dup_rate":0.21839080459770116,"lint_score":1.0,"output_tokens_toon":458,"output_tokens_json":478,"component_count":33.0,"unique_component_types":8.0,"max_tree_depth":4.0,"avg_tree_depth":1.4545454545454546,"container_to_text_ratio":0.47058823529411764,"information_chunking_score":0.7451879010082494,"ui_modularity_score":0.15151515151515152,"ui_decomposition_score":0.4967202896490652,"actionable_elements":3.0,"action_coverage":1.0,"url_as_text_rate":0.0,"table_pattern_detected":0.0,"table_cell_coverage":0.0,"section_heading_coverage":0.6666666666666666,"markdown_leakage_rate":0.0,"missing_ids":0.0,"missing_ids_rate":0.0,"dangling_components":0.0,"dangling_co