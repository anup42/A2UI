: package_id_text\n          text:\n            call: formatString\n            returnType: string\n            args:\n              value: \"ID: ${id}\"\n        - component: Text\n          id: package_status_text\n          text:\n            call: formatString\n            returnType: string\n            args:\n              value: \"Status: ${status}\"\n        - component: Text\n          id: package_location_text\n          text:\n            call: formatString\n            returnType: string\n            args:\n              value: \"Location: ${location}\"\n        - component: Text\n          id: arrival_title\n          text: \"Estimated Arrival Order:\"\n          variant: h3\n        - component: Column\n          id: arrival_list\n          children[3]: arrival_item_1,arrival_item_2,arrival_item_3\n        - component: Column\n          id: arrival_item_1\n          children[2]: arrival_item_1_title,arrival_item_1_desc\n        - component: Text\n          id: arrival_item_1_title\n          text: \"1. Package ID: 94001 (Out for Delivery)\"\n        - component: Text\n          id: arrival_item_1_desc\n          text: This package is the closest to delivery and is likely to arrive today (May 20th) or the next business day.\n        - component: Column\n          id: arrival_item_2\n          children[2]: arrival_item_2_title,arrival_item_2_desc\n        - component: Text\n          id: arrival_item_2_title\n          text: \"2. Package ID: 94002 (In Transit)\"\n        - component: Text\n          id: arrival_item_2_desc\n          text: \"This package has arrived at a sorting facility and is actively moving. It will likely arrive after package 94001, typically within a few business days depending on its final destination.\"\n        - component: Column\n          id: arrival_item_3\n          children[2]: arrival_item_3_title,arrival_item_3_desc\n        - component: Text\n          id: arrival_item_3_title\n          text: \"3. Package ID: 94003 (Label Created, pending pickup)\"\n        - component: Text\n          id: arrival_item_3_desc\n          text: \"This package has only had its label created and has not yet been picked up by the carrier. It will be the last to arrive, as its journey has not yet begun.\"\n        - component: Text\n          id: assumptions_text\n          text: \"Assumptions: These estimates are based on typical shipping timelines for each status. Actual delivery times may vary due to carrier operations, unforeseen delays, or specific service levels.\"\n          variant: caption\n        - component: Row\n          id: actions_row\n          justify: spaceAround\n          children:\n            componentId: track_button_template\n            path: /packages\n        - child: track_button_text_template\n          component: Button\n          id: track_button_template\n          action:\n            functionCall:\n              call: openUrl\n              returnType: void\n              args:\n                url:\n                  path: url\n        - component: Text\n          id: track_button_text_template\n          text:\n            call: formatString\n            returnType: string\n            args:\n              value: \"Track Package ${id}\"","validation":{"json_parse_ok":true,"schema_valid_strict":true,"schema_valid_lenient":true,"toon_roundtrip_ok":true,"errors":[],"repair_attempts":0,"repair_needed":false},"metrics":{"content_coverage":0.9702970297029703,"dup_rate":0.22302158273381295,"lint_score":1.0,"output_tokens_toon":411,"output_tokens_json":417,"component_count":25.0,"unique_component_types":5.0,"max_tree_depth":4.0,"avg_tree_depth":1.48,"container_to_text_ratio":0.6,"information_chunking_score":0.8470209339774557,"ui_modularity_score":0.12,"ui_decomposition_score":0.4644041867954911,"actionable_elements":0.0,"action_coverage":0.0,"url_as_text_rate":0.0,"table_pattern_detected":0.0,"table_cell_coverage":0.0,"section_heading_coverage":0.6666666666666666,"markdown_