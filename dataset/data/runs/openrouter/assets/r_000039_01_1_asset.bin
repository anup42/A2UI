eUrl":"https://www.idealist.org/volunteersolutions"}},{"id":"83b78a22d524451f99bb8f0fff336fe3","type":"SPLIT_CONTENT","data":{"sections":[{"type":"TEXT","data":{"label":null,"headline":"<h2&gt;<u&gt;About Us</u&gt;</h2&gt;","html":"<p&gt;Over the past 30 years, Idealist and VolunteerMatch have supported millions of people in their quest to build a better world, be it through a job, volunteer opportunity, or by working with neighbors to solve a local problem.</p&gt;<p&gt;Since merging in early 2025, our combined organization is connecting more individuals with social-impact opportunities than ever before.</p&gt;","button":{"type":"URL","data":{"pageTitle":null,"url":"https://www.idealist.org/en/about"},"text":"Discover Idealist"},"buttonUrl":"https://www.idealist.org/en/about","buttonText":"Discover Idealist"}},{"type":"IMAGE","data":{"image":{"fileId":"2104572c535f433b815251fa95561f6c","filename":"Meet Idealist Illustration.webp","handle":"RCswVyvTpKVP9IOycCCg","mimetype":"image/webp","size":77972,"source":"local_file_system","width":1270,"height":942,"altText":"Illustration of a blue browser window with a person icon, upward trending arrow, coffee cup, green leaf, and yellow flower, representing digital growth and productivity.","caption":null},"url":null,"isMobileBackground":false,"hideOnMobile":false,"size":"FIXED_WIDTH"}}],"appearance":"SIDE_BY_SIDE"}},{"id":"c89743c138814ceba88afca71f58c7fb","type":"THREE_STEP_CTA","data":{"mainHeadline":"<p class=\"ql-align-center\"&gt;The world's largest <u&gt;volunteer recruitment network</u&gt;</p&gt;","mainText":"<p class=\"ql-align-center\"&gt;Idealist is the best place to reach like-hearted individuals to support your organization, community group, or event. Now that VolunteerMatch has joined us, our platform is connecting more volunteers with opportunities to take action than ever before.</p&gt;","overlap":false,"buttonText":null,"buttonUrl":null,"imageSize":"SMALL","stepOneImage":{"fileId":"31037fbb878245f1bf82573f44599ee0","filename":"Globe_Location_Blue.png","handle":"NVVIyWwzSAiShi6OqsXA","mimetype":"image/png","size":14022,"source":"local_file_system","width":384,"height":384,"altText":"blue globe","caption":null},"stepOneHeadline":"<p class=\"ql-align-center\"&gt;Join More Than 200,000 Organizations</p&gt;","stepOneText":"<p class=\"ql-align-center\"&gt;Sign up to join our network of nonprofits, social-impact corporations, and community groups using Idealist to find volunteers.</p&gt;","stepOneUrl":"https://www.idealist.org/en/orgs/post-free-volunteer-listings","stepTwoImage":{"fileId":"dd5e3b828e8b46d59eaea5e2c08ee817","filename":"5ffdc7c7-876e-4912-85b5-ace148a5ad3a.png","handle":"KR4sExjKSES2p2vnk6H7","mimetype":"image/png","size":20235,"source":"local_file_system","width":384,"height":384,"altText":"green hammer and pencil","caption":null},"stepTwoHeadline":"<p class=\"ql-align-center\"&gt;Explore Resources for Leaders of Volunteers</p&gt;","stepTwoText":"<p class=\"ql-align-center\"&gt;Check out our library of resources, guides, and webinars for finding and engaging dedicated volunteers to support your cause.</p&gt;","stepTwoUrl":"https://www.idealist.org/en/orgs/volunteer-engagement-resources","stepThreeImage":{"fileId":"102b7f5b684e4b60b7ca711bc0a78e24","filename":"90d18129-014f-4211-b247-7a6e12177ecc.png","handle":"dtpbKnQPSwaMAa8SP67t","mimetype":"image/png","size":10480,"source":"local_file_system","width":384,"height":384,"altText":"yellow puzzle piece","caption":null},"stepThreeHeadline":"<p class=\"ql-align-center\"&gt;Check Out Frequently Asked Questions</p&gt;","stepThreeText":"<p class=\"ql-align-center\"&gt;Take advantage of everything that Idealist has to offer and discover how our merger with VolunteerMatch affects you.</p&gt;","stepThreeUrl":"https://www.idealist.org/en/about/merger-faq"}},{"id":"3997230303ae441883f40810040dd7ec","type":"SCROLL_TRACKING","data":{"eventName":"Mid page"}},{"id":"51d49693f5a04ea0917542e08f2fac9d","type":"SPLIT_CONTENT","data":{"sections":[{"type":"TEXT","data":{"label":"RECIPES FOR ACTION","headline":"<p&gt;Inspiration for building a better world</p&gt;","html":"<p&gt;Recipes for Action is a collection of ideas to inspire positive change, one action at a time.</p&gt;<p&gt;We invite people from around the world to share the varied and creative ways they’re making a positive impact in their communities to inspire others.</p&gt;","button":{"type":"URL","data":{"pageTitle":null,"url":"https://www.idealist.org/en/recipes-for-action?pq="},"text":"Take a Recipe"},"buttonUrl":"https://www.idealist.org/en/recipes-for-action?pq=","buttonText":"Take a Recipe"}},{"type":"IMAGE","data":{"image":{"fileId":"329c2d43a26942b889b938216388a4fb","filename":"Recipe+for_action.webp","handle":"RBse9bHCSD61xGr9dclk","mimetype":"image/webp","size":73898,"source":"local_file_system","width":1115,"height":769,"altText":"Illustration of a yellow cat sitting on a purple document with lines of text, surrounded by colorful icons including a red heart, green checkmark, blue thumbs up, water droplet, thread spool, paint palette, and food bowl, representing creativity and productivity elements.","caption":null},"url":null,"isMobileBackground":false,"hideOnMobile":false,"size":"CROPPED"}}],"appearance":"SIDE_BY_SIDE"}},{"id":"3fe1255824b04d91be6f295127859129","type":"FOUR_ARTICLES_HIGHLIGHT","data":{"headline":"<h2&gt;Make your corner of the world <strong&gt;a little better</strong&gt;</h2&gt;<p&gt;Discover tips, resources, and inspiration for finding a volunteer opportunity that's right for you.</p&gt;","pageOne":{"id":"6d6972b8d5884e81add4f7e97de2882e","title":"How Tasha From Canada Builds Community With Others","url":"en/volunteer-resources/how-tasha-from-canada-builds-community-with-others","image":{"fileId":"bec038ccb00a4556b289fb91637d3a8b","filename":"Tasha Van Vlack.png","handle":"rmnoQKkNRyu3hKVEfUDl","mimetype":"image/png","size":8846120,"source":"local_file_system","width":4032,"height":3024,"altText":"Tasha Van Vlack and the Nonprofit Hive logo","caption":null}},"pageTwo":{"id":"85955aa8645148198f9ed6061b1d8450","title":"Volunteer Opportunities for High School Students","url":"en/volunteer-resources/volunteer-opportunities-for-high-school-students","image":{"fileId":"f3cbf78ae52b4a419adee9aae5546176","filename":"gen-z-children-of-different-ages-have-fun-at-a-ho-2026-01-06-09-21-41-utc.jpg","handle":"tYJ26pQivIS2CqTGutQK","mimetype":"image/jpeg","size":2257805,"source":"local_file_system","width":4188,"height":2793,"altText":"High school students volunteer to lead an extracurricular activity at a local elementary school.","caption":null}},"pageThree":{"id":"7517d20463c74b568ad3fa275dada2bb","title":"Done-in-a-Day Volunteer Opportunities for Busy People","url":"en/volunteer-resources/done-in-a-day-volunteer-opportunities","image":{"fileId":"0b633b2c7455473890a44e7b63bf2f7d","filename":"community-service-volunteering-and-people-plant-t-2023-11-27-05-12-15-utc.jpg","handle":"BzCdIIRUqy6y2kqcEadw","mimetype":"image/jpeg","size":8293180,"source":"local_file_system","width":7161,"height":4774,"altText":"volunteers participate in a tree planting activity","caption":null}},"pageFour":{"id":"2363b08cae86462693c865af41d54f92","title":"Want to Engage in Community Service in 2026? 10 Volunteer Opportunities to Try This Week","url":"en/volunteer-resources/10-volunteer-opportunities","image":{"fileId":"60e3bc62f6aa49c887688d8ccc5a226a","filename":"giving tuesday image.JPG","handle":"EcjMpaPSPu5uSTmdnR9X","mimetype":"image/jpeg","size":25382549,"source":"local_file_system","width":9600,"height":6400,"altText":"Two volunteers high-five after cleaning up the local park through a volunteer opportunity.","caption":null}},"buttonText":"Read More","buttonUrl":"https://www.idealist.org/en/volunteering-resources?pq="}},{"id":"db78713fcd264335a9023ee9e2317e33","type":"SPLIT_CONTENT","data":{"sections":[{"type":"TEXT","data":{"label":"Free Community Action Program","headline":"<h2&gt;What’s your <strong&gt;big idea?</strong&gt;</h2&gt;","html":"<p&gt;If you’ve been dreaming up ways to make an impact in your community but aren't quite sure where to begin (or how to proceed), Idealist can help.</p&gt;<p&gt;The <em&gt;Action Incubator Sessions</em&gt; are designed to help you move forward with your big idea for community action. Apply now to access free coaching, resources, and 1:1 support from our organizing experts.</p&gt;","button":{"type":"URL","data":{"pageTitle":null,"url":"https://www.idealist.org/en/action-incubator/sessions"},"text":"Sign Up"},"buttonUrl":"https://www.idealist.org/en/action-incubator/sessions","buttonText":"Sign Up"}},{"type":"IMAGE","data":{"image":{"fileId":"b29262f7bde74c11af34ae20d6d02d2e","filename":"action.webp","handle":"0t1Qj1pgSEe1d5jRTDOX","mimetype":"image/webp","size":58108,"source":"local_file_system","width":982,"height":758,"altText":"Illustration of collaboration tools including a hammer, scissors, pencil, lightbulb icon, and four blue circular user profile icons arranged on a light blue cloud background.","caption":null},"url":null,"isMobileBackground":false,"hideOnMobile":false,"size":"FIXED_WIDTH"}}],"appearance":"SIDE_BY_SIDE"}},{"id":"5a6548a740e84f2d9c7eb0d148599486","type":"RECOMMENDED_ACTIONS","data":{"headline":"<p&gt;Find your next <u&gt;volunteer opportunity</u&gt; on Idealist</p&gt;","volopFunction":null,"areaOfFocus":null,"locale":"all"}},{"id":"5b0baadabfeb48b99ecbc64ee755f410","type":"RICHTEXT","data":{"html":"<p class=\"ql-align-center\"&gt;<em&gt;As part of the merger, we’ve updated some of our policies. By using Idealist, you agree to these updated <a href=\"https://www.idealist.org/en/terms-of-service\"&gt;Terms of Service</a&gt; and acknowledge our <a href=\"https://www.idealist.org/en/privacy-policy\"&gt;Privacy Policy</a&gt;.</em&gt;</p&gt;"}}],"subsite":{"id":"c1e2ba58de384e238a7473a032352392","publicName":"Volunteer Resources","searchPlaceholderText":"","categoryLabel":null,"searchBlurb":"","updated":"2025-06-12T15:04:01.853946Z","urlRoot":"volunteer-resources","hasFeaturedPostInSearchResults":true,"defaultSearchType":"VOLOP","homePage":{"id":"9ce69647ff034e88b4d88b4f4ba5f917","updated":"2025-03-07T22:25:47.675065Z","locale":"en","type":"PAGE","title":"Volunteering","url":"en/volunteering-resources"},"subscribeText":"","canSubscribe":false,"placeholderImages":[],"searchLinks":[],"includedSubsites":[],"icon":{"fileId":"5ca69e2348ab4cc79af4c0cfe8a0161f","filename":"Volunteer.svg","handle":"f6FYwJrQyyBybDzCYapw","mimetype":"image/svg+xml","size":2420,"source":"local_file_system","width":30,"height":30}},"heroSearch":null,"headerImage":null,"thumbnail":null,"headTitle":"VolunteerMatch is now part of Idealist! For Volunteering, Nonprofit Opportunities, and More","metaDescription":null,"layout":"FULL_WIDTH","translations":[],"isPublished":true,"onlySearchResults":false,"hasSocialSharing":false,"listingSearchType":"JOB","hasRecommendedJobs":false,"hasReactions":false,"enableComments":false,"enableProfileOnVisit":false,"postedDate":"2020-05-12T00:00:00","articleMeta":null,"xDefaultTranslationUrl":"https://www.idealist.org/volunteermatch","schemaMarkup":null,"showDate":false,"author":null,"tags":[],"categories":[],"tableOfContents":[],"visibleToRobots":true},"type":"CMS_PAGE"}}}--></script>
