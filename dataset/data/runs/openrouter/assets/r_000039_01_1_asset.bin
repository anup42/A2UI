/en/volunteer-in-new-york-city" data-discover="true">Volunteer in New York City</a><a class="sc-bbljk3-3 hfuzIw" href="/en/volunteer-in-phoenix-az" data-discover="true">Volunteer in Phoenix</a><a class="sc-bbljk3-3 hfuzIw" href="/en/volunteer-in-washington-dc" data-discover="true">Volunteer in Washington DC</a><a class="sc-bbljk3-3 hfuzIw" href="/en/volunteer-in-san-diego-ca" data-discover="true">Volunteer in San Diego</a></div></div></footer></div><script>window.__staticRouterHydrationData = JSON.parse("{\"loaderData\":{\"cms-route\":{\"type\":\"PAGE\",\"content\":{\"id\":\"b2a8283ba93943ac9e13ba883fabbbcb\",\"updated\":\"2025-12-15T18:56:57.517241Z\",\"type\":\"PAGE\",\"title\":\"Volunteer Match Home\",\"showTitle\":false,\"locale\":\"en\",\"url\":\"volunteermatch\",\"contentBlocks\":[{\"id\":\"45c98a338ac748c1947048de7b0f7d8b\",\"type\":\"SIGN_UP\",\"data\":{\"blockId\":\"45c98a338ac748c1947048de7b0f7d8b\",\"headline\":\"\u003cp\u003eVolunteerMatch is now part of Idealist! \u003cu\u003eSign up\u003c/u\u003e or \u003cu\u003elog in\u003c/u\u003e to join our community.\u003c/p\u003e\",\"bgImage\":{\"fileId\":\"9ef41d1d0d0646e0bd941e7ca53c8439\",\"filename\":\"Screenshot 2025-04-02 at 4.41.34 PM.png\",\"handle\":\"UDfLiB3CRaC6CVegEwxS\",\"mimetype\":\"image/png\",\"size\":3514673,\"source\":\"local_file_system\",\"width\":1838,\"height\":792},\"redirectUrl\":\"https://www.idealist.org/volunteermatch\",\"loggedInHeadline\":null,\"loggedInRedirectButtonText\":null,\"hasSubscribe\":false}},{\"id\":\"d94ca72d1d944697b552c6a634c0fdbe\",\"type\":\"THREE_STEP_CTA\",\"data\":{\"mainHeadline\":null,\"mainText\":null,\"overlap\":true,\"buttonText\":null,\"buttonUrl\":null,\"imageSize\":\"SMALL\",\"stepOneImage\":{\"fileId\":\"e2840111507c489d8e0f75189d0ad49d\",\"filename\":\"Check_Green.png\",\"handle\":\"B0QPakuQYmvXlBe7CNLV\",\"mimetype\":\"image/png\",\"size\":13031,\"source\":\"local_file_system\",\"width\":384,\"height\":384,\"altText\":\"green magnifying glass\",\"caption\":null},\"stepOneHeadline\":\"\u003cp class=\\\"ql-align-center\\\"\u003eFind Volunteer Opportunities\u003c/p\u003e\",\"stepOneText\":\"\u003cp class=\\\"ql-align-center\\\"\u003eDiscover 100,000+ unique ways to volunteer, with opportunities for virtual and onsite opportunities to support 56 different cause areas.\u003c/p\u003e\",\"stepOneUrl\":\"https://www.idealist.org/en/volunteer\",\"stepTwoImage\":{\"fileId\":\"0c5b6c63108b4de881890ea2f54b1197\",\"filename\":\"cbb569aa-3fb3-445d-92ae-9c9882313874.png\",\"handle\":\"6wUhZMDsS5CcvOeEJBTm\",\"mimetype\":\"image/png\",\"size\":9582,\"source\":\"local_file_system\",\"width\":384,\"height\":384,\"altText\":\"blue listing icon\",\"caption\":null},\"stepTwoHeadline\":\"\u003cp class=\\\"ql-align-center\\\"\u003eAdd Your Organization\u003c/p\u003e\",\"stepTwoText\":\"\u003cp class=\\\"ql-align-center\\\"\u003eShare your unique volunteer opportunity with more than 2 million people around the world looking for ways to do good.\u003c/p\u003e\",\"stepTwoUrl\":\"https://www.idealist.org/en/orgs/post-free-volunteer-listings\",\"stepThreeImage\":{\"fileId\":\"5323453ab62f4cea88f1f3e57429847f\",\"filename\":\"bdd771a9-f604-4ddf-9403-aa572145bb47.png\",\"handle\":\"miem116OTfqswQ694dUH\",\"mimetype\":\"image/png\",\"size\":11450,\"source\":\"local_file_system\",\"width\":384,\"height\":384,\"altText\":\"yellow mouse click\",\"caption\":null},\"stepThreeHeadline\":\"\u003cp class=\\\"ql-align-center\\\"\u003eExplore Business Solutions\u003c/p\u003e\",\"stepThreeText\":\"\u003cp class=\\\"ql-align-center\\\"\u003eShare thousands of virtual and on-site volunteer opportunities with your company’s employees or platform’s audience.\u003c/p\u003e\",\"stepThreeUrl\":\"https://www.idealist.org/volunteersolutions\"}},{\"id\":\"83b78a22d524451f99bb8f0fff336fe3\",\"type\":\"SPLIT_CONTENT\",\"data\":{\"sections\":[{\"type\":\"TEXT\",\"data\":{\"label\":null,\"headline\":\"\u003ch2\u003e\u003cu\u003eAbout Us\u003c/u\u003e\u003c/h2\u003e\",\"html\":\"\u003cp\u003eOver the past 30 years, Idealist and VolunteerMatch have supported millions of people in their quest to build a better world, be it through a job, volunteer opportunity, or by working with neighbors to solve a local problem.\u003c/p\u003e\u003cp\u003eSince merging in early 2025, our combined organization is connecting more individuals with social-impact opportunities than ever before.\u003c/p\u003e\",\"button\":{\"type\":\"URL\",\"data\":{\"pageTitle\":null,\"url\":\"https://www.idealist.org/en/about\"},\"text\":\"Discover Idealist\"},\"buttonUrl\":\"https://www.idealist.org/en/about\",\"buttonText\":\"Discover Idealist\"}},{\"type\":\"IMAGE\",\"data\":{\"image\":{\"fileId\":\"2104572c535f433b815251fa95561f6c\",\"filename\":\"Meet Idealist Illustration.webp\",\"handle\":\"RCswVyvTpKVP9IOycCCg\",\"mimetype\":\"image/webp\",\"size\":77972,\"source\":\"local_file_system\",\"width\":1270,\"height\":942,\"altText\":\"Illustration of a blue browser window with a person icon, upward trending arrow, coffee cup, green leaf, and yellow flower, representing digital growth and productivity.\",\"caption\":null},\"url\":null,\"isMobileBackground\":false,\"hideOnMobile\":false,\"size\":\"FIXED_WIDTH\"}}],\"appearance\":\"SIDE_BY_SIDE\"}},{\"id\":\"c89743c138814ceba88afca71f58c7fb\",\"type\":\"THREE_STEP_CTA\",\"data\":{\"mainHeadline\":\"\u003cp class=\\\"ql-align-center\\\"\u003eThe world's largest \u003cu\u003evolunteer recruitment network\u003c/u\u003e\u003c/p\u003e\",\"mainText\":\"\u003cp class=\\\"ql-align-center\\\"\u003eIdealist is the best place to reach like-hearted individuals to support your organization, community group, or event. Now that VolunteerMatch has joined us, our platform is connecting more volunteers with opportunities to take action than ever before.\u003c/p\u003e\",\"overlap\":false,\"buttonText\":null,\"buttonUrl\":null,\"imageSize\":\"SMALL\",\"stepOneImage\":{\"fileId\":\"31037fbb878245f1bf82573f44599ee0\",\"filename\":\"Globe_Location_Blue.png\",\"handle\":\"NVVIyWwzSAiShi6OqsXA\",\"mimetype\":\"image/png\",\"size\":14022,\"source\":\"local_file_system\",\"width\":384,\"height\":384,\"altText\":\"blue globe\",\"caption\":null},\"stepOneHeadline\":\"\u003cp class=\\\"ql-align-center\\\"\u003eJoin More Than 200,000 Organizations\u003c/p\u003e\",\"stepOneText\":\"\u003cp class=\\\"ql-align-center\\\"\u003eSign up to join our network of nonprofits, social-impact corporations, and community groups using Idealist to find volunteers.\u003c/p\u003e\",\"stepOneUrl\":\"https://www.idealist.org/en/orgs/post-free-volunteer-listings\",\"stepTwoImage\":{\"fileId\":\"dd5e3b828e8b46d59eaea5e2c08ee817\",\"filename\":\"5ffdc7c7-876e-4912-85b5-ace148a5ad3a.png\",\"handle\":\"KR4sExjKSES2p2vnk6H7\",\"mimetype\":\"image/png\",\"size\":20235,\"source\":\"local_file_system\",\"width\":384,\"height\":384,\"altText\":\"green hammer and pencil\",\"caption\":null},\"stepTwoHeadline\":\"\u003cp class=\\\"ql-align-center\\\"\u003eExplore Resources for Leaders of Volunteers\u003c/p\u003e\",\"stepTwoText\":\"\u003cp class=\\\"ql-align-center\\\"\u003eCheck out our library of resources, guides, and webinars for finding and engaging dedicated volunteers to support your cause.\u003c/p\u003e\",\"stepTwoUrl\":\"https://www.idealist.org/en/orgs/volunteer-engagement-resources\",\"stepThreeImage\":{\"fileId\":\"102b7f5b684e4b60b7ca711bc0a78e24\",\"filename\":\"90d18129-014f-4211-b247-7a6e12177ecc.png\",\"handle\":\"dtpbKnQPSwaMAa8SP67t\",\"mimetype\":\"image/png\",\"size\":10480,\"source\":\"local_file_system\",\"width\":384,\"height\":384,\"altText\":\"yellow puzzle piece\",\"caption\":null},\"stepThreeHeadline\":\"\u003cp class=\\\"ql-align-center\\\"\u003eCheck Out Frequently Asked Questions\u003c/p\u003e\",\"stepThreeText\":\"\u003cp class=\\\"ql-align-center\\\"\u003eTake advantage of everything that Idealist has to offer and discover how our merger with VolunteerMatch affects you.\u003c/p\u003e\",\"stepThreeUrl\":\"https://www.idealist.org/en/about/merger-faq\"}},{\"id\":\"3997230303ae441883f40810040dd7ec\",\"type\":\"SCROLL_TRACKING\",\"data\":{\"eventName\":\"Mid page\"}},{\"id\":\"51d49693f5a04ea0917542e08f2fac9d\",\"type\":\"SPLIT_CONTENT\",\"data\":{\"sections\":[{\"type\":\"TEXT\",\"data\":{\"label\":\"RECIPES FOR ACTION\",\"headline\":\"\u003cp\u003eInspiration for building a better world\u003c/p\u003e\",\"html\":\"\u003cp\u003eRecipes for Action is a collection of ideas to inspire positive change, one action at a time.\u003c/p\u003e\u003cp\u003eWe invite people from around the world to share the varied and creative ways they’re making a positive impact in their communities to inspire others.\u003c/p\u003e\",\"button\":{\"type\":\"URL\",\"data\":{\"pageTitle\":null,\"url\":\"https://www.idealist.org/en/recipes-for-action?pq=\"},\"text\":\"Take a Recipe\"},\"buttonUrl\":\"https://www.idealist.org/en/recipes-for-action?pq=\",\"buttonText\":\"Take a Recipe\"}},{\"type\":\"IMAGE\",\"data\":{\"image\":{\"fileId\":\"329c2d43a26942b889b938216388a4fb\",\"filename\":\"Recipe+for_action.webp\",\"handle\":\"RBse9bHCSD61xGr9dclk\",\"mimetype\":\"image/webp\",\"size\":73898,\"source\":\"local_file_system\",\"width\":1115,\"height\":769,\"altText\":\"Illustration of a yellow cat sitting on a purple document with lines of text, surrounded by colorful icons including a red heart, green checkmark, blue thumbs up, water droplet, thread spool, paint palette, and food bowl, representing creativity and productivity elements.\",\"caption\":null},\"url\":null,\"isMobileBackground\":false,\"hideOnMobile\":false,\"size\":\"CROPPED\"}}],\"appearance\":\"SIDE_BY_SIDE\"}},{\"id\":\"3fe1255824b04d91be6f295127859129\",\"type\":\"FOUR_ARTICLES_HIGHLIGHT\",\"data\":{\"headline\":\"\u003ch2\u003eMake your corner of the world \u003cstrong\u003ea little better\u003c/strong\u003e\u003c/h2\u003e\u003cp\u003eDiscover tips, resources, and inspiration for finding a volunteer opportunity that's right for you.\u003c/p\u003e\",\"pageOne\":{\"id\":\"6d6972b8d5884e81add4f7e97de2882e\",\"title\":\"How Tasha From Canada Builds Community With Others\",\"url\":\"en/volunteer-resources/how-tasha-from-canada-builds-community-with-others\",\"image\":{\"fileId\":\"bec038ccb00a4556b289fb91637d3a8b\",\"filename\":\"Tasha Van Vlack.png\",\"handle\":\"rmnoQKkNRyu3hKVEfUDl\",\"mimetype\":\"image/png\",\"size\":8846120,\"source\":\"local_file_system\",\"width\":4032,\"height\":3024,\"altText\":\"Tasha Van Vlack and the Nonprofit Hive logo\",\"caption\":null}},\"pageTwo\":{\"id\":\"85955aa8645148198f9ed6061b1d8450\",\"title\":\"Volunteer Opportunities for High School Students\",\"url\":\"en/volunteer-resources/volunteer-opportunities-for-high-school-students\",\"image\":{\"fileId\":\"f3cbf78ae52b4a419adee9aae5546176\",\"filename\":\"gen-z-children-of-different-ages-have-fun-at-a-ho-2026-01-06-09-21-41-utc.jpg\",\"handle\":\"tYJ26pQivIS2CqTGutQK\",\"mimetype\":\"image/jpeg\",\"size\":2257805,\"source\":\"local_file_system\",\"width\":4188,\"height\":2793,\"altText\":\"High school students volunteer to lead an extracurricular activity at a local elementary school.\",\"caption\":null}},\"pageThree\":{\"id\":\"7517d20463c74b568ad3fa275dada2bb\",\"title\":\"Done-in-a-Day Volunteer Opportunities for Busy People\",\"url\":\"en/volunteer-resources/done-in-a-day-volunteer-opportunities\",\"image\":{\"fileId\":\"0b633b2c7455473890a44e7b63bf2f7d\",\"filename\":\"community-service-volunteering-and-people-plant-t-2023-11-27-05-12-15-utc.jpg\",\"handle\":\"BzCdIIRUqy6y2kqcEadw\",\"mimetype\":\"image/jpeg\",\"size\":8293180,\"source\":\"local_file_system\",\"width\":7161,\"height\":4774,\"altText\":\"volunteers participate in a tree planting activity\",\"caption\":null}},\"pageFour\":{\"id\":\"2363b08cae86462693c865af41d54f92\",\"title\":\"Want to Engage in Community Service in 2026? 10 Volunteer Opportunities to Try This Week\",\"url\":\"en/volunteer-resources/10-volunteer-opportunities\",\"image\":{\"fileId\":\"60e3bc62f6aa49c887688d8ccc5a226a\",\"filename\":\"giving tuesday image.JPG\",\"handle\":\"EcjMpaPSPu5uSTmdnR9X\",\"mimetype\":\"image/jpeg\",\"size\":25382549,\"source\":\"local_file_system\",\"width\":9600,\"height\":6400,\"altText\":\"Two volunteers high-five after cleaning up the local park through a volunteer opportunity.\",\"caption\":null}},\"buttonText\":\"Read More\",\"buttonUrl\":\"https://www.idealist.org/en/volunteering-resources?pq=\"}},{\"id\":\"db78713fcd264335a9023ee9e2317e33\",\"type\":\"SPLIT_CONTENT\",\"data\":{\"sections\":[{\"type\":\"TEXT\",\"data\":{\"label\":\"Free Community Action Program\",\"headline\":\"\u003ch2\u003eWhat’s your \u003cstrong\u003ebig idea?\u003c/strong\u003e\u003c/h2\u003e\",\"html\":\"\u003cp\u003eIf you’ve been dreaming up ways to make an impact in your community but aren't quite sure where to begin (or how to proceed), Idealist can help.\u003c/p\u003e\u003cp\u003eThe \u003cem\u003eAction Incubator Sessions\u003c/em\u003e are designed to help you move forward with your big idea for community action. Apply now to access free coaching, resources, and 1:1 support from our organizing experts.\u003c/p\u003e\",\"button\":{\"type\":\"URL\",\"data\":{\"pageTitle\":null,\"url\":\"https://www.idealist.org/en/action-incubator/sessions\"},\"text\":\"Sign Up\"},\"buttonUrl\":\"https://www.idealist.org/en/action-incubator/sessions\",\"buttonText\":\"Sign Up\"}},{\"type\":\"IMAGE\",\"data\":{\"image\":{\"fileId\":\"b29262f7bde74c11af34ae20d6d02d2e\",\"filename\":\"action.webp\",\"handle\":\"0t1Qj1pgSEe1d5jRTDOX\",\"mimetype\":\"image/webp\",\"size\":58108,\"source\":\"local_file_system\",\"width\":982,\"height\":758,\"altText\":\"Illustration of collaboration tools including a hammer, scissors, pencil, lightbulb icon, and four blue circular user profile icons arranged on a light blue cloud background.\",\"caption\":null},\"url\":null,\"isMobileBackground\":false,\"hideOnMobile\":false,\"size\":\"FIXED_WIDTH\"}}],\"appearance\":\"SID