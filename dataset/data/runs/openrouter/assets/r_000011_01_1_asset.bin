ments.\u003c/p\u003e\r\n"},"audioTts":null,"createdAt":"2026-01-30T15:20:12-0500","updatedAt":"2026-01-30T15:23:41-0500","image":{"detail":{"default":{"srcset":"https://image-api.prod.kitco.com/image/365a14c4-787d-4a91-821c-3a43a8a5f134.png?top=80\u0026left=0\u0026width=1536\u0026height=864\u0026scale_width=1920\u0026token=1a08236707042c81723878511ad09e98ad63cc8ac31f271e395734cb5d0bc971"},"sources":{"teaser_small":{"srcset":"https://image-api.prod.kitco.com/image/365a14c4-787d-4a91-821c-3a43a8a5f134.png?top=80\u0026left=0\u0026width=1536\u0026height=864\u0026scale_width=200\u0026token=a846a4fdfce352c8e2a8e219df52a102472ba697657bbc93d53fc358aa2225ca","media":"all and (min-width: 0px)"},"teaser_medium":{"srcset":"https://image-api.prod.kitco.com/image/365a14c4-787d-4a91-821c-3a43a8a5f134.png?top=80\u0026left=0\u0026width=1536\u0026height=864\u0026scale_width=400\u0026token=d107da50df028cdb1f860b2d3eb078e66bcd30b8fbe2d7c24b310e8f6bced415","media":"all and (min-width: 0px)"},"desktop":{"media":"all and (min-width: 1024px)","srcset":"https://image-api.prod.kitco.com/image/365a14c4-787d-4a91-821c-3a43a8a5f134.png?top=80\u0026left=0\u0026width=1536\u0026height=864\u0026scale_width=1920\u0026token=1a08236707042c81723878511ad09e98ad63cc8ac31f271e395734cb5d0bc971"},"mobile":{"media":"all and (min-width: 0px)","srcset":"https://image-api.prod.kitco.com/image/365a14c4-787d-4a91-821c-3a43a8a5f134.png?top=0\u0026left=256\u0026width=1024\u0026height=1024\u0026scale_width=768\u0026token=536bb0a305627bac8f96f586bda02ea92da0f2a09825a18a101caa2579ae661d"},"tablet":{"media":"all and (min-width: 768px)","srcset":"https://image-api.prod.kitco.com/image/365a14c4-787d-4a91-821c-3a43a8a5f134.png?top=80\u0026left=0\u0026width=1536\u0026height=864\u0026scale_width=1024\u0026token=9f6b17ceea2b9eb7468a00c5b02d4ecd86615e0a7e6cb52c674823dcb3917c7f"}}}},"teaserImage":{"detail":{"default":{"srcset":null},"sources":{"teaser_small":{"srcset":null,"media":null},"teaser_medium":{"srcset":null,"media":n