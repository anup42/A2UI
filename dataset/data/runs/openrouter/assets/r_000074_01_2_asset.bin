e\": {\n              \"eq\": false\n            },\n            \"isBranded\": {\n              \"eq\": false\n            },\n            \"or\": {\n              \"sku.inStock\": {\n                \"eq\": false\n              },\n              \"and\": {\n                \"sku.fastFrame\": {\n                  \"eq\": true\n                },\n                \"sku.inStockOhio\": {\n                  \"eq\": false\n                }\n              }\n            }\n          }\n        }\n      ]\n    }\n  },\n{\n    \"label\": \"Prescription only\",\n    \"className\": \"ready-readers\",\n    \"includePath\": [\"/b/performance-sunglasses\", \"/b/sports-glasses/running\", \"/b/sports-glasses/zunnies\", \"/b/sports-glasses/zunnies/running\", \"/b/sports-glasses/zunnies/cycling\", \"/search\", \"/b/visual-search\", \"/b/visual-search-iframe\",\"/b/sports-glasses/zunnies/active-style\"],\n    \"qualifier\": {\n        \"and\": {\n            \"prodGroups\": {\n                \"has\": \"Sports Performance\"\n            },\n            \"prescription\": {\n                \"has\": \"Single Vision\"\n            }\n        }\n    }\n},\n  {\n    \"label\": \"Contacts\",\n    \"className\": \"contacts\",\n    \"useDynamicValue\": true,\n    \"valueAttribute\": \"prodLensType\",\n    \"includePath\": [\"/b/contact-lenses\", \"/search\", \"/contacts\"],\n    \"qualifier\": {\n      \"prodType\": {\n        \"eq\": \"contacts\"\n      }\n    }\n  },\n  {\n    \"label\": \"Daily Deals\",\n    \"className\": \"daily-deals\",\n    \"qualifier\": {\n      \"sku.isDailyDeal\": {\n        \"eq\": true\n      }\n    }\n  },\n  {\n    \"label\": \"Sale\",\n    \"className\": \"sale\",\n    \"excludePath\": [\"/b/glasses-on-sale\", \"/b/flash-sale\"],\n    \"qualifier\": {\n      \"and\": {\n        \"isBranded\": {\n          \"eq\": false\n        },\n        \"sku.sale\": {\n          \"eq\": true\n        }\n      }\n    }\n  },\n  {\n    \"label\": \"Flash sale\",\n    \"className\": \"flash-sale\",\n    \"--icon\": \"flash\",\n    \"excludePath\": [\"/b/flash-sale\", \"/b/glasses-on-sale\"],\n    \"qualifier\": {\n      \"sku.isFlashSale\": {\n        \"eq\": true\n      }\n    }\n  },\n  {\n    \"label\": \"Non-Prescription\",\n    \"className\": \"non-rx\",\n    \"--icon\": \"fire\",\n    \"--iconClass\": \"color-white\",\n    \"excludePath\": [\"/b/non-prescription-glasses\"],\n    \"qualifier\": {\n      \"frameType\": {\n        \"in\": [\"NonRX Sunglasses\", \"NonRX Goggles\"]\n      }\n    }\n  },\n  {\n    \"label\": \"Kids\",\n    \"className\": \"kids\",\n    \"excludePath\": [\n      \"/b/all-kids-glasses\",\n      \"/b/little-kids-glasses\",\n      \"/b/pre-teen-glasses\",\n      \"/b/teen-glasses\",\n      \"/b/toddler-glasses\",\n      \"/b/kids-prescription-sunglasses\",\n      \"/b/kids-flexible-glasses-frames\"\n    ],\n    \"qualifier\": {\n      \"gender\": {\n        \"has\": \"Kids\"\n      }\n    }\n  },\n  {\n    \"label\": \"Blue light\",\n    \"className\": \"ready-readers\",\n    \"qualifier\": {\n      \"prodGroups\": {\n        \"has\": \"OTC Blue Light Lens\"\n      }\n    }\n  },\n  {\n    \"label\": \"Sunglasses\",\n    \"className\": \"ready-readers\",\n    \"qualifier\": {\n      \"prodGroups\": {\n        \"has\": \"OTC Sunglass\"\n      }\n    }\n  },\n  {\n    \"label\": \"Ready Readers\",\n    \"className\": \"ready-readers\",\n    \"excludePath\": [\"/b/over-the-counter-readers\"],\n    \"qualifier\": {\n      \"prodType\": {\n        \"eq\": \"reader\"\n      }\n    }\n  },\n  {\n    \"label\": \"New\",\n    \"className\": \"new\",\n    \"excludePath\": [\"/b/new-arrivals\"],\n    \"qualifier\": {\n      \"sku.isNew\": {\n        \"eq\": true\n      }\n    }\n  },\n  {\n    \"label\": \"Top rated\",\n    \"className\": \"top-rated\",\n    \"excludePath\": [\"/b/top-rated-glasses\"],\n    \"qualifier\": {\n      \"prodTopRated\": {\n        \"eq\": true\n      }\n    }\n  },\n  {\n    \"name\": \"Best seller\",\n    \"label\": \"Best seller\",\n    \"className\": \"best-seller\",\n    \"excludePath\": [\"/b/best-seller-glasses\"],\n    \"qualifier\": {\n      \"skuBestSeller\": {\n        \"between\": {\n          \"min\": 500,\n          \"max\": 20000\n        }\n      }\n    }\n  },\n  {\n    \"name\": \"Rush delivery\",\n    \"label\": \"Rush delivery\",\n    \"className\": \"rush-delivery\",\n    \"excludePath\": [\"/b/rush-delivery\", \"/b/sunglasses\", \"/b/sunglasses/oversized\", \"/b/sunglasses/summer-colors\", \"/b/sunglasses/retro\"],\n    \"qualifier\": {\n      \"sku.fastFrame\": {\n        \"eq\": true\n      }\n    }\n  }\n]"])</script><script>self.__next_f.push([1,"4b:Ta23,"])</script><script>self.__next_f.push([1,"[\n  {\n    \"id\": \"paypal\",\n    \"title\": \"PayPal\",\n    \"img\": \"/marketing/checkout/payment/paypal.svg\",\n    \"content\": \"\u003cdiv id='paypal-msg-row'\u003e\u003cdiv id='paypal-msg' data-pp-message='' data-pp-style-text-size='14' data-pp-placement='' data-pp-amount='' data-pp-style-text-align='left' data-pp-style-logo-type='none' data-pp-style-layout='text'\u003e\u003ciframe src='https://www.paypal.com/credit-presentment/lander/modal?payer_id=SULDEDQPHB6T6' frameBorder='0' height='750' scrollable='true' width='100%' title='Iframe PayPal'\u003e\u003c/iframe\u003e\u003c/div\u003e\u003c/div\u003e\"\n  },\n  {\n    \"id\": \"affirm\",\n    \"title\": \"Affirm\",\n    \"img\": \"/marketing/checkout/payment/affirm.svg\",\n    \"content\": \"\u003cp\u003eWith Affirm you can pay over time with monthly payments of 3, 6, or 12 months. Your rate will be 10%-36% APR based on credit, and is subject to an eligibility check. Payment options through Affirm are provided by these lending partners: \u003ca target='_blank' href='https://www.affirm.com/lenders'\u003eaffirm.com/lenders\u003c/a\u003e. Options depend on your purchase amount and a down payment may be required.\u003c/p\u003e\"\n  },\n  {\n    \"id\": \"afterpay\",\n    \"title\": \"Afterpay\",\n    \"img\": \"/marketing/checkout/payment/afterpay.svg\",\n    \"content\": \"\u003cp\u003eWith Afterpay, make 4 interest-free* payments every 2 weeks (for purchases of $1 to $2,000) or you can pay over time with monthly payments spread over 6 or 12 months** (for purchases of $400 to $4,000).\u003c/p\u003e\u003cp\u003e* You must be 18 or older, a resident of the U.S.and meet additional eligibility criteria to qualify.Late fees may apply. Click \u003ca href='https://www.afterpay.com/en-US/installment-agreement'\u003e here\u003c/a\u003e for complete terms. Loans to California residents made or arranged pursuant to a California Finance Lenders Law license.\u003c/p \u003e\u003cp\u003e**You must be 18 or older, a resident of the U.S. and meet additional eligibility criteria to qualify. Loans through the Afterpay Pay Monthly program are underwritten and issued by the First Electronic Bank, Member FDIC. A down payment may be required. APRs range from 6.99% to 35.99%, depending on eligibility and merchant. As an example, a 12 month $1,000 loan with 21% APR would have 11 monthly payments of $93.11 and 1 payment of $93.19 for a total payment of $1,117.40. Loans are subject to credit check and approval and are not available in all states. Valid debit card, accessible credit report and acceptance of final terms required to apply. Estimated payment amounts shown on product pages exclude taxes and shipping charges, which are added at checkout. Click \u003ca href='https://www.afterpay.com/en-US/loan-agreement'\u003ehere\u003c/a\u003e for complete terms.\u003c/p\u003e\"\n  }\n]"])</script><script>self.__next_f.push([1,"4c:T10d3,"])</script><script>self.__next_f.push([1,"\u003cdiv class=\"tw-gap-10 tw-flex tw-flex-col\"\u003e\n    \u003cdiv class=\"tw-flex md:tw-flex-row tw-flex-col md:tw-justify-around md:tw-items-start tw-gap-8\"\u003e\n        \u003cpicture\u003e\n            \u003csource media=\"(max-width: 767px)\"\n                srcset=\"//static.zennioptical.com/dev/image/site/order-process/progressive-option/pal_premium_tooltip-xs.jpg\"\u003e\n            \u003csource media=\"(min-width: 768px)\"\n                srcset=\"//static.zennioptical.com/dev/image/site/order-process/progressive-option/pal_premium_tooltip-lg.jpg\"\u003e\n            \u003cimg alt=\"Premium Progressives\" class=\"tw-w-full md:tw-w-auto\"\n                src=\"//static.zennioptical.com/dev/image/site/order-process/progressive-option/pal_premium_tooltip-lg.jpg\"\u003e\n        \u003c/picture\u003e\n        \u003cdiv\u003e\n            \u003ch5 class=\"tw-mb-0\"\u003ePremium Progressives\u003c/h5\u003e\n            \u003cp class=\"tw-mt-4\"\u003ePremium progressives offer everything standard progressives do, but with a\n                wider viewing area, quicker adaptation, and maximum comfort.\u003c/p\u003e\n        \u003c/div\u003e\n    \u003c/div\u003e\n    \u003cdiv class=\"tw-flex md:tw-flex-row tw-flex-col md:tw-justify-around md:tw-items-start tw-gap-8\"\u003e\n        \u003cpicture\u003e\n            \u003csource media=\"(max-width: 767px)\"\n                srcset=\"//static.zennioptical.com/dev/image/site/order-process/progressive-option/pal_standard_tooltip-xs.jpg\"\u003e\n            \u003csource media=\"(min-width: 768px)\"\n                srcset=\"//static.zennioptical.com/dev/image/site/order-process/progressive-option/pal_standard_tooltip-lg.jpg\"\u003e\n            \u003cimg alt=\"Standard Progressives\" class=\"tw-w-full md:tw-w-auto\"\n                src=\"//static.zennioptical.com/dev/image/site/order-process/progressive-option/pal_standard_tooltip-lg.jpg\"\u003e\n        \u003c/picture\u003e\n        \u003cdiv\u003e\n            \u003ch5 class=\"tw-mb-0\"\u003eStandard Progressives\u003c/h5\u003e\n            \u003cp class=\"tw-mt-4\"\u003eStandard progressives were designed to balance distance, near and mid range\n                viewing areas for comfortable, all day wear.\u003c/p\u003e\n        \u003c/div\u003e\n    \u003c/div\u003e\n    \u003cdiv class=\"tw-flex md:tw-flex-row tw-flex-col md:tw-justify-around md:tw-items-start tw-gap-8\"\u003e\n        \u003cpicture\u003e\n            \u003csource media=\"(max-width: 767px)\"\n                srcset=\"//static.zennioptical.com/dev/image/site/order-process/progressive-option/pal_mid_tooltip-xs.jpg\"\u003e\n            \u003csource media=\"(min-width: 768px)\"\n                srcset=\"//static.zennioptical.com/dev/image/site/order-process/progressive-option/pal_mid_tooltip-lg.jpg\"\u003e\n            \u003cimg alt=\"Mid-Range Progressives\" class=\"tw-w-full md:tw-w-auto\"\n                src=\"//static.zennioptical.com/dev/image/site/order-process/progressive-option/pal_mid_tooltip-lg.jpg\"\u003e\n        \u003c/picture\u003e\n        \u003cdiv\u003e\n            \u003ch5 class=\"tw-mb-0\"\u003eMid-Range Progressives\u003c/h5\u003e\n            \u003cp class=\"b1-semibold tw-mt-2 !tw-text-gray-700\"\u003eApproximately 14 feet max distance\u003c/p\u003e\n            \u003cp class=\"tw-mt-4\"\u003eMid-Range progressives feature narrower near-range vision with greater mid-range vision\n                for comfort and visual clarity within 14 feet. They are designed for those who need enhanced up-close\n                vision\n                with the ability to see the entire room more clearly.\u003c/p\u003e\n        \u003c/div\u003e\n    \u003c/div\u003e\n    \u003cdiv class=\"tw-flex md:tw-flex-row tw-flex-col md:tw-justify-around md:tw-items-start tw-gap-8\"\u003e\n        \u003cpicture\u003e\n            \u003csource media=\"(max-width: 767px)\"\n                srcset=\"//static.zennioptical.com/dev/image/site/order-process/progressive-option/pal_near_tooltip-xs.jpg\"\u003e\n            \u003csource media=\"(min-width: 768px)\"\n                srcset=\"//static.zennioptical.com/dev/image/site/order-process/progressive-option/pal_near_tooltip-lg.jpg\"\u003e\n            \u003cimg alt=\"Near-Range Progressives\" class=\"tw-w-full md:tw-w-auto\"\n                src=\"//static.zennioptical.com/dev/image/site/order-process/progressive-option/pal_near_tooltip-lg.jpg\"\u003e\n        \u003c/picture\u003e\n        \u003cdiv\u003e\n            \u003ch5 class=\"tw-mb-0\"\u003eNear-Range Progressives\u003c/h5\u003e\n            \u003cp class=\"b1-semibold tw-mt-2 !tw-text-gray-700\"\u003eApproximately 3 feet max distance\u003c/p\u003e\n            \u003cp class=\"tw-mt-4\"\u003eNear-Range progressives provide greater comfort and visual clarity within 3\n                feet. They are\n                designed for those who spend long periods at a desk or other smaller workspaces.\u003c/p\u003e\n        \u003c/div\u003e\n    \u003c/div\u003e\n\u003c/div\u003e"])</script><script>self.__next_f.push([1,"4d:Ta24,"])</script><script>self.__next_f.push([1,"\u003cdiv class=\"tw-gap-10 tw-flex tw-flex-col\"\u003e\n    \u003cdiv class=\"tw-flex tw-gap-8 tw-w-full tw-flex-col md:tw-flex-row tw-items-start\"\u003e\n        \u003cimg class=\"tw-w-full md:tw-w-[48%]\"\n            src=\"https://static.zennioptical.com/marketing/landingpage/multifocal_landing_page/singleVision.png\"\n            alt=\"Single Vision\" /\u003e\n\n        \u003cdiv class=\"tw-w-full\"\u003e\n            \u003ch5 class=\"tw-mb-0\"\u003eSingle Vision\u003c/h5\u003e\n            \u003cp class=\"tw-mt-4 p1\"\u003eSingle Vision lenses are the standard eyeglass prescription. These glasses are for one\n                field of vision across the entire lens. Single vision glasses can be prescribed for distance vision,\n                near-vision\n                reading glasses, or computer-distance glasses. There are no lens height requirements for single vision\n                prescriptions.\u003c/p\u003e\n        \u003c/div\u003e\n    \u003c/div\u003e\n    \u003cdiv class=\"tw-flex tw-gap-8 tw-w-full tw-flex-col md:tw-flex-row tw-items-start\"\u003e\n        \u003cimg class=\"tw-w-full md:tw-w-[48%]\"\n            src=\"https://static.zennioptical.com/marketing/landingpage/multifocal_landing_page/Progressive.png\"\n            alt=\"Progressive\" /\u003e\n\n        \u003cdiv class=\"tw-w-full\"\u003e\n            \u003ch5 class=\"tw-mb-0\"\u003eProgressive\u003c/h5\u003e\n            \u003cp class=\"tw-mt-4 p1\"\u003eProgressive lenses includes three fields of vision, without lines. In a Progressive\n                lens,\n                the shape of the corrected part of the lens is approximately that of a funnel or mushroom. The top\n                portion\n                is\n                used for distance-vision, the middle portion (corridor) for mid-range vision, and the bottom portion for\n                the\n                near-vision or reading.\u003c/p\u003e\n        \u003c/div\u003e\n    \u003c/div\u003e\n    \u003cdiv class=\"tw-flex tw-gap-8 tw-w-full tw-flex-col md:tw-flex-row tw-items-start\"\u003e\n        \u003cimg class=\"tw-w-full md:tw-w-[48%]\"\n            src=\"https://static.zennioptical.com/marketing/landingpage/multifocal_landing_page/Bifocal.png\"\n            alt=\"Bifocal\" /\u003e\n\n        \u003cdiv class=\"tw-w-full\"\u003e\n            \u003ch5 class=\"tw-mb-0\"\u003eBifocals\u003c/h5\u003e\n            \u003cp class=\"tw-mt-4 p1\"\u003eBifocals lenses include two fields of vision separated by a line. Usually the top is\n                designated for distance vision or computer-distance vision, and the bottom for near-vision work such as\n                reading.\n                The bottom reading area is positioned just below the centerline of the lens. The position of the\n                bi-focal\n                area\n                will be affected by the height of the lens chosen.\u003c/p\u003e\n        \u003c/div\u003e\n    \u003c/div\u003e\n\u003c/div\u003e"])</script><script>self.__next_f.push([1,"4e:T3498,"])</script><script>self.__next_f.push([1,"[\n  {\n    \"productId\": \"11431\",\n    \"text\": \"More colors available (non-presc