\n        },\n        {\n          \"title\": \"Temple arm\",\n          \"description\": \"Length from frame hinge to tip. Affects the comfort behind your ears and overall stability.\",\n          \"imageUrl\": \"https://static.zennioptical.com/marketing/size-guide/temple-arm.svg\",\n          \"imageAlt\": \"Temple arm\"\n        },\n        {\n          \"title\": \"Pupillary distance\",\n          \"description\": \"Distance between the center of your pupils. Ensures the optical center of your lenses is aligned with your eyes.\",\n          \"imageUrl\": \"https://static.zennioptical.com/marketing/size-guide/pupillary-distance.svg\",\n          \"imageAlt\": \"Pupillary distance\"\n        }\n      ]\n    },\n    \"returnPolicy\": {\n      \"text\": \"We offer 30-day returns so you can find the right size and shop with ease.\",\n      \"link\": {\n        \"label\": \"See terms\",\n        \"url\": \"/c/return\"\n      }\n    }\n  }"])</script><script>self.__next_f.push([1,"35:T1133,"])</script><script>self.__next_f.push([1,"{\n  \"attributes\": [\n    { \"value\": \"Casual\", \"en-US\": \"Casual\" },\n    { \"value\": \"Trendy\", \"en-US\": \"Trendy\" },\n    { \"value\": \"Sporty\", \"en-US\": \"Sporty\" },\n    { \"value\": \"Fashion Forward\", \"en-US\": \"Fashion Forward\" },\n    { \"value\": \"Classic\", \"en-US\": \"Classic\" },\n    { \"value\": \"Formal\", \"en-US\": \"Formal\" },\n    { \"value\": \"Loose\", \"en-US\": \"Loose\" },\n    { \"value\": \"True to Size\", \"en-US\": \"True to Size\" },\n    { \"value\": \"Tight\", \"en-US\": \"Tight\" },\n    { \"value\": \"Low\", \"en-US\": \"Low\" },\n    { \"value\": \"Average\", \"en-US\": \"Average\" },\n    { \"value\": \"High\", \"en-US\": \"High\" },\n    { \"value\": \"Oval\", \"en-US\": \"Oval\" },\n    { \"value\": \"Round\", \"en-US\": \"Round\" },\n    { \"value\": \"Square\", \"en-US\": \"Square\" },\n    { \"value\": \"Heart\", \"en-US\": \"Heart\" },\n    { \"value\": \"Pear\", \"en-US\": \