lide to show more images on the left or right\",\"global.pdp.standard.flashSaleIconSrc\":\"/dev/image/site/flash-sale/flash-sale-icon.svg\",\"pdp.branded.upsellText\":\"{\\n  \\\"items\\\": [\\n    {\\n      \\\"iconClass\\\": \\\"fas fa-badge-check\\\",\\n      \\\"title\\\": \\\"Authenticity Guaranteed\\\",\\n      \\\"description\\\": \\\"Certified genuine ${brandName}, ships with the original case and cloth.\\\"\\n    },\\n    {\\n      \\\"imageUrl\\\": \\\"/dev/image/site/branded-skus/truck-fast.svg\\\",\\n      \\\"title\\\": \\\"Eligible for Rush Delivery\\\",\\n      \\\"description\\\": \\\"Available for non-prescription, single vision (near or far distance), and progressive lenses.\\\"\\n    }\\n  ],\\n  \\\"tooltipItem\\\": {\\n    \\\"iconClass\\\": \\\"fas fa-exchange-alt\\\",\\n    \\\"title\\\": \\\"30-Day Returns\\\",\\n    \\\"description\\\": \\\"Learn more\\\",\\n    \\\"tooltipData\\\": {\\n      \\\"title\\\": \\\"Return policy\\\",\\n      \\\"description\\\": \\\"Get a full refund within 14 days or store credit within 30 days of delivery. Shipping costs not included.\\\",\\n      \\\"link\\\": {\\n        \\\"text\\\": \\\"Read our full return policy\\\",\\n        \\\"url\\\": \\\"/c/return\\\"\\n      }\\n    }\\n  }\\n}\",\"global.pdp.standard.dailyDealLinkText\":\"terms\",\"global.pdp.standard.dailyDealBody\":\"Score these frames for just ${$dailyDealPrice} today! Offer available for up to 3 pairs. Act fast, this amazing deal expires at midnight! See \",\"pdp.readers.priceOfferMessage\":\"Buy 2 or more pairs of ready readers, 20% off for each pair!\",\"global.pdp.standard.flashSale\":\"Flash Sale\",\"global.pdp.price.retail\":\"Retails at\",\"global.pdp.tooltip.close\":\"Close tooltip\",\"global.pdp.standard.dailyDeal\":\"Daily Deal\",\"global.pdp.standard.dailyDealHref\":\"/promotion/promotion-tnc#deal-of-the-day\",\"global.pdp.dailyDealTitle\":\"Deal of the Day: ${$dailyDealPrice} Frames\",\"global.pdp.fullStop\":\".\",\"global.pdp.cta.selectLensAndTint\":\"Select Lens \u0026 Tint\",\"global.pdp.standard.flashSaleTitleBody\":\"No returns or exchanges on flash sale items.\",\"global.pdp.cta.selectLenses\":\"Select Lenses\",\"global.button.navigateTo\":\"Navigate to\",\"pdp.nonRx.upsellText\":\"{\\n  \\\"items\\\": [\\n    {\\n      \\\"iconClass\\\": \\\"fas fa-sun\\\",\\n      \\\"title\\\": \\\"Complete UV Protection\\\",\\n      \\\"description\\\": \\\"Our lenses block 100% of harmful UVA \u0026 UVB rays.\\\"\\n    },\\n    {\\n      \\\"iconClass\\\": \\\"fas fa-sparkles\\\",\\n      \\\"title\\\": \\\"Coatings \u0026 Finishes\\\",\\n      \\\"description\\\": \\\"Scratch-resistant coating included on standard lenses. Mirrored lenses feature a reflective finish.\\\"\\n    },\\n    {\\n      \\\"iconClass\\\": \\\"fas fa-exchange-alt\\\",\\n      \\\"title\\\": \\\"30-Day Returns\\\",\\n      \\\"description\\\": \\\"Full refund within 14 days; store credit within 30 days. Shipping costs not included.\\\"\\n    }\\n  ]\\n}\",\"plp.productCard.previousPriceAria\":\"Previous price:\",\"plp.productCard.brandedWas.label\":\"Was\",\"plp.productCard.brandedWas.aria\":\"Previous price:\",\"plp.productCard.brandedRetailsAt.aria\":\"Retails at:\",\"plp.productCard.brandedRetailsAt.label\":\"Retails At\",\"pdp.lensPower.error.message\":\"Please select lens power to continue\",\"global.pdp.selectLensPower\":\"Select lens power:\",\"pdp.Reader.PriceOfferMessage\":\"Buy 2 or more pairs of ready readers, 20% off for each pair!\",\"plp.VTO.closeConfirmPD\":\"close confirm pd modal\",\"global.pdp.share.text\":\"Share\",\"pdp.rushDelivery.addRushForPrice\":\"Rush Delivery starts at $19\",\"pdp.vr.howToInstall.config.VR70006\":\"{\\n  \\\"steps\\\": [\\n    {\\n      \\\"text\\\": \\\"Position your headset with the lenses facing you.\\\",\\n      \\\"imageUrl\\\": \\\"/marketing/vr_lens_inserts/beast/pdp_install_step1.png\\\"\\n    },\\n    {\\n      \\\"text\\\": \\\"Align the lens inserts for left (L) and right (R). The (L) and (R) markings on the lens inserts should be at the top (1 o’clock for the Left lens, and 11 o’clock for the Right lens).\\\",\\n      \\\"imageUrl\\\": \\\"/marketing/vr_lens_inserts/beast/pdp_install_step2.png\\\"\\n    },\\n    {\\n      \\\"text\\\": \\\"Push the lens inserts onto the headset lenses until they snap into place.\\\",\\n      \\\"imageUrl\\\": \\\"/marketing/vr_lens_inserts/beast/pdp_install_step3.png\\\"\\n    }\\n  ],\\n  \\\"title\\\": \\\"MR Lens Installation Meta Quest 3S / 2\\\",\\n  \\\"videoBtnLabel\\\": \\\"View installation video\\\"\\n}\",\"pdp.rushDelivery.seeRestrictions.label\":\"See restrictions\",\"pdp.vr.skuOptions.config\":\"$44\",\"pdp.rushDelivery.seeRestrictions.modalBody\":\"\u003cdiv\u003eRush Delivery is available for Single Vision, Progressive, and Non-Prescription lenses in the US and Canada. Delivery estimates are based on Single Vision lenses, please add two days for Progressive lenses. Higher prescriptions may require additional time.\u003cbr\u003e\u003cbr\u003eWhile we aim for accurate delivery times, final dates depend on our shipping partners. For any issues or questions, please contact our \u003ca class=text-decoration-underline href=/c/contact-us\u003ecustomer service\u003c/a\u003e team.\u003c/div\u003e\",\"global.normalAnchor.prev\":\"Previous\",\"global.video.fallbackMsg\":\"Your browser does not support the video tag.\",\"global.normalAnchor.next\":\"Next \",\"pdp.vr.skuOptions.offRate\":\"Save {{percent}}%\",\"pdp.vr.skuOptions.included\":\"Included\",\"pdp.rimless.lens.shape.selector.modal.title\":\"Lens Shape Selector\",\"pdp.standard.sizeChartPopupTitle\":\"Size Chart\",\"pdp.rimless.lens.for.single\":\"Single Vision\",\"global.button.scrollToTop\":\"Scroll to top\",\"pdp.rimless.button.shape.text\":\"Change lens shape\",\"global.rushDelivery.modal.categoryList\":\"{\\n  \\\"categories\\\": [\\n    {\\n      \\\"title\\\": \\\"Eyeglass\\\",\\n      \\\"pageUrl\\\": \\\"/b/all-glasses\\\",\\n