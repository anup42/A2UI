udes font-small\\\"\u003e\u003cstrong class=\\\"text-uppercase\\\"\u003eFrame Price Includes:\u003c/strong\u003e\u003cul class=\\\"list-unstyled margin-bottom-0 margin-top-10\\\"\u003e\u003cli\u003e\u003ci class=\\\"fas fa-check font-smaller\\\"\u003e\u003c/i\u003e\u003cspan\u003eAnti-scratch coating\u003c/span\u003e\u003c/li\u003e\u003cli\u003e\u003ci class=\\\"fas fa-check font-smaller\\\"\u003e\u003c/i\u003e\u003cspan\u003eUV protection\u003c/span\u003e\u003c/li\u003e\u003c/ul\u003e\u003c/div\u003e\\n\",\"pdp.upsellText.Goggles\":\"\u003cdiv class=\\\"price-includes font-small\\\"\u003e\u003cstrong class=\\\"text-uppercase\\\"\u003eFrame Price Includes:\u003c/strong\u003e\u003cul class=\\\"list-unstyled margin-bottom-0 margin-top-10\\\"\u003e\u003cli\u003e\u003ci class=\\\"fas fa-check font-smaller\\\"\u003e\u003c/i\u003e\u003cspan\u003eAnti-scratch coating\u003c/span\u003e\u003c/li\u003e\u003cli\u003e\u003ci class=\\\"fas fa-check font-smaller\\\"\u003e\u003c/i\u003e\u003cspan\u003eUV protection\u003c/span\u003e\u003c/li\u003e\u003c/ul\u003e\u003c/div\u003e\\n\",\"pdp.upsellText.NonRXSunglasses\":\"For luxe shades with Zenni’s signature style and affordability, check out our \u003ca href=\\\"/premium-sunglasses\\\"\u003epremium sunglasses\u003c/a\u003e.\\n\",\"pdp.upsellText.NonRXGoggles\":\"Large enough to fit over glasses, protecting the eyes from dust and other particulate matter.\\n\",\"password.requirements.long\":\"8 to 14 characters long\",\"my.account.settings.confirm.new.password.does.not.match\":\"Password confirmation does not match\",\"my.account.settings.password.change\":\"I want to change my password.\",\"password.requirements.number\":\"One number\",\"password.requirements.uppercase\":\"One uppercase character\",\"password.requirements.lowercase\":\"One lowercase character\",\"label.show\":\"Show\",\"my.account.settings.current.password.does.not.match\":\"Password does not match the account information\",\"label.hide\":\"Hide\",\"my.account.settings.email.notice\":\"You'll use this to log in from now on\",\"my.account.settings.firstname\":\"First Name\",\"my.account.settings.email.already.exist\":\"This account already exists. Please enter a different email address.\",\"my.account.settings.email.required\":\"Email required\",\"my.account.settings.email\":\"Email\",\"my.account.settings.email.invalid\":\"Email invalid\",\"my.account.settings.lastname.invalid\":\"Last name invalid\",\"my.account.settings.lastname.required\":\"Last name required\",\"my.account.settings.email.invalidated\":\"We're unable to validate your email. Please make sure it's entered correctly. If your email is correct, you may continue with registration.\",\"my.account.settings.firstname.required\":\"First name required\",\"my.account.settings.continue\":\"Ok, got it!\",\"my.account.settings.lastname\":\"Last Name\",\"my.dashboard.password.label\":\"********\",\"my.account.settings.firstname.invalid\":\"First name invalid\",\"my.dashboard.password\":\"Password:\",\"tint.selection.save.tint.button\":\"Save Tint Selection\",\"my.dashboard.the.account.information.has.been.saved\":\"The account information has been saved.\",\"my.dashboard.edit\":\"edit\",\"tint.selection.lens.type.link\":\"Lens Type\",\"my.dashboard.my.account.setting\":\"My Account Settings\",\"tint.selection.main.heading\":\"Select a Tint Type\",\"snap.on.shield.text\":\"Easily slide over the top of your glasses. Displayed on sample frame.\",\"order.state.Fraudulent\":\"Fraudulent\",\"my.prescription.title\":\"My Prescriptions\",\"pdp.upsellText.Earrings\":\" Amplify your style with chic acetate earrings. Shop matching frames below. \u003ci\u003eEarrings available for U.S. shipping only.\u003c/i\u003e---test\\n\",\"pdp.upsellText.SafetyGlasses\":\"\u003cdiv class=\\\"relative blokz-upsell\\\"\u003e\u003cstrong\u003eZenni WOW Price\u003c/strong\u003e\u003cbr\u003eZ87.1 options include impact-resistant lenses, anti-scratch, 100% UV, and advanced anti-reflective coatings. (Lens options not included in frame price)---test\\n\",\"add.on.clear.all.link\":\"Clear All\",\"order.state.Cancelled\":\"Removed\",\"order.state.Processing\":\"Processing\",\"order.state.Shipped\":\"Shipped\",\"order.state.Manufactured\":\"Manufactured\",\"text.engraving.input.limit.text\":\"character limit.\",\"engraving.nav.outside.link\":\"Outside\",\"text.engraving.input.placeholder\":\"Enter your engraving\",\"text.engraving.input.required.error.message\":\"Engraving text required\",\"text.engraving.input.max.error.message\":\"Max character limit reached\",\"engraving.back.button\":\"Back\",\"order.confirm.items.order.line.footer.title\":\"FSA/HSA Reimbursement\",\"order.confirm.items.order.line.footer.print\":\" In 7 days your printable receipt will be ready for download within My Account.\",\"engraving.nav.engraving.link\":\"Engraving\",\"engraving.heading.main\":\"Personalize your frames\",\"order.confirm.items.order.line.item.btn.print\":\"Print Order\",\"order.confirm.items.order.line.item.btn.continue.shopping\":\"Continue Shopping\",\"order.confirm.items.order.shipping\":\"Shipping\",\"order.confirm.items.order.payment\":\"Payment\",\"order.confirm.items.order.number\":\"Order number\",\"order.confirm.items.order.line.item.review\":\"Item Review\",\"order.confirm.items.order.line.item.quantity\":\"Qty:\",\"order.confirm.header.thanks\":\"Thank you for the order.\",\"terms.modal.copyrights.trademarks.text2\":\"Further you warrant and represent that no part of the design or custom text engraving: (a) violates or infringes upon any common law or statutory right of any person or entity, including, but not limited to, rights relating to copyrights, trademarks, contract rights, moral rights or rights of public performance; (b) is the subject of any notice of such infringement you have received; or (c) is subject to any restriction or right of any kind or nature whatsoever which would prevent ZenniOptical.com from legally reproducing the images or custom text engraving submitted.\",\"outside.text.engraving.fonts\":\"Fonts\",\"outside.text.engraving.colors\":\"Colors\",\"outside.text.engraving.sub.heading\":\"Applied to both arms.\",\"terms.modal.copyrights.trademarks.text3\":\"You as a customer of ZenniOptical.com agree to defend, at your sole expense, any claim, suit, or proceeding brought against ZenniOptical.com which pertains to, or is based upon, a claim that any portion of the design infringes or constitutes use or wrongful use, of any copyright, trademark, or other rights of any third party, provided that ZenniOptical.com gives you written notice of any such claim and provides you such reasonable cooperation and assistance as you may require in the defense thereof. You shall pay any and all damages and costs assessed against ZenniOptical.com pursuant to such a suit or proceeding. Further, you agree to indemnify and hold ZenniOptical.com harmless from and with respect to any and all such loss or damage (including, but not limited to, reasonable attorneys' fees, costs, and travel costs) associated with any such claim, suit or proceeding.\",\"outside.text.engraving.heading\":\"Outside temple arms.\",\"my.account.settings.confirm.new.password.invalid\":\"Confirm new password invalid\",\"terms.modal.text\":\"I have read, understood and agree to the copyright and trademark terms stated herein.\",\"terms.modal.read.terms.link\":\"Read terms\",\"terms.modal.copyrights.trademarks.text1\":\"By submitting a design, a logo, or custom text engraving on ZenniOptical.com, you warrant and represent that you are the sole, or legal owner or licensee of all rights, including copyright, to each copyright, trademark, service mark, trade name, logo, statement, portrait, graphic, artwork, photograph, picture or illustration of any person or any other intellectual property included in such design.\",\"terms.modal.copyrights.trademarks.heading\":\"Copyrights and Trademarks\",\"my.account.settings.confirm.new.password.required\":\"Confirm n