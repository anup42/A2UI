mmary.checkout.product.snap.on.shields\":\"Snap On Shields\",\"summary.checkout.product.prescription.option\":\"Option:\",\"summary.checkout.product.prescription.non.prescription\":\"Non Prescription\",\"summary.checkout.product.prescription.separator\":\"|\",\"summary.checkout.product.clip.ons\":\"Clip-Ons\",\"summary.checkout.product.prescription.prism.base.direction.in\":\"BI\",\"summary.checkout.product.prescription.prism.base.direction.up\":\"BU\",\"summary.checkout.product.prescription.prism.base.direction.out\":\"BO\",\"summary.checkout.product.prescription.prism.horizontal\":\"Horizontal\",\"summary.checkout.product.prescription.prism.base.direction.down\":\"BD\",\"summary.checkout.product.prescription.prism.vertical\":\"Vertical\",\"summary.checkout.product.prescription.nv.add\":\"ADD\",\"summary.checkout.product.prescription.prism\":\"Prism:\",\"summary.checkout.product.prescription.axis\":\"Axis\",\"summary.checkout.product.prescription.sph\":\"SPH\",\"summary.checkout.product.prescription.os\":\"OS:\",\"summary.checkout.product.prescription.cyl\":\"CYL\",\"summary.checkout.product.prescription.od\":\"OD:\",\"summary.checkout.product.prescription\":\"Prescription\",\"summary.checkout.product.prescription.type\":\"Type:\",\"summary.checkout.product.prescription.pd\":\"PD:\",\"cart.page.section.add-discount.error.cart-service-error-add-discount-already-have\":\"Please remove applied coupon first before you try next one\",\"summary.checkout.product.glasses\":\"Your glasses\",\"pdp.standard.tooltipsPdRange\":\"\u003cdiv class=\\\"title\\\"\u003ePD Range\u003c/div\u003e\\n\u003cbr /\u003e\\n\u003cdiv class=\\\"message\\\"\u003e\\n  \u003cp\u003e\\n    Pupillary Distance (PD) is the distance, in millimeters, between the center of\\n    one pupil to the center of the other. The PD is needed to manufacture your\\n    eyeglasses because it determines the exact optical center of the lens, which\\n    is the point where you look through the lens. PD is especially important for\\n    manufacturing progressive lenses.\\n  \u003c/p\u003e\\n  \u003cp\u003e\u0026nbsp;\u003c/p\u003e\\n  \u003cp\u003e\\n    Once you have your PD, you can upload your photo to the Frame Fit tool and\\n    begin trying on glasses. The Frame Fit tool allows you to see exactly what the\\n    glasses look like on you and how well they fit the size and shape of your\\n    face. If you don’t have your PD, you can find out how to measure it\\n    \u003ca href=\\\"/c/infographic#comp-infographics-measure-PD\\\" target=\\\"_blank;\\\"\u003ehere\u003c/a\u003e.\\n  \u003c/p\u003e\\n\u003c/div\u003e\",\"payment.creditcard.creditcardNumber.disallow.discover\":\"Discover credit card is not supported\",\"reader.magnification.strength.your.age\":\"Your Age\",\"reader.magnification.strength.select.your.magnification.strength\":\"Select your magnification strength\",\"reader.magnification.strength.0.75.to.1.00\":\"+0.75 to +1.00\",\"reader.magnification.strength.recommended.reading.glasses.power\":\"Recommended Reading Glasses Power\",\"tint.selection.included\":\"Included\",\"payment.paymentoption.ca-store.popover.content\":\"\u003cp\u003e\\n  \u003cdiv\u003e\\n    \u003cstrong\u003eCredit Cards:\u003c/strong\u003e\\n  \u003c/div\u003e\\n  Visa, Master Card, American Express\\n\u003c/p\u003e\\n\u003cp\u003e\\n  \u003cdiv\u003e\\n    \u003cstrong\u003ePayment Options:\u003c/strong\u003e\\n  \u003c/div\u003e\\n  To pay with ApplePay, PayPal, AmazonPay, or GooglePay, select the appropriate icon and follow the prompts.\\n\u003c/p\u003e\",\"reader.magnification.strength.age.40-44\":\"40-44\",\"cart.page.eyeglasses.prescription.cylinder.sm\":\"CYL\",\"cart.page.eyeglasses.prescription.sphere.sm\":\"SPH\",\"cart.page.eyeglasses.prescription.type.sm\":\"PRES TYPE\",\"prescription.form.table.NearRange\":\"Near-Range\",\"payment.paymentoption.us-store.popover.content\":\"\u003cp\u003e\\n  \u003cdiv\u003e\\n    \u003cstrong\u003eCredit Cards:\u003c/strong\u003e\\n  \u003c/div\u003e\\n  Visa, Master Card, American Express, and Discover\\n\u003c/p\u003e\\n\u003cp\u003e\\n  \u003cdiv\u003e\\n    \u003cstrong\u003ePayment Options:\u003c/strong\u003e\\n  \u003c/div\u003e\\n  To pay with ApplePay, PayPal, AmazonPay, or GooglePay, select the appropriate icon and follow the prompts.\\n\u003c/p\u003e\",\"payment.paymentoption.popover.content\":\"\u003cp\u003e\\n  \u003cdiv\u003e\\n    \u003cstrong\u003eCredit Cards:\u003c/strong\u003e\\n  \u003c/div\u003e\\n  Visa, Master Card, American Express, and Discover\\n\u003c/p\u003e\\n\u003cp\u003e\\n  \u003cdiv\u003e\\n    \u003cstrong\u003ePayment Options:\u003c/strong\u003e\\n  \u003c/div\u003e\\n  To pay with ApplePay, PayPal, AmazonPay, or GooglePay, select the appropriate icon and follow the prompts.\\n\u003c/p\u003e\",\"prescription.form.table.Standard\":\"Standard\",\"summary.checkout.gift.card.name\":\"Zenni\",\"customer-service-error-invalid-reminder-input\":\"Reminder frequency is not valid should be either of 6 12 18 22 24\",\"order.details.quantity\":\"Qty:\",\"order.details.readers.strength\":\"Strength:\",\"customer-service-error-invalid-prescription\":\"Prescription has errors\",\"customer-service-error-prescription-reminder-not-added\":\"There was an error processing the request\",\"order.details.free\":\"FREE\",\"order.details.inside.text\":\"Inside Text\",\"order.details.colon.separator\":\":\",\"order.details.outside.text\":\"Outside Text\",\"order.details.outside.icon\":\"Outside Icon\",\"order.details.readers\":\"Readers\",\"order.details.snap.on.shields\":\"Snap On Shields\",\"order.details.engraving\":\"Engraving\",\"order.details.clip.ons\":\"Clip Ons\",\"order.details.unavailable\":\"Unavailable\",\"order.details.add.ons\":\"Add Ons\",\"order.details.estimated.total\":\"Estimated Total\",\"pdp.details.bifocal\":\"Bifocal\",\"pdp.details.progressive\":\"Progressive\",\"order.details.coating\":\"AR Coating\",\"global.error\":\"Error\",\"order.details.lenses\":\"Lenses\",\"order.details.index\":\"Index\",\"order.confirm.items.order.eyeglasses.type\":\"Frame:\",\"order.confirm.items.order.сlipon.frame.type\":\"Clipon of frame: \",\"previously.saved.prescription.select.from.order.sub.text\":\"Select a prescription from a previous order\",\"order.confirm.items.order.gift.card.type\":\"GiftCard:\",\"summary.checkout.product.eyeglasses.coating\":\"Anti-Reflection:\",\"summary.checkout.product.eyeglasses.tint\":\"Tint:\",\"pdp.details.bifocal.link\":\"/b/bifocal-glasses\",\"pdp.details.progressive.link\":\"/b/progressive-eyeglasses\",\"summary.checkout.product.eyeglasses.index\":\"Index:\",\"summary.checkout.product.eyeglasses.lens\":\"Lens\",\"pdp.details.readers.link\":\"/b/reading-glasses\",\"lens.arm.image.alt\":\"lens arm image\",\"search.noResult.noResults\":\"No results were found\",\"frame.image.alt\":\"lens frame image\",\"search.noResult.phoneNumber\":\"(800) 211-2105\",\"pdp.standard.readers\":\"Readers\",\"eyeglasses.order.summary.os.left\":\"Left-OS:\",\"eyeglasses.order.summary.prescription\":\"Prescription:\",\"eyeglasses.order.summary.od.right\":\"Right-OD:\",\"eyeglasses.order.summary.prescription.sph\":\"Sphere (SPH) \",\"eyeglasses.order.summary.prescription.cyl\":\"Cylinder (CYL)\",\"eyeglasses.order.summary.pd\":\"PD-Pupillary Distance:\",\"order.modal.error.payments.generate\":\"Payment failed. Please try again.\",\"SelectedFilter.Name.prescription\":\"Prescription\",\"order.modal.error.tryagain\":\"Click OK to refresh the page to try again.\",\"eyeglasses.order.summary.title\":\"Order Summary\",\"add-to-cart-error-max-cart-quantity-exceeded\":\"OOPS! Sorry, a regular order can't have more than 99 products. If you plan to buy large quantity, please call us for partnership opportunity\",\"plp.filterbox.selectFilterNotice\":\"Select a filter to narrow your selection\",\"prescription.progressive.option.Premium\":\"Premium\",\"prescription.progressive.option.Standard\":\"Standard\",\"prescription.progressive.option.NearRange\":\"Near-Range\",\"prescription.progressive.option.MidRange\":\"Mid-Range\",\"cart.page.product.eyeglasses.coating.title\":\"AR Anti-Reflection Coating\",\"prescription.type.Bifocal\":\"Bifocal\",\"prescription.type.Progressive\":\"Progressive (No-Line Multi-Focal)\",\"configuration.summary.warning.message.text.1\":\"You are about to make a change that will affect your selected options.\",\"my.prescription.remove\":\"delete\",\"configuration.summary.warning.message.text.2\":\"Do you want to continue?\",\"prescription.type.SingleVision\":\"Single Vision\",\"configuration.summary.warning.cancel.button\":\"Cancel\",\"configuration.summary.warning.title\":\"Are you sure?\",\"order.details.rx\":\"Rx\",\"SelectedFilter.Name.prod_lens_height\":\"Lens Height\",\"order.details.lens\":\"Lens\",\"configuration.summary.warning.yes.button\":\"Yes\",\"SelectedFilter.Name.temple_arm\":\"Temple Arm\",\"SelectedFilter.Name.single_pd\":\"PD\",\"SelectedFilter.Name.color\":\"Color\",\"SelectedFilter.Name.prod_shape\":\"Frame Shape\",\"SelectedFilter.Name.genders\":\"Gender\",\"SelectedFilter.Name.prod_frame_width\":\"Frame Width\",\"SelectedFilter.Name.prod_material\":\"Material\",\"cart-service-error-add-discount\":\"Generic error code when service got successfull CT request status code (200) but had some problem on handling the response message\",\"cart-service-error-add-discount-mutation\":\"Generic error code when service got insuccessfull CT request status code (\u003c\u003e 200, 201, etc)\",\"cart-service-error-expired-code\":\"Error code returned when the discount code provided has expired\",\"cart-service-error-invalid-code\":\"Error code returned when the discount code provided doesn’t exists\",\"coating.selection.modal.includes\":\"Includes\",\"coating.selection.modal.water.resistant.image.item\":\"Hydrophobic\",\"coating.selection.modal.premium.antifog.description\":\"Zenni’s anti-fog + anti-reflective coating reduces glare and helps prevent your lenses from fogging up. The anti-fog coating is on both sides of the lenses. Each pair of anti-fog coated lenses comes with a special anti-fog activator lens cloth that activates the anti-fog properties every time you clean your lenses to help keep them extra clear.\",\"coating.selection.modal.oil.resistant.image.item\":\"Oleophobic\",\"text.allowed.alphanumeric.characters.title\":\"Alphanumeric Characters:\",\"text.allowed.alphanumeric.characters.text\":\"ABC, abc, 123...\",\"coating.selection.modal.anti.reflective.image.item\":\"Anti_Reflective\",\"usage.sub.type.card.title.blokz.photochromic\":\"Blokz Photochromic\",\"coating.selection.modal.anti.fog.image.item\":\"Antifog\",\"usage.sub.type.card.title.photochromic.blokz\":\"Blokz Photochromic\",\"usage.sub.type.card.title.sunglasses.blokz\":\"Blokz Sunglasses\",\"coating.selection.modal.add.anti.reflective.coating\":\"ADD ANTI-REFLECTIVE COATING\",\"payment.option.paypal.summary.taxes\":\"Taxes\",\"usage.type.title.blokz\":\"Blokz Blue Light\",\"usage.sub.type.card.title.blokz.generaluse\":\"Blokz\",\"usage.sub.type.card.title.blokz.sunglasses\":\"Blokz Sunglasses\",\"usage.sub.type.card.title.clear.blokzgeneraluse\":\"Blokz\",\"my.address.book.edit.address\":\"Edit Address\",\"snap.on.detail.modal.swatch.title\":\"Colors\",\"engraving.background.decider.color2\":\"Yellow\",\"engraving.background.decider.color1\":\"White\",\"snap.on.detail.modal.title\":\"Protective Snap On Shields\",\"snap.on.detail.modal.text\":\"The non-prescription detachable shield fits securely over your prescription glasses, providing convinent protection when you need it.\",\"payment.option.paypal.summary.shipping\":\"Shipping\",\"eyeglasses.order.summary.lenses\":\"Lenses:\",\"eyeglasses.order.summary.clipons\":\"Clip Ons\",\"eyeglasses.order.summary.tint\":\"Tint:\",\"eyeglasses.order.summary.index\":\"Index:\",\"eyeglasses.order.summary.coating\":\"AR Coating:\",\"eyeglasses.order.summary.addons\":\"Add Ons:\",\"eyeglasses.order.summary.prescription.prism.bd.out\":\"BO\",\"eyeglasses.order.summary.prescription.birth.year\":\"Birth Year: \",\"eyeglasses.order.summary.prescription.prism.bd.up\":\"BU\",\"eyeglasses.order.summary.prescription.prism.bd.down\":\"BD\",\"eyeglasses.order.summary.prescription.prism.bd.in\":\"BI\",\"eyeglasses.order.summary.prescription.prism.vertical\":\"Vertical\",\"eyeglasses.order.summary.prescription.prism\":\"Prism:\",\"eyeglasses.order.summary.prescription.nv.add\":\"NV-ADD: \",\"eyeglasses.order.summary.prescription.axis\":\"Axis\",\"eyeglasses.order.summary.prescription.prism.horizontal\":\"Horizontal\",\"text.allowed.special.characters.text\":\"! @ # $ % ^ \u0026 * ( ) _ + - \\\\ = [ ; ' / . , \u003c \u003e ? : \\\" { } |\",\"text.allowed.greek.letters.text\":\"Α-Ω, α-ω...\",\"text.allowed.special.characters.title\":\"Special Characters like:\",\"text.allowed.greek.letters.title\":\"24 Greek letters in both uppercase and lowercase:\",\"progressive.option.comfortable.view\":\"Comfortable view\",\"progressive.option.maximum.comfort.use\":\"Maximum comfort\",\"progressive.option.easy.zone.adaptation\":\"Easy zone adaptation\",\"progressive.option.vision.range.upto.14ft\":\"Vision range: up to 14 ft.\",\"progressive.option.for.all.day.activities\":\"For all day activities\",\"progressive.option.40%.wider.viewing.area\":\"40% wider viewing area\",\"progressive.option.monitor.url\":\"monitor\",\"progressive.option.reading.url\":\"reading\",\"progressive.option.closeview.url\":\"closeview\",\"progressive.option.driving.url\":\"driving\",\"progressive.option.standard.progressives\":\"Standard Progressives\",\"progressive.option.vision.range.upto.3ft\":\"Vision range: up to 3 ft.\",\"progressive.option.NearRange.image\":\"near_illo-xs\",\"order.details.tint\":\"Tint\",\"progressive.option.premium\":\"Premium\",\"progressive.option.premium.image\":\"premium_illo-xs\",\"pdp.mobile.add\":\"ADD\",\"progressive.option.MidRange.image\":\"mid_illo-xs\",\"reader.magnification.strength.1.50.to.2.00\":\"+1.50 to +2.00\",\"reader.magnification.strength.2.00.to.2.25\":\"+2.00 to +2.25\",\"SelectedFilter.Name.prod_bridge\":\"Bridge\",\"global.date.format.test\":\"DD/MM/YYYY\",\"order.details.prescription\":\"Prescription\",\"reader.magnification.strength.2.25.to.2.75\":\"+2.25 to +2.75\",\"order.details.details\":\"Details\",\"reader.magnification.strength.age.45-49\":\"45-49\",\"reader.magnification.strength.age.50-54\":\"50-54\",\"reader.magnification.strength.age.60+\":\"60+\",\"reader.magnification.strength.age.55-59\":\"55-59\",\"reader.magnification.strength.1.00.to.1.50\":\"+1.00 to +1.50\",\"reader.magnification.strength.modal.sub.title\":\"Find your preferred magnification strength by using \u003ca href=\\\"https://static.zennioptical.com/marketing/information/magnification-strength-chart.pdf\\\" target=\\\"_blank;\\\"\u003ethis chart\u003c/a\u003e or the recommendations below. No prescription is required for readers\\n\",\"order.details.non.prescription\":\"Non-prescription\",\"coating.selection.modal.standard.description\":\"\u003cb\u003eStandard\u003c/b\u003e Anti-Reflective Coating  \u003cb\u003ereduces glare\u003c/b\u003e, reflections, and halos around lights at night, improving the vision and the appearance of your glasses.\",\"reader.magnification.strength.magnification.strength\":\"MAGNIFICATION STRENGTH\",\"coating.selection.modal.premium.oil.resistant.description\":\"\u003cb\u003eOleophobic\u003c/b\u003e (Premium Oil And Fingerprint Resistant) Anti-Reflective Coating has all the properties of the standard AR and water-resistant coatings, plus and added oleophobic coating that repels fingerprints.\",\"coating.selection.modal.advanced.description\":\"\u003cb\u003eSuper Hydrophobic\u003c/b\u003e (Water Resistant, Easy To Clean) Anti-Reflective Coating has all the properties of the standard AR coating, plus a water-resistant coating that repels dirt and water, making it easier to clean.\\n\\n\",\"new.prescription.data.entry.left.os\":\"Left - OS\",\"prescription.readers.strength\":\"STRENGTH\",\"new.prescription.data.entry.right.od\":\"Right - OD\",\"text.engraving.input.emoji.error.message\":\"Emojis are not allowed \",\"SelectedFilter.Name.prod_features\":\"Feature\",\"new.prescription.data.entry.od\":\"OD\",\"add.new.prescription.my.prescription\":\"My Prescription\",\"global.product.on.sale\":\"On sale\",\"email.template.order.confirmation.non.prescription\":\"Non Prescription\",\"add.new.prescription.add.new.prescription\":\"Add New Prescription\",\"add.new.prescription.save\":\"Save\",\"add.new.prescription.progressive\":\"Progressive (No Line Multi Focal)\",\"progressive.option.customer.service.info\":\"Still unsure which progressive lens is best for you? Chat live with customer support through our Zee chatbot or call\",\"progressive.option.near.range.progressives\":\"near-range Progressives\",\"progressive.option.mid.range.progressives\":\" mid-range Progressives\",\"progressive.option.customer.service.number\":\"(800) 211-2105.\",\"progressive.option.progressive.options\":\"Progressive options\",\"progressive.option.learn.more\":\"Learn More\",\" progressive.option.starting.at\":\"Starting at\",\"progressive.option.premium.price\":\"$$42.90 \",\"progressive.option.standard.price\":\" $27.95\",\"progressive.option.max.distance.approx.3.feet\":\"(Max. distance: approx. 3 feet)\",\"prescription.form.table.Premium\":\"Premium\",\"progressive.option.starting.at\":\"Starting at\",\"progressive.option.premium.progressives.content\":\"Premium progressives offer everything standard progressives do, but with a wider viewing area, quicker adaptation, and maximum comfort.\",\"progressive.option.near.range.progressives.content\":\"Near-Range progressives provide greater comfort and visual clarity within 3 feet. They are designed for those who spend long periods at a desk or other smaller workspaces.\",\"progressive.option.mid.range.progressives.content\":\"Mid-Range progressives feature narrower near-range vision with greater mid-range vision for comfort and visual clarity within 14 feet. They are designed for those who need enhanced up-close vision with the ability to see the entire room more clearly.\",\"progressive.option.premium.progressives\":\"Premium Progressives\",\"progressive.option.standard.progressives.content\":\"Standard progressives were designed to balance distance, near and mid range viewing areas for comfortable, all day wear.\",\"progressive.option.max.distance.approx.14.feet\":\"(Max. distance: approx. 14 feet)\",\"coating.selection.modal.ar.coating.advanced.image\":\"AR_Coating_Advanced_Image\",\"coating.selection.modal.ar.coating.antifog.image\":\"AR_Coating_Antifog_Image\",\"coating.selection.modal.ar.coating.base.image\":\"AR_Coating_Base_Image\",\"coating.selection.modal.ar.coating.standard.image\":\"AR_Coating_Standard_Image\",\"cart.page.title\":\"Shopping Cart\",\"coating.selection.modal.ar.coating.oil.resistant.image\":\"AR_Coating_Oil_Resistant_Image\",\"progressive.option.easiest.zone.adaptation\":\"Easiest zone adaptation\",\"pdp.all.addToFavorites\":\"ADD TO FAVORITES\",\"progressive.option.Premium.image\":\"premium_illo-xs\",\"progressive.option.german.engineered.lens\":\"German-Engineered lens\",\"my.prescription.modal.title\":\"Prescription for item \",\"prescription.type.progressives\":\"Progressives\",\"prescription.type.progressive\":\"Progressive\",\"new.prescription.data.entry.birth.year.content\":\"\u003cp\u003ePlease enter the birth year of the customer associated with this prescription/order. \u003cbr\u003eCustomer's birth year helps us provide age-appropriate lens recommendations.\u003c/p\u003e\",\"prescription.type.prescription.type\":\"Prescription Type\",\"cart.page.section.add-discount.error.invalid-discount-code\":\"Sorry, the promo code you entered is no longer valid.\",\"pupillary.distance.modal.DualPD.title\":\"2 Number PD\",\"pupillary.distance.modal.SinglePD.title\":\"1 Number PD\",\"pupillary.distance.modal.DualPD.content\":\"\u003cp\u003eIf your PD consists of two numbers, also known as \\\"Dual PD\\\", this is the pupillary distance between the centers of each pupil to the bridge of the nose. It is written in the following notation: 32/30. The first number is the right eye, and second is the left eye. Both are less than 40.\u003c/p\u003e\",\"pupillary.distance.modal.SinglePD.content\":\"\u003cp\u003eIf your PD consists of one number, also known as \\\"Single PD\\\", this is the pupillary distance between your pupils. This is typically your distance PD measurement, unless it is noted as a near/reading PD. The distance PD is usually between 40-80mm. You can also calculate near PD, used for reading glasses, by subtracting 3mm from your distance PD.\u003c/p\u003e\\n\u003cp\u003eLearn how to measure, as well as understand the differences between single, dual and near PD by checking out our PD \u003ca target=\\\"_blank\\\" href=\\\"https://www.zennioptical.com/measuring-pd-infographic\\\"\u003einfographic\u003c/a\u003e and \u003ca target=\\\"_blank\\\" href=\\\"https://www.zennioptical.com/c/how-to#howto-measure-pd\\\"\u003eHow-To-Video\u003c/a\u003e.\u003c/p\u003e\",\"pupillary.distance.modal.WhatIsPD.title\":\"What is PD\",\"pupillary.distance.modal.WhatIsPD.content\":\"\u003cp\u003e\u003cb\u003ePupillary Distance (PD)\u003c/b\u003e, the distance between the centers of your pupils, determines where you look through the lens of your glasses. It should be as accurate as possible. The average adult's single PD is between 54-74 mm; kids' are between 43-58 mm. \u003cbr\u003e\u003cbr\u003eLearn how to measure, as well as understand the differences between single, dual and near PD by checking out our PD \u003ca target=\\\"_blank\\\" href=\\\"https://www.zennioptical.com/measuring-pd-infographic\\\"\u003einfographic\u003c/a\u003e and \u003ca target=\\\"_blank\\\" href=\\\"https://www.zennioptical.com/c/how-to#howto-measure-pd\\\"\u003eHow-To-Video\u003c/a\u003e.\u003c/p\u003e\",\"prescription.type.all.day.progressives.learn.more\":\"\u003cp\u003e\u003ca target=\\\"_blank\\\" href=\\\"https://www.zennioptical.com/blog/which-eyeglasses-are-right-for-you/#progressive\\\"\u003eLearn more\u003c/a\u003e\u003c/p\u003e\",\"prescription.type.workspace.progressive.learn.more\":\"\u003cp\u003e\u003ca target=\\\"_blank\\\" href=\\\"https://www.zennioptical.com/blog/which-eyeglasses-are-right-for-you/#workspace-progressive\\\"\u003eLearn more\u003c/a\u003e\u003c/p\u003e\",\"prescription.type.workspace.progressive.text\":\"Workspace progressives are specialized multifocal lenses with two viewing areas: intermediate- and near-vision, and are best suited for home or office-related activities. Zenni offers a near-range option for activities up to 3' of distance and a mid-range option for activities up to 14' of distance.\",\"prescription.type.bifocal.learn.more\":\"\u003cp\u003e\u003ca target=\\\"_blank\\\" href=\\\"https://www.zennioptical.com/blog/which-eyeglasses-are-right-for-you/#bifocals\\\"\u003eLearn more\u003c/a\u003e\u003c/p\u003e\",\"prescription.type.bifocal.text\":\"Bifocal lenses have two viewing areas divided by a visible line: a larger viewing area for distance with a smaller segment for reading. Bifocal lenses have two viewing areas divided by a visible line: a larger viewing area for distance with a smaller segment for reading.\",\"prescription.type.workspace.progressive\":\"WORKSPACE PROGRESSIVES\",\"new.prescription.data.entry.base\":\"Base\",\"prescription.type.single.vision.learn.more\":\"\u003cp\u003e\u003ca target=\\\"_blank\\\" href=\\\"https://www.zennioptical.com/blog/which-eyeglasses-are-right-for-you/#single-vision\\\"\u003eLearn more\u003c/a\u003e\u003c/p\u003e\",\"prescription.type.all.day.progressives.text\":\"All-day progressives are multifocal lenses with three viewing areas: distance-, intermediate-, and near-vision. The power \\\"progressively\\\" changes throughout the lens which means there is no visible line on the lenses.\",\"prescription.type.single.vision.text\":\"Single vision is the most common type of prescription lens. This lens type features a single field of vision, or one prescription power throughout the entire lens, for correcting nearsightedness (myopia) or farsightedness (hyperopia).\",\"prescription.type.all.day.progressives\":\"ALL-DAY PROGRESSIVES\",\"new.prescription.data.entry.base.value.2\":\"BU\",\"new.prescription.data.entry.modal.axis.footer.content\":\"\u003cp\u003e\u003cb\u003eAxis\u003c/b\u003e refers to the angle of the correction for the astigmatism (CYL) in the eye from 1 to 180 degrees. If there is no CYL value then there is no Axis value. The Axis value may be written as 3 digits, which means if your Axis value is 5, it is often written as 005. \u003cbr\u003e\u003ca target=\\\"_blank\\\" href=\\\"https://www.zennioptical.com/how-to-read-my-eye-prescription\\\"\u003eLearn more\u003c/a\u003e\u003c/p\u003e\",\"new.prescription.data.entry.od.os\":\"od / os\",\"save.prescription.modal.content\":\"We will email you a friendly reminder to update your prescription based on your renewal selection. You can edit your renewal reminder anytime under \\\"My Prescriptions\\\" in your Account Settings.\",\"new.prescription.data.entry.base.value.1\":\"BO\",\"new.prescription.data.entry.prism.value.2\":\"2∆\",\"new.prescription.data.entry.prism.value.1\":\"1∆\",\"new.prescription.data.entry.cyl.large.screen\":\"Cyclinder(CYL)\",\"new.prescription.data.entry.modal.sph.footer.content\":\"\u003cp\u003e\u003cb\u003eSPH\u003c/b\u003e = Sphere or Spherical, refers to the main correction in the prescription.  Minus (-) values are for nearsightedness, and Plus (+) values are for farsightedness.   If \\\"PL\\\" or \\\"Plano\\\" is written for this value then you should select 0.00 for this field. \u003cbr\u003e\u003ca target=\\\"_blank\\\" href=\\\"https://www.zennioptical.com/how-to-read-my-eye-prescription\\\"\u003eLearn more\u003c/a\u003e\u003c/p\u003e\",\"new.prescription.data.entry.modal.cyl.footer.content\":\"\u003cp\u003e\u003cb\u003eCYL\u003c/b\u003e = Cylinder, refers to a correction for astigmatism. It can be either positive or negative. A CYL value will always have an Axis value. If \\\"DS\\\" or \\\"SPH\\\" is noted in the CYL space on your prescription, you have no astigmatism in that eye. In that case, enter 0.00 for the CYL and Axis. \u003cbr\u003e\u003ca target=\\\"_blank\\\" href=\\\"https://www.zennioptical.com/how-to-read-my-eye-prescription\\\"\u003eLearn more\u003c/a\u003e\u003c/p\u003e\",\"new.prescription.data.entry.prism\":\"Prism\",\"new.prescription.data.entry.modal.od.os.footer.content\":\"\u003cp\u003e\u003cb\u003eOD\u003c/b\u003e = Oculus Dexter, which refers to the right eye. \u003cbr\u003e\u003cb\u003eOS\u003c/b\u003e = Oculus Sinister, refers to left eye. \u003cbr\u003e\u003ca target=\\\"_blank\\\" href=\\\"https://www.zennioptical.com/how-to-read-my-eye-prescription\\\"\u003eLearn more\u003c/a\u003e\u003c/p\u003e\",\"new.prescription.data.entry.prescription.values\":\"Prescription Values\",\"new.prescription.data.entry.axis.default\":\"0\",\"pupillary.distance.modal.title\":\"Pupillary Distance\",\"new.prescription.data.entry.os\":\"OS\",\"new.prescription.data.entry.sph.large.screen\":\"Sphere(SPH)\",\"lens.details.includes.arCoatingStandard.text\":\"STANDARD\u003cbr/\u003eANTI-REFLECTIVE\u003cbr/\u003eCOATING\",\"lens.details.includes.blueLightProtection.text\":\"BLUE LIGHT\u003cbr/\u003ePROTECTION\",\"lens.details.includes.arCoatingHydro.text\":\"WATER RESISTANT\",\"lens.details.polarity.minus.title\":\"Minus\",\"lens.details.includes.virtuallyClear.text\":\"VIRTUALLY CLEAR\",\"lens.details.includes.mrHighIndex.text\":\"\u003cem\u003eMR™\u003c/em\u003e HIGH INDEX\",\"lens.details.includes.uv8590.text\":\"85% - 90% UV\u003cbr/\u003ePROTECTION\",\"lens.details.includes.antiScratch.text\":\"ANTI-SCRATCH\u003cbr/\u003eRESISTANT COATING\",\"lens.details.includes.superiorOpticalClarity.text\":\"SUPER OPTICAL CLARITY\",\"lens.details.includes.lightweight.text\":\"LIGHTWEIGHT\",\"lens.details.includes.uv100.text\":\"100% UV\u003cbr/\u003ePROTECTION\",\"lens.details.includes.impactResistant.text\":\"IMPACT RESISTANT\",\"lens.details.SportsProtectiveGlasses.Readers.LensStandard.1.50.text\":\"\u003cb\u003e1.50 Basic\u003c/b\u003e lens provides 85%-90% UV protection. For 100% UV protection, please select a higher lens index.\",\"lens.details.SportsProtectiveGlasses.SingleVision.LensStandard.1.53.text\":\"Protective lens package includes the following:\u003cbr/\u003e\u003cbr/\u003e\u003cb\u003e1.53 Trivex® Impact-Resistant\u003c/b\u003e\u003cbr/\u003e1.53 Trivex® Impact-Resistant lenses offer excellent impact resistance. These lenses are recommended for children’s glasses, safety eyewear, and sports eyewear.\u003cbr/\u003e\u003cbr/\u003e\u003cem\u003eTrivex is a registered trademark of PPG Industries Ohio, Inc.\u003c/em\u003e\u003cbr/\u003e\u003cbr/\u003e\u003cb\u003eAdvanced-Super Hydrophobic Anti-Reflective Coating\u003c/b\u003e\u003cbr/\u003eSuper Hydrophobic  (Water Resistant, Easy To Clean)  Anti-Reflective Coating has all the properties of the LensStandard AR coating, plus a water-resistant coating that repels dirt and water, making it easier to clean.\",\"lens.details.SportsProtectiveGlasses.Readers.LensStandard.1.61.text\":\"\u003cb\u003e1.61 High-Index\u003c/b\u003e lenses are up to 20% thinner than 1.50 basic lens. They are made with MR™, a premium lens material.\u003cbr/\u003e\u003cbr/\u003e\u003cem\u003eMR™ is a trademark of Mitsui Chemicals in Japan, a global leading provider of ophthalmic lens materials and technologies.\u003c/em\u003e\",\"lens.details.SportsProtectiveGlasses.SingleVision.LensStandard.1.59.text\":\"Protective lens package includes the following:\u003cbr/\u003e\u003cbr/\u003e\u003cb\u003e1.59 Polycarbonate Impact-Resistant\u003c/b\u003e\u003cbr/\u003e1.59 Polycarbonate Impact-Resistant lenses have the highest impact resistance of all the lenses we carry, making them a great choice for children’s glasses, safety eyewear, and sports eyewear. Made with pure polycarbonate, the softer material reduces breakages but can scratch easier than polymer lenses.\u003cbr/\u003e\u003cbr/\u003e\u003cb\u003eAdvanced-Super Hydrophobic Anti-Reflective Coating\u003c/b\u003e\u003cbr/\u003eSuper Hydrophobic  (Water Resistant, Easy To Clean)  Anti-Reflective Coating has all the properties of the LensStandard AR coating, plus a water-resistant coating that repels dirt and water, making it easier to clean.\",\"lens.details.polarity.plus.alt\":\"Positive Polarity\",\"lens.details.polarity.minus.alt\":\"Negative Polarity\",\"lens.details.SafetyGlasses.SingleVision.LensStandard.1.59.text\":\"Protective lens package includes the following:\u003cbr/\u003e\u003cbr/\u003e\u003cb\u003e1.59 Polycarbonate Impact-Resistant\u003c/b\u003e\u003cbr/\u003e1.59 Polycarbonate Impact-Resistant lenses have the highest impact resistance of all the lenses we carry, making them a great choice for children’s glasses, safety eyewear, and sports eyewear. Made with pure polycarbonate, the softer material reduces breakages but can scratch easier than polymer lenses.\u003cbr/\u003e\u003cbr/\u003e\u003cb\u003eAdvanced-Super Hydrophobic Anti-Reflective Coating\u003c/b\u003e\u003cbr/\u003eSuper Hydrophobic  (Water Resistant, Easy To Clean)  Anti-Reflective Coating has all the properties of the LensStandard AR coating, plus a water-resistant coating that repels dirt and water, making it easier to clean.\",\"lens.details.SafetyGlasses.Progressive.LensStandard.1.53.text\":\"Protective lens package includes the following:\u003cbr/\u003e\u003cbr/\u003e\u003cb\u003e1.53 Trivex® Impact-Resistant\u003c/b\u003e\u003cbr/\u003e1.53 Trivex® Impact-Resistant lenses offer excellent impact resistance. These lenses are recommended for children’s glasses, safety eyewear, and sports eyewear.\u003cbr/\u003e\u003cbr/\u003e\u003cem\u003eTrivex is a registered trademark of PPG Industries Ohio, Inc.\u003c/em\u003e\u003cbr/\u003e\u003cbr/\u003e\u003cb\u003eAdvanced-Super Hydrophobic Anti-Reflective Coating\u003c/b\u003e\u003cbr/\u003eSuper Hydrophobic  (Water Resistant, Easy To Clean)  Anti-Reflective Coating has all the properties of the LensStandard AR coating, plus a water-resistant coating that repels dirt and water, making it easier to clean.\",\"lens.details.SafetyGlasses.Progressive.LensStandard.1.59.text\":\"Protective lens package includes the following:\u003cbr/\u003e\u003cbr/\u003e\u003cb\u003e1.59 Polycarbonate Impact-Resistant\u003c/b\u003e\u003cbr/\u003e1.59 Polycarbonate Impact-Resistant lenses have the highest impact resistance of all the lenses we carry, making them a great choice for children’s glasses, safety eyewear, and sports eyewear. Made with pure polycarbonate, the softer material reduces breakages but can scratch easier than polymer lenses.\u003cbr/\u003e\u003cbr/\u003e\u003cb\u003eAdvanced-Super Hydrophobic Anti-Reflective Coating\u003c/b\u003e\u003cbr/\u003eSuper Hydrophobic  (Water Resistant, Easy To Clean)  Anti-Reflective Coating has all the properties of the LensStandard AR coating, plus a water-resistant coating that repels dirt and water, making it easier to clean.\",\"lens.details.SafetyGlasses.SingleVision.LensStandard.1.53.text\":\"Protective lens package includes the following:\u003cbr/\u003e\u003cbr/\u003e\u003cb\u003e1.53 Trivex® Impact-Resistant\u003c/b\u003e\u003cbr/\u003e1.53 Trivex® Impact-Resistant lenses offer excellent impact resistance. These lenses are recommended for children’s glasses, safety eyewear, and sports eyewear.\u003cbr/\u003e\u003cbr/\u003e\u003cem\u003eTrivex is a registered trademark of PPG Industries Ohio, Inc.\u003c/em\u003e\u003cbr/\u003e\u003cbr/\u003e\u003cb\u003eAdvanced-Super Hydrophobic Anti-Reflective Coating\u003c/b\u003e\u003cbr/\u003eSuper Hydrophobic  (Water Resistant, Easy To Clean)  Anti-Reflective Coating has all the properties of the LensStandard AR coating, plus a water-resistant coating that repels dirt and water, making it easier to clean.\",\"lens.details.SafetyGlasses.Readers.LensStandard.1.61.text\":\"\u003cb\u003e1.61 High-Index\u003c/b\u003e lenses are up to 20% thinner than 1.50 basic lens. They are made with MR™, a premium lens material.\u003cbr/\u003e\u003cbr/\u003e\u003cem\u003eMR™ is a trademark of Mitsui Chemicals in Japan, a global leading provider of ophthalmic lens materials and technologies.\u003c/em\u003e\",\"lens.details.SafetyGlasses.Readers.LensStandard.1.50.text\":\"\u003cb\u003e1.50 Basic\u003c/b\u003e lens provides 85%-90% UV protection. For 100% UV protection, please select a higher lens index.\",\"err.rx.type.safetyprogressive.strong.sph.or.cyl\":\"The SPH or CYL numbers are too strong for the selected prescription type.\",\"err.rx.type.bifocal.strong.sph.or.cyl\":\"The SPH or CYL numbers are too strong for the selected prescription type.\",\"err.rx.type.progressive.nearrange.strong.sph.or.cyl\":\"The SPH or CYL numbers are too strong for the selected prescription type.\",\"err.rx.type.progressive.midrage.strong.sph.or.cyl\":\"The SPH or CYL numbers are too strong for the selected prescription type.\",\"err.rx.type.singlevision.strong.sph.or.cyl\":\"The SPH or CYL numbers are too strong for the selected prescription type.\",\"err.rx.type.progressive.standard.premium.strong.sph.or.cyl\":\"The SPH or CYL numbers are too strong for the selected prescription type.\",\"err.frame.rimless.lens.width.54to55\":\"\u003cp\u003eFor your prescription, please select a lens from 54mm to 55mm wide. To find the lens width \u003cspan class='font-large'\u003e(\u003cspan class='color-primary'\u003eW\u003c/span\u003e)\u003c/span\u003e, see the example below.\u003c/p\u003e \u003cdiv class='div-view-lens center-block'\u003e\u003cimg class='img-responsive' src='/dev/image/site/page-order/rimless-lens-extra-width.png' alt=''\u003e\u003c/div\u003e\",\"err.frame.rimless.lens.width.52to53\":\"\u003cp\u003eFor your prescription, please select a lens from 52mm to 53mm wide. To find the lens width \u003cspan class='font-large'\u003e(\u003cspan class='color-primary'\u003eW\u003c/span\u003e)\u003c/span\u003e, see the example below.\u003c/p\u003e \u003cdiv class='div-view-lens center-block'\u003e\u003cimg class='img-responsive' src='/dev/image/site/page-order/rimless-lens-extra-width.png' alt=''\u003e\u003c/div\u003e\",\"err.frame.halfrim.rx.strong\":\"Your prescription is too strong for this frame. Please select a full-rim frame.\",\"err.frame.halfrim.mismatch.sph.or.cyl\":\"SPH or CYL doesn't match selected frame shape.\",\"err.frame.rimless.lens.width.46to55\":\"Your prescription is too strong for this frame. Please select a full-rim or half-rim frame.\",\"err.frame.rimless.lens.width.46to51\":\"\u003cp\u003eFor your prescription, please select a lens from 46mm to 51mm wide. To find the lens width \u003cspan class='font-large'\u003e(\u003cspan class='color-primary'\u003eW\u003c/span\u003e)\u003c/span\u003e, see the example below.\u003c/p\u003e \u003cdiv class='div-view-lens center-block'\u003e\u003cimg class='img-responsive' src='/dev/image/site/page-order/rimless-lens-extra-width.png' alt=''\u003e\u003c/div\u003e\",\"err.frame.sunshade.mismatch.sph.or.cyl\":\"SPH or CYL doesn't match selected frame shape.\",\"payment.option.paypal.summary.discounts\":\"Discounts\",\"err.frame.fullrim.mismatch.sph.or.cyl\":\"SPH or CYL doesn't match selected frame shape.\",\"err.frame.goggles.mismatch.sph.or.cyl\":\"SPH or CYL doesn't match selected frame shape.\",\"lens.details.modal.title\":\"How to Choose a Lens Index\",\"lens.details.modal.polarized.title\":\"How to Choose a Polarized Lens Index\",\"error.na.prism.plano\":\"Prism cannot be done for Plano.\",\"error.direction.prism.missing\":\"A base direction was selected without a prism value. Please check your prism entry.\",\"lens.details.modal.photochromic.title\":\"How to Choose a Photochromic Lens Index\",\"err.rx.frame.minpd.unsuitable\":\"The combination of your prescription and PD value is not suitable for this product.  Please select another product that supports a wider range of PD values.\",\"error.rx.frame.mismatch.alt.frame\":\"Unfortunately your prescription cannot be accommodated in these frames. Please select a different frame.\",\"error.na.bifocal.progressive.pd.diff\":\"Bifocal \u0026 Progressive are not available when PD \u003c 50 or lower PD * 2 \u003c 50.\",\" error.rx.too.strong\":\"Your prescription is too strong for this frame. Please select a different frame.\",\"error.sph.frame.incompatible\":\"Your SPH is not suitable for this frame.\",\"error.prism.direction.pair\":\"Both Prism Value and Base Direction must have an entry or both must be 0.\",\"error.prism.direction.missing\":\"A prism value was selected without a base direction. Please check your prism entry.\",\"error.pd.diff.five\":\"Sorry, we cannot make lenses when the difference between PD values is over 5mm.\",\"lens.details.tab.lens.color.title\":\"Lens Color\",\"warn.check.sph\":\"Please make sure your SPH is correct.\",\"lens.details.tab.lens.index.title\":\"Lens Index\",\"error.cyl.frame.incompatible\":\"the CYL is not compatible with the frame.\",\"error.pd.diff.three.bifocal.progressive\":\"The difference in PD values cannot be greater than 3mm when used with progressive or bifocal lenses.\",\"warn.check.sph.cyl\":\"Please make sure your SPH and CYL are correct.\\n\",\"warn.lens.thick.lt.fifty\":\"When SPH \u003c -10.00 and lens width \u003e 50mm, system will pop up the prompt to suggest to use frame whose lens LESS THAN 50\",\"warn.rx.bipolar\":\"You have entered both positive (+) and negative (-) SPH values which is highly unusual. If your entry is correct please continue. Otherwise edit your prescription.\",\"error.odcyl.oscyl.same.polarity\":\"OD CYL and OS CYL values must either be both positive or both negative.\",\"product.lable.outOfStock\":\"OUT OF STOCK\",\"warn.lens.thick.alt.fullrim\":\"Your lenses may be thick in this frame. We suggest you choose a full-rim frame with a lens width of 50mm or less.\",\"lens.details.blokz.logo.caption\":\"Blue light blocking lenses\",\"lens.details.blokz.logo.alt\":\"Blokz Logo\",\"lens.details.recommended\":\"Recommended\",\"cart.page.safety.warning.modal.title.warn\":\"WARNING\",\"cart.page.safety.warning.modal.title.congrats\":\"CONGRATULATIONS\",\"cart.page.safety.warning.modal.body.congrats.sku.A110402124\":\"You are receiving a FREE blue light laser pointer to see how your Blokz glasses block blue light. To enjoy this gift, please \\\"CONTINUE\\\" or \\\"REMOVE\\\" to remove this item from your cart.\",\"cart.page.safety.warning.modal.footer.btn.remove\":\"REMOVE\",\"checkout.footer.addpaymenttype\":\"Add Payment Type\",\"cart.page.safety.warning.modal.footer.btn.continue\":\"CONTINUE\",\"payment.walletoptions.cancel\":\"Cancel\",\"checkout.save.payment.success\":\"Success! Your Payment Method has been added.\",\"cart.page.safety.warning.modal.sku.A110402124.msg\":\"For your safety: Do not aim at the laser beam into the eye or look into the aperture of the pointer. This is not a toy. Keep out of reach of children.\",\"payment.walletoptions.mywallet\":\"My Wallet\",\"lens.details.polarity.plus.title\":\"Plus\",\"lens.details.whats.Included.title\":\"What's Included\",\"payment.walletoptions.addnew\":\"Add New\",\"lens.details.otherFrames.Progressive.LensStandard.1.74.text\":\"\u003cb\u003e1.74 High-Index Progressive\u003c/b\u003e lenses are up to 40% thinner than 1.50 basic lens. They are made with MR™, a premium lens material. \u003cbr/\u003e\u003cbr/\u003e\u003cem\u003eMR™ is a trademark of Mitsui Chemicals in Japan, a global leading provider of ophthalmic lens materials and technologies.\u003c/em\u003e\",\"lens.details.otherFrames.Progressive.LensStandard.1.67.text\":\"\u003cb\u003e1.67 High-Index Progressive\u003c/b\u003e lenses are up to 30% thinner than 1.50 basic lens. They are made with MR™, a premium lens material. \u003cbr/\u003e\u003cbr/\u003e\u003cem\u003eMR™ is a trademark of Mitsui Chemicals in Japan, a global leading provider of ophthalmic lens materials and technologies.\u003c/em\u003e\",\"lens.details.otherFrames.Progressive.Polarized.1.50.text\":\"\u003cb\u003e1.50 Basic Polarized Progressive\u003c/b\u003e lenses contain full UV protection.\",\"lens.details.otherFrames.Progressive.LensStandard.1.61.text\":\"\u003cb\u003e1.61 High-Index Progressive\u003c/b\u003e lenses are up to 20% thinner than 1.50 basic lens. They are made with MR™, a premium lens material. \u003cbr/\u003e\u003cbr/\u003eMR™ is a trademark of Mitsui Chemicals in Japan, a global leading provider of ophthalmic lens materials and technologies.\u003cem/\u003e\",\"lens.details.otherFrames.Progressive.Polarized.1.59.text\":\"\u003cb\u003e1.59 Polarized Polycarbonate Impact-Resistant Progressive\u003c/b\u003e lenses are made with pure polycarbonate. They’re an excellent choice for rimless styles and sports enthusiasts.\",\"lens.details.otherFrames.Progressive.Polarized.1.61.text\":\"\u003cb\u003e1.61 Polarized High-Index Progressive\u003c/b\u003e lenses are up to 20% thinner than 1.50 basic lens. They are made with MR™, a premium lens material.\u003cbr/\u003e\u003cbr/\u003e\u003cem\u003eMR™ is a trademark of Mitsui Chemicals in Japan, a global leading provider of ophthalmic lens materials and technologies.\u003c/em\u003e\",\"lens.details.otherFrames.Progressive.LensStandard.1.53.text\":\"\u003cb\u003e1.53 Trivex® Impact-Resistant\u003c/b\u003e lenses are slightly thinner than 1.50 basic lens. Due to its excellent impact resistance, these lenses are recommended for children’s glasses, rimless glasses, sports and safety eyewear.\u003cbr/\u003e\u003cbr/\u003e\u003cem\u003eTrivex is a registered trademark of PPG Industries Ohio, Inc.\u003c/em\u003e\",\"lens.details.otherFrames.SingleVision.Photochromic.1.61.text\":\"\u003cb\u003e1.61 Photochromic High-Index\u003c/b\u003e lenses are up to 20% thinner than 1.50 Photochromic lens. They are made with MR™, a premium lens material.\u003cbr/\u003e\u003cbr/\u003e\u003cem\u003eMR™ is a trademark of Mitsui Chemicals in Japan, a global leading provider of ophthalmic lens materials and technologies.\u003c/em\u003e\",\"lens.details.otherFrames.SingleVision.Photochromic.1.67.text\":\"\u003cb\u003e1.67 Photochromic Transitions® High-Index Signature™ VII\u003c/b\u003e lenses are clear indoors and darken automatically in bright sunlight. These lenses are up to 30% thinner than 1.50 Photochromic lens. Lenses and are made with MR™, a premium lens material.\u003cbr/\u003e\u003cbr/\u003e\u003cem\u003eMR™ is a trademark of Mitsui Chemicals in Japan, a global leading provider of ophthalmic lens materials and technologies.\u003c/em\u003e\",\"lens.details.otherFrames.Progressive.LensStandard.1.59.text\":\"\u003cb\u003e1.59 Polycarbonate Impact-Resistant Progressive\u003c/b\u003e lenses have the highest impact resistance of all the lenses we carry, making them a great choice for rimless glasses and sports eyewear. Made with pure polycarbonate, the softer material reduces breakages but can scratch easier than polymer lenses.\",\"lens.details.otherFrames.Progressive.LensStandard.1.50.text\":\"\u003cb\u003e1.50 Basic Progressive\u003c/b\u003e lens provides 85%-90% UV protection. For 100% UV protection, please select a higher lens index.\",\"lens.details.otherFrames.Progressive.LensStandard.1.57.text\":\"\u003cb\u003e1.57 Basic Progressive\u003c/b\u003e lenses are up to 15% thinner than 1.50 basic lens.\",\"lens.details.otherFrames.SingleVision.Photochromic.1.50.text\":\"\u003cb\u003e1.50 Photochromic Transitions® Signature™ VII\u003c/b\u003e lenses are clear indoors and darken automatically in sunlight.\",\"lens.details.otherFrames.SingleVision.Polarized.1.67.text\":\"\u003cb\u003e1.67 Polarized High-Index\u003c/b\u003e lenses are up to 30% thinner than 1.50 basic lens. They are made with MR™, a premium lens material.\u003cbr/\u003e\u003cbr/\u003e\u003cem\u003eMR™ is a trademark of Mitsui Chemicals in Japan, a global leading provider of ophthalmic lens materials and technologies.\u003c/em\u003e\",\"lens.details.otherFrames.SingleVision.Photochromic.1.59.text\":\"\u003cb\u003e1.59 Photochromic Polycarbonate Impact-Resistant\u003c/b\u003e lenses are clear indoors and darken automatically in bright sunlight. These lenses are made with impact resistant pure polycarbonate, so they’re an excellent choice for rimless glasses, sports enthusiasts, and children.\",\"lens.details.otherFrames.SingleVision.Polarized.1.59.text\":\"\u003cb\u003e1.59 Polarized Polycarbonate Impact-Resistant\u003c/b\u003e lenses are made with pure polycarbonate. They’re an excellent choice for rimless styles, sports enthusiasts, and children.\",\"lens.details.otherFrames.SingleVision.Polarized.1.50.text\":\"\u003cb\u003e1.50 Basic Polarized\u003c/b\u003e lenses contain full UV protection.\",\"lens.details.otherFrames.SingleVision.Polarized.1.61.text\":\"\u003cb\u003e1.61 Polarized High-Index\u003c/b\u003e lenses are up to 20% thinner than 1.50 basic lens. They are made with MR™, a premium lens material.\u003cbr/\u003e\u003cbr/\u003e\u003cem\u003eMR™ is a trademark of Mitsui Chemicals in Japan, a global leading provider of ophthalmic lens materials and technologies.\u003c/em\u003e\",\"lens.details.otherFrames.SingleVision.LensStandard.1.61.text\":\"\u003cb\u003e1.61 High-Index\u003c/b\u003e lenses are up to 20% thinner than 1.50 basic lens. They are made with MR™, a premium lens material.\u003cbr/\u003e\u003cbr/\u003e\u003cem\u003eMR™ is a trademark of Mitsui Chemicals in Japan, a global leading provider of ophthalmic lens materials and technologies.\u003c/em\u003e\",\"lens.details.otherFrames.SingleVision.LensStandard.1.59.text\":\"\u003cb\u003e1.59 Polycarbonate Impact-Resistant\u003c/b\u003e lenses have the highest impact resistance of all the lenses we carry, making them a great choice for rimless glasses, sports eyewear, and children’s glasses. Made with pure polycarbonate, the softer material reduces breakages but can scratch easier than polymer lenses.\",\"lens.details.otherFrames.SingleVision.LensStandard.1.53.text\":\"\u003cb\u003e1.53 Trivex® Impact-Resistant\u003c/b\u003e lenses are slightly thinner than 1.50 basic lens. Due to its excellent impact resistance, these lenses are recommended for children’s glasses, rimless glasses, sports and safety eyewear.\u003cbr/\u003e\u003cbr/\u003e\u003cem\u003eTrivex is a registered trademark of PPG Industries Ohio, Inc.\u003c/em\u003e\",\"lens.details.otherFrames.SingleVision.LensStandard.1.74.text\":\"\u003cb\u003e1.74 High-Index\u003c/b\u003e lenses are up to 40% thinner than 1.50 basic lens. They are made with MR™, a premium lens material.\u003cbr/\u003e\u003cbr/\u003e\u003cem\u003eMR™ is a trademark of Mitsui Chemicals in Japan, a global leading provider of ophthalmic lens materials and technologies.\u003c/em\u003e\",\"lens.details.otherFrames.SingleVision.LensStandard.1.67.text\":\"\u003cb\u003e1.67 High-Index\u003c/b\u003e lenses are up to 30% thinner than 1.50 basic lens. They are made with MR™, a premium lens material.\u003cbr/\u003e\u003cbr/\u003e\u003cem\u003eMR™ is a trademark of Mitsui Chemicals in Japan, a global leading provider of ophthalmic lens materials and technologies.\u003c/em\u003e\",\"lens.details.otherFrames.SingleVision.LensStandard.1.57.text\":\"\u003cb\u003e1.57 Basic\u003c/b\u003e lenses are up to 15% thinner than 1.50 basic lens.\",\"lens.details.lens.color.title\":\"Sunglasses\",\"lens.details.BlueBlockLensPhotochromic.tint.description\":\"Blokz Photochromic lenses are virtually clear indoors and darken to gray outdoors, providing all-in-one glasses and sunglasses that protect your eyes from UV and blue light. It includes blue light protection beyond UV400nm to 415nm.\",\"lens.details.Photochromic.tint.description\":\"Photochromic lenses are clear indoors and darken automatically in sunlight, for convenient, two-in-one glasses and sunglasses. \u003cem\u003ePlease note: photochromic lenses will not darken in a car due to UV-blocking windshields/windows. Also, lenses may develop a slight base tint after long-term use.\u003c/em\u003e\",\"lens.details.otherFrames.SingleVision.LensStandard.1.50.text\":\"\u003cb\u003e1.50 Basic\u003c/b\u003e lens provides 85%-90% UV protection. For 100% UV protection, please select a higher lens index.\",\"lens.details.range.title\":\"Recommend RX Range\",\"lens.details.Polarized.tint.description\":\"Polarized lenses fight glare, boost contrast, and improve clarity. They are an excellent choice for driving and outdoor activities—especially water and snow sports\",\"lens.details.SportsProtectiveGlasses.NonPrescription.LensStandard.1.59.text\":\"Protective lens package includes the following:\u003cbr/\u003e\u003cbr/\u003e\u003cb\u003e1.59 Polycarbonate Impact-Resistant\u003c/b\u003e\u003cbr/\u003e1.59 Polycarbonate Impact-Resistant lenses have the highest impact resistance of all the lenses we carry, making them a great choice for children’s glasses, safety eyewear, and sports eyewear. Made with pure polycarbonate, the softer material reduces breakages but can scratch easier than polymer lenses.\u003cbr/\u003e\u003cbr/\u003e\u003cb\u003eAdvanced-Super Hydrophobic Anti-Reflective Coating\u003c/b\u003e\u003cbr/\u003eSuper Hydrophobic  (Water Resistant, Easy To Clean)  Anti-Reflective Coating has all the properties of the LensStandard AR coating, plus a water-resistant coating that repels dirt and water, making it easier to clean.\",\"lens.details.SafetyGlasses.NonPrescription.LensStandard.1.53.text\":\"Protective lens package includes the following:\u003cbr/\u003e\u003cbr/\u003e\u003cb\u003e1.53 Trivex® Impact-Resistant\u003c/b\u003e\u003cbr/\u003e1.53 Trivex® Impact-Resistant lenses offer excellent impact resistance. These lenses are recommended for children’s glasses, safety eyewear, and sports eyewear.\u003cbr/\u003e\u003cbr/\u003e\u003cem\u003eTrivex is a registered trademark of PPG Industries Ohio, Inc.\u003c/em\u003e\u003cbr/\u003e\u003cbr/\u003e\u003cb\u003eAdvanced-Super Hydrophobic Anti-Reflective Coating\u003c/b\u003e\u003cbr/\u003eSuper Hydrophobic  (Water Resistant, Easy To Clean)  Anti-Reflective Coating has all the properties of the LensStandard AR coating, plus a water-resistant coating that repels dirt and water, making it easier to clean.\",\"lens.details.SportsProtectiveGlasses.NonPrescription.LensStandard.1.53.text\":\"Protective lens package includes the following:\u003cbr/\u003e\u003cbr/\u003e\u003cb\u003e1.53 Trivex® Impact-Resistant\u003c/b\u003e\u003cbr/\u003e1.53 Trivex® Impact-Resistant lenses offer excellent impact resistance. These lenses are recommended for children’s glasses, safety eyewear, and sports eyewear.\u003cbr/\u003e\u003cbr/\u003e\u003cem\u003eTrivex is a registered trademark of PPG Industries Ohio, Inc.\u003c/em\u003e\u003cbr/\u003e\u003cbr/\u003e\u003cb\u003eAdvanced-Super Hydrophobic Anti-Reflective Coating\u003c/b\u003e\u003cbr/\u003eSuper Hydrophobic  (Water Resistant, Easy To Clean)  Anti-Reflective Coating has all the properties of the LensStandard AR coating, plus a water-resistant coating that repels dirt and water, making it easier to clean.\",\"lens.details.SafetyGlasses.NonPrescription.LensStandard.1.59.text\":\"Protective lens package includes the following:\u003cbr/\u003e\u003cbr/\u003e\u003cb\u003e1.59 Polycarbonate Impact-Resistant\u003c/b\u003e\u003cbr/\u003e1.59 Polycarbonate Impact-Resistant lenses have the highest impact resistance of all the lenses we carry, making them a great choice for children’s glasses, safety eyewear, and sports eyewear. Made with pure polycarbonate, the softer material reduces breakages but can scratch easier than polymer lenses.\u003cbr/\u003e\u003cbr/\u003e\u003cb\u003eAdvanced-Super Hydrophobic Anti-Reflective Coating\u003c/b\u003e\u003cbr/\u003eSuper Hydrophobic  (Water Resistant, Easy To Clean)  Anti-Reflective Coating has all the properties of the LensStandard AR coating, plus a water-resistant coating that repels dirt and water, making it easier to clean.\",\"error.odsph.odsph.diff.large\":\"The difference between OD and OS for CYL is unusually large, please confirm your prescription. If the prescription is correct, please choose single vision to achieve a better experience.\",\"error.odcyl.odcyl.diff.large\":\"The differences between OD and OS for SPH and CYL are unusually large, please confirm your prescription. If the prescription is correct, please choose single vision to achieve a better experience.\",\"error.lensshape.rxtype.mistmatch\":\"This lens shape does not support this prescription type.\",\"error.frame.bifocal.progressive.alt.lens.thirty\":\"This frame can't support Bifocal/Progressive prescription type. Please select a frame with lens height greater than 30mm.\",\"error.od.os.diff.large\":\"The difference between OD and OS for SPH is unusually large, please confirm your prescription. If the prescription is correct, please choose single vision to achieve a better experience.\",\"err.rx.frame.minpd3.unsuitable\":\"The combination of your prescription and PD value is not suitable for this product.  Please select another product that supports a wider range of PD values.\",\"checkout.terms.\u0026.conditions.label\":\"By placing your order, you agree to Zenni Opticals\",\"lens.details.otherFrames.SingleVision.BlueBlockLensPhotochromic.1.74.text\":\"\u003cb\u003e1.74 High-Index\u003c/b\u003e virtually clear lenses are up to 40% thinner than 1.50 basic lens. Made with MR™, a premium lens material, these lenses help protect the eyes from harmful UV and blue light.\u003cbr/\u003e\u003cbr/\u003e\u003cem\u003eMR™ is a trademark of Mitsui Chemicals in Japan, a global leading provider of ophthalmic lens materials and technologies.\u003c/em\u003e\",\"pdp.egcDetailsValue\":\"$3e\",\"lens.details.otherFrames.Progressive.BlueBlockLensPhotochromic.1.74.text\":\"\u003cb\u003e1.74 High-Index\u003c/b\u003e virtually clear lenses are up to 40% thinner than 1.50 basic lens. Made with MR™, a premium lens material, these lenses help protect the eyes from harmful UV and blue light.\u003cbr/\u003e\u003cbr/\u003e\u003cem\u003eMR™ is a trademark of Mitsui Chemicals in Japan, a global leading provider of ophthalmic lens materials and technologies.\u003c/em\u003e\",\"checkout.terms.\u0026.conditions.ok.button\":\"Ok\",\"prescription.confirmation.are.you.sure\":\"ARE YOU SURE ? \",\"payment.creditcard.myWallet.close\":\"Close\",\"checkout.terms.\u0026.conditions.link\":\"terms and conditions\",\"checkout.terms.\u0026.conditions\":\"$3f\",\"payment.creditcard.myWallet.usepaymenttype\":\"Use Selected Payment Type\",\"payment.creditcard.myWallet.addNewPaymentType\":\"Add a new payment type\",\"checkout.terms.\u0026.conditions.modal.title\":\"Terms \u0026 Conditions\",\"payment.creditcard.expiration.label\":\"Expiration Date:\",\"shipping.modal.restrictions.footer.btn.update.address\":\"Update Shipping Address\",\"shipping.modal.restrictions.body.after.countries\":\"Please update your shipping address or remove the products from your cart.\",\"shipping.modal.restrictions.body.before.countries\":\"Sorry, we are currently unable to ship following products outside of the\",\"payment.creditcard.number.mask\":\"**** **** **** \",\"payment.creditcard.cardHolderName.label\":\"Name:\",\"clipons.subtitle\":\"To order a custom clip-on for an existing frame, or a replacement clip-on for a set, enter the frame number here.\",\"lens.details.otherFrames.NonPrescription.Photochromic.1.59.text\":\"\u003cb\u003e1.59 Photochromic Polycarbonate Impact-Resistant\u003c/b\u003e lenses are clear indoors and darken automatically in bright sunlight. These lenses are made with impact-resistant pure polycarbonate, so they’re an excellent choice for rimless glasses, sports enthusiasts, and children.\",\"lens.details.otherFrames.NonPrescription.Photochromic.1.61.text\":\"\u003cb\u003e1.61 Photochromic High-Index\u003c/b\u003e lenses are made with MR™, a premium lens material.\u003cbr/\u003e\u003cbr/\u003e\u003cem\u003eMR™ is a trademark of Mitsui Chemicals in Japan, a global leading provider of ophthalmic lens materials and technologies.\u003c/em\u003e\",\"shipping.modal.restrictions.footer.btn.remove.item\":\"Remove Restricted Items\",\"shipping.modal.restrictions.title\":\"WARNING\",\"lens.details.otherFrames.NonPrescription.Photochromic.1.50.text\":\"\u003cb\u003e1.50 Photochromic Transitions® Signature™ VII\u003c/b\u003e lenses are clear indoors and darken automatically in sunlight.\",\"lens.details.otherFrames.Readers.LensStandard.1.61.text\":\"\u003cb\u003e1.61 High-Index\u003c/b\u003e lenses are up to 20% thinner than 1.50 basic lens. They are made with MR™, a premium lens material.\u003cbr/\u003e\u003cbr/\u003e\u003cem\u003eMR™ is a trademark of Mitsui Chemicals in Japan, a global leading provider of ophthalmic lens materials and technologies.\u003c/em\u003e\",\"lens.details.otherFrames.NonPrescription.Polarized.1.50.text\":\"\u003cb\u003e1.50 Basic Polarized\u003c/b\u003e lenses contain full UV protection.\",\"lens.details.otherFrames.NonPrescription.LensStandard.1.50.text\":\"\u003cb\u003e1.50 Basic\u003c/b\u003e lenses provides 85%-90% UV protection. For 100% UV protection, please select a higher lens index.\",\"lens.details.otherFrames.NonPrescription.Polarized.1.59.text\":\"\u003cb\u003e1.59 Polarized Polycarbonate Impact Resistance\u003c/b\u003e lenses are made with pure polycarbonate. They’re an excellent choice for rimless styles, sports enthusiasts, and children.\",\"lens.details.otherFrames.NonPrescription.LensStandard.1.53.text\":\"\u003cb\u003e1.53 Trivex® Impact-Resistant\u003c/b\u003e lenses offer excellent impact resistance. These lenses are recommended for children’s glasses, rimless glasses, sports and safety eyewear. These lenses cannot be tinted.\u003cbr /\u003e\u003cbr /\u003e\u003cem\u003eTrivex is a registered trademark of PPG Industries Ohio, Inc.\u003c/em\u003e\",\"lens.details.otherFrames.NonPrescription.LensStandard.1.59.text\":\"\u003cb\u003e1.59 Polycarbonate impact-resistant\u003c/b\u003e lenses have the highest impact resistance of all the lenses we carry, making them a great choice for rimless glasses, sports eyewear, and children’s glasses. Made with pure polycarbonate, the softer material reduces breakages but can scratch easier than the polymer lenses.\",\"lens.details.otherFrames.Bifocal.LensStandard.1.61.text\":\"\u003cb\u003e1.61 High-Index Bifocal\u003c/b\u003e lenses contain 100% UV protection. Made with MR™, a premium lens material.\u003cbr/\u003e\u003cbr/\u003e\u003cem\u003eMR™ is a trademark of Mitsui Chemicals in Japan, a global leading provider of ophthalmic lens materials and technologies.\u003c/em\u003e\",\"lens.details.otherFrames.Readers.LensStandard.1.50.text\":\"\u003cb\u003e1.50 Basic\u003c/b\u003e lens provides 85%-90% UV protection. For 100% UV protection, please select a higher lens index.\",\"lens.details.otherFrames.Bifocal.LensStandard.1.50.text\":\"\u003cb\u003e1.50 Basic Bifocal\u003c/b\u003e lenses provides 85%-90% UV protection. For 100% UV protection, please select 1.61 high-index lens.\",\"lens.details.otherFrames.Progressive.Photochromic.1.67.text\":\"\u003cb\u003e1.67 Photochromic Transitions® Signature™ VII Progressive\u003c/b\u003e lenses are clear indoors and darken automatically in bright sunlight. These lenses are up to 30% thinner than 1.50 Photochromic lens. Lenses and are made with MR™, a premium lens material.\u003cbr/\u003e\u003cbr/\u003e\u003cem\u003eMR™ is a trademark of Mitsui Chemicals in Japan, a global leading provider of ophthalmic lens materials and technologies.\u003c/em\u003e\",\"lens.details.otherFrames.Bifocal.Photochromic.1.57.text\":\"\u003cb\u003e1.57 Photochromic Bifocal\u003c/b\u003e Gray UV-reactive bifocal lenses are clear indoors and  darken to gray in sunlight.\",\"lens.details.otherFrames.Bifocal.Polarized.1.50.text\":\"\u003cb\u003e1.50 Polarized Bifocal\u003c/b\u003e Gray lenses contain full UV protection.\",\"lens.details.otherFrames.Progressive.Photochromic.1.59.text\":\"\u003cb\u003e1.59 Photochromic Polycarbonate Impact-Resistant Progressive\u003c/b\u003e lenses are clear indoors and darken automatically in bright sunlight. These lenses are made with impact resistant pure polycarbonate, so they’re an excellent choice for rimless glasses and sports enthusiasts.\",\"lens.details.otherFrames.Progressive.Photochromic.1.61.text\":\"\u003cb\u003e1.61 Photochromic UV-reactive High-Index Progressive\u003c/b\u003e lenses are up to 20% thinner than 1.50 Photochromic lens. They are made with MR™, a premium lens material.\u003cbr/\u003e\u003cbr/\u003e\u003cem\u003eMR™ is a trademark of Mitsui Chemicals in Japan, a global leading provider of ophthalmic lens materials and technologies.\u003c/em\u003e\",\"lens.details.otherFrames.Progressive.Polarized.1.67.text\":\"\u003cb\u003e1.67 Polarized High-Index Progressive\u003c/b\u003e lenses are up to 30% thinner than 1.50 basic lens. They are made with MR™, a premium lens material.\u003cbr/\u003e\u003cbr/\u003e\u003cem\u003eMR™ is a trademark of Mitsui Chemicals in Japan, a global leading provider of ophthalmic lens materials and technologies.\u003c/em\u003e\",\"lens.details.otherFrames.Progressive.Photochromic.1.50.text\":\"\u003cb\u003e1.50 Photochromic Transitions® Signature™ VII Progressive\u003c/b\u003e lenses are clear indoors and darken automatically in sunlight.\",\"myAccount.myTryOn.defaultTryOn\":\"Default 'TryOn'\",\"summary.checkout.product.eyeglasses.prism.charges\":\"Prism charges:\",\"warn.check.cyl.oscyl.2x.odcyl\":\"Please make sure your CYL is correct.\",\"warn.check.cyl.div.2.5\":\"Please make sure your CYL is correct.\",\"pdp.clipon.updateCart\":\"UPDATE CART\",\"warn.check.cyl.odcyl.2x.oscyl\":\"Please make sure your CYL is correct.\",\"myAccount.myTryOn.delete\":\"Delete\\n\",\"myAccount.myTryOn.myTryOnTitle\":\"MY 'TRY ON'\\n\",\"myAccount.myTryOn.makeDefault\":\"Make Default\\n\",\"myAccount.myTryOn.virtualTryOn\":\"Virtual TryOn\\n \",\"myAccount.myTryOn.createTryOn\":\"CREATE NEW VIRTUAL TRY ON\\n\",\"my.orders.frame.oos.message\":\"This color is currently out of stock but don't worry, your order will not be affected.\",\"cart.page.errors.removed-line-item.discontinued\":\"has been discontinued.\",\"sign.in.sign.up\":\"Sign Up\",\"cart.page.errors.removed-line-item.oos\":\"is out of stock.\",\"pdp.standard.beTheFirstToWriteAReview\":\"Be the first to write a review\",\"cart.page.errors.removed-line-item.exclamation\":\"OOPS!\",\"payment.paymentoption.cvv.popover.content\":\"\u003cp\u003e\\n  \u003cdiv\u003e\\n    \u003cstrong\u003eCVV - Card verification value:\u003c/strong\u003e\\n  \u003c/div\u003e\\n\u003c/p\u003e\\n\u003cp\u003e\\n  \u003cdiv\u003e\\n    \u003cimg class=\\\"w-100 p-3\\\" src=\\\"https://static.zennioptical.com/dev/image/common/tip_checkout_cvv2.jpg\\\"\u003e\\n  \u003c/div\u003e\\n\u003c/p\u003e\",\"prism.product\":\"Prism Product\",\"my.prescription.renewal.modal.content\":\"Next Renewal Reminder Date\",\"my.prescription.renewal.modal.cancel.button\":\"Cancel\",\"prism.additional.price.sku\":\"sku170303\",\"warn.pd.gt.74\":\"warn.pd.gt.74\",\"cart.page.prism\":\"Prism\",\"lens.details.with.text\":\"with\",\"lens.details.sunglass.tint.swatch.title\":\"Sunglasses Lens Color\",\"lens.details.mirrorSilver.color.name\":\"Silver Mirror\",\"lens.details.mirrorSkyBlue.color.name\":\"Sky Blue Mirror\",\"warn.pd.lt.46\":\"warn.pd.lt.46\",\"lens.details.mirror.tint.swatch.title\":\"Mirror\",\"lens.details.mirrorGold.color.name\":\"Gold Mirror\",\"lens.details.mirrorRoseGold.color.name\":\"Rose Gold Mirror\",\"lens.details.mirrorIndigo.color.name\":\"Indigo Mirror\",\"lens.details.mirrorMossGreen.color.name\":\"Moss Green Mirror\",\"lens.details.mirrorFlameRed.color.name\":\"Flame Red Mirror\",\"lens.details.mirrorLavendar.color.name\":\"Lavender Mirror\",\"lens.details.polarizedAmber.color.name\":\"Amber\",\"lens.details.photochromicGray.color.name\":\"Gray\",\"lens.details.photochromicAmber.color.name\":\"Amber\",\"lens.details.polarizedGray.color.name\":\"Gray\",\"lens.details.otherFrames.Progressive.BlueBlockLensPhotochromic.1.61.text\":\"\u003cb\u003e1.61 Blokz Photochromic Progressive\u003c/b\u003e lenses darken to a gray tint outdoors and turn virtually clear indoors. Made with MR™, a premium lens material, these lenses help protect the eyes from harmful UV and blue light up to 415nm.\u003cbr/\u003e\u003cbr/\u003ePlease note: photochromic lenses will not darken in a car due to UV-blocking windshields/windows. Also, lenses may develop a slight base tint after long-term use.\u003cbr/\u003e\u003cbr/\u003e\u003cem\u003eMR™ is a trademark of Mitsui Chemicals in Japan, a global leading provider of ophthalmic lens materials and technologies.\u003c/em\u003e\",\"lens.details.otherFrames.Progressive.BlueBlockLensPhotochromic.1.67.text\":\"\u003cb\u003e1.67 Blokz Photochromic Progressive\u003c/b\u003e lenses darken to a gray tint outdoors and turn virtually clear indoors. Made with MR™, a premium lens material, these lenses help protect the eyes from harmful UV and blue light up to 415nm.\u003cbr/\u003e\u003cbr/\u003ePlease note: photochromic lenses will not darken in a car due to UV-blocking windshields/windows. Also, lenses may develop a slight base tint after long-term use.\u003cbr/\u003e\u003cbr/\u003e\u003cem\u003eMR™ is a trademark of Mitsui Chemicals in Japan, a global leading provider of ophthalmic lens materials and technologies.\u003c/em\u003e\",\"order.summary.back.to.cart\":\"Back to Cart\",\"lens.details.otherFrames.Readers.BlueBlockLens.1.61.text\":\"\u003cb\u003e1.61 Blokz High-Index\u003c/b\u003e virtually clear lenses are lighter and 20% thinner than 1.50 basic lens, and they help protect the eyes from harmful UV and blue light. These lenses are made with MR™, a premium lens material.\u003cbr/\u003e\u003cbr/\u003e\u003cem\u003eMR™ is a trademark of Mitsui Chemicals in Japan, a global leading provider of ophthalmic lens materials and technologies.\u003c/em\u003e\",\"lens.details.otherFrames.Readers.BlueBlockLens.1.50.text\":\"\u003cb\u003e1.50 Basic Blokz\u003c/b\u003e virtually clear lenses help protect the eyes from harmful blue light and UV rays emitted from digital devices, artificial lights, and the sun.\",\"lens.details.otherFrames.Readers.BlueBlockLensPhotochromic.1.61.text\":\"\u003cb\u003e1.61 Blokz Photochromic\u003c/b\u003e lenses darken to a gray tint outdoors and turn virtually clear indoors. Made with MR™, a premium lens material, these lenses help protect the eyes from harmful UV and blue light up to 415nm.\u003cbr/\u003e\u003cbr/\u003ePlease note: photochromic lenses will not darken in a car due to UV-blocking windshields/windows. Also, lenses may develop a slight base tint after long-term use.\u003cbr/\u003e\u003cbr/\u003e\u003cem\u003eMR™ is a trademark of Mitsui Chemicals in Japan, a global leading provider of ophthalmic lens materials and technologies.\u003c/em\u003e\",\"lens.details.otherFrames.SingleVision.BlueBlockLensPhotochromic.1.67.text\":\"\u003cb\u003e1.67 Blokz Photochromic\u003c/b\u003e lenses darken to a gray tint outdoors and turn virtually clear indoors. Made with MR™, a premium lens material, these lenses help protect the eyes from harmful UV and blue light up to 415nm.\u003cbr/\u003e\u003cbr/\u003ePlease note: photochromic lenses will not darken in a car due to UV-blocking windshields/windows. Also, lenses may develop a slight base tint after long-term use.\u003cbr/\u003e\u003cbr/\u003e\u003cem\u003eMR™ is a trademark of Mitsui Chemicals in Japan, a global leading provider of ophthalmic lens materials and technologies.\u003c/em\u003e\",\"lens.details.otherFrames.Progressive.BlueBlockLens.1.74.text\":\"\u003cb\u003e1.74 High-Index\u003c/b\u003e virtually clear lenses are up to 40% thinner than 1.50 basic lens. Made with MR™, a premium lens material, these lenses help protect the eyes from harmful UV and blue light.\u003cbr/\u003e\u003cbr/\u003e\u003cem\u003eMR™ is a trademark of Mitsui Chemicals in Japan, a global leading provider of ophthalmic lens materials and technologies.\u003c/em\u003e\",\"lens.details.otherFrames.Progressive.BlueBlockLens.1.67.text\":\"\u003cb\u003e1.67 Blokz High-Index Progressive\u003c/b\u003e virtually clear lenses are up to 30% thinner than 1.50 basic lenses. Made with MR™, a premium lens material, these lenses help protect the eyes from harmful UV and blue light.\u003cbr/\u003e\u003cbr/\u003e\u003cem\u003eMR™ is a trademark of Mitsui Chemicals in Japan, a global leading provider of ophthalmic lens materials and technologies.\u003c/em\u003e\",\"lens.details.otherFrames.Progressive.BlueBlockLens.1.53.text\":\"\u003cb\u003e1.53 Blokz Trivex® Impact-Resistant\u003c/b\u003e virtually clear lenses are impact resistant and help block harmful UV and blue light. They are an excellent choice for children’s glasses, rimless glasses, sports and safety eyewear.\u003cbr/\u003e\u003cbr/\u003e\u003cem\u003eTrivex is a registered trademark of PPG Industries Ohio, Inc.\u003c/em\u003e\",\"lens.details.otherFrames.Progressive.BlueBlockLens.1.61.text\":\"\u003cb\u003e1.61 Blokz High-Index Progressive\u003c/b\u003e virtually clear lenses are lighter and 20% thinner than 1.50 basic lens, and they help protect the eyes from harmful UV and blue light. These lenses are made with MR™, a premium lens material.\u003cbr/\u003e\u003cbr/\u003e\u003cem\u003eMR™ is a trademark of Mitsui Chemicals in Japan, a global leading provider of ophthalmic lens materials and technologies.\u003c/em\u003e\",\"lens.details.otherFrames.Progressive.BlueBlockLens.1.50.text\":\"\u003cb\u003e1.50 Basic Blokz Progressive\u003c/b\u003e virtually clear lenses help protect the eyes from harmful blue light and UV rays emitted from digital devices, artificial lights, and the sun.\",\"lens.details.otherFrames.SingleVision.BlueBlockLens.1.67.text\":\"\u003cb\u003e1.67 Blokz High-Index\u003c/b\u003e virtually clear lenses are up to 30% thinner than 1.50 basic lenses. Made with MR™, a premium lens material, these lenses help protect the eyes from harmful UV and blue light.\u003cbr/\u003e\u003cbr/\u003e\u003cem\u003eMR™ is a trademark of Mitsui Chemicals in Japan, a global leading provider of ophthalmic lens materials and technologies.\u003c/em\u003e\",\"lens.details.otherFrames.SingleVision.BlueBlockLens.1.50.text\":\"\u003cb\u003e1.50 Basic Blokz\u003c/b\u003e virtually clear lenses help protect the eyes from harmful blue light and UV rays emitted from digital devices, artificial lights, and the sun.\",\"lens.details.otherFrames.SingleVision.BlueBlockLensPhotochromic.1.61.text\":\"\u003cb\u003e1.61 Blokz Photochromic\u003c/b\u003e lenses darken to a gray tint outdoors and turn virtually clear indoors. Made with MR™, a premium lens material, these lenses help protect the eyes from harmful UV and blue light up to 415nm.\u003cbr/\u003e\u003cbr/\u003ePlease note: photochromic lenses will not darken in a car due to UV-blocking windshields/windows. Also, lenses may develop a slight base tint after long-term use.\u003cbr/\u003e\u003cbr/\u003e\u003cem\u003eMR™ is a trademark of Mitsui Chemicals in Japan, a global leading provider of ophthalmic lens materials and technologies.\u003c/em\u003e\",\"lens.details.otherFrames.SingleVision.BlueBlockLens.1.61.text\":\"\u003cb\u003e1.61 Blokz High-Index\u003c/b\u003e virtually clear lenses are lighter and 20% thinner than 1.50 basic lens, and they help protect the eyes from harmful UV and blue light. These lenses are made with MR™, a premium lens material.\u003cbr/\u003e\u003cbr/\u003e\u003cem\u003eMR™ is a trademark of Mitsui Chemicals in Japan, a global leading provider of ophthalmic lens materials and technologies.\u003c/em\u003e\",\"lens.details.otherFrames.SingleVision.BlueBlockLens.1.74.text\":\"\u003cb\u003e1.74 High-Index\u003c/b\u003e virtually clear lenses are up to 40% thinner than 1.50 basic lens. Made with MR™, a premium lens material, these lenses help protect the eyes from harmful UV and blue light.\u003cbr/\u003e\u003cbr/\u003e\u003cem\u003eMR™ is a trademark of Mitsui Chemicals in Japan, a global leading provider of ophthalmic lens materials and technologies.\u003c/em\u003e\",\"lens.details.otherFrames.SingleVision.BlueBlockLens.1.53.text\":\"\u003cb\u003e1.53 Blokz Trivex® Impact-Resistant\u003c/b\u003e virtually clear lenses are impact resistant and help block harmful UV and blue light. They are an excellent choice for children’s glasses, rimless glasses, sports and safety eyewear.\u003cbr/\u003e\u003cbr/\u003e\u003cem\u003eTrivex is a registered trademark of PPG Industries Ohio, Inc.\u003c/em\u003e\",\"err.pd.range.alt.frame\":\"The dual PD entered does not match the PD range required for this frame. Please use prescription filter to look for frames that match with your PD.\",\"err.pd.small.extra.charge\":\"Your PD is smaller than minimum PD of the frame, but we can process with an extra charge.\",\"order.summary.add\":\"Add\",\"order.summary.title\":\"Order Summary\",\"err.pd.too.large\":\"Your PD is too large for this frame. Please select a different frame.\",\"err.pd.too.small.nodecentration\":\"Your PD is too small for this frame. Please select a different frame.\",\"error.direction.prism.missing.os.value\":\"A base direction was selected without a prism value. Please check your prism entry.\",\"error.prism.direction.missing.dir.os\":\"A prism value was selected without a base direction. Please check your prism entry.\",\"error.direction.prism.missing.od.value\":\"A base direction was selected without a prism value. Please check your prism entry.\",\"error.prism.direction.missing.dir.od\":\"A prism value was selected without a base direction. Please check your prism entry.\",\"err.pd.too.small.bifocal\":\"Your PD is too small for this frame. Please select a different frame.\",\"err.pd.too.small.safety.sportspg\":\"Your PD is too small for this frame. Please select a different frame.\",\"error.rx.too.strong.od\":\"Your prescription is too strong for this frame. Please select a different frame.\",\"error.rx.prmsunglass.alt.frame.jointos\":\"Unfortunately, we are unable to accommodate your prescription in our line of Premium Sunglasses frames. Please choose a different frame from our large eyeglasses collection. You can customize them as sunglasses by tinting your lenses at checkout.\",\"error.rx.prmsunglass.alt.frame.od\":\"Unfortunately, we are unable to accommodate your prescription in our line of Premium Sunglasses frames. Please choose a different frame from our large eyeglasses collection. You can customize them as sunglasses by tinting your lenses at checkout.\",\"error.rx.too.strong.os\":\"Your prescription is too strong for this frame. Please select a different frame.\",\"error.select.nvadd.singlevision\":\"Please select a NVADD.\",\"error.rx.prmsunglass.alt.frame.jointod\":\"Unfortunately, we are unable to accommodate your prescription in our line of Premium Sunglasses frames. Please choose a different frame from our large eyeglasses collection. You can customize them as sunglasses by tinting your lenses at checkout.\",\"error.rx.prmsunglass.alt.frame.os\":\"Unfortunately, we are unable to accommodate your prescription in our line of Premium Sunglasses frames. Please choose a different frame from our large eyeglasses collection. You can customize them as sunglasses by tinting your lenses at checkout.\",\"warn.check.sph.ossph.gt.2x.odsph\":\"Please make sure your SPH is correct.\",\"warn.check.sph.odsph.gt.2x.ossph\":\"Please make sure your SPH is correct.\",\"warn.check.sph.div.2.5\":\"Please make sure your SPH is correct.\",\"progressive.option.Standard.image.item\":\"op-standard\",\"progressive.option.NearRange.image.item\":\"op-near\",\"plp.search.youSearchedFor\":\"YOU SEARCHED FOR\",\"plp.filterbox.tryOn.createButton\":\"CREATE A TRY-ON\",\"SelectedFilter.Name.prod_lens_width\":\"Lens Width\",\"progressive.option.MidRange.image.item\":\"op-mid\",\"my.prescription.add.renewal.modal.title\":\"Renewal Reminder\",\"err.pd.too.small.decentration\":\"Your PD is too small for this frame. Please select a different frame.\",\"pdp.clipon.addToCard\":\"ADD TO CART\",\"my.prescription.add.renewal.modal.content\":\"Your prescription reminder will expire in a year based on your settings. If you have more than 5 reminders, then your oldest will be discontinued. You can edit your reminders by clicking on Edit.\",\"pdp.standard.sizeChartPopupKidsSuggestedAge\":\"*Suggested age\",\"plp.search.results\":\"results:\",\"gift.card.balance.english.time\":\"English 5AM – 9PM PT\",\"gift.card.balance.further.information\":\"For further information and updates regarding the availability of this service, please contact Customer Service.\\n\",\"gift.card.balance.service.unavailable\":\"SERVICE UNAVAILABLE\",\"gift.card.balance.espanol.time\":\"Español \u0026 Français 5AM – 9PM PT\",\"gift.card.balance.number\":\"(800) 211-2105\",\"gift.card.balance.unable.to.accept.gift.card\":\"We are currently unable to accept gift cards due to a system update.\",\"global.product.free\":\"FREE\",\"pdp.alsoBought.over99Error\":\"Your cart is full, please checkout or remove some items before adding more items\",\"outside.icon.engraving.not.available.text\":\"Sorry, we are unable to retrieve outside arm icons.\",\"add-to-cart-error-max-quantity-exceeded\":\"OOPS!Quantity reached for this item. Limit 9 per order.\",\"payment.use.an.existing.store.credit\":\"If you would like to use an existing store credit, type ‘Please apply my store credit’ into the Special Requests box on this page. Customer Service will validate the amount, and issue a partial refund for your order.\",\"payment.unable.to.process.gift.card\":\"We are currently unable to accept gift cards and store credit due to a system update.\",\"snap.on.sheild.not.available.text\":\"Sorry, we are unable to retrieve snap-ons.\",\"lens.details.SportsProtectiveGlasses.Readers.BlueBlockLens.1.61.text\":\"\u003cb\u003e1.61 Blokz High-Index\u003c/b\u003e virtually clear lenses are lighter and 20% thinner than 1.50 basic lens, and they help protect the eyes from harmful UV and blue light. These lenses are made with MR™, a premium lens material.\u003cbr/\u003e\u003cbr/\u003e\u003cem\u003eMR™ is a trademark of Mitsui Chemicals in Japan, a global leading provider of ophthalmic lens materials and technologies.\u003c/em\u003e\",\"lens.details.SportsProtectiveGlasses.Readers.BlueBlockLens.1.50.text\":\"\u003cb\u003e1.50 Basic Blokz\u003c/b\u003e virtually clear lenses help protect the eyes from harmful blue light and UV rays emitted from digital devices, artificial lights, and the sun.\",\"lens.details.SportsProtectiveGlasses.Readers.BlueBlockLensPhotochromic.1.61.text\":\"\u003cb\u003e1.61 Blokz Photochromic\u003c/b\u003e lenses darken to a gray tint outdoors and turn virtually clear indoors. Made with MR™, a premium lens material, these lenses help protect the eyes from harmful UV and blue light up to 415nm.\u003cbr/\u003e\u003cbr/\u003ePlease note: photochromic lenses will not darken in a car due to UV-blocking windshields/windows. Also, lenses may develop a slight base tint after long-term use.\u003cbr/\u003e\u003cbr/\u003e\u003cem\u003eMR™ is a trademark of Mitsui Chemicals in Japan, a global leading provider of ophthalmic lens materials and technologies.\u003c/em\u003e\",\"lens.details.SportsProtectiveGlasses.NonPrescription.BlueBlockLens.1.53.text\":\"Protective lens package includes the following:\u003cbr/\u003e\u003cbr/\u003e\u003cb\u003e1.53 Blokz Trivex® Impact-Resistant\u003c/b\u003e\u003cbr/\u003e1.53 Blokz Trivex® Impact-Resistant lenses are impact-resistant and help block harmful UV and blue light. They are an excellent choice for children’s glasses, safety eyewear, and sports eyewear.\u003cbr/\u003e\u003cbr/\u003e\u003cem\u003eTrivex is a registered trademark of PPG Industries Ohio, Inc.\u003c/em\u003e\u003cbr/\u003e\u003cbr/\u003e\u003cb\u003eAdvanced-Super Hydrophobic Anti-Reflective\u003c/b\u003e\u003cbr/\u003eSuper Hydrophobic  (Water Resistant, Easy To Clean)  Anti-Reflective Coating has all the properties of the standard AR coating, plus a water-resistant coating that repels dirt and water, making it easier to clean.\",\"clip.on.not.available.text\":\"Sorry, we are unable to retrieve clip-ons.\",\"lens.details.SafetyGlasses.NonPrescription.BlueBlockLens.1.53.text\":\"Protective lens package includes the following:\u003cbr/\u003e\u003cbr/\u003e\u003cb\u003e1.53 Blokz Trivex® Impact-Resistant\u003c/b\u003e\u003cbr/\u003e1.53 Blokz Trivex® Impact-Resistant lenses are impact-resistant and help block harmful UV and blue light. They are an excellent choice for children’s glasses, safety eyewear, and sports eyewear.\u003cbr/\u003e\u003cbr/\u003e\u003cem\u003eTrivex is a registered trademark of PPG Industries Ohio, Inc.\u003c/em\u003e\u003cbr/\u003e\u003cbr/\u003e\u003cb\u003eAdvanced-Super Hydrophobic Anti-Reflective\u003c/b\u003e\u003cbr/\u003eSuper Hydrophobic  (Water Resistant, Easy To Clean)  Anti-Reflective Coating has all the properties of the standard AR coating, plus a water-resistant coating that repels dirt and water, making it easier to clean.\",\"lens.details.SafetyGlasses.Progressive.BlueBlockLens.1.53.text\":\"Protective lens package includes the following:\u003cbr/\u003e\u003cbr/\u003e\u003cb\u003e1.53 Blokz Trivex® Impact-Resistant\u003c/b\u003e\u003cbr/\u003e1.53 Blokz Trivex® Impact-Resistant lenses are impact-resistant and help block harmful UV and blue light. They are an excellent choice for children’s glasses, safety eyewear, and sports eyewear.\u003cbr/\u003e\u003cbr/\u003e\u003cem\u003eTrivex is a registered trademark of PPG Industries Ohio, Inc.\u003c/em\u003e\u003cbr/\u003e\u003cbr/\u003e\u003cb\u003eAdvanced-Super Hydrophobic Anti-Reflective\u003c/b\u003e\u003cbr/\u003eSuper Hydrophobic  (Water Resistant, Easy To Clean)  Anti-Reflective Coating has all the properties of the standard AR coating, plus a water-resistant coating that repels dirt and water, making it easier to clean.\",\"lens.details.SafetyGlasses.Readers.BlueBlockLens.1.61.text\":\"\u003cb\u003e1.61 Blokz High-Index\u003c/b\u003e virtually clear lenses are lighter and 20% thinner than 1.50 basic lens, and they help protect the eyes from harmful UV and blue light. These lenses are made with MR™, a premium lens material.\u003cbr/\u003e\u003cbr/\u003e\u003cem\u003eMR™ is a trademark of Mitsui Chemicals in Japan, a global leading provider of ophthalmic lens materials and technologies.\u003c/em\u003e\",\"lens.details.SafetyGlasses.Readers.BlueBlockLens.1.50.text\":\"\u003cb\u003e1.50 Basic Blokz\u003c/b\u003e virtually clear lenses help protect the eyes from harmful blue light and UV rays emitted from digital devices, artificial lights, and the sun.\",\"lens.details.SafetyGlasses.Readers.BlueBlockLensPhotochromic.1.61.text\":\"\u003cb\u003e1.61 Blokz Photochromic\u003c/b\u003e lenses darken to a gray tint outdoors and turn virtually clear indoors. Made with MR™, a premium lens material, these lenses help protect the eyes from harmful UV and blue light up to 415nm.\u003cbr/\u003e\u003cbr/\u003ePlease note: photochromic lenses will not darken in a car due to UV-blocking windshields/windows. Also, lenses may develop a slight base tint after long-term use.\u003cbr/\u003e\u003cbr/\u003e\u003cem\u003eMR™ is a trademark of Mitsui Chemicals in Japan, a global leading provider of ophthalmic lens materials and technologies.\u003c/em\u003e\",\"lens.details.SportsProtectiveGlasses.SingleVision.BlueBlockLens.1.53.text\":\"Protective lens package includes the following:\u003cbr/\u003e\u003cbr/\u003e\u003cb\u003e1.53 Blokz Trivex® Impact-Resistant\u003c/b\u003e\u003cbr/\u003e1.53 Blokz Trivex® Impact-Resistant lenses are impact-resistant and help block harmful UV and blue light. They are an excellent choice for children’s glasses, safety eyewear, and sports eyewear.\u003cbr/\u003e\u003cbr/\u003e\u003cem\u003eTrivex is a registered trademark of PPG Industries Ohio, Inc.\u003c/em\u003e\u003cbr/\u003e\u003cbr/\u003e\u003cb\u003eAdvanced-Super Hydrophobic Anti-Reflective\u003c/b\u003e\u003cbr/\u003eSuper Hydrophobic  (Water Resistant, Easy To Clean)  Anti-Reflective Coating has all the properties of the standard AR coating, plus a water-resistant coating that repels dirt and water, making it easier to clean.\",\"lens.details.otherFrames.NonPrescription.BlueBlockLensPhotochromic.1.61.text\":\"\u003cb\u003e1.61 Blokz Photochromic Gray\u003c/b\u003e are clear indoors and automatically darken to gray in sunlight for convenient 2-in-1 glasses and sunglasses. They help protect the eyes from harmful blue light and UV rays emitted from digital devices, artificial light, and the sun.\u003cbr/\u003e\u003cbr/\u003eThey are made with MR™, a premium lens material.\u003cbr/\u003e\u003cbr/\u003e\u003cem\u003eMR™ is a trademark of Mitsui Chemicals in Japan, a global leading provider of ophthalmic lens materials and technologies.\u003c/em\u003e\",\"lens.details.otherFrames.NonPrescription.BlueBlockLens.1.50.text\":\"\u003cb\u003e1.50 Blokz Basic\u003c/b\u003e virtually clear lenses help protect the eyes from harmful blue light and UV rays emitted from digital devices, artificial lights, and the sun.\",\"lens.details.SafetyGlasses.SingleVision.BlueBlockLens.1.53.text\":\"Protective lens package includes the following:\u003cbr/\u003e\u003cbr/\u003e\u003cb\u003e1.53 Blokz Trivex® Impact-Resistant\u003c/b\u003e\u003cbr/\u003e1.53 Blokz Trivex® Impact-Resistant lenses are impact-resistant and help block harmful UV and blue light. They are an excellent choice for children’s glasses, safety eyewear, and sports eyewear.\u003cbr/\u003e\u003cbr/\u003e\u003cem\u003eTrivex is a registered trademark of PPG Industries Ohio, Inc.\u003c/em\u003e\u003cbr/\u003e\u003cbr/\u003e\u003cb\u003eAdvanced-Super Hydrophobic Anti-Reflective\u003c/b\u003e\u003cbr/\u003eSuper Hydrophobic  (Water Resistant, Easy To Clean)  Anti-Reflective Coating has all the properties of the standard AR coating, plus a water-resistant coating that repels dirt and water, making it easier to clean.\",\"lens.details.otherFrames.NonPrescription.BlueBlockLens.1.53.text\":\"\u003cb\u003e1.53 Blokz Trivex® Impact-Resistant\u003c/b\u003e virtually clear lenses are impact-resistant and help block harmful UV and blue light. They are an excellent choice for children’s glasses, rimless glasses, sports and safety eyewear.\u003c/br\u003e\u003c/br\u003e\u003cem\u003eTrivex is a registered trademark of PPG Industries Ohio, Inc.\u003c/em\u003e\",\"error.cyl.unusual\":\"We see that you entered a unusual value for your cylinder. This result in one lens being thicker than the other. Please review your entry and let us know if this is correct.\",\"Error.CreditCard.CVVMismatch\":\"This card could not be verified. Please check your card number, security code, and expiration date. If the problem persists, please try a different payment method.\",\"Error.CreditCard.InvalidCCNumber\":\"This card could not be verified. Please check your card number, security code, and expiration date. If the problem persists, please try a different payment method.\",\"Error.CreditCard.Expired\":\"This card could not be verified. Please check your card number, security code, and expiration date. If the problem persists, please try a different method\",\"Error.CreditCard.SystemError\":\"Unfortunately, we are unable to process your order with the credit card you entered. Please try different payment method\",\"Error.CreditCard.Declined\":\"Unfortunately, we are unable to process your order because your credit card was declined. Please try another card or different payment method\",\"checkout.footer.you.saved\":\"You saved: \",\"summary.checkout.product.clipons.caption\":\"Clip-Ons\",\"Error.CreditCard.AVSFailed\":\"This card could not be verified. Please check your card number, security code, expiration date and billing address. If the problem persists, please try a different method.\",\"Error.PaymentMethod.PaypalPay.Failed\":\"Paypal payment has failed. Please select an alternate payment method.\",\"summary.checkout.product.clipons\":\"Your clipons\",\"pdp.pd.warningbanner.text\":\"   This frame is scaled to fit your face. To see how it will actually fit, create a\\n  new Virtual Try-On with your PD.\",\"add.on.selection.add-to-cart-error-max-cart-quantity-exceeded\":\"Sorry, a regular order can't have more than 99 products. If you plan to buy large quantity, please call us for partnership opportunity.\",\"pdp.upsellText.StandardFrameType\":\"\u003cdiv class=\\\"price-includes font-small\\\"\u003e\u003cstrong class=\\\"text-uppercase\\\"\u003eFrame Price Includes:\u003c/strong\u003e\\n\u003cul class=\\\"list-unstyled margin-bottom-0 margin-top-10\\\"\u003e\\n\\n\u003cli\u003e\u003ci class=\\\"fas fa-check font-smaller\\\"\u003e\u003c/i\u003e\u003cspan\u003eAnti-scratch coating\u003c/span\u003e\u003c/li\u003e\\n\u003cli\u003e\u003ci class=\\\"fas fa-check font-smaller\\\"\u003e\u003c/i\u003e\u003cspan\u003eUV protection\u003c/span\u003e\u003c/li\u003e\\n\\n\u003c/ul\u003e\\n\u003c/div\u003e\\n\",\"checkout.footer.upcharge.shipping.discount\":\"UpCharge Shipping Discount\",\"checkout.footer.free\":\"Free\",\"cart.page.errors.modal.ok\":\"Ok\",\"cart-service-error-max-cart-quantity-exceeded\":\"Sorry, a regular order can't have more than 99 products. If you plan to buy large quantity, please call us for partnership opportunity.\",\"my.orders.disabled.message.coating.iconEngraving\":\"We`re sorry, the engraving icon or coating you selected previously is no longer available. Please select another add-on option.\",\"my.orders.disabled.message.iconEngraving\":\"We`re sorry, the engraving icon you selected previously is no longer available. Please select another add-on option.\\n\",\"my.orders.disabled.message.clipOn.iconEngraving.shield\":\"We`re sorry, the clip-on or engraving icon or shield you selected previously is no longer available. Please select another add-on option.\",\"my.orders.disabled.message.coating.iconEngraving.shield\":\"We`re sorry, the engraving icon or coating or shield you selected previously is no longer available. Please select another add-on option.\",\"my.orders.disabled.message.iconEngraving.shield\":\"We`re sorry, the engraving icon or shield you selected previously is no longer available. Please select another add-on option.\",\"my.orders.disabled.message.clipOn.iconEngraving\":\"We`re sorry, the clip-on or engraving icon you selected previously is no longer available. Please select another add-on option.\",\"my.orders.disabled.message.coating.clipOn\":\"We`re sorry, the clip-on or coating you selected previously is no longer available. Please select another add-on option.\",\"my.orders.disabled.message.coating.clipOn.iconEngraving.shield\":\"We`re sorry, the clip-on or engraving icon or coating or shield you selected previously is no longer available. Please select another add-on option.\",\"my.orders.disabled.message.clipOn.shield\":\"We`re sorry, the clip-on or shield you selected previously is no longer available. Please select another add-on option.\",\"my.orders.disabled.message.coating.clipOn.shield\":\"We`re sorry, the clip-on or coating or shield you selected previously is no longer available. Please select another add-on option.\",\"my.orders.disabled.message.clipOn\":\"We`re sorry, the clip-on you selected previously is no longer available. Please select another add-on option.\",\"my.orders.disabled.message.coating.clipOn.iconEngraving\":\"We`re sorry, the clip-on or engraving icon or coating you selected previously is no longer available. Please select another add-on option.\\n\",\"my.orders.disabled.message.shield\":\"We`re sorry, the shield you selected previously is no longer available. Please select another add-on option.\",\"my.orders.disabled.message.coating.shield\":\"We`re sorry, the coating or shield you selected previously is no longer available. Please select another add-on option.\",\"pdp.mobile.retiredText\":\"RETIRED\",\"my.orders.disabled.message.coating\":\"We`re sorry, the coating you selected previously is no longer available. Please select another add-on option.\\n\",\"pdp.upsellText.CasesAndLensCloths\":\"Grab a few cases and cleaning cloths to keep any place your glasses go.\\n\",\"my.orders.disabled.message.clip.on\":\"We`re sorry, the clip-on or engraving icon or coating you selected previously is no longer available. Please select another add-on option.\",\"my.orders.disabled.message.tint\":\"We`re sorry, the tint option you selected previously is no longer available. Please select another lens option.\",\"order.confirm.items.order.line.item.btn.close\":\"Close\",\"gift.card.balance.email\":\"  \u003ca href=\\\"https://www.zennioptical.com/help/contactsupport\\\" className=\\\"d-block link\\\"\u003eEmail\u003c/a\u003e\",\"my.orders.disabled.message.lens\":\"We`re sorry, the lens option you selected previously is no longer available. Please select another lens option.\",\"order.confirm.items.order.additional.charge.type\":\"Additional Charge\",\"my.order.detail.print.order\":\"Print Order\",\"my.order.detail.back.to.orders.list\":\"Back to My Orders List\",\"my.order.detail.print.fsa.hsa\":\"Print FSA/HSA Receipt\",\"order.state.Completed\":\"Completed\",\"myAccount.myFavorites.noFavorites\":\"\u003cp\u003eThere is no product item on your favorites.\u003c/p\u003e\u003ca class=\\\"btn btn-outline-primary\\\" href=\\\"/\\\"\u003eContinue Shopping\u003c/a\u003e\",\"error.ux.os.horizontal.power.dir.reqd\":\"Both power and direction are required for prism.\",\"error.ux.lensshape.rxtype.incompatible\":\"This lens shape is not tall enough to accommodate that prescription type.\",\"error.ux.nvadd.zero\":\"nvAdd is required\",\"error.ux.os.vertical.power.dir.reqd\":\"Both power and direction are required for prism.\",\"error.ux.od.vertical.power.dir.reqd\":\"Both power and direction are required for prism.\",\"error.ux.od.horizontal.power.dir.reqd\":\"Both power and direction are required for prism.\",\"error.ux.odcyl.axis.zero\":\"Both OD CYL and OD AXIS must have a number or both must be 0. Please check your entries.\",\"error.ux.pd.dual.right.zero\":\"Please select your Right PD!\",\"warn.ux.od.os.zero\":\"All of the values are 0. Do you want to order lenses without a prescription? Please confirm your prescription details.\",\"error.ux.pd.dual.left.zero\":\"Please select your Left PD!\",\"error.ux.oscyl.axis.zero\":\"Both OS CYL and OS AXIS must have a number or both must be 0. Please check your entries.\",\"error.ux.sph.pd.zero\":\"You must select the pd with SPH\",\"prescription.form.table.select.progressive.option\":\"Select Progressive Option\",\"pdp.oos.emailvalidValue\":\"Please enter a valid email address.\",\"error.ux.pd.dual.zero\":\"Please select your PD values!\",\"error.ux.select.progressiveoption\":\"Please select progressive option\",\"pdp.writeReview.content\":\"\u003cp class=\\\"font-tips\\\"\u003eBe the first to \u003ca class=\\\"lnkWriteReview\\\" href=\\\"/review/write?skuId={0}\u0026amp;pId={1}\\\"\u003eWrite a review\u003c/a\u003e\u003c/p\u003e\",\"error.ux.pd.single.zero\":\"Please select your PD!\",\"Label.HelpTips.Clipon.cosku100009\":\"\\n\u003cdiv class=\\\"helpMsgPane\\\"\u003e\\n  \u003cdiv class=\\\"jspPane\\\" style=\\\"padding: 0px 4px; top: 0px; width: 540px;\\\"\u003e\\n    \u003cp\u003e\u003cstrong\u003eMirror Clip-On\u003c/strong\u003e\u003c/p\u003e\\n    \u003cp\u003e\u0026nbsp;\u003c/p\u003e\\n    \u003cp\u003eTurn your glasses into instantly cool sunglasses with our polarized mirror clip-ons. The mirror clip-ons come\\n      with oleophobic anti-reflective coating to reduce fingerprints and glare. To provide full sun coverage, clip-ons\\n      are cut slightly larger than the optical lenses.\\n    \u003c/p\u003e\\n  \u003c/div\u003e\\n\u003c/div\u003e\",\"checkout.save.payment.failure\":\"Payment method failed verification.\",\"pdp.oos.message1\":\"This color is out of stock.\",\"cart.page.section.add-discount.error.cart-service-error-add-discount-invalid-code\":\"Please enter a correct promotion code to proceed.\",\"global.product.included\":\"INCLUDED\",\"Label.HelpTips.Clipon.cosku100006\":\"\u003cdiv class=\\\"jspPane\\\" style=\\\"padding: 0px 4px; top: 0px; width: 540px;\\\"\u003e\\n  \u003cp\u003e\u003cstrong\u003e3D Clip-On\u003c/strong\u003e\u003c/p\u003e\\n  \u003cp\u003e\u0026nbsp;\u003c/p\u003e\\n  \u003cp\u003eOur 3D clip-ons attach to the front of your glasses, providing a more comfortable way to enjoy 3D movies. Made with\\n    passive 3D technology, they are designed for watching most 3D movies in theaters. They cannot be used with IMAX 3D\\n    or alternative 3D technology.\u003c/p\u003e\\n  \u003cp\u003eTo provide a complete 3D experience, 3D clip-ons are cut slightly larger than the optical lenses.\u003c/p\u003e\\n  \u003cp\u003eNot for use as sunglasses.\u003c/p\u003e\\n\u003c/div\u003e\",\"clipOnFinder.popup.rimlessFoundFrames\":\"Here are the frames we found.\",\"Label.HelpTips.Clipon.cosku100003\":\"\u003cdiv class=\\\"\\\"jspPane\\\"\\\" style=\\\"\\\"padding: 0px 4px; top: 0px; width: 540px;\\\"\\\"\u003e\\n    \u003cp\u003e\u003cstrong\u003eSunglasses Gradient Clip-On\u003c/strong\u003e\u003c/p\u003e\\n    \u003cp\u003e\u0026nbsp;\u003c/p\u003e\\n    \u003cp\u003eGradient clip-ons have a darker tint at the top and gradually get lighter at the bottom. The clip-ons are polarized to reduce glare and are cut sligthly larger than the optical lenses to provide full sun coverage.\u003c/p\u003e\\n\u003c/div\u003e\\n\",\"Label.HelpTips.Clipon.cosku100010\":\"\u003chead/\u003e\u003cdiv class=\\\"\\\"helpMsgPane\\\"\\\"\u003e\\n\u003cdiv class=\\\"\\\"jspPane\\\"\\\" style=\\\"\\\"padding: 0px 4px; top: 0px; width: 540px;\\\"\\\"\u003e\\n    \u003cp\u003e\u003cstrong\u003eMirror Clip-On\u003c/strong\u003e\u003c/p\u003e\\n    \u003cp\u003e\u0026nbsp;\u003c/p\u003e\\n    \u003cp\u003eTurn your glasses into instantly cool sunglasses with our polarized mirror clip-ons. The mirror clip-ons come with oleophobic anti-reflective coating to reduce fingerprints and glare. To provide full sun coverage, clip-ons are cut slightly larger than the optical lenses.\\n\u003c/p\u003e\\n\u003c/div\u003e\\n\u003c/div\u003e\",\"Label.HelpTips.Clipon.cosku100002\":\"\u003cdiv class=\\\"\\\"jspPane\\\"\\\" style=\\\"padding: 0px 4px; top: 0px; width: 540px;\\\"\u003e\\n    \u003cp\u003e\u003cstrong\u003eSunglass Clip-On\u003c/strong\u003e\u003c/p\u003e\\n    \u003cp\u003e\u0026nbsp;\u003c/p\u003e\\n    \u003cp\u003eThese classic clip-ons feature a polarized tint to reduce glare. The tint is a solid color. To provide full sun coverage, clip-ons are cut slightly larger than the optical lenses.\u003c/p\u003e\\n\u003c/div\u003e\\n\",\"Label.HelpTips.Clipon.cosku100005\":\"\u003cdiv class=\\\"jspPane\\\" style=\\\"padding: 0px 4px; top: 0px; width: 540px;\\\"\u003e\\n  \u003cp\u003e\u003cstrong\u003eSunglasses Gradient Clip-On\u003c/strong\u003e\u003c/p\u003e\\n  \u003cp\u003e\u0026nbsp;\u003c/p\u003e\\n  \u003cp\u003eGradient clip-ons have a darker tint at the top and gradually get lighter at the bottom. The clip-ons are polarized\\n    to reduce glare and are cut sligthly larger than the optical lenses to provide full sun coverage.\u003c/p\u003e\\n\u003c/div\u003e\",\"clipOnFinder.popup.foundFrames\":\"Here's the frame we found.\",\"myorder.prescription.modal.title\":\"Prescription for item\",\"prescription.type.readers\":\"Readers\",\"Pdp.Sku.VirtualTryOn\":\"{\\n  buttonText: 'VIRTUAL TRY ON',\\n  text: 'COLOR OPTIONS',\\n}\",\"prescription.reader.strength.text\":\"Strength\",\"account.btnLogoutMobile\":\"Log Out\",\"switchCountry.welcomeUSTitle\":\"Welcome to Zenni USA\",\"account.btnLogoutDesktop\":\"Log Out\",\"sign.in.log.in.mobile\":\"Log In\",\"switchCountry.welcomeUSDescription\":\"You're currently shopping our U.S. site.\\n\\n\",\"switchCountry.welcomeCATitle\":\"Welcome to Zenni Canada\",\"global.search.searchFor\":\"Search for...\",\"sign.in.log.in\":\"Sign In\",\"global.search.viewAllResults\":\"View All Results\",\"sign.in.new.to.zenni\":\"New to Zenni? Sign up now!\",\"sign.up.create.account\":\"CREATE ACCOUNT\",\"global.search.go\":\"Go\",\"sign.up.password.invalid\":\"Please enter a valid password\",\"sign.up.rewards.agree\":\"By creating an account, you agree to our rewards program.\",\"sign.up.email.invalid\":\"Please enter a valid email address.\",\"sign.up.email.required\":\"Email is required.\",\"sign.in.create.new.account\":\"Create New Account\",\"sign.in.rewards.agree\":\"By creating an account, you agree to our rewards program.\",\"sign.in.sign.in\":\"SIGN IN\",\"switchCountry.CADescription\":\"\\t\\n\u003cp\u003eYou’re currently shopping our Canadian site.\u003c/p\u003e\\n\\n\u003cp\u003eTo make a purchase on our U.S. site, you’ll need to create a separate account.\u003c/p\u003e\",\"login.btnLoginMobile\":\"Log In\",\"switchCountry.shopZenniCanada\":\"SHOP ZENNI CANADA\",\"switchCountry.USDescription\":\"\u003cp\u003eYou’re currently shopping our United States site.\u003c/p\u003e\\n\u003cp\u003eTo make a purchase on our Canadian site, you’ll need to create a separate account.\u003c/p\u003e\",\"sign.in.create.account\":\"CREATE ACCOUNT\",\"switchCountry.shopZenniUSA\":\"SHOP ZENNI USA\",\"switchCountry.title\":\"Select Your Location\",\"order.confirm.items.order.frame\":\"Frame: T\",\"payment.details\":\"PAYMENT DETAILS\",\"my.order.detail.order.date.title\":\"Order date:\",\"pdp.rimless.tooltipsContent \":\"\u003cdiv class=\\\"message\\\"\u003e\u003cp\u003eA lens shape must be chosen for rimless glasses.\u0026nbsp; Click the “Select a Lens Shape” link and a pop-up will open.\u0026nbsp;\u0026nbsp; If you wear bifocals or progressives, you can only choose from the lens shapes on the Progressive/Bifocal tab.\u0026nbsp; If you wear single vision lenses, you can choose from any of the displayed lens shapes on Single Vision tab.\u003c/p\u003e\u003cbr\u003e\u003cp\u003eLens shapes are only available in the size displayed.\u0026nbsp; Keep in mind that a really wide lens will result in wide glasses.\u0026nbsp; Choose a lens shape with a lens width similar to what you currently wear and not just by the shape of the len.\u003c/p\u003e\u003c/div\u003e\",\"my.order.detail.shipping.method.title\":\"Shipping Method:\",\"my.order.detail.payment.method.title\":\"Payment Method:\",\"global.product.engraving.text.outside\":\"Text Outside:\",\"global.product.engraving.icon.outside\":\"Art\",\"my.order.detail.shipping.address.title\":\"Shipping Address:\",\"global.product.engraving.text.inside\":\"Text Inside:\",\"my.orders.lens.text\":\"Lens:\",\"my.order.detail.order.status\":\"Order Status:\",\"my.order.detail.shipped.tracking\":\"Shipped with Tracking #:\",\"my.order.detail.show.details\":\"Show Details\",\"visibly.prescription.detail.sphMobileLabel\":\"(SPH)\",\"visibly.prescription.list.prismHelpTitle\":\"PRISM VALUES\",\"visibly.prescription.form.osaxis.label\":\"Axis\",\"visibly.prescription.review.errorLabel\":\"Error!\",\"visibly.prescription.form.osaxis.validate\":\"Please enter OS Axis.\",\"visibly.prescription.list.prismHelpSubTitle\":\"This prescription has a prism value.\",\"visibly.prescription.list.backLabel\":\"Back\",\"visibly.prescription.review.continueLabel\":\"Continue\",\"visibly.prescription.form.pdSingle.select\":\"Enter your pupillary distance\",\"visibly.prescription.form.pdLeft.placeholder\":\"Select your pupillary distance for left\",\"visibly.prescription.detail.pdLabel\":\"PD-Pupillary Distance: \",\"visibly.prescription.form.pdLeft.required\":\"Please enter Left PD.\",\"visibly.prescription.form.pdSingle.required\":\"Please enter Single PD.\",\"visibly.qualify.fail.findFramesLabel\":\"Find frames\",\"sign.up.prompt.google.email\":\"Or sign up with your email\",\"visibly.prequalify.message.sessionExpired\":\"Session expired, please re-login.\",\"visibly.prescription.form.osaxis.placeholder\":\"Axis\",\"sign.up.prompt.google.subcopy\":\"Fewer passwords, less headaches: Keep everything simple and secure by signing up with your Google account.\",\"sign.in.gsi.label\":\"Or\",\"plp.filter.pupillaryDistance\":\"\u003cdiv class=\\\"tool-tip-content\\\" role=\\\"tooltip\\\" id=\\\"Pupillary Distance\\\"\u003e\\n  \u003cdiv class=\\\"modal-header\\\"\u003e\\n    \u003ch4 class=\\\"modal-title\\\" id=\\\"comp-questions-modal-title\\\"\u003e\\n      PUPILLARY DISTANCE (PD)\\n    \u003c/h4\u003e\\n  \u003c/div\u003e\\n  \u003cdiv class=\\\"modal-body\\\"\u003e\\n    \u003cul class=\\\"question-tips\\\"\u003e\\n      \u003cli class=\\\"question-tips-item\\\"\u003e\\n        \u003cspan style=\\\"font-weight: bold\\\"\u003ePupillary Distance (PD),\u003c/span\u003e\\n        the distance between the centers of your pupils, determines where you\\n        look through the lens of your glasses. Ensure your best vision by\\n        finding this measurement on your prescription or using our virtual PD\\n        reader when customizing your lens.\\n      \u003c/li\u003e\\n    \u003c/ul\u003e\\n  \u003c/div\u003e\\n  \u003cdiv class=\\\"modal-footer\\\"\u003e\u003c/div\u003e\\n\u003c/div\u003e\",\"sign.in.prompt.zenni\":\"You already have a Zenni account with this email address.\",\"sign.in.prompt.zenni.subcopy\":\"Please sign in with your Zenni credentials.\",\"sign.in.prompt.google\":\"Looks like you already have a Zenni account that's using your Google account.\",\"plp.filter.lensWidth\":\"\u003cdiv class=\\\"tool-tip-content\\\" role=\\\"tooltip\\\" id=\\\"Lens Width\\\"\u003e\\n  \u003cdiv class=\\\"modal-header\\\"\u003e\\n    \u003ch4 class=\\\"modal-title\\\" id=\\\"comp-questions-modal-title\\\"\u003eLENS WIDTH\u003c/h4\u003e\\n  \u003c/div\u003e\\n  \u003cdiv class=\\\"modal-body\\\"\u003e\\n    \u003cul class=\\\"question-tips\\\"\u003e\\n      \u003cli class=\\\"question-tips-item\\\"\u003e\\n        The\\n        \u003cspan style=\\\"font-weight: bold\\\"\u003elens width\u003c/span\u003e\\n        is the horizontal diameter of one lens.\\n      \u003c/li\u003e\\n    \u003c/ul\u003e\\n  \u003c/div\u003e\\n  \u003cdiv class=\\\"modal-footer\\\"\u003e\u003c/div\u003e\\n\u003c/div\u003e\",\"plp.filter.lensHeight\":\"\u003cdiv class=\\\"tool-tip-content\\\" role=\\\"tooltip\\\" id=\\\"Lens Height\\\"\u003e\\n  \u003cdiv class=\\\"modal-header\\\"\u003e\\n    \u003ch4 class=\\\"modal-title\\\" id=\\\"comp-questions-modal-title\\\"\u003eLENS HEIGHT\u003c/h4\u003e\\n  \u003c/div\u003e\\n  \u003cdiv class=\\\"modal-body\\\"\u003e\\n    \u003cul class=\\\"question-tips\\\"\u003e\\n      \u003cli class=\\\"question-tips-item\\\"\u003e\\n        The\\n        \u003cspan style=\\\"font-weight: bold\\\"\u003elens height\u003c/span\u003e\\n        measures the vertical height of the lens.\\n      \u003c/li\u003e\\n    \u003c/ul\u003e\\n  \u003c/div\u003e\\n  \u003cdiv class=\\\"modal-footer\\\"\u003e\u003c/div\u003e\\n\u003c/div\u003e\",\"plp.filter.bridgeWidth\":\"\u003cdiv class=\\\"tool-tip-content\\\" role=\\\"tooltip\\\" id=\\\"Bridge Width\\\"\u003e\\n  \u003cdiv class=\\\"modal-header\\\"\u003e\\n    \u003ch4 class=\\\"modal-title\\\" id=\\\"comp-questions-modal-title\\\"\u003eBRIDGE WIDTH\u003c/h4\u003e\\n  \u003c/div\u003e\\n  \u003cdiv class=\\\"modal-body\\\"\u003e\\n    \u003cul class=\\\"question-tips\\\"\u003e\\n      \u003cli class=\\\"question-tips-item\\\"\u003e\\n        The\\n        \u003cspan style=\\\"font-weight: bold\\\"\u003ebridge width\u003c/span\u003e\\n        is the part of the frame that goes across the bridge of your nose.\\n      \u003c/li\u003e\\n    \u003c/ul\u003e\\n  \u003c/div\u003e\\n  \u003cdiv class=\\\"modal-footer\\\"\u003e\u003c/div\u003e\\n\u003c/div\u003e\",\"plp.filter.universalBridgeFit\":\"\u003cdiv class=\\\"tool-tip-content\\\" role=\\\"tooltip\\\" id=\\\"Universal Fit\\\"\u003e\\n  \u003cdiv class=\\\"modal-header\\\"\u003e\\n    \u003ch4 class=\\\"modal-title\\\" id=\\\"comp-questions-modal-title\\\"\u003eUNIVERSAL FIT\u003c/h4\u003e\\n  \u003c/div\u003e\\n  \u003cdiv class=\\\"modal-body\\\"\u003e\\n    \u003cul class=\\\"question-tips\\\"\u003e\\n      \u003cli class=\\\"question-tips-item\\\"\u003e\\n        Designed to fit comfortably on most faces.\\n      \u003c/li\u003e\\n      \u003cli class=\\\"question-tips-item\\\"\u003e\\n        Narrow bridge and raised nose piece prevent sliding down your face.\\n      \u003c/li\u003e\\n    \u003c/ul\u003e\\n  \u003c/div\u003e\\n  \u003cdiv class=\\\"modal-footer\\\"\u003e\u003c/div\u003e\\n\u003c/div\u003e\",\"plp.filter.extendedFit\":\"\u003cdiv class=\\\"tool-tip-content\\\" role=\\\"tooltip\\\" id=\\\"Extended Fit\\\"\u003e\\n  \u003cdiv class=\\\"modal-header\\\"\u003e\\n    \u003ch4 class=\\\"modal-title\\\" id=\\\"comp-questions-modal-title\\\"\u003eEXTENDED FIT\u003c/h4\u003e\\n  \u003c/div\u003e\\n  \u003cdiv class=\\\"modal-body\\\"\u003e\\n    \u003cul class=\\\"question-tips\\\"\u003e\\n      \u003cli class=\\\"question-tips-item\\\"\u003e\\n        Wider frames with longer temple arms for larger faces.\\n      \u003c/li\u003e\\n    \u003c/ul\u003e\\n  \u003c/div\u003e\\n  \u003cdiv class=\\\"modal-footer\\\"\u003e\u003c/div\u003e\\n\u003c/div\u003e\",\"global.recommended.carousel.fastframe\":\"2-3 Day Delivery\",\"plp.filter.narrowFit\":\"\u003cdiv class=\\\"tool-tip-content\\\" role=\\\"tooltip\\\" id=\\\"Narrow Fit\\\"\u003e\\n  \u003cdiv class=\\\"modal-header\\\"\u003e\\n    \u003ch4\\n      class=\\\"modal-title\\\"\\n      id=\\\"comp-questions-modal-title\\\"\\n    \u003e\\n      NARROW FIT\\n    \u003c/h4\u003e\\n  \u003c/div\u003e\\n  \u003cdiv class=\\\"modal-body\\\"\u003e\\n    \u003cul class=\\\"question-tips\\\"\u003e\\n      \u003cli class=\\\"question-tips-item\\\"\u003e\\n        Narrow frame width and shorter temple arms for smaller faces.\\n   