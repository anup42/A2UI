:\"CardVariantA\",\"configJson\":{\"cards\":[{\"body\":\"Make a resolution for better vision with easy eye health and wellness tips.\",\"image\":{\"lg\":\"/marketing/campaign/CSR/HP/251217-Clear-Start-CSR-HP-Tile-card-lg.png\",\"md\":\"/marketing/campaign/CSR/HP/251217-Clear-Start-CSR-HP-Tile-card-md.png\",\"sm\":\"/marketing/campaign/CSR/HP/251217-Clear-Start-CSR-HP-Tile-card-sm.png\",\"xl\":\"/marketing/campaign/CSR/HP/251217-Clear-Start-CSR-HP-Tile-card-xl.png\",\"xs\":\"/marketing/campaign/CSR/HP/251217-Clear-Start-CSR-HP-Tile-card-xs.png\",\"xxl\":\"/marketing/campaign/CSR/HP/251217-Clear-Start-CSR-HP-Tile-card-xxl.png\",\"xxs\":\"/marketing/campaign/CSR/HP/251217-Clear-Start-CSR-HP-Tile-card-xxs.png\",\"default\":\"xxs\"},\"title\":\"NEW YEAR, CLEAR START\",\"buttons\":[{\"url\":\"/impact\",\"text\":\"Learn more\",\"variant\":\"secondary\"}],\"cardUrl\":\"/impact\",\"imageAlt\":\"A profile illustration of a person wearing round glasses, whose open head is filled with blooming white and orange flowers, set against a light blue background.\",\"bodyColor\":\"--black\",\"titleColor\":\"--black\",\"eyeBrowText\":\"\",\"titleVariant\":\"d5\",\"eyeBrowTextColor\":\"--black\",\"overrideTitleTag\":\"h3\",\"contentBlockVerticalAlign\":\"bottom\",\"mobileContentBlockMaxWidth\":\"60%\",\"contentBlockHorizontalAlign\":\"left\"},{\"body\":\"Join millions who have found a clearly better way to care for their vision and express their style with affordable glasses.\",\"image\":{\"lg\":\"/marketing/campaign/CSR/HP/250718-Brand-Winter-Q4-Motif-CSR-HP-Tile-card-lg.png\",\"md\":\"/marketing/campaign/CSR/HP/250718-Brand-Winter-Q4-Motif-CSR-HP-Tile-card-md.png\",\"sm\":\"/marketing/campaign/CSR/HP/250718-Brand-Winter-Q4-Motif-CSR-HP-Tile-card-sm.png\",\"xl\":\"/marketing/campaign/CSR/HP/250718-Brand-Winter-Q4-Motif-CSR-HP-Tile-card-xl.png\",\"xs\":\"/marketing/campaign/CSR/HP/250718-Brand-Winter-Q4-Motif-CSR-HP-Tile-card-xs.png\",\"xxl\":\"/marketing/campaign/CSR/HP/250718-Brand-Winter-Q4-Motif-CSR-HP-Tile-card-xxl.png\",\"xxs\":\"/marketing/campaign/CSR/HP/250718-Brand-Winter-Q4-Motif-CSR-HP-Tile-card-xxs.png\",\"default\":\"xxs\"},\"title\":\"EYEWEAR FOR EVERYONE™\",\"buttons\":[{\"url\":\"/about-us\",\"text\":\"Our story\",\"variant\":\"secondary\"}],\"cardUrl\":\"/about-us\",\"imageAlt\":\"The image shows three illustrated characters dressed in winter clothing, standing together and waving against a light blue snowy background with small star-like accents.\",\"bodyColor\":\"--black\",\"titleColor\":\"--black\",\"titleVariant\":\"d5\",\"introGraphical\":{\"xs\":\"/marketing/logo/zenni-square-dark-teal-logo.png\",\"default\":\"xs\"},\"overrideTitleTag\":\"h3\",\"introGraphicalAlt\":\"Zenni logo\",\"introGraphicalWidth\":\"50px\",\"contentBlockVerticalAlign\":\"bottom\",\"mobileContentBlockMaxWidth\":\"60%\",\"contentBlockHorizontalAlign\":\"left\"}],\"widgetId\":\"csr-two-card-variant-a\",\"marginTop\":24}}],[\"$\",\"$L69\",\"4S3qMvxpNRxvavOejRkoOB-16\",{\"name\":\"Homepage - Featured Content - Payment Options\",\"componentType\":\"FeaturedContent\",\"configJson\":{\"widgetId\":\"payment-options-featured-content\",\"sectionTitle\":\"Payment Options Available\",\"sectionTitleVariant\":\"d4\",\"sectionSubtitle\":\"Shop now and pay over time with our flexible payment options.\",\"widgetHeaderAlign\":\"center\",\"widgetWrapperBackground\":{\"color\":\"--gray-100\"},\"cardDirection\":\"horizontal\",\"featuredContent\":[{\"size\":\"large\",\"title\":\"Pay in 4 interest-free payments\",\"modalButton\":\"\u003cspan class=\\\"link\\\"\u003eLearn more\u003c/span\u003e\",\"backgroundColor\":\"--white\",\"type\":\"image\",\"logoUrl\":\"//static.zennioptical.com/marketing/checkout/payment/paypal.svg\",\"logoAlt\":\"Paypal Logo\",\"modal\":{\"title\":\"Paypal\",\"body\":\"\u003cp\u003eSplit your purchase into 4 interest-free payments, every 2 weeks. Available on orders of $30-$1500.\u003c/p\u003e\u003cp\u003ePay in 4 is available to consumers upon approval for purchases of $30 to $1, 500. Pay in 4 is currently not available to residents of MO or NV. Offer availability depends on the merchant and also may not be available for certain recurring, subscription services. When applying, a soft credit check may be needed, but will not affect your credit score. You must be 18 years old or older to apply. PayPal, Inc.: Loans to CA residents are made or arranged pursuant to a CA Financing Law License. GA Installment Lender Licensee, NMLS #910457. RI Small Loan Lender Licensee. NM residents: \u003ca href=\\\"https://www.paypal.com/us/webapps/mpp/campaigns/newmexicodisclosure\\\" target=\\\"_blank\\\" rel=\\\"noopener noreferrer\\\" class=\\\"link\\\"\u003eFind more disclosures\u003c/a\u003e related to Pay in 4.\u003c/p\u003e\"}},{\"size\":\"large\",\"title\":\"Monthly payments with Affirm\",\"modalButton\":\"\u003cspan class=\\\"link\\\"\u003eLearn more\u003c/span\u003e\",\"backgroundColor\":\"--white\",\"type\":\"image\",\"logoUrl\":\"//static.zennioptical.com/marketing/checkout/payment/affirm.svg\",\"logoAlt\":\"Affirm Logo\",\"modal\":{\"title\":\"Affirm\",\"body\":\"\u003cp\u003eWith Affirm you can pay over time with monthly payments of 3, 6, or 12 months. Your rate will be 10%-36% APR based on credit, and is subject to an eligibility check.\u003c/p\u003e\u003cp\u003ePayment options through Affirm are provided by these lending partners: \u003ca href=\\\"http://affirm.com/lenders\\\" class=\\\"link\\\" target=\\\"_blank\\\" rel=\\\"noopener noreferrer\\\"\u003ehttp://affirm.com/lenders\u003c/a\u003e . Options depend on your purchase amount and a down payment may be required.\u003c/p\u003e\"}},{\"size\":\"large\",\"title\":\"Pay in 4 interest-free payments\",\"modalButton\":\"\u003cspan class=\\\"link\\\"\u003eLearn more\u003c/span\u003e\",\"backgroundColor\":\"--white\",\"type\":\"image\",\"logoUrl\":\"//static.zennioptical.com/marketing/checkout/payment/afterpay.svg\",\"logoAlt\":\"Afterpay Logo\",\"modal\":{\"title\":\"Afterpay\",\"body\":\"$6a\"}}]}}]]\n"])</script><script type="text/javascript"  src="/DZuSzA/LUs/mBT/Z8ZntvCY/3bOaJSYaf53w0mNaa7/aXtKDWIB/DyYTWG/FQTCkB"></script><link rel="stylesheet" type="text/css"  href="/DZuSzA/LUs/mBT/Z8ZntvCY/4fOa3E/YWQwDWIB/FwBPNQ/1sQB9Z"><script  src="/DZuSzA/LUs/mBT/Z8ZntvCY/4fOa3E/YWQwDWIB/CnZ8LQ/QWHkwp" async defer></script><div id="sec-overlay" style="display:none;"><div id="sec-container"></div></div></body></html>