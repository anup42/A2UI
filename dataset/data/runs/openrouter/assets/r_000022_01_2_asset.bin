<!-- change id= to classes in order to update all similar ids -->
<!-- https://stackoverflow.com/questions/4035570/how-can-i-apply-jquery-on-all-elements-with-same-id-attribute -->
<script type='text/javascript'>
    function guhl(i) {
        var id = i;
        var url = "/Home/GUHL";
        $.post(url, { id: id }, function (result) {
            //$('#' + id).blur();
            $('#' + id).text(result.msg);
            //alert(result.success);
            if (result.success) {
                window.open(result.msg, "_blank");
            }
            });
}
</script>

<div class="cg-search-dropdowns-container">
    <div class="cg-search-dropdowns-container-title">CalGold v2 - Permit Assistance Tool</div>

    <h4>
        This website assists you in finding appropriate permit information for your business.
        It also provides contact information for the various agencies that administer & issue these permits.
        Select your primary business location and business type below:
    </h4>

