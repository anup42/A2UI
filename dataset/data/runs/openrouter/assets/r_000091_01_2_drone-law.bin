.top-bar .toggle-topbar.menu-icon a {
  padding: 10px 15px;
}
.top-bar .toggle-topbar.menu-icon a i {
  font-weight: 400;
  font-style: normal;
}
.top-bar .toggle-topbar.menu-icon a i:before {
  width: 30px;
  height: 30px;
  color: #fff;
  font-family: "FontAwesome";
  font-size: 24px;
}
.single-page__content p a {
  text-decoration: underline;
}
.single-page__content p a:hover {
  color: #318570;
}
.booking-info {
  text-align: center;

  margin-bottom: 40px;
}

.uav-items {
  display: flex;
  flex-direction: column;
  font-family: "Open Sans", sans-serif;
  text-decoration: none !important;
}

.uav-items__titles {
  display: none;
  background-color: #0d5276 !important;
  border-top-left-radius: 5px;
  border-top-right-radius: 5px;
  text-transform: uppercase;
  color: #fff;
  text-align: center;
  padding: 7px 7px;
  align-items: center;
  font-weight: bold !important;
  font-size: 15px;
  font-family: "Montserrat", sans-serif;
}
.uav-item {
  display: flex;
  border: 1px solid #dcdcdc;
  border-top: none;
  border-top-left-radius: 5px;
  border-top-right-radius: 5px;
  text-decoration: none;
  flex-wrap: wrap;
  margin: 4px 0 !important;
  border-bottom-left-radius: 5px;
  border-bottom-right-radius: 5px;
  padding-bottom: 5px;
  line-height: 20px !important;
}

a.uav-item:hover {
  text-decoration: none !important;
}

a.uav-item:link {
  text-decoration: none !important;
}

.uav-item__features-list {
  list-style-position: outside;
  font-weight: normal;
  list-style-type: none;
  padding-left: 1;
}

.uav-item__title-image,
.uav-item__column-image {
  width: 25%;
}

.uav-item__title-product,
.uav-item__column-product {
  width: 40%;
  flex-direction: column;
  margin: 0px 0px 0px 0px;
  padding: 0px 0px 0px 0px;
}

.uav-item__title-features,
.uav-item__column-features,
.uav-item__column-features-mobile {
  width: 0%;
  padding-left: 0px;
  padding-right: 0px;
}

.uav-item__column-button {
  width: 35%;
}
.uav-item__column-image {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: auto;
  max-width: 150px;
  height: 150px;
  transform: scale(1.05);
}

.uav-item__image {
  max-width: 95%;
  max-height: 140px;
  margin: 5px 0 0 0 !important;
}
.uav-item__column-features {
  display: flex;
  align-items: center;
  color: black;
  margin-top: 0px;
  display: none;
}

.uav-item__column-features-mobile {
  display: flex;
  align-items: left;
  color: black;
  margin-top: 0px;
  display: none;
}

.uav-item__column-product {
  display: flex;
  justify-content: center;
  flex-direction: column;
  color: #222;
}

.uav-item__column-title {
  text-align: left;
  margin: 5px 0px 5px 0px;
  font-family: "Montserrat", sans-serif;
  color: #0d5276;
  font-size: 22px !important;
  font-weight: bold;
  margin-top: 10px;
}

.uav-item__link-label {
  color: #fff;
  line-height: 18px;
  font-weight: 600;
  text-align: center;
  text-transform: uppercase;
  background: #6da3c7;
  text-decoration: none;
  width: 100%;
  margin: 0px 0px 0px 0px;
  border-radius: 0px;
  padding: 2px 5px;
  letter-spacing: 0.5px;
  font-weight: bold !important;
  font-size: 12px;
  justify-content: center;
  border-top-left-radius: 5px;
  border-top-right-radius: 5px;
}

.uav-item__link-label:empty {
  display: none;
}

.uav-item__stars {
  color: #000;
  display: flex;
  font-size: 15px;
  padding: 4px 6px;
  text-transform: uppercase;
  text-align: center;
  margin: auto;
  margin-top: 0px;
  width: 100px;
}

.uav-item__features-item {
  line-height: 20px;
  margin-top: 0px;
  margin-bottom: 3px !important;
  margin-left: 0px;
  color: #222 !important;
  position: relative;
  font-size: 14px !important;
  text-align: left;
}

.uav-item__features-item:empty {
  display: none;
}

.uav-item__features-item span {
  color: #6da3c7 !important;
  position: relative;
  font-size: 15px !important;
  font-weight: bolder;
  text-transform: uppercase;
}

.uav-item__features-item-mobile {
  line-height: 20px;
  margin-top: 5px;
  margin-bottom: 0px !important;
  margin-left: 5px;
  color: #222 !important;
  position: relative;
  font-size: 14px !important;
}

.uav-item__features-item-mobile:empty {
  display: none;
}

.uav-item__features-item-mobile span {
  color: #6da3c7 !important;
  position: relative;
  font-size: 15px !important;
  font-weight: bolder;
  text-transform: uppercase;
}

.uav-item__column-button {
  display: flex;
  align-items: center;
  justify-content: center;
}

.uav-item__button {
  background-color: #318570;
  line-height: 18px !important;
  text-decoration: none !important;
  text-transform: uppercase;
  color: #fff !important;
  font-family: "Montserrat", sans-serif !important;
  font-size: 12px !important;
  letter-spacing: 0.2px;
  border-radius: 4px;
  padding: 10px 14px;
  width: 90%;
  margin-right: 20px;
  margin-left: 20px;
  margin-bottom: 0 !important;
  text-align: center !important;
  transition: 0.2s linear;
  -webkit-box-shadow: 0px 1px 1px 0px rgba(0, 0, 0, 0.3);
  -moz-box-shadow: 0px 1px 1px 0px rgba(0, 0, 0, 0.3);
  box-shadow: 0px 1px 1px 0px rgba(0, 0, 0, 0.3);
}
.uav-item__button:hover {
  background-color: #2fcac8;
}

.uav-item__link {
  flex-basis: 100%;
}

.uav-items p {
  display: none;
}

@media screen and (max-width: 780px) {
  .uav-item {
    flex-wrap: wrap;
    padding: 0px;
  }
  .uav-item__title-image,
  .uav-item__title-features {
    display: none;
  }
  .uav-item__title-product,
  .uav-item__column-image,
  .uav-item__column-product,
  .uav-item__column-features,
  .uav-item__column-features-mobile,
  .uav-item__column-button {
    width: 100%;
