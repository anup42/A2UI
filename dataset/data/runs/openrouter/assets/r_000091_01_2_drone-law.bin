  margin: 0px 0px 0px 0px;
  padding: 0px 0px 0px 0px;
}

.uavtbl-item__title-features,
.uavtbl-item__column-features,
.uavtbl-item__column-features-mobile {
  width: 0%;
  padding-left: 0px;
  padding-right: 0px;
}

.uavtbl-item__column-button {
  width: 35%;
}

.uavtbl-item__column-image {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: auto;
  max-width: 150px;
  height: 150px;
  transform: scale(1);
}

.uavtbl-item__image {
  max-width: 90% !important;
  max-height: 150px;
  margin: 5px 0 0 0 !important;
}

.uavtbl-item__column-features {
  display: flex;
  align-items: center;
  color: black;
  margin-top: 0px;
  display: none;
}

.uavtbl-item__column-features-mobile {
  display: flex;
  align-items: left;
  color: black;
  margin-top: 0px;
  display: none;
}

.uavtbl-item__column-product {
  display: flex;
  justify-content: center;
  flex-direction: column;
  color: #222;
}

.uavtbl-item__column-title {
  text-align: left;
