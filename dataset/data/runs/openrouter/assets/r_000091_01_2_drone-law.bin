    /* Header */
    header.uav_header{
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height:60px;
	  transition: top 0.3s ease-in-out;
	  background-color: #ffffff;
      border-bottom: 1px solid #b2c0cb;
		position:relative;
		z-index:999;
    }

    .uav_header .header-inner {
      display: flex;
	  font-family: "Montserrat", sans-serif;
      justify-content: space-between;
      gap: 30px;
      max-width: 1300px;
      width: 100%;
      margin: 0 auto;
    }
	.uav_header .header-inner .col-1 {
		width: auto;
		display: flex;
	}
	.uav_header .header-inner .col-2 {
		width: 440px;
		display: flex;
		justify-content: flex-end;
	}
    .uav_header .logo {
      font-size: 20px;
      font-weight: bold;
      color: #004c70;
	  display: flex;
	  padding:10px 10px 10px 10px;
    }
	  .uav_header .logo img{
		   padding:0px;
	  }
	  .uav_header a,
	  .uav_header p,
	  .uav_header span
	  .uav_header ul,
	  .uav_header li,
	  .uav_header {
		  font-family: "Montserrat", sans-serif;
		  font-weight:500;
	  }
    .uav_header .logo-link {
	  font-family: "Montserrat", sans-serif;
      display: inline-flex;
      align-items: center;
      text-decoration: none;
    }

    .uav_header .logo-link img {
      height: 36px;
      vertical-align: middle;
      margin-right: 8px;
    }

    /* Nav */
    .uav_header .nav {
		font-family: "Montserrat", sans-serif;
      display: flex;
      gap: 3px;
      align-items: center;
      margin: 0;
      padding: 0;
	  margin-bottom: -1px;
    }

    .uav_header .nav>li {
	  font-family: "Montserrat", sans-serif;
		list-style: none;
		cursor: pointer;
		font-weight: bold;
		position: static;
		padding: 20px;
		border-bottom: 3px solid transparent;
    }
	  .uav_header .nav>li.active,
	  .uav_header .nav>li:hover{
		  border-bottom: 3px solid #025377;
		  background-color: #f3f4f6;
	  }
	.uav_header .nav>li>a {
		font-size: 16px;
		display: flex;
		align-items: center;
		gap: 5px;
		justify-content: space-between;
	}
	  .uav_header .nav>li:hover > a,
	  .uav_header .nav>li.menu-item.active:hover > a{
			color: #025377;
		}
	.uav_header .nav>li a {
		font-family: "Montserrat", sans-serif;
		font-weight: 600;
		color:#000000;
	}


    /* Arrow icon */
    .uav_header .nav>li i.fa {
      transition: transform 0.3s ease;
      font-size: 18px;
      margin-top: 0px;
      margin-left: 6px;
    }
	 
    .uav_header .nav>li.active i.fa {
      transform: rotate(180deg);
    }

    /* Right side */
    .uav_header .header-right {
		font-family: "Montserrat", sans-serif;
      display: flex;
      align-items: center;
      gap: 20px;
		padding-right:10px;
    }
	
	.uav_header .header-right a {
		color: #000;
		font-size:14px;
	}
	  .uav_header .header-right a:hover {
		color: #025377;
	}

    .uav_header  a.subscribe-btn {
	  font-family: "Montserrat", sans-serif;
      background: #68c2c6;
      color: #fff;
      border: none;
      padding: 8px 15px;
      font-size: 14px;
      cursor: pointer;
      border-radius: 5px;
      font-weight: bold;
	  margin-bottom: 0px;
	  border:1px solid #fff;
    }
	.uav_header a.subscribe-btn:hover {
      background-color: #025377;
      color: #fff;
    }

    /* Mega menu */
    .uav_header .mega-menu {
		font-family: "Montserrat", sans-serif;
      display: none;
      position: absolute;
	top: 100%;
      left: 0;
      width: 100vw;
      background-color: #fff;
	  border-top: 1px solid #b2c0cb;
	  border-bottom: 1px solid #b2c0cb;
      justify-content: center;
      z-index: 1000;
      opacity: 0;
      transform: translateY(20px);
/*       transition: all 0.3s ease; */
    }

    .uav_header .mega-menu.active {
      display: flex;
      opacity: 1;
      transform: translateY(0);
	  flex-wrap: wrap;
    }
	 /* Overlay */
	.menu-overlay {
	  position: fixed;
	  top: 0;
	  left: 0;
	  width: 100%;
	  height: 100%;
	  background: rgba(0,0,0,0.45); /* tweak opacity */
	  z-index: 2;               /* must be lower than mega menu z-index */
	  opacity: 0;
	  pointer-events: none;
	  transition: opacity 180ms ease;
	}

	/* visible state */
	.menu-overlay.visible {
	  opacity: 1;
	  pointer-events: auto;
	}

 /* End  Overlay */
	  
    .uav_header .mega-inner {
		font-family: "Montserrat", sans-serif;
      display: flex;
      justify-content: space-between;
/*       gap: 30px; */
      padding: 15px;
      max-width: 1300px;
      width: 100%;
	  flex-wrap: wrap;
    }

    .uav_header .mega-col {
/*       flex: 1; */
      min-width: 120px;
	  padding-left:30px;
	  padding-right:30px;
      border-right: 1px solid #b2c0cb;
    }
	  .uav_header .mega-col:first-child {
		 padding-left:0px;
	  }
	  
    .uav_header .mega-col:last-child {
      border-right: none;
	  padding-right:0px;
    }
		.uav_header .card-img img{
			padding: 0px 0px;
			max-width: 250px;
    		width: 100%;
		}
    .uav_header .mega-col h4 {
		font-family: "Montserrat", sans-serif;
      margin-bottom: 15px;
		text-transform:uppercase;
      font-size: 14px;
		font-weight:600;
      color: #025377;
    }

    .uav_header .mega-col ul {
      padding: 0;
      margin: 0;
      list-style: none;
    }

    .uav_header .mega-col ul li {
		font-family: "Montserrat", sans-serif;
      	margin-bottom: 16px;
      	font-size: 14px;
		font-weight:600;
    }
	  .uav_header .nav .mega-col ul li a{
			width:100%;
		    display: block;
		   font-size:18px;
		   font-weight:500;
		}
	  .uav_header .mega-col ul li:hover a {
			color: #025377;
		}
    .uav_header .btn-container {
		text-align: center;
		display: flex;
		width: 100%;
		justify-content: center;
		
		margin-bottom: 30px;
		max-width: 1200px;
	}

    .uav_header .view-all {
	  font-family: "Montserrat", sans-serif;
      padding: 10px 35px;
      border: 1px solid #025377;
      border-radius: 5px;
	  color: #025377 !important;
      background: #fff;
      cursor: pointer;
      font-size: 14px;
	  display: inline-block;
      width: auto;
    }

    .uav_header .view-all:hover {
      background-color: #025377;
      color: #fff !important;
      border-color: #fff;
    }

    /* --- Mobile Responsive --- */
    .uav_header .hamburger {
