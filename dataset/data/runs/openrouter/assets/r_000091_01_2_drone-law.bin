/***** UAV CTA STARTS HERE**/

.uav-cta-container {
  max-width: 300px;
  margin: 10px auto 50px;
  padding: 0;
}

.uav-cta-table {
  border-spacing: 0;
  font-family: "Montserrat", sans-serif;
  width: 100%;
  border: 0px solid #dcdcdc !important;
  background-color: #b00505;
  border-top-left-radius: 5px;
  border-bottom-left-radius: 5px;
  border-top-right-radius: 5px;
  border-bottom-right-radius: 5px;
}

.uav-cta-table a {
  text-decoration: none !important;
}

.uav-cta-table :hover {
  transition: 0.5s all;
  background-color: #ff0000;
  border-top-left-radius: 5px;
  border-bottom-left-radius: 5px;
}

.uav-cta-table__column-title {
  text-align: center;
  color: #fff;
  font-size: 15px;
  font-weight: 400;
  display: block;
  padding: 10px;
  display: table-cell;
  width: 50%;
  line-height: 20px;
  text-transform: uppercase;
}
.uav-cta-table__column-button {
  display: table-cell;
  text-align: center;
  border-top-right-radius: 5px;
  border-bottom-right-radius: 5px;
  width: 10%;
  vertical-align: middle;
  border-left: 2px solid #fff;
}

.uav-cta-table__column-product {
  border-top-left-radius: 5px;
  border-bottom-left-radius: 5px;
  border-top-right-radius: 5px;
  border-bottom-right-radius: 5px;

  width: 90%;
  vertical-align: center;

  margin: 0;
  padding: 0;
}

.uav-cta-table__column-features {
  width: 30%;

  border-right: none !important;
  vertical-align: middle;
  padding: 6px 2px !important;
  display: none;
}

.uav-cta-table__link-label {
  color: #fff;
  line-height: 18px;
  text-align: center;
  text-transform: uppercase;
  background: #2e6a1e;

  text-decoration: none;
  width: 60%;
  letter-spacing: 0.5px;
  font-weight: bold;
  font-size: 14px;
  padding: 2px 2px;
  display: block;
  margin: auto auto 10px auto !important;
}

.uav-cta-table__link-label:empty {
  display: none;
}

.uav-cta-table__column-subtitle {
  text-align: left;
  color: white;
  font-size: 15px;
  font-weight: 400;
  display: block;
  width: 80%;
}

.uav-cta-table__button {
  background-color: #49c24e;

  cursor: pointer;
  color: #ffffff;
  font-family: Helvetica, Arial, sans-serif;
  font-size: 14px;

  line-height: 200px;
  text-decoration: none;
  text-transform: uppercase;
  color: #fff !important;
  font-family: "Helvetica", sans-serif;

  text-align: center;
  transition: 0.2s linear;

  width: 80%;
  margin: auto;
  margin-left: -20px;
  display: block;
  border: 3px solid #49c24e;
}

.uav-cta-table__button:hover {
  padding-left: 10px;
}
.uav-cta-__button_arrow {
  font-size: 25px;
  font-weight: bold;
  color: #fff;
  line-height: 20px;
}

.uav-cta-table2 {
  border-spacing: 0;
  font-family: "Montserrat", sans-serif;
  width: 100%;
  border: 0px solid #dcdcdc !important;

  border-top-left-radius: 5px;
  border-bottom-left-radius: 5px;
  border-top-right-radius: 5px;
  border-bottom-right-radius: 5px;
  background-color: #318570;
}
.uav-cta-table2:hover {
  background-color: #09cac7;
  transition: 0.5s all;
  border-top-left-radius: 5px;
  border-bottom-left-radius: 5px;
}
.uav-cta-table2 a {
  text-decoration: none !important;
}

@media screen and (max-width: 645px) {
  .uav-cta-container {
    max-width: 300px;
    margin: 10px auto 50px;
    padding: 0;
  }
}

/***** UAV CTA ENDS HERE**/

/***** UAV STARTS HERE **/

.uavtbl-items {
  display: flex;
  flex-direction: column;
  font-family: "Open Sans", sans-serif;
  text-decoration: none !important;
  border-collapse: separate;
  border: none;
  padding: 0 !important;
}

.uavtbl-items tr {
  background: none !important;
}

.uavtbl-items td {
  padding: 0 !important;
}

.uavtbl-items__titles {
  display: none;
  background-color: #0d5276 !important;
  border-top-left-radius: 5px;
  border-top-right-radius: 5px;
  text-transform: uppercase;
  color: #fff;
  text-align: center;
  padding: 7px 7px;
  align-items: center;
  font-weight: bold !important;
  font-size: 15px;
  font-family: "Montserrat", sans-serif;
}

.uavtbl-item {
  display: flex;
  border: 1px solid #dcdcdc;
  border-top: none;
  border-top-left-radius: 5px;
  border-top-right-radius: 5px;
  text-decoration: none;
  flex-wrap: wrap;
  margin: 4px 0 !important;
  border-bottom-left-radius: 5px;
  border-bottom-right-radius: 5px;
  padding-bottom: 5px;
  line-height: 20px !important;
}

a.uavtbl-item:hover {
  text-decoration: none !important;
}

a.uavtbl-item:link {
  text-decoration: none !important;
}

a.uavtbl-item__button:link {
  text-decoration: none !important;
}

a.uavtbl-item__button:hover {
  text-decoration: none !important;
}

.uavtbl-item__features-list {
  list-style-position: outside;
  font-weight: normal;
  list-style-type: none;
  padding-left: 1;
}

.uavtbl-item__title-image,
.uavtbl-item__column-image {
  width: 25%;
}

.uavtbl-item__title-product,
.uavtbl-item__column-product {
  width: 40%;
