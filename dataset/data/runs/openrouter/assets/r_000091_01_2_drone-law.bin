<script>
  const menus = document.querySelectorAll('.mega-menu');

  function positionMegaMenu(menu) {
    menu.style.top = "";
    menu.style.left = "0";
    menu.style.width = "100%";
  }

  function resetMegaMenu(menu) {
    menu.style.top = "";
    menu.style.left = "";
    menu.style.width = "";
  }

  function initMenuEvents() {
    document.querySelectorAll('.menu-item').forEach(item => {
      const mega = item.querySelector('.mega-menu');
      item.replaceWith(item.cloneNode(true));
    });

    const items = document.querySelectorAll('.menu-item');

    if (window.innerWidth >= 992) {
      items.forEach(item => {
        const mega = item.querySelector('.mega-menu');
        if (mega) {
          item.addEventListener('mouseenter', function () {
            menus.forEach(menu => {
              if (menu !== mega) {
                menu.classList.remove('active');
                resetMegaMenu(menu);
                if (menu.parentElement && menu.parentElement.classList) {
                  menu.parentElement.classList.remove('active');
                }
              }
            });
            mega.classList.add('active');
            item.classList.add('active');
            positionMegaMenu(mega);
          });

          item.addEventListener('mouseleave', function () {
            mega.classList.remove('active');
            resetMegaMenu(mega);
            item.classList.remove('active');
          });
        }
      });
    } else {
      items.forEach(item => {
        item.addEventListener('click', function (e) {
          e.stopPropagation();
          const mega = this.querySelector('.mega-menu');
          if (!mega) return;

          menus.forEach(menu => {
            if (menu !== mega) {
              menu.classList.remove('active');
              resetMegaMenu(menu);
              if (menu.parentElement && menu.parentElement.classList) {
                menu.parentElement.classList.remove('active');
              }
            }
          });

          const isActive = mega.classList.contains('active');
          mega.classList.toggle('active');
          this.classList.toggle('active', !isActive);
          if (!isActive) {
            positionMegaMenu(mega);
          } else {
            resetMegaMenu(mega);
          }
        });
      });

      document.addEventListener('click', function () {
        menus.forEach(menu => {
          menu.classList.remove('active');
          resetMegaMenu(menu);
          if (menu.parentElement && menu.parentElement.classList) {
            menu.parentElement.classList.remove('active');
          }
        });
      });
    }
  }

  document.addEventListener("DOMContentLoaded", initMenuEvents);
  window.addEventListener("resize", initMenuEvents);

  // Adjust header top position
  document.addEventListener("DOMContentLoaded", function () {
    function adjustHeader() {
      const header = document.querySelector(".uav_header");
      const noticeBar = document.querySelector(".sumome-smartbar-popup");
      if (header) {
        if (noticeBar && noticeBar.offsetHeight > 0) {
          header.style.marginTop = noticeBar.offsetHeight + "px";
        } else {
          header.style.marginTop = "0px";
        }
      }
    }
    adjustHeader();
    window.addEventListener("resize", adjustHeader);
    const observer = new MutationObserver(adjustHeader);
    observer.observe(document.body, { childList: true, subtree: true });
  });
</script>

<script>
const nav = document.querySelector('.nav');
const burger = document.querySelector('.hamburger');

burger.addEventListener('click', function (e) {
  e.stopPropagation();
  nav.classList.toggle('active');
  burger.classList.toggle('active', nav.classList.contains('active'));
});

document.addEventListener('click', function (e) {
  if (!nav.contains(e.target) && !burger.contains(e.target)) {
    nav.classList.remove('active');
    burger.classList.remove('active');
  }
});

function adjustNavPosition() {
  var topBar = document.querySelector('.sumome-smartbar-popup');
  var header = document.querySelector('.uav_header');
  var nav = document.querySelector('.uav_header .nav.active');
  var adminBar = document.getElementById('wpadminbar');
  var adminBarHeight = adminBar ? adminBar.offsetHeight : 0;

  if (header && nav) {
    var headerHeight = header.offsetHeight;
    if (window.innerWidth > 992) {
      var topBarHeight = topBar ? topBar.offsetHeight : 0;
      var totalHeight = topBarHeight + headerHeight + adminBarHeight;
      nav.style.top = totalHeight + "px";
    } else {
      var totalHeight = headerHeight + adminBarHeight;
      nav.style.top = totalHeight + "px";
    }
  }
}
window.addEventListener("load", adjustNavPosition);
window.addEventListener("resize", adjustNavPosition);
var observer = new MutationObserver(adjustNavPosition);
observer.observe(document.body, { childList: true, subtree: true });
document.querySelector('.hamburger').addEventListener('click', function() {
  setTimeout(adjustNavPosition, 50);
});
</script>


			<article class="default">
			<div class="default__top-block">
				<div class="row">
					<div class="large-8 large-centered medium-12 small-12 columns">
						<h1 class="text-center">Master List of Drone Laws (Organized by State &#038; Country)</h1>
						<p style="text-align: center;">A global directory of drone laws and regulations.</p>
					</div>
				</div>
			</div><div class='uavcoach-ad uavcoach-ad-center uavcoach-ad-1'>
<div class="row row-small">

<span data-sumome-listbuilder-embed-id="e10df9a28849cf236b5cb8041fff2bf9c2a9b16cca41742e22e0b6546f269f0f"></span>
</div>

</div>

			    <div class="row row-small">
        <div class="default__standard with_line">
            <p>The global drone industry is booming.</p>
<p>As unmanned aerial vehicle (UAV) technology becomes more advanced, more approachable and more affordable, troves of recreational and commercial drone pilots are entering the drone industry.</p>
<p>Problem is, as it so often happens in such a quickly evolving ecosystem, <strong>policy makers are having a hard time keeping up</strong>. While some countries have clear, established drone laws, many others don&#8217;t, or the existing regulations don&#8217;t take into account how much the UAV landscape has changed over the last several years.</p>
<p><img fetchpriority="high" decoding="async" class="lazy lazy-hidden aligncenter size-large wp-image-6708" src="//uavcoach.com/wp-content/plugins/a3-lazy-load/assets/images/lazy_placeholder.gif" data-lazy-type="image" data-src="https://uavcoach.com/wp-content/uploads/2015/09/drone-laws-guide-1024x383.png" alt="drone laws guide" width="1024" height="383" srcset="" data-srcset="https://uavcoach.com/wp-content/uploads/2015/09/drone-laws-guide-1024x383.png 1024w, https://uavcoach.com/wp-content/uploads/2015/09/drone-laws-guide-300x112.png 300w, https://uavcoach.com/wp-content/uploads/2015/09/drone-laws-guide-768x287.png 768w, https://uavcoach.com/wp-content/uploads/2015/09/drone-laws-guide.png 1100w" sizes="(max-width: 1024px) 100vw, 1024px" /><noscript><img fetchpriority="high" decoding="async" class="aligncenter size-large wp-image-6708" src="https://uavcoach.com/wp-content/uploads/2015/09/drone-laws-guide-1024x383.png" alt="drone laws guide" width="1024" height="383" srcset="https://uavcoach.com/wp-content/uploads/2015/09/drone-laws-guide-1024x383.png 1024w, https://uavcoach.com/wp-content/uploads/2015/09/drone-laws-guide-300x112.png 300w, https://uavcoach.com/wp-content/uploads/2015/09/drone-laws-guide-768x287.png 768w, https://uavcoach.com/wp-content/uploads/2015/09/drone-laws-guide.png 1100w" sizes="(max-width: 1024px) 100vw, 1024px" /></noscript></p>
<p>On this page, we&#8217;ve done our best to lay out drone law links to help you better navigate the UAV industry in your respective U.S. state or country.</p>
<p>While additional drone regulations exist for a wide range of topics, including equipment on board, purpose of flight, airworthiness, and more, our goal with this resource is to focus on <strong>safe and legal piloting of UAVs around the world</strong>.</p>
<p>These links are not exhaustive and simply meant to provide direction. We are not aviation attorneys, so it goes without saying that you should perform additional research on your intended application of sUAS and chosen airspace.</p>
<div style="padding: 15px; background-color: #025377; margin-bottom: 40px; text-align: center;"><span style="color: #09cac7;">Stay informed on regulations, product launches, and breaking news in the drone industry. </span><br />
<strong><a data-sumome-listbuilder-id="7a7d793f-59c2-4a5c-9264-37b2b674bb86"><span style="color: #09cac7;">Subscribe to our weekly drone industry update newsletter.</span></a></strong></div>
