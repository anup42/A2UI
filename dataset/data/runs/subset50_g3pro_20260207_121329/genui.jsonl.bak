 - version: v0.9\n    updateComponents:\n      surfaceId: london-packing-list\n      components[31]:\n        - component: Column\n          id: root\n          children[15]: header,subheader,weather_card,picker_outerwear,picker_footwear,picker_business,picker_casual,picker_essentials,picker_toiletries,divider_1,images_title,images_row,tips_card,divider_2,actions_row\n        - component: Text\n          id: header\n          text: London Business Trip Packing List\n          variant: h1\n        - component: Text\n          id: subheader\n          text: \"Oct 15-17, 2024 | London, UK\"\n          variant: h3\n        - child: weather_content\n          component: Card\n          id: weather_card\n        - component: Column\n          id: weather_content\n          children[2]: weather_title,weather_desc\n        - component: Text\n          id: weather_title\n          text: \"Forecast: Cool, Wet, Windy\"\n          variant: h4\n        - component: Text\n          id: weather_desc\n          text: Temperatures 10°C - 14°C. Heavy rain and strong winds expected on the first two days.\n          variant: body\n        - component: ChoicePicker\n          id: picker_outerwear\n          label: Outerwear (Critical)\n          variant: multipleSelection\n          options[3]{label,value}:\n            Waterproof Trench Coat or Smart Rain Jacket,coat\n            Compact Travel Umbrella,umbrella\n            Wool Scarf,scarf\n          value:\n            path: /outerwear\n        - component: ChoicePicker\n          id: picker_footwear\n          label: Footwear\n          variant: multipleSelection\n          options[2]{label,value}:\n            Waterproof Leather Shoes/Boots,boots\n            Smart Dress Shoes (Indoor),shoes\n          value:\n            path: /footwear\n        - component: ChoicePicker\n          id: picker_business\n          label: Business Attire\n          variant: multipleSelection\n          options[5]{label,value}:\n            Suit or B