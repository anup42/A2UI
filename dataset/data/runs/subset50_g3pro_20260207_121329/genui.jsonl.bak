t\n      theme:\n        agentDisplayName: Project Manager\n        primaryColor: #D32F2F\n  - version: v0.9\n    updateComponents:\n      surfaceId: project-status-report\n      components[50]:\n        - component: Column\n          id: root\n          children[11]: header_section,divider_1,summary_section,divider_2,tasks_section,divider_3,health_section,divider_4,bottleneck_section,divider_5,actions_section\n        - component: Column\n          id: header_section\n          children[2]: title,date\n        - component: Text\n          id: title\n          text: \"Project Status Report: Website Redesign\"\n          variant: h1\n        - component: Text\n          id: date\n          text: \"Date: 2024-03-01\"\n          variant: caption\n        - component: Divider\n          id: divider_1\n        - component: Column\n          id: summary_section\n          children[2]: summary_title,summary_text\n        - component: Text\n          id: summary_title\n          text: Summary\n          variant: h3\n        - component: Text\n          id: summary_text\n          text: \"The 'Website Redesign' project is currently facing significant challenges. While UI Mockups are complete, the critical Backend API development is only 60% complete, directly blocking QA Testing. Content Migration has not yet started.\"\n          variant: body\n        - component: Divider\n          id: divider_2\n        - component: Column\n          id: tasks_section\n          children[5]: tasks_title,task_1,task_2,task_3,task_4\n        - component: Text\n          id: tasks_title\n          text: Task Status Overview\n          variant: h3\n        - align: center\n          component: Row\n          id: task_1\n          children[2]: icon_completed,task_info_1\n        - component: Image\n          id: icon_completed\n          url: /icons/checkmark.png\n          variant: icon\n        - component: Column\n          id: task_info_1\n          children[2]: task_name_1,task_status_1\n        - component: Text\n          id: task_name_1\n          text: UI Mockups\n          variant: h5\n        - component: Text\n          id: task_status_1\n          text: \"Status: Completed | Progress: 100%\"\n          variant: caption\n        - align: center\n          component: Row\n          id: task_2\n          children[2]: icon_inprogress,task_info_2\n        - component: Image\n          id: icon_inprogress\n          url: /icons/gear.png\n          variant: icon\n        - component: Column\n          id: task_info_2\n          children[2]: task_name_2,task_status_2\n        - component: Text\n          id: task_name_2\n          text: Backend API\n          variant: h5\n        - component: Text\n          id: task_status_2\n          text: \"Status: In Progress | Progress: 60%\"\n          variant: caption\n        - align: center\n          component: Row\n          id: task_3\n          children[2]: icon_notstarted,task_info_3\n        - component: Image\n          id: icon_notstarted\n          url: /icons/clock.png\n          variant: icon\n        - component: Column\n          id: task_info_3\n          children[2]: task_name_3,task_status_3\n        - component: Text\n          id: task_name_3\n          text: Content Migration\n          variant: h5\n        - component: Text\n          id: task_status_3\n          text: \"Status: Not Started | Progress: 0%\"\n          variant: caption\n        - align: center\n          component: Row\n          id: task_4\n          children[2]: icon_blocked,task_info_4\n        - component: Image\n          id: icon_blocked\n          url: /icons/stop_sign.png\n          variant: icon\n        - component: Column\n          id: task_info_4\n          children[2]: task_name_4,task_status_4\n        - component: Text\n          id: task_name_4\n          text: QA Testing\n          variant: h5\n        - component: Text\n          id: task_status_4\n          text: \"Status: Blocked by Backend | Progress: 0%\"\n          variant: caption\n        - component: Divider\n          id: divider_3\n        - component: Column\n          id: health_section\n          children[3]: health_title,health_status,health_desc\n        - component: Text\n          id: health_title\n          text: Project Health Status\n          variant: h3\n        - component: Text\n          id: health_status\n          text: At Risk\n          variant: h4\n        - component: Text\n          id: health_desc\n          text: The project is at risk due to key dependencies not being met and a major component still in progress. The inability to start QA Testing and Content Migration significantly impacts the project timeline.\n          variant: body\n        - component: Divider\n          id: divider_4\n        - component: Column\n          id: bottleneck_section\n          children[3]: bottleneck_title,bottleneck_name,bottleneck_desc\n        - component: Text\n          id: bottleneck_title\n          text: Primary Bottleneck\n          variant: h3\n        - component: Text\n          id: bottleneck_name\n          text: Backend API Development\n          variant: h4\n        - component: Text\n          id: bottleneck_desc\n          text: \"The Backend API development is the primary bottleneck. Its incomplete status (60%) is directly blocking the QA Testing phase. Until the Backend API is finalized, further progress on testing and potentially other dependent tasks like Content Migration cannot proceed efficiently.\"\n          variant: body\n        - component: Divider\n          id: divider_5\n        - component: Column\n          id: actions_section\n          children[4]: actions_title,btn_update,btn_plan,btn_discuss\n        - component: Text\n          id: actions_title\n          text: Quick Actions\n          variant: h3\n        - child: btn_txt_update\n          component: Button\n          id: btn_update\n          variant: primary\n          action:\n            functionCall:\n              call: openUrl\n              args:\n                url: /project/websiteredesign/backend_status_update\n        - component: Text\n          id: btn_txt_update\n          text: Update Backend API Status\n        - child: btn_txt_plan\n          component: Button\n          id: btn_plan\n          action:\n            functionCall:\n              call: openUrl\n              args:\n                url: /project/websiteredesign/backend_plan\n        - component: Text\n          id: btn_txt_plan\n          text: Review Backend API Development Plan\n        - child: btn_txt_discuss\n          component: Button\n          id: btn_discuss\n          action:\n            functionCall:\n              call: openUrl\n              args:\n                url: /project/websiteredesign/content_migration_planning\n        - component: Text\n          id: btn_txt_discuss\n          text: Discuss Content Migration Readiness","validation":{"json_parse_ok":true,"schema_valid_strict":true,"schema_valid_lenient":true,"toon_roundtrip_ok":true,"errors":[],"repair_attempts":0,"repair_needed":false},"metrics":{"content_coverage":0.9489795918367347,"dup_rate":0.2986425339366516,"lint_score":1.0,"output_tokens_toon":592,"output_tokens_json":570,"component_count":50.0,"unique_component_types":6.0,"max_tree_depth":5.0,"avg_tree_depth":1.56,"container_to_text_ratio":0.6521739130434783,"information_chunking_score":0.7609630266552021,"ui_modularity_score":0.08,"ui_decomposition_score":0.4743665183745187,"actionable_elements":3.0,"action_coverage":1.0,"url_as_text_rate":0.0,"table_pattern_detected":0.0,"table_cell_coverage":0.0,"section_heading_coverage":0.8333333333333334,"markdown_leakage_rate":0.0,"missing_ids":0.0,"missing_ids_rate":0.0,"dangling_components":0.0,"dangling_components_rate":0.0,"intent_require_table":1.0,"intent_require_actions":1.0,"intent_require_sections":1.0,"intent_table_ok":0.0,"intent_actions_ok":1.0,"intent_sections_ok":1.0,"intent_expectation_pass":0