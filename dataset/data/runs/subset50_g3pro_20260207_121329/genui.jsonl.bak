oan Summary","variant":"h4"},{"id":"summary_stats_row","component":"Row","children":["stat_home_price","stat_down_payment","stat_loan_amount"],"justify":"spaceBetween","align":"start"},{"id":"stat_home_price","component":"Column","children":["lbl_home_price","val_home_price"]},{"id":"lbl_home_price","component":"Text","text":"Home Price","variant":"caption"},{"id":"val_home_price","component":"Text","text":"$500,000","variant":"body"},{"id":"stat_down_payment","component":"Column","children":["lbl_down_payment","val_down_payment"]},{"id":"lbl_down_payment","component":"Text","text":"Down Payment","variant":"caption"},{"id":"val_down_payment","component":"Text","text":"$100,000 (20%)","variant":"body"},{"id":"stat_loan_amount","component":"Column","children":["lbl_loan_amount","val_loan_amount"]},{"id":"lbl_loan_amount","component":"Text","text":"Loan Amount","variant":"caption"},{"id":"val_loan_amount","component":"Text","text":"$400,000","variant":"body"},{"id":"options_header","component":"Text","text":"Mortgage Option Comparison","variant":"h3"},{"id":"option_a_card","component":"Card","child":"option_a_col"},{"id":"option_a_col","component":"Column","children":["option_a_title_row","option_a_rate","option_a_payment","option_a_interest"]},{"id":"option_a_title_row","component":"Row","children":["icon_loan_a","title_option_a"],"align":"center"},{"id":"icon_loan_a","component":"Image","url":"/icons/loan_option.png","variant":"icon","fit":"contain"},{"id":"title_option_a","component":"Text","text":" Option A: 30-Year Fixed","variant":"h4"},{"id":"option_a_rate","component":"Text","text":"Interest Rate: 6.50%","variant":"body"},{"id":"option_a_payment","component":"Text","text":"Monthly P&I Payment: $2,528","variant":"body"},{"id":"option_a_interest","component":"Text","text":"Total Interest Paid: $509,900","variant":"body"},{"id":"option_b_card","component":"Card","child":"option_b_col"},{"id":"option_b_col","component":"Column","children":["option_b_title_row","opt