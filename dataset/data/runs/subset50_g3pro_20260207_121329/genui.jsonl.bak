3\n        - align: center\n          component: Column\n          id: tab_prep\n          children[2]: prep_icon,prep_title\n        - component: Image\n          fit: contain\n          id: prep_icon\n          url: /clock_icon.png\n          variant: mediumFeature\n        - component: Text\n          id: prep_title\n          text: Prep Timeline\n          variant: h3\n        - align: center\n          component: Column\n          id: tab_tips\n          children[2]: tips_icon,tips_title\n        - component: Image\n          fit: contain\n          id: tips_icon\n          url: /lightbulb_icon.png\n          variant: mediumFeature\n        - component: Text\n          id: tips_title\n          text: Tips for Success\n          variant: h3","validation":{"json_parse_ok":true,"schema_valid_strict":true,"schema_valid_lenient":true,"toon_roundtrip_ok":true,"errors":[],"repair_attempts":0,"repair_needed":false},"metrics":{"content_coverage":0.9659090909090909,"dup_rate":0.24539877300613497,"lint_score":1.0,"output_tokens_toon":406,"output_tokens_json":404,"component_count":28.0,"unique_component_types":7.0,"max_tree_depth":4.0,"avg_tree_depth":1.4642857142857142,"container_to_text_ratio":0.8461538461538461,"information_chunking_score":0.7515151515151515,"ui_modularity_score":0.14285714285714285,"ui_decomposition_score":0.5584532134532135,"actionable_elements":0.0,"action_coverage":1.0,"url_as_text_rate":0.0,"table_pattern_detected":0.0,"table_cell_coverage":0.0,"section_heading_coverage":0.0,"markdown_leakage_rate":0.07692307692307693,"missing_ids":0.0,"missing_ids_rate":0.0,"dangling_components":0.0,"dangling_components_rate":0.0,"intent_require_table":0.0,"intent_require_actions":0.0,"intent_require_sections":1.0,"intent_table_ok":0.0,"intent_actions_ok":0.0,"intent_sections_ok":0.0,"intent_expectation_pass":0.0,"intent_score":0.0},"gen":{"provider":"gemini","model":"gemini-3-pro-preview","prompt_version":"genui_gen_v1","latency_ms":68534.94906425476,"input_token