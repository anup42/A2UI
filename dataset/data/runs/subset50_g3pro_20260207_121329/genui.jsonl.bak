 Text\n          id: td_g_r\n          text: ~55 (Moderate)\n          weight: 1\n        - component: Divider\n          id: divider_2\n        - component: Text\n          id: gi_notes\n          text: \"GI Notes: Low (≤55), Moderate (56-69), High (≥70). Both fall within the moderate range, causing a relatively steady rise in blood sugar.\"\n          variant: caption\n        - component: Row\n          id: actions_row\n          justify: spaceAround\n          children[2]: btn_quinoa,btn_rice\n        - child: btn_txt_q\n          component: Button\n          id: btn_quinoa\n          action:\n            functionCall:\n              call: openUrl\n              args:\n                url: /quinoa-recipes\n        - component: Text\n          id: btn_txt_q\n          text: Explore Quinoa Recipes\n        - child: btn_txt_r\n          component: Button\n          id: btn_rice\n          action:\n            functionCall:\n              call: openUrl\n              args:\n                url: /brown-rice-recipes\n        - component: Text\n          id: btn_txt_r\n          text: Explore Brown Rice Recipes","validation":{"json_parse_ok":true,"schema_valid_strict":true,"schema_valid_lenient":true,"toon_roundtrip_ok":true,"errors":[],"repair_attempts":0,"repair_needed":false},"metrics":{"content_coverage":0.7553191489361702,"dup_rate":0.2867647058823529,"lint_score":1.0,"output_tokens_toon":350,"output_tokens_json":338,"component_count":28.0,"unique_component_types":5.0,"max_tree_depth":4.0,"avg_tree_depth":1.3928571428571428,"container_to_text_ratio":0.3333333333333333,"information_chunking_score":0.6744525547445255,"ui_modularity_score":0.17857142857142858,"ui_decomposition_score":0.38231114586954,"actionable_elements":2.0,"action_coverage":1.0,"url_as_text_rate":0.0,"table_pattern_detected":0.0,"table_cell_coverage":0.0,"section_heading_coverage":0.0,"markdown_leakage_rate":0.0,"missing_ids":0.0,"missing_ids_rate":0.0,"dangling_components":0.0,"dangling_component