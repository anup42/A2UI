  text: 416 sq ft\n        - component: Row\n          id: row_total\n          justify: spaceBetween\n          children[2]: lbl_total,val_total\n        - component: Text\n          id: lbl_total\n          text: Total Area to Paint\n        - component: Text\n          id: val_total\n          text: 832 sq ft\n        - component: Divider\n          id: div_2\n        - component: Row\n          id: row_need\n          justify: spaceBetween\n          children[2]: lbl_need,val_need\n        - component: Text\n          id: lbl_need\n          text: Gallons Needed\n        - component: Text\n          id: val_need\n          text: 2.38 gallons (approx)\n        - component: Row\n          id: row_buy\n          justify: spaceBetween\n          children[2]: lbl_buy,val_buy\n        - component: Text\n          id: lbl_buy\n          text: Gallons to Buy\n        - component: Text\n          id: val_buy\n          text: 3 gallons\n          variant: h5\n        - component: Text\n          id: details_header\n          text: Detailed Calculation\n          variant: h4\n        - component: Column\n          id: details_col\n          children[5]: step_1,step_2,step_3,step_4,step_5\n        - component: Text\n          id: step_1\n          text: \"1. Calculate the perimeter: (14 + 12) * 2 = 52 feet\"\n        - component: Text\n          id: step_2\n          text: \"2. Calculate wall area: 52 * 8 = 416 sq ft\"\n        - component: Text\n          id: step_3\n          text: \"3. Calculate total area (2 coats): 416 * 2 = 832 sq ft\"\n        - component: Text\n          id: step_4\n          text: \"4. Calculate gallons: 832 / 350 = 2.377 gallons\"\n        - component: Text\n          id: step_5\n          text: \"Result: Round up 2.377 to 3 gallons.\"\n        - component: Row\n          id: actions_row\n          justify: start\n          children[2]: btn_shop,btn_tips\n        - child: txt_shop\n          component: Button\n          id: btn_shop\n          var