cloth_8\n          text: \"**Gloves (2 pairs)**\\n• Thin liner gloves.\\n• Warm, waterproof outer gloves or mittens.\"\n        - component: Text\n          id: cloth_9\n          text: \"**Headwear (2-3 items)**\\n• Warm wool or fleece beanie/hat.\\n• Sun hat or cap.\\n• Neck gaiter or buff.\"\n        - component: Text\n          id: cloth_10\n          text: \"**Sleepwear**\\n• Can use a clean set of base layers.\"\n        - component: Column\n          id: gear_list\n          children[9]: gear_1,gear_2,gear_3,gear_4,gear_5,gear_6,gear_7,gear_8,gear_9\n        - component: Text\n          id: gear_1\n          text: \"**Backpacks**\\n• Large duffel bag (80-100L) for porter.\\n• Daypack (25-35L) for daily essentials.\"\n        - component: Text\n          id: gear_2\n          text: \"**Sleeping Bag**\\n• Rated to at least -10°C (comfort).\"\n        - component: Text\n          id: gear_3\n          text: \"**Footwear**\\n• Sturdy, waterproof trekking boots.\\n• Camp shoes, sandals, or crocs.\"\n        - component: Text\n          id: gear_4\n          text: \"**Trekking Poles**\\n• Highly recommended for stability.\"\n        - component: Text\n          id: gear_5\n          text: \"**Water Storage**\\n• 2 x 1L Nalgene bottles.\\n• Hydration reservoir (2-3L).\"\n        - component: Text\n          id: gear_6\n          text: \"**Headlamp**\\n• With fresh batteries and spare set.\"\n        - component: Text\n          id: gear_7\n          text: \"**Eyewear**\\n• High-quality sunglasses (Category 3 or 4).\"\n        - component: Text\n          id: gear_8\n          text: \"**Electronics**\\n• Power bank, Camera, Phone, Universal adapter.\"\n        - component: Text\n          id: gear_9\n          text: \"**Miscellaneous**\\n• Towel, Padlock, Dry bags, Book, Map, Thermos, Snacks, Shopping bag.\"\n        - component: Column\n          id: hygiene_list\n          children[8]: hyg_1,hyg_2,hyg_3,hyg_4,hyg_5,hyg_6,hyg_7,hyg_8\n        - component: Text\n          id: hyg_1\n          text: \"**Toiletries**\\n• Toothbrush, paste, biodegradable soap, deodorant.\"\n        - component: Text\n          id: hyg_2\n          text: \"**Hand Sanitizer**\\n• Essential for hygiene.\"\n        - component: Text\n          id: hyg_3\n          text: \"**Wet Wipes**\\n• For sponge baths or cleaning.\"\n        - component: Text\n          id: hyg_4\n          text: \"**Sun Protection**\\n• High SPF sunscreen, Lip balm with SPF.\"\n        - component: Text\n          id: hyg_5\n          text: \"**Toilet Paper**\\n• Small roll.\"\n        - component: Text\n          id: hyg_6\n          text: \"**Moisturizer**\\n• For face and hands.\"\n        - component: Text\n          id: hyg_7\n          text: \"**Personal Medications**\\n• Prescriptions.\"\n        - component: Text\n          id: hyg_8\n          text: \"**Feminine Hygiene**\\n• As needed.\"\n        - component: Column\n          id: first_aid_list\n          children[1]: fa_1\n        - component: Text\n          id: fa_1\n          text: \"**Basic Pain Relief**\\n• Ibuprofen\"","validation":{"json_parse_ok":true,"schema_valid_strict":true,"schema_valid_lenient":true,"toon_roundtrip_ok":true,"errors":[],"repair_attempts":0,"repair_needed":false},"metrics":{"content_coverage":0.7003367003367004,"dup_rate":0.19230769230769232,"lint_score":1.0,"output_tokens_toon":561,"output_tokens_json":558,"component_count":39.0,"unique_component_types":4.0,"max_tree_depth":4.0,"avg_tree_depth":1.2564102564102564,"container_to_text_ratio":0.25806451612903225,"information_chunking_score":0.921003717472119,"ui_modularity_score":0.02564102564102564,"ui_decomposition_score":0.35082605366812103,"actionable_elements":0.0,"action_coverage":1.0,"url_as_text_rate":0.0,"table_pattern_detected":0.0,"table_cell_coverage":0.0,"section_heading_coverage":0.029411764705882353,"markdown_leakage_rate":0.0,"missing_ids":0.0,"missing_ids_rate":0.0,"dangling_components":0.0,"dangling_components_rate":0.0,"in