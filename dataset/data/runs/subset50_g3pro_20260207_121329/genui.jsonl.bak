{"ui_id":"u_000681_01","response_id":"r_000681_01","query_id":"q_000681","intent":"Navigation","tags":["travel","itinerary","walking-tour"],"intent_bucket":"navigation","genui_json":[{"version":"v0.9","createSurface":{"surfaceId":"rome-tour-surface","catalogId":"https://genui.local/specification/v0_9/standard_catalog.json","theme":{"primaryColor":"#C41E3A"}}},{"version":"v0.9","updateComponents":{"surfaceId":"rome-tour-surface","components":[{"id":"root","component":"Column","children":["header_title","itinerary_list","tips_header","tips_list","actions_row"]},{"id":"header_title","component":"Text","text":"Rome Historic Center Walking Tour: 2025-05-15","variant":"h2"},{"id":"itinerary_list","component":"Column","children":["card_colosseum","walk_1","card_forum","walk_2","card_lunch","card_pantheon","walk_3","card_navona"]},{"id":"card_colosseum","component":"Card","child":"col_colosseum"},{"id":"col_colosseum","component":"Column","children":["img_colosseum","meta_colosseum","title_colosseum","desc_colosseum"]},{"id":"img_colosseum","component":"Image","url":"/images/colosseum_rome.jpg","variant":"mediumFeature","fit":"cover"},{"id":"meta_colosseum","component":"Row","children":["time_colosseum","dur_colosseum"],"justify":"spaceBetween"},{"id":"time_colosseum","component":"Text","text":"09:00 - 10:30","variant":"caption"},{"id":"dur_colosseum","component":"Text","text":"1 hr 30 min","variant":"caption"},{"id":"title_colosseum","component":"Text","text":"Visit the Colosseum","variant":"h4"},{"id":"desc_colosseum","component":"Text","text":"Start your day exploring this iconic amphitheater. Pre-booking tickets is highly recommended.","variant":"body"},{"id":"walk_1","component":"Row","children":["icon_walk_1","text_walk_1"],"align":"center"},{"id":"icon_walk_1","component":"Icon","name":{"path":"/icons/walking.png"}},{"id":"text_walk_1","component":"Text","text":"15 min walk to Roman Forum / Palatine Hill","variant":"caption"},{"id":"card_forum","component":"Card","ch