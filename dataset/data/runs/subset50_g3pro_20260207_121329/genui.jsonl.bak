{"ui_id":"u_000761_01","response_id":"r_000761_01","query_id":"q_000761","intent":"Documentation","tags":["documentation","api","data-structure"],"intent_bucket":"documentation","genui_json":[{"version":"v0.9","createSurface":{"surfaceId":"surface_q_000761","catalogId":"https://genui.local/specification/v0_9/standard_catalog.json"}},{"version":"v0.9","updateComponents":{"surfaceId":"surface_q_000761","components":[{"id":"root","component":"Column","children":["text_1"]},{"id":"text_1","component":"Text","text":"User Profile JSON Documentation\n\nThis table describes the keys found in the provided user profile JSON object, including their data types and purpose.\n\nTechnical Documentation Table:\n\nKey       | Data Type           | Description\n-------------------------------------------------------------------------------------------------\nid        | Number (Integer)    | A unique identifier for the user.\nname      | String              | The full name of the user.\nroles     | Array of Strings    | A list of roles or permissions assigned to the user.\nlast_login| String (ISO 8601)   | The timestamp of the user's last successful login.\nsettings  | Object              | An object containing user-specific preferences and settings.\nsettings.theme | String         | The visual theme preference for the user interface (e.g., \"dark\", \"light\").\nsettings.notifications | Boolean | Indicates whether the user has enabled or disabled notifications.","variant":"body"}]}}],"assets":[],"toon":"[2]:\n  - version: v0.9\n    createSurface:\n      catalogId: \"https://genui.local/specification/v0_9/standard_catalog.json\"\n      surfaceId: surface_q_000761\n  - version: v0.9\n    updateComponents:\n      surfaceId: surface_q_000761\n      components[2]:\n        - component: Column\n          id: root\n          children[1]: text_1\n        - component: Text\n          id: text_1\n          text: \"User Profile JSON Documentation\\n\\nThis table describes the keys found in the provided user profile JSON object, including their data types and purpose.\\n\\nTechnical Documentation Table:\\n\\nKey       | Data Type           | Description\\n-------------------------------------------------------------------------------------------------\\nid        | Number (Integer)    | A unique identifier for the user.\\nname      | String              | The full name of the user.\\nroles     | Array of Strings    | A list of roles or permissions assigned to the user.\\nlast_login| String (ISO 8601)   | The timestamp of the user's last successful login.\\nsettings  | Object              | An object containing user-specific preferences and settings.\\nsettings.theme | String         | The visual theme preference for the user interface (e.g., \\\"dark\\\", \\\"light\\\").\\nsettings.notifications | Boolean | Indicates whether the user has enabled or disabled notifications.\"\n          variant: body","validation":{"json_parse_ok":true,"schema_valid_strict":true,"schema_valid_lenient":true,"toon_roundtrip_ok":true,"errors":["fallback_generated"],"repair_attempts":1,"repair_needed":true},"metrics":{"content_coverage":1.0,"dup_rate":0.06666666666666667,"lint_score":1.0,"output_tokens_toon":142,"output_tokens_json":137,"component_count":2.0,"unique_component_types":2.0,"max_tree_depth":2.0,"avg_tree_depth":1.5,"container_to_text_ratio":1.0,"information_chunking_score":0.0,"ui_modularity_score":0.0,"ui_decomposition_score":0.2833333333333333,"actionable_elements":0.0,"action_coverage":1.0,"url_as_text_rate":0.0,"table_pattern_detected":0.0,"table_cell_coverage":0.0,"section_heading_coverage":0.0,"markdown_leakage_rate":0.0,"missing_ids":0.0,"missing_ids_rate":0.0,"dangling_components":0.0,"dangling_components_rate":0.0,"intent_require_table":1.0,"intent_require_actions":0.0,"intent_require_sections":1.0,"intent_table_ok":0.0,"intent_actions_ok":0.0,"intent_sections_ok":0.0,"intent_expectation_pass":0.0,"intent_score":0.0},"gen":{"provider":"gemini","model":"ge