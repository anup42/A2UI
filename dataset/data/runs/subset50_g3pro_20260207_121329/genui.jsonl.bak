{"ui_id":"u_000401_01","response_id":"r_000401_01","query_id":"q_000401","intent":"Technical support","tags":["software troubleshooting","excel","data formatting"],"intent_bucket":"technical_support","genui_json":[{"version":"v0.9","createSurface":{"surfaceId":"vlookup-error-guide","catalogId":"https://genui.local/specification/v0_9/standard_catalog.json","theme":{"primaryColor":"#107C41"}}},{"version":"v0.9","updateComponents":{"surfaceId":"vlookup-error-guide","components":[{"id":"root","component":"Column","children":["header","summary","divider_1","assumptions_title","assumption_1","assumption_2","assumption_3","divider_2","sol1_title","sol1_expl","sol1_steps_title","sol1_step_1","sol1_step_2","sol1_example_title","sol1_example_1","sol1_example_2","divider_3","sol2_title","sol2_expl","sol2_steps_title","sol2_step_1","sol2_step_2","sol2_step_3","sol2_alt_title","sol2_alt_1","sol2_alt_2","sol2_alt_3","divider_4","comparison_title","table_head","table_row_1","table_row_2","divider_5","actions_title","actions_row"]},{"id":"header","component":"Text","variant":"h1","text":"Fixing VLOOKUP Errors: Text vs Number Mismatch"},{"id":"summary","component":"Text","variant":"body","text":"A common VLOOKUP error occurs when the lookup value and the source column have different data types (text vs number). Below are two methods to resolve this."},{"id":"divider_1","component":"Divider"},{"id":"assumptions_title","component":"Text","variant":"h3","text":"Assumptions"},{"id":"assumption_1","component":"Text","variant":"body","text":"• The lookup value (e.g., A2) is formatted as text."},{"id":"assumption_2","component":"Text","variant":"body","text":"• The source table's first column contains numbers."},{"id":"assumption_3","component":"Text","variant":"body","text":"• The VLOOKUP formula structure is correct otherwise."},{"id":"divider_2","component":"Divider"},{"id":"sol1_title","component":"Text","variant":"h2","text":"Solution 1: Formula-Based Approach"},{"id":"sol1_expl","component":"Text","variant":"body","text":"Convert the text lookup value to a number within the formula. This is non-destructive to your data."},{"id":"sol1_steps_title","component":"Text","variant":"h4","text":"Steps"},{"id":"sol1_step_1","component":"Text","variant":"body","text":"1. Identify the cell with the text-formatted lookup value (e.g., A2)."},{"id":"sol1_step_2","component":"Text","variant":"body","text":"2. Modify the VLOOKUP formula to convert this value to a number."},{"id":"sol1_example_title","component":"Text","variant":"h4","text":"Example Formulas"},{"id":"sol1_example_1","component":"Text","variant":"body","text":"Using Double Unary: =VLOOKUP(--A2, B:C, 2, FALSE)"},{"id":"sol1_example_2","component":"Text","variant":"body","text":"Using VALUE Function: =VLOOKUP(VALUE(A2), B:C, 2, FALSE)"},{"id":"divider_3","component":"Divider"},{"id":"sol2_title","component":"Text","variant":"h2","text":"Solution 2: Formatting-Based Approach"},{"id":"sol2_expl","component":"Text","variant":"body","text":"Permanently convert the source column data from text to numbers."},{"id":"sol2_steps_title","component":"Text","variant":"h4","text":"Steps"},{"id":"sol2_step_1","component":"Text","variant":"body","text":"1. Select the source column containing numbers stored as text."},{"id":"sol2_step_2","component":"Text","variant":"body","text":"2. Click the yellow 'Error Checking' icon that appears."},{"id":"sol2_step_3","component":"Text","variant":"body","text":"3. Select 'Convert to Number'."},{"id":"sol2_alt_title","component":"Text","variant":"h4","text":"Alternative Methods"},{"id":"sol2_alt_1","component":"Text","variant":"body","text":"• Text to Columns: Data tab > Text to Columns > Finish."},{"id":"sol2_alt_2","component":"Text","variant":"body","text":"• Paste Special (Multiply): Copy '1', select range, Paste Special > Multiply."},{"id":"sol2_alt_3","component":"Text","variant":"body","text":"• Paste Special (Add): Copy '0', select range, Paste Special > Add."},{"id":"divider_4","component":"Divider"},{"id":"comparison_title","component":"Text","variant":"h3","text":"Comparison"},{"id":"table_head","component":"Row","children":["th_1","th_2","th_3","th_4"]},{"id":"th_1","component":"Text","variant":"h5","text":"Type","weight":1},{"id":"th_2","component":"Text","variant":"h5","text":"Pros","weight":1.5},{"id":"th_3","component":"Text","variant":"h5","text":"Cons","weight":1.5},{"id":"th_4","component":"Text","variant":"h5","text":"Best Use","weight":1.5},{"id":"table_row_1","component":"Row","children":["tr1_1","tr1_2","tr1_3","tr1_4"]},{"id":"tr1_1","component":"Text","variant":"body","text":"Formula","weight":1},{"id":"tr1_2","component":"Text","variant":"caption","text":"Non-destructive","weight":1.5},{"id":"tr1_3","component":"Text","variant":"caption","text":"Modifies formulas","weight":1.5},{"id":"tr1_4","component":"Text","variant":"caption","text":"Read-only source","weight":1.5},{"id":"table_row_2","component":"Row","children":["tr2_1","tr2_2","tr2_3","tr2_4"]},{"id":"tr2_1","component":"Text","variant":"body","text":"Format","weight":1},{"id":"tr2_2","component":"Text","variant":"caption","text":"Permanent fix","weight":1.5},{"id":"tr2_3","component":"Text","variant":"caption","text":"Alters data","weight":1.5},{"id":"tr2_4","component":"Text","variant":"caption","text":"Clean data needed","weight":1.5},{"id":"divider_5","component":"Divider"},{"id":"actions_title","component":"Text","variant":"h3","text":"Quick Actions"},{"id":"actions_row","component":"Row","justify":"start","children":["btn_help","btn_convert"]},{"id":"btn_help","component":"Button","child":"btn_help_text","action":{"functionCall":{"call":"openUrl","args":{"url":"https://support.microsoft.com/en-us/office/vlookup-function-0398606e-09a8-4229-9e63-c7e6c40a5a67"}}}},{"id":"btn_help_text","component":"Text","text":"VLOOKUP Help"},{"id":"btn_convert","component":"Button","child":"btn_convert_text","action":{"functionCall":{"call":"openUrl","args":{"url":