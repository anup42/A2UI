{"ui_id":"u_000321_01","response_id":"r_000321_01","query_id":"q_000321","intent":"Recipe","tags":["dinner","italian","classic"],"intent_bucket":"recipe","genui_json":[{"version":"v0.9","createSurface":{"surfaceId":"surface_bolognese_recipe","catalogId":"https://genui.local/specification/v0_9/standard_catalog.json","theme":{"primaryColor":"#A31621"}}},{"version":"v0.9","updateComponents":{"surfaceId":"surface_bolognese_recipe","components":[{"id":"root","component":"Column","children":["header_image","title","summary","divider_1","ingredients_header","ingredients_image","ingredients_list","divider_2","instructions_header","instructions_list","divider_3","actions_row"]},{"id":"header_image","component":"Image","url":"/bolognese_simmering.jpg","fit":"cover","variant":"header"},{"id":"title","component":"Text","text":"Traditional Italian Bolognese Sauce (Serves 4)","variant":"h1"},{"id":"summary","component":"Text","text":"This recipe provides a traditional, rich, and deeply flavorful Bolognese sauce, perfect for serving with fresh pasta. The key to its authentic taste is a slow, patient simmer over three hours, allowing the flavors to meld beautifully.","variant":"body"},{"id":"divider_1","component":"Divider"},{"id":"ingredients_header","component":"Text","text":"Ingredients","variant":"h2"},{"id":"ingredients_image","component":"Image","url":"/soffritto_ingredients.jpg","fit":"cover","variant":"mediumFeature"},{"id":"ingredients_list","component":"Column","children":["ing_1","ing_2","ing_3","ing_4","ing_5","ing_6","ing_7","ing_8","ing_9","ing_10","ing_11","ing_12","ing_13","ing_14","ing_15"]},{"id":"ing_1","component":"Text","text":"• Olive Oil: 30 ml (2 tablespoons)"},{"id":"ing_2","component":"Text","text":"• Pancetta, diced: 100 grams"},{"id":"ing_3","component":"Text","text":"• Yellow Onion, finely chopped: 150 grams"},{"id":"ing_4","component":"Text","text":"• Carrot, finely chopped: 100 grams"},{"id":"ing_5","component":"Text","text":"• Celery Stalk, finely chopped: 100 grams"},{"id":"ing_6","component":"Text","text":"• Ground Beef (80/20 blend): 300 grams"},{"id":"ing_7","component":"Text","text":"• Ground Pork: 200 grams"},{"id":"ing_8","component":"Text","text":"• Whole Milk: 200 ml"},{"id":"ing_9","component":"Text","text":"• Dry White Wine: 200 ml"},{"id":"ing_10","component":"Text","text":"• Canned Crushed Tomatoes: 400 grams"},{"id":"ing_11","component":"Text","text":"• Tomato Paste: 30 grams (2 tablespoons)"},{"id":"ing_12","component":"Text","text":"• Beef Broth (or water): 250 ml"},{"id":"ing_13","component":"Text","text":"• Salt: 5 grams (1 teaspoon)"},{"id":"ing_14","component":"Text","text":"• Freshly Ground Black Pepper: 2 grams"},{"id":"ing_15","component":"Text","text":"• Freshly Grated Nutmeg: 1 gram"},{"id":"divider_2","component":"Divider"},{"id":"instructions_header","component":"Text","text":"Instructions","variant":"h2"},{"id":"instructions_list","component":"Column","children":["step_1","step_2","step_3","step_4","step_5","step_6","step_7"]},{"id":"step_1","component":"Text","text":"**1. Prepare the Soffritto:** Heat the olive oil in a large pot. Add diced pancetta and cook until crispy (5-7 mins). Remove pancetta, leaving fat."},{"id":"step_2","component":"Text","text":"**2. Sauté Vegetables:** Add onion, carrot, and celery. Cook over medium-low until soft and translucent (10-15 mins)."},{"id":"step_3","component":"Text","text":"**3. Brown the Meats:** Increase heat to medium. Add beef and pork. Cook until fully browned (8-10 mins). Drain excess fat."},{"id":"step_4","component":"Text","text":"**4. Deglaze:** Pour in milk, simmer until evaporated (10-15 mins). Add wine, simmer until evaporated (5-7 mins)."},{"id":"step_5","component":"Text","text":"**5. Add Tomatoes:** Stir in tomatoes, paste, broth, salt, pepper, and nutmeg. Return pancetta to pot. Bring to simmer."},{"id":"step_6","component":"Text","text":"**6. Slow Simmer:** Reduce heat to very low, partially cover, and simmer for at least 3 hours. Stir occasionally."},{"id":"step_7","component":"Text","text":"**7. Finish and Serve:** Taste and adjust seasoning. Serve hot with pasta and Parmigiano-Reggiano."},{"id":"divider_3","component":"Divider"},{"id":"actions_row","component":"Row","justify":"spaceAround","children":["btn_pairings","btn_shop"]},{"id":"btn_pairings","component":"Button","variant":"primary","child":"txt_pairings","action":{"functionCall":{"call":"openUrl","args":{"url":"/pasta-pairings"}}}},{"id":"txt_pairings","component":"Text","text":"Find Pasta Pairings"},{"id":"btn_shop","component":"Button","variant":"primary","child":"txt_shop","action":{"functionCall":{"call":"openUrl","args":{"url":"/shop-bolognese-ingredients"}}}},{"id":"txt_shop","component":"Text","text":"Shop Ingredients"}]}}],"assets":[],"toon":"[2]:\n  - version: v0.9\n    createSurface:\n      catalogId: \"https://genui.local/specification/v0_9/standard_catalog.json\"\n      surfaceId: surface_bolognese_recipe\n      theme:\n        primaryColor: #A31621\n  - version: v0.9\n    updateComponents:\n      surfaceId: surface_bolognese_recipe\n      components[39]:\n        - component: Column\n          id: root\n          children[12]: header_image,title,summary,divider_1,ingredients_header,ingredients_image,ingredients_list,divider_2,instructions_header,instructions_list,divider_3,actions_row\n        - component: Image\n          fit: cover\n          id: header_image\n          url: /bolognese_simmering.jpg\n          variant: header\n        - component: Text\n          id: title\n          text: Traditional Italian Bolognese Sauce (Serves 4)\n          variant: h1\n        - component: Text\n          id: summary\n          text: \"This recipe provides a traditional, rich, and deeply flavorful Bolognese sauce, perfect for serving with fresh pasta. The key to its authentic taste is a slow, patient simmer over three hours, allowing the flavors to meld beautifully.\"\n          variant: body\n        - component: Divider\n          id: divider_1\n        - component: Text\n          id: ingredients_header\n          text: Ingredients\n          variant: h2\n        - component: Image\n          fit: cover\n          id: ingredients_image\n          url: /soffritto_ingredients.jpg\n          variant: mediumFeature\n        - component: Column\n          id: ingredients_list\n          children[15]: ing_1,ing_2,ing_3,ing_4,ing_5,ing_6,ing_7,ing_8,ing_9,ing_10,ing_11,ing_12,ing_13,ing_14,ing_15\n        - component: Text\n          id: ing_1\n          text: \"• Olive Oil: 30 ml (2 tablespoons)\"\n        - component: Text\n          id: ing_2\n          text: \"• Pancetta, diced: 100 grams\"\n        - component: Text\n          id: ing_3\n          text: \"• Yellow Onion, finely chopped: 150 grams\"\n        - component: Text\n          id: ing_4\n          text: \"• Carrot, finely chopped: 100 grams\"\n        - component: Text\n          id: ing_5\n          text: \"• Celery Stalk, finely chopped: 100 grams\"\n        - component: Text\n          id: ing_6\n          text: \"• Ground Beef (80/20 blend): 300 grams\"\n        - component: Text\n          id: ing_7\n          text: \"• Ground Pork: 200 grams\"\n        - component: Text\n          id: ing_8\n          text: \"• Whole Milk: 200 ml\"\n        - component: Text\n          id: ing_9\n          text: \"• Dry White Wine: 200 ml\"\n        - component: Text\n          id: ing_10\n          text: \"• Canned Crushed Tomatoes: 400 grams\"\n        - component: Text\n          id: ing_11\n          text: \"• Tomato Paste: 30 grams (2 tablespoons)\"\n        - component: Text\n          id: ing_12\n          text: \"• Beef Broth (or water): 250 ml\"\n        - component: Text\n          id: ing_13\n          text: \"• Salt: 5 grams (1 teaspoon)\"\n        - component: Text\n          id: ing_14\n          text: \"• Freshly Ground Black Pepper: 2 grams\"\n        - component: Text\n          id: ing_15\n          text: \"• Freshly Grated Nutmeg: 1 gram\"\n        - component: Divider\n          id: divider_2\n        - component: Text\n          id: instructions_header\n          text: Instructions\n          variant: h2\n        - component: Column\n          id: instructions_list\n          children[7]: step_1,step_2,step_3,step_4,step_5,step_6,step_7\n        - component: Text\n          id: step_1\n          text: \"**1. Prepare the Soffritto:** Heat the olive oil in a large pot. Add diced pancetta and cook until crispy (5-7 mins). Remove pancetta, leaving fat.\"\n        - component: Text\n          id: step_2\n          text: \"**2. Sauté Vegetables:** Add onion, carrot, and celery. Cook over medium-low until soft and translucent (10-15 mins).\"\n        - component: Text\n          id: step_3\n          text: \"**3. Brown the Meats:** Increase heat to medium. Add beef and pork. Cook until fully browned (8-10 mins). Drain excess fat.\"\n        - component: Text\n          id: step_4\n          text: \"**4. Deglaze:** Pour in milk, simmer until evaporated (10-15 mins). Add wine, simmer until evaporated (5-7 mins).\"\n        - component: Text\n          id: step_5\n          text: \"**5. Add Tomatoes:** Stir in tomatoes, paste, broth, salt, pepper, and nutmeg. Return pancetta to pot. Bring to simmer.\"\n        - component: Text\n          id: step_6\n          text: \"**6. Slow Simmer:** Reduce heat to very low, partially cover, and simmer for at least 3 hours. Stir occasionally.\"\n        - component: Text\n          id: step_7\n          text: \"**7. Finish and Serve:** Taste and adjust seasoning. Serve hot with pasta and Parmigiano-Reggiano.\"\n        - component: Divider\n          id: divider_3\n        - component: Row\n          id: actions_row\n          justify: spaceAround\n          children[2]: btn_pairings,btn_shop\n        - child: txt_pairings\n          component: Button\n          id: btn_pairings\n          variant: primary\n          action:\n            functio