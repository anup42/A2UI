o the trenches in 1914.\"}]}]}]}]\n"])</script><script>self.__next_f.push([1,"10c:[\"$\",\"$Lf6\",\"4b0OiW5YzBdfdhGCQ75dKd\",{\"index\":11,\"image\":[\"$\",\"$L41\",null,{\"className\":\"\",\"src\":\"keen-eyesight\",\"alt\":\"\",\"width\":550,\"height\":350,\"sizes\":\"(max-width: 834px) 100vw,\\n\\t\\t\\t\\t(max-width: 1280px) 75vw,\\n\\t\\t\\t\\t50vw\",\"data-sentry-element\":\"CldImage\",\"data-sentry-component\":\"Image\",\"data-sentry-source-file\":\"image.tsx\"}],\"credits\":\"Popperfoto/Getty Images\",\"caption\":[\"$\",\"div\",null,{\"className\":\"_153e98si _153e98sc\",\"data-sentry-component\":\"MaxLines\",\"data-sentry-source-file\":\"max-lines.tsx\",\"children\":[\"$\",\"div\",null,{\"className\":\"_42elsxd g1fwxfzw\",\"data-sentry-element\":\"Component\",\"data-sentry-component\":\"Box\",\"data-sentry-source-file\":\"box.tsx\",\"children\":[\"$\",\"p\",null,{\"children\":\"Visual cues were critical for dogs on missions during World War I. German soldiers in 1916 appear to point something important out to a dog serving as a messenger in the field.\"}]}]}]}]\n"])</script><script>self.__next_f.push([1,"10d:[\"$\",\"$Lf6\",\"2mMPbTaa0E9BQ6UW21pukt\",{\"index\":12,\"image\":[\"$\",\"$L41\",null,{\"className\":\"\",\"src\":\"skilled-rat-hunters\",\"alt\":\"\",\"width\":550,\"height\":350,\"sizes\":\"(max-width: 834px) 100vw,\\n\\t\\t\\t\\t(max-width: 1280px) 75vw,\\n\\t\\t\\t\\t50vw\",\"data-sentry-element\":\"CldImage\",\"data-sentry-component\":\"Image\",\"data-sentry-source-file\":\"image.tsx\"}],\"credits\":\"Adoc-Photos/Corbis/Getty Images\",\"caption\":[\"$\",\"div\",null,{\"className\":\"_153e98si _153e98sc\",\"data-sentry-component\":\"MaxLines\",\"data-sentry-source-file\":\"max-lines.tsx\",\"children\":[\"$\",\"div\",null,{\"className\":\"_42elsxd g1fwxfzw\",\"data-sentry-element\":\"Component\",\"data-sentry-component\":\"Box\",\"data-sentry-source-file\":\"box.tsx\",\"children\":[\"$\",\"p\",null,{\"children\":\"WWI dogs, especially terriers, proved to be productive rat hunters—an invaluable skill in the war’s rodent-infested trenches. Here, a terrier poses with some of his kill near the front lines of France, May 1916.\"}]}]}]}]\n"])</script><script>self.__next_f.push([1,"10e:[\"$\",\"$Lf6\",\"13d4D6qTN7LI8B28dyVPlr\",{\"index\":13,\"image\":[\"$\",\"$L41\",null,{\"className\":\"\",\"src\":\"in-disguise\",\"alt\":\"\",\"width\":550,\"height\":350,\"sizes\":\"(max-width: 834px) 100vw,\\n\\t\\t\\t\\t(max-width: 1280px) 75vw,\\n\\t\\t\\t\\t50vw\",\"data-sentry-element\":\"CldImage\",\"data-sentry-component\":\"Image\",\"data-sentry-source-file\":\"image.tsx\"}],\"credits\":\"Adoc-Photos/Corbis/Getty Images\",\"caption\":[\"$\",\"div\",null,{\"className\":\"_153e98si _153e98sc\",\"data-sentry-component\":\"MaxLines\",\"data-sentry-source-file\":\"max-lines.tsx\",\"children\":[\"$\",\"div\",null,{\"className\":\"_42elsxd g1fwxfzw\",\"data-sentry-element\":\"Component\",\"data-sentry-component\":\"Box\",\"data-sentry-source-file\":\"box.tsx\",\"children\":[\"$\",\"p\",null,{\"children\":\"In France in 1915, a dog is dressed up as a German soldier—complete with pipe and goggles—to the amusement of soldiers marching by.\"}]}]}]}]\n"])</script><script>self.__next_f.push([1,"10f:[\"$\",\"$Lf6\",\"18YLQEbclQ0EzwzG0lIRUE\",{\"index\":14,\"image\":[\"$\",\"$L41\",null,{\"className\":\"\",\"src\":\"constant-companion\",\"alt\":\"\",\"width\":550,\"height\":350,\"sizes\":\"(max-width: 834px) 100vw,\\n\\t\\t\\t\\t(max-width: 1280px) 75vw,\\n\\t\\t\\t\\t50vw\",\"data-sentry-element\":\"CldImage\",\"data-sentry-component\":\"Image\",\"data-sentry-source-file\":\"image.tsx\"}],\"credits\":\"Smith Collection/Gado/Getty Images\",\"caption\":[\"$\",\"div\",null,{\"className\":\"_153e98si _153e98sc\",\"data-sentry-component\":\"MaxLines\",\"data-sentry-source-file\":\"max-lines.tsx\",\"children\":[\"$\",\"div\",null,{\"className\":\"_42elsxd g1fwxfzw\",\"data-sentry-element\":\"Component\",\"data-sentry-component\":\"Box\",\"data-sentry-source-file\":\"box.tsx\",\"children\":[\"$\",\"p\",null,{\"children\":\"German military pilots smoke pipes and chat alongside their canine companion. Dogs were great 'morale boosters' for troops on both sides of the conflict during World War I.\"}]}]}]}]\n"])</script><script>self.__next_f.push([1,"110:[\"$\",\"$Lf6\",\"5fAXvH5w7GsEWVZ7HuTK1Q\",{\"index\":15,\"image\":[\"$\",\"$L41\",null,{\"className\":\"\",\"src\":\"memorial-service-dog\",\"alt\":\"\",\"width\":550,\"height\":350,\"sizes\":\"(max-width: 834px) 100vw,\\n\\t\\t\\t\\t(max-width: 1280px) 75vw,\\n\\t\\t\\t\\t50vw\",\"data-sentry-element\":\"CldImage\",\"data-sentry-component\":\"Image\",\"data-sentry-source-file\":\"image.tsx\"}],\"credits\":\"Topical Press Agency/Getty Images\",\"caption\":[\"$\",\"div\",null,{\"className\":\"_153e98si _153e98sc\",\"data-sentry-component\":\"MaxLines\",\"data-sentry-source-file\":\"max-lines.tsx\",\"children\":[\"$\",\"div\",null,{\"className\":\"_42elsxd g1fwxfzw\",\"data-sentry-element\":\"Component\",\"data-sentry-component\":\"Box\",\"data-sentry-source-file\":\"box.tsx\",\"children\":[\"$\",\"p\",null,{\"children\":\"Mascots such as 'Doreen' of the 1st Battalion of the Irish Guards were often brought to memorial services. WWI was one of the deadliest conflicts in human history, with total casualties estimated at over 16 million.\"}]}]}]}]\n"])</script><script>self.__next_f.push([1,"111:[\"$\",\"$Lf6\",\"3EkmSAeLEWLHxmQM6zCRgJ\",{\"index\":16,\"image\":[\"$\",\"$L41\",null,{\"className\":\"\",\"src\":\"search-and-rescue\",\"alt\":\"\",\"width\":550,\"height\":350,\"sizes\":\"(max-width: 834px) 100vw,\\n\\t\\t\\t\\t(max-width: 1280px) 75vw,\\n\\t\\t\\t\\t50vw\",\"data-sentry-element\":\"CldImage\",\"data-sentry-component\":\"Image\",\"data-sentry-source-file\":\"image.tsx\"}],\"credits\":\"The Print Collector/Getty Images\",\"caption\":[\"$\",\"div\",null,{\"className\":\"_153e98si _153e98sc\",\"data-sentry-component\":\"MaxLines\",\"data-sentry-source-file