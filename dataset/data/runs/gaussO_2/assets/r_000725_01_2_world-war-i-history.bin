\":\"quick-facts-logo\",\"altText\":\"$undefined\",\"title\":\"Quick Facts Logo\",\"credit\":\"$undefined\",\"caption\":\"$undefined\",\"orientation\":\"landscape\",\"width\":128,\"height\":33,\"publicId\":\"Frame_41451_khtydw\",\"url\":\"http://res.cloudinary.com/aenetworks/image/upload/f_auto/q_auto/v1746023555/Frame_41451_khtydw.svg\"},\"data-sentry-element\":\"RightRail\",\"data-sentry-source-file\":\"rich-text-section.tsx\"}]]}]\n"])</script><script>self.__next_f.push([1,"95:[\"$\",\"$1\",\"full-bleed-1\",{\"children\":[\"$@b5\"]}]\n"])</script><script>self.__next_f.push([1,"96:[\"$\",\"div\",\"main-content-2\",{\"className\":\"i94vss1 i94vss4 g1fwxfnf g1fwxflx g1fwxfzo g1fwxfii\",\"data-name\":\"section\",\"data-sentry-element\":\"Component\",\"data-sentry-component\":\"Box\",\"data-sentry-source-file\":\"box.tsx\",\"children\":[\"$undefined\",[[\"$\",\"div\",null,{\"className\":\"g1fwxf4 g1fwxf7 g1fwxfy g1fwxfy8 g1fwxflu g1fwxfm9 g1fwxfn0\",\"data-contentful-field-id\":\"content\",\"data-contentful-entry-id\":\"4dn1XEkmYZYFLe5gMwbzPO\",\"id\":\"main-content-2\",\"data-sentry-element\":\"Component\",\"data-sentry-source-file\":\"box.tsx\",\"data-sentry-component\":\"Box\",\"children\":[\"$undefined\",[[\"$\",\"h2\",\"0\",{\"className\":\"_15il2ffd _15il2ffa a0xfey1 g1fwxfbr g1fwxfc1 _15il2ffl g1fwxfvr _15il2ffj\",\"id\":\"Kaiser-Wilhelm-II\",\"children\":[\"Kaiser Wilhelm II\"],\"data-sentry-element\":\"H\",\"data-sentry-component\":\"H2\",\"data-sentry-source-file\":\"heading.tsx\"}],[\"$\",\"div\",\"1\",{\"className\":\"_42elsx1 o2jrjz3 g1fwxfzs g1fwxfzw\",\"data-sentry-element\":\"Component\",\"data-sentry-source-file\":\"box.tsx\",\"children\":[\"$\",\"p\",null,{\"children\":[\"Because mighty Russia supported Serbia, Austria-Hungary waited to declare war until its leaders received assurance from German leader \",[\"$\",\"$L40\",\"1\",{\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":[\"Kaiser Wilhelm II\"],\"data-sentry-element\":\"NextLink\",\"data-sentry-component\":\"Link\",\"data-sentry-source-file\":\"link.tsx\",\"href\":\"/articles/world-war-i/kaiser-wilhelm-ii\",\"className\":\"mpgbmc0 _1jnz0oc1y g1fwxfm3 mpgbmc2 g1fwxflr\",\"prefetch\":false}],\" that Germany would support their cause. Austro-Hungarian leaders feared that a Russian intervention would involve Russia’s ally, France, and possibly Great Britain as well.\"]}],\"data-sentry-component\":\"Box\"}],[\"$\",\"div\",\"2\",{\"className\":\"_42elsx1 o2jrjz3 g1fwxfzs g1fwxfzw\",\"data-sentry-element\":\"Component\",\"data-sentry-source-file\":\"box.tsx\",\"children\":[\"$\",\"p\",null,{\"children\":[\"On July 5, Kaiser Wilhelm secretly pledged his support, giving Austria-Hungary a so-called carte blanche, or “blank check” assurance of Germany’s backing in the case of war. The Dual Monarchy of Austria-Hungary then sent an ultimatum to Serbia, with such harsh terms as to make it almost impossible to accept.\"]}],\"data-sentry-component\":\"Box\"}],[\"$\",\"h2\",\"3\",{\"className\":\"_15il2ffd _15il2ffa a0xfey1 g1fwxfbr g1fwxfc1 _15il2ffl g1fwxfvr _15il2ffj\",\"id\":\"World-War-I-Starts\",\"children\":[\"World War I Starts\"],\"data-sentry-element\":\"H\",\"data-sentry-component\":\"H2\",\"data-sentry-source-file\":\"heading.tsx\"}],[\"$\",\"div\",\"4\",{\"className\":\"_42elsx1 o2jrjz3 g1fwxfzs g1fwxfzw\",\"data-sentry-element\":\"Component\",\"data-sentry-source-file\":\"box.tsx\",\"children\":[\"$\",\"p\",null,{\"children\":[\"Convinced that Austria-Hungary was readying for war, the Serbian government ordered the Serbian army to mobilize and appealed to Russia for assistance. On July 28, Austria-Hungary declared war on Serbia, and the tenuous peace between Europe’s great powers quickly collapsed.\"]}],\"data-sentry-component\":\"Box\"}],[\"$\",\"div\",\"5\",{\"className\":\"_42elsx1 o2jrjz3 g1fwxfzs g1fwxfzw\",\"data-sentry-element\":\"Component\",\"data-sentry-source-file\":\"box.tsx\",\"children\":[\"$\",\"p\",null,{\"children\":[\"Within a week, Russia, Belgium, France, Great Britain and Serbia had lined up against Austria-Hungary and Germany, and World War I had begun.\"]}],\"data-sentry-component\":\"Box\"}],[\"$\",\"h2\",\"6\",{\"className\":\"_15il2ffd _15il2ffa a0xfey1 g1fwxfbr g1fwxfc1 _15il2ffl g1fwxfvr _15il2ffj\",\"id\":\"The-Western-Front\",\"children\":[\"The Western Front\"],\"data-sentry-element\":\"H\",\"data-sentry-component\":\"H2\",\"data-sentry-source-file\":\"heading.tsx\"}],[\"$\",\"div\",\"7\",{\"className\":\"_42elsx1 o2jrjz3 g1fwxfzs g1fwxfzw\",\"data-sentry-element\":\"Component\",\"data-sentry-source-file\":\"box.tsx\",\"children\":[\"$\",\"p\",null,{\"children\":[\"According to an aggressive military strategy known as the \",[\"$\",\"$L40\",\"1\",{\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":[\"Schlieffen Plan\"],\"data-sentry-element\":\"NextLink\",\"data-sentry-component\":\"Link\",\"data-sentry-source-file\":\"link.tsx\",\"href\":\"/articles/was-germany-doomed-in-world-war-i-by-the-schlieffen-plan\",\"className\":\"mpgbmc0 _1jnz0oc1y g1fwxfm3 mpgbmc2 g1fwxflr\",\"prefetch\":false}],\" (named for its mastermind, German Field Marshal \",\"$Lb6\",\"), Germany began fighting World War I on two fronts, invading France through neutral Belgium in the west and confronting Russia in the east.\"]}],\"data-sentry-component\":\"Box\"}],\"$Lb7\"]]}],\"$Lb8\"]]}]\n"])</script><script>self.__next_f.push([1,"97:[\"$\",\"$1\",\"full-bleed-3\",{\"children\":[\"$@b9\"]}]\n"])</script><script>self.__next_f.push([1,"98:[\"$\",\"div\",\"main-content-4\",{\"className\":\"i94vss1 i94vss4 g1fwxfnf g1fwxflx g1fwxfzo g1fwxfii\",\"data-name\":\"section\",\"data-sentry-element\":\"Component\",\"data-sentry-component\":\"Box\",\"data-sentry-source-file\":\"box.tsx\",\"children\":[\"$undefined\",[[\"$\",\"div\",null,{\"className\":\"g1fwxf4 g1fwxf7 g1fwxfy g1fwxfy8 g1fwxflu g1fwxfm9 g1fwxfn0\",\"data-contentful-field-id\":\"content\",\"data-contentful-entry-id\":\"4dn1XEkmYZYFLe5gMwbzPO\",\"id\":\"main-content-4\",\"data-sentry-element\":\"Component\",\"data-sentry-source-file\":\"box.tsx\",\"data-sentry-component\":\"Box\",\"children\":[\"$undefined\",[[\"$\",\"h2\",\"0\",{\"className\":\"_15il2ffd _15il2ffa a0xfey1 g1fwxfbr g1fwxfc1 _15il2ffl g1fwxfvr _15il2ffj\",\"id\":\"First-Battle-of-the-Marne\",\"children\":[\"First Battle of the Marne\"],\"data-sentry-element\":\"H\",\"data-sentry-component\":\"H2\",\"data-sentry-source-file\":\"heading.tsx\"}],[\"$\",\"div\",\"1\",{\"className\":\"_42elsx1 o2jrjz3 g1fwxfzs g1fwxfzw\",\"data-sentry-element\":\"Component\",\"data-sentry-source-file\":\"box.tsx\",\"children\":[\"$\",\"p\",null,{\"children\":[\"In the \",[\"$\",\"$L40\",\"1\",{\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":[\"First Battle of the Marne\"],\"data-sentry-element\":\"NextLink\",\"data-sentry-component\":\"Link\",\"data-sentry-source-file\":\"link.tsx\",\"href\":\"/articles/world-war-i/first-battle-of-marne\",\"className\":\"mpgbmc0 _1jnz0oc1y g1fwxfm3 mpgbmc2 g1fwxflr\",\"prefetch\":false}],\", fought from September 6-9, 1914, French and British forces confronted the invading German army, which had by then penetrated deep into northeastern France, within 30 miles of Paris. The Allied troops checked the German advance and mounted a successful counterattack, driving the Germans back to the north of the Aisne River.\"]}],\"data-sentry-component\":\"Box\"}],[\"$\",\"div\",\"2\",{\"className\":\"_42elsx1 o2jrjz3 g1fwxfzs g1fwxfzw\",\"data-sentry-element\":\"Component\",\"data-sentry-source-file\":\"box.tsx\",\"children\":[\"$\",\"p\",null,{\"children\":[\"The defeat meant the end of German plans for a quick victory in France. Both sides dug into \",[\"$\",\"$L40\",\"1\",{\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":[\"trenches\"],\"data-sentry-element\":\"NextLink\",\"data-sentry-component\":\"Link\",\"data-sentry-source-file\":\"link.tsx\",\"href\":\"/articles/life-in-the-trenches-of-world-war-i\",\"className\":\"mpgbmc0 _1jnz0oc1y g1fwxfm3 mpgbmc2 g1fwxflr\",\"prefetch\":false}],\", and the Western Front was the setting for a hellish war of attrition that would last more than three years.\"]}],\"data-sentry-component\":\"Box\"}],[\"$\",\"div\",\"3\",{\"className\":\"_42elsx1 o2jrjz3 g1fwxfzs g1fwxfzw\",\"data-sentry-element\":\"Component\",\"data-sentry-source-file\":\"box.tsx\",\"children\":[\"$\",\"p\",null,{\"children\":[\"Particularly long and costly battles in this campaign were fought at \",[\"$\",\"$L40\",\"1\",{\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":[\"Verdun\"],\"data-sentry-element\":\"NextLink\",\"data-sentry-component\":\"Link\",\"data-sentry-source-file\":\"link.tsx\",\"href\":\"/articles/world-war-i/battle-of-verdun\",\"className\":\"mpgbmc0 _1jnz0oc1y g1fwxfm3 mpgbmc2 g1fwxflr\",\"prefetch\":false}],\" (February-December 1916) and the \",[\"$\",\"$L40\",\"3\",{\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":[\"Battle of the Somme\"],\"data-sentry-element\":\"NextLink\",\"data-sentry-component\":\"Link\",\"data-sentry-source-file\":\"link.tsx\",\"href\":\"/articles/world-war-i/battle-of-the-somme\",\"className\":\"mpgbmc0 _1jnz0oc1y g1fwxfm3 mpgbmc2 g1fwxflr\",\"prefetch\":false}],\" (July-November 1916). German and French troops suffered close to a million casualties in the \",[\"$\",\"$L40\",\"5\",{\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":[\"Battle of Verdun\"],\"data-sentry-element\":\"NextLink\",\"data-sentry-component\":\"Link\",\"data-sentry-source-file\":\"link.tsx\",\"href\":\"/articles/world-war-i/battle-of-verdun\",\"className\":\"mpgbmc0 _1jnz0oc1y g1fwxfm3 mpgbmc2 g1fwxflr\",\"prefetch\":false}],\" alone.\"]}],\"data-sentry-component\":\"Box\"}],[\"$\",\"h2\",\"4\",{\"className\":\"_15il2ffd _15il2ffa a0xfey1 g1fwxfbr g1fwxfc1 _15il2ffl g1fwxfvr _15il2ffj\",\"id\":\"World-War-I-Books-and-Art\",\"children\":[\"World War I Books and Art\"],\"data-sentry-element\":\"H\",\"data-sentry-component\":\"H2\",\"data-sentry-source-file\":\"heading.tsx\"}],\"$Lba\",\"$Lbb\",\"$Lbc\"]]}],\"$Lbd\"]]}]\n"])</script><script>self.__next_f.push([1,"99:[\"$\",\"$1\",\"full-bleed-5\",{\"children\":[\"$@be\"]}]\n"])</script><script>self.__next_f.push([1,"9a:[\"$\",\"div\",\"main-content-6\",{\"className\":\"i94vss1 i94vss4 g1fwxfnf g1fwxflx g1fwxfzo g1fwxfii\",\"data-name\":\"section\",\"data-sentry-element\":\"Component\",\"data-sentry-component\":\"Box\",\"data-sentry-source-file\":\"box.tsx\",\"children\":[\"$undefined\",[[\"$\",\"div\",null,{\"className\":\"g1fwxf4 g1fwxf7 g1fwxfy g1fwxfy8 g1fwxflu g1fwxfm9 g1fwxfn0\",\"data-contentful-field-id\":\"content\",\"data-contentful-entry-id\":\"4dn1XEkmYZYFLe5gMwbzPO\",\"id\":\"main-content-6\",\"data-sentry-element\":\"Component\",\"data-sentry-source-file\":\"box.tsx\",\"data-sentry-component\":\"Box\",\"children\":[\"$undefined\",[[\"$\",\"h2\",\"0\",{\"className\":\"_15il2ffd _15il2ffa a0xfey1 g1fwxfbr g1fwxfc1 _15il2ffl g1fwxfvr _15il2ffj\",\"id\":\"The-Eastern-Front\",\"children\":[\"The Eastern Front\"],\"data-sentry-element\":\"H\",\"data-sentry-component\":\"H2\",\"data-sentry-source-file\":\"heading.tsx\"}],[\"$\",\"div\",\"1\",{\"className\":\"_42elsx1 o2jrjz3 g1fwxfzs g1fwxfzw\",\"data-sentry-element\":\"Component\",\"data-sentry-source-file\":\"box.tsx\",\"children\":[\"$\",\"p\",null,{\"children\":[\"On the Eastern Front of World War I, Russian forces invaded the German-held regions of East Prussia and Poland but were stopped short by German and Austrian forces at the \",[\"$\",\"$L40\",\"1\",{\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":[\"Battle of Tannenberg\"],\"data-sentry-element\":\"NextLink\",\"data-sentry-component\":\"Link\",\"data-sentry-source-file\":\"link.tsx\",\"href\":\"/articles/battle-of-tannenberg\",\"className\":\"mpgbmc0 _1jnz0oc1y g1fwxfm3 mpgbmc2 g1fwxflr\",\"prefetch\":false}],\" in late August 1914.\"]}],\"data-sentry-component\":\"Box\"}],[\"$\",\"div\",\"2\",{\"className\":\"_42elsx1 o2jrjz3 g1fwxfzs g1fwxfzw\",\"data-sentry-element\":\"Component\",\"data-sentry-source-file\":\"box.tsx\",\"children\":[\"$\",\"p\",null,{\"children\":[\"Despite that victory, Russia’s assault forced Germany to move two corps from the Western Front to the Eastern Front, contributing to the German loss in the Battle of the Marne.\"]}],\"data-sentry-component\":\"Box\"}],[\"$\",\"div\",\"3\",{\"className\":\"_42elsx1 o2jrjz3 g1fwxfzs g1fwxfzw\",\"data-sentry-element\":\"Component\",\"data-sentry-source-file\":\"box.tsx\",\"children\":[\"$\",\"p\",null,{\"children\":[\"Combined with the fierce Allied resistance in France, the ability of Russia’s huge war machine to mobilize relatively quickly in the east ensured a longer, more grueling conflict instead of the quick victory Germany had hoped to win under the \",[\"$\",\"$L40\",\"1\",{\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":[\"Schlieffen Plan\"],\"data-sentry-element\":\"NextLink\",\"data-sentry-component\":\"Link\",\"data-sentry-source-file\":\"link.tsx\",\"href\":\"/articles/was-germany-doomed-in-world-war-i-by-the-schlieffen-plan\",\"className\":\"mpgbmc0 _1jnz0oc1y g1fwxfm3 mpgbmc2 g1fwxflr\",\"prefetch\":false}],\".\"]}],\"data-sentry-component\":\"Box\"}],[\"$\",\"h2\",\"4\",{\"className\":\"_15il2ffd _15il2ffa a0xfey1 g1fwxfbr g1fwxfc1 _15il2ffl g1fwxfvr _15il2ffj\",\"id\":\"Russian-Revolution\",\"children\":[\"Russian Revolution\"],\"data-sentry-element\":\"H\",\"data-sentry-component\":\"H2\",\"data-sentry-source-file\":\"heading.tsx\"}],[\"$\",\"div\",\"5\",{\"className\":\"_42elsx1 o2jrjz3 g1fwxfzs g1fwxfzw\",\"data-sentry-element\":\"Component\",\"data-sentry-source-file\":\"box.tsx\",\"children\":[\"$\",\"p\",null,{\"children\":[\"From 1914 to 1916, Russia’s army mounted several offensives on World War I’s Eastern Front but was unable to break through German lines.\"]}],\"data-sentry-component\":\"Box\"}],[\"$\",\"div\",\"6\",{\"className\":\"_42elsx1 o2jrjz3 g1fwxfzs g1fwxfzw\",\"data-sentry-element\":\"Component\",\"data-sentry-source-file\":\"box.tsx\",\"children\":[\"$\",\"p\",null,{\"children\":[\"Defeat on the battlefield, combined with economic instability and the scarcity of food and other essentials, led to mounting discontent among the bulk of Russia’s population, especially the poverty-stricken workers and peasants. This increased hostility was directed toward the imperial regime of \",\"$Lbf\",\" and his unpopular German-born wife, Alexandra.\"]}],\"data-sentry-component\":\"Box\"}],\"$Lc0\",\"$Lc1\",\"$Lc2\"]]}],\"$Lc3\"]]}]\n"])</script><script>self.__next_f.push([1,"9b:[\"$\",\"$1\",\"full-bleed-7\",{\"children\":[\"$@c4\"]}]\n"])</script><script>self.__next_f.push([1,"9c:[\"$\",\"div\",\"main-content-8\",{\"className\":\"i94vss1 i94vss4 g1fwxfnf g1fwxflx g1fwxfzo g1fwxfii\",\"data-name\":\"section\",\"data-sentry-element\":\"Component\",\"data-sentry-component\":\"Box\",\"data-sentry-source-file\":\"box.tsx\",\"children\":[\"$undefined\",[[\"$\",\"div\",null,{\"className\":\"g1fwxf4 g1fwxf7 g1fwxfy g1fwxfy8 g1fwxflu g1fwxfm9 g1fwxfn0\",\"data-contentful-field-id\":\"content\",\"data-contentful-entry-id\":\"4dn1XEkmYZYFLe5gMwbzPO\",\"id\":\"main-content-8\",\"data-sentry-element\":\"Component\",\"data-sentry-source-file\":\"box.tsx\",\"data-sentry-component\":\"Box\",\"children\":[\"$undefined\",[[\"$\",\"div\",\"0\",{\"className\":\"_42elsx1 o2jrjz3 g1fwxfzs g1fwxfzw\",\"data-sentry-element\":\"Component\",\"data-sentry-source-file\":\"box.tsx\",\"children\":[\"$\",\"p\",null,{\"children\":[\"\",[\"$\",\"$L40\",\"1\",{\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":[\"Woodrow Wilson\"],\"data-sentry-element\":\"NextLink\",\"data-sentry-component\":\"Link\",\"data-sentry-source-file\":\"link.tsx\",\"href\":\"/articles/woodrow-wilson\",\"className\":\"mpgbmc0 _1jnz0oc1y g1fwxfm3 mpgbmc2 g1fwxflr\",\"prefetch\":false}],\" was president during World War I. At the outbreak of fighting in 1914, the U.S. remained on the sidelines, adopting the policy of neutrality favored by Wilson while continuing to engage in commerce and shipping with European countries on both sides of the conflict.\"]}],\"data-sentry-component\":\"Box\"}],[\"$\",\"div\",\"1\",{\"className\":\"_42elsx1 o2jrjz3 g1fwxfzs g1fwxfzw\",\"data-sentry-element\":\"Component\",\"data-sentry-source-file\":\"box.tsx\",\"children\":[\"$\",\"p\",null,{\"children\":[\"Neutrality, however, was increasingly difficult to maintain in the face of Germany’s unchecked submarine aggression against neutral ships, including those carrying passengers. In 1915, Germany declared the waters surrounding the British Isles to be a war zone, and \",[\"$\",\"$L40\",\"1\",{\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":[\"German U-boats\"],\"data-sentry-element\":\"NextLink\",\"data-sentry-component\":\"Link\",\"data-sentry-source-file\":\"link.tsx\",\"href\":\"/articles/world-war-i/deconstructing-history-u-boats-video\",\"className\":\"mpgbmc0 _1jnz0oc1y g1fwxfm3 mpgbmc2 g1fwxflr\",\"prefetch\":false}],\" sunk several commercial and passenger vessels, including some U.S. ships.\"]}],\"data-sentry-component\":\"Box\"}],[\"$\",\"div\",\"2\",{\"className\":\"_42elsx1 o2jrjz3 g1fwxfzs g1fwxfzw\",\"data-sentry-element\":\"Component\",\"data-sentry-source-file\":\"box.tsx\",\"children\":[\"$\",\"p\",null,{\"children\":[\"Widespread protest over the sinking by U-boat of the British ocean liner \",[\"$\",\"$L40\",\"1\",{\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":[\"Lusitania\"],\"data-sentry-element\":\"NextLink\",\"data-sentry-component\":\"Link\",\"data-sentry-source-file\":\"link.tsx\",\"href\":\"/articles/world-war-i/lusitania\",\"className\":\"mpgbmc0 _1jnz0oc1y g1fwxfm3 mpgbmc2 g1fwxflr\",\"prefetch\":false}],\"—traveling from \",[\"$\",\"$L40\",\"3\",{\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":[\"New York\"],\"data-sentry-element\":\"NextLink\",\"data-sentry-component\":\"Link\",\"data-sentry-source-file\":\"link.tsx\",\"href\":\"/articles/us-states/new-york\",\"className\":\"mpgbmc0 _1jnz0oc1y g1fwxfm3 mpgbmc2 g1fwxflr\",\"prefetch\":false}],\" to Liverpool, England, with hundreds of American passengers onboard—in May 1915 helped turn the tide of American public opinion against Germany. In February 1917, Congress passed a $250 million arms-appropriations bill intended to make the United States ready for war.\"]}],\"data-sentry-component\":\"Box\"}],[\"$\",\"div\",\"3\",{\"className\":\"_42elsx1 o2jrjz3 g1fwxfzs g1fwxfzw\",\"data-sentry-element\":\"Component\",\"data-sentry-source-file\":\"box.tsx\",\"children\":[\"$\",\"p\",null,{\"children\":[\"Germany sank four more U.S. merchant ships the following month, and on April 2 Woodrow Wilson appeared before Congress and called for a declaration of war against Germany.\"]}],\"data-sentry-component\":\"Box\"}],[\"$\",\"h2\",\"4\",{\"className\":\"_15il2ffd _15il2ffa a0xfey1 g1fwxfbr g1fwxfc1 _15il2ffl g1fwxfvr _15il2ffj\",\"id\":\"Gallipoli-Campaign\",\"children\":[\"Gallipoli Campaign\"],\"data-sentry-element\":\"H\",\"data-sentry-component\":\"H2\",\"data-sentry-source-file\":\"heading.tsx\"}]]]}],\"$Lc5\"]]}]\n"])</script><script>self.__next_f.push([1,"9d:[\"$\",\"$1\",\"full-bleed-9\",{\"children\":[\"$@c6\"]}]\n"])</script><script>self.__next_f.push([1,"9e:[\"$\",\"div\",\"main-content-10\",{\"className\":\"i94vss1 i94vss4 g1fwxfnf g1fwxflx g1fwxfzo g1fwxfii\",\"data-name\":\"section\",\"data-sentry-element\":\"Component\",\"data-sentry-component\":\"Box\",\"data-sentry-source-file\":\"box.tsx\",\"children\":[\"$undefined\",[[\"$\",\"div\",null,{\"className\":\"g1fwxf4 g1fwxf7 g1fwxfy g1fwxfy8 g1fwxflu g1fwxfm9 g1fwxfn0\",\"data-contentful-field-id\":\"content\",\"data-contentful-entry-id\":\"4dn1XEkmYZYFLe5gMwbzPO\",\"id\":\"main-content-10\",\"data-sentry-element\":\"Component\",\"data-sentry-source-file\":\"box.tsx\",\"data-sentry-component\":\"Box\",\"children\":[\"$undefined\",[[\"$\",\"div\",\"0\",{\"className\":\"_42elsx1 o2jrjz3 g1fwxfzs g1fwxfzw\",\"data-sentry-element\":\"Component\",\"data-sentry-source-file\":\"box.tsx\",\"children\":[\"$\",\"p\",null,{\"children\":[\"With World War I having effectively settled into a stalemate in Europe, the Allies attempted to score a victory against the Ottoman Empire, which entered the conflict on the side of the Central Powers in late 1914.\"]}],\"data-sentry-component\":\"Box\"}],[\"$\",\"div\",\"1\",{\"className\":\"_42elsx1 o2jrjz3 g1fwxfzs g1fwxfzw\",\"data-sentry-element\":\"Component\",\"data-sentry-source-file\":\"box.tsx\",\"children\":[\"$\",\"p\",null,{\"children\":[\"After a failed attack on the Dardanelles (the strait linking the Sea of Marmara with the Aegean Sea), Allied forces led by Britain launched a large-scale land invasion of the \",[\"$\",\"$L40\",\"1\",{\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":[\"Gallipoli\"],\"data-sentry-element\":\"NextLink\",\"data-sentry-component\":\"Link\",\"data-sentry-source-file\":\"link.tsx\",\"href\":\"/articles/world-war-i/battle-of-gallipoli\",\"className\":\"mpgbmc0 _1jnz0oc1y g1fwxfm3 mpgbmc2 g1fwxflr\",\"prefetch\":false}],\" Peninsula in April 1915. The invasion also proved a dismal failure, and in January 1916 Allied forces staged a full retreat from the shores of the peninsula after suffering 250,000 casualties.\"]}],\"data-sentry-component\":\"Box\"}],\"$@c7\",[\"$\",\"div\",\"3\",{\"className\":\"_42elsx1 o2jrjz3 g1fwxfzs g1fwxfzw\",\"data-sentry-element\":\"Component\",\"data-sentry-source-file\":\"box.tsx\",\"children\":[\"$\",\"p\",null,{\"children\":[\"British-led forces also combated the Ottoman Turks in Egypt and \",[\"$\",\"$L40\",\"1\",{\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":[\"Mesopotamia\"],\"data-sentry-element\":\"NextLink\",\"data-sentry-component\":\"Link\",\"data-sentry-source-file\":\"link.tsx\",\"href\":\"/articles/mesopotamia\",\"className\":\"mpgbmc0 _1jnz0oc1y g1fwxfm3 mpgbmc2 g1fwxflr\",\"prefetch\":false}],\", while in northern Italy, Austrian and Italian troops faced off in a series of 12 battles along the Isonzo River, located at the border between the two nations.\"]}],\"data-sentry-component\":\"Box\"}],[\"$\",\"h2\",\"4\",{\"className\":\"_15il2ffd _15il2ffa a0xfey1 g1fwxfbr g1fwxfc1 _15il2ffl g1fwxfvr _15il2ffj\",\"id\":\"Battle-of-the-Isonzo\",\"children\":[\"Battle of the Isonzo\"],\"data-sentry-element\":\"H\",\"data-sentry-component\":\"H2\",\"data-sentry-source-file\":\"heading.tsx\"}],[\"$\",\"div\",\"5\",{\"className\":\"_42elsx1 o2jrjz3 g1fwxfzs g1fwxfzw\",\"data-sentry-element\":\"Component\",\"data-sentry-source-file\":\"box.tsx\",\"children\":[\"$\",\"p\",null,{\"children\":[\"The \",[\"$\",\"$L40\",\"1\",{\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":[\"First Battle of the Isonzo\"],\"data-sentry-element\":\"NextLink\",\"data-sentry-component\":\"Link\",\"data-sentry-source-file\":\"link.tsx\",\"href\":\"/articles/world-war-i/eleven-battles-of-isonzo\",\"className\":\"mpgbmc0 _1jnz0oc1y g1fwxfm3 mpgbmc2 g1fwxflr\",\"prefetch\":false}],\" took place in the late spring of 1915, soon after Italy’s entrance into the war on the Allied side. In the Twelfth Battle of the Isonzo, also known as the \",[\"$\",\"$L40\",\"3\",{\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":[\"Battle of Caporetto\"],\"data-sentry-element\":\"NextLink\",\"data-sentry-component\":\"Link\",\"data-sentry-source-file\":\"link.tsx\",\"href\":\"/articles/world-war-i/battle-of-caporetto\",\"className\":\"mpgbmc0 _1jnz0oc1y g1fwxfm3 mpgbmc2 g1fwxflr\",\"prefetch\":false}],\" (October 1917), German reinforcements helped Austria-Hungary win a decisive victory.\"]}],\"data-sentry-component\":\"Box\"}],\"$Lc8\",\"$Lc9\",\"$Lca\",\"$Lcb\",\"$Lcc\",\"$Lcd\",\"$Lce\",\"$Lcf\",\"$Ld0\",\"$Ld1\",\"$Ld2\",\"$Ld3\",\"$Ld4\",\"$Ld5\",\"$Ld6\",\"