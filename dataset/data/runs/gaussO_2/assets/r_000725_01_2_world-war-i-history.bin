,\"data-sentry-source-file\":\"image.tsx\"}],\"credits\":\"Ullstein Bild/Getty Images\",\"caption\":[\"$\",\"div\",null,{\"className\":\"_153e98si _153e98sc\",\"data-sentry-component\":\"MaxLines\",\"data-sentry-source-file\":\"max-lines.tsx\",\"children\":[\"$\",\"div\",null,{\"className\":\"_42elsxd g1fwxfzw\",\"data-sentry-element\":\"Component\",\"data-sentry-component\":\"Box\",\"data-sentry-source-file\":\"box.tsx\",\"children\":[\"$\",\"p\",null,{\"children\":\"A German soldier walking through the ruins of Peronne, in northern France, in November 1916.\"}]}]}]}]\n"])</script><script>self.__next_f.push([1,"104:[\"$\",\"$L41\",null,{\"className\":\"\",\"src\":\"terriers-made-good-soldiers_1_ux1ciy\",\"alt\":\"\",\"width\":550,\"height\":350,\"sizes\":\"(max-width: 834px) 100vw,\\n\\t\\t\\t\\t(max-width: 1280px) 75vw,\\n\\t\\t\\t\\t50vw\",\"data-sentry-element\":\"CldImage\",\"data-sentry-component\":\"Image\",\"data-sentry-source-file\":\"image.tsx\"}]\n105:[\"$\",\"div\",null,{\"className\":\"_153e98si _153e98sc\",\"data-sentry-component\":\"MaxLines\",\"data-sentry-source-file\":\"max-lines.tsx\",\"children\":[\"$\",\"div\",null,{\"className\":\"_42elsxd g1fwxfzw\",\"data-sentry-element\":\"Component\",\"data-sentry-component\":\"Box\",\"data-sentry-source-file\":\"box.tsx\",\"children\":[\"$\",\"p\",null,{\"children\":\"Terriers were a preferred breed during WWI for their loyalty, rodent-hunting skills and friendly demeanors. A New Zealand soldier poses here with a regimental mascot during the Gallipoli campaign in Turkey.\"}]}]}]\n"])</script><script>self.__next_f.push([1,"106:[\"$\",\"$Lf6\",\"o1HfHmKDUWSPZh0aZi5Uf\",{\"index\":5,\"image\":[\"$\",\"$L41\",null,{\"className\":\"\",\"src\":\"war-gear\",\"alt\":\"\",\"width\":550,\"height\":350,\"sizes\":\"(max-width: 834px) 100vw,\\n\\t\\t\\t\\t(max-width: 1280px) 75vw,\\n\\t\\t\\t\\t50vw\",\"data-sentry-element\":\"CldImage\",\"data-sentry-component\":\"Image\",\"data-sentry-source-file\":\"image.tsx\"}],\"credits\":\"Henry Guttmann/Getty Images\",\"caption\":[\"$\",\"div\",null,{\"className\":\"_153e98si _153e98sc\",\"data-sentry-component\":\"MaxLines\",\"data-sentry-source-file\":\"max-lines.tsx\",\"children\":[\"$\",\"div\",null,{\"className\":\"_42elsxd g1fwxfzw\",\"data-sentry-element\":\"Component\",\"data-sentry-component\":\"Box\",\"data-sentry-source-file\":\"box.tsx\",\"children\":[\"$\",\"p\",null,{\"children\":\"Germany officially began using dogs during wartime in the late 19th century. In WWI, Allied Forces used at least 20,000 dogs on the battlefield, while the Central Powers—primarily Germany—used about 30,000.\"}]}]}]}]\n"])</script><script>self.__next_f.push([1,"107:[\"$\",\"$Lf6\",\"5KQQuwb99zV08Yv4oR340d\",{\"index\":6,\"image\":[\"$\",\"$L41\",null,{\"className\":\"\",\"src\":\"speedy-delivery\",\"alt\":\"\",\"width\":550,\"height\":350,\"sizes\":\"(max-width: 834px) 100vw,\\n\\t\\t\\t\\t(max-width: 1280px) 75vw,\\n\\t\\t\\t\\t50vw\",\"data-sentry-element\":\"CldImage\",\"data-sentry-component\":\"Image\",\"data-sentry-source-file\":\"image.tsx\"}],\"credits\":\"Daily Mirror/Mirrorpix/Getty Images\",\"caption\":[\"$\",\"div\",null,{\"className\":\"_153e98si _153e98sc\",\"data-sentry-component\":\"MaxLines\",\"data-sentry-source-file\":\"max-lines.tsx\",\"children\":[\"$\",\"div\",null,{\"className\":\"_42elsxd g1fwxfzw\",\"data-sentry-element\":\"Component\",\"data-sentry-component\":\"Box\",\"data-sentry-source-file\":\"box.tsx\",\"children\":[\"$\",\"p\",null,{\"children\":\"During World War I, dogs were primarily used as messengers. On July 5, 1916, this messenger dog used by the British Army in Flanders, Belgium, runs to the front with urgent messages.\"}]}]}]}]\n"])</script><script>self.__next_f.push([1,"108:[\"$\",\"$Lf6\",\"6rNfLJrgKpgG0zowYdUD5H\",{\"index\":7,\"image\":[\"$\",\"$L41\",null,{\"className\":\"\",\"src\":\"special-collars\",\"alt\":\"\",\"width\":550,\"height\":350,\"sizes\":\"(max-width: 834px) 100vw,\\n\\t\\t\\t\\t(max-width: 1280px) 75vw,\\n\\t\\t\\t\\t50vw\",\"data-sentry-element\":\"CldImage\",\"data-sentry-component\":\"Image\",\"data-sentry-source-file\":\"image.tsx\"}],\"credits\":\"Second Lt. D McLellan/IWM/Getty Images\",\"caption\":[\"$\",\"div\",null,{\"className\":\"_153e98si _153e98sc\",\"data-sentry-component\":\"MaxLines\",\"data-sentry-source-file\":\"max-lines.tsx\",\"children\":[\"$\",\"div\",null,{\"className\":\"_42elsxd g1fwxfzw\",\"data-sentry-element\":\"Component\",\"data-sentry-component\":\"Box\",\"data-sentry-source-file\":\"box.tsx\",\"children\":[\"$\",\"p\",null,{\"children\":\"Message dogs were often outfitted with collars that had attached cylinders. Here, a sergeant of the Royal Engineers places a message into the cylinder on August 28, 1918, at Etaples, France.\"}]}]}]}]\n"])</script><script>self.__next_f.push([1,"109:[\"$\",\"$Lf6\",\"1qnYbzBCpkj6iLuNmpJRTq\",{\"index\":8,\"image\":[\"$\",\"$L41\",null,{\"className\":\"\",\"src\":\"obstacle-course\",\"alt\":\"\",\"width\":550,\"height\":350,\"sizes\":\"(max-width: 834px) 100vw,\\n\\t\\t\\t\\t(max-width: 1280px) 75vw,\\n\\t\\t\\t\\t50vw\",\"data-sentry-element\":\"CldImage\",\"data-sentry-component\":\"Image\",\"data-sentry-source-file\":\"image.tsx\"}],\"credits\":\"Popperfoto/Getty Images\",\"caption\":[\"$\",\"div\",null,{\"className\":\"_153e98si _153e98sc\",\"data-sentry-component\":\"MaxLines\",\"data-sentry-source-file\":\"max-lines.tsx\",\"children\":[\"$\",\"div\",null,{\"className\":\"_42elsxd g1fwxfzw\",\"data-sentry-element\":\"Component\",\"data-sentry-component\":\"Box\",\"data-sentry-source-file\":\"box.tsx\",\"children\":[\"$\",\"p\",null,{\"children\":\"Messenger dogs such as 'Wolf,' an Alsatian, often had to negotiate dangerous obstacles, including barbed wire entanglements. Here, Wolf clears a fence at the Western Front in Flanders, Belgium.\"}]}]}]}]\n"])</script><script>self.__next_f.push([1,"10a:[\"$\",\"$Lf6\",\"4XydiXz97S3922Cv6Oz1Gu\",{\"index\":9,\"image\":[\"$\",\"$L41\",nul