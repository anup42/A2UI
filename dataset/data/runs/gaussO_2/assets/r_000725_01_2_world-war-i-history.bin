,\\n\\t\\t\\t\\t(max-width: 1280px) 75vw,\\n\\t\\t\\t\\t50vw\",\"aspectRatio\":2,\"gravity\":\"auto\",\"data-sentry-element\":\"CldImage\",\"data-sentry-source-file\":\"image.tsx\",\"data-sentry-component\":\"Image\"}],\"data-sentry-component\":\"Box\"}],false,[\"$\",\"span\",null,{\"children\":[\"$undefined\",\"Buyenlarge/Getty Images\",null],\"className\":\"_198y7iph _198y7ipb _198y7ip4 x4or4w6 g1fwxfil g1fwxfju g1fwxfl0 g1fwxfzy\",\"data-sentry-element\":\"Component\",\"data-sentry-source-file\":\"box.tsx\",\"data-sentry-component\":\"Box\",\"ref\":null}],[\"$\",\"div\",null,{\"className\":\"g1fwxflu g1fwxfk0 g1fwxfio\",\"data-sentry-element\":\"Component\",\"data-sentry-source-file\":\"box.tsx\",\"children\":[[\"$\",\"div\",null,{\"className\":\"_6y1v0z7 g1fwxflu g1fwxfm9 g1fwxfmr\",\"data-sentry-element\":\"Component\",\"data-sentry-source-file\":\"box.tsx\",\"children\":[[\"$\",\"span\",null,{\"children\":[\"$undefined\",[\"Published: \",\"October 29, 2009\"],null],\"className\":\"_198y7iph _198y7ipb _198y7ip4 g1fwxfil g1fwxfju g1fwxfzx\",\"data-sentry-element\":\"Component\",\"data-sentry-source-file\":\"box.tsx\",\"data-sentry-component\":\"Box\",\"ref\":null}],[\"$\",\"span\",null,{\"children\":[[\"$\",\"svg\",null,{\"width\":48,\"height\":48,\"viewBox\":\"0 0 48 48\",\"fill\":\"none\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"aria-hidden\":true,\"className\":\"g1fwxf103 _11axmyd9 _11axmyd1 x4or4w6\",\"data-sentry-element\":\"svg\",\"data-sentry-component\":\"IconSvg\",\"data-sentry-source-file\":\"icon.tsx\",\"children\":[\"$\",\"path\",null,{\"d\":\"M30 20L40 30M40 30L30 40M40 30H16C13.8783 30 11.8434 29.1571 10.3431 27.6569C8.84285 26.1566 8 24.1217 8 22V8\",\"stroke\":\"currentColor\",\"strokeWidth\":\"4\",\"strokeLinecap\":\"inherit\",\"strokeLinejoin\":\"inherit\",\"data-sentry-element\":\"path\",\"data-sentry-source-file\":\"corner-down-left.tsx\"}]}],[\"Last Updated: \",\"January 02, 2026\"],null],\"className\":\"_198y7iph _198y7ipb _198y7ip4 g1fwxflu g1fwxfof _6y1v0z8 g1fwxfil g1fwxfju g1fwxfzw g1fwxflu g1fwxfoi g1fwxfgu\",\"data-sentry-element\":\"Component\",\"data-sentry-component\":\"Box\",\"data-sentry-source-file\":\"box.tsx\",\"ref\":null}]],\"data-sentry-component\":\"Box\"}],[\"$\",\"div\",null,{\"className\":\"x4or4w6\",\"data-sentry-element\":\"Component\",\"data-sentry-source-file\":\"box.tsx\",\"children\":[\"$\",\"div\",null,{\"className\":\"_1qo2kklc _1qo2kkl0 g1fwxf3l\",\"data-sentry-element\":\"Component\",\"data-sentry-source-file\":\"box.tsx\",\"children\":[[\"$\",\"$L90\",null,{\"data-sentry-element\":\"PrintButton\",\"data-sentry-source-file\":\"article-header.tsx\"}],[\"$\",\"$L91\",null,{\"title\":\"World War I\",\"brand\":\"History\",\"shareText\":\"Share this article\",\"data-sentry-element\":\"ShareButton\",\"data-sentry-source-file\":\"article-header.tsx\"}]],\"data-sentry-component\":\"Box\"}],\"data-sentry-component\":\"Box\"}]],\"data-sentry-component\":\"Box\"}]],\"data-sentry-component\":\"Box\"}]\n"])</script><script>self.__next_f.push([1,"86:[\"$\",\"div\",null,{\"className\":\"x4or4w6 i94vss1 i94vss4 g1fwxfnf g1fwxflx g1fwxfzo g1fwxfii\",\"data-name\":\"section\",\"data-sentry-element\":\"Component\",\"data-sentry-component\":\"Box\",\"data-sentry-source-file\":\"box.tsx\",\"children\":[\"$undefined\",[\"$\",\"$L92\",null,{\"content\":[{\"nodeType\":\"heading-2\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"The Assassination of Archduke Franz Ferdinand\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"Tensions had been brewing throughout Europe—especially in the troubled Balkan region of southeast Europe—for years before World War I actually broke out.\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"A number of alliances involving European powers, the \",\"marks\":[],\"data\":{}},{\"nodeType\":\"hyperlink\",\"data\":{\"uri\":\"/articles/ottoman-empire\"},\"content\":[{\"nodeType\":\"text\",\"value\":\"Ottoman Empire\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"text\",\"value\":\", Russia and other parties had existed for years, but political instability in the \",\"marks\":[],\"data\":{}},{\"nodeType\":\"hyperlink\",\"data\":{\"uri\":\"/this-day-in-history/the-first-balkan-war-ends\"},\"content\":[{\"nodeType\":\"text\",\"value\":\"Balkans\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"text\",\"value\":\" (particularly Bosnia, Serbia and Herzegovina) threatened to destroy these agreements.\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"The spark that ignited World War I was struck in Sarajevo, Bosnia, where \",\"marks\":[],\"data\":{}},{\"nodeType\":\"hyperlink\",\"data\":{\"uri\":\"/this-day-in-history/archduke-franz-ferdinand-assassinated\"},\"content\":[{\"nodeType\":\"text\",\"value\":\"Archduke Franz Ferdinand\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"text\",\"value\":\"—heir to the Austro-Hungarian Empire—was shot to death along with his wife, Sophie, by the Serbian nationalist Gavrilo Princip on June 28, 1914. Princip and other nationalists were struggling to end Austro-Hungarian rule over Bosnia and Herzegovina.\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"The assassination of Franz Ferdinand set off a rapidly escalating chain of events: \",\"marks\":[],\"data\":{}},{\"nodeType\":\"hyperlink\",\"data\":{\"uri\":\"/this-day-in-history/austria-hungary-declares-war-on-serbia\"},\"content\":[{\"nodeType\":\"text\",\"value\":\"Austria-Hungary\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"text\",\"value\":\", like many countries around the world, blamed the Serbian government for the attack and hoped to use the incident as justification for settling the question of Serbian nationalism once and for all.\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"embedded-entry-block\",\"data\":{\"target\":{\"sys\":{\"id\":\"2qUJWkMvzZlQViI1eb933Q\",\"type\":\"Link\",\"linkType\":\"Entry\"}}},\"content\":[]},{\"nodeType\":\"heading-2\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"Kaiser Wilhelm II\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"Because mighty Russia supported Serbia, Austria-Hungary waited to declare war until its leaders received assurance from German leader \",\"marks\":[],\"data\":{}},{\"nodeType\":\"hyperlink\",\"data\":{\"uri\":\"/articles/world-war-i/kaiser-wilhelm-ii\"},\"content\":[{\"nodeType\":\"text\",\"value\":\"Kaiser Wilhelm II\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"text\",\"value\":\" that Germany would support their cause. Austro-Hungarian leaders feared that a Russian intervention would involve Russia’s ally, France, and possibly Great Britain as well.\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"On July 5, Kaiser Wilhelm secretly pledged his support, giving Austria-Hungary a so-called carte blanche, or “blank check” assurance of Germany’s backing in the case of war. The Dual Monarchy of Austria-Hungary then sent an ultimatum to Serbia, with such harsh terms as to make it almost impossible to accept.\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"heading-2\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"World War I Starts\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"Convinced that Austria-Hungary was readying for war, the Serbian government ordered the Serbian army to mobilize and appealed to Russia for assistance. On July 28, Austria-Hungary declared war on Serbia, and the tenuous peace between Europe’s great powers quickly collapsed.\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"Within a week, Russia, Belgium, France, Great Britain and Serbia had lined up against Austria-Hungary and Germany, and World War I had begun.\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"heading-2\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"The Western Front\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"According to an aggressive military strategy known as the \",\"marks\":[],\"data\":{}},{\"nodeType\":\"hyperlink\",\"data\":{\"uri\":\"/articles/was-germany-doomed-in-world-war-i-by-the-schlieffen-plan\"},\"content\":[{\"nodeType\":\"text\",\"value\":\"Schlieffen Plan\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"text\",\"value\":\" (named for its mastermind, German Field Marshal \",\"marks\":[],\"data\":{}},{\"nodeType\":\"hyperlink\",\"data\":{\"uri\":\"/this-day-in-history/alfred-von-schlieffen-dies\"},\"content\":[{\"nodeType\":\"text\",\"value\":\"Alfred von Schlieffen\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"text\",\"value\":\"), Germany began fighting World War I on two fronts, invading France through neutral Belgium in the west and confronting Russia in the east.\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"On August 4, 1914, German troops crossed the border into Belgium. In the first battle of World War I, the Germans assaulted the heavily fortified city of \",\"marks\":[],\"data\":{}},{\"nodeType\":\"hyperlink\",\"data\":{\"uri\":\"/this-day-in-history/german-assault-on-liege-begins-first-battle-of-world-war-i\"},\"content\":[{\"nodeType\":\"text\",\"value\":\"Liege\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"text\",\"value\":\", using the most powerful weapons in their arsenal—enormous siege cannons—to capture the city by August 15. The Germans left death and destruction in their wake as they advanced through Belgium toward France, shooting civilians and executing a Belgian priest they had accused of inciting civilian resistance.\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"embedded-entry-block\",\"data\":{\"target\":{\"sys\":{\"id\":\"5rcq4t2j6KkmcQ6akizR23\",\"type\":\"Link\",\"linkType\":\"Entry\"}}},\"content\":[]},{\"nodeType\":\"heading-2\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"First Battle of the Marne\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"In the \",\"marks\":[],\"data\":{}},{\"nodeType\":\"hyperlink\",\"data\":{\"uri\":\"/articles/world-war-i/first-battle-of-marne\"},\"content\":[{\"nodeType\":\"text\",\"value\":\"First Battle of the Marne\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"text\",\"value\":\", fought from September 6-9, 1914, French and British forces confronted the invading German army, which had by then penetrated deep into northeastern France, within 30 miles of Paris. The Allied troops checked the German advance and mounted a successful counterattack, driving the Germans back to the north of the Aisne River.\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"The defeat meant the end of German plans for a quick victory in France. Both sides dug into \",\"marks\":[],\"data\":{}},{\"nodeType\":\"hyperlink\",\"data\":{\"uri\":\"/articles/life-in-the-trenches-of-world-war-i\"},\"content\":[{\"nodeType\":\"text\",\"value\":\"trenches\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"text\",\"value\":\", and the Western Front was the setting for a hellish war of attrition that would last more than three years.\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"Particularly long and costly battles in this campaign were fought at \",\"marks\":[],\"data\":{}},{\"nodeType\":\"hyperlink\",\"data\":{\"uri\":\"/articles/world-war-i/battle-of-verdun\"},\"content\":[{\"nodeType\":\"text\",\"value\":\"Verdun\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"text\",\"value\":\" (February-December 1916) and the \",\"marks\":[],\"data\":{}},{\"nodeType\":\"hyperlink\",\"data\":{\"uri\":\"/articles/world-war-i/battle-of-the-somme\"},\"content\":[{\"nodeType\":\"text\",\"value\":\"Battle of the Somme\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"text\",\"value\":\" (July-November 1916). German and French troops suffered close to a million casualties in the \",\"marks\":[],\"data\":{}},{\"nodeType\":\"hyperlink\",\"data\":{\"uri\":\"/articles/world-war-i/battle-of-verdun\"},\"content\":[{\"nodeType\":\"text\",\"value\":\"Battle of Verdun\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"text\",\"value\":\" alone.\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"heading-2\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"World War I Books and Art\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"The bloodshed on the battlefields of the Western Front, and the difficulties its soldiers had for years after the fighting had ended, inspired such works of art as \",\"marks\":[],\"data\":{}},{\"nodeType\":\"hyperlink\",\"data\":{\"uri\":\"/this-day-in-history/remarque-publishes-all-quiet-on-the-western-front\"},\"content\":[{\"nodeType\":\"text\",\"value\":\"All Quiet on the Western Front\",\"marks\":[{\"type\":\"italic\"}],\"data\":{}}]},{\"nodeType\":\"text\",\"value\":\" by \",\"marks\":[],\"data\":{}},{\"nodeType\":\"hyperlink\",\"data\":{\"uri\":\"/this-day-in-history/erich-maria-remarque-born\"},\"content\":[{\"nodeType\":\"text\",\"value\":\"Erich Maria Remarque\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"text\",\"value\":\" and \\\"In Flanders Fields\\\" by Canadian doctor Lieutenant-Colonel \",\"marks\":[],\"data\":{}},{\"nodeType\":\"hyperlink\",\"data\":{\"uri\":\"/articles/8-battlefield-poets-of-world-war-i\"},\"content\":[{\"nodeType\":\"text\",\"value\":\"John McCrae\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"text\",\"value\":\". In the latter poem, McCrae writes from the perspective of the fallen soldiers:\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"Published in 1915, the poem inspired the use of the \",\"marks\":[],\"data\":{}},{\"nodeType\":\"hyperlink\",\"data\":{\"uri\":\"/articles/world-war-i-poppy-remembrance-symbol-veterans-day\"},\"content\":[{\"nodeType\":\"text\",\"value\":\"poppy as a symbol\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"text\",\"value\":\" of remembrance.\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"Visual artists like Otto Dix of Germany and British painters Wyndham Lewis, Paul Nash and David Bomberg used their firsthand experience as soldiers in World War I to create their art, capturing the anguish of trench warfare and exploring the themes of technology, violence and landscapes decimated by war.\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"embedded-entry-block\",\"data\":{\"target\":{\"sys\":{\"id\":\"7xQnJPqwXCXmBtea1KoFlH\",\"type\":\"Link\",\"linkType\":\"Entry\"}}},\"content\":[]},{\"nodeType\":\"heading-2\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"The Eastern Front\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"On the Eastern Front of World War I, Russian forces invaded the German-held regions of East Prussia and Poland but were stopped short by German and Austrian forces at the \",\"marks\":[],\"data\":{}},{\"nodeType\":\"hyperlink\",\"data\":{\"uri\":\"/articles/battle-of-tannenberg\"},\"content\":[{\"nodeType\":\"text\",\"value\":\"Battle of Tannenberg\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"text\",\"value\":\" in late August 1914.\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"Despite that victory, Russia’s assault forced Germany to move two corps from the Western Front to the Eastern Front, contributing to the German loss in the Battle of the Marne.\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"Combined with the fierce Allied resistance in France, the ability of Russia’s huge war machine to mobilize relatively quickly in the east ensured a longer, more grueling conflict instead of the quick victory Germany had hoped to win under the \",\"marks\":[],\"data\":{}},{\"nodeType\":\"hyperlink\",\"data\":{\"uri\":\"/articles/was-germany-doomed-in-world-war-i-by-the-schlieffen-plan\"},\"content\":[{\"nodeType\":\"text\",\"value\":\"Schlieffen Plan\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"text\",\"value\":\".\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"heading-2\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"Russian Revolution\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"From 1914 to 1916, Russia’s army mounted several offensives on World War I’s Eastern Front but was unable to break through German lines.\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"Defeat on the battlefield, combined with economic instability and the scarcity of food and other essentials, led to mounting discontent among the bulk of Russia’s population, especially the poverty-stricken workers and peasants. This increased hostility was directed toward the imperial regime of \",\"marks\":[],\"data\":{}},{\"nodeType\":\"hyperlink\",\"data\":{\"uri\":\"/this-day-in-history/czar-nicholas-ii-abdicates\"},\"content\":[{\"nodeType\":\"text\",\"value\":\"Czar Nicholas II\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"text\",\"value\":\" and his unpopular German-born wife, Alexandra.\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"Russia’s simmering instability exploded in the \",\"marks\":[],\"data\":{}},{\"nodeType\":\"hyperlink\",\"data\":{\"uri\":\"/articles/russian-revolution\"},\"content\":[{\"nodeType\":\"text\",\"value\":\"Russian Revolution\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"text\",\"value\":\" of 1917, spearheaded by \",\"marks\":[],\"data\":{}},{\"nodeType\":\"hyperlink\",\"data\":{\"uri\":\"/articles/vladimir-lenin\"},\"content\":[{\"nodeType\":\"text\",\"value\":\"Vladimir Lenin\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"text\",\"value\":\" and the \",\"marks\":[],\"data\":{}},{\"nodeType\":\"hyperlink\",\"data\":{\"uri\":\"http://www.history.com/this-day-in-history/bolsheviks-revolt-in-russia\"},\"content\":[{\"nodeType\":\"text\",\"value\":\"Bolsheviks\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"text\",\"value\":\", which ended czarist rule and brought a halt to Russian participation in World War I.\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"Russia reached an \",\"marks\":[],\"data\":{}},{\"nodeType\":\"hyperlink\",\"data\":{\"uri\":\"/this-day-in-history/russia-reaches-armistice-with-the-central-powers\"},\"content\":[{\"nodeType\":\"text\",\"value\":\"armistice with the Central Powers\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"text\",\"value\":\" in early December 1917, freeing German troops to face the remaining Allies on the Western Front.\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"heading-2\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"America Enters World War I\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"embedded-entry-block\",\"data\":{\"target\":{\"sys\":{\"id\":\"5NBNBimXs4hye44tff0pRK\",\"type\":\"Link\",\"linkType\":\"Entry\"}}},\"content\":[]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"\",\"marks\":[],\"data\":{}},{\"nodeType\":\"hyperlink\",\"data\":{\"uri\":\"/articles/woodrow-wilson\"},\"content\":[{\"nodeType\":\"text\",\"value\":\"Woodrow Wilson\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"text\",\"value\":\" was president during World War I. At the outbreak of fighting in 1914, the U.S. remained on the sidelines, adopting the policy of neutrality favored by Wilson while continuing to engage in commerce and shipping with European countries on both sides of the conflict.\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"Neutrality, however, was increasingly difficult to maintain in the face of Germany’s unchecked submarine aggression against neutral ships, including those carrying passengers. In 1915, Germany declared the waters surrounding the British Isles to be a war zone, and \",\"marks\":[],\"data\":{}},{\"nodeType\":\"hyperlink\",\"data\":{\"uri\":\"/articles/world-war-i/deconstructing-history-u-boats-video\"},\"content\":[{\"nodeType\":\"text\",\"value\":\"German U-boats\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"text\",\"value\":\" sunk several commercial and passenger vessels, including some U.S. ships.\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"Widespread protest over the sinking by U-boat of the British ocean liner \",\"marks\":[],\"data\":{}},{\"nodeType\":\"hyperlink\",\"data\":{\"uri\":\"/articles/world-war-i/lusitania\"},\"content\":[{\"nodeType\":\"text\",\"value\":\"Lusitania\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"text\",\"value\":\"—traveling from \",\"marks\":[],\"data\":{}},{\"nodeType\":\"hyperlink\",\"data\":{\"uri\":\"/articles/us-states/new-york\"},\"content\":[{\"nodeType\":\"text\",\"value\":\"New York\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"text\",\"value\":\" to Liverpool, England, with hundreds of American passengers onboard—in May 1915 helped turn the tide of American public opinion against Germany. In February 1917, Congress passed a $250 million arms-appropriations bill intended to make the United States ready for war.\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"Germany sank four more U.S. merchant ships the following month, and on April 2 Woodrow Wilson appeared before Congress and called for a declaration of war against Germany.\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"heading-2\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"Gallipoli Campaign\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"embedded-entry-block\",\"data\":{\"target\":{\"sys\":{\"id\":\"4YH5BDzmt0Ki9ZtB8K9M9g\",\"type\":\"Link\",\"linkType\":\"Entry\"}}},\"content\":[]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"With World War I having effectively settled into a stalemate in Europe, the Allies attempted to score a victory against the Ottoman Empire, which entered the conflict on the side of the Central Powers in late 1914.\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"After a failed attack on the Dardanelles (the strait linking the Sea of Marmara with the Aegean Sea), Allied forces led by Britain launched a large-scale land invasion of the \",\"marks\":[],\"data\":{}},{\"nodeType\":\"hyperlink\",\"data\":{\"uri\":\"/articles/world-war-i/battle-of-gallipoli\"},\"content\":[{\"nodeType\":\"text\",\"value\":\"Gallipoli\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"text\",\"value\":\" Peninsula in April 1915. The invasion also proved a dismal failure, and in January 1916 Allied forces staged a full retreat from the shores of the peninsula after suffering 250,000 casualties.\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"embedded-entry-block\",\"data\":{\"target\":{\"sys\":{\"id\":\"7zw8cx5ltTrMPw6Sxxp4GN\",\"type\":\"Link\",\"linkType\":\"Entry\"}}},\"content\":[]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"British-led forces also combated the Ottoman Turks in Egypt and \",\"marks\":[],\"data\":{}},{\"nodeType\":\"hyperlink\",\"data\":{\"uri\":\"/articles/mesopotamia\"},\"content\":[{\"nodeType\":\"text\",\"value\":\"Mesopotamia\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"text\",\"value\":\", while in northern Italy, Austrian and Italian troops faced off in a series of 12 battles along the Isonzo River, located at the border between the two nations.\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"heading-2\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"Battle of the Isonzo\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"The \",\"marks\":[],\"data\":{}},{\"nodeType\":\"hyperlink\",\"data\":{\"uri\":\"/articles/world-war-i/eleven-battles-of-isonzo\"},\"content\":[{\"nodeType\":\"text\",\"value\":\"First Battle of the Isonzo\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"text\",\"value\":\" took place in the late spring of 1915, soon after Italy’s entrance into the war on the Allied side. In the Twelfth Battle of the Isonzo, also known as the \",\"marks\":[],\"data\":{}},{\"nodeType\":\"hyperlink\",\"data\":{\"uri\":\"/articles/world-war-i/battle-of-caporetto\"},\"content\":[{\"nodeType\":\"text\",\"value\":\"Battle of Caporetto\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"text\",\"value\":\" (October 1917), German reinforcements helped Austria-Hungary win a decisive victory.\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"After Caporetto, Italy’s allies jumped in to offer increased assistance. British and French—and later, American—troops arrived in the region, and the Allies began to take back the Italian front.\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"heading-2\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"World War I at Sea\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"In the years before World War I, the superiority of Britain’s Royal Navy was unchallenged by any other nation’s fleet, but the Imperial German Navy had made substantial strides in closing the gap between the two naval powers. Germany’s strength on the high seas was also aided by its lethal fleet of U-boat submarines.\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"After the Battle of Dogger Bank in January 1915, in which the British mounted a surprise attack on German ships in the North Sea, the German navy chose not to confront Britain’s mighty Royal Navy in a major battle for more than a year, preferring to rest the bulk of its naval strategy on its U-boats.\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"The biggest naval engagement of World War I, the \",\"marks\":[],\"data\":{}},{\"nodeType\":\"hyperlink\",\"data\":{\"uri\":\"/articles/world-war-i/battle-of-jutland\"},\"content\":[{\"nodeType\":\"text\",\"value\":\"Battle of Jutland\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"text\",\"value\":\" (May 1916) left British naval superiority on the North Sea intact, and Germany would make no further attempts to break an Allied naval blockade for the remainder of the war.\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"heading-2\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"World War I Planes\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"World War I was the first major conflict to harness the power of planes. Though not as impactful as the British Royal Navy or Germany’s U-boats, the use of planes in World War I presaged their later, pivotal role in military conflicts around the globe.\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"At the dawn of World War I, aviation was a relatively new field; the \",\"marks\":[],\"data\":{}},{\"nodeType\":\"hyperlink\",\"data\":{\"uri\":\"/articles/inventions/wright-brothers\"},\"content\":[{\"nodeType\":\"text\",\"value\":\"Wright brothers\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"text\",\"value\":\" took their first sustained flight just eleven years before, in 1903. Aircraft were initially used primarily for reconnaissance missions. During the First Battle of the Marne, information passed from pilots allowed the Allies to exploit weak spots in the German lines, helping them to push Germany out of France.\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"The first machine guns were successfully mounted on planes in June of 1912 in the United States, but were imperfect; if timed incorrectly, a bullet could easily destroy the propeller of the plane it came from. The Morane-Saulnier L, a French plane, provided a solution: The propeller was armored with deflector wedges that prevented bullets from hitting it. The Morane-Saulnier Type L was used by the French, the British Royal Flying Corps (part of the Army), the British Royal Navy Air Service and the Imperial Russian Air Service. The British Bristol Type 22 was another popular model used for both reconnaissance work and as a fighter plane.\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"Dutch inventor Anthony Fokker improved upon the French deflector system in 1915. His “interrupter” synchronized the firing of the guns with the plane’s propeller to avoid collisions. Though his most popular plane during WWI was the single-seat Fokker Eindecker, Fokker created over 40 kinds of airplanes for the Germans.\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"The Allies debuted the Handley-Page HP O/400, the first two-engine bomber, in 1915. As aerial technology progressed, long-range heavy bombers like Germany’s Gotha G.V. (first introduced in 1917) were used to strike cities like London. Their speed and maneuverability proved to be far deadlier than Germany’s earlier Zeppelin raids.\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"By the war’s end, the Allies were producing five times more aircraft than the Germans. On April 1, 1918, the British created the Royal Air Force, or RAF, the first air force to be a separate military branch independent from the navy or army.\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"heading-2\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"Second Battle of the Marne\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"With Germany able to build up its strength on the Western Front after the armistice with Russia, Allied troops struggled to hold off another German offensive until promised reinforcements from the United States were able to arrive.\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"On July 15, 1918, German troops launched what would become the last German offensive of the war, attacking French forces (joined by 85,000 American troops as well as some of the British Expeditionary Force) in the \",\"marks\":[],\"data\":{}},{\"nodeType\":\"hyperlink\",\"data\":{\"uri\":\"/this-day-in-history/second-battle-of-the-marne-begins-with-final-german-offensive\"},\"content\":[{\"nodeType\":\"text\",\"value\":\"Second Battle of the Marne\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"text\",\"value\":\". The Allies successfully pushed back the German offensive and launched their own counteroffensive just three days later.\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"After suffering massive casualties, Germany was forced to call off a planned offensive further north, in the Flanders region stretching between France and Belgium, which was envisioned as Germany’s best hope of victory.\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"The Second Battle of the Marne turned the tide of war decisively towards the Allies, who were able to regain much of France and Belgium in the months that followed.\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"heading-2\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"The Harlem Hellfighters and Other All-Black Regiments\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"By the time World War I began, there were four all-Black regiments in the U.S. military: the 24th and 25th Infantry and the 9th and 10th Cavalry. All four regiments comprised of celebrated soldiers who fought in the \",\"marks\":[],\"data\":{}},{\"nodeType\":\"hyperlink\",\"data\":{\"uri\":\"/articles/early-20th-century-us/spanish-american-war\"},\"content\":[{\"nodeType\":\"text\",\"value\":\"Spanish-American War\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"text\",\"value\":\" and \",\"marks\":[],\"data\":{}},{\"nodeType\":\"hyperlink\",\"data\":{\"uri\":\"/articles/native-american-history/american-indian-wars\"},\"content\":[{\"nodeType\":\"text\",\"value\":\"American-Indian Wars\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"text\",\"value\":\", and served in the American territories. But they were not deployed for overseas combat in World War I.\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"embedded-entry-block\",\"data\":{\"target\":{\"sys\":{\"id\":\"5reAak4r2k87ImfhUuNwgr\",\"type\":\"Link\",\"linkType\":\"Entry\"}}},\"content\":[]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"Black Americans serving alongside white soldiers on the front lines in Europe was inconceivable to the U.S. military. Instead, the first African American troops sent overseas served in segregated labor battalions, restricted to menial roles in the Army and Navy—and shut out of the Marines, entirely. Their duties mostly included unloading ships, transporting materials from train depots, bases and ports, digging trenches, cooking and maintenance, removing barbed wire and inoperable equipment, and burying soldiers.\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"Facing criticism from the Black community and civil rights organizations for its quotas and treatment of African American soldiers in the war effort, the military formed two Black combat units in 1917, the \",\"marks\":[],\"data\":{}},{\"nodeType\":\"hyperlink\",\"data\":{\"uri\":\"https://unwritten-record.blogs.archives.gov/2017/02/13/a-brief-look-at-african-american-soldiers-in-the-great-war/\"},\"content\":[{\"nodeType\":\"text\",\"value\":\"92nd and 93rd Divisions\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"text\",\"value\":\". Trained separately and inadequately in the United States, the divisions fared differently in the war. The 92nd faced criticism for their performance in the Meuse-Argonne campaign in September 1918. The 93rd Division, however, had more success.\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"With dwindling armies, France asked America for reinforcements, and General \",\"marks\":[],\"data\":{}},{\"nodeType\":\"hyperlink\",\"data\":{\"uri\":\"/articles/world-war-i/john-j-pershing\"},\"content\":[{\"nodeType\":\"text\",\"value\":\"John Pershing\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"text\",\"value\":\", commander of the American Expeditionary Forces, sent regiments in the 93 Division to over, since France had experience fighting alongside Black soldiers from their Senegalese French Colonial army. The 93 Division’s 369 regiment, nicknamed the \",\"marks\":[],\"data\":{}},{\"nodeType\":\"hyperlink\",\"data\":{\"uri\":\"/articles/world-war-i/the-harlem-hellfighters-video\"},\"content\":[{\"nodeType\":\"text\",\"value\":\"Harlem Hellfighters\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"text\",\"value\":\", fought so gallantly, with a total of 191 days on the front lines, longer than any AEF regiment, that France awarded them the Croix de Guerre for their heroism. More than 350,000 African American soldiers would serve in World War I in various capacities.\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"heading-2\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"World War I Armistice\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"By the fall of 1918, the Central Powers were unraveling on all fronts.\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"Despite the Turkish victory at Gallipoli, later defeats by invading forces and an Arab revolt that destroyed the Ottoman economy and devastated its land, the Turks signed a treaty with the Allies in late October 1918.\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"Austria-Hungary, dissolving from within due to growing nationalist movements among its diverse population, reached an armistice on November 4. Facing dwindling resources on the battlefield, discontent on the home front and the surrender of its allies, Germany was finally forced to seek an \",\"marks\":[],\"data\":{}},{\"nodeType\":\"hyperlink\",\"data\":{\"uri\":\"/this-day-in-history/november-11/world-war-i-ends\"},\"content\":[{\"nodeType\":\"text\",\"value\":\"armistice\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"text\",\"value\":\" on November 11, 1918, ending World War I.\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"heading-2\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"Treaty of Versailles\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"At the \",\"marks\":[],\"data\":{}},{\"nodeType\":\"hyperlink\",\"data\":{\"uri\":\"/this-day-in-history/post-world-war-i-peace-conference-begins-in-paris\"},\"content\":[{\"nodeType\":\"text\",\"value\":\"Paris Peace Conference\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"text\",\"value\":\" in 1919, Allied leaders stated their desire to build a postwar world that would safeguard itself against future conflicts of such a devastating scale.\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"Some hopeful participants had even begun calling World War I “the War to End All Wars.” But the \",\"marks\":[],\"data\":{}},{\"nodeType\":\"hyperlink\",\"data\":{\"uri\":\"/articles/world-war-i/treaty-of-versailles\"},\"content\":[{\"nodeType\":\"text\",\"value\":\"Treaty of Versailles\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"text\",\"value\":\", signed on June 28, 1919, would not achieve that lofty goal.\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"Saddled with war guilt, heavy reparations and denied entrance into the \",\"marks\":[],\"data\":{}},{\"nodeType\":\"hyperlink\",\"data\":{\"uri\":\"/articles/league-of-nations\"},\"content\":[{\"nodeType\":\"text\",\"value\":\"League of Nations\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"text\",\"value\":\", Germany felt tricked into signing the treaty, having believed any peace would be a “peace without victory,” as put forward by President Wilson in his famous \",\"marks\":[],\"data\":{}},{\"nodeType\":\"hyperlink\",\"data\":{\"uri\":\"/this-day-in-history/wilson-delivers-fourteen-points-speech\"},\"content\":[{\"nodeType\":\"text\",\"value\":\"Fourteen Points\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"text\",\"value\":\" speech of January 1918.\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"As the years passed, hatred of the Versailles treaty and its authors settled into a smoldering resentment in Germany that would, two decades later, be counted among the causes of \",\"marks\":[],\"data\":{}},{\"nodeType\":\"hyperlink\",\"data\":{\"uri\":\"/articles/world-war-ii/world-war-ii-history\"},\"content\":[{\"nodeType\":\"text\",\"value\":\"World War II\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"text\",\"value\":\".\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"heading-2\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"World War I Casualties\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"World War I took the lives of \",\"marks\":[],\"data\":{}},{\"nodeType\":\"hyperlink\",\"data\":{\"uri\":\"/articles/how-many-people-died-in-world-war-i\"},\"content\":[{\"nodeType\":\"text\",\"value\":\"more than 9 million\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"text\",\"value\":\" soldiers; 21 million more were wounded. Civilian casualties numbered close to 10 million. The two nations most affected were Germany and France, each of which sent some 80 percent of their male populations between the ages of 15 and 49 into battle.\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"The political disruption surrounding World War I also contributed to the fall of four venerable imperial dynasties: Germany, Austria-Hungary, Russia and Turkey.\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"heading-2\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"Legacy of World War I\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"The World War I period brought about massive social upheaval, as millions of women entered the workforce to replace men who went to war and those who never came back. The first global war also helped spread one of the world’s deadliest global pandemics, the \",\"marks\":[],\"data\":{}},{\"nodeType\":\"hyperlink\",\"data\":{\"uri\":\"/articles/how-many-people-died-in-world-war-i/1918-flu-pandemic\"},\"content\":[{\"nodeType\":\"text\",\"value\":\"Spanish flu\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"text\",\"value\":\" epidemic of 1918, which killed an estimated 20 to 50 million people.\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"embedded-entry-block\",\"data\":{\"target\":{\"sys\":{\"id\":\"3bMZal9qXrDtdEoFJLHmrh\",\"type\":\"Link\",\"linkType\":\"Entry\"}}},\"content\":[]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"World War I has also been referred to as “the first modern war.” Many of the \",\"marks\":[],\"data\":{}},{\"nodeType\":\"hyperlink\",\"data\":{\"uri\":\"/articles/world-war-i-inventions-pilates-drones-kleenex\"},\"content\":[{\"nodeType\":\"text\",\"value\":\"technologies\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"text\",\"value\":\" now associated with military conflict—machine guns, \",\"marks\":[],\"data\":{}},{\"nodeType\":\"hyperlink\",\"data\":{\"uri\":\"/this-day-in-history/tanks-introduced-into-warfare-at-the-somme\"},\"content\":[{\"nodeType\":\"text\",\"value\":\"tanks\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"text\",\"value\":\", aerial combat and radio communications—were introduced on a massive scale during World War I.\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"The severe effects that \",\"marks\":[],\"data\":{}},{\"nodeType\":\"hyperlink\",\"data\":{\"uri\":\"/this-day-in-history/germans-introduce-poison-gas\"},\"content\":[{\"nodeType\":\"text\",\"value\":\"chemical weapons\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"text\",\"value\":\" such as mustard gas and phosgene had on soldiers and civilians during World War I galvanized public and military attitudes against their continued use. The \",\"marks\":[],\"data\":{}},{\"nodeType\":\"hyperlink\",\"data\":{\"uri\":\"/articles/geneva-convention\"},\"content\":[{\"nodeType\":\"text\",\"value\":\"Geneva Convention\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"text\",\"value\":\" agreements, signed in 1925, restricted the use of chemical and biological agents in warfare and remain in effect today.\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"heading-2\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"Photo Galleries\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"embedded-entry-block\",\"data\":{\"target\":{\"sys\":{\"id\":\"7btl9u9lHLxkGTegY8GGmv\",\"type\":\"Link\",\"linkType\":\"Entry\"}}},\"content\":[]},{\"nodeType\":\"embedded-entry-block\",\"data\":{\"target\":{\"sys\":{\"id\":\"2pTtxUUWTaaSVVYiug8Tzn\",\"type\":\"Link\",\"linkType\":\"Entry\"}}},\"content\":[]},{\"nodeType\":\"embedded-entry-block\",\"data\":{\"target\":{\"sys\":{\"id\":\"5BUsyNLmoR69Gec6Fvlotr\",\"type\":\"Link\",\"linkType\":\"Entry\"}}},\"content\":[]},{\"nodeType\":\"embedded-entry-block\",\"data\":{\"target\":{\"sys\":{\"id\":\"7oyBjKNNCdp536C1tkZyba\",\"type\":\"Link\",\"linkType\":\"Entry\"}}},\"content\":[]},{\"nodeType\":\"embedded-entry-block\",\"data\":{\"target\":{\"sys\":{\"id\":\"7ts1SgPwLBYMCRwImpHyjy\",\"type\":\"Link\",\"linkType\":\"Entry\"}}},\"content\":[]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"\",\"marks\":[],\"data\":{}}]}],\"title\":\"$L93\"}]]}]\n"])</script><script>self.__next_f.push([1,"87:[\"$\",\"div\",null,{\"className\":\"i94vss1 i94vss4 g1fwxfnf g1fwxflx g1fwxfzo g1fwxfii g1fwxfdo\",\"data-name\":\"section\",\"data-sentry-element\":\"Component\",\"data-sentry-component\":\"Box\",\"data-sentry-source-file\":\"box.tsx\",\"children\":[\"$undefined\",[\"$\",\"div\",null,{\"className\":\"g1fwxf4 g1fwxf7 g1fwxfy g1fwxfy8\",\"data-sentry-element\":\"Component\",\"data-sentry-component\":\"Box\",\"data-sentry-source-file\":\"box.tsx\",\"children\":[\"$undefined\",[\"$\",\"div\",null,{\"className\":\"g1fwxflu g1fwxfm9 g1fwxfn0\",\"data-sentry-element\":\"Component\",\"data-sentry-source-file\":\"box.tsx\",\"children\":[\"$\",\"div\",null,{\"children\":[\"$\",\"div\",null,{\"className\":\"g1fwxflu g1fwxfm9 g1fwxfn0 g1fwxfzu\",\"data-sentry-element\":\"Component\",\"data-sentry-component\":\"Box\",\"data-sentry-source-file\":\"box.tsx\",\"children\":[[\"$\",\"p\",\"p-0\",{\"children\":\"World War I, also known as the Great War, started in 1914 after the assassination of Archduke Franz Ferdinand of Austria. His murder escalated into a war across Europe that lasted until 1918. During the four-year conflict, Germany, Austria-Hungary, Bulgaria and the Ottoman Empire (the Central Powers) fought against Great Britain, France, Russia, Italy, Romania, Canada, Japan and the United States (the Allied Powers). Thanks to new military technologies and the horrors of trench warfare, World War I saw unprecedented levels of carnage and destruction. By the time the war was over and the Allied Powers had won, more than 16 million people—soldiers and civilians alike—were dead.\"}]]}],\"className\":\"_42elsx1 g1fwxfzw\",\"data-sentry-element\":\"Component\",\"data-sentry-source-file\":\"box.tsx\",\"data-sentry-component\":\"Box\",\"ref\":null}],\"data-sentry-component\":\"Box\"}]]}]]}]\n"])</script><script>self.__next_f.push([1,"88:[[\"$\",\"div\",\"main-content-0\",{\"className\":\"i94vss1 i94vss4 g1fwxfnf g1fwxflx g1fwxfzo g1fwxfii\",\"data-name\":\"section\",\"data-sentry-element\":\"Component\",\"data-sentry-component\":\"Box\",\"data-sentry-source-file\":\"box.tsx\",\"children\":[\"$undefined\",[[\"$\",\"div\",null,{\"className\":\"g1fwxf4 g1fwxf7 g1fwxfy g1fwxfy8 g1fwxflu g1fwxfm9 g1fwxfn0\",\"data-contentful-field-id\":\"content\",\"data-contentful-entry-id\":\"4dn1XEkmYZYFLe5gMwbzPO\",\"id\":\"main-content-0\",\"data-sentry-element\":\"Component\",\"data-sentry-source-file\":\"box.tsx\",\"data-sentry-component\":\"Box\",\"children\":[\"$undefined\",[[\"$\",\"h2\",\"0\",{\"className\":\"_15il2ffd _15il2ffa a0xfey1 g1fwxfbr g1fwxfc1 _15il2ffl g1fwxfvr _15il2ffj\",\"id\":\"The-Assassination-of-Archduke-Franz-Ferdinand\",\"children\":[\"The Assassination of Archduke Franz Ferdinand\"],\"data-sentry-element\":\"H\",\"data-sentry-component\":\"H2\",\"data-sentry-source-file\":\"heading.tsx\"}],[\"$\",\"div\",\"1\",{\"className\":\"_42elsx1 o2jrjz3 g1fwxfzs g1fwxfzw\",\"data-sentry-element\":\"Component\",\"data-sentry-source-file\":\"box.tsx\",\"children\":[\"$\",\"p\",null,{\"children\":[\"Tensions had been brewing throughout Europe—especially in the troubled Balkan region of southeast Europe—for years before World War I actually broke out.\"]}],\"data-sentry-component\":\"Box\"}],[\"$\",\"div\",\"2\",{\"className\":\"_42elsx1 o2jrjz3 g1fwxfzs g1fwxfzw\",\"data-sentry-element\":\"Component\",\"data-sentry-source-file\":\"box.tsx\",\"children\":[\"$\",\"p\",null,{\"children\":[\"A number of alliances involving European powers, the \",[\"$\",\"$L40\",\"1\",{\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":[\"Ottoman Empire\"],\"data-sentry-element\":\"NextLink\",\"data-sentry-component\":\"Link\",\"data-sentry-source-file\":\"link.tsx\",\"href\":\"/articles/ottoman-empire\",\"className\":\"mpgbmc0 _1jnz0oc1y g1fwxfm3 mpgbmc2 g1fwxflr\",\"prefetch\":false}],\", Russia and other parties had existed for years, but political instability in the \",[\"$\",\"$L40\",\"3\",{\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":[\"Balkans\"],\"data-sentry-element\":\"NextLink\",\"data-sentry-component\":\"Link\",\"data-sentry-source-file\":\"link.tsx\",\"href\":\"/this-day-in-history/the-first-balkan-war-ends\",\"className\":\"mpgbmc0 _1jnz0oc1y g1fwxfm3 mpgbmc2 g1fwxflr\",\"prefetch\":false}],\" (particularly Bosnia, Serbia and Herzegovina) threatened to destroy these agreements.\"]}],\"data-sentry-component\":\"Box\"}],[\"$\",\"div\",\"3\",{\"className\":\"_42elsx1 o2jrjz3 g1fwxfzs g1fwxfzw\",\"data-sentry-element\":\"Component\",\"data-sentry-source-file\":\"box.tsx\",\"children\":[\"$\",\"p\",null,{\"children\":[\"The spark that ignited World War I was struck in Sarajevo, Bosnia, where \",[\"$\",\"$L40\",\"1\",{\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":[\"Archduke Franz Ferdinand\"],\"data-sentry-element\":\"NextLink\",\"data-sentry-component\":\"Link\",\"data-sentry-source-file\":\"link.tsx\",\"href\":\"/this-day-in-history/archduke-franz-ferdinand-assassinated\",\"className\":\"mpgbmc0 _1jnz0oc1y g1fwxfm3 mpgbmc2 g1fwxflr\",\"prefetch\":false}],\"—heir to the Austro-Hungarian Empire—was shot to death along with his wife, Sophie, by the Serbian nationalist Gavrilo Princip on June 28, 1914. Princip and other nationalists were struggling to end Austro-Hungarian rule over Bosnia and Herzegovina.\"]}],\"data-sentry-component\":\"Box\"}],[\"$\",\"div\",\"4\",{\"className\":\"_42elsx1 o2jrjz3 g1fwxfzs g1fwxfzw\",\"data-sentry-element\":\"Component\",\"data-sentry-source-file\":\"box.tsx\",\"children\":[\"$\",\"p\",null,{\"children\":[\"The assassination of Franz Ferdinand set off a rapidly escalating chain of events: \",[\"$\",\"$L40\",\"1\",{\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":[\"Austria-Hungary\"],\"data-sentry-element\":\"NextLink\",\"data-sentry-component\":\"Link\",\"data-sentry-source-file\":\"link.tsx\",\"href\":\"/this-day-in-history/austria-hungary-declares-war-on-serbia\",\"className\":\"mpgbmc0 _1jnz0oc1y g1fwxfm3 mpgbmc2 g1fwxflr\",\"prefetch\":false}],\", like many countries around the world, blamed the Serbian government for the attack and hoped to use the incident as justification for settling the question of Serbian nationalism once and for all.\"]}],\"data-sentry-component\":\"Box\"}]]]}],\"$L94\"]]}],\"$L95\",\"$L96\",\"$L97\",\"$L98\",\"$L99\",\"$L9a\",\"$L9b\",\"$L9c\",\"$L9d\",\"$L9e\",\"$L9f\",\"$La0\",\"$La1\",\"$La2\",\"$La3\",\"$La4\",\"$La5\",\"$La6\",\"$La7\",\"$La8\"]\n"])</script><script>self.__next_f.push([1,"89:null\n"])</script><script>self.__next_f.push([1,"8a:[\"$\",\"div\",null,{\"className\":\"g1fwxfyf x4or4w6 i94vss3 i94vss5 g1fwxfzq g1fwxf4f g1fwxf6o\",\"data-name\":\"full bleed section\",\"data-sentry-element\":\"Component\",\"data-sentry-component\":\"Box\",\"data-sentry-source-file\":\"box.tsx\",\"children\":[\"$\",\"div\",null,{\"className\":\"i94vss1 i94vss4 g1fwxfnf g1fwxflx g1fwxfzo g1fwxfil\",\"data-name\":\"section\",\"data-section-name\":\"content list\",\"data-sentry-element\":\"Component\",\"data-sentry-component\":\"Box\",\"data-sentry-source-file\":\"box.tsx\",\"children\":[\"$undefined\",[[\"$\",\"div\",null,{\"className\":\"g1fwxf9 g1fwxfz g1fwxflu g1fwxflz g1fwxfju g1fwxfil g1fwxfzn g1fwxfvw\",\"data-sentry-element\":\"Component\",\"data-sentry-source-file\":\"box.tsx\",\"data-sentry-component\":\"Box\",\"children\":[\"$undefined\",[\"$\",\"div\",null,{\"className\":\"g1fwxfl0\",\"data-sentry-element\":\"Component\",\"data-sentry-source-file\":\"box.tsx\",\"data-sentry-component\":\"Box\",\"children\":[\"$\",\"h2\",null,{\"children\":\"Related\",\"className\":\"_42elsx8 _1y6xuyv0 _1y6xuyv2\",\"data-sentry-element\":\"Component\",\"data-sentry-source-file\":\"box.tsx\",\"data-sentry-component\":\"Box\",\"ref\":null}]}]]}],[\"$\",\"div\",null,{\"className\":\"g1fwxfzn g1fwxflx g1fwxfw2\",\"data-sentry-element\":\"Component\",\"data-sentry-source-file\":\"box.tsx\",\"data-sentry-component\":\"Box\",\"children\":[\"$undefined\",[\"$\",\"div\",null,{\"className\":\"_1p47p4a0 g1fwxfy3\",\"data-sentry-element\":\"Component\",\"data-sentry-source-file\":\"box.tsx\",\"children\":[[\"$\",\"$L40\",\"/topics/world-war-i/videos\",{\"children\":[\"$\",\"div\",null,{\"className\":\"g1fwxflu g1fwxfm9 g1fwxfmx g1fwxfil g1fwxfl0\",\"data-sentry-element\":\"Comp