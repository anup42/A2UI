				50vw" srcSet="https://res.cloudinary.com/aenetworks/image/upload/c_fill,w_384,h_244,g_auto/dpr_auto/f_auto/q_auto:eco/v1/war-dogs?_a=BAVAZGID0 384w, https://res.cloudinary.com/aenetworks/image/upload/c_fill,w_640,h_407,g_auto/dpr_auto/f_auto/q_auto:eco/v1/war-dogs?_a=BAVAZGID0 640w, https://res.cloudinary.com/aenetworks/image/upload/c_fill,w_750,h_477,g_auto/dpr_auto/f_auto/q_auto:eco/v1/war-dogs?_a=BAVAZGID0 750w, https://res.cloudinary.com/aenetworks/image/upload/c_fill,w_828,h_526,g_auto/dpr_auto/f_auto/q_auto:eco/v1/war-dogs?_a=BAVAZGID0 828w, https://res.cloudinary.com/aenetworks/image/upload/c_fill,w_1080,h_687,g_auto/dpr_auto/f_auto/q_auto:eco/v1/war-dogs?_a=BAVAZGID0 1080w, https://res.cloudinary.com/aenetworks/image/upload/c_fill,w_1200,h_763,g_auto/dpr_auto/f_auto/q_auto:eco/v1/war-dogs?_a=BAVAZGID0 1200w, https://res.cloudinary.com/aenetworks/image/upload/c_fill,w_1920,h_1221,g_auto/dpr_auto/f_auto/q_auto:eco/v1/war-dogs?_a=BAVAZGID0 1920w, https://res.cloudinary.com/aenetworks/image/upload/c_fill,w_2048,h_1303,g_auto/dpr_auto/f_auto/q_auto:eco/v1/war-dogs?_a=BAVAZGID0 2048w, https://res.cloudinary.com/aenetworks/image/upload/c_fill,w_3840,h_2443,g_auto/dpr_auto/f_auto/q_auto:eco/v1/war-dogs?_a=BAVAZGID0 3840w" src="https://res.cloudinary.com/aenetworks/image/upload/c_fill,w_3840,h_2443,g_auto/dpr_auto/f_auto/q_auto:eco/v1/war-dogs?_a=BAVAZGID0"/></div><div class="_1qtr0uz2" data-sentry-element="Component" data-sentry-source-file="box.tsx" data-sentry-component="Box"><div class="_153e98si _153e98sc" data-sentry-component="MaxLines" data-sentry-source-file="max-lines.tsx"><div class="_42elsxd g1fwxfzw" data-sentry-element="Component" data-sentry-component="Box" data-sentry-source-file="box.tsx"><p>The term &#x27;war dog&#x27; is an official one and it wasn’t until World War II that the United States began using dogs officially. Before then, they were considered &#x27;mascots.&#x27;</p></div></div><span class="_198y7iph _198y7ipb _198y7ip4 _1qtr0uz3 g1fwxfil g1fwxfju g1fwxfzy" data-sentry-element="Component" data-sentry-source-file="box.tsx" data-sentry-component="Box">Hulton Archive/Getty Images</span></div></div><div class="_1qtr0uz0 g1fwxf7o" data-previous-card="false" data-sentry-element="Component" data-sentry-component="Box" data-sentry-source-file="box.tsx"><div class="_1qtr0uz1"><div class="_1qtr0uz4" data-active="false"></div><img alt="" dpr="auto" data-sentry-element="DefaultCldImage" data-sentry-component="CldImage" data-sentry-source-file="cld-image.tsx" loading="lazy" width="550" height="350" decoding="async" data-nimg="1" class="" style="color:transparent" sizes="(max-width: 834px) 100vw,
				(max-width: 1280px) 75vw,
