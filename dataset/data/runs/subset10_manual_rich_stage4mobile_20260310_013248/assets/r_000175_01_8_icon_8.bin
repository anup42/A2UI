			function adjustConsentModalElements(sdkBannerElement) {
				sdkBannerElement.style.setProperty('bottom', '0px', 'important');
			}

			function adjustConsentModalPosition() {
				setTimeout(() => {
					var sdkBannerElement = document.getElementById('onetrust-banner-sdk');
					if (sdkBannerElement) {
						adjustConsentModalElements(sdkBannerElement);
					} else {
						// Set up a MutationObserver to watch for its addition to the DOM.
						var observer = new MutationObserver(function (mutationsList, observer) {
							sdkBannerElement = document.getElementById('onetrust-banner-sdk');
							if (sdkBannerElement) {
