    <div class="c-block c-block--light c-block--pull-up1">
        <div class="l-container">

            <div class="c-block__content">

                <div class="c-showcase c-showcase--spotlight">

                    <div class="c-showcase__content">
                        <h2 class="c-showcase__title">In the spotlight</h2>

                        <div class="c-testimonial c-testimonial--quote">

                            <blockquote class="c-testimonial__content">

                                <p>@SessionizeCom is the GOAT 🐐

We use it at @WeAreDevs and it's an absolute delight working with it - for speakers and organizers ❤️ </p>

                            </blockquote>

                            <footer class="c-testimonial__footer">

                                <img src="https://pbs.twimg.com/profile_images/1693878258859700224/q45cX5zU_normal.jpg" alt="" class="c-testimonial__avatar">

                                <p class="c-testimonial__author">
                                    Marc Backes

                                    <span class="c-testimonial__meta"><a href="https://twitter.com/themarcba/status/1644295136505999366" target="_blank">@themarcba</a></span>

                                </p>
                            </footer>

                        </div>

                    </div>

                    <div class="c-showcase__aside">
                        <figure class="c-showcase__illustration">
