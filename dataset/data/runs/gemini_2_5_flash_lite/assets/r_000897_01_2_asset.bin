16px] md:mb-[40px] lg:mb-[56px]"><h2 class="font-bold text-neutral-900 text-xl md:text-2xl lg:text-5xl mb-[4px] md:mb-2 lg:mb-[12px]">Do you own a repair shop?</h2><p class="font-normal text-base md:text-l lg:text-xl text-neutral-800">Discover how Steer &amp; AutoOps help auto shops book more appointments, connect with customers, and deliver exceptional service.</p></div><div class="grid grid-cols-1 md:grid-cols-2 gap-[24px] lg:gap-[32px] xl:gap-[56px]"><div class="p-[16px] md:p-[24px] lg:p-[40px] bg-white rounded-[24px] flex flex-col"><div class="relative mb-4 h-[24px] w-[83.57px] md:h-[32px] md:w-[111.4px] lg:h-[40px] lg:w-[139.3px]"><img alt="Steer Logo" loading="lazy" decoding="async" data-nimg="fill" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" sizes="100vw" srcSet="/_next/image?url=%2FSteerLogo.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2FSteerLogo.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2FSteerLogo.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2FSteerLogo.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2FSteerLogo.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2FSteerLogo.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2FSteerLogo.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2FSteerLogo.png&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=%2FSteerLogo.png&amp;w=3840&amp;q=75"/></div><h3 class="font-bold md:text-2xl lg:text-4xl mb-[4px] text-neutral-900">Best-in-Class Marketing and Communications Platform</h3><p class="font-bold md:text-lg lg:text-2xl bg-grey-gradient mb-[4px] md:mb-[16px]"></p><p class="font-normal md:text-base lg:text-lg text-gray-600 lg:min-h-[48px]">Get more customers. Keep them coming back. All with one powerful CRM.</p><a class="font-semibold text-lg text-center w-full bg-primary-blue text-white px-6 py-[12px] rounded-[8px] hover:bg-blue-700 transition my-[16px] md:my-[24px]" href="https://steercrm.com">Get Started</a><div><h4 class="font-semibold text-lg text-neutra