.2023 14.202C12.8128 15.5915 10.9654 16.3568 9.00033 16.3568C7.03525 16.3568 5.18783 15.5915 3.79831 14.202C2.40879 12.8125 1.64355 10.9651 1.64355 8.99999C1.64355 7.03492 2.40879 5.18749 3.79831 3.79797C5.18783 2.40845 7.03525 1.64322 9.00033 1.64322C10.9654 1.64322 12.8128 2.40845 14.2023 3.79797C15.5919 5.18749 16.3571 7.03492 16.3571 8.99999C16.3571 10.9651 15.5919 12.8125 14.2023 14.202Z\",\"fill\":\"white\"}],[\"$\",\"path\",null,{\"d\":\"$1f\",\"fill\":\"white\"}]]}]}]}]}],[\"$\",\"div\",null,{\"className\":\"relative flex justify-center\",\"children\":[\"$\",\"picture\",null,{\"className\":\"pointer-events-none\",\"children\":[[\"$\",\"source\",null,{\"height\":458,\"width\":1435,\"srcSet\":\"/HeroImage/Desktop.png\",\"media\":\"(min-width: 1500px)\"}],[\"$\",\"source\",null,{\"height\":408,\"width\":1152.5,\"srcSet\":\"/HeroImage/DesktopSm.png\",\"media\":\"(min-width: 1200px)\"}],[\"$\",\"source\",null,{\"height\":491,\"width\":966,\"srcSet\":\"/HeroImage/Tablet2x.png\",\"media\":\"(min-width: 1024px)\"}],[\"$\",\"source\",null,{\"height\":374,\"width\":736,\"srcSet\":\"/HeroImage/Tablet.png\",\"media\":\"(min-width: 768px)\"}],[\"$\",\"img\",null,{\"height\":268,\"width\":328,\"src\":\"/HeroImage/Phone2x.png\",\"alt\":\"Hero background\"}]]}]}]]}]}],[\"$\",\"$L20\",null,{\"title\":\"Schedule with these auto shops nearby in New York\",\"shopsData\":[{\"mechanicAdvisorID\":591253,\"name\":\"Pica's Automotive Service Inc\",\"address\":\"90 State Highway 139\",\"address2\":\"\",\"city\":\"Jersey City\",\"state\":\"NJ\",\"zip\":\"07306  \",\"phone1\":\"(201) 798-5566\",\"webAddress\":\"https://www.picasauto.com/\",\"isPremium\":true,\"description\":\"Honesty and Affordability are what  Pica's Automotive is based on for the last 24 years. Our AAA shop may look small, but it's not. Its 3000 square feet inside allows for every type of auto repair needed: foreign and domestic, which includes, but not limited to, oil changes, brakes, shocks, exhaust, check engine lights to name a few; steering, suspension, and alignments are our specialty. \\r\\nHere at Pica's Automotive we fix car's that the other shops can't fix. We actually do a lot of repairs for the local shops in the area. \\r\\n We also maintain your vehicles, keep records on every repair, and offer a 1 year warranty on all new parts. Once you are our customer, our goal is to take care of you and keep you happy. \\r\\nPica's Automotive is not a corporate store where you are just a number. We are a small independent shop who appreciates your business.\\r\\nSo whether you have a small or large problem, we are the #1 stop shop you need to be.\\r\\n\",\"couponsAmount\":1,\"nameEncode\":\"picas-automotive-service-inc\",\"radiusMiles\":null,\"countReviews\":2,\"averageRating\":5,\"couponDescription\":\"$$10 Off Any Repair Over $100 - MechanicAdvisor.com Special - print and Present Before Service - Limit One Per Customer\",\"logoName\":\"591253_635820588386726998_5291.jpg\",\"seoCustomServiceText\":null,\"seoCustomVehicleText\":null,\"seoCustomServiceVehicleText\":null,\"hasSEOCustom\":false,\"searchText\":null,\"showFirstCoupon\":false,\"sortBy\":0,\"locationId\":31300,\"recentReview\":\"I BROUGHT MY TRUCK TO PICAS AUTOMOTIVE IT WAS A PLEASURE DEALING DIRECTLEY WITH THE OWNER.HE SHOWED ME WHAT THE PROBLEM WAS AND FIXED IT IMMEDIATELY WHEN I TOLD HIM I NEEDED IT FOR WORK.I ASKED HIM TO CHECK MY BRAKES TO SEE IF THEY NEEDED TO BE REPACED HE TOLD ME I STILL HAD 40% LEFT ON THEM I WAS SURPRISED BECAUSE FIRESTONE TOLD ME THEY NEEDED TO BE REPLACED, THATS THE DIFFERANCE BETWEEN A CORPORATE SHOP AND A PRIVATELY OWNED SHOP.THIS IS WHAT THEY CALL OLD SCHOOL IM GLAD THERE IS STILL AN AUTO SHOP LIKE PICAS.  I WILL DEFINANTLY BE GOING TO PICAS IN THE FUTURE FOR ALL MY MECHANICAL PROBLEMS... THANKS AGAIN PICAS!!!!\",\"autoOpsApiKey\":null,\"mechanicLocation\":{\"lat\":40.7367406,\"lon\":-74.058092},\"cityLocation\":{\"lat\":40.7281575,\"lon\":-74.0776417},\"servicesIds\":[],\"vehicleIds\":[],\"searchTerms\":null,\"mechanicTypes\":[],\"nearLocationIds\":[],\"showBookApointment\":true,\"isEnabledListingStatistic\":true,\"hourlyLabourRate\":null,\"daysData\":null,\"mechanicCertificates\":null},{\"mechanicAdvisorID\":656073,\"name\":\"God First Auto Services\",\"address\":\"835 Communipaw Avenue\",\"address2\":\"\",\"city\":\"Jersey City\",\"state\":\"NJ\",\"zip\":\"07304\",\"phone1\":\"(201) 938-2886\",\"webAddress\":\"https://www.godfirstautoservices.com/\",\"isPremium\":true,\"description\":\"\",\"couponsAmount\":0,\"nameEncode\":\"god-first-auto-services\",\"radiusMiles\":null,\"countReviews\":0,\"averageRating\":null,\"couponDescription\":null,\"logoName\":\"656073_637890014933528826_74295.jpg\",\"seoCustomServiceText\":null,\"seoCustomVehicleText\":null,\"seoCustomServiceVehicleText\":null,\"hasSEOCustom\":false,\"searchText\":null,\"showFirstCoupon\":false,\"sortBy\":0,\"locationId\":31300,\"recentReview\":null,\"autoOpsApiKey\":\"cd6fa16bb6a24d1f9b981ef4ac86337d\",\"mechanicLocation\":{\"lat\":40.7212249,\"lon\":-74.082914},\"cityLocation\":{\"lat\":40.7281575,\"lon\":-74.0776417},\"servicesIds\":[],\"vehicleIds\":[],\"searchTerms\":null,\"mechanicTypes\":[],\"nearLocationIds\":[],\"showBookApointment\":false,\"isEnabledListingStatistic\":true,\"hourlyLabourRate\":null,\"daysData\":null,\"mechanicCertificates\":null},{\"mechanicAdvisorID\":580864,\"name\":\"Key Auto Center\",\"address\":\"240 Green St\",\"address2\":\"\",\"city\":\"Brooklyn\",\"state\":\"NY\",\"zip\":\"11222\",\"phone1\":\"(718) 389-6009\",\"webAddress\":\"http://www.autorepairbrooklyn.com/\",\"isPremium\":true,\"description\":\"\",\"couponsAmount\":1,\"nameEncode\":\"key-auto-center\",\"radiusMiles\":null,\"countReviews\":2,\"averageRating\":5,\"couponDescription\":\"5% off Service with MechanicAdvisor.com Coupon - PRINT\",\"logoName\":\"580864_635412044508892986.jpg\",\"seoCustomServiceText\":null,\"seoCustomVehicleText\":null,\"seoCustomServiceVehicleText\":null,\"hasSEOCustom\":false,\"searchText\":null,\"showFirstCoupon\":false,\"sortBy\":0,\"locationId\":33487,\"recentReview\":\"Had a timing chain tensioner issue, it was a big job and knew this was the place to go. Honest about how complicated things can get and with their cost, they did a excellent job. Extremely happy with their service over the years from simple oil changes to most complicated of jobs. These are the guys to go to, no question about it.\",\"autoOpsApiKey\":null,\"mechanicLocation\":{\"lat\":40.7339757,\"lon\":-73.9513019},\"cityLocation\":{\"lat\":40.6528762,\"lon\":-73.959494},\"servicesIds\":[],\"vehicleIds\":[],\"searchTerms\":null,\"mechanicTypes\":[],\"nearLocationIds\":[],\"showBookApointment\":true,\"isEnabledListingStatistic\":true,\"hourlyLabourRate\":null,\"daysData\":null,\"mechanicCertificates\":null},{\"mechanicAdvisorID\":568170,\"name\":\"Bay Diagnostic\",\"address\":\"1717 Gravesend Neck Road\",\"address2\":\"\",\"city\":\"Brooklyn\",\"state\":\"NY\",\"zip\":\"11229  \",\"phone1\":\"(718) 615-0705\",\"webAddress\":\"https://www.baydiagnostic.com\",\"isPremium\":true,\"description\":\"Bay Diagnostic has been here in Brooklyn,N.Y. serving All for 35 YEARS\\r\\n  A 3 YEAR 36,000 MILE Warranty is available. \\r\\n\\r\\n 24 hour key drop-off available to all.\\r\\n\\r\\n  Visit our website  www.baydiagnostic.com  see what we are all about.\\r\\n    See what people are saying about us see our 5 star reviews on GOOGLE\",\"couponsAmount\":0,\"nameEncode\":\"bay-diagnostic\",\"radiusMiles\":null,\"countReviews\":2,\"averageRating\":5,\"couponDescription\":null,\"logoName\":\"568170_637303414948892834_83292.jpg\",\"seoCustomServiceText\":null,\"seoCustomVehicleText\":null,\"seoCustomServiceVehicleText\":null,\"hasSEOCustom\":false,\"searchText\":null,\"showFirstCoupon\":false,\"sortBy\":0,\"locationId\":33487,\"recentReview\":\"Great customer service! I strongly recommend this shop, because they are willing to go extra mile to address your issues..... So far fantastic experience.\\r\\n\\r\\nThanks,\\r\\nEdgar\\r\\nBrooklyn, NY\",\"autoOpsApiKey\":\"a9712eeea75247d9b29a45fe7119d118\",\"mechanicLocation\":{\"lat\":40.5957095,\"lon\":-73.9532975},\"cityLocation\":{\"lat\":40.6528762,\"lon\":-73.959494},\"servicesIds\":[],\"vehicleIds\":[],\"searchTerms\":null,\"mechanicTypes\":[],\"nearLocationIds\":[],\"showBookApointment\":true,\"isEnabledListingStatistic\":true,\"hourlyLabourRate\":null,\"daysData\":null,\"mechanicCertificates\":null},{\"mechanicAdvisorID\":201541,\"name\":\"MINHS Auto Care Center\",\"address\":\"578 3rd Avenue\",\"address2\":\"\",\"city\":\"Brooklyn\",\"state\":\"NY\",\"zip\":\"11215  \",\"phone1\":\"(718) 832-3096\",\"webAddress\":\"https://www.minhsautocare.com/\",\"isPremium\":true,\"description\":\"\",\"couponsAmount\":0,\"nameEncode\":\"minhs-auto-care-center\",\"radiusMiles\":null,\"countReviews\":1,\"averageRating\":5,\"couponDescription\":null,\"logoName\":null,\"seoCustomServiceText\":null,\"seoCustomVehicleText\":null,\"seoCustomServiceVehicleText\":null,\"hasSEOCustom\":false,\"searchText\":null,\"showFirstCoupon\":false,\"sortBy\":0,\"locationId\":33487,\"recentReview\":\"I've only been here once to get some work done on my BMW 335. They are very knowledgeable when it comes to repairs on BMW's. I am a handy guy myself and they provided information and some assistance for repairs I can do myself so that I can save money. Highly recommended!\",\"autoOpsApiKey\":null,\"mechanicLocation\":{\"lat\":40.6676837,\"lon\":-73.9944822},\"cityLocation\":{\"lat\":40.6528762,\"lon\":-73.959494},\"servicesIds\":[],\"vehicleIds\":[],\"searchTerms\":null,\"mechanicTypes\":[],\"nearLocationIds\":[],\"showBookApointment\":true,\"isEnabledListingStatistic\":true,\"hourlyLabourRate\":null,\"daysData\":null,\"mechanicCertificates\":null},{\"mechanicAdvisorID\":657907,\"name\":\"Minhs Automotive\",\"address\":\"578 3rd Ave \",\"address2\":\"\",\"city\":\"Brooklyn\",\"state\":\"NY\",\"zip\":\"11215\",\"phone1\":\