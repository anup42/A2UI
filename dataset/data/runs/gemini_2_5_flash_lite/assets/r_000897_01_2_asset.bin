nt\":true,\"isEnabledListingStatistic\":true,\"hourlyLabourRate\":null,\"daysData\":null,\"mechanicCertificates\":null},{\"mechanicAdvisorID\":585426,\"name\":\"Surgical Auto Repair\",\"address\":\"40 N Macquesten Pkwy\",\"address2\":\"\",\"city\":\"Mount Vernon\",\"state\":\"NY\",\"zip\":\"10550  \",\"phone1\":\"(914) 665-3770\",\"webAddress\":\"https://www.surgicalautorepair.com/\",\"isPremium\":true,\"description\":\"\",\"couponsAmount\":1,\"nameEncode\":\"surgical-auto-repair\",\"radiusMiles\":null,\"countReviews\":0,\"averageRating\":null,\"couponDescription\":\"$$5 OFF Synthetic Oil Change!!! - Print and Present Before Service - Limit One Per Customer\",\"logoName\":\"585426_635539129802483290.jpg\",\"seoCustomServiceText\":null,\"seoCustomVehicleText\":null,\"seoCustomServiceVehicleText\":null,\"hasSEOCustom\":false,\"searchText\":null,\"showFirstCoupon\":false,\"sortBy\":0,\"locationId\":35094,\"recentReview\":null,\"autoOpsApiKey\":\"cc3ad0324c364da2a0d8b220b25abec5\",\"mechanicLocation\":{\"lat\":40.9141396,\"lon\":-73.8482317},\"cityLocation\":{\"lat\":40.9125992,\"lon\":-73.8370786},\"servicesIds\":[],\"vehicleIds\":[],\"searchTerms\":null,\"mechanicTypes\":[],\"nearLocationIds\":[],\"showBookApointment\":false,\"isEnabledListingStatistic\":true,\"hourlyLabourRate\":null,\"daysData\":null,\"mechanicCertificates\":null}]}],[\"$\",\"$L22\",null,{\"shopData\":{\"mechanics\":\"$13:props:children:2:props:shopsData\",\"recentReviews\":[{\"shopId\":201541,\"shopState\":\"NY\",\"shopCity\":\"Brooklyn\",\"shopName\":\"MINHS Auto Care Center\",\"shopNameEncode\":\"minhs-auto-care-center\",\"description\":\"I've only been here once to get some work done on my BMW 335. They are very knowledgeable when it comes to repairs on BMW's. I am a handy guy myself and they provided information and some assistance for repairs I can do myself so that I can save money. Highly recommended!\",\"rating\":5,\"userFirstName\":\"Alex\"},{\"shopId\":591253,\"shopState\":\"NJ\",\"shopCity\":\"Jersey City\",\"shopName\":\"Pica's Automotive Service Inc\",\"shopNameEncode\":\"picas-automotive-service-inc\",\"description\":\"I BROUGHT MY TRUCK TO PICAS AUTOMOTIVE IT WAS A PLEASURE DEALING DIRECTLEY WITH THE OWNER.HE SHOWED ME WHAT THE PROBLEM WAS AND FIXED IT IMMEDIATELY WHEN I TOLD HIM I NEEDED IT FOR WORK.I ASKED HIM TO CHECK MY BRAKES TO SEE IF THEY NEEDED TO BE REPACED HE TOLD ME I STILL HAD 40% LEFT ON THEM I WAS SURPRISED BECAUSE FIRESTONE TOLD ME THEY NEEDED TO BE REPLACED, THATS THE DIFFERANCE BETWEEN A CORPORATE SHOP AND A PRIVATELY OWNED SHOP.THIS IS WHAT THEY CALL OLD SCHOOL IM GLAD THERE IS STILL AN AUTO SHOP LIKE PICAS.  I WILL DEFINANTLY BE GOING TO PICAS IN THE FUTURE FOR ALL MY MECHANICAL PROBLEMS... THANKS AGAIN PICAS!!!!\",\"rating\":5,\"userFirstName\":\"Danny\"},{\"shopId\":580864,\"shopState\":\"NY\",\"shopCity\":\"Brooklyn\",\"shopName\":\"Key Auto Center\",\"shopNameEncode\":\"key-auto-center\",\"description\":\"Had a timing chain tensioner issue, it was a big job and knew this was the place to go. Honest about how complicated things can get and with their cost, they did a excellent job. Extremely happy with their service over the years from simple oil changes to most complicated of jobs. These are the guys to go to, no question about it.\",\"rating\":5,\"userFirstName\":\"Toom\"},{\"shopId\":146506,\"shopState\":\"NJ\",\"shopCity\":\"Fort Lee\",\"shopName\":\"Twin Towers Service Station\",\"shopNameEncode\":\"twin-towers-service-station\",\"description\":\"Twin Towers has been my service station/repair shop and especially my fill-up station for more years than I can remember ... I moved here in 1992. From my 1st visit I knew I was in competent hands. By age 67, I’ve had quite a large experience with mechanics, etc. By far Twin Towers is the best. Prompt scheduling for car emergencies, frequent calls with any sub-optimal or abnormal findings, options, estimates, updates, road test results, etc. There are never any surprises. It’s a family-owned business for generations. Twin Towers is the only service station I’ll ever use. “5 stars” doesn’t adequately describe the experience you will have at Twin Towers.\",\"rating\":5,\"userFirstName\":\"Kathleen\"},{\"shopId\":568170,\"shopState\":\"NY\",\"shopCity\":\"Brooklyn\",\"shopName\":\"Bay Diagnostic\",\"shopNameEncode\":\"bay-diagnostic\",\"description\":\"Great customer service! I strongly recommend this shop, because they are willing to go extra mile to address your issues..... So far fantastic experience.\\r\\n\\r\\nThanks,\\r\\nEdgar\\r\\nBrooklyn, NY\",\"rating\":5,\"userFirstName\":\"Edgar\"},{\"shopId\":655621,\"shopState\":\"NY\",\"shopCity\":\"Yonkers\",\"shopName\":\"Milad Nukho \u0026 Sons\",\"shopNameEncode\":\"milad-nukho-sons\",\"description\":\"I have been a customer of Milad Nukho \u0026Sons for over 30 years, I highly recommend them.\\r\\nThey provide excellent customer service and are extremely knowledgeable.\\r\\nI wouldn’t have anyone else service my vehicle!\",\"rating\":5,\"userFirstName\":\"Adeline\"},{\"shopId\":576581,\"shopState\":\"NY\",\"shopCity\":\"Middle Village\",\"shopName\":\"M-Spec Performance - Middle Village\",\"shopNameEncode\":\"m-spec-performance-middle-village\",\"description\":\"They fix my headlight they do a good job very professional\",\"rating\":5,\"userFirstName\":\"Pablo\"},{\"shopId\":656643,\"shopState\":\"NY\",\"shopCity\":\"Great Neck Plaza\",\"shopName\":\"Paul's Great Neck Auto Repair \u0026 Collision\",\"shopNameEncode\":\"pauls-great-neck-auto-repair-collision\",\"description\":\"$23\",\"rating\":1,\"userFirstName\":\"Kuan\"}],\"filter\":{\"types\":[{\"id\":1,\"name\":\"Auto\",\"checked\":true},{\"id\":2,\"name\":\"Gas Station\",\"checked\":false},{\"id\":3,\"name\":\"DMV\",\"checked\":false},{\"id\":4,\"name\":\"Dealership\",\"checked\":false},{\"id\":5,\"name\":\"Motorcycle\",\"checked\":false},{\"id\":6,\"name\":\"RV Mechanics\",\"checked\":false},{\"id\":7,\"name\":\"Truck\",\"checked