{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genui.local/specification/flatspec/v1/genui_flatspec.schema.json",
  "title": "GenUICraft Flat Spec",
  "type": "object",
  "required": ["root", "elements"],
  "additionalProperties": false,
  "properties": {
    "root": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "type": "object",
      "additionalProperties": true
    },
    "elements": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/element"
      }
    }
  },
  "$defs": {
    "action": {
      "type": "object",
      "required": ["action"],
      "additionalProperties": false,
      "properties": {
        "action": {
          "type": "string",
          "enum": ["openUrl", "setState", "pushState", "removeState", "validateForm"]
        },
        "params": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "allOf": [
        {
          "if": {"properties": {"action": {"const": "openUrl"}}},
          "then": {
            "required": ["params"],
            "properties": {
              "params": {
                "anyOf": [
                  {"required": ["url"]},
                  {"required": ["href"]},
                  {"required": ["link"]},
                  {"required": ["targetUrl"]}
                ]
              }
            }
          }
        },
        {
          "if": {"properties": {"action": {"enum": ["setState", "pushState"]}}},
          "then": {
            "required": ["params"],
            "properties": {
              "params": {
                "required": ["value"],
                "anyOf": [{"required": ["statePath"]}, {"required": ["path"]}]
              }
            }
          }
        },
        {
          "if": {"properties": {"action": {"const": "removeState"}}},
          "then": {
            "required": ["params"],
            "properties": {
              "params": {
                "required": ["index"],
                "anyOf": [{"required": ["statePath"]}, {"required": ["path"]}]
              }
            }
          }
        }
      ]
    },
    "actionOrList": {
      "oneOf": [
        {
          "$ref": "#/$defs/action"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/action"
          }
        }
      ]
    },
    "repeat": {
      "type": "object",
      "required": ["statePath"],
      "additionalProperties": true,
      "properties": {
        "statePath": {
          "type": "string",
          "minLength": 1
        },
        "key": {
          "type": "string"
        }
      }
    },
    "element": {
      "type": "object",
      "required": ["type", "props", "children"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "Stack",
            "List",
            "Card",
            "Text",
            "Formula",
            "CodeBlock",
            "ConsoleLog",
            "EmailPreview",
            "Table",
            "Chart",
            "Image",
            "Icon",
            "Video",
            "AudioPlayer",
            "Divider",
            "Button",
            "Tabs",
            "Modal",
            "TextField",
            "CheckBox",
            "ChoicePicker",
            "Slider",
            "DateTimeInput",
            "Alert",
            "Checklist"
          ]
        },
        "props": {
          "type": "object",
          "additionalProperties": true
        },
        "children": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "repeat": {
          "$ref": "#/$defs/repeat"
        },
        "visible": {
          "description": "Visibility expression",
          "type": ["object", "boolean", "string", "number", "array", "null"]
        },
        "on": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/actionOrList"
          }
        },
        "watch": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/actionOrList"
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "Chart"}}},
          "then": {
            "properties": {
              "props": {
                "properties": {
                  "chartType": {"enum": ["bar", "column"]}
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"type": {"const": "Alert"}}},
          "then": {
            "properties": {
              "props": {
                "anyOf": [{"required": ["message"]}, {"required": ["text"]}],
                "properties": {
                  "tone": {"enum": ["info", "success", "warning", "error"]}
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"type": {"const": "Checklist"}}},
          "then": {
            "properties": {
              "props": {
                "required": ["items"],
                "properties": {
                  "items": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 20,
                    "items": {
                      "type": "object",
                      "required": ["label"],
                      "properties": {
                        "label": {"type": "string", "minLength": 1},
                        "detail": {"type": "string"},
                        "state": {"enum": ["pending", "complete", "warning", "blocked"]},
                        "required": {"type": "boolean"}
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
